;================================================================

;================================================================
; 2A. DERIVED ENEMY THREAT STATE
;----------------------------------------------------------------
; Threat booleans describe immediate counter categories.
; Counter levels describe response pressure and feed role-target capacity.
; Production-building capacity is derived from the resulting standing-role targets.
(defrule
    (true)
=>
    (set-goal bt-cavalry-threat-goal 0)
    (set-goal bt-ranged-threat-goal 0)
    (set-goal bt-spear-threat-goal 0)
    (set-goal bt-any-threat-goal 0)
    (set-goal bt-cavalry-counter-level-goal 0)
    (set-goal bt-ranged-counter-level-goal 0)
    (set-goal bt-spear-counter-level-goal 0)
    (set-goal bt-noncav-cavalry-level-goal 0)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 3)
        (or
            (players-unit-type-count any-enemy camel-line >= 3)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 3)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 3)
                    (players-unit-type-count any-enemy war-elephant-line >= 3)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-threat-goal 1)
    (set-goal bt-any-threat-goal 1)
)
(defrule
    (or
        (players-unit-type-count any-enemy archer-line >= 3)
        (players-unit-type-count any-enemy cavalry-archer-line >= 3)
    )
=>
    (set-goal bt-ranged-threat-goal 1)
    (set-goal bt-any-threat-goal 1)
)
(defrule
    (players-unit-type-count any-enemy spearman-line >= 4)
=>
    (set-goal bt-spear-threat-goal 1)
    (set-goal bt-any-threat-goal 1)
)
; Counter levels preserve original military-response thresholds.
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 3)
        (or
            (players-unit-type-count any-enemy camel-line >= 3)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 3)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 3)
                    (players-unit-type-count any-enemy war-elephant-line >= 3)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-counter-level-goal 1)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 10)
        (or
            (players-unit-type-count any-enemy camel-line >= 10)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 10)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 10)
                    (players-unit-type-count any-enemy war-elephant-line >= 10)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-counter-level-goal 2)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 20)
        (or
            (players-unit-type-count any-enemy camel-line >= 20)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 20)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 20)
                    (players-unit-type-count any-enemy war-elephant-line >= 20)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-counter-level-goal 3)
)
(defrule
    (or
        (players-unit-type-count any-enemy archer-line >= 3)
        (players-unit-type-count any-enemy cavalry-archer-line >= 3)
    )
=>
    (set-goal bt-ranged-counter-level-goal 1)
)
(defrule
    (or
        (players-unit-type-count any-enemy archer-line >= 10)
        (players-unit-type-count any-enemy cavalry-archer-line >= 10)
    )
=>
    (set-goal bt-ranged-counter-level-goal 2)
)
;---------------------------------------------------------------
; VARANGIAN GUARD DERIVED PACKAGE STATE
; Update 185872 adds Byzantines a Castle-age Barracks shock-infantry
; line. The premium package is deliberately narrower than the cheap
; Spear/Camel response: it enters only at substantial cavalry pressure.
(defrule
    (true)
=>
    (set-goal bt-varangian-fielded-goal 0)
    (set-goal bt-varangian-target-goal 0)
    (up-get-fact unit-type-count-total varangian-guard bt-varangian-count-scratch-goal)
    (up-modify-goal bt-varangian-fielded-goal g:+ bt-varangian-count-scratch-goal)
    (up-get-fact unit-type-count-total elite-varangian-guard bt-varangian-count-scratch-goal)
    (up-modify-goal bt-varangian-fielded-goal g:+ bt-varangian-count-scratch-goal)
)

(defrule
    (current-age >= castle-age)
    (up-compare-goal bt-cavalry-counter-level-goal >= 3)
=>
    (set-goal bt-varangian-target-goal bt-varangian-target-level-3)
)

(defrule
    (current-age >= castle-age)
    (up-compare-goal bt-cavalry-counter-level-goal >= 2)
    (up-compare-goal bt-cavalry-counter-level-goal < 3)
=>
    (set-goal bt-varangian-target-goal bt-varangian-target-level-2)
)

; Create the premium package only when the cheaper standing response is
; not already in deficit and the Cataphract package does not own the
; current premium-gold decision.
(defrule
    (current-age >= castle-age)
    (goal bt-varangian-demand-goal 0)
    (goal bt-cataphract-demand-goal 0)
    (up-compare-goal bt-varangian-target-goal > bt-varangian-fielded-goal)
    (up-compare-goal bt-standing-army-deficit-goal >= 0)
=>
    (set-goal bt-varangian-demand-goal 1)
)

; Withdraw the tactical package when cavalry pressure falls away or
; the desired Guard mass is already present. At the larger six-Guard
; tier, keep the demand alive until Logistica is researched so the new
; Byzantine trample interaction is actually reachable.
(defrule
    (goal bt-varangian-demand-goal 1)
    (or
        (current-age < castle-age)
        (or
            (up-compare-goal bt-cavalry-counter-level-goal < 2)
            (and
                (up-compare-goal bt-varangian-fielded-goal >= bt-varangian-target-goal)
                (or
                    (up-compare-goal bt-varangian-target-goal < bt-varangian-logistica-min)
                    (up-research-status c: ri-logistica == research-complete)
                )
            )
        )
    )
=>
    (set-goal bt-varangian-demand-goal 0)
)

; Update 185872: Logistica now gives both Cataphracts and Varangian Guards
; trample damage. Earn it only for the six-Guard package, preserving the
; existing Cataphract premium research path.
(defrule
    (goal bt-research-cataphract-package-goal 0)
    (goal bt-varangian-demand-goal 1)
    (up-compare-goal bt-varangian-fielded-goal >= bt-varangian-logistica-min)
    (up-research-status c: ri-logistica < research-complete)
=>
    (set-goal bt-research-cataphract-package-goal ri-logistica)
)

; Imperial follow-on: only buy Elite Varangian Guard after Logistica,
; a real 12-Guard mass, and favorable battlefield conditions. This uses the
; existing shared premium-research cursor; there is no second research system.
(defrule
    (goal bt-research-cataphract-package-goal 0)
    (goal bt-cataphract-demand-goal 0)
    (goal bt-varangian-demand-goal 0)
    (current-age >= imperial-age)
    (up-compare-goal bt-varangian-fielded-goal >= bt-varangian-elite-target-level)
    (up-research-status c: ri-logistica == research-complete)
    (up-research-status c: ri-elite-varangian-guard < research-pending)
    (up-compare-goal bt-cavalry-counter-level-goal >= 2)
    (up-compare-goal bt-ranged-counter-level-goal < 2)
    (players-unit-type-count any-enemy militiaman-line < bt-cataphract-enemy-threshold-2)
=>
    (set-goal bt-research-cataphract-package-goal ri-elite-varangian-guard)
)

; Strategic invalidation applies only before the upgrade has actually started.
(defrule
    (goal bt-research-cataphract-package-goal ri-elite-varangian-guard)
    (up-research-status c: ri-elite-varangian-guard < research-pending)
    (or
        (current-age < imperial-age)
        (or
            (goal bt-cataphract-demand-goal 1)
            (or
                (up-compare-goal bt-varangian-fielded-goal < bt-varangian-elite-target-level)
                (or
                    (up-compare-goal bt-cavalry-counter-level-goal < 2)
                    (or
                        (up-compare-goal bt-ranged-counter-level-goal >= 2)
                        (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-2)
                    )
                )
            )
        )
    )
=>
    (set-goal bt-research-cataphract-package-goal 0)
)

(defrule
    (goal bt-research-cataphract-package-goal ri-elite-varangian-guard)
    (up-research-status c: ri-elite-varangian-guard == research-complete)
=>
    (set-goal bt-research-cataphract-package-goal 0)
)


(defrule
    (or
        (players-unit-type-count any-enemy archer-line >= 20)
        (players-unit-type-count any-enemy cavalry-archer-line >= 20)
    )
=>
    (set-goal bt-ranged-counter-level-goal 3)
)
(defrule
    (players-unit-type-count any-enemy spearman-line >= 4)
=>
    (set-goal bt-spear-counter-level-goal 1)
)
(defrule
    (players-unit-type-count any-enemy spearman-line >= 8)
=>
    (set-goal bt-spear-counter-level-goal 2)
)
; Non-Camel cavalry capacity: 10/15.
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 10)
        (or
            (players-unit-type-count any-enemy cataphract-line >= 10)
            (or
                (players-unit-type-count any-enemy scout-cavalry-line >= 10)
                (players-unit-type-count any-enemy war-elephant-line >= 10)
            )
        )
    )
=>
    (set-goal bt-noncav-cavalry-level-goal 1)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 15)
        (or
            (players-unit-type-count any-enemy cataphract-line >= 15)
            (or
                (players-unit-type-count any-enemy scout-cavalry-line >= 15)
                (players-unit-type-count any-enemy war-elephant-line >= 15)
            )
        )
    )
=>
    (set-goal bt-noncav-cavalry-level-goal 2)
)
; Cavalry production capacity: 6/15/25/40/55.


;================================================================
; MONASTERY / MONK DEMAND
;================================================================
; Three monks are support, not a prerequisite for attacking.
(defrule
    (goal bt-imperial-siege-package-goal 1)
    (current-age >= imperial-age)
    (unit-type-count-total monk < 3)
    (goal bt-monk-demand-goal 0)
=>
    (set-goal bt-monk-target-goal 3)
    (set-goal bt-monk-demand-goal 1)
)

; MONASTERY / MONK DEMAND
;================================================================
(defrule
    (current-age >= castle-age)
    (players-unit-type-count target-player monk >= 1)
=>
    (set-goal bt-monk-target-goal 3)
    (set-goal bt-monk-demand-goal 1)
)
(defrule
    (current-age >= castle-age)
    (players-unit-type-count target-player monk < 1)
    (or
        (players-unit-type-count target-player mangonel-line >= 1)
        (or
            (players-unit-type-count target-player scorpion-line >= 1)
            (or
                (players-unit-type-count target-player battering-ram-line >= 1)
                (or
                    (players-unit-type-count target-player siege-tower >= 1)
                    (or
                        (players-unit-type-count target-player bombard-cannon-line >= 1)
                        (players-unit-type-count target-player trebuchet-set >= 1)
                    )
                )
            )
        )
    )
=>
    (set-goal bt-monk-target-goal 2)
    (set-goal bt-monk-demand-goal 1)
)
(defrule
    (current-age >= imperial-age)
    (or
        (players-unit-type-count target-player mangonel-line >= 1)
        (or
            (players-unit-type-count target-player bombard-cannon-line >= 1)
            (players-unit-type-count target-player trebuchet-set >= 1)
        )
    )
=>
    (set-goal bt-monk-target-goal 4)
    (set-goal bt-monk-demand-goal 1)
)
(defrule
    (goal bt-monk-demand-goal 1)
    (goal bt-imperial-siege-package-goal 0)
    (players-unit-type-count target-player monk < 1)
    (players-unit-type-count target-player mangonel-line < 1)
    (players-unit-type-count target-player scorpion-line < 1)
    (players-unit-type-count target-player battering-ram-line < 1)
    (players-unit-type-count target-player siege-tower < 1)
    (players-unit-type-count target-player bombard-cannon-line < 1)
    (players-unit-type-count target-player trebuchet-set < 1)
=>
    (set-goal bt-monk-demand-goal 0)
    (set-goal bt-monk-target-goal 0)
)

; MONK RESEARCH PACKAGE
;================================================================
; The cursor follows the actual monk job rather than a blind monastery
; technology queue. Enemy monks are answered first with Atonement;
; siege is answered with Redemption; Sanctity follows once the active
; monk job is established; Block Printing is an Imperial extension of
; an existing siege-conversion job. Faith and Theocracy are deliberately
; not automatic here: Faith now requires Devotion, while Theocracy needs
; a real grouped-conversion use case rather than a raw monk count.
(defrule
    (goal bt-research-monk-package-goal 0)
    (goal bt-monk-demand-goal 1)
    (unit-type-count-total monk >= 2)
    (players-unit-type-count target-player monk >= 1)
    (up-compare-goal bt-research-monastery-failure-backoff-goal != ri-atonement)
    (up-research-status c: ri-atonement < research-complete)
    (research-available ri-atonement)
=>
    (set-goal bt-research-monk-package-goal ri-atonement)
)
(defrule
    (goal bt-research-monk-package-goal 0)
    (goal bt-monk-demand-goal 1)
    (unit-type-count-total monk >= 2)
    (or
        (players-unit-type-count target-player mangonel-line >= 1)
        (or
            (players-unit-type-count target-player scorpion-line >= 1)
            (or
                (players-unit-type-count target-player battering-ram-line >= 1)
                (or
                    (players-unit-type-count target-player siege-tower >= 1)
                    (or
                        (players-unit-type-count target-player bombard-cannon-line >= 1)
                        (players-unit-type-count target-player trebuchet-set >= 1)
                    )
                )
            )
        )
    )
    (or
        (players-unit-type-count target-player monk < 1)
        (up-research-status c: ri-atonement == research-complete)
    )
    (up-compare-goal bt-research-monastery-failure-backoff-goal != ri-redemption)
    (up-research-status c: ri-redemption < research-complete)
    (research-available ri-redemption)
=>
    (set-goal bt-research-monk-package-goal ri-redemption)
)
(defrule
    (goal bt-research-monk-package-goal 0)
    (goal bt-monk-demand-goal 1)
    (unit-type-count-total monk >= 2)
    (or
        (players-unit-type-count target-player monk < 1)
        (up-research-status c: ri-atonement == research-complete)
    )
    (or
        (and
            (players-unit-type-count target-player mangonel-line < 1)
            (and
            (players-unit-type-count target-player scorpion-line < 1)
            (and
            (players-unit-type-count target-player battering-ram-line < 1)
            (and
            (players-unit-type-count target-player siege-tower < 1)
            (and
            (players-unit-type-count target-player bombard-cannon-line < 1)
            (players-unit-type-count target-player trebuchet-set < 1)
                    )
                    )
                    )
                    )
        )
        (up-research-status c: ri-redemption == research-complete)
    )
    (up-compare-goal bt-research-monastery-failure-backoff-goal != ri-sanctity)
    (up-research-status c: ri-sanctity < research-complete)
    (research-available ri-sanctity)
=>
    (set-goal bt-research-monk-package-goal ri-sanctity)
)
(defrule
    (goal bt-research-monk-package-goal 0)
    (goal bt-monk-demand-goal 1)
    (current-age >= imperial-age)
    (unit-type-count-total monk >= 4)
    (or
        (players-unit-type-count target-player mangonel-line >= 1)
        (or
            (players-unit-type-count target-player bombard-cannon-line >= 1)
            (players-unit-type-count target-player trebuchet-set >= 1)
        )
    )
    (up-research-status c: ri-redemption == research-complete)
    (up-research-status c: ri-sanctity == research-complete)
    (up-compare-goal bt-research-monastery-failure-backoff-goal != ri-block-printing)
    (up-research-status c: ri-block-printing < research-complete)
    (research-available ri-block-printing)
=>
    (set-goal bt-research-monk-package-goal ri-block-printing)
)
; Monk package state resets from research completion, demand loss, or capability
; loss. Failed starts release only the active claim and enter bounded cooldown.

(defrule
    (goal bt-research-monk-package-goal ri-atonement)
    (up-research-status c: ri-atonement == research-complete)
=>
    (set-goal bt-research-monk-package-goal 0)
)
(defrule
    (goal bt-research-monk-package-goal ri-redemption)
    (up-research-status c: ri-redemption == research-complete)
=>
    (set-goal bt-research-monk-package-goal 0)
)
(defrule
    (goal bt-research-monk-package-goal ri-sanctity)
    (up-research-status c: ri-sanctity == research-complete)
=>
    (set-goal bt-research-monk-package-goal 0)
)
(defrule
    (goal bt-research-monk-package-goal ri-block-printing)
    (up-research-status c: ri-block-printing == research-complete)
=>
    (set-goal bt-research-monk-package-goal 0)
)
(defrule
    (up-compare-goal bt-research-monk-package-goal != 0)
    (goal bt-monk-demand-goal 0)
=>
    (set-goal bt-research-monk-package-goal 0)
)
; BLACKSMITH FRIENDLY-ARMY WITNESSES
; Friendly mass keeps its blacksmith package alive even when enemy threat
; observations fall away. Unit counts are live engine facts, not threat latches.
(defrule
    (true)
=>
    (set-goal bt-blacksmith-ranged-army-goal 0)
    (set-goal bt-blacksmith-infantry-army-goal 0)
)
(defrule
    (or
        (unit-type-count-total archer-line >= 3)
        (or
            (unit-type-count-total skirmisher-line >= 3)
            (unit-type-count-total cavalry-archer-line >= 3)
        )
    )
=>
    (set-goal bt-blacksmith-ranged-army-goal 1)
)
(defrule
    (or
        (unit-type-count-total spearman-line >= 3)
        (or
            (unit-type-count-total militiaman-line >= 3)
            (up-compare-goal bt-varangian-fielded-goal >= 3)
        )
    )
=>
    (set-goal bt-blacksmith-infantry-army-goal 1)
)

; RESEARCH PACKAGE PRIORITY
;================================================================
; Package goal value:
;   0     = inactive
;   ri-*  = persistent technology cursor
; The cursor follows the existing Shadow progression-pause idea without
; introducing a universal scheduler. Existing research rules remain the
; executor and retain escrow, age, prerequisite, and failure gates.

; CAVALRY COUNTER PACKAGE
(defrule
    (goal bt-research-cavalry-counter-package-goal 0)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-scale-mail)
    (and
        (up-compare-goal bt-standing-spear-target-goal >= bt-spear-target-1)
        (unit-type-count-total spearman-line >= bt-spear-target-1)
    )
    (up-research-status c: ri-scale-mail < research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-scale-mail)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal 0)
    (or
        (up-compare-goal bt-cavalry-counter-level-goal >= 1)
        (goal bt-blacksmith-infantry-army-goal 1)
    )
    (up-research-status c: ri-scale-mail == research-complete)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-chain-mail)
    (up-research-status c: ri-chain-mail < research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-chain-mail)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal 0)
    (up-compare-goal bt-cavalry-counter-level-goal >= 1)
    (up-research-status c: ri-scale-mail == research-complete)
    (up-research-status c: ri-chain-mail == research-complete)
    (current-age >= castle-age)
    (up-research-status c: ri-pikeman < research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-pikeman)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal 0)
    (goal bt-halberdier-demand-goal 1)
    (up-research-status c: ri-pikeman == research-complete)
    (up-research-status c: ri-halberdier < research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-halberdier)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal 0)
    (or
        (up-compare-goal bt-cavalry-counter-level-goal >= 2)
        (and
            (goal bt-blacksmith-infantry-army-goal 1)
            (up-compare-goal bt-standing-spear-target-goal >= bt-spear-target-2)
        )
    )
    (current-age >= imperial-age)
    (up-compare-goal bt-standing-spear-target-goal >= bt-spear-target-2)
    (up-research-status c: ri-halberdier == research-complete)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-plate-mail)
    (up-research-status c: ri-plate-mail < research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-plate-mail)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal ri-scale-mail)
    (up-research-status c: ri-scale-mail == research-complete)
    (current-age == feudal-age)
    (goal bt-blacksmith-infantry-army-goal 1)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-forging)
    (up-research-status c: ri-forging < research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-forging)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal ri-scale-mail)
    (up-research-status c: ri-scale-mail == research-complete)
    (current-age >= castle-age)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-chain-mail)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-chain-mail)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal ri-chain-mail)
    (up-research-status c: ri-chain-mail == research-complete)
    (current-age >= castle-age)
    (goal bt-blacksmith-infantry-army-goal 1)
    (up-compare-goal bt-cavalry-counter-level-goal < 1)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-iron-casting)
    (up-research-status c: ri-iron-casting < research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-iron-casting)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal ri-chain-mail)
    (up-research-status c: ri-chain-mail == research-complete)
    (current-age >= castle-age)
    (up-research-status c: ri-pikeman < research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-pikeman)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal ri-pikeman)
    (up-research-status c: ri-pikeman == research-complete)
    (goal bt-halberdier-demand-goal 1)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-halberdier)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal ri-halberdier)
    (up-research-status c: ri-halberdier == research-complete)
    (current-age >= imperial-age)
    (up-compare-goal bt-cavalry-counter-level-goal >= 2)
    (up-compare-goal bt-standing-spear-target-goal >= bt-spear-target-2)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-plate-mail)
    (up-research-status c: ri-plate-mail < research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-plate-mail)
)

(defrule
    (goal bt-research-cavalry-counter-package-goal ri-pikeman)
    (up-research-status c: ri-pikeman == research-complete)
    (goal bt-halberdier-demand-goal 0)
=>
    (set-goal bt-research-cavalry-counter-package-goal 0)
)

(defrule
    (goal bt-research-cavalry-counter-package-goal ri-halberdier)
    (up-research-status c: ri-halberdier == research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal 0)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal ri-forging)
    (up-research-status c: ri-forging == research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal 0)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal ri-iron-casting)
    (up-research-status c: ri-iron-casting == research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal 0)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal ri-plate-mail)
    (up-research-status c: ri-plate-mail == research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal 0)
)
(defrule
    (up-compare-goal bt-research-cavalry-counter-package-goal != 0)
    (up-compare-goal bt-cavalry-counter-level-goal < 1)
    (goal bt-cavalry-threat-goal 0)
    (goal bt-blacksmith-infantry-army-goal 0)
    (goal bt-halberdier-demand-goal 0)
=>
    (set-goal bt-research-cavalry-counter-package-goal 0)
)

; RANGED COUNTER / RANGED ROLE PACKAGE
;----------------------------------------------------------------
; Package selection is strategic policy only. Reliability state is read
; here as an availability constraint; it is never written here.
;
; Counter branch:
;   active enemy ranged threat -> real Skirmisher response.
; Boom branch:
;   explicit Crossbow role -> Crossbow/Bodkin/Thumb Ring.
; Defensive armor:
;   only while a real ranged army and the corresponding threat/role remain.
;
; Crossbow/Arbalest/Thumb Ring are deliberately isolated from the generic
; ranged-threat branch. Enemy archers do not, by themselves, authorize the
; gold-heavy Crossbow line. Byzantines answer the immediate ranged threat
; with the discounted Skirmisher line unless a separate Crossbow role has
; been established.

; FLETCHING: establish a real ranged response package.
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
    (or
        (and
            (up-compare-goal bt-standing-archer-target-goal > 0)
            (unit-type-count-total archer-line >= 3)
        )
        (or
            (and
                (up-compare-goal bt-standing-skirm-target-goal > 0)
                (unit-type-count-total skirmisher-line >= 3)
            )
            (goal bt-blacksmith-ranged-army-goal 1)
        )
    )
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-fletching)
    (up-research-status c: ri-fletching < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-fletching)
)

; CROSSBOW: separate Castle BOOM / CASTLE-POWER ranged-role branch.
; It cannot activate from enemy ranged threat because the standing
; Crossbow role is explicitly a no-immediate-threat investment.
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (goal bt-crossbow-demand-goal 1)
    (goal bt-arbalest-demand-goal 0)
    (or
        (goal strategy-goal bt-strategy-boom)
        (goal strategy-goal bt-strategy-castle-power)
    )
    (goal bt-any-threat-goal 0)
    (goal bt-ranged-threat-goal 0)
    (current-age >= castle-age)
    (up-compare-goal bt-standing-crossbow-target-goal > 0)
    (up-research-status c: ri-fletching == research-complete)
    (up-compare-goal bt-research-archery-range-failure-backoff-goal != ri-crossbow)
    (up-research-status c: ri-crossbow < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-crossbow)
)

; ELITE SKIRMISHER: primary Byzantine counter branch.
; Crossbow demand must be absent so the two strategic branches cannot
; simultaneously claim the same package slot.
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (current-age >= castle-age)
    (up-compare-goal bt-ranged-counter-level-goal >= 1)
    (not (and
             (goal strategy-goal bt-strategy-boom)
             (and
             (goal bt-any-threat-goal 0)
             (up-compare-goal bt-standing-crossbow-target-goal > 0)
                      )
         ))
    (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-1)
    (unit-type-count-total skirmisher-line >= bt-skirm-target-1)
    (up-compare-goal bt-research-archery-range-failure-backoff-goal != ri-elite-skirmisher)
    (up-research-status c: ri-elite-skirmisher < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-elite-skirmisher)
)

; FLETCHING -> CROSSBOW: retain the explicit Castle BOOM / CASTLE-POWER role after
; the prerequisite completes.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-fletching)
    (goal bt-crossbow-demand-goal 1)
    (goal bt-arbalest-demand-goal 0)
    (or
        (goal strategy-goal bt-strategy-boom)
        (goal strategy-goal bt-strategy-castle-power)
    )
    (goal bt-any-threat-goal 0)
    (goal bt-ranged-threat-goal 0)
    (current-age >= castle-age)
    (up-research-status c: ri-fletching == research-complete)
    (up-compare-goal bt-standing-crossbow-target-goal > 0)
    (up-compare-goal bt-research-archery-range-failure-backoff-goal != ri-crossbow)
    (up-research-status c: ri-crossbow < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-crossbow)
)

; FLETCHING -> ELITE SKIRMISHER: primary Byzantine ranged counter.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-fletching)
    (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (current-age >= castle-age)
    (up-research-status c: ri-fletching == research-complete)
    (not (and
             (goal strategy-goal bt-strategy-boom)
             (and
             (goal bt-any-threat-goal 0)
             (up-compare-goal bt-standing-crossbow-target-goal > 0)
                      )
         ))
    (up-compare-goal bt-ranged-counter-level-goal >= 1)
    (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-1)
    (unit-type-count-total skirmisher-line >= bt-skirm-target-1)
    (up-compare-goal bt-research-archery-range-failure-backoff-goal != ri-elite-skirmisher)
    (up-research-status c: ri-elite-skirmisher < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-elite-skirmisher)
)

; FLETCHING -> ELITE SKIRMISHER: friendly ranged mass keeps the package alive.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-fletching)
    (up-research-status c: ri-fletching == research-complete)
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (current-age >= castle-age)
    (goal bt-blacksmith-ranged-army-goal 1)
    (up-compare-goal bt-standing-skirm-target-goal > 0)
    (unit-type-count-total skirmisher-line >= bt-skirm-target-1)
    (up-compare-goal bt-research-archery-range-failure-backoff-goal != ri-elite-skirmisher)
    (up-research-status c: ri-elite-skirmisher < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-elite-skirmisher)
)

; FLETCHING -> PADDED ARMOR: defensive support when the primary counter
; branch does not own the package.
; CAVALRY-ARCHER FLETCHING -> BODKIN
; A real CA mass earns the universal ranged attack progression once Fletching
; is complete. This closes the CA-only path before terminal release.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-fletching)
    (up-research-status c: ri-fletching == research-complete)
    (current-age >= castle-age)
    (unit-type-count-total cavalry-archer-line >= 3)
    (up-research-status c: ri-bodkin-arrow < research-complete)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-bodkin-arrow)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-bodkin-arrow)
)

(defrule
    (goal bt-research-ranged-counter-package-goal ri-fletching)
    (up-research-status c: ri-fletching == research-complete)
    (up-research-status c: ri-bodkin-arrow == research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

(defrule
    (goal bt-research-ranged-counter-package-goal ri-fletching)
    (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
    (goal bt-crossbow-demand-goal 0)
    (up-research-status c: ri-fletching == research-complete)
    (or
        (and
            (up-compare-goal bt-standing-archer-target-goal > 0)
            (unit-type-count-total archer-line >= 3)
        )
        (and
            (up-compare-goal bt-standing-skirm-target-goal > 0)
            (unit-type-count-total skirmisher-line >= 3)
        )
    )
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-padded-archer-armor)
    (up-research-status c: ri-padded-archer-armor < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-padded-archer-armor)
)

; BODKIN SUPPORT FROM CROSSBOW.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-crossbow)
    (up-research-status c: ri-crossbow == research-complete)
    (or
        (and
            (goal unit-goal crossbowman)
            (or
                (unit-type-count-total crossbowman >= bt-crossbow-target-castle)
                (unit-type-count-total arbalest >= bt-crossbow-target-castle)
            )
        )
        (or
        (and
            (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
            (and
            (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-1)
            (unit-type-count-total skirmisher-line >= bt-skirm-target-1)
                    )
        )
        (and
            (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
            (and
            (up-compare-goal bt-standing-archer-target-goal >= 3)
            (unit-type-count-total archer-line >= 3)
                    )
        )
            )
    )
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-bodkin-arrow)
    (up-research-status c: ri-bodkin-arrow < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-bodkin-arrow)
)

; BODKIN SUPPORT FROM ELITE SKIRMISHER.
; Bodkin is a prerequisite for Bracer in the existing executor, so do not
; allow the Elite -> Bracer edge to strand the package behind a missing
; prerequisite.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-elite-skirmisher)
    (up-research-status c: ri-elite-skirmisher == research-complete)
    (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
    (current-age >= castle-age)
    (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-1)
    (unit-type-count-total skirmisher-line >= bt-skirm-target-1)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-bodkin-arrow)
    (up-research-status c: ri-bodkin-arrow < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-bodkin-arrow)
)

; ELITE -> BRACER when Bodkin already exists.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-elite-skirmisher)
    (up-research-status c: ri-elite-skirmisher == research-complete)
    (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
    (current-age >= imperial-age)
    (up-research-status c: ri-bodkin-arrow == research-complete)
    (or
        (and
            (goal unit-goal crossbowman)
            (and
            (up-research-status c: ri-arbalest == research-complete)
            (unit-type-count-total arbalest >= bt-crossbow-target-mature)
                    )
        )
        (or
        (and
            (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-2)
            (and
            (unit-type-count-total skirmisher-line >= bt-skirm-target-2)
            (up-compare-goal bt-ranged-counter-level-goal >= 2)
                    )
        )
        (unit-type-count-total cavalry-archer >= 6)
            )
    )
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-bracer)
    (up-research-status c: ri-bracer < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-bracer)
)

; BRACER: mature ranged army, active ranged threat, and Bodkin already
; available/completed. Elite completion alone is not strategic authority.
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (current-age >= imperial-age)
    (up-research-status c: ri-bodkin-arrow == research-complete)
    (and
            (goal unit-goal crossbowman)
            (and
            (up-research-status c: ri-arbalest == research-complete)
            (unit-type-count-total arbalest >= bt-crossbow-target-mature)
                    )
        )
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-bracer)
    (up-research-status c: ri-bracer < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-bracer)
)
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (current-age >= imperial-age)
    (up-research-status c: ri-bodkin-arrow == research-complete)
    (or
        (and
            (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-2)
            (and
            (unit-type-count-total skirmisher-line >= bt-skirm-target-2)
            (and
            (up-compare-goal bt-ranged-counter-level-goal >= 2)
            (up-research-status c: ri-elite-skirmisher == research-complete)
                    )
                    )
        )
        (and
            (unit-type-count-total cavalry-archer >= 6)
            (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
        )
            )
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-bracer)
    (up-research-status c: ri-bracer < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-bracer)
)

; BRACER AFTER BODKIN / ELITE.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-bodkin-arrow)
    (up-research-status c: ri-bodkin-arrow == research-complete)
    (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
    (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-2)
    (unit-type-count-total skirmisher-line >= bt-skirm-target-2)
    (up-compare-goal bt-ranged-counter-level-goal >= 2)
    (up-research-status c: ri-elite-skirmisher == research-complete)
    (current-age >= imperial-age)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-bracer)
    (up-research-status c: ri-bracer < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-bracer)
)

; PADDED ARCHER ARMOR: defensive support for an actual ranged response.
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (up-research-status c: ri-fletching == research-complete)
    (or
        (and
            (up-compare-goal bt-standing-archer-target-goal > 0)
            (unit-type-count-total archer-line >= 3)
        )
        (and
            (up-compare-goal bt-standing-skirm-target-goal > 0)
            (unit-type-count-total skirmisher-line >= 3)
        )
    )
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-padded-archer-armor)
    (up-research-status c: ri-padded-archer-armor < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-padded-archer-armor)
)

; Padded -> Leather only while the ranged threat and army remain.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-padded-archer-armor)
    (up-research-status c: ri-padded-archer-armor == research-complete)
    (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (or
        (and
            (up-compare-goal bt-standing-archer-target-goal > 0)
            (unit-type-count-total archer-line >= 3)
        )
        (and
            (up-compare-goal bt-standing-skirm-target-goal > 0)
            (unit-type-count-total skirmisher-line >= 3)
        )
    )
    (current-age >= castle-age)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-leather-archer-armor)
    (up-research-status c: ri-leather-archer-armor < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-leather-archer-armor)
)

; Leather -> Ring only for an established late ranged army.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-leather-archer-armor)
    (up-research-status c: ri-leather-archer-armor == research-complete)
    (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (current-age >= imperial-age)
    (or
        (and
            (goal unit-goal crossbowman)
            (and
            (up-research-status c: ri-arbalest == research-complete)
            (unit-type-count-total arbalest >= bt-crossbow-target-mature)
                    )
        )
        (or
        (and
            (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-2)
            (unit-type-count-total skirmisher-line >= bt-skirm-target-2)
        )
        (unit-type-count-total cavalry-archer >= 6)
            )
    )
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-ring-archer-armor)
    (up-research-status c: ri-ring-archer-armor < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-ring-archer-armor)
)

; RING -> BRACER: continue only when the existing Bracer package is
; strategically admissible after Ring completes. This rule advances only the
; package cursor; Bracer's existing executor owns research dispatch.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-ring-archer-armor)
    (up-research-status c: ri-ring-archer-armor == research-complete)
    (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (current-age >= imperial-age)
    (up-research-status c: ri-bodkin-arrow == research-complete)
    (or
        (and
            (goal unit-goal crossbowman)
            (and
            (up-research-status c: ri-arbalest == research-complete)
            (unit-type-count-total arbalest >= bt-crossbow-target-mature)
                    )
        )
        (or
        (and
            (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-2)
            (and
            (unit-type-count-total skirmisher-line >= bt-skirm-target-2)
            (and
            (up-compare-goal bt-ranged-counter-level-goal >= 2)
            (up-research-status c: ri-elite-skirmisher == research-complete)
                    )
                    )
        )
        (unit-type-count-total cavalry-archer >= 6)
            )
    )
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-bracer)
    (up-research-status c: ri-bracer < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-bracer)
)

; THUMB RING: Castle BOOM ranged support, not a counter response.
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (or
        (goal strategy-goal bt-strategy-boom)
        (goal strategy-goal bt-strategy-castle-power)
    )
    (goal bt-any-threat-goal 0)
    (goal bt-ranged-threat-goal 0)
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (goal unit-goal crossbowman)
    (current-age >= castle-age)
    (building-type-count archery-range >= 1)
    (or
        (goal bt-resource-mode-goal bt-resource-mode-castle-boom)
        (goal bt-resource-mode-goal bt-resource-mode-premium-gold)
    )
    (up-research-status c: ri-crossbow == research-complete)
    (up-research-status c: ri-bodkin-arrow == research-complete)
    (or
        ; Keep Thumb Ring behind the first real Castle ranged mass.
        (unit-type-count-total crossbowman >= bt-crossbow-target-mature)
        (unit-type-count-total arbalest >= bt-crossbow-target-mature)
    )
    (up-compare-goal bt-research-archery-range-failure-backoff-goal != ri-thumb-ring)
    (up-research-status c: ri-thumb-ring < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-thumb-ring)
)

; ARBALEST: Imperial primary ranged-line branch only.
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (goal bt-arbalest-demand-goal 1)
    (goal bt-crossbow-demand-goal 0)
    (goal strategy-goal bt-strategy-boom)
    (goal bt-any-threat-goal 0)
    (goal bt-ranged-threat-goal 0)
    (goal unit-goal crossbowman)
    (current-age >= imperial-age)
    (up-research-status c: ri-crossbow == research-complete)
    (unit-type-count-total crossbowman >= bt-crossbow-target-mature)
    (up-compare-goal bt-research-archery-range-failure-backoff-goal != ri-arbalest)
    (up-research-status c: ri-arbalest < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-arbalest)
)

; Crossbow -> Bodkin terminal release.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-bodkin-arrow)
    (up-research-status c: ri-bodkin-arrow == research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; Bracer is terminal after completion.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-bracer)
    (up-research-status c: ri-bracer == research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; Thumb Ring is terminal after completion.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-thumb-ring)
    (up-research-status c: ri-thumb-ring == research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; Arbalest is terminal after completion.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-arbalest)
    (up-research-status c: ri-arbalest == research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; Counter branch cancellation: enemy ranged threat disappeared.
(defrule
    (or
        (goal bt-research-ranged-counter-package-goal ri-fletching)
        (or
        (goal bt-research-ranged-counter-package-goal ri-elite-skirmisher)
        (or
        (goal bt-research-ranged-counter-package-goal ri-padded-archer-armor)
        (or
        (goal bt-research-ranged-counter-package-goal ri-leather-archer-armor)
        (or
        (goal bt-research-ranged-counter-package-goal ri-ring-archer-armor)
        (goal bt-research-ranged-counter-package-goal ri-bracer)
            )
            )
            )
            )
    )
    (goal bt-ranged-threat-goal 0)
    (goal bt-blacksmith-ranged-army-goal 0)
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; Crossbow package cancellation: its explicit Boom demand disappeared or
; an immediate enemy threat made the Boom investment strategically obsolete.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-crossbow)
    (or
        (goal bt-crossbow-demand-goal 0)
        (goal bt-any-threat-goal 1)
    )
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; Arbalest package cancellation: the primary Crossbow role is no longer a
; valid no-threat Boom investment.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-arbalest)
    (or
        (goal bt-arbalest-demand-goal 0)
        (or
        (goal bt-any-threat-goal 1)
        (or
        (goal strategy-goal bt-strategy-flush)
        (goal strategy-goal bt-strategy-rush)
            )
            )
    )
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; Thumb Ring package cancellation: preserve only the Castle BOOM role.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-thumb-ring)
    (or
        (goal bt-any-threat-goal 1)
        (or
        (goal strategy-goal bt-strategy-flush)
        (or
        (goal strategy-goal bt-strategy-rush)
        (not
            (or
                (goal bt-resource-mode-goal bt-resource-mode-castle-boom)
                (goal bt-resource-mode-goal bt-resource-mode-premium-gold)
            )
        )
            )
            )
    )
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; BLACKSMITH RESEARCH PACKAGE POLICY
;
; Research package demand is persistent while its strategic role remains
; valid. A failed research action releases only the active claim and
; enters the shared 30-second fairness backoff. There is no permanent
; per-technology retry cutoff: can-research-with-escrow plus the
; package predicates remain the execution gate, while research-complete
; is the only success witness.
; CATAPHRACT PREMIUM PACKAGE
; Tier 1 (6-9 enemy infantry) is a completed Cataphract response, not a
; premium-research package. Logistica begins only at the 10-unit threat tier.
(defrule
    (goal bt-research-cataphract-package-goal 0)
    (goal bt-cataphract-demand-goal 1)
    (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-2)
    (up-research-status c: ri-logistica < research-complete)
=>
    (set-goal bt-research-cataphract-package-goal ri-logistica)
)
(defrule
    (goal bt-research-cataphract-package-goal 0)
    (goal bt-cataphract-demand-goal 1)
    (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-3)
    (up-research-status c: ri-logistica == research-complete)
    (up-research-status c: ri-elite-cataphract < research-complete)
=>
    (set-goal bt-research-cataphract-package-goal ri-elite-cataphract)
)
(defrule
    (goal bt-research-cataphract-package-goal ri-logistica)
    (up-research-status c: ri-logistica == research-complete)
    (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-3)
    (up-research-status c: ri-elite-cataphract < research-complete)
=>
    (set-goal bt-research-cataphract-package-goal ri-elite-cataphract)
)
(defrule
    (goal bt-research-cataphract-package-goal ri-logistica)
    (up-research-status c: ri-logistica == research-complete)
    (goal bt-cataphract-demand-goal 0)
=>
    (set-goal bt-research-cataphract-package-goal 0)
)
(defrule
    (goal bt-research-cataphract-package-goal ri-logistica)
    (goal bt-research-castle-claim-goal 0)
    (up-research-status c: ri-logistica < research-pending)
    (goal bt-varangian-demand-goal 0)
    (players-unit-type-count any-enemy militiaman-line < bt-cataphract-enemy-threshold-2)
=>
    (set-goal bt-research-cataphract-package-goal 0)
)
(defrule
    (goal bt-research-cataphract-package-goal ri-elite-cataphract)
    (goal bt-research-castle-claim-goal 0)
    (up-research-status c: ri-elite-cataphract < research-pending)
    (players-unit-type-count any-enemy militiaman-line < bt-cataphract-enemy-threshold-3)
=>
    (set-goal bt-research-cataphract-package-goal 0)
)
(defrule
    (goal bt-research-cataphract-package-goal ri-elite-cataphract)
    (up-research-status c: ri-elite-cataphract == research-complete)
=>
    (set-goal bt-research-cataphract-package-goal 0)
)
(defrule
    (up-compare-goal bt-research-cataphract-package-goal != 0)
    (goal bt-cataphract-demand-goal 0)
    (or
        (goal bt-research-cataphract-package-goal ri-elite-cataphract)
        (and
            (goal bt-research-cataphract-package-goal ri-logistica)
            (goal bt-varangian-demand-goal 0)
        )
    )
=>
    (set-goal bt-research-cataphract-package-goal 0)
)

; SIEGE ESCALATION PACKAGE
;
; University-backed siege research is persistent while its strategic demand
; remains valid. A failed research action releases only the active claim;
; the capability-local fairness backoff prevents immediate contention.
(defrule
    (goal bt-research-siege-package-goal 0)
    (goal bt-scorpion-ballistics-demand-goal 1)
    (up-compare-goal bt-research-university-failure-backoff-goal != ri-ballistics)
    (up-research-status c: ri-ballistics < research-complete)
=>
    (set-goal bt-research-siege-package-goal ri-ballistics)
)

(defrule
    (goal bt-research-siege-package-goal 0)
    (goal bt-scorpion-ballistics-demand-goal 0)
    (goal bt-onager-demand-goal 1)
    (up-compare-goal bt-research-university-failure-backoff-goal != ri-chemistry)
    (up-research-status c: ri-chemistry < research-complete)
=>
    (set-goal bt-research-siege-package-goal ri-chemistry)
)

(defrule
    (goal bt-research-siege-package-goal 0)
    (goal bt-scorpion-ballistics-demand-goal 0)
    (goal bt-onager-demand-goal 1)
    (up-research-status c: ri-chemistry == research-complete)
    (up-compare-goal bt-research-siege-workshop-failure-backoff-goal != ri-onager)
    (up-research-status c: ri-onager < research-complete)
=>
    (set-goal bt-research-siege-package-goal ri-onager)
)

(defrule
    (goal bt-research-siege-package-goal 0)
    (goal bt-bombard-cannon-demand-goal 1)
    (up-compare-goal bt-research-university-failure-backoff-goal != ri-chemistry)
    (up-research-status c: ri-chemistry < research-complete)
=>
    (set-goal bt-research-siege-package-goal ri-chemistry)
)

(defrule
    (goal bt-research-siege-package-goal 0)
    (goal bt-ram-demand-goal 1)
    (up-research-status c: ri-capped-ram < research-complete)
=>
    (set-goal bt-research-siege-package-goal ri-capped-ram)
)

(defrule
    (goal bt-research-siege-package-goal 0)
    (goal bt-ram-demand-goal 1)
    (up-research-status c: ri-capped-ram == research-complete)
    (up-research-status c: ri-siege-ram < research-complete)
=>
    (set-goal bt-research-siege-package-goal ri-siege-ram)
)

; Completion transitions are explicit package witnesses, never retry caps.
(defrule
    (goal bt-research-siege-package-goal ri-ballistics)
    (up-research-status c: ri-ballistics == research-complete)
    (goal bt-scorpion-ballistics-demand-goal 0)
    (goal bt-onager-demand-goal 1)
    (up-research-status c: ri-chemistry < research-complete)
    (up-compare-goal bt-research-university-failure-backoff-goal != ri-chemistry)
=>
    (set-goal bt-research-siege-package-goal ri-chemistry)
)

(defrule
    (goal bt-research-siege-package-goal ri-ballistics)
    (up-research-status c: ri-ballistics == research-complete)
    (goal bt-scorpion-ballistics-demand-goal 0)
    (goal bt-onager-demand-goal 1)
    (up-research-status c: ri-chemistry == research-complete)
    (up-compare-goal bt-research-siege-workshop-failure-backoff-goal != ri-onager)
    (up-research-status c: ri-onager < research-complete)
=>
    (set-goal bt-research-siege-package-goal ri-onager)
)

(defrule
    (goal bt-research-siege-package-goal ri-ballistics)
    (up-research-status c: ri-ballistics == research-complete)
    (goal bt-scorpion-ballistics-demand-goal 0)
    (goal bt-onager-demand-goal 0)
=>
    (set-goal bt-research-siege-package-goal 0)
)

(defrule
    (goal bt-research-siege-package-goal ri-chemistry)
    (up-research-status c: ri-chemistry == research-complete)
    (goal bt-onager-demand-goal 1)
    (up-compare-goal bt-research-siege-workshop-failure-backoff-goal != ri-onager)
    (up-research-status c: ri-onager < research-complete)
=>
    (set-goal bt-research-siege-package-goal ri-onager)
)

(defrule
    (goal bt-research-siege-package-goal ri-chemistry)
    (up-research-status c: ri-chemistry == research-complete)
    (goal bt-onager-demand-goal 0)
=>
    (set-goal bt-research-siege-package-goal 0)
)

(defrule
    (goal bt-research-siege-package-goal ri-chemistry)
    (up-research-status c: ri-chemistry == research-complete)
    (up-research-status c: ri-onager == research-complete)
=>
    (set-goal bt-research-siege-package-goal 0)
)

(defrule
    (goal bt-research-siege-package-goal ri-onager)
    (up-research-status c: ri-onager == research-complete)
=>
    (set-goal bt-research-siege-package-goal 0)
)

(defrule
    (goal bt-research-siege-package-goal ri-siege-ram)
    (up-research-status c: ri-siege-ram == research-complete)
=>
    (set-goal bt-research-siege-package-goal 0)
)

(defrule
    (up-compare-goal bt-research-siege-package-goal != 0)
    (goal bt-mangonel-demand-goal 0)
    (goal bt-onager-demand-goal 0)
    (goal bt-bombard-cannon-demand-goal 0)
    (goal bt-ram-demand-goal 0)
    (goal bt-scorpion-ballistics-demand-goal 0)
=>
    (set-goal bt-research-siege-package-goal 0)
)

; MONASTERY RESEARCH EXECUTOR
;================================================================
(defrule
    (goal bt-research-monk-package-goal ri-atonement)
    (current-age >= castle-age)
    (building-type-count monastery >= 1)
    (up-compare-goal bt-research-monastery-failure-backoff-goal != ri-atonement)
    (goal bt-research-monastery-claim-goal 0)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-atonement)
=>
    (set-strategic-number sn-resource-control ri-atonement)
    (release-escrow food)
    (release-escrow gold)
    (research ri-atonement)
    (set-goal bt-research-monastery-claim-goal ri-atonement)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-research-monastery-claim-goal ri-atonement)
    (up-research-status c: ri-atonement == research-complete)
=>
    (set-goal bt-research-monastery-claim-goal 0)
    (set-goal bt-research-monk-package-goal 0)
)

(defrule
    (goal bt-research-monk-package-goal ri-redemption)
    (current-age >= castle-age)
    (building-type-count monastery >= 1)
    (up-compare-goal bt-research-monastery-failure-backoff-goal != ri-redemption)
    (goal bt-research-monastery-claim-goal 0)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-redemption)
=>
    (set-strategic-number sn-resource-control ri-redemption)
    (release-escrow food)
    (release-escrow gold)
    (research ri-redemption)
    (set-goal bt-research-monastery-claim-goal ri-redemption)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-research-monastery-claim-goal ri-redemption)
    (up-research-status c: ri-redemption == research-complete)
=>
    (set-goal bt-research-monastery-claim-goal 0)
    (set-goal bt-research-monk-package-goal 0)
)

(defrule
    (goal bt-research-monk-package-goal ri-sanctity)
    (current-age >= castle-age)
    (building-type-count monastery >= 1)
    (up-compare-goal bt-research-monastery-failure-backoff-goal != ri-sanctity)
    (goal bt-research-monastery-claim-goal 0)
    (strategic-number sn-resource-control == 0)
    (nor
        (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
        (or
            (goal bt-resource-mode-goal bt-resource-mode-food-crisis)
            (goal bt-resource-mode-goal bt-resource-mode-gold-crisis)
        )
    )
    (can-research-with-escrow ri-sanctity)
=>
    (set-strategic-number sn-resource-control ri-sanctity)
    (release-escrow food)
    (release-escrow gold)
    (research ri-sanctity)
    (set-goal bt-research-monastery-claim-goal ri-sanctity)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-research-monastery-claim-goal ri-sanctity)
    (up-research-status c: ri-sanctity == research-complete)
=>
    (set-goal bt-research-monastery-claim-goal 0)
    (set-goal bt-research-monk-package-goal 0)
)

(defrule
    (goal bt-research-monk-package-goal ri-block-printing)
    (current-age >= imperial-age)
    (building-type-count monastery >= 1)
    (up-compare-goal bt-research-monastery-failure-backoff-goal != ri-block-printing)
    (goal bt-research-monastery-claim-goal 0)
    (strategic-number sn-resource-control == 0)
    (nor
        (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
        (or
            (goal bt-resource-mode-goal bt-resource-mode-food-crisis)
            (goal bt-resource-mode-goal bt-resource-mode-gold-crisis)
        )
    )
    (can-research-with-escrow ri-block-printing)
=>
    (set-strategic-number sn-resource-control ri-block-printing)
    (release-escrow food)
    (release-escrow gold)
    (research ri-block-printing)
    (set-goal bt-research-monastery-claim-goal ri-block-printing)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-research-monastery-claim-goal ri-block-printing)
    (up-research-status c: ri-block-printing == research-complete)
=>
    (set-goal bt-research-monastery-claim-goal 0)
    (set-goal bt-research-monk-package-goal 0)
)

;================================================================
; 3. LOOM
;================================================================
; Q: "How do I write a technology rule?"
;
;   CONDITION
;       ->
;   START AUTHORITY
;       ->
;   RELEASE ESCROW
;       ->
;   RESEARCH
;       ->
;   RELEASE GLOBAL CLAIM
;       ->
;   RESEARCH-PENDING / COMPLETE
;
; Loom costs gold, so gold escrow is released.
(defrule
    (current-age == dark-age)
    (unit-type-count villager >= 7)
    (up-compare-goal bt-research-town-center-failure-backoff-goal != ri-loom)
    (strategic-number sn-resource-control == 0)
    (building-type-count town-center >= 1)
    (can-research-with-escrow ri-loom)
    (goal bt-research-town-center-claim-goal 0)
=>
    (set-strategic-number sn-resource-control ri-loom)
    (release-escrow gold)
    (research ri-loom)
    (set-goal bt-research-town-center-claim-goal ri-loom)
    (set-strategic-number sn-resource-control 0)
)

; Q: "How do I know the technology actually completed?"
;
; research-pending is not enough.
; The completion witness is research-complete.
; The capability-local claim remains live while Loom researches, but the
; global strategic mutex is already free for unrelated actions.
; Q: "What proves the Loom claim is finished?"
;
; research-complete is the terminal witness. The watchdog is stopped
; before the shared mutex is released.
(defrule
    (goal bt-research-town-center-claim-goal ri-loom)
    (up-research-status c: ri-loom == research-complete)
=>
    (set-goal bt-research-town-center-claim-goal 0)
)

;================================================================
; 4. AGE-READINESS VILLAGER STOP GATES
;================================================================
; These are temporary latches, not new state. Each gate uses the exact
; age-action predicate and clears itself by consuming train-civ-goal 1.
; Keeping the readiness tests in their own rules avoids illegal oversized
; logical operators in the production rule while preserving the can-* gate.
(defrule
    (goal train-civ-goal 1)
    (current-age == dark-age)
    (unit-type-count villager >= bt-feudal-villagers)
    (up-compare-goal bt-research-age-failure-backoff-goal != feudal-age)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow feudal-age)
=>
    (set-goal train-civ-goal -1)
)

(defrule
    (goal train-civ-goal 1)
    (current-age == feudal-age)
    (unit-type-count villager >= bt-castle-villagers)
    (goal bt-castle-commitment-goal 1)
    (up-compare-goal bt-research-age-failure-backoff-goal != castle-age)
    (strategic-number sn-resource-control == 0)
=>
    ; Castle commitment owns the TC bank. The research executor below keeps
    ; the engine-native can-research-with-escrow guard for the actual action.
    (set-goal train-civ-goal -1)
)

(defrule
    (goal train-civ-goal 1)
    (current-age == castle-age)
    (unit-type-count villager >= bt-imperial-villagers)
    (goal bt-imperial-commitment-goal 1)
    (up-compare-goal bt-research-age-failure-backoff-goal != imperial-age)
    (strategic-number sn-resource-control == 0)
=>
    ; Imperial commitment owns the TC bank. The research executor below keeps
    ; the engine-native can-research-with-escrow guard for the actual action.
    (set-goal train-civ-goal -1)
)

;================================================================
; 5. NORMAL VILLAGER PRODUCTION
;================================================================
; The normal villager-training goal must be enabled.
; An active age claim overrides ordinary production.
(defrule
    (goal train-civ-goal 1)
    (strategic-number sn-resource-control != feudal-age)
    (strategic-number sn-resource-control != castle-age)
    (strategic-number sn-resource-control != imperial-age)
    (can-train villager)
    (population-headroom > 0)
=>
    (train villager)
)

;================================================================
; 5. FEUDAL AGE
;================================================================
; Q: "How do I stop normal villager training without idling
; every Town Center?"
;
; Use train-civ-goal.
;
; Do NOT use up-reset-building on Town Centers here.
; That resets all TCs of the specified type.
(defrule
    (current-age == dark-age)
    (unit-type-count villager >= bt-feudal-villagers)
    (up-compare-goal bt-research-age-failure-backoff-goal != feudal-age)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow feudal-age)
=>
    (set-strategic-number sn-resource-control feudal-age)
    (set-goal train-civ-goal -1)
    (release-escrow food)
    (release-escrow gold)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research feudal-age)
)

; Q: "What proves the age transition actually happened?"
;
; current-age is the world-state witness.
; Q: "What proves the Feudal claim is finished?"
;
; current-age is the world-state witness. Only then is the
; research watchdog stopped and normal villager production restored.
(defrule
    (strategic-number sn-resource-control == feudal-age)
    (current-age >= feudal-age)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal train-civ-goal 1)
)

;================================================================
; 6. CASTLE AGE
;================================================================
(defrule
    (current-age == feudal-age)
    (unit-type-count villager >= bt-castle-villagers)
    (goal bt-castle-commitment-goal 1)
    (up-compare-goal bt-research-age-failure-backoff-goal != castle-age)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow castle-age)
=>
    (set-strategic-number sn-resource-control castle-age)
    (set-goal train-civ-goal -1)
    (release-escrow food)
    (release-escrow gold)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research castle-age)
)

; Q: "What proves the Castle claim is finished?"
;
; current-age is the world-state witness. The normal villager goal
; stays disabled until the age transition is actually complete.
(defrule
    (strategic-number sn-resource-control == castle-age)
    (current-age >= castle-age)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-castle-commitment-goal 0)
    ; The Feudal bank has completed its job. Release the resource-mode
    ; ownership so Castle-age consumers, including Castle stone, can arbitrate.
    (set-goal bt-resource-mode-goal 0)
    (set-goal train-civ-goal 1)
)

;================================================================
; 7. IMPERIAL AGE
;================================================================
; Byzantine competitive thresholds:
;   667 food
;   536 gold

;================================================================
; 6A. PRE-IMPERIAL CASTLE CAPABILITY
;================================================================
; This demand is created in Castle Age, before Imperial authority is
; evaluated below. It is strategic intent, not production authorization.
;
; Two valid reasons own the same finite Castle capability package:
;   1) real infantry pressure justifies the Cataphract/defensive Castle;
;   2) a mature Castle economy should secure the Byzantine Castle capability
;      before Imperial makes the decision irrelevant.
;
; The mature-economy trigger deliberately waits for 36 villagers plus
; meaningful food/gold reserves. It does not force a Castle immediately on
; reaching Castle Age and does not create a stone demand before the economy
; is ready to carry it.
(defrule
    (current-age == castle-age)
    (goal bt-castle-cataphract-demand-goal 0)
    (goal bt-castle-cataphract-failure-history-goal 0)
    (building-type-count-total castle < 1)
    (or
        (and
            (not (can-research-with-escrow imperial-age))
            (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-1)
        )
        (and
            (or
                (goal strategy-goal bt-strategy-boom)
                (goal strategy-goal bt-strategy-castle-power)
            )
            (and
                (unit-type-count villager >= 36)
                (and
                    (food-amount >= 500)
                    (gold-amount >= 200)
                )
            )
        )
    )
=>
    (set-goal bt-castle-cataphract-demand-goal 1)
    (set-goal bt-castle-mature-commitment-goal 1)
)

; Withdraw an unclaimed project when the strategic reason disappears.
; A real pending Castle foundation is never abandoned by this rule.
(defrule
    (goal bt-castle-cataphract-demand-goal 1)
    (goal bt-castle-mature-commitment-goal 0)
    (strategic-number sn-resource-control != bt-castle-cataphract-claim)
    (up-pending-objects c: castle == 0)
    (or
        (building-type-count-total castle >= 1)
        (or
        (and
            (current-age >= imperial-age)
            (goal bt-imperial-siege-package-goal 0)
        )
        (or
        (and
            (can-research-with-escrow imperial-age)
            (not
                (or
                    (goal strategy-goal bt-strategy-boom)
                    (or
                        (goal strategy-goal bt-strategy-castle-power)
                        (goal strategy-goal bt-strategy-flush)
                    )
                )
            )
        )
        (or
        (not
            (or
                (goal strategy-goal bt-strategy-boom)
                (goal strategy-goal bt-strategy-flush)
            )
        )
        (players-unit-type-count any-enemy militiaman-line < bt-cataphract-enemy-threshold-1)
            )
            )
            )
    )
=>
    (disable-timer bt-castle-cataphract-backoff-timer)
    (set-goal bt-castle-cataphract-demand-goal 0)
    (set-goal bt-castle-cataphract-backoff-goal 0)
)

; Imperial siege recovery reuses the existing Castle capability lifecycle.
; A missing Castle is an executable capability gap, not a new subsystem.
(defrule
    (goal bt-imperial-siege-package-goal 1)
    (current-age >= imperial-age)
    (building-type-count-total castle < 1)
    (up-pending-objects c: castle == 0)
    (goal bt-castle-cataphract-demand-goal 0)
    (goal bt-castle-cataphract-backoff-goal 0)
    (player-in-game target-player)
    (players-building-count target-player > 0)
    (stone-amount >= bt-forward-castle-stone-floor)
    (up-compare-goal bt-relative-force-goal >= bt-forward-castle-force-floor)
    (up-compare-goal bt-attack-reserve-goal >= bt-forward-castle-reserve-floor)
=>
    (set-goal bt-castle-cataphract-demand-goal 1)
)

; Imperial Cataphract recovery reuses the existing Castle project lifecycle after
; the civilization has aged past the original Castle-demand creation window.
; Imperial Cataphract recovery reuses the existing Castle project lifecycle after
; the civilization has aged past the original Castle-demand creation window.
(defrule
    (goal bt-cataphract-demand-goal 1)
    (goal bt-castle-cataphract-demand-goal 0)
    (goal bt-castle-cataphract-failure-history-goal 0)
    (goal bt-castle-cataphract-backoff-goal 0)
    (current-age >= imperial-age)
    (building-type-count-total castle < 1)
    (up-pending-objects c: castle == 0)
    (or
        (goal strategy-goal bt-strategy-boom)
        (goal strategy-goal bt-strategy-flush)
    )
    (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-1)
=>
    (set-goal bt-castle-cataphract-demand-goal 1)
)

; Construction failure is temporary execution state. Once the
; strategic trigger disappears, the failure-history witness is cleared for future use.
(defrule
    (goal bt-castle-cataphract-failure-history-goal 1)
    (or
        (current-age >= imperial-age)
        (or
        (building-type-count-total castle >= 1)
        (or
        (not
            (or
                (goal strategy-goal bt-strategy-boom)
                (goal strategy-goal bt-strategy-flush)
            )
        )
        (or
        (players-unit-type-count any-enemy militiaman-line < bt-cataphract-enemy-threshold-1)
        (unit-type-count-total cataphract-line >= bt-cataphract-target-1)
            )
            )
            )
    )
=>
    (set-goal bt-castle-cataphract-failure-history-goal 0)
)

; Imperial age authority owns the transition once the civilian threshold is
; reached. Castle/Cataphract capability state is independent of this age gate.
(defrule
    (current-age == castle-age)
    (unit-type-count villager >= bt-imperial-villagers)
    (goal bt-imperial-commitment-goal 1)
    (building-type-count-total castle >= 1)
    (up-compare-goal bt-research-age-failure-backoff-goal != imperial-age)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow imperial-age)
=>
    (set-strategic-number sn-resource-control imperial-age)
    (set-goal train-civ-goal -1)
    (release-escrow food)
    (release-escrow gold)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research imperial-age)
)

; Q: "What proves the Imperial claim is finished?"
;
; current-age is the world-state witness. The watchdog is not allowed
; to release a still-running age transition.
(defrule
    (strategic-number sn-resource-control == imperial-age)
    (current-age >= imperial-age)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-imperial-commitment-goal 0)
    (set-goal train-civ-goal 1)
)

;----------------------------------------------------------------
; BASILISK STRATEGIC NARRATION: AGE-UP LIFECYCLE
; Each milestone has an independent latch. A shared last-event latch can make
; earlier lifecycle messages fire again after later milestones change its code.
;----------------------------------------------------------------
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (current-age == dark-age)
    (unit-type-count villager >= bt-feudal-villagers)
    (can-research-with-escrow feudal-age)
    (goal bt-debug-age-feudal-bank-goal 0)
=>
    (chat-local-to-self "BASILISK | AGE | Feudal bank committed.")
    (set-goal bt-debug-age-feudal-bank-goal 1)
)
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (current-age == dark-age)
    (up-research-status c: feudal-age >= research-pending)
    (goal bt-debug-age-feudal-start-goal 0)
=>
    (chat-local-to-self "BASILISK | AGE | Feudal research started.")
    (set-goal bt-debug-age-feudal-start-goal 1)
)
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (current-age >= feudal-age)
    (goal bt-debug-age-feudal-complete-goal 0)
=>
    (chat-local-to-self "BASILISK | AGE | Feudal complete.")
    (set-goal bt-debug-age-feudal-complete-goal 1)
)
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (current-age == feudal-age)
    (goal bt-castle-commitment-goal 1)
    (goal bt-debug-age-castle-bank-goal 0)
=>
    (chat-local-to-self "BASILISK | AGE | Castle bank committed.")
    (set-goal bt-debug-age-castle-bank-goal 1)
)
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (current-age == feudal-age)
    (up-research-status c: castle-age >= research-pending)
    (goal bt-debug-age-castle-start-goal 0)
=>
    (chat-local-to-self "BASILISK | AGE | Castle research started.")
    (set-goal bt-debug-age-castle-start-goal 1)
)
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (current-age >= castle-age)
    (goal bt-debug-age-castle-complete-goal 0)
=>
    (chat-local-to-self "BASILISK | AGE | Castle complete.")
    (set-goal bt-debug-age-castle-complete-goal 1)
)
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (current-age == castle-age)
    (goal bt-imperial-commitment-goal 1)
    (unit-type-count villager >= bt-imperial-villagers)
    (can-research-with-escrow imperial-age)
    (goal bt-debug-age-imperial-bank-goal 0)
=>
    (chat-local-to-self "BASILISK | AGE | Imperial bank committed.")
    (set-goal bt-debug-age-imperial-bank-goal 1)
)
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (current-age == castle-age)
    (up-research-status c: imperial-age >= research-pending)
    (goal bt-debug-age-imperial-start-goal 0)
=>
    (chat-local-to-self "BASILISK | AGE | Imperial research started.")
    (set-goal bt-debug-age-imperial-start-goal 1)
)
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (current-age >= imperial-age)
    (goal bt-debug-age-imperial-complete-goal 0)
=>
    (chat-local-to-self "BASILISK | AGE | Imperial complete.")
    (set-goal bt-debug-age-imperial-complete-goal 1)
)


;================================================================
; 8. HOUSING
;================================================================
; Resource-local housing hygiene. When a lumber camp already exists, place
; the next house around that active woodline rather than defaulting every house
; to the Town Center area. The generic housing rule remains the fallback.
(defrule
    (housing-headroom <= 5)
    (up-pending-objects c: house == 0)
    (building-type-count-total lumber-camp >= 1)
    (can-build house)
=>
    (up-set-placement-data my-player-number lumber-camp c: 6)
    (up-build place-control 0 c: house)
)

; Q: "How do I prevent a population-cap stall?"
(defrule
    ; Keep one house ahead of the normal four-headroom trigger so fast villager
    ; production and woodline expansions do not hit the population cap.
    (housing-headroom <= 5)
    (up-pending-objects c: house == 0)
    (can-build house)
=>
    (build house)
)

;================================================================
; 9. BASIC ECONOMIC BUILDINGS
;================================================================
(defrule
    (building-type-count-total lumber-camp == 0)
    (civilian-population >= 7)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)

(defrule
    (building-type-count-total mining-camp == 0)
    (civilian-population >= 8)
    (can-build mining-camp)
=>
    (build mining-camp)
)

;----------------------------------------------------------------
; VILLAGER / DROPSITE HYGIENE
; Community-native maintenance rules. These are capability repairs only:
; they do not create a second economic allocator.
;----------------------------------------------------------------

; 1. WOOD DROPSITE REFRESH
; Keep wood walking distance bounded once a usable forest is actually known.
(defrule
    (strategic-number sn-wood-gatherer-percentage > 0)
    (resource-found wood)
    (dropsite-min-distance wood > 8)
    (building-type-count-total lumber-camp < 4)
    (up-pending-objects c: lumber-camp == 0)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)

; 2. GOLD DROPSITE REFRESH
(defrule
    (strategic-number sn-gold-gatherer-percentage > 0)
    (resource-found gold)
    (dropsite-min-distance gold > 8)
    (building-type-count-total mining-camp < 3)
    (up-pending-objects c: mining-camp == 0)
    (can-build mining-camp)
=>
    (build mining-camp)
)

; 3. STONE DROPSITE REFRESH
(defrule
    (strategic-number sn-stone-gatherer-percentage > 0)
    (resource-found stone)
    (dropsite-min-distance stone > 8)
    (building-type-count-total mining-camp < 3)
    (up-pending-objects c: mining-camp == 0)
    (can-build mining-camp)
=>
    (build mining-camp)
)

; 4. SMALL SCOUT-RAID VILLAGER DEFENSE
; Find the attacking player first so the remote search is target-specific.
; Only 1-2 enemy scout-cavalry-line units trigger this reflex. Six nearby
; villagers are enough to discourage a tiny raid without creating a standing
; villager-combat system.
(defrule
    (up-enemy-units-in-town >= 1)
    (players-unit-type-count any-enemy scout-cavalry-line >= 1)
    (players-unit-type-count any-enemy scout-cavalry-line <= 2)
    (unit-type-count villager >= 6)
=>
    (up-find-next-player enemy find-attacker bt-villager-defense-raider-player-goal)
    (up-modify-sn sn-focus-player-number g:= bt-villager-defense-raider-player-goal)
)

(defrule
    (up-compare-goal bt-villager-defense-raider-player-goal > 0)
    (players-unit-type-count focus-player scout-cavalry-line >= 1)
    (players-unit-type-count focus-player scout-cavalry-line <= 2)
=>
    (up-full-reset-search)
    (up-reset-filters)
    (up-find-local c: town-center c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object bt-villager-defense-point-goal)
    (up-reset-search 1 1 0 0)
    (up-set-target-point bt-villager-defense-point-goal)
    (up-filter-distance c: -1 c: 10)
    (up-find-local c: villager-class c: 6)
    (up-get-fact player-number 0 bt-villager-defense-self-player-goal)
    (up-modify-sn sn-focus-player-number g:= bt-villager-defense-raider-player-goal)
    (up-find-remote c: scout-cavalry-line c: 2)
    (up-target-objects 0 action-default -1 stance-defensive)
    (up-modify-sn sn-focus-player-number g:= bt-villager-defense-self-player-goal)
)


;----------------------------------------------------------------
; 11. MILL FOOD-INFRASTRUCTURE LIFECYCLE
;----------------------------------------------------------------
; First-mill demand preserves the previous behavior: a mill becomes a
; valid target once the civilian population reaches 10 and no mill exists.
; Demand is stored separately from resource authority.
(defrule
    (goal bt-mill-target-goal 0)
    (building-type-count-total mill == 0)
    (up-pending-objects c: mill == 0)
    (civilian-population >= 10)
=>
    (set-goal bt-mill-target-goal 1)
)

; The second mill is justified by farm density, with completed Town
; Centers acting as the scale modifier rather than as a direct trigger.
; One TC requires 8 farms; two or more require 14 farms.
(defrule
    (goal bt-mill-target-goal 1)
    (building-type-count mill >= 1)
    (building-type-count town-center == 1)
    (building-type-count-total farm >= bt-mill-second-farm-threshold-1tc)
=>
    (set-goal bt-mill-target-goal 2)
)

(defrule
    (goal bt-mill-target-goal 1)
    (building-type-count mill >= 1)
    (building-type-count town-center >= 2)
    (building-type-count-total farm >= bt-mill-second-farm-threshold-2tc)
=>
    (set-goal bt-mill-target-goal 2)
)

(defrule
    (goal bt-mill-target-goal 2)
    (building-type-count mill >= 2)
    (building-type-count town-center >= 3)
    (building-type-count-total farm >= bt-mill-third-farm-threshold-3tc)
=>
    (set-goal bt-mill-target-goal 3)
)
(defrule
    (goal bt-mill-target-goal 2)
    (building-type-count mill >= 2)
    (building-type-count town-center >= 4)
    (building-type-count-total farm >= bt-mill-third-farm-threshold-4tc)
=>
    (set-goal bt-mill-target-goal 3)
)

; Demand is distinct from action. The project remains pending while another
; resource claim owns the bank. No second request is emitted while a mill
; object is already pending.
(defrule
    (goal bt-mill-target-goal 1)
    (goal bt-mill-project-goal 0)
    (building-type-count-total mill == 0)
    (up-pending-objects c: mill == 0)
=>
    (set-goal bt-mill-project-goal 1)
)

(defrule
    (goal bt-mill-target-goal 2)
    (goal bt-mill-project-goal 0)
    (building-type-count-total mill < 2)
    (up-pending-objects c: mill == 0)
=>
    (set-goal bt-mill-project-goal 2)
)

(defrule
    (goal bt-mill-target-goal 3)
    (goal bt-mill-project-goal 0)
    (building-type-count-total mill < 3)
    (up-pending-objects c: mill == 0)
=>
    (set-goal bt-mill-project-goal 3)
)

; First Mill: keep the existing generic engine placement.
(defrule
    (goal bt-mill-project-goal 1)
    (goal bt-mill-backoff-goal 0)
    (strategic-number sn-resource-control == 0)
    (not (and
        (current-age == feudal-age)
        (or
            (can-research-with-escrow castle-age)
            (goal bt-castle-commitment-goal 1)
        )
    ))
    (up-pending-objects c: mill == 0)
    (civilian-population >= 10)
    (can-build-with-escrow mill)
=>
    (set-strategic-number sn-resource-control bt-mill-claim)
    (release-escrow wood)
    (enable-timer bt-mill-watchdog-timer bt-mill-watchdog-seconds)
    (build mill)
)

; Later Mills: center the placement on the latest completed Farm. The
; compact zone keeps the initial search near food infrastructure, while
; dropsite separation rejects Mill-on-Mill placement and fish-pond wandering.
(defrule
    (up-compare-goal bt-mill-project-goal >= 2)
    (current-age >= feudal-age)
    (building-type-count farm >= 1)
    (goal bt-mill-backoff-goal 0)
    (strategic-number sn-resource-control == 0)
    (not (and
        (current-age == feudal-age)
        (or
            (can-research-with-escrow castle-age)
            (goal bt-castle-commitment-goal 1)
        )
    ))
    (up-pending-objects c: mill == 0)
    (civilian-population >= 10)
    (can-build-with-escrow mill)
=>
    (up-set-placement-data my-player-number farm c: 0)
    (set-strategic-number sn-placement-zone-size bt-mill-placement-zone-size)
    (set-strategic-number sn-dropsite-separation-distance bt-mill-placement-separation-distance)
    (set-strategic-number sn-resource-control bt-mill-claim)
    (release-escrow wood)
    (enable-timer bt-mill-watchdog-timer bt-mill-watchdog-seconds)
    (up-build place-control 0 c: mill)
)

(defrule
    (building-type-count-total barracks == 0)
    (civilian-population >= 12)
    (can-build barracks)
=>
    (build barracks)
)

;================================================================
; 10. BOAR HUNTING / NATURAL-FOOD CONTROL
;================================================================
; Q: "How does a competitive heuristic AI turn the engine's native food system
; into a practical early-game food income?"
;
; Do NOT write a villager-by-villager food allocator here.
; The engine already owns normal food-source selection. Our job is
; to configure the native hunt controller when a live boar is close
; enough to justify it, then return control to normal hunting when
; the boar is gone or too far away.
;
; COMMUNITY META PATTERN:
;   live boar detected
;       ->
;   enable boar hunting
;       ->
;   require at least one hunter
;       ->
;   allow a one-villager lure
;       ->
;   request support hunters
;       ->
;   once the boar is under the TC, maintain the hunt group
;       ->
;   current boar nearly exhausted + another live boar available
;       -> reset to one-lurer mode for the next boar
;       ->
;   when no usable live boar remains, restore normal hunting
;
; This is deliberately smaller than a full food-economy model.
; The controller principle is that:
;
;   OBSERVATION
;       !=
;   MANUAL VILLAGER ASSIGNMENT
;
; The observation changes an engine-native subsystem's policy.
;
; The community references use dropsite-min-distance live-boar,
; sn-enable-boar-hunting, sn-minimum-number-hunters,
; sn-minimum-boar-lure-group-size, sn-minimum-boar-hunt-group-size,
; sn-maximum-hunt-drop-distance, and up-request-hunters.
;
; up-request-hunters is a request, not a guarantee. The engine may
; fail to reach the requested total when suitable villagers are not
; available.
;
;----------------------------------------------------------------
; 10A. INITIAL FOOD-HUNT POLICY
;----------------------------------------------------------------
; Start with normal hunting behavior. A later live-boar rule takes
; ownership only when the engine can actually see a live boar.
(defrule
    (true)
=>
    (set-strategic-number sn-enable-boar-hunting 1)
    (set-strategic-number sn-minimum-number-hunters 0)
    (set-strategic-number sn-minimum-boar-lure-group-size 0)
    (set-strategic-number sn-minimum-boar-hunt-group-size 0)
    (set-strategic-number sn-maximum-hunt-drop-distance 8)
    (disable-self)
)

;----------------------------------------------------------------
; 10B. START / MAINTAIN THE BOAR LURE
;----------------------------------------------------------------
; A live boar within 32 tiles is close enough for the engine's native
; hunt controller to use as the preferred early food source.
;
; The minimum hunter count of 1 creates the initial lurer.
; The lure group size of 1 keeps the opening deterministic.
(defrule
    (unit-type-count villager >= 9)
    (unit-type-count villager-hunter == 0)
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 32)
=>
    (set-strategic-number sn-enable-boar-hunting 2)
    (set-strategic-number sn-minimum-number-hunters 1)
    (set-strategic-number sn-minimum-boar-lure-group-size 1)
    (set-strategic-number sn-minimum-boar-hunt-group-size 1)
    (set-strategic-number sn-maximum-hunt-drop-distance 32)
    (set-strategic-number sn-maximum-food-drop-distance 16)
    (up-request-hunters c: 1)
)

;----------------------------------------------------------------
; 10C. SUPPORT THE ACTIVE BOAR UNDER THE TOWN CENTER
;----------------------------------------------------------------
; Once the boar is very close, use the community-standard hunt-group
; behavior: request a larger total hunting group rather than manually
; retasking individual villagers.
;
; Seven is a hunt-group target, not a promise that seven villagers
; will always be available.
(defrule
    (unit-type-count villager >= 9)
    (strategic-number sn-minimum-number-hunters < 7)
    (unit-type-count villager-hunter < 7)
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 10)
=>
    (set-strategic-number sn-enable-boar-hunting 2)
    (set-strategic-number sn-minimum-number-hunters 7)
    (set-strategic-number sn-minimum-boar-hunt-group-size 7)
    (up-request-hunters c: 6)
)

;----------------------------------------------------------------
; 10D. MOVE FROM A FINISHED BOAR TO THE NEXT LURE
;----------------------------------------------------------------
; live-boar deliberately reports the next living boar, while
; boar-hunting describes the nearest boar being hunted. The distinction
; matters after the first boar is down: using live-boar alone cannot tell
; us that the current hunt is nearly finished.
;
; up-remaining-boar-amount is valid only when a current/next boar exists;
; 65535 means there is no valid boar. Therefore <195 is a safe "current
; boar is low and another boar is available" signal.
;
; This is the smallest second-boar closure. We do not manually select a
; lurer or direct units. We simply return the native hunt controller to
; one-lurer mode so it can begin the next lure.
(defrule
    (strategic-number sn-enable-boar-hunting == 2)
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 32)
    (dropsite-min-distance boar-hunting >= 0)
    (dropsite-min-distance boar-hunting <= 10)
    (up-remaining-boar-amount < 195)
    (strategic-number sn-minimum-number-hunters > 1)
=>
    (set-strategic-number sn-minimum-number-hunters 1)
    (set-strategic-number sn-minimum-boar-hunt-group-size 1)
    (set-strategic-number sn-minimum-boar-lure-group-size 1)
    (up-request-hunters c: 1)
)

;----------------------------------------------------------------
; 10E. BOAR GONE / TOO FAR -> NORMAL HUNTING
;----------------------------------------------------------------
; Once no usable live boar is available, stop forcing the boar
; subsystem and let normal hunting choose deer/forage/farms.
(defrule
    (or
        (dropsite-min-distance live-boar == -1)
        (dropsite-min-distance live-boar > 32)
    )
=>
    (set-strategic-number sn-enable-boar-hunting 1)
    (set-strategic-number sn-minimum-number-hunters 0)
    (set-strategic-number sn-minimum-boar-lure-group-size 0)
    (set-strategic-number sn-minimum-boar-hunt-group-size 0)
    (set-strategic-number sn-maximum-hunt-drop-distance 8)
)
;----------------------------------------------------------------
; 10F. NATURAL-FOOD TRANSITION STATE
;----------------------------------------------------------------
; Farm logic must not treat deer as the definition of "natural food."
; The engine already handles normal food-source selection. This small
; derived state only answers how aggressively the farm-capacity layer
; should replace natural land food.
;
; STATE 0: STABLE
;   Boar control is active, or both deer and nearby sheep/forage remain
;   viable. Existing food-stock rules remain conservative.
;
; STATE 1: TRANSITION
;   No active boar hunt, and exactly one of the two major land-food
;   witnesses has become unavailable: deer or nearby sheep/forage.
;
; STATE 2: DEPLETED
;   No active boar hunt, deer is unavailable, and nearby sheep/forage
;   is also unavailable.
;
; Fish is deliberately not made a hard farm predicate. No current
; controller fact is strong enough to make "shore fish gone" equivalent
; to "natural food depleted." Fish therefore remains inside the engine's
; normal food-source selection.
;
; The deer threshold is evaluated here once. The mutable hunt-distance
; SN remains owned by the boar subsystem; farm rules consume only this
; derived state instead of inheriting that coupling directly.
(defrule
    (true)
=>
    (set-goal bt-natural-food-state-goal bt-natural-food-stable)
)

; Recovery closes the natural-food lifecycle. The transition/depleted
; writers require hunting to be off, preventing same-pass oscillation.
(defrule
    (or
        (goal bt-natural-food-state-goal bt-natural-food-transition)
        (goal bt-natural-food-state-goal bt-natural-food-depleted)
    )
    (or
        (strategic-number sn-enable-boar-hunting == 2)
        (and
            (not (sheep-and-forage-too-far))
            (and
            (not (dropsite-min-distance deer-hunting == -1))
            (and
            (not (dropsite-min-distance deer-hunting == 255))
            (not (dropsite-min-distance deer-hunting s:> sn-maximum-hunt-drop-distance))
                    )
                    )
        )
    )
=>
    (set-goal bt-natural-food-state-goal bt-natural-food-stable)
)

(defrule
    (strategic-number sn-enable-boar-hunting != 2)
    (sheep-and-forage-too-far)
    (not (dropsite-min-distance deer-hunting == -1))
    (not (dropsite-min-distance deer-hunting == 255))
    (not (dropsite-min-distance deer-hunting s:> sn-maximum-hunt-drop-distance))
=>
    (set-goal bt-natural-food-state-goal bt-natural-food-transition)
)

(defrule
    (strategic-number sn-enable-boar-hunting != 2)
    (not (sheep-and-forage-too-far))
    (or (dropsite-min-distance deer-hunting == -1) (or (dropsite-min-distance deer-hunting == 255) (dropsite-min-distance deer-hunting s:> sn-maximum-hunt-drop-distance)))
=>
    (set-goal bt-natural-food-state-goal bt-natural-food-transition)
)

(defrule
    (strategic-number sn-enable-boar-hunting != 2)
    (sheep-and-forage-too-far)
    (or (dropsite-min-distance deer-hunting == -1) (or (dropsite-min-distance deer-hunting == 255) (dropsite-min-distance deer-hunting s:> sn-maximum-hunt-drop-distance)))
=>
    (set-goal bt-natural-food-state-goal bt-natural-food-depleted)
)

;================================================================
; 11. HORSE COLLAR
;================================================================
; Horse Collar has persistent Feudal demand so a temporary research
; collision cannot erase the upgrade from the decision state.
(defrule
    (goal bt-horse-collar-demand-goal 0)
    (current-age == feudal-age)
    (up-research-status c: ri-horse-collar == research-available)
    (building-type-count mill >= 1)
=>
    (set-goal bt-horse-collar-demand-goal 1)
)

; Closing the Feudal window clears only an unneeded future demand.
; A live research claim remains execution-owned until completion.
(defrule
    (goal bt-horse-collar-demand-goal 1)
    (goal bt-research-mill-claim-goal 0)
    (or
        (current-age != feudal-age)
        (up-research-status c: ri-horse-collar == research-complete)
    )
=>
    (set-goal bt-horse-collar-demand-goal 0)
)

; Actual execution keeps the engine-native can-research gate, but unrelated
; military package cursors no longer veto the Feudal eco investment.
(defrule
    (goal bt-horse-collar-demand-goal 1)
    (current-age == feudal-age)
    (up-compare-goal bt-research-mill-failure-backoff-goal != ri-horse-collar)
    (strategic-number sn-resource-control == 0)
    (not (goal bt-castle-commitment-goal 1))
    (building-type-count mill >= 1)
    (can-research-with-escrow ri-horse-collar)
    (goal bt-research-mill-claim-goal 0)
=>
    (set-strategic-number sn-resource-control ri-horse-collar)
    (release-escrow food)
    (release-escrow wood)
    (research ri-horse-collar)
    (set-goal bt-research-mill-claim-goal ri-horse-collar)
    (set-strategic-number sn-resource-control 0)
)

; Q: "What proves the Horse Collar claim is finished?"
;
; research-complete is the terminal witness for the technology claim.
(defrule
    (goal bt-research-mill-claim-goal ri-horse-collar)
    (up-research-status c: ri-horse-collar == research-complete)
=>
    (set-goal bt-research-mill-claim-goal 0)
    (set-goal bt-horse-collar-demand-goal 0)
)

;================================================================
; 11A. CASTLE FARM TECHNOLOGY
;================================================================
; Heavy Plow is the Castle-age continuation of the Mill farm lifecycle.
; Demand starts on a modest 8-farm base so the upgrade arrives before the
; economy has already spent a pile of wood compensating for the missing tech.
(defrule
    (goal bt-heavy-plow-demand-goal 0)
    (current-age == castle-age)
    (up-research-status c: ri-horse-collar >= research-complete)
    (building-type-count-total farm >= bt-mill-second-farm-threshold-1tc)
    (up-research-status c: ri-heavy-plow == research-available)
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
=>
    (set-goal bt-heavy-plow-demand-goal 1)
)

; Strategic invalidation only. Temporary resource contention and provider
; loss do not erase Heavy Plow demand; the executor owns feasibility.
; Four independent invalidation witnesses. Keep each rule parser-simple:
; demand is cleared whenever any terminal strategic condition becomes true.
(defrule
    (goal bt-heavy-plow-demand-goal 1)
    (goal bt-research-mill-claim-goal 0)
    (current-age > castle-age)
=>
    (set-goal bt-heavy-plow-demand-goal 0)
)

(defrule
    (goal bt-heavy-plow-demand-goal 1)
    (goal bt-research-mill-claim-goal 0)
    (up-research-status c: ri-heavy-plow >= research-complete)
=>
    (set-goal bt-heavy-plow-demand-goal 0)
)

(defrule
    (goal bt-heavy-plow-demand-goal 1)
    (goal bt-research-mill-claim-goal 0)
    (can-research-with-escrow imperial-age)
=>
    (set-goal bt-heavy-plow-demand-goal 0)
)

(defrule
    (goal bt-heavy-plow-demand-goal 1)
    (goal bt-research-mill-claim-goal 0)
    (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
=>
    (set-goal bt-heavy-plow-demand-goal 0)
)

; Demand -> claim -> release Food + Wood escrow -> research.
; Military package cursors are strategic intent, not eco-tech feasibility.
(defrule
    (goal bt-heavy-plow-demand-goal 1)
    (current-age == castle-age)
    (up-compare-goal bt-research-mill-failure-backoff-goal != ri-heavy-plow)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (building-type-count mill >= 1)
    (can-research-with-escrow ri-heavy-plow)
    (goal bt-research-mill-claim-goal 0)
=>
    (set-strategic-number sn-resource-control ri-heavy-plow)
    (release-escrow food)
    (release-escrow wood)
    (research ri-heavy-plow)
    (set-goal bt-research-mill-claim-goal ri-heavy-plow)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-research-mill-claim-goal ri-heavy-plow)
    (up-research-status c: ri-heavy-plow == research-complete)
=>
    (set-goal bt-research-mill-claim-goal 0)
    (set-goal bt-heavy-plow-demand-goal 0)
)

;================================================================
; 11B. IMPERIAL FARM TECHNOLOGY
;================================================================
; Crop Rotation is the final Mill farm lifecycle step. At Imperial,
; it is a selective late-eco investment: require a mature completed-farm
; base so the 250F/250W research is not purchased merely because it is affordable.
(defrule
    (current-age >= imperial-age)
    (building-type-count farm >= bt-crop-rotation-farm-threshold)
    (up-research-status c: ri-heavy-plow >= research-complete)
    (up-compare-goal bt-research-mill-failure-backoff-goal != ri-crop-rotation)
    (strategic-number sn-resource-control == 0)
    (building-type-count mill >= 1)
    (can-research-with-escrow ri-crop-rotation)
    (goal bt-research-mill-claim-goal 0)
    (goal bt-research-cavalry-counter-package-goal 0)
    (goal bt-research-ranged-counter-package-goal 0)
    (goal bt-research-cataphract-package-goal 0)
    (goal bt-research-siege-package-goal 0)
    (goal bt-research-monk-package-goal 0)
=>
    (set-strategic-number sn-resource-control ri-crop-rotation)
    (release-escrow food)
    (release-escrow wood)
    (research ri-crop-rotation)
    (set-goal bt-research-mill-claim-goal ri-crop-rotation)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-research-mill-claim-goal ri-crop-rotation)
    (up-research-status c: ri-crop-rotation == research-complete)
=>
    (set-goal bt-research-mill-claim-goal 0)
)

;================================================================
; 11. FARM TRANSITION
;================================================================
; Farm construction consumes three existing signals without creating
; a second economy:
;
;   - food policy / stockpile pressure
;   - natural-food transition state
;   - idle-farm capacity
;
; Natural-food state is derived by section 10/10F:
;   STABLE     = boar active, or both deer + sheep/forage are viable
;   TRANSITION = one major land-food source has become unavailable
;   DEPLETED   = both major land-food sources are unavailable and boar
;                hunting is no longer active
;
; Farms are food capacity. Horse Collar / Heavy Plow / Crop Rotation
; are efficiency technologies, not universal prerequisites for the
; physical existence of a farm. Their research lifecycle remains
; owned by section 11 and sn-resource-control.
;
; building-type-count-total farm includes existing and queued farms;
; it remains the hard age-cap witness. The explicit pending-object
; guard below is therefore not about the cap; it rate-limits farm
; construction to one active placement at a time.
;
; A healthy natural-food state preserves the old conservative
; food-stock trigger. Transition/depleted states use the actual food
; gatherer policy instead of an arbitrary minimum food percentage, so
; 45% food modes can still maintain farm capacity when natural land
; food weakens. The pending guard prevents a farm flood.
;
;----------------------------------------------------------------
; 11A. FOOD-DEMAND RESERVES
;----------------------------------------------------------------
; Food-demand reserves are derived directly from the live food-gatherer
; percentage and civilian population. The engine does not expose a
; convenient integer multiplication primitive, so the thresholds are
; coarse, age-specific capacity witnesses rather than exact arithmetic.
(defrule
    (current-age == feudal-age)
    (strategic-number sn-food-gatherer-percentage >= 55)
    (civilian-population < 28)
=>
    (set-goal bt-farm-transition-reserve-goal 2)
    (set-goal bt-farm-depleted-reserve-goal 3)
)
(defrule
    (current-age == feudal-age)
    (strategic-number sn-food-gatherer-percentage >= 55)
    (civilian-population >= 28)
    (civilian-population < 37)
=>
    (set-goal bt-farm-transition-reserve-goal 3)
    (set-goal bt-farm-depleted-reserve-goal 4)
)
(defrule
    (current-age == feudal-age)
    (strategic-number sn-food-gatherer-percentage >= 55)
    (civilian-population >= 37)
    (civilian-population < 46)
=>
    (set-goal bt-farm-transition-reserve-goal 4)
    (set-goal bt-farm-depleted-reserve-goal 6)
)
(defrule
    (current-age == feudal-age)
    (strategic-number sn-food-gatherer-percentage >= 55)
    (civilian-population >= 46)
=>
    (set-goal bt-farm-transition-reserve-goal 5)
    (set-goal bt-farm-depleted-reserve-goal 7)
)
(defrule
    (current-age == feudal-age)
    (strategic-number sn-food-gatherer-percentage < 55)
    (civilian-population < 30)
=>
    (set-goal bt-farm-transition-reserve-goal 2)
    (set-goal bt-farm-depleted-reserve-goal 3)
)
(defrule
    (current-age == feudal-age)
    (strategic-number sn-food-gatherer-percentage < 55)
    (civilian-population >= 30)
    (civilian-population < 40)
=>
    (set-goal bt-farm-transition-reserve-goal 3)
    (set-goal bt-farm-depleted-reserve-goal 4)
)
(defrule
    (current-age == feudal-age)
    (strategic-number sn-food-gatherer-percentage < 55)
    (civilian-population >= 40)
    (civilian-population < 50)
=>
    (set-goal bt-farm-transition-reserve-goal 4)
    (set-goal bt-farm-depleted-reserve-goal 6)
)
(defrule
    (current-age == feudal-age)
    (strategic-number sn-food-gatherer-percentage < 55)
    (civilian-population >= 50)
=>
    (set-goal bt-farm-transition-reserve-goal 5)
    (set-goal bt-farm-depleted-reserve-goal 7)
)
(defrule
    (current-age == castle-age)
    (strategic-number sn-food-gatherer-percentage >= 55)
    (civilian-population < 30)
=>
    (set-goal bt-farm-transition-reserve-goal 2)
    (set-goal bt-farm-depleted-reserve-goal 4)
)
(defrule
    (current-age == castle-age)
    (strategic-number sn-food-gatherer-percentage >= 55)
    (civilian-population >= 30)
    (civilian-population < 41)
=>
    (set-goal bt-farm-transition-reserve-goal 3)
    (set-goal bt-farm-depleted-reserve-goal 5)
)
(defrule
    (current-age == castle-age)
    (strategic-number sn-food-gatherer-percentage >= 55)
    (civilian-population >= 41)
    (civilian-population < 52)
=>
    (set-goal bt-farm-transition-reserve-goal 4)
    (set-goal bt-farm-depleted-reserve-goal 7)
)
(defrule
    (current-age == castle-age)
    (strategic-number sn-food-gatherer-percentage >= 55)
    (civilian-population >= 52)
=>
    (set-goal bt-farm-transition-reserve-goal 5)
    (set-goal bt-farm-depleted-reserve-goal 9)
)
(defrule
    (current-age == castle-age)
    (strategic-number sn-food-gatherer-percentage < 55)
    (civilian-population < 33)
=>
    (set-goal bt-farm-transition-reserve-goal 2)
    (set-goal bt-farm-depleted-reserve-goal 4)
)
(defrule
    (current-age == castle-age)
    (strategic-number sn-food-gatherer-percentage < 55)
    (civilian-population >= 33)
    (civilian-population < 45)
=>
    (set-goal bt-farm-transition-reserve-goal 3)
    (set-goal bt-farm-depleted-reserve-goal 5)
)
(defrule
    (current-age == castle-age)
    (strategic-number sn-food-gatherer-percentage < 55)
    (civilian-population >= 45)
    (civilian-population < 57)
=>
    (set-goal bt-farm-transition-reserve-goal 4)
    (set-goal bt-farm-depleted-reserve-goal 7)
)
(defrule
    (current-age == castle-age)
    (strategic-number sn-food-gatherer-percentage < 55)
    (civilian-population >= 57)
=>
    (set-goal bt-farm-transition-reserve-goal 5)
    (set-goal bt-farm-depleted-reserve-goal 9)
)
(defrule
    (current-age >= imperial-age)
    (strategic-number sn-food-gatherer-percentage >= 55)
    (civilian-population < 38)
=>
    (set-goal bt-farm-transition-reserve-goal 2)
    (set-goal bt-farm-depleted-reserve-goal 4)
)
(defrule
    (current-age >= imperial-age)
    (strategic-number sn-food-gatherer-percentage >= 55)
    (civilian-population >= 38)
    (civilian-population < 50)
=>
    (set-goal bt-farm-transition-reserve-goal 3)
    (set-goal bt-farm-depleted-reserve-goal 6)
)
(defrule
    (current-age >= imperial-age)
    (strategic-number sn-food-gatherer-percentage >= 55)
    (civilian-population >= 50)
    (civilian-population < 64)
=>
    (set-goal bt-farm-transition-reserve-goal 5)
    (set-goal bt-farm-depleted-reserve-goal 8)
)
(defrule
    (current-age >= imperial-age)
    (strategic-number sn-food-gatherer-percentage >= 55)
    (civilian-population >= 64)
=>
    (set-goal bt-farm-transition-reserve-goal 6)
    (set-goal bt-farm-depleted-reserve-goal 10)
)
(defrule
    (current-age >= imperial-age)
    (strategic-number sn-food-gatherer-percentage < 55)
    (civilian-population < 42)
=>
    (set-goal bt-farm-transition-reserve-goal 2)
    (set-goal bt-farm-depleted-reserve-goal 4)
)
(defrule
    (current-age >= imperial-age)
    (strategic-number sn-food-gatherer-percentage < 55)
    (civilian-population >= 42)
    (civilian-population < 55)
=>
    (set-goal bt-farm-transition-reserve-goal 3)
    (set-goal bt-farm-depleted-reserve-goal 6)
)
(defrule
    (current-age >= imperial-age)
    (strategic-number sn-food-gatherer-percentage < 55)
    (civilian-population >= 55)
    (civilian-population < 70)
=>
    (set-goal bt-farm-transition-reserve-goal 5)
    (set-goal bt-farm-depleted-reserve-goal 8)
)
(defrule
    (current-age >= imperial-age)
    (strategic-number sn-food-gatherer-percentage < 55)
    (civilian-population >= 70)
=>
    (set-goal bt-farm-transition-reserve-goal 6)
    (set-goal bt-farm-depleted-reserve-goal 10)
)

;----------------------------------------------------------------
; 11A. FEUDAL FARM CAPACITY
;----------------------------------------------------------------
(defrule
    (current-age == feudal-age)
    (strategic-number sn-resource-control == 0)
    (up-pending-objects c: farm == 0)
    (or
        (and (food-amount < 350) (idle-farm-count == 0))
        (or
        (and (goal bt-natural-food-state-goal bt-natural-food-transition)
             (idle-farm-count <= bt-farm-transition-reserve-goal))
        (and (goal bt-natural-food-state-goal bt-natural-food-depleted)
             (idle-farm-count <= bt-farm-depleted-reserve-goal))
            )
    )
    (building-type-count-total farm < bt-farm-feudal-cap)
    ; Wood escrow is intentionally usable by the farm action once the
    ; shared resource mutex is free. This is the same escrow-aware
    ; feasibility model used by TC/research construction.
    (can-build-with-escrow farm)
=>
    (release-escrow wood)
    (build farm)
)

;----------------------------------------------------------------
; 11B. CASTLE FARM CAPACITY
;----------------------------------------------------------------
(defrule
    (current-age == castle-age)
    (strategic-number sn-resource-control == 0)
    (up-pending-objects c: farm == 0)
    (or
        (and (food-amount < bt-farm-castle-food-threshold) (idle-farm-count == 0))
        (or
        (and (goal bt-natural-food-state-goal bt-natural-food-transition)
             (idle-farm-count <= bt-farm-transition-reserve-goal))
        (and (goal bt-natural-food-state-goal bt-natural-food-depleted)
             (idle-farm-count <= bt-farm-depleted-reserve-goal))
            )
    )
    (building-type-count-total farm < bt-farm-castle-cap)
    ; Farm construction is escrow-aware, so the rule cannot stall merely
    ; because the controller is carrying reserved wood.
    (can-build-with-escrow farm)
=>
    (release-escrow wood)
    (build farm)
)

;----------------------------------------------------------------
; 11C. IMPERIAL FARM CAPACITY
;----------------------------------------------------------------
; Imperial no longer waits for Crop Rotation or deer extinction before
; maintaining food capacity. Natural-food state becomes a soft urgency
; signal; farm capacity remains the hard completion witness.
(defrule
    (current-age >= imperial-age)
    (strategic-number sn-resource-control == 0)
    (up-pending-objects c: farm == 0)
    (or
        (and (food-amount < bt-farm-imperial-food-threshold) (idle-farm-count == 0))
        (or
        (and (goal bt-natural-food-state-goal bt-natural-food-transition)
             (idle-farm-count <= bt-farm-transition-reserve-goal))
        (and (goal bt-natural-food-state-goal bt-natural-food-depleted)
             (idle-farm-count <= bt-farm-depleted-reserve-goal))
            )
    )
    (building-type-count-total farm < bt-farm-imperial-cap)
    ; Preserve the same feasibility semantics through Imperial: the
    ; physical farm may consume reserved wood only when no higher-priority
    ; resource claim currently owns the bank.
    (can-build-with-escrow farm)
=>
    (release-escrow wood)
    (build farm)
)

;================================================================
; 12. SCOUTING
;================================================================
; Q: "How does the AI deliberately search for the enemy?"
;
; up-send-scout directs a land/water scout to a strategic location.
;
; Community pattern:
;   - one exploration group is the normal baseline;
;   - scout-flank performs the opening search;
;   - scout-enemy is used only after the target player's location is known;
;   - extra Scout production is a finite Feudal pressure commitment.
;
;---------------------------------------------------------------
; 12A. TARGET SELECTION
;---------------------------------------------------------------
; The controller already consumes target-player throughout military
; interpretation and attack readiness, but previously had no local
; writer.  Select the closest active enemy once enemy information exists,
; then copy that player number into the engine's target-player selector.
;
; This is intentionally minimal.  In 1v1, the result is deterministic.
; In team games, closest-enemy remains the repository's simple policy;
; it is not a full multi-enemy threat allocator.
(defrule
    (players-building-count any-enemy > 0)
    (or
        (strategic-number sn-target-player-number <= 0)
        (not (player-in-game target-player))
    )
=>
    (up-find-player enemy find-closest bt-scout-target-player-goal)
)

(defrule
    (up-compare-goal bt-scout-target-player-goal > 0)
    (strategic-number sn-target-player-number != bt-scout-target-player-goal)
=>
    (up-modify-sn sn-target-player-number g:= bt-scout-target-player-goal)
)

;---------------------------------------------------------------
; 12B. INITIAL / REPEATED ENEMY SEARCH
;---------------------------------------------------------------
; Search remains timer-driven.  The target-specific witness prevents
; another enemy's visible building from authorizing targeted scouting.
; scout-cavalry-line is used only as an availability witness so an
; upgraded Light Cavalry/Hussar scout remains a mobile reconnaissance asset.
(defrule
    (timer-triggered bt-scouting-timer)
    (or
        (game-time < bt-scout-home-grace)
        (or
            (sheep-and-forage-too-far)
            (players-building-count target-player <= 0)
        )
    )
    (unit-type-count scout-cavalry-line >= 1)
    (strategic-number sn-number-explore-groups > 0)
=>
    (up-send-scout bt-land-explore-group scout-flank)
    (enable-timer bt-scouting-timer bt-scout-home-pulse)
)

;---------------------------------------------------------------
; 12C. TARGETED ENEMY SCOUTING
;---------------------------------------------------------------
;
; scout-enemy is legal only after target-player has an actual known
; building witness.  any-enemy is deliberately not used here.
(defrule
    (timer-triggered bt-scouting-timer)
    (game-time >= bt-scout-home-grace)
    (not (sheep-and-forage-too-far))
    (players-building-count target-player > 0)
    (unit-type-count scout-cavalry-line >= 1)
    (strategic-number sn-number-explore-groups > 0)
=>
    (up-send-scout bt-land-explore-group scout-enemy)
    (enable-timer bt-scouting-timer bt-scout-enemy-pulse)
)

;---------------------------------------------------------------
; 12D. FEUDAL SCOUT-PRESSURE DEMAND
;---------------------------------------------------------------
; This is a narrow opening demand, not a new strategy system.
;
; It activates only when the controller is still in its early Feudal
; BOOM posture, is not currently able to research Castle Age, has
; located the target, and has not already invested in an Archer-heavy
; or Barracks-heavy Feudal plan.  The demand owns the finite four-Scout
; investment and disappears when a higher-priority plan takes over.
(defrule
    (goal bt-scout-pressure-demand-goal 0)
    (current-age == feudal-age)
    (game-time < bt-scout-pressure-window)
    (goal strategy-goal bt-strategy-boom)
    (players-building-count target-player > 0)
    (not (town-under-attack))
    (strategic-number sn-resource-control == 0)
    (not (or
        (can-research-with-escrow castle-age)
        (goal bt-castle-commitment-goal 1)
    ))
    (building-type-count-total archery-range == 0)
    (unit-type-count-total archer-line == 0)
    (building-type-count-total barracks < 2)
    (unit-type-count-total spearman-line < 3)
    (unit-type-count-total scout-cavalry >= 1)
    (unit-type-count-total scout-cavalry < bt-scout-feudal-cap)
    (food-amount >= bt-scout-safe-food)
    (wood-amount >= bt-scout-stable-wood)
    (can-build stable)
=>
    (set-goal bt-scout-pressure-demand-goal 1)
)

; Stop producing Scouts as soon as the finite Feudal investment has
; reached its cap or another strategic priority has become authoritative.
(defrule
    (goal bt-scout-pressure-demand-goal 1)
    (or (current-age >= castle-age) (or (can-research-with-escrow castle-age) (or (goal strategy-goal bt-strategy-flush) (or (goal strategy-goal bt-strategy-rush) (or (building-type-count-total archery-range >= 1) (or
(building-type-count-total barracks >= 2) (or (unit-type-count-total scout-cavalry >= bt-scout-feudal-cap) (or (food-amount < bt-scout-safe-food) (not (players-building-count target-player > 0))))))))))
=> 
    (set-goal bt-scout-pressure-demand-goal 0)
)

;================================================================
; 12E. MAP-AWARE OPENING SELECTION
;================================================================
; Strategic wire:
;   MAP / EARLY OPPONENT SIGNALS -> OPENING PLAN -> EXISTING STRATEGY
;
; This layer owns opening intent only. It never writes strategy-goal,
; unit-goal, resource mode, gatherer percentages, escrow, production
; claims, or research state.
(defrule
    (goal bt-opening-map-goal 0)
    (map-type arabia)
=>
    (set-goal bt-opening-map-goal bt-opening-map-arabia)
)
(defrule
    (goal bt-opening-map-goal 0)
    (map-type arena)
=>
    (set-goal bt-opening-map-goal bt-opening-map-arena)
)
(defrule
    (goal bt-opening-map-goal 0)
    (not (map-type arabia))
    (not (map-type arena))
=>
    (set-goal bt-opening-map-goal bt-opening-map-generic)
)

; Recompute the opening-pressure witness every pass.
(defrule
    (true)
=>
    (set-goal bt-opening-threat-goal bt-opening-threat-none)
)

; Immediate pressure: tower, multiple military buildings, or early mass.
(defrule
    (game-time >= 180)
    (game-time < bt-scout-pressure-window)
    (players-building-count target-player > 0)
    (or
        (players-building-type-count target-player watch-tower >= 1)
        (or
            (and
                (players-building-type-count target-player barracks >= 1)
                (players-building-type-count target-player archery-range >= 1)
            )
            (or
                (and
                    (players-building-type-count target-player barracks >= 1)
                    (players-building-type-count target-player stable >= 1)
                )
                (or
                    (and
                        (players-building-type-count target-player archery-range >= 1)
                        (players-building-type-count target-player stable >= 1)
                    )
                    (or
                        (players-unit-type-count target-player militiaman-line >= 3)
                        (or
                            (players-unit-type-count target-player archer-line >= 3)
                            (players-unit-type-count target-player scout-cavalry-line >= 4)
                        )
                    )
                )
            )
        )
    )
=>
    (set-goal bt-opening-threat-goal bt-opening-threat-immediate)
)

; Confirmed pressure only writes while the immediate branch did not fire.
(defrule
    (goal bt-opening-threat-goal bt-opening-threat-none)
    (game-time >= 180)
    (game-time < bt-scout-pressure-window)
    (players-building-count target-player > 0)
    (or
        (and
            (players-building-type-count target-player barracks >= 1)
            (players-unit-type-count target-player militiaman-line >= 2)
        )
        (or
            (and
                (players-building-type-count target-player archery-range >= 1)
                (players-unit-type-count target-player archer-line >= 2)
            )
            (or
                (and
                    (players-building-type-count target-player stable >= 1)
                    (players-unit-type-count target-player scout-cavalry-line >= 3)
                )
                (or
                    (and
                        (players-current-age target-player >= feudal-age)
                        (players-military-population target-player >= 3)
                    )
                    (players-military-population target-player >= 5)
                )
            )
        )
    )
=>
    (set-goal bt-opening-threat-goal bt-opening-threat-confirmed)
)

(defrule
    (goal bt-opening-threat-goal bt-opening-threat-none)
    (game-time >= 180)
    (game-time < bt-scout-pressure-window)
    (players-building-count target-player > 0)
    (players-military-population target-player >= 2)
=>
    (set-goal bt-opening-threat-goal bt-opening-threat-suspected)
)

; Anti-Rush is the highest-priority opening commitment.
(defrule
    (goal bt-opening-stage-goal bt-opening-stage-selecting)
    (up-compare-goal bt-opening-threat-goal >= bt-opening-threat-confirmed)
    (current-age == dark-age)
    (goal bt-opening-map-goal bt-opening-map-arabia)
=>
    (set-goal bt-opening-underlay-goal bt-opening-plan-arabia-standard)
    (set-goal bt-opening-plan-goal bt-opening-plan-anti-rush)
    (set-goal bt-opening-stage-goal bt-opening-stage-committed)
)
(defrule
    (goal bt-opening-stage-goal bt-opening-stage-selecting)
    (up-compare-goal bt-opening-threat-goal >= bt-opening-threat-confirmed)
    (current-age == dark-age)
    (goal bt-opening-map-goal bt-opening-map-arena)
=>
    (set-goal bt-opening-underlay-goal bt-opening-plan-arena-fast-castle)
    (set-goal bt-opening-plan-goal bt-opening-plan-anti-rush)
    (set-goal bt-opening-stage-goal bt-opening-stage-committed)
)
(defrule
    (goal bt-opening-stage-goal bt-opening-stage-selecting)
    (up-compare-goal bt-opening-threat-goal >= bt-opening-threat-confirmed)
    (current-age == dark-age)
    (goal bt-opening-map-goal bt-opening-map-generic)
=>
    (set-goal bt-opening-underlay-goal bt-opening-plan-generic-defensive)
    (set-goal bt-opening-plan-goal bt-opening-plan-anti-rush)
    (set-goal bt-opening-stage-goal bt-opening-stage-committed)
)

; Arabia early pressure: visible market investment with no military
; infrastructure is treated as a greedy/under-defended opening signal.
(defrule
    (goal bt-opening-stage-goal bt-opening-stage-selecting)
    (goal bt-opening-map-goal bt-opening-map-arabia)
    (goal bt-opening-threat-goal bt-opening-threat-none)
    (current-age == dark-age)
    (game-time >= 300)
    (players-building-count target-player > 0)
    (players-building-type-count target-player market >= 1)
    (players-building-type-count target-player barracks < 1)
    (players-building-type-count target-player archery-range < 1)
    (players-building-type-count target-player stable < 1)
=>
    (set-goal bt-opening-underlay-goal bt-opening-plan-arabia-pressure)
    (set-goal bt-opening-plan-goal bt-opening-plan-arabia-pressure)
    (set-goal bt-opening-stage-goal bt-opening-stage-committed)
)

; Arabia FC only when the target is known, still Dark, lightly armed, and
; shows no military infrastructure.
(defrule
    (goal bt-opening-stage-goal bt-opening-stage-selecting)
    (goal bt-opening-map-goal bt-opening-map-arabia)
    (goal bt-opening-threat-goal bt-opening-threat-none)
    (current-age == dark-age)
    (game-time >= 300)
    (players-building-count target-player > 0)
    (players-current-age target-player == dark-age)
    (players-military-population target-player <= 1)
    (players-building-type-count target-player barracks < 1)
    (players-building-type-count target-player archery-range < 1)
    (players-building-type-count target-player stable < 1)
=>
    (set-goal bt-opening-underlay-goal bt-opening-plan-arabia-fast-castle)
    (set-goal bt-opening-plan-goal bt-opening-plan-arabia-fast-castle)
    (set-goal bt-opening-stage-goal bt-opening-stage-committed)
)

; Arabia Standard is the conservative fallback for incomplete information
; or a merely suspected military opening.
(defrule
    (goal bt-opening-stage-goal bt-opening-stage-selecting)
    (goal bt-opening-map-goal bt-opening-map-arabia)
    (current-age == dark-age)
    (game-time >= 300)
    (or
        (players-building-count target-player <= 0)
        (goal bt-opening-threat-goal bt-opening-threat-suspected)
    )
=>
    (set-goal bt-opening-underlay-goal bt-opening-plan-arabia-standard)
    (set-goal bt-opening-plan-goal bt-opening-plan-arabia-standard)
    (set-goal bt-opening-stage-goal bt-opening-stage-committed)
)

; Arena FC is the safe default. Confirmed pressure was already claimed by
; Anti-Rush above.
(defrule
    (goal bt-opening-stage-goal bt-opening-stage-selecting)
    (goal bt-opening-map-goal bt-opening-map-arena)
    (up-compare-goal bt-opening-threat-goal < bt-opening-threat-confirmed)
    (current-age == dark-age)
    (game-time >= 180)
=>
    (set-goal bt-opening-underlay-goal bt-opening-plan-arena-fast-castle)
    (set-goal bt-opening-plan-goal bt-opening-plan-arena-fast-castle)
    (set-goal bt-opening-stage-goal bt-opening-stage-committed)
)

; Generic maps remain conservative unless the opponent supplies the same
; market/no-military greed signal.
(defrule
    (goal bt-opening-stage-goal bt-opening-stage-selecting)
    (goal bt-opening-map-goal bt-opening-map-generic)
    (goal bt-opening-threat-goal bt-opening-threat-none)
    (current-age == dark-age)
    (game-time >= 300)
    (players-building-count target-player > 0)
    (players-current-age target-player == dark-age)
    (players-building-type-count target-player market >= 1)
    (players-building-type-count target-player barracks < 1)
    (players-building-type-count target-player archery-range < 1)
    (players-building-type-count target-player stable < 1)
=>
    (set-goal bt-opening-underlay-goal bt-opening-plan-generic-pressure)
    (set-goal bt-opening-plan-goal bt-opening-plan-generic-pressure)
    (set-goal bt-opening-stage-goal bt-opening-stage-committed)
)
(defrule
    (goal bt-opening-stage-goal bt-opening-stage-selecting)
    (goal bt-opening-map-goal bt-opening-map-generic)
    (current-age == dark-age)
    (game-time >= 300)
=>
    (set-goal bt-opening-underlay-goal bt-opening-plan-generic-defensive)
    (set-goal bt-opening-plan-goal bt-opening-plan-generic-defensive)
    (set-goal bt-opening-stage-goal bt-opening-stage-committed)
)

; A confirmed early rush temporarily overrides the saved base opening until
; Castle Age. Existing FLUSH handles later threats beyond the opening.
(defrule
    (up-compare-goal bt-opening-stage-goal >= bt-opening-stage-committed)
    (up-compare-goal bt-opening-threat-goal >= bt-opening-threat-confirmed)
    (current-age < castle-age)
    (not (goal bt-opening-plan-goal bt-opening-plan-anti-rush))
=>
    (set-goal bt-opening-plan-goal bt-opening-plan-anti-rush)
)

; Restore the saved base opening when confirmed pressure disappears.
(defrule
    (goal bt-opening-plan-goal bt-opening-plan-anti-rush)
    (up-compare-goal bt-opening-threat-goal < bt-opening-threat-confirmed)
    (goal bt-opening-underlay-goal bt-opening-plan-arabia-standard)
=>
    (set-goal bt-opening-plan-goal bt-opening-plan-arabia-standard)
)
(defrule
    (goal bt-opening-plan-goal bt-opening-plan-anti-rush)
    (up-compare-goal bt-opening-threat-goal < bt-opening-threat-confirmed)
    (goal bt-opening-underlay-goal bt-opening-plan-arabia-pressure)
=>
    (set-goal bt-opening-plan-goal bt-opening-plan-arabia-pressure)
)
(defrule
    (goal bt-opening-plan-goal bt-opening-plan-anti-rush)
    (up-compare-goal bt-opening-plan-goal == bt-opening-plan-anti-rush)
    (up-compare-goal bt-opening-underlay-goal == bt-opening-plan-arabia-fast-castle)
    (up-compare-goal bt-opening-threat-goal < bt-opening-threat-confirmed)
=>
    (set-goal bt-opening-plan-goal bt-opening-plan-arabia-fast-castle)
)
(defrule
    (goal bt-opening-plan-goal bt-opening-plan-anti-rush)
    (up-compare-goal bt-opening-threat-goal < bt-opening-threat-confirmed)
    (goal bt-opening-underlay-goal bt-opening-plan-arena-fast-castle)
=>
    (set-goal bt-opening-plan-goal bt-opening-plan-arena-fast-castle)
)
(defrule
    (goal bt-opening-plan-goal bt-opening-plan-anti-rush)
    (up-compare-goal bt-opening-threat-goal < bt-opening-threat-confirmed)
    (goal bt-opening-underlay-goal bt-opening-plan-generic-pressure)
=>
    (set-goal bt-opening-plan-goal bt-opening-plan-generic-pressure)
)
(defrule
    (goal bt-opening-plan-goal bt-opening-plan-anti-rush)
    (up-compare-goal bt-opening-threat-goal < bt-opening-threat-confirmed)
    (goal bt-opening-underlay-goal bt-opening-plan-generic-defensive)
=>
    (set-goal bt-opening-plan-goal bt-opening-plan-generic-defensive)
)

; Arena Fast Castle becomes Arena Boom only after Castle Age is real.
(defrule
    (goal bt-opening-plan-goal bt-opening-plan-arena-fast-castle)
    (goal bt-opening-underlay-goal bt-opening-plan-arena-fast-castle)
    (current-age >= castle-age)
    (goal bt-opening-threat-goal bt-opening-threat-none)
=>
    (set-goal bt-opening-underlay-goal bt-opening-plan-arena-boom)
    (set-goal bt-opening-plan-goal bt-opening-plan-arena-boom)
    (set-goal bt-opening-stage-goal bt-opening-stage-complete)
)

(defrule
    (goal bt-opening-stage-goal bt-opening-stage-committed)
    (current-age >= feudal-age)
=>
    (set-goal bt-opening-stage-goal bt-opening-stage-complete)
)

;----------------------------------------------------------------
; BASILISK STRATEGIC NARRATION: THREAT INTERPRETATION
; The threat goal is recomputed every pass, so narration uses a diagnostic
; latch rather than attaching chat directly to the observation writers.
;----------------------------------------------------------------
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-opening-threat-goal bt-opening-threat-none)
    (up-compare-goal bt-debug-last-threat-goal != bt-opening-threat-none)
    (up-compare-goal bt-debug-last-threat-goal != 0)
=>
    (chat-local-to-self "BASILISK | THREAT | clear.")
    (set-goal bt-debug-last-threat-goal bt-opening-threat-none)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-opening-threat-goal bt-opening-threat-suspected)
    (up-compare-goal bt-debug-last-threat-goal != bt-opening-threat-suspected)
=>
    (chat-local-to-self "BASILISK | THREAT | suspected pressure.")
    (set-goal bt-debug-last-threat-goal bt-opening-threat-suspected)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-opening-threat-goal bt-opening-threat-confirmed)
    (up-compare-goal bt-debug-last-threat-goal != bt-opening-threat-confirmed)
=>
    (chat-local-to-self "BASILISK | THREAT | confirmed pressure.")
    (set-goal bt-debug-last-threat-goal bt-opening-threat-confirmed)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-opening-threat-goal bt-opening-threat-immediate)
    (up-compare-goal bt-debug-last-threat-goal != bt-opening-threat-immediate)
=>
    (chat-local-to-self "BASILISK | THREAT | immediate pressure.")
    (set-goal bt-debug-last-threat-goal bt-opening-threat-immediate)
)


;----------------------------------------------------------------
; BASILISK STRATEGIC NARRATION: OPENING PLAN
; Existing opening writers remain authoritative; this is a one-shot observer.
;----------------------------------------------------------------
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-opening-plan-goal bt-opening-plan-arabia-standard)
    (up-compare-goal bt-debug-last-opening-goal != bt-opening-plan-arabia-standard)
=>
    (chat-local-to-self "BASILISK | OPENING | ARABIA-STANDARD")
    (set-goal bt-debug-last-opening-goal bt-opening-plan-arabia-standard)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-opening-plan-goal bt-opening-plan-arabia-pressure)
    (up-compare-goal bt-debug-last-opening-goal != bt-opening-plan-arabia-pressure)
=>
    (chat-local-to-self "BASILISK | OPENING | ARABIA-PRESSURE")
    (set-goal bt-debug-last-opening-goal bt-opening-plan-arabia-pressure)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-opening-plan-goal bt-opening-plan-arabia-fast-castle)
    (up-compare-goal bt-debug-last-opening-goal != bt-opening-plan-arabia-fast-castle)
=>
    (chat-local-to-self "BASILISK | OPENING | ARABIA-FAST-CASTLE")
    (set-goal bt-debug-last-opening-goal bt-opening-plan-arabia-fast-castle)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-opening-plan-goal bt-opening-plan-arena-fast-castle)
    (up-compare-goal bt-debug-last-opening-goal != bt-opening-plan-arena-fast-castle)
=>
    (chat-local-to-self "BASILISK | OPENING | ARENA-FAST-CASTLE")
    (set-goal bt-debug-last-opening-goal bt-opening-plan-arena-fast-castle)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-opening-plan-goal bt-opening-plan-arena-boom)
    (up-compare-goal bt-debug-last-opening-goal != bt-opening-plan-arena-boom)
=>
    (chat-local-to-self "BASILISK | OPENING | ARENA-BOOM")
    (set-goal bt-debug-last-opening-goal bt-opening-plan-arena-boom)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-opening-plan-goal bt-opening-plan-anti-rush)
    (up-compare-goal bt-debug-last-opening-goal != bt-opening-plan-anti-rush)
=>
    (chat-local-to-self "BASILISK | OPENING | ANTI-RUSH")
    (set-goal bt-debug-last-opening-goal bt-opening-plan-anti-rush)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-opening-plan-goal bt-opening-plan-generic-pressure)
    (up-compare-goal bt-debug-last-opening-goal != bt-opening-plan-generic-pressure)
=>
    (chat-local-to-self "BASILISK | OPENING | GENERIC-PRESSURE")
    (set-goal bt-debug-last-opening-goal bt-opening-plan-generic-pressure)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-opening-plan-goal bt-opening-plan-generic-defensive)
    (up-compare-goal bt-debug-last-opening-goal != bt-opening-plan-generic-defensive)
=>
    (chat-local-to-self "BASILISK | OPENING | GENERIC-DEFENSIVE")
    (set-goal bt-debug-last-opening-goal bt-opening-plan-generic-defensive)
)


; 13. STRATEGY SELECTION
;================================================================
;
; Strategy answers:
;
;   "What kind of game are we playing right now?"
;
; It does NOT train units.
;
; Strategy values:
;
;   FLUSH = react to military pressure
;   RUSH  = convert a small prepared army into pressure
;   BOOM  = prioritize economic expansion
;---------------------------------------------------------------
; 13A. MILITARY PRESSURE -> FLUSH
;---------------------------------------------------------------
; Threat observation is centralized in section 12C.
;
; FLUSH is the highest-priority strategy state.  It may only be
; entered from a non-FLUSH state.  Recovery is explicit: once the
; threat is gone, return either to the Feudal RUSH posture when its
; conditions are still satisfied, or to BOOM otherwise.
(defrule
    (town-under-attack)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-flush)
)
(defrule
    (not (town-under-attack))
    (goal bt-cavalry-threat-goal 1)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-flush)
)
(defrule
    (not (town-under-attack))
    (goal bt-ranged-threat-goal 1)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-flush)
)
(defrule
    (not (town-under-attack))
    (goal bt-spear-threat-goal 1)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-flush)
)

;---------------------------------------------------------------
; 13B. FLUSH RECOVERY -> RUSH
;---------------------------------------------------------------
; This is an explicit exit from FLUSH.  It is evaluated after the
; threat writers, so the current pass must already be threat-free.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (current-age == feudal-age)
    (game-time >= 600)
    (players-building-count any-enemy > 0)
    (up-compare-goal bt-standing-army-deficit-goal >= 0)
    (up-compare-goal bt-standing-army-floor-goal >= bt-flush-army-floor-feudal)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
=>
    (set-goal strategy-goal bt-strategy-rush)
)

;---------------------------------------------------------------
; 13C. FLUSH RECOVERY -> BOOM
;---------------------------------------------------------------
; If the RUSH recovery conditions are not satisfied, recover to the
; economic posture explicitly rather than relying on a generic BOOM
; rule to overwrite FLUSH.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (not (current-age == feudal-age))
    (up-compare-goal bt-standing-army-deficit-goal >= 0)
    (or
        (and
            (current-age == castle-age)
            (up-compare-goal bt-standing-army-floor-goal >= bt-flush-army-floor-castle)
        )
        (and
            (current-age >= imperial-age)
            (up-compare-goal bt-standing-army-floor-goal >= bt-flush-army-floor-imperial)
        )
    )
=>
    (set-goal strategy-goal bt-strategy-boom)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (current-age == feudal-age)
    (not (game-time >= 600))
    (up-compare-goal bt-standing-army-deficit-goal >= 0)
    (up-compare-goal bt-standing-army-floor-goal >= bt-flush-army-floor-feudal)
=>
    (set-goal strategy-goal bt-strategy-boom)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (current-age == feudal-age)
    (game-time >= 600)
    (players-building-count any-enemy <= 0)
    (up-compare-goal bt-standing-army-deficit-goal >= 0)
    (up-compare-goal bt-standing-army-floor-goal >= bt-flush-army-floor-feudal)
=>
    (set-goal strategy-goal bt-strategy-boom)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (current-age == feudal-age)
    (game-time >= 600)
    (players-building-count any-enemy > 0)
    (up-compare-goal bt-standing-army-deficit-goal >= 0)
    (up-compare-goal bt-standing-army-floor-goal >= bt-flush-army-floor-feudal)
    (not (goal strategy-goal bt-strategy-rush))
=>
    (set-goal strategy-goal bt-strategy-boom)
)

;---------------------------------------------------------------
; 13D. FEUDAL MILITARY READY -> RUSH
;---------------------------------------------------------------
;
; This does NOT run if the AI is already in FLUSH.
;
; The first rush army is intentionally small and readable:
; Archery Range + Archers.
(defrule
    (current-age == feudal-age)
    (game-time >= 600)
    (players-building-count any-enemy > 0)
    (military-population >= 6)
    (not (town-under-attack))
    (not (goal strategy-goal bt-strategy-flush))
    (not (goal strategy-goal bt-strategy-rush))
=>
    (set-goal strategy-goal bt-strategy-rush)
)

;---------------------------------------------------------------
; 13E. SAFE CASTLE STRATEGY TRANSITIONS
;---------------------------------------------------------------
; Explicitly exclude active pressure states from the generic BOOM
; fallback. RUSH gets one qualified Castle-Power continuation, with
; BOOM as the explicit recovery when that qualification fails.
;---------------------------------------------------------------
; 13E.1 FEUDAL RUSH -> CASTLE TRANSITION
;---------------------------------------------------------------
; RUSH is a Feudal pressure posture. Once Castle Age is reached,
; surviving pressure with a live target and four archers continues
; into Castle-Power. A safe RUSH that fails those witnesses recovers
; to BOOM so Castle economic consumers are not starved by stale
; Feudal strategy state. Active pressure is already claimed by
; FLUSH above, so both branches require a clear current threat
; snapshot.
(defrule
    (goal strategy-goal bt-strategy-rush)
    (current-age >= castle-age)
    (players-building-count target-player > 0)
    (player-in-game target-player)
    (unit-type-count archer-line >= 4)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
=>
    (set-goal strategy-goal bt-strategy-castle-power)
)

; Failed Castle-Power promotion is an explicit RUSH -> BOOM recovery.
; This is mutually exclusive with the promotion rule above because that rule
; changes strategy-goal away from RUSH before this rule can match in the same pass.
(defrule
    (goal strategy-goal bt-strategy-rush)
    (current-age >= castle-age)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
=>
    (set-goal strategy-goal bt-strategy-boom)
)

(defrule
    (current-age >= castle-age)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (not (goal strategy-goal bt-strategy-boom))
    (not (goal strategy-goal bt-strategy-rush))
    (not (goal strategy-goal bt-strategy-flush))
    (not (goal strategy-goal bt-strategy-castle-power))
=>
    (set-goal strategy-goal bt-strategy-boom)
)

; Castle-power is a Castle-only pressure posture. Once Imperial Age is
; actually reached, return to the existing Imperial/BOOM consumers rather
; than leave the strategy state stranded.
(defrule
    (goal strategy-goal bt-strategy-castle-power)
    (current-age >= imperial-age)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
=>
    (set-goal strategy-goal bt-strategy-boom)
)

;---------------------------------------------------------------
; 13F. SAFE PRE-CASTLE DEFAULT
;---------------------------------------------------------------
(defrule
    (current-age < castle-age)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (not (goal strategy-goal bt-strategy-boom))
    (not (goal strategy-goal bt-strategy-rush))
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-boom)
)

;----------------------------------------------------------------
; 13F-1. OPENING PLAN -> EXISTING STRATEGY
;----------------------------------------------------------------
(defrule
    (goal bt-opening-plan-goal bt-opening-plan-anti-rush)
    (current-age < castle-age)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-flush)
)
(defrule
    (current-age == feudal-age)
    (goal bt-opening-plan-goal bt-opening-plan-arabia-pressure)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (military-population >= 3)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-rush)
)
(defrule
    (current-age == feudal-age)
    (goal bt-opening-plan-goal bt-opening-plan-generic-pressure)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (military-population >= 3)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-rush)
)
(defrule
    (current-age < castle-age)
    (not (goal bt-opening-plan-goal bt-opening-plan-anti-rush))
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (or
        (goal bt-opening-plan-goal bt-opening-plan-arabia-fast-castle)
        (or
            (goal bt-opening-plan-goal bt-opening-plan-arena-fast-castle)
            (or
                (goal bt-opening-plan-goal bt-opening-plan-arabia-standard)
                (goal bt-opening-plan-goal bt-opening-plan-generic-defensive)
            )
        )
    )
=>
    (set-goal strategy-goal bt-strategy-boom)
)
(defrule
    (goal bt-opening-plan-goal bt-opening-plan-arena-boom)
    (current-age >= castle-age)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (not (goal strategy-goal bt-strategy-castle-power))
=>
    (set-goal strategy-goal bt-strategy-boom)
)

;================================================================
; 13G. CATAPHRACT DEMAND
;================================================================
;
; Cataphract demand is a strategic response package. It persists until
; the current enemy tier is satisfied and any tier-required premium
; technology is complete. Queue-inclusive totals drive production;
; actual completed Cataphracts qualify expensive upgrades.
(defrule
    (current-age >= imperial-age)
    (or
        (goal strategy-goal bt-strategy-boom)
        (goal strategy-goal bt-strategy-flush)
    )
    (or (and
            (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-3)
            (unit-type-count-total cataphract-line < bt-cataphract-target-3)
        ) (or (and (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-2) (and (players-unit-type-count any-enemy militiaman-line < bt-cataphract-enemy-threshold-3) (unit-type-count-total cataphract-line <
bt-cataphract-target-2))) (and (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-1) (and (players-unit-type-count any-enemy militiaman-line < bt-cataphract-enemy-threshold-2) (unit-type-count-total
cataphract-line < bt-cataphract-target-1)))))
=>
    (set-goal bt-cataphract-demand-goal 1)
)

; Demand stays live through a required premium upgrade. This prevents the
; 10/20-unit package from self-canceling when queue-inclusive production
; reaches its target before Logistica or Elite Cataphract can claim.
(defrule
    (goal bt-cataphract-demand-goal 1)
    (strategic-number sn-resource-control != ri-logistica)
    (strategic-number sn-resource-control != ri-elite-cataphract)
    (current-age < imperial-age)
=>
    (set-goal bt-cataphract-demand-goal 0)
)
(defrule
    (goal bt-cataphract-demand-goal 1)
    (strategic-number sn-resource-control != ri-logistica)
    (strategic-number sn-resource-control != ri-elite-cataphract)
    (or
        (nor
            (goal strategy-goal bt-strategy-boom)
            (goal strategy-goal bt-strategy-flush)
        )
        (or
            (players-unit-type-count any-enemy militiaman-line < bt-cataphract-enemy-threshold-1)
            (or
                (and
                    (players-unit-type-count any-enemy militiaman-line < bt-cataphract-enemy-threshold-2)
                    (unit-type-count cataphract-line >= bt-cataphract-target-1)
                )
                (or
                    (and
                        (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-2)
                        (and
                            (players-unit-type-count any-enemy militiaman-line < bt-cataphract-enemy-threshold-3)
                            (and
                                (unit-type-count-total cataphract-line >= bt-cataphract-target-2)
                                (up-research-status c: ri-logistica == research-complete)
                            )
                        )
                    )
                    (and
                        (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-3)
                        (and
                            (unit-type-count-total cataphract-line >= bt-cataphract-target-3)
                            (and
                                (up-research-status c: ri-logistica == research-complete)
                                (up-research-status c: ri-elite-cataphract == research-complete)
                            )
                        )
                    )
                )
            )
        )
    )
=>
    (set-goal bt-cataphract-demand-goal 0)
)
;----------------------------------------------------------------
; BASILISK STRATEGIC NARRATION: STRATEGY
; The four broad postures are observed after their existing writers.
;----------------------------------------------------------------
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal strategy-goal bt-strategy-flush)
    (up-compare-goal bt-debug-last-strategy-goal != bt-strategy-flush)
=>
    (chat-local-to-self "BASILISK | STRATEGY | FLUSH: defensive response.")
    (set-goal bt-debug-last-strategy-goal bt-strategy-flush)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal strategy-goal bt-strategy-rush)
    (up-compare-goal bt-debug-last-strategy-goal != bt-strategy-rush)
=>
    (chat-local-to-self "BASILISK | STRATEGY | RUSH: pressure posture.")
    (set-goal bt-debug-last-strategy-goal bt-strategy-rush)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal strategy-goal bt-strategy-boom)
    (up-compare-goal bt-debug-last-strategy-goal != bt-strategy-boom)
=>
    (chat-local-to-self "BASILISK | STRATEGY | BOOM: economic posture.")
    (set-goal bt-debug-last-strategy-goal bt-strategy-boom)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal strategy-goal bt-strategy-castle-power)
    (up-compare-goal bt-debug-last-strategy-goal != bt-strategy-castle-power)
=>
    (chat-local-to-self "BASILISK | STRATEGY | CASTLE-POWER: pressure survives the age-up.")
    (set-goal bt-debug-last-strategy-goal bt-strategy-castle-power)
)


;================================================================
; 14. UNIT-GOAL SELECTION
;================================================================
;
; Unit-goal answers:
;
;   "What composition should the production system make?"
;
; The strategy layer decides POSTURE.
; This layer decides COMPOSITION.
;---------------------------------------------------------------
; 14A. MULTIPLE THREAT TYPES -> MIX
;---------------------------------------------------------------
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-cavalry-threat-goal 1)
    (goal bt-ranged-threat-goal 1)
=>
    (set-goal unit-goal bt-unit-mix)
)
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-cavalry-threat-goal 1)
    (goal bt-spear-threat-goal 1)
=>
    (set-goal unit-goal bt-unit-mix)
)
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-ranged-threat-goal 1)
    (goal bt-spear-threat-goal 1)
=>
    (set-goal unit-goal bt-unit-mix)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-cavalry-threat-goal 1)
    (not (goal bt-ranged-threat-goal 1))
    (not (goal bt-spear-threat-goal 1))
=>
    (set-goal unit-goal spearman-line)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-ranged-threat-goal 1)
    (not (goal bt-cavalry-threat-goal 1))
    (not (goal bt-spear-threat-goal 1))
=>
    (set-goal unit-goal skirmisher-line)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-spear-threat-goal 1)
    (not (goal bt-cavalry-threat-goal 1))
    (not (goal bt-ranged-threat-goal 1))
=>
    (set-goal unit-goal archer-line)
)

;---------------------------------------------------------------
; 14B. FLUSH WITH NO CURRENT THREAT -> MIX
;---------------------------------------------------------------
; Prevent a stale composition from surviving a transient defensive
; posture when the town is still under attack but the counted enemy
; threat has not resolved to a specific counter.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (not (goal bt-cavalry-threat-goal 1))
    (not (goal bt-ranged-threat-goal 1))
    (not (goal bt-spear-threat-goal 1))
=>
    (set-goal unit-goal bt-unit-mix)
)

;---------------------------------------------------------------
; 14C. STRATEGIC POSTURES
;---------------------------------------------------------------
(defrule
    (goal strategy-goal bt-strategy-rush)
=>
    (set-goal unit-goal archer-line)
)

(defrule
    (goal strategy-goal bt-strategy-boom)
=>
    (set-goal unit-goal bt-unit-mix)
)

;---------------------------------------------------------------
; 14C.1 CASTLE-POWER PRIMARY MILITARY SELECTION
;---------------------------------------------------------------
(defrule
    (goal strategy-goal bt-strategy-castle-power)
    (current-age >= castle-age)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (unit-type-count archer-line >= 4)
=>
    (set-goal unit-goal crossbowman)
)

;---------------------------------------------------------------
; 14C.1 CASTLE PRIMARY MILITARY SELECTION
;---------------------------------------------------------------
(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= castle-age)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (unit-type-count-total archer-line >= 4)
    (food-amount >= 350)
    (gold-amount >= 150)
    (research-available ri-crossbow)
=>
    (set-goal unit-goal crossbowman)
)

(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= castle-age)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (unit-type-count-total archer-line < 4)
    (food-amount >= 350)
    (gold-amount >= 150)
=>
    (set-goal unit-goal knight-line)
)

;================================================================
;----------------------------------------------------------------
; BASILISK STRATEGIC NARRATION: VARANGIAN PACKAGE
;----------------------------------------------------------------
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal bt-varangian-demand-goal 1)
    (up-compare-goal bt-debug-last-unit-goal != varangian-guard)
=>
    (chat-local-to-self "BASILISK | COMPOSITION | VARANGIAN GUARD")
    (set-goal bt-debug-last-unit-goal varangian-guard)
)

;----------------------------------------------------------------
; BASILISK STRATEGIC NARRATION: COMPOSITION
; Unit-goal is continuously selected; this reports only meaningful changes.
;----------------------------------------------------------------
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal unit-goal bt-unit-mix)
    (up-compare-goal bt-debug-last-unit-goal != bt-unit-mix)
=>
    (chat-local-to-self "BASILISK | COMPOSITION | MIX")
    (set-goal bt-debug-last-unit-goal bt-unit-mix)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal unit-goal spearman-line)
    (up-compare-goal bt-debug-last-unit-goal != spearman-line)
=>
    (chat-local-to-self "BASILISK | COMPOSITION | SPEARS")
    (set-goal bt-debug-last-unit-goal spearman-line)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal unit-goal skirmisher-line)
    (up-compare-goal bt-debug-last-unit-goal != skirmisher-line)
=>
    (chat-local-to-self "BASILISK | COMPOSITION | SKIRMISHERS")
    (set-goal bt-debug-last-unit-goal skirmisher-line)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal unit-goal archer-line)
    (up-compare-goal bt-debug-last-unit-goal != archer-line)
=>
    (chat-local-to-self "BASILISK | COMPOSITION | ARCHERS")
    (set-goal bt-debug-last-unit-goal archer-line)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal unit-goal crossbowman)
    (up-compare-goal bt-debug-last-unit-goal != crossbowman)
=>
    (chat-local-to-self "BASILISK | COMPOSITION | CROSSBOW")
    (set-goal bt-debug-last-unit-goal crossbowman)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal unit-goal knight-line)
    (up-compare-goal bt-debug-last-unit-goal != knight-line)
=>
    (chat-local-to-self "BASILISK | COMPOSITION | KNIGHTS")
    (set-goal bt-debug-last-unit-goal knight-line)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal unit-goal camel-line)
    (up-compare-goal bt-debug-last-unit-goal != camel-line)
=>
    (chat-local-to-self "BASILISK | COMPOSITION | CAMELS")
    (set-goal bt-debug-last-unit-goal camel-line)
)



;================================================================
; 13H. TEMPORARY POLICY PREEMPTION
;================================================================
; TC2/TC3 are discretionary BOOM projects. Their resource claims may
; be displaced for one short defensive pulse. Age/prerequisite claims are not.
(defrule
    (town-under-attack)
    (goal bt-preempt-active-goal 0)
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
    (goal bt-any-threat-goal 1)
    (strategic-number sn-resource-control == bt-tc2-claim)
=>
    (set-goal bt-preempt-active-goal 1)
    (set-goal bt-preempt-original-owner-goal bt-tc2-claim)
    (up-modify-goal bt-preempt-original-mode-goal g:= bt-resource-mode-goal)
    (set-goal bt-preempt-reason-goal bt-preempt-reason-attack)
    (set-goal bt-preempt-result-goal bt-preempt-result-none)
    (set-goal bt-preempt-defense-issued-goal 0)
    (set-strategic-number sn-resource-control bt-preempt-emergency-claim)
    (set-goal bt-telemetry-event-type-goal 1)
    (set-goal bt-telemetry-event-owner-goal bt-tc2-claim)
    (set-goal bt-telemetry-event-flags-goal 100)
    (up-modify-goal bt-telemetry-event-flags-goal g:+ bt-preempt-original-mode-goal)
    (up-get-fact game-time 0 bt-telemetry-event-time-goal)
    (set-goal bt-telemetry-event-pending-goal 1)
)
(defrule
    (town-under-attack)
    (goal bt-preempt-active-goal 0)
    (goal bt-tc-project-goal 3)
    (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
    (goal bt-any-threat-goal 1)
    (strategic-number sn-resource-control == bt-tc3-claim)
=>
    (set-goal bt-preempt-active-goal 1)
    (set-goal bt-preempt-original-owner-goal bt-tc3-claim)
    (up-modify-goal bt-preempt-original-mode-goal g:= bt-resource-mode-goal)
    (set-goal bt-preempt-reason-goal bt-preempt-reason-attack)
    (set-goal bt-preempt-result-goal bt-preempt-result-none)
    (set-goal bt-preempt-defense-issued-goal 0)
    (set-strategic-number sn-resource-control bt-preempt-emergency-claim)
    (set-goal bt-telemetry-event-type-goal 1)
    (set-goal bt-telemetry-event-owner-goal bt-tc3-claim)
    (set-goal bt-telemetry-event-flags-goal 100)
    (up-modify-goal bt-telemetry-event-flags-goal g:+ bt-preempt-original-mode-goal)
    (up-get-fact game-time 0 bt-telemetry-event-time-goal)
    (set-goal bt-telemetry-event-pending-goal 1)
)

; TELEMETRY FIFO BEGIN
(defrule
    (goal bt-telemetry-event-pending-goal 1)
    (up-compare-goal bt-telemetry-count-goal < 4)
    (goal bt-telemetry-write-head-goal 0)
=>
    (up-modify-goal bt-telemetry-slot0-event-goal g:= bt-telemetry-event-type-goal)
    (up-modify-goal bt-telemetry-slot0-owner-goal g:= bt-telemetry-event-owner-goal)
    (up-modify-goal bt-telemetry-slot0-flags-goal g:= bt-telemetry-event-flags-goal)
    (up-modify-goal bt-telemetry-slot0-time-goal g:= bt-telemetry-event-time-goal)
    (up-modify-goal bt-telemetry-sequence-goal c:+ 1)
    (up-modify-goal bt-telemetry-slot0-sequence-goal g:= bt-telemetry-sequence-goal)
    (up-modify-goal bt-telemetry-count-goal c:+ 1)
    (set-goal bt-telemetry-write-head-goal 1)
    (set-goal bt-telemetry-event-pending-goal 0)
)
(defrule
    (goal bt-telemetry-event-pending-goal 1)
    (up-compare-goal bt-telemetry-count-goal < 4)
    (goal bt-telemetry-write-head-goal 1)
=>
    (up-modify-goal bt-telemetry-slot1-event-goal g:= bt-telemetry-event-type-goal)
