    (not (goal bt-resource-mode-goal bt-resource-mode-gold-crisis))
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-iron-casting)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-iron-casting)
    (goal bt-research-blacksmith-claim-goal 0)
    (or
        (goal bt-research-cavalry-counter-package-goal ri-iron-casting)
        (and
            (goal bt-research-cavalry-counter-package-goal 0)
            (goal bt-research-ranged-counter-package-goal 0)
        )
    )
=>
    (set-strategic-number sn-resource-control ri-iron-casting)
    (release-escrow food)
    (release-escrow gold)
    (research ri-iron-casting)
    (set-goal bt-research-blacksmith-claim-goal ri-iron-casting)
    (set-strategic-number sn-resource-control 0)
)
