    (set-goal bt-debug-last-eco-event-goal 4)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal bt-research-lumber-camp-claim-goal ri-double-bit-axe)
    (up-compare-goal bt-debug-last-eco-event-goal != 5)
=>
    (chat-local-to-self "BASILISK | ECO | Double-Bit Axe: research started.")
    (set-goal bt-debug-last-eco-event-goal 5)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (up-research-status c: ri-double-bit-axe == research-complete)
    (up-compare-goal bt-debug-last-eco-event-goal != 6)
=>
    (chat-local-to-self "BASILISK | ECO | Double-Bit Axe: complete.")
    (set-goal bt-debug-last-eco-event-goal 6)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal bt-gold-mining-demand-goal 1)
    (up-compare-goal bt-debug-last-eco-event-goal != 7)
=>
    (chat-local-to-self "BASILISK | ECO | Gold Mining: demand active.")
    (set-goal bt-debug-last-eco-event-goal 7)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal bt-research-mining-camp-claim-goal ri-gold-mining)
    (up-compare-goal bt-debug-last-eco-event-goal != 8)
=>
    (chat-local-to-self "BASILISK | ECO | Gold Mining: research started.")
    (set-goal bt-debug-last-eco-event-goal 8)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (up-research-status c: ri-gold-mining == research-complete)
    (up-compare-goal bt-debug-last-eco-event-goal != 9)
=>
    (chat-local-to-self "BASILISK | ECO | Gold Mining: complete.")
