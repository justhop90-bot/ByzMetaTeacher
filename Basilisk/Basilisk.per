)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal bt-wheelbarrow-demand-goal 1)
    (up-compare-goal bt-debug-last-eco-event-goal != 10)
=>
    (chat-local-to-self "BASILISK | ECO | Wheelbarrow: demand active.")
