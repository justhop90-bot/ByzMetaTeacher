; Imperial Knight transition: Cavalier.
(defrule
    (goal bt-cavalier-demand-goal 0)
    (goal unit-goal knight-line)
    (current-age >= imperial-age)
    (unit-type-count-total knight-line >= bt-knight-target-mature)
    (up-research-status c: ri-cavalier < research-pending)
    (goal bt-cataphract-demand-goal 0)
    (goal bt-bombard-cannon-demand-goal 0)
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (not (goal bt-resource-mode-goal bt-resource-mode-food-crisis))
    (not (goal bt-resource-mode-goal bt-resource-mode-gold-crisis))
=>
    (set-goal bt-cavalier-demand-goal 1)
)
(defrule
    (goal bt-cavalier-demand-goal 1)
    (or
        (current-age < imperial-age)
        (or
            (not (goal unit-goal knight-line))
            (or
                (unit-type-count-total knight-line < bt-knight-target-mature)
                (or
                    (not (up-research-status c: ri-cavalier < research-pending))
                    (or
                        (goal bt-cataphract-demand-goal 1)
                        (or
                            (goal bt-bombard-cannon-demand-goal 1)
                            (or
                                (goal bt-resource-mode-goal bt-resource-mode-imperial-bank)
                                (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
                            )
                        )
                    )
                )
            )
        )
    )
=>
    (set-goal bt-cavalier-demand-goal 0)
)
(defrule
    (goal bt-cavalier-demand-goal 1)
    (current-age >= imperial-age)
    (up-compare-goal bt-research-stable-failure-backoff-goal != ri-cavalier)
    (strategic-number sn-resource-control == 0)
    (building-type-count stable >= 1)
    (can-research-with-escrow ri-cavalier)
    (goal bt-research-stable-claim-goal 0)
=>
    (set-strategic-number sn-resource-control ri-cavalier)
    (release-escrow food)
    (release-escrow gold)
    (research ri-cavalier)
    (set-goal bt-research-stable-claim-goal ri-cavalier)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-research-stable-claim-goal ri-cavalier)
    (up-research-status c: ri-cavalier == research-complete)
=>
    (set-goal bt-research-stable-claim-goal 0)
    (set-goal bt-cavalier-demand-goal 0)
)

; Imperial Paladin transition.
(defrule
    (goal bt-paladin-demand-goal 0)
    (goal unit-goal knight-line)
    (current-age >= imperial-age)
    (up-research-status c: ri-cavalier == research-complete)
    (unit-type-count-total knight-line >= bt-knight-target-late)
    (unit-type-count villager >= 60)
    (up-research-status c: ri-paladin < research-pending)
    (goal bt-cataphract-demand-goal 0)
    (goal bt-bombard-cannon-demand-goal 0)
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (not (goal bt-resource-mode-goal bt-resource-mode-food-crisis))
    (not (goal bt-resource-mode-goal bt-resource-mode-gold-crisis))
=>
    (set-goal bt-paladin-demand-goal 1)
)
(defrule
    (goal bt-paladin-demand-goal 1)
    (or (current-age < imperial-age) (or (not (goal unit-goal knight-line)) (or (up-research-status c: ri-cavalier != research-complete) (or (unit-type-count-total knight-line < bt-knight-target-late) (or (unit-type-count villager < 60)
(or (not (up-research-status c: ri-paladin < research-pending)) (or (goal bt-cataphract-demand-goal 1) (or (goal bt-bombard-cannon-demand-goal 1) (or (goal bt-resource-mode-goal bt-resource-mode-imperial-bank) (or (goal
bt-resource-mode-goal bt-resource-mode-imperial-bank-prep) (or (goal bt-resource-mode-goal bt-resource-mode-food-crisis) (goal bt-resource-mode-goal bt-resource-mode-gold-crisis))))))))))))
=>
    (set-goal bt-paladin-demand-goal 0)
)
(defrule
    (goal bt-paladin-demand-goal 1)
    (current-age >= imperial-age)
    (up-compare-goal bt-research-stable-failure-backoff-goal != ri-paladin)
    (strategic-number sn-resource-control == 0)
    (building-type-count stable >= 1)
    (can-research-with-escrow ri-paladin)
    (goal bt-research-stable-claim-goal 0)
=>
    (set-strategic-number sn-resource-control ri-paladin)
    (release-escrow food)
    (release-escrow gold)
    (research ri-paladin)
    (set-goal bt-research-stable-claim-goal ri-paladin)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-research-stable-claim-goal ri-paladin)
    (up-research-status c: ri-paladin == research-complete)
=>
    (set-goal bt-research-stable-claim-goal 0)
    (set-goal bt-paladin-demand-goal 0)
)

; Imperial ranged transition: Arbalest.
