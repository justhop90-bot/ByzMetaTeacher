)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal bt-research-town-center-claim-goal ri-wheel-barrow)
    (up-compare-goal bt-debug-last-eco-event-goal != 11)
=>
    (chat-local-to-self "BASILISK | ECO | Wheelbarrow: research started.")
