    (up-research-status c: ri-elite-varangian-guard <= research-available)
=>
    (set-goal bt-research-barracks-failure-backoff-goal ri-elite-varangian-guard)
    (enable-timer bt-research-barracks-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-barracks-claim-goal 0)
