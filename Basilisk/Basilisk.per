(defrule
    (not (town-under-attack))
    (goal bt-preempt-active-goal 1)
    (goal bt-preempt-original-owner-goal bt-tc2-claim)
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
    (goal strategy-goal bt-strategy-boom)
    (strategic-number sn-resource-control == bt-preempt-emergency-claim)
    (can-afford-building town-center-foundation)
    (can-build town-center)
=>
    (set-strategic-number sn-resource-control bt-tc2-claim)
    (set-goal bt-preempt-active-goal 0)
    (set-goal bt-preempt-result-goal bt-preempt-result-resume)
    (set-goal bt-preempt-defense-issued-goal 0)
    (set-goal bt-telemetry-event-type-goal 3)
    (set-goal bt-telemetry-event-owner-goal bt-tc2-claim)
    (set-goal bt-telemetry-event-flags-goal 100)
    (up-modify-goal bt-telemetry-event-flags-goal g:+ bt-preempt-original-mode-goal)
    (up-get-fact game-time 0 bt-telemetry-event-time-goal)
    (set-goal bt-telemetry-event-pending-goal 1)
)
(defrule
    (not (town-under-attack))
    (goal bt-preempt-active-goal 1)
    (goal bt-preempt-original-owner-goal bt-tc3-claim)
    (goal bt-tc-project-goal 3)
    (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
    (goal strategy-goal bt-strategy-boom)
    (strategic-number sn-resource-control == bt-preempt-emergency-claim)
    (can-afford-building town-center-foundation)
    (can-build town-center)
=>
    (set-strategic-number sn-resource-control bt-tc3-claim)
    (set-goal bt-preempt-active-goal 0)
    (set-goal bt-preempt-result-goal bt-preempt-result-resume)
    (set-goal bt-preempt-defense-issued-goal 0)
    (set-goal bt-telemetry-event-type-goal 3)
    (set-goal bt-telemetry-event-owner-goal bt-tc3-claim)
    (set-goal bt-telemetry-event-flags-goal 100)
    (up-modify-goal bt-telemetry-event-flags-goal g:+ bt-preempt-original-mode-goal)
    (up-get-fact game-time 0 bt-telemetry-event-time-goal)
    (set-goal bt-telemetry-event-pending-goal 1)
)
; A TC can complete through another already-issued engine path while emergency
; ownership is active. Completion is terminal and must release the emergency
; claim without resurrecting the finished project.
(defrule
    (goal bt-preempt-active-goal 1)
    (goal bt-preempt-original-owner-goal bt-tc2-claim)
    (building-type-count town-center >= 2)
    (strategic-number sn-resource-control == bt-preempt-emergency-claim)
=>
    (set-goal bt-preempt-active-goal 0)
    (set-goal bt-preempt-result-goal bt-preempt-result-complete)
    (set-goal bt-preempt-defense-issued-goal 0)
    (set-goal bt-telemetry-event-type-goal 3)
    (set-goal bt-telemetry-event-owner-goal bt-tc2-claim)
    (set-goal bt-telemetry-event-flags-goal 200)
    (up-modify-goal bt-telemetry-event-flags-goal g:+ bt-preempt-original-mode-goal)
    (up-get-fact game-time 0 bt-telemetry-event-time-goal)
    (set-goal bt-telemetry-event-pending-goal 1)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-preempt-active-goal 1)
    (goal bt-preempt-original-owner-goal bt-tc3-claim)
    (building-type-count town-center >= 3)
    (strategic-number sn-resource-control == bt-preempt-emergency-claim)
=>
    (set-goal bt-preempt-active-goal 0)
    (set-goal bt-preempt-result-goal bt-preempt-result-complete)
    (set-goal bt-preempt-defense-issued-goal 0)
    (set-goal bt-telemetry-event-type-goal 3)
    (set-goal bt-telemetry-event-owner-goal bt-tc3-claim)
