;----------------------------------------------------------------
; LIVE AGE RESEARCH WATCHDOG REFRESH
;
; A watchdog expiry is only an observation boundary. If an age research
; transaction is still engine-pending, retain the age claim and refresh
; the observation window. Pending research is live execution state, not
; a failed start.
(defrule
    (strategic-number sn-resource-control == feudal-age)
    (current-age < feudal-age)
    (up-research-status c: feudal-age == research-pending)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
)

(defrule
    (strategic-number sn-resource-control == castle-age)
    (current-age < castle-age)
    (up-research-status c: castle-age == research-pending)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
)

(defrule
    (strategic-number sn-resource-control == imperial-age)
    (current-age < imperial-age)
    (up-research-status c: imperial-age == research-pending)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
)

;----------------------------------------------------------------
; FEUDAL AGE WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == feudal-age)
    (current-age < feudal-age)
    (up-research-status c: feudal-age <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-goal bt-research-age-failure-backoff-goal feudal-age)
    (enable-timer bt-research-age-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-strategic-number sn-resource-control 0)
    (set-goal train-civ-goal 1)
)

;----------------------------------------------------------------
; CASTLE AGE WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == castle-age)
    (current-age < castle-age)
    (up-research-status c: castle-age <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-goal bt-research-age-failure-backoff-goal castle-age)
    (enable-timer bt-research-age-failure-backoff-timer bt-research-failure-backoff-seconds)
