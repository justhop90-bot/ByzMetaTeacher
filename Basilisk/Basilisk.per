        (and
            (up-compare-goal bt-elite-skirmisher-bank-delta-food-goal >= 0)
            (and
                (up-compare-goal bt-elite-skirmisher-bank-delta-wood-goal >= 0)
                (up-compare-goal bt-elite-skirmisher-bank-delta-gold-goal >= 0)
            )
        )
    )
    (building-type-count archery-range >= 1)
    (can-research-with-escrow ri-elite-skirmisher)
    (goal bt-research-archery-range-claim-goal 0)
    (goal bt-research-ranged-counter-package-goal ri-elite-skirmisher)
=>
    (set-strategic-number sn-resource-control ri-elite-skirmisher)
    (release-escrow food)
    (release-escrow gold)
    (research ri-elite-skirmisher)
    (set-goal bt-research-archery-range-claim-goal ri-elite-skirmisher)
    (set-strategic-number sn-resource-control 0)
)

; Q: "What proves the Elite Skirmisher claim is finished?"
;
; research-complete is the terminal witness.
(defrule
    (goal bt-research-archery-range-claim-goal ri-elite-skirmisher)
    (up-research-status c: ri-elite-skirmisher == research-complete)
=>
    (set-goal bt-research-archery-range-claim-goal 0)
)

; Plate Mail closes the mature Spear/Halberdier armor package.
; It reinforces the already-funded counter army and never substitutes
; for Halberdier/Pikeman production.
(defrule
    (current-age >= imperial-age)
    (building-type-count blacksmith >= 1)
    (up-research-status c: ri-halberdier == research-complete)
