; Mill food-infrastructure lifecycle state.
;
; target-goal = desired completed mill count.
; project-goal = the completed mill count the current mill project must reach.
;
; The second-mill trigger is a simplified Naga-derived scaling rule:
;   1 completed TC  -> 8 farms
;   2+ completed TCs -> 14 farms
; This keeps the 1-TC trigger deliberately early while retaining a 14-farm witness for 2+ TCs.
; The target deliberately stops at two mills because this controller's
; farm capacity currently stops at 24; a third mill needs a later placement
; and food-density proof rather than another speculative threshold.
(defconst bt-mill-target-goal 525)
(defconst bt-mill-project-goal 526)
(defconst bt-mill-second-farm-threshold-1tc 8)
(defconst bt-mill-second-farm-threshold-2tc 14)
(defconst bt-mill-third-farm-threshold-3tc 18)
(defconst bt-mill-third-farm-threshold-4tc 22)
; Post-Feudal Mill placement: anchor on the latest Farm and keep other
; dropsites separated so later Mills do not collapse into one fish pond.
(defconst bt-mill-placement-zone-size 6)
(defconst bt-mill-placement-separation-distance 10)

