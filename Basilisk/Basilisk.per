    (set-goal bt-debug-last-eco-event-goal 21)
)


;================================================================
; 17. BYZANTINE BOOM
;================================================================
;
; Town Centers are persistent strategic demand executed through one
; lifecycle. The project goal is the desired completed+pending TC count
; for the current expansion. Placement itself is delegated to the
; engine-managed place-control system; the script does not invent a
; second retry/search algorithm.
;
; Lifecycle:
;   STRATEGIC DEMAND
;       -> RESOURCE CLAIM
;       -> SINGLE PLACEMENT REQUEST
;       -> PENDING FOUNDATION / ENGINE PLACEMENT
;       -> FOUNDATION SUPPORT
;       -> COMPLETION
;       -> REASSESS DEMAND
;
; A failed execution must not destroy a still-valid strategic demand.
; Watchdogs only release stale execution ownership or renew foundation
; support. They remain execution support only and never alter strategic demand.

;------------------------------
; TC2 strategic demand.
;------------------------------
(defrule
    (goal bt-tc-project-goal 0)
    (goal bt-tc-stage-goal bt-tc-stage-idle)
    (goal strategy-goal bt-strategy-boom)
    (current-age >= castle-age)
    (unit-type-count villager >= 32)
    (food-amount >= 350)
    (wood-amount >= 300)
    (building-type-count town-center >= 1)
    (building-type-count-total town-center < 2)
=>
    (set-goal bt-tc-project-goal 2)
    (set-goal bt-tc-stage-goal bt-tc-stage-demanded)
)

; TC3 strategic demand.
(defrule
    (goal bt-tc-project-goal 0)
    (goal bt-tc-stage-goal bt-tc-stage-idle)
    (goal strategy-goal bt-strategy-boom)
    (current-age >= castle-age)
    (unit-type-count villager >= 45)
    (food-amount >= 500)
    (wood-amount >= 300)
    (building-type-count town-center >= 2)
    (building-type-count-total town-center < 3)
=>
    (set-goal bt-tc-project-goal 3)
    (set-goal bt-tc-stage-goal bt-tc-stage-demanded)
)

;------------------------------
; TC2 resource-claim provider.
;------------------------------
(defrule
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-demanded)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total town-center < 2)
    (not (up-pending-placement c: town-center))
    (can-build-with-escrow town-center)
=>
    (set-strategic-number sn-resource-control bt-tc2-claim)
    (release-escrow food)
    (release-escrow wood)
    (set-goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
    (enable-timer bt-tc2-watchdog-timer bt-tc-watchdog-seconds)
)

; TC3 resource-claim provider.
(defrule
    (goal bt-tc-project-goal 3)
    (goal bt-tc-stage-goal bt-tc-stage-demanded)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total town-center < 3)
    (not (up-pending-placement c: town-center))
    (can-build-with-escrow town-center)
=>
    (set-strategic-number sn-resource-control bt-tc3-claim)
    (release-escrow food)
    (release-escrow wood)
    (set-goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
    (enable-timer bt-tc3-watchdog-timer bt-tc-watchdog-seconds)
)

;------------------------------
; TC2 single execution provider.
;------------------------------
(defrule
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
    (strategic-number sn-resource-control == bt-tc2-claim)
    (building-type-count town-center >= 1)
    (building-type-count-total town-center < 2)
    (not (up-pending-placement c: town-center))
    (can-afford-building town-center-foundation)
    (can-build town-center)
=>
    ; place-control is intentionally retained. AIRef documents that the
    ; engine expands the stored placement zone after failed passes, so
    ; the controller must not cancel and recreate this request itself.
    (set-strategic-number sn-placement-to-center 1)
    (set-strategic-number sn-placement-zone-size bt-tc-placement-zone-size)
    (set-strategic-number sn-placement-fail-delta 0)
    (up-set-placement-data my-player-number -1 c: bt-tc-placement-distance)
    (up-assign-builders c: town-center-foundation c: bt-tc-builder-count)
    (up-build place-control 0 c: town-center)
    (disable-timer bt-tc2-watchdog-timer)
    (set-goal bt-tc-stage-goal bt-tc-stage-placement-pending)
)

; TC3 single execution provider.
(defrule
    (goal bt-tc-project-goal 3)
    (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
    (strategic-number sn-resource-control == bt-tc3-claim)
    (building-type-count town-center >= 2)
    (building-type-count-total town-center < 3)
    (not (up-pending-placement c: town-center))
    (can-afford-building town-center-foundation)
    (can-build town-center)
=>
    (set-strategic-number sn-placement-to-center 1)
    (set-strategic-number sn-placement-zone-size bt-tc-placement-zone-size)
    (set-strategic-number sn-placement-fail-delta 0)
    (up-set-placement-data my-player-number -1 c: bt-tc-placement-distance)
    (up-assign-builders c: town-center-foundation c: bt-tc-builder-count)
    (up-build place-control 0 c: town-center)
    (disable-timer bt-tc3-watchdog-timer)
    (set-goal bt-tc-stage-goal bt-tc-stage-placement-pending)
)

;------------------------------
; Resource-claim watchdogs.
;------------------------------
; A claim is an execution mutex, not a permanent strategic lock. If the
; actual build edge cannot execute for the entire watchdog interval,
; release ownership and return to persistent demand. Do not reset
; placement here because placement has not successfully been requested.
(defrule
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
    (timer-triggered bt-tc2-watchdog-timer)
    (building-type-count-total town-center < 2)
    (strategic-number sn-resource-control == bt-tc2-claim)
    (not (up-pending-placement c: town-center))
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-tc-stage-goal bt-tc-stage-demanded)
)

(defrule
    (goal bt-tc-project-goal 3)
    (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
    (timer-triggered bt-tc3-watchdog-timer)
    (building-type-count-total town-center < 3)
    (strategic-number sn-resource-control == bt-tc3-claim)
    (not (up-pending-placement c: town-center))
=>
    (disable-timer bt-tc3-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-tc-stage-goal bt-tc-stage-demanded)
)

;------------------------------
; Placement -> foundation witnesses.
;------------------------------
(defrule
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
    (building-type-count-total town-center >= 2)
    (building-type-count town-center < 2)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (up-assign-builders c: town-center-foundation c: bt-tc-builder-count)
    (set-goal bt-tc-stage-goal bt-tc-stage-foundation-active)
    (enable-timer bt-tc2-watchdog-timer bt-tc-watchdog-seconds)
)

(defrule
    (goal bt-tc-project-goal 3)
    (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
    (building-type-count-total town-center >= 3)
    (building-type-count town-center < 3)
=>
    (disable-timer bt-tc3-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (up-assign-builders c: town-center-foundation c: bt-tc-builder-count)
    (set-goal bt-tc-stage-goal bt-tc-stage-foundation-active)
    (enable-timer bt-tc3-watchdog-timer bt-tc-watchdog-seconds)
)

; A placement request which has disappeared without producing the target
; foundation is an execution failure, not a strategic failure. Release
; the mutex and let the persistent demand provider try again normally.
(defrule
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
    (building-type-count-total town-center < 2)
    (not (up-pending-placement c: town-center))
    (strategic-number sn-resource-control == bt-tc2-claim)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-tc-stage-goal bt-tc-stage-demanded)
)

(defrule
    (goal bt-tc-project-goal 3)
    (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
    (building-type-count-total town-center < 3)
    (not (up-pending-placement c: town-center))
    (strategic-number sn-resource-control == bt-tc3-claim)
=>
    (disable-timer bt-tc3-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-tc-stage-goal bt-tc-stage-demanded)
)

;------------------------------
; Foundation support.
;------------------------------
; A live foundation is a construction obligation. Never turn a stalled
; foundation into strategic failure history. Reassign builders and keep
; the project alive until completion or an explicit strategic veto.
(defrule
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
    (building-type-count-total town-center >= 2)
    (building-type-count town-center < 2)
    (timer-triggered bt-tc2-watchdog-timer)
=>
    (up-assign-builders c: town-center-foundation c: bt-tc-builder-count)
    (disable-timer bt-tc2-watchdog-timer)
    (enable-timer bt-tc2-watchdog-timer bt-tc-watchdog-seconds)
)

(defrule
    (goal bt-tc-project-goal 3)
    (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
    (building-type-count-total town-center >= 3)
    (building-type-count town-center < 3)
    (timer-triggered bt-tc3-watchdog-timer)
=>
    (up-assign-builders c: town-center-foundation c: bt-tc-builder-count)
    (disable-timer bt-tc3-watchdog-timer)
    (enable-timer bt-tc3-watchdog-timer bt-tc-watchdog-seconds)
)

; If a foundation is genuinely lost, return to demand. There is no
; failure history to exhaust and no strategic state to erase.
(defrule
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
    (building-type-count-total town-center < 2)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-tc-stage-goal bt-tc-stage-demanded)
)

(defrule
    (goal bt-tc-project-goal 3)
    (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
    (building-type-count-total town-center < 3)
=>
    (disable-timer bt-tc3-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-tc-stage-goal bt-tc-stage-demanded)
)

;------------------------------
; Strategic cancellation.
;------------------------------
; Cancel only pre-foundation expansion when BOOM is no longer the
; strategic posture. A live foundation is deliberately allowed to finish.
(defrule
    (goal bt-tc-project-goal 2)
    (or
        (goal bt-tc-stage-goal bt-tc-stage-demanded)
        (or
            (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
            (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
        )
    )
    (not (goal strategy-goal bt-strategy-boom))
    (building-type-count-total town-center < 2)
    (or
        (strategic-number sn-resource-control == 0)
        (strategic-number sn-resource-control == bt-tc2-claim)
    )
=>
    (disable-timer bt-tc2-watchdog-timer)
    (up-reset-placement c: town-center)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-tc-project-goal 0)
    (set-goal bt-tc-stage-goal bt-tc-stage-idle)
)

(defrule
    (goal bt-tc-project-goal 3)
    (or
        (goal bt-tc-stage-goal bt-tc-stage-demanded)
        (or
            (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
            (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
        )
    )
    (not (goal strategy-goal bt-strategy-boom))
    (building-type-count-total town-center < 3)
    (or
        (strategic-number sn-resource-control == 0)
        (strategic-number sn-resource-control == bt-tc3-claim)
    )
=>
    (disable-timer bt-tc3-watchdog-timer)
    (up-reset-placement c: town-center)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-tc-project-goal 0)
    (set-goal bt-tc-stage-goal bt-tc-stage-idle)
)

; Resource mutex cleanup runs before the project reset so the
; completion witness cannot erase the state needed by the cleanup rule.
(defrule
    (goal bt-tc-project-goal 2)
    (building-type-count town-center >= 2)
    (strategic-number sn-resource-control == bt-tc2-claim)
=>
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-tc-project-goal 3)
    (building-type-count town-center >= 3)
    (strategic-number sn-resource-control == bt-tc3-claim)
=>
    (set-strategic-number sn-resource-control 0)
)

;------------------------------
; Completion witnesses.
;------------------------------
(defrule
    (goal bt-tc-project-goal 2)
    (building-type-count town-center >= 2)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (up-reset-placement c: town-center)
    (set-goal bt-tc-project-goal 0)
    (set-goal bt-tc-stage-goal bt-tc-stage-idle)
)

(defrule
    (goal bt-tc-project-goal 3)
    (building-type-count town-center >= 3)
=>
    (disable-timer bt-tc3-watchdog-timer)
    (up-reset-placement c: town-center)
    (set-goal bt-tc-project-goal 0)
    (set-goal bt-tc-stage-goal bt-tc-stage-idle)
)

;----------------------------------------------------------------
; BASILISK STRATEGIC NARRATION: TOWN-CENTER PROJECTS
; Existing TC lifecycle remains authoritative; narration only observes stage.
;----------------------------------------------------------------
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal bt-tc-stage-goal bt-tc-stage-demanded)
    (up-compare-goal bt-debug-last-tc-stage-goal != 1)
=>
    (chat-local-to-self "BASILISK | TC | TC project demanded.")
    (set-goal bt-debug-last-tc-stage-goal 1)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
    (up-compare-goal bt-debug-last-tc-stage-goal != 2)
=>
    (chat-local-to-self "BASILISK | TC | TC resource bank claimed.")
    (set-goal bt-debug-last-tc-stage-goal 2)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
    (up-compare-goal bt-debug-last-tc-stage-goal != 3)
=>
    (chat-local-to-self "BASILISK | TC | TC placement requested.")
    (set-goal bt-debug-last-tc-stage-goal 3)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
    (up-compare-goal bt-debug-last-tc-stage-goal != 4)
=>
    (chat-local-to-self "BASILISK | TC | TC foundation active.")
    (set-goal bt-debug-last-tc-stage-goal 4)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (building-type-count town-center >= 2)
    (up-compare-goal bt-debug-last-tc-complete-goal < 2)
=>
    (chat-local-to-self "BASILISK | TC | TC2 complete.")
    (set-goal bt-debug-last-tc-complete-goal 2)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (building-type-count town-center >= 3)
    (up-compare-goal bt-debug-last-tc-complete-goal < 3)
=>
    (chat-local-to-self "BASILISK | TC | TC3 complete.")
    (set-goal bt-debug-last-tc-complete-goal 3)
)


;================================================================
; 18. SCOUTING -> ATTACK-GROUP GATHERING
;================================================================
(defrule
    (players-building-count target-player > 0)
=>
    (up-get-fact military-population 0 bt-relative-force-goal)
    (up-get-target-fact military-population 0 bt-target-military-scratch-goal)
    (up-modify-goal bt-relative-force-goal g:- bt-target-military-scratch-goal)
)

; Relative force is the aggregate parity signal. Standing-army demand
; separately closes the required role targets before attack authority.
(defrule
    (true)
=>
    (set-goal bt-counter-veto-goal 0)
)

; CAVALRY-MELEE FAMILY #1.
; Generic and high-frequency mounted melee families.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player knight-line >= 3)
            (or
                (players-unit-type-count target-player scout-cavalry-line >= 3)
                (or
                    (players-unit-type-count target-player camel-line >= 3)
                    (or
                        (players-unit-type-count target-player cataphract-line >= 3)
                        (or
                            (players-unit-type-count target-player battle-elephant-line >= 3)
                            (or
                                (players-unit-type-count target-player war-elephant-line >= 3)
                                (or
                                    (players-unit-type-count target-player steppe-lancer-line >= 3)
                                    (or
                                        (players-unit-type-count target-player tarkan-line >= 3)
                                        (or
                                            (players-unit-type-count target-player boyar-line >= 3)
                                            (players-unit-type-count target-player leitis-line >= 3)
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
        (unit-type-count-total spearman-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; CAVALRY-MELEE FAMILY #2.
; Additional current DE civilization-specific mounted melee families.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player keshik-line >= 3)
            (or
                (players-unit-type-count target-player coustillier-line >= 3)
                (or
                    (players-unit-type-count target-player konnik-line >= 3)
                    (or
                        (players-unit-type-count target-player magyar-huszar-line >= 3)
                        (or
                            (players-unit-type-count target-player shrivamsha-rider-line >= 3)
                            (or
                                (players-unit-type-count target-player iron-pagoda-line >= 3)
                                (or
                                    (players-unit-type-count target-player hei-guang-cavalry-line >= 3)
                                    (or
                                        (players-unit-type-count target-player kona-line >= 3)
                                        (or
                                            (players-unit-type-count target-player monaspa-line >= 3)
                                            (or
                                                (players-unit-type-count target-player centurion-line >= 3)
                                                (or
                                                    (players-unit-type-count target-player ratha-melee-line >= 3)
                                                    (players-unit-type-count target-player tiger-cavalry-line >= 3)
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
        (unit-type-count-total spearman-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; BOW-RANGED FAMILY #1.
; Generic archer/crossbow plus the established unique bow families.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player archer-line >= 3)
            (or
                (players-unit-type-count target-player cavalry-archer-line >= 3)
                (or
                    (players-unit-type-count target-player plumed-archer-line >= 3)
                    (or
                        (players-unit-type-count target-player longbowman-line >= 3)
                        (or
                            (players-unit-type-count target-player chu-ko-nu-line >= 3)
                            (or
                                (players-unit-type-count target-player genoese-crossbowman-line >= 3)
                                (or
                                    (players-unit-type-count target-player rattan-archer-line >= 3)
                                    (or
                                        (players-unit-type-count target-player blackwood-archer-line >= 3)
                                        (players-unit-type-count target-player fire-archer-line >= 3)
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
        (unit-type-count-total skirmisher-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; BOW-RANGED FAMILY #2.
; Mounted/unique bow families with a canonical skirmisher response.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player elephant-archer-line >= 3)
            (or
                (players-unit-type-count target-player bolas-rider-line >= 3)
                (or
                    (players-unit-type-count target-player mangudai-line >= 3)
                    (or
                        (players-unit-type-count target-player kipchak-line >= 3)
                        (or
                            (players-unit-type-count target-player camel-archer-line >= 3)
                            (or
                                (players-unit-type-count target-player genitour-line >= 3)
                                (or
                                    (players-unit-type-count target-player war-wagon-line >= 3)
                                    (or
                                        (players-unit-type-count target-player composite-bowman-line >= 3)
                                        (players-unit-type-count target-player ratha-ranged-line >= 3)
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
        (unit-type-count-total skirmisher-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; GUNPOWDER-CAVALRY FAMILY.
; Dedicated Conquistador/Arambai branch. These are mounted gunpowder
; specialists, not ordinary bow-ranged cavalry. At exact parity,
; require at least minimal skirmisher presence before attack authority.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player conquistador-line >= 3)
            (players-unit-type-count target-player arambai-line >= 3)
        )
        (unit-type-count-total skirmisher-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; ELEPHANT-SPECIALIST FAMILY.
; Ballista and Armored/Siege Elephant lines are elephant/siege specialists,
; but their stable Byzantine parity counter remains the Spearman line.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player ballista-elephant-line >= 3)
            (players-unit-type-count target-player armored-elephant-line >= 3)
        )
        (unit-type-count-total spearman-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; SPECIALIST-MELEE-INFANTRY FAMILY.
; Fire Lancer, Liao Dao, and Ibirapema are infantry specialists with a
; stable Archer-line counter relationship.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player fire-lancer-line >= 3)
            (or
                (players-unit-type-count target-player liao-dao-line >= 3)
                (players-unit-type-count target-player ibirapema-warrior-line >= 3)
            )
        )
        (unit-type-count-total archer-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; RANGED-MELEE SPECIALIST FAMILY.
; Throwing Axemen retain a clean Skirmisher counter relationship.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (players-unit-type-count target-player throwing-axeman-line >= 3)
        (unit-type-count-total skirmisher-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; HAND-CANNONEER FAMILY.
; Hand Cannoneers carry the archer armor class, so the canonical cheap
; Byzantine response is a minimum Skirmisher presence at exact parity.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (players-unit-type-count target-player hand-cannoneer >= 3)
        (unit-type-count-total skirmisher-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; MAMELUKE FAMILY.
; Mamelukes are cavalry-class but function as ranged anti-cavalry specialists.
; At exact parity, require minimum archer-line presence before attack authority.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (players-unit-type-count target-player mameluke-line >= 3)
        (unit-type-count-total archer-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; SPEAR / ANTI-CAVALRY INFANTRY FAMILY.
; Generic Spearman -> Pikeman -> Halberdier plus the Kamayuk specialist.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player spearman-line >= 4)
            (players-unit-type-count target-player kamayuk-line >= 3)
        )
        (unit-type-count-total archer-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

;
; Q: "How does the AI actually form an army?"
;
; We do not manually move ten units.
;
; The engine's attack-group system handles gathering.
;
; minimum group size = 10
; gather spacing      = 5
; attack allocation   = floor-tier policy targeting the 10-unit attack package.
; Q: "When should the first deliberate attack happen?"
;
; After:
;   Feudal+
;   enemy located
;   attack group is actually available
;   town is not currently under attack
;   no other attack cycle is active
; Reserve surplus above the standing floor is the attack budget.
(defrule
    (true)
=>
    (up-get-fact defend-soldier-count 0 bt-attack-reserve-goal)
    (up-modify-goal bt-attack-reserve-goal g:- bt-standing-army-floor-goal)
)

; CPSB documents that sn-percent-attack-soldiers is difficulty-scaled.
; Disable that scaling and derive a reserve-safe allocation from the
; standing-floor tier. Ten soldiers is also the minimum attack group.
(defrule (up-compare-goal bt-standing-army-floor-goal == 6)
=> (set-strategic-number sn-percent-attack-soldiers 63))
(defrule (up-compare-goal bt-standing-army-floor-goal == 12)
=> (set-strategic-number sn-percent-attack-soldiers 46))
(defrule (up-compare-goal bt-standing-army-floor-goal == 16)
=> (set-strategic-number sn-percent-attack-soldiers 39))
(defrule (up-compare-goal bt-standing-army-floor-goal == 20)
=> (set-strategic-number sn-percent-attack-soldiers 34))
(defrule (up-compare-goal bt-standing-army-floor-goal == 26)
=> (set-strategic-number sn-percent-attack-soldiers 28))
(defrule (up-compare-goal bt-standing-army-floor-goal == 30)
=> (set-strategic-number sn-percent-attack-soldiers 25))
(defrule (up-compare-goal bt-standing-army-floor-goal == 34)
=> (set-strategic-number sn-percent-attack-soldiers 23))
(defrule (up-compare-goal bt-standing-army-floor-goal == 42)
=> (set-strategic-number sn-percent-attack-soldiers 20))

; Feudal counter deficits use the compact 3/4/6 defensive ladder.
; This must agree with the Feudal role-target writer above, or production may
; be complete while attack authority still waits for the obsolete 6/16/24 tiers.
(defrule
    (current-age == feudal-age)
    (or
        (and
            (up-compare-goal bt-cavalry-counter-level-goal >= 1)
            (up-compare-goal bt-standing-spear-target-goal < bt-feudal-spear-counter-1)
        )
        (or
            (and
                (up-compare-goal bt-cavalry-counter-level-goal >= 2)
                (up-compare-goal bt-standing-spear-target-goal < bt-feudal-spear-counter-2)
            )
            (or
                (and
                    (up-compare-goal bt-cavalry-counter-level-goal >= 3)
                    (up-compare-goal bt-standing-spear-target-goal < bt-feudal-spear-counter-3)
                )
                (or
                    (and
                        (up-compare-goal bt-ranged-counter-level-goal >= 1)
                        (up-compare-goal bt-standing-skirm-target-goal < bt-feudal-skirm-counter-1)
                    )
                    (or
                        (and
                            (up-compare-goal bt-ranged-counter-level-goal >= 2)
                            (up-compare-goal bt-standing-skirm-target-goal < bt-feudal-skirm-counter-2)
                        )
                        (and
                            (up-compare-goal bt-ranged-counter-level-goal >= 3)
                            (up-compare-goal bt-standing-skirm-target-goal < bt-feudal-skirm-counter-3)
                        )
                    )
                )
            )
        )
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; Castle/Imperial counter deficits retain the larger strategic response tiers.
(defrule
    (current-age >= castle-age)
    (or (and
            (up-compare-goal bt-cavalry-counter-level-goal >= 1)
            (up-compare-goal bt-standing-spear-target-goal < bt-spear-target-1)
        ) (or (and
            (up-compare-goal bt-cavalry-counter-level-goal >= 2)
            (up-compare-goal bt-standing-spear-target-goal < bt-spear-target-2)
        ) (or (and
            (up-compare-goal bt-cavalry-counter-level-goal >= 3)
            (up-compare-goal bt-standing-spear-target-goal < bt-spear-target-3)
        ) (or (and
            (up-compare-goal bt-ranged-counter-level-goal >= 1)
            (up-compare-goal bt-standing-skirm-target-goal < bt-skirm-target-1)
        ) (or (and
            (up-compare-goal bt-ranged-counter-level-goal >= 2)
            (up-compare-goal bt-standing-skirm-target-goal < bt-skirm-target-2)
        ) (and
            (up-compare-goal bt-ranged-counter-level-goal >= 3)
            (up-compare-goal bt-standing-skirm-target-goal < bt-skirm-target-3)
        ))))))
=>
    (set-goal bt-counter-veto-goal 1)
)

;---------------------------------------------------------------
; 18A. PERSISTENT MANGONEL DEMAND
;---------------------------------------------------------------
; This is strategic demand only. It deliberately executes after the
; final attack-readiness evidence is derived above it in source order:
; ranged pressure is observed earlier, while relative force, attack
; reserve, and the final counter veto are current by this point.
;
; Production remains in the earlier military-production section and will
; consume this persistent demand on the following pass. That one-pass
; latency is intentional and bounded by the next reassessment.
(defrule
    (goal bt-mangonel-demand-goal 0)
    (current-age >= castle-age)
    (unit-type-count mangonel-line < bt-mangonel-response-target)
    (up-compare-goal bt-ranged-counter-level-goal >= 2)
    (players-building-count target-player > 0)
    (up-compare-goal bt-attack-reserve-goal >= 10)
    (up-compare-goal bt-relative-force-goal >= 0)
    (goal bt-counter-veto-goal 0)
    (goal attack-goal 0)
    (goal retreat-now-goal 0)
    (not (town-under-attack))
=>
    (set-goal bt-mangonel-demand-goal 1)
)

; Clear only when the strategic package is no longer relevant.
; Resource contention, missing Workshop, attack-state changes, and other
; temporary execution blockers do not clear persistent demand.
;
; retreat-now-goal may be written later in this source pass. In that case
; this invalidation sees the prior value and the demand may survive until
; the next reassessment. That is an intentional one-pass source-order
; consequence, not an ownership race.
(defrule
    (goal bt-mangonel-demand-goal 1)
    (or (up-compare-goal bt-ranged-counter-level-goal < 2) (or (players-building-count target-player == 0) (or (town-under-attack) (goal retreat-now-goal 1))))
=>
    (set-goal bt-mangonel-demand-goal 0)
)

;---------------------------------------------------------------
; 18A.2. SCORPION RESPONSE PACKAGE
;---------------------------------------------------------------
; Strategic purpose:
;   Castle-age enemy infantry mass is the direct witness.
;
; Explicit exclusions:
;   * no demand before Castle Age;
;   * no demand when the selected target player has lost its infantry or buildings;
;   * no demand during active Mangonel/Onager/BBC/Ram packages;
;   * no demand at high cavalry-counter pressure;
;   * no demand during Imperial bank preparation;
;   * no demand while retreating or under direct town attack.
;
; This is a finite four-Scorpion response package. Four Scorpions are a
; minimum combat-support package, not an attempt to match enemy infantry count.
(defrule
    (goal bt-scorpion-demand-goal 0)
    (current-age >= castle-age)
    (players-unit-type-count target-player militiaman-line >= bt-scorpion-trigger-infantry)
    (players-building-count target-player > 0)
    (player-in-game target-player)
    (up-compare-goal bt-scout-target-player-goal > 0)
    (up-compare-goal bt-cavalry-counter-level-goal < 2)
    (up-compare-goal bt-ranged-counter-level-goal < 2)
    (players-unit-type-count target-player mangonel-line < 2)
    (players-unit-type-count target-player scorpion-line < 4)
    (goal bt-mangonel-demand-goal 0)
    (goal bt-onager-demand-goal 0)
    (goal bt-bombard-cannon-demand-goal 0)
    (goal bt-ram-demand-goal 0)
    (goal retreat-now-goal 0)
    (not (town-under-attack))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (unit-type-count-total scorpion-line < bt-scorpion-response-target)
=>
    (set-goal bt-scorpion-demand-goal 1)
)

; Scorpion demand is persistent through temporary resource contention and
; Workshop absence. Reassess only the strategic purpose and explicit exclusions.
(defrule
    (goal bt-scorpion-demand-goal 1)
    (or
        (current-age < castle-age)
        (or
            (players-unit-type-count target-player militiaman-line < bt-scorpion-trigger-infantry)
            (or
                (players-building-count target-player == 0)
                (not (player-in-game target-player))
            )
        )
    )
=>
    (set-goal bt-scorpion-demand-goal 0)
)
(defrule
    (goal bt-scorpion-demand-goal 1)
    (or
        (up-compare-goal bt-cavalry-counter-level-goal >= 2)
        (or
            (up-compare-goal bt-ranged-counter-level-goal >= 2)
            (or
                (players-unit-type-count target-player mangonel-line >= 2)
                (players-unit-type-count target-player scorpion-line >= 4)
            )
        )
    )
=>
    (set-goal bt-scorpion-demand-goal 0)
)
(defrule
    (goal bt-scorpion-demand-goal 1)
    (or
        (goal bt-mangonel-demand-goal 1)
        (or
            (goal bt-onager-demand-goal 1)
            (or
                (goal bt-bombard-cannon-demand-goal 1)
                (goal bt-ram-demand-goal 1)
            )
        )
    )
=>
    (set-goal bt-scorpion-demand-goal 0)
)
(defrule
    (goal bt-scorpion-demand-goal 1)
    (or
        (goal retreat-now-goal 1)
        (or
            (town-under-attack)
            (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
        )
    )
=>
    (set-goal bt-scorpion-demand-goal 0)
)

; Package completion uses actual Scorpions, not queued units.
(defrule
    (goal bt-scorpion-demand-goal 1)
    (unit-type-count scorpion-line >= bt-scorpion-response-target)
=>
    (set-goal bt-scorpion-demand-goal 0)
)

;---------------------------------------------------------------
; 18A.2A. SCORPION -> BALLISTICS DECISION
;---------------------------------------------------------------
; Current DE makes Scorpion projectiles benefit from Ballistics.  The bot
; waits for the actual four-Scorpion response package and a still-relevant
; target before buying the technology.  This is an existing-mutex research
; decision, not a second technology arbiter.
(defrule
    (goal bt-scorpion-ballistics-demand-goal 0)
    (current-age >= castle-age)
    (unit-type-count scorpion-line >= bt-scorpion-response-target)
    (players-unit-type-count target-player militiaman-line >= bt-scorpion-trigger-infantry)
    (players-building-count target-player > 0)
    (player-in-game target-player)
    (up-compare-goal bt-scout-target-player-goal > 0)
    (goal retreat-now-goal 0)
    (not (town-under-attack))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (up-research-status c: ri-ballistics == research-available)
=>
    (set-goal bt-scorpion-ballistics-demand-goal 1)
)

; Keep the strategic decision alive through temporary resource contention.
; An active Ballistics claim owns the mutex and is not canceled here.
(defrule
    (goal bt-scorpion-ballistics-demand-goal 1)
    (strategic-number sn-resource-control != ri-ballistics)
    (or (current-age < castle-age) (or (unit-type-count scorpion-line < bt-scorpion-response-target) (or (players-unit-type-count target-player militiaman-line < bt-scorpion-trigger-infantry) (or (players-building-count target-player == 0)
(or (not (player-in-game target-player)) (or (goal retreat-now-goal 1) (or (town-under-attack) (or (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep) (not (up-research-status c: ri-ballistics == research-available))))))))))
=>
    (set-goal bt-scorpion-ballistics-demand-goal 0)
)

(defrule
    (current-age >= castle-age)
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (up-compare-goal bt-research-university-failure-backoff-goal != ri-ballistics)
    (strategic-number sn-resource-control == 0)
    (building-type-count university >= 1)
    (can-research-with-escrow ri-ballistics)
    (goal bt-research-university-claim-goal 0)
    (goal bt-research-siege-package-goal ri-ballistics)
=>
    (set-strategic-number sn-resource-control ri-ballistics)
    (release-escrow wood)
    (release-escrow gold)
    (research ri-ballistics)
    (set-goal bt-research-university-claim-goal ri-ballistics)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-research-university-claim-goal ri-ballistics)
    (up-research-status c: ri-ballistics == research-complete)
=>
    (set-goal bt-research-university-claim-goal 0)
    (set-goal bt-scorpion-ballistics-demand-goal 0)
)

;---------------------------------------------------------------
; 18A.1. MANGONEL RESPONSE PACKAGE COMPLETION
;---------------------------------------------------------------
; This is the terminal witness for the configured response package.
; Use unit-type-count rather than unit-type-count-total: queued Mangonels
; satisfy the production cap, but they do not satisfy package completion.
;
; Reset persistent demand only after the configured number of Mangonels
; actually exists. Workshop construction and production authorization are
; deliberately untouched by this completion edge.
(defrule
    (goal bt-mangonel-demand-goal 1)
    (unit-type-count mangonel-line >= bt-mangonel-response-target)
=>
    (set-goal bt-mangonel-demand-goal 0)
)

;---------------------------------------------------------------
; 18A.3. IMPERIAL ONAGER ESCALATION
;---------------------------------------------------------------
; The Castle Mangonel response is intentionally finite at two units.
; Imperial escalation is a separate state so the package-completion edge does
; not make a four-Mangonel Onager gate unreachable.
(defrule
    (goal bt-onager-demand-goal 0)
    (current-age >= imperial-age)
    (unit-type-count onager < bt-onager-response-target)
    (up-compare-goal bt-ranged-counter-level-goal >= 2)
    (players-building-count target-player > 0)
    (unit-type-count mangonel-line >= bt-mangonel-response-target)
    (up-compare-goal bt-attack-reserve-goal >= 10)
    (up-compare-goal bt-relative-force-goal >= 0)
    (goal bt-counter-veto-goal 0)
    (goal attack-goal 0)
    (goal retreat-now-goal 0)
    (not (town-under-attack))
    (not (goal bt-cataphract-demand-goal 1))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (up-research-status c: ri-onager == research-available)
=>
    (set-goal bt-onager-demand-goal 1)
)

; Pending Onager demand is persistent while the purpose remains valid.
; Once the strategic mutex is owned by Onager research, this invalidation edge
; cannot cancel that active research claim.
(defrule
    (goal bt-onager-demand-goal 1)
    (strategic-number sn-resource-control != ri-onager)
    (or (current-age < imperial-age) (or (up-compare-goal bt-ranged-counter-level-goal < 2) (or (players-building-count target-player == 0) (or (unit-type-count mangonel-line < bt-mangonel-response-target) (or (town-under-attack) (or (goal
retreat-now-goal 1) (or (goal bt-cataphract-demand-goal 1) (or (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep) (not (up-research-status c: ri-onager == research-available))))))))))
=>
    (set-goal bt-onager-demand-goal 0)
)

; Four completed Mangonels are the predecessor-mass witness. Queued units do
; not authorize the expensive upgrade.
(defrule
    (goal bt-onager-demand-goal 1)
    (current-age >= imperial-age)
    (building-type-count siege-workshop >= 1)
    (unit-type-count mangonel-line >= bt-mangonel-imperial-escalation-target)
    (not (goal bt-cataphract-demand-goal 1))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (up-compare-goal bt-research-siege-workshop-failure-backoff-goal != ri-onager)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-onager)
    (goal bt-research-siege-workshop-claim-goal 0)
    (goal bt-research-siege-package-goal ri-onager)
=>
    (set-strategic-number sn-resource-control ri-onager)
    (release-escrow food)
    (release-escrow gold)
    (research ri-onager)
    (set-goal bt-research-siege-workshop-claim-goal ri-onager)
    (set-strategic-number sn-resource-control 0)
)

; Research completion releases only the Onager resource claim. Demand stays
; active so the completed upgrade can feed the finite production package.
(defrule
    (goal bt-research-siege-workshop-claim-goal ri-onager)
    (up-research-status c: ri-onager == research-complete)
=>
    (set-goal bt-research-siege-workshop-claim-goal 0)
)

; Two actual Onagers close the finite Imperial response package.
(defrule
    (goal bt-onager-demand-goal 1)
    (up-research-status c: ri-onager == research-complete)
    (unit-type-count onager >= bt-onager-response-target)
=>
    (set-goal bt-onager-demand-goal 0)
)

;---------------------------------------------------------------
; 18A.4. IMPERIAL BOMBARD CANNON DEMAND / CHEMISTRY
;---------------------------------------------------------------
; Strategic ownership is now the Imperial siege package. The separate
; enemy-Trebuchet branch remains a tactical reason to retain/replace BBCs.
(defrule
    ; BBC is the default Imperial siege conversion demand.
    (goal bt-bombard-cannon-demand-goal 0)
    (goal bt-imperial-siege-package-goal 1)
    (current-age >= imperial-age)
    (unit-type-count-total bombard-cannon-line < bt-imperial-siege-bbc-target)
    (players-building-count target-player > 0)
    (player-in-game target-player)
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (or
        (up-research-status c: ri-chemistry == research-available)
        (up-research-status c: ri-chemistry == research-complete)
    )
=> 
    (set-goal bt-bombard-cannon-demand-goal 1)
)

; Demand remains live through the Chemistry claim and until the finite BBC
; package exists, but stale demand is released when its strategic purpose or
; Imperial opportunity disappears before an active Chemistry claim owns it.
(defrule
    (goal bt-bombard-cannon-demand-goal 1)
    (strategic-number sn-resource-control != ri-chemistry)
    (strategic-number sn-resource-control != bt-bombard-university-claim)
    (or
        (current-age < imperial-age)
        (or
            (goal bt-imperial-siege-package-goal 0)
            (or
                (players-building-count target-player == 0)
                (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
            )
        )
    )
=> 
    (disable-timer bt-bombard-university-backoff-timer)
    (set-goal bt-bombard-cannon-demand-goal 0)
    (set-goal bt-bombard-university-backoff-goal 0)
)

; University is a required Chemistry capability when the Castle-to-Imperial
; path did not already build one. Use a separate claim so BBC capability cannot
; mutate the Imperial prerequisite failure state.
(defrule
    (goal bt-bombard-cannon-demand-goal 1)
    (goal bt-bombard-university-backoff-goal 0)
    (current-age >= imperial-age)
    (building-type-count-total university < 1)
    (up-pending-objects c: university == 0)
    (strategic-number sn-resource-control == 0)
    (can-build-with-escrow university)
=>
    (set-strategic-number sn-resource-control bt-bombard-university-claim)
    (enable-timer bt-bombard-university-watchdog-timer bt-bombard-university-watchdog-seconds)
    (release-escrow wood)
    (build university)
)

(defrule
    (strategic-number sn-resource-control == bt-bombard-university-claim)
    (building-type-count university >= 1)
=>
    (disable-timer bt-bombard-university-watchdog-timer)
    (disable-timer bt-bombard-university-backoff-timer)
    (set-goal bt-bombard-university-backoff-goal 0)
    (set-strategic-number sn-resource-control 0)
)
 
(defrule
    (building-type-count university >= 1)
    (strategic-number sn-resource-control != bt-bombard-university-claim)
=>
    (disable-timer bt-bombard-university-watchdog-timer)
    (disable-timer bt-bombard-university-backoff-timer)
    (set-goal bt-bombard-university-backoff-goal 0)
)

(defrule
    (goal bt-bombard-cannon-demand-goal 0)
    (strategic-number sn-resource-control != bt-bombard-university-claim)
    (up-pending-objects c: university == 0)
=>
    (disable-timer bt-bombard-university-backoff-timer)
    (set-goal bt-bombard-university-backoff-goal 0)
)

;----------------------------------------------------------------
; BOMBARD UNIVERSITY CONSTRUCTION WATCHDOG
(defrule
    (strategic-number sn-resource-control == bt-bombard-university-claim)
    (timer-triggered bt-bombard-university-watchdog-timer)
    (up-pending-objects c: university > 0)
=>
    (disable-timer bt-bombard-university-watchdog-timer)
    (up-assign-builders c: university c: bt-foundation-stall-builder-count)
    (enable-timer bt-bombard-university-watchdog-timer bt-bombard-university-watchdog-seconds)
)
(defrule
    (strategic-number sn-resource-control == bt-bombard-university-claim)
    (timer-triggered bt-bombard-university-watchdog-timer)
    (up-pending-objects c: university == 0)
=>
    (disable-timer bt-bombard-university-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-bombard-university-backoff-goal 1)
    (enable-timer bt-bombard-university-backoff-timer bt-bombard-university-backoff-seconds)
)
(defrule
    (goal bt-bombard-university-backoff-goal 1)
    (timer-triggered bt-bombard-university-backoff-timer)
=>
    (disable-timer bt-bombard-university-backoff-timer)
    (set-goal bt-bombard-university-backoff-goal 0)
)

; Chemistry is researched only as a downstream BBC prerequisite, never as a
; generic Imperial-age technology. The existing resource mutex and watchdog
; remain the only research arbitration mechanism.
(defrule
    (current-age >= imperial-age)
    (building-type-count university >= 1)
    (not (goal bt-cataphract-demand-goal 1))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (up-compare-goal bt-research-university-failure-backoff-goal != ri-chemistry)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-chemistry)
    (goal bt-research-university-claim-goal 0)
    (goal bt-research-siege-package-goal ri-chemistry)
=>
    (set-strategic-number sn-resource-control ri-chemistry)
    (release-escrow food)
    (release-escrow gold)
    (research ri-chemistry)
    (set-goal bt-research-university-claim-goal ri-chemistry)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-research-university-claim-goal ri-chemistry)
    (up-research-status c: ri-chemistry == research-complete)
=>
    (set-goal bt-research-university-claim-goal 0)
)

; Two actual Bombard Cannons close the precision-siege package. Queued BBCs
; count toward the execution ceiling, but cannot satisfy this completion rule.
(defrule
    (goal bt-bombard-cannon-demand-goal 1)
    (unit-type-count bombard-cannon-line >= bt-bombard-cannon-response-target)
=>
    (set-goal bt-bombard-cannon-demand-goal 0)
)

;---------------------------------------------------------------
; 18A.5. BBC -> TREBUCHET DIRECT TARGETING
;---------------------------------------------------------------
; DUC is a combat consumer, not a second strategic decision layer.
; Strategic Trebuchet existence remains the demand authority.
;
; DUC stages:
;   0 = idle
;   1 = Trebuchet search results ready
;   2 = building fallback search results ready
;
; up-get-search-state writes four consecutive goals:
;   base     = local total
;   base + 1 = local results added by the search
;   base + 2 = remote total
;   base + 3 = remote results added by the search
;
; Search bases:
;   548..551 = Trebuchet probe
;   552..555 = building fallback probe
;
; The fallback searches generic building class 903, not enemy military units.
; If neither a visible Trebuchet nor a visible enemy building exists, no DUC
; command is issued and the next timed probe is scheduled.
;
(defrule
    (goal bt-bombard-cannon-demand-goal 1)
    (goal bt-bombard-trebuchet-duc-armed-goal 0)
    (current-age >= imperial-age)
    (unit-type-count bombard-cannon-line >= 1)
    (players-unit-type-count target-player trebuchet-set >= 1)
    (players-building-count target-player > 0)
    (player-in-game target-player)
    (up-compare-goal bt-scout-target-player-goal > 0)
    (not (town-under-attack))
=>
    (set-goal bt-bombard-trebuchet-duc-armed-goal 1)
    (set-goal bt-bombard-trebuchet-duc-stage-goal bt-bombard-trebuchet-duc-stage-idle)
    (enable-timer bt-bombard-trebuchet-target-timer 1)
)

; Probe for a currently actionable Trebuchet.
(defrule
    (goal bt-bombard-cannon-demand-goal 1)
    (goal bt-bombard-trebuchet-duc-stage-goal bt-bombard-trebuchet-duc-stage-idle)
    (timer-triggered bt-bombard-trebuchet-target-timer)
    (current-age >= imperial-age)
    (unit-type-count bombard-cannon-line >= 1)
    (players-unit-type-count target-player trebuchet-set >= 1)
    (players-building-count target-player > 0)
    (player-in-game target-player)
    (up-compare-goal bt-scout-target-player-goal > 0)
    (not (town-under-attack))
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number g:= bt-scout-target-player-goal)
    (up-find-local c: bombard-cannon-line c: 240)
    (up-find-remote c: unpacked-trebuchet-class c: 40)
    (up-get-search-state bt-bombard-trebuchet-search-state-goal)
    (set-goal bt-bombard-trebuchet-duc-stage-goal bt-bombard-trebuchet-duc-stage-trebuchet-probe)
    (disable-timer bt-bombard-trebuchet-target-timer)
)

; Direct BBC -> Trebuchet consumer when DUC has an actionable target.
(defrule
    (goal bt-bombard-cannon-demand-goal 1)
    (goal bt-bombard-trebuchet-duc-stage-goal bt-bombard-trebuchet-duc-stage-trebuchet-probe)
    (up-compare-goal bt-bombard-trebuchet-remote-count-goal >= 1)
    (current-age >= imperial-age)
    (unit-type-count bombard-cannon-line >= 1)
    (players-unit-type-count target-player trebuchet-set >= 1)
    (player-in-game target-player)
    (up-compare-goal bt-scout-target-player-goal > 0)
    (not (town-under-attack))
=>
    (up-target-objects 0 action-default -1 -1)
    (set-goal bt-bombard-trebuchet-duc-stage-goal bt-bombard-trebuchet-duc-stage-idle)
    (disable-timer bt-bombard-trebuchet-target-timer)
    (enable-timer bt-bombard-trebuchet-target-timer bt-bombard-trebuchet-target-interval)
)

; No Trebuchet is currently actionable. Search visible enemy buildings as a
; positioning fallback, using the same selected target player.
(defrule
    (goal bt-bombard-cannon-demand-goal 1)
    (goal bt-bombard-trebuchet-duc-stage-goal bt-bombard-trebuchet-duc-stage-trebuchet-probe)
    (up-compare-goal bt-bombard-trebuchet-remote-count-goal == 0)
    (current-age >= imperial-age)
    (unit-type-count bombard-cannon-line >= 1)
    (players-unit-type-count target-player trebuchet-set >= 1)
    (players-building-count target-player > 0)
    (player-in-game target-player)
    (up-compare-goal bt-scout-target-player-goal > 0)
    (not (town-under-attack))
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number g:= bt-scout-target-player-goal)
    (up-find-local c: bombard-cannon-line c: 240)
    (up-find-remote c: building-class c: 40)
    (up-get-search-state bt-bombard-building-search-state-goal)
    (set-goal bt-bombard-trebuchet-duc-stage-goal bt-bombard-trebuchet-duc-stage-building-probe)
)

; Move the BBCs toward visible enemy buildings. The next timed probe will
; retarget an actual Trebuchet when it becomes actionable again.
(defrule
    (goal bt-bombard-cannon-demand-goal 1)
    (goal bt-bombard-trebuchet-duc-stage-goal bt-bombard-trebuchet-duc-stage-building-probe)
    (up-compare-goal bt-bombard-building-remote-count-goal >= 1)
    (current-age >= imperial-age)
    (unit-type-count bombard-cannon-line >= 1)
    (players-unit-type-count target-player trebuchet-set >= 1)
    (player-in-game target-player)
    (up-compare-goal bt-scout-target-player-goal > 0)
    (not (town-under-attack))
=>
    (up-target-objects 0 action-move -1 -1)
    (set-goal bt-bombard-trebuchet-duc-stage-goal bt-bombard-trebuchet-duc-stage-idle)
    (disable-timer bt-bombard-trebuchet-target-timer)
    (enable-timer bt-bombard-trebuchet-target-timer bt-bombard-trebuchet-target-interval)
)

; No actionable Trebuchet and no visible enemy building. Do not issue DUC and
; do not clear the strategic BBC demand. Rearm the next probe.
(defrule
    (goal bt-bombard-cannon-demand-goal 1)
    (goal bt-bombard-trebuchet-duc-stage-goal bt-bombard-trebuchet-duc-stage-building-probe)
    (up-compare-goal bt-bombard-building-remote-count-goal == 0)
=>
    (set-goal bt-bombard-trebuchet-duc-stage-goal bt-bombard-trebuchet-duc-stage-idle)
    (disable-timer bt-bombard-trebuchet-target-timer)
    (enable-timer bt-bombard-trebuchet-target-timer bt-bombard-trebuchet-target-interval)
)

; Defense takes precedence over direct BBC DUC targeting. Disarm locally while
; the town is under attack; the arm rule restarts probing after it ends.
(defrule
    (goal bt-bombard-cannon-demand-goal 1)
    (goal bt-bombard-trebuchet-duc-armed-goal 1)
    (town-under-attack)
=>
    (disable-timer bt-bombard-trebuchet-target-timer)
    (set-goal bt-bombard-trebuchet-duc-armed-goal 0)
    (set-goal bt-bombard-trebuchet-duc-stage-goal bt-bombard-trebuchet-duc-stage-idle)
)

; Demand cleanup owns all BBC DUC state.
(defrule
    (goal bt-bombard-cannon-demand-goal 0)
    (or (goal bt-bombard-trebuchet-duc-armed-goal 1) (or (goal bt-bombard-trebuchet-duc-stage-goal bt-bombard-trebuchet-duc-stage-trebuchet-probe) (goal bt-bombard-trebuchet-duc-stage-goal bt-bombard-trebuchet-duc-stage-building-probe)))
=>
    (disable-timer bt-bombard-trebuchet-target-timer)
    (set-goal bt-bombard-trebuchet-duc-armed-goal 0)
    (set-goal bt-bombard-trebuchet-duc-stage-goal bt-bombard-trebuchet-duc-stage-idle)
)

;---------------------------------------------------------------
; 18B. SIEGE TOWER WALL-CROSSING PROJECT
;---------------------------------------------------------------
; This is a finite transport project, not a second attack controller.
;
; Lifecycle:
;   demand -> wall probe -> wall selected -> tower pending
;   -> payload ready -> garrisoning -> loaded -> wall approach
;   -> unload pending -> assault -> complete/reset.
;
; The wall search uses class 927.  The selected wall's point is persisted
; because later DUC rules are allowed to reset the search lists.
;
; The native Siege Tower wall action is an attack/default command against
; the wall.  Manual ungarrison is NOT used for the crossing itself.
;
; up-garrison is deliberately capped at six units through the existing
; garrison control strategic numbers.  Those values are restored to 0
; immediately after the operation, because this controller has no other
; owner for those settings.
;
; Wall-specific failures may advance to another selected wall.  Tower and
; garrison execution failures use a bounded retry ladder.  Three exhausted
; failures terminate this project for the current attack cycle rather than
; allowing a broken tower to become a permanent DUC loop.

; Open one wall-crossing project from an active attack cycle.
(defrule
    (goal bt-siege-tower-demand-goal 0)
    (goal bt-siege-tower-cycle-complete-goal 0)
    (goal bt-siege-tower-failure-goal 0)
    (goal attack-goal 1)
    (current-age >= castle-age)
    (players-building-count target-player > 0)
    (player-in-game target-player)
    (up-compare-goal bt-scout-target-player-goal > 0)
    (unit-type-count infantry-class >= bt-siege-tower-payload-min)
    (up-compare-goal bt-siege-tower-spare-army-goal >= bt-siege-tower-payload-min)
    (up-compare-goal bt-attack-reserve-goal >= 10)
    (goal bt-counter-veto-goal 0)
    (goal bt-mangonel-demand-goal 0)
    (goal bt-onager-demand-goal 0)
    (goal bt-bombard-cannon-demand-goal 0)
    (goal bt-ram-demand-goal 0)
    (goal bt-scorpion-demand-goal 0)
    (goal retreat-now-goal 0)
    (not (town-under-attack))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
=>
    (set-goal bt-siege-tower-demand-goal 1)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-wall-probe)
    (set-goal bt-siege-tower-wall-attempt-goal 0)
    (set-goal bt-siege-tower-failure-retry-goal 0)
)

; Strategic invalidation owns the abort edge.  Do not tear down a valid
; payload merely because transient production conditions changed later.
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal attack-goal 0)
=>
    (up-ungarrison c: siege-tower)
    (disable-timer bt-siege-tower-tower-watchdog-timer)
    (disable-timer bt-siege-tower-payload-watchdog-timer)
    (disable-timer bt-siege-tower-garrison-watchdog-timer)
    (disable-timer bt-siege-tower-approach-watchdog-timer)
    (disable-timer bt-siege-tower-unload-watchdog-timer)
    (disable-timer bt-siege-tower-assault-watchdog-timer)
    (disable-timer bt-siege-tower-retry-timer)
    (set-strategic-number sn-number-garrison-units 0)
    (set-strategic-number sn-maximum-garrison-fill 0)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-execution-remote-count-goal 0)
    (set-goal bt-siege-tower-wall-remote-count-goal 0)
    (set-goal bt-siege-tower-failure-goal 0)
    (set-goal bt-siege-tower-wall-attempt-goal 0)
)
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (players-building-count target-player == 0)
=>
    (up-ungarrison c: siege-tower)
    (disable-timer bt-siege-tower-tower-watchdog-timer)
    (disable-timer bt-siege-tower-payload-watchdog-timer)
    (disable-timer bt-siege-tower-garrison-watchdog-timer)
    (disable-timer bt-siege-tower-approach-watchdog-timer)
    (disable-timer bt-siege-tower-unload-watchdog-timer)
    (disable-timer bt-siege-tower-assault-watchdog-timer)
    (disable-timer bt-siege-tower-retry-timer)
    (set-strategic-number sn-number-garrison-units 0)
    (set-strategic-number sn-maximum-garrison-fill 0)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-execution-remote-count-goal 0)
    (set-goal bt-siege-tower-wall-remote-count-goal 0)
    (set-goal bt-siege-tower-failure-goal 0)
    (set-goal bt-siege-tower-wall-attempt-goal 0)
)
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (not (player-in-game target-player))
=>
    (up-ungarrison c: siege-tower)
    (disable-timer bt-siege-tower-tower-watchdog-timer)
    (disable-timer bt-siege-tower-payload-watchdog-timer)
    (disable-timer bt-siege-tower-garrison-watchdog-timer)
    (disable-timer bt-siege-tower-approach-watchdog-timer)
    (disable-timer bt-siege-tower-unload-watchdog-timer)
    (disable-timer bt-siege-tower-assault-watchdog-timer)
    (disable-timer bt-siege-tower-retry-timer)
    (set-strategic-number sn-number-garrison-units 0)
    (set-strategic-number sn-maximum-garrison-fill 0)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-execution-remote-count-goal 0)
    (set-goal bt-siege-tower-wall-remote-count-goal 0)
    (set-goal bt-siege-tower-failure-goal 0)
    (set-goal bt-siege-tower-wall-attempt-goal 0)
)
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (or (goal retreat-now-goal 1) (town-under-attack))
=>
    (up-ungarrison c: siege-tower)
    (disable-timer bt-siege-tower-tower-watchdog-timer)
    (disable-timer bt-siege-tower-payload-watchdog-timer)
    (disable-timer bt-siege-tower-garrison-watchdog-timer)
    (disable-timer bt-siege-tower-approach-watchdog-timer)
    (disable-timer bt-siege-tower-unload-watchdog-timer)
    (disable-timer bt-siege-tower-assault-watchdog-timer)
    (disable-timer bt-siege-tower-retry-timer)
    (set-strategic-number sn-number-garrison-units 0)
    (set-strategic-number sn-maximum-garrison-fill 0)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-execution-remote-count-goal 0)
    (set-goal bt-siege-tower-wall-remote-count-goal 0)
    (set-goal bt-siege-tower-failure-goal 0)
    (set-goal bt-siege-tower-wall-attempt-goal 0)
)
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
=>
    (up-ungarrison c: siege-tower)
    (disable-timer bt-siege-tower-tower-watchdog-timer)
    (disable-timer bt-siege-tower-payload-watchdog-timer)
    (disable-timer bt-siege-tower-garrison-watchdog-timer)
    (disable-timer bt-siege-tower-approach-watchdog-timer)
    (disable-timer bt-siege-tower-unload-watchdog-timer)
    (disable-timer bt-siege-tower-assault-watchdog-timer)
    (disable-timer bt-siege-tower-retry-timer)
    (set-strategic-number sn-number-garrison-units 0)
    (set-strategic-number sn-maximum-garrison-fill 0)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-execution-remote-count-goal 0)
    (set-goal bt-siege-tower-wall-remote-count-goal 0)
    (set-goal bt-siege-tower-failure-goal 0)
    (set-goal bt-siege-tower-wall-attempt-goal 0)
)
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (or
        (goal bt-mangonel-demand-goal 1)
        (or
            (goal bt-onager-demand-goal 1)
            (or
                (goal bt-bombard-cannon-demand-goal 1)
                (or
                    (goal bt-ram-demand-goal 1)
                    (goal bt-scorpion-demand-goal 1)
                )
            )
        )
    )
=>
    (up-ungarrison c: siege-tower)
    (disable-timer bt-siege-tower-tower-watchdog-timer)
    (disable-timer bt-siege-tower-payload-watchdog-timer)
    (disable-timer bt-siege-tower-garrison-watchdog-timer)
    (disable-timer bt-siege-tower-approach-watchdog-timer)
    (disable-timer bt-siege-tower-unload-watchdog-timer)
    (disable-timer bt-siege-tower-assault-watchdog-timer)
    (disable-timer bt-siege-tower-retry-timer)
    (set-strategic-number sn-number-garrison-units 0)
    (set-strategic-number sn-maximum-garrison-fill 0)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-execution-remote-count-goal 0)
    (set-goal bt-siege-tower-wall-remote-count-goal 0)
    (set-goal bt-siege-tower-failure-goal 0)
    (set-goal bt-siege-tower-wall-attempt-goal 0)
)

; Wall probe. The focus player is the already-selected attack target.
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-wall-probe)
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number g:= bt-scout-target-player-goal)
    (up-find-remote c: bt-siege-tower-wall-class c: 40)
    (up-get-search-state bt-siege-tower-wall-search-state-goal)
)

; Pick a bounded wall candidate and persist its point.  The .per
; comparison language does not compare one goal against another goal, so the
; three legal candidate indices are explicit rules.
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-wall-probe)
    (up-compare-goal bt-siege-tower-wall-attempt-goal == 0)
    (up-compare-goal bt-siege-tower-wall-remote-count-goal >= 1)
=>
    (up-set-target-object search-remote c: 0)
    (up-get-point position-object bt-siege-tower-wall-point-goal)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-tower-pending)
    (enable-timer bt-siege-tower-tower-watchdog-timer bt-siege-tower-tower-watchdog-seconds)
)

(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-wall-probe)
    (up-compare-goal bt-siege-tower-wall-attempt-goal == 1)
    (up-compare-goal bt-siege-tower-wall-remote-count-goal >= 2)
=>
    (up-set-target-object search-remote c: 1)
    (up-get-point position-object bt-siege-tower-wall-point-goal)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-tower-pending)
    (enable-timer bt-siege-tower-tower-watchdog-timer bt-siege-tower-tower-watchdog-seconds)
)

(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-wall-probe)
    (up-compare-goal bt-siege-tower-wall-attempt-goal == bt-siege-tower-last-wall-attempt)
    (up-compare-goal bt-siege-tower-wall-remote-count-goal >= 3)
=>
    (up-set-target-object search-remote c: 2)
    (up-get-point position-object bt-siege-tower-wall-point-goal)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-tower-pending)
    (enable-timer bt-siege-tower-tower-watchdog-timer bt-siege-tower-tower-watchdog-seconds)
)

; No currently usable wall at the current bounded index. Re-probe after a
; short interval so a newly sighted wall can become actionable.
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-wall-probe)
    (up-compare-goal bt-siege-tower-wall-attempt-goal == 0)
    (up-compare-goal bt-siege-tower-wall-remote-count-goal == 0)
=>
    (set-goal bt-siege-tower-failure-goal bt-siege-tower-wall-no-target-failure)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-retry-wait)
    (enable-timer bt-siege-tower-retry-timer bt-siege-tower-wall-probe-interval)
)

(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-wall-probe)
    (up-compare-goal bt-siege-tower-wall-attempt-goal == 1)
    (up-compare-goal bt-siege-tower-wall-remote-count-goal < 2)
=>
    (set-goal bt-siege-tower-failure-goal bt-siege-tower-wall-no-target-failure)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-retry-wait)
    (enable-timer bt-siege-tower-retry-timer bt-siege-tower-wall-probe-interval)
)

(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-wall-probe)
    (goal bt-siege-tower-wall-attempt-goal bt-siege-tower-last-wall-attempt)
    (up-compare-goal bt-siege-tower-wall-remote-count-goal < 3)
=>
    (set-goal bt-siege-tower-failure-goal bt-siege-tower-wall-no-target-failure)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-retry-wait)
    (enable-timer bt-siege-tower-retry-timer bt-siege-tower-wall-probe-interval)
)

; A real tower is the capability witness. Queued towers do not satisfy this
; transition; unit-type-count-total is used only by the production edge.
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-tower-pending)
    (unit-type-count siege-tower >= 1)
=>
    (disable-timer bt-siege-tower-tower-watchdog-timer)
    (enable-timer bt-siege-tower-payload-watchdog-timer bt-siege-tower-payload-watchdog-seconds)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-payload-ready)
)

; Tower production failure is bounded separately from wall geometry failure.
(defrule
    (timer-triggered bt-siege-tower-tower-watchdog-timer)
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-tower-pending)
    (up-compare-goal bt-siege-tower-failure-retry-goal < bt-siege-tower-failure-retry-cap)
=>
    (disable-timer bt-siege-tower-tower-watchdog-timer)
    (set-goal bt-siege-tower-failure-goal bt-siege-tower-tower-timeout-failure)
    (up-modify-goal bt-siege-tower-failure-retry-goal g:+ 1)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-retry-wait)
    (enable-timer bt-siege-tower-retry-timer bt-siege-tower-wall-probe-interval)
)

; Third failed tower acquisition is terminal for this attack cycle.
(defrule
    (timer-triggered bt-siege-tower-tower-watchdog-timer)
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-tower-pending)
    (up-compare-goal bt-siege-tower-failure-retry-goal >= bt-siege-tower-failure-retry-cap)
=>
    (up-ungarrison c: siege-tower)
    (disable-timer bt-siege-tower-tower-watchdog-timer)
    (set-strategic-number sn-number-garrison-units 0)
    (set-strategic-number sn-maximum-garrison-fill 0)
    (set-goal bt-siege-tower-failure-goal bt-siege-tower-tower-timeout-failure)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-cycle-complete-goal 1)
)

; A completed tower can stall in payload-ready while the army rebuilds.
; Bound that wait so the project cannot permanently own the attack cycle.
(defrule
    (timer-triggered bt-siege-tower-payload-watchdog-timer)
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-payload-ready)
    (up-compare-goal bt-siege-tower-failure-retry-goal < bt-siege-tower-failure-retry-cap)
=>
    (disable-timer bt-siege-tower-payload-watchdog-timer)
    (set-goal bt-siege-tower-failure-goal bt-siege-tower-garrison-timeout-failure)
    (up-modify-goal bt-siege-tower-failure-retry-goal g:+ 1)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-retry-wait)
    (enable-timer bt-siege-tower-retry-timer bt-siege-tower-retry-interval)
)

(defrule
    (timer-triggered bt-siege-tower-payload-watchdog-timer)
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-payload-ready)
    (up-compare-goal bt-siege-tower-failure-retry-goal >= bt-siege-tower-failure-retry-cap)
=>
    (up-ungarrison c: siege-tower)
    (disable-timer bt-siege-tower-payload-watchdog-timer)
    (set-goal bt-siege-tower-failure-goal bt-siege-tower-garrison-timeout-failure)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-cycle-complete-goal 1)
)

; Payload is valid only when enough infantry exists and the standing army
; can spare the complete six-unit package without violating its floor.
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-payload-ready)
    (unit-type-count infantry-class >= bt-siege-tower-payload-min)
    (up-compare-goal bt-siege-tower-spare-army-goal >= bt-siege-tower-payload-min)
=>
    (disable-timer bt-siege-tower-payload-watchdog-timer)
    (set-strategic-number sn-number-garrison-units bt-siege-tower-payload-min)
    (set-strategic-number sn-maximum-garrison-fill bt-siege-tower-payload-min)
    (up-garrison siege-tower c: infantry-class)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-garrisoning)
    (enable-timer bt-siege-tower-garrison-watchdog-timer bt-siege-tower-garrison-watchdog-seconds)
)

; Verify the native garrison operation produced a real loaded tower.
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-garrisoning)
=>
    (up-full-reset-search)
    (up-filter-garrison c: -1 c: bt-siege-tower-payload-min)
    (up-find-local c: siege-tower c: 1)
    (up-get-search-state bt-siege-tower-execution-search-state-goal)
)

(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-garrisoning)
    (up-compare-goal bt-siege-tower-execution-search-state-goal >= 1)
=>
    (disable-timer bt-siege-tower-garrison-watchdog-timer)
    (set-strategic-number sn-number-garrison-units 0)
    (set-strategic-number sn-maximum-garrison-fill 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-loaded)
)

; Failed garrisoning is retried through the project failure ladder.
(defrule
    (timer-triggered bt-siege-tower-garrison-watchdog-timer)
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-garrisoning)
    (up-compare-goal bt-siege-tower-failure-retry-goal < bt-siege-tower-failure-retry-cap)
=>
    (disable-timer bt-siege-tower-garrison-watchdog-timer)
    (set-strategic-number sn-number-garrison-units 0)
    (set-strategic-number sn-maximum-garrison-fill 0)
    (set-goal bt-siege-tower-failure-goal bt-siege-tower-garrison-timeout-failure)
    (up-modify-goal bt-siege-tower-failure-retry-goal g:+ 1)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-retry-wait)
    (enable-timer bt-siege-tower-retry-timer bt-siege-tower-wall-probe-interval)
)

(defrule
    (timer-triggered bt-siege-tower-garrison-watchdog-timer)
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-garrisoning)
    (up-compare-goal bt-siege-tower-failure-retry-goal >= bt-siege-tower-failure-retry-cap)
=>
    (up-ungarrison c: siege-tower)
    (disable-timer bt-siege-tower-garrison-watchdog-timer)
    (set-strategic-number sn-number-garrison-units 0)
    (set-strategic-number sn-maximum-garrison-fill 0)
    (set-goal bt-siege-tower-failure-goal bt-siege-tower-garrison-timeout-failure)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-cycle-complete-goal 1)
)

; Loaded tower -> wall approach. Rebuild the DUC lists from the persisted
; wall point because other controller DUC consumers are allowed to reset them.
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-loaded)
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number g:= bt-scout-target-player-goal)
    (up-find-local c: siege-tower c: 1)
    (up-set-target-point bt-siege-tower-wall-point-goal)
    (up-filter-distance c: -1 c: 4)
    (up-find-remote c: bt-siege-tower-wall-class c: 4)
    (up-get-search-state bt-siege-tower-execution-search-state-goal)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-approach)
)

; A selected wall point may become invalid before the loaded tower
; reaches the approach stage. Treat that as a wall-candidate failure rather
; than arming a watchdog for an action that was never issued.
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-approach)
    (up-compare-goal bt-siege-tower-execution-remote-count-goal == 0)
    (up-compare-goal bt-siege-tower-wall-attempt-goal < bt-siege-tower-last-wall-attempt)
=>
    (up-ungarrison c: siege-tower)
    (set-strategic-number sn-number-garrison-units 0)
    (set-strategic-number sn-maximum-garrison-fill 0)
    (up-modify-goal bt-siege-tower-wall-attempt-goal g:+ 1)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-retry-wait)
    (enable-timer bt-siege-tower-retry-timer bt-siege-tower-retry-interval)
)

(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-approach)
    (up-compare-goal bt-siege-tower-execution-remote-count-goal == 0)
    (up-compare-goal bt-siege-tower-wall-attempt-goal >= bt-siege-tower-last-wall-attempt)
=>
    (up-ungarrison c: siege-tower)
    (set-goal bt-siege-tower-failure-goal bt-siege-tower-approach-exhausted-failure)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-cycle-complete-goal 1)
)

; Attack the selected wall. For a Siege Tower this is the native wall-crossing
; behavior: the tower travels to the wall and unloads its payload across it.
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-approach)
    (up-compare-goal bt-siege-tower-execution-remote-count-goal >= 1)
=>
    (up-target-objects 0 action-default -1 -1)
    (disable-timer bt-siege-tower-approach-watchdog-timer)
    (enable-timer bt-siege-tower-approach-watchdog-timer bt-siege-tower-approach-watchdog-seconds)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-unload-pending)
)

; A wall target disappeared or was not reusable. Advance to the next wall.
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-approach)
    (up-compare-goal bt-siege-tower-execution-search-state-goal == 0)
    (up-compare-goal bt-siege-tower-wall-attempt-goal < bt-siege-tower-last-wall-attempt)
=>
    (up-modify-goal bt-siege-tower-wall-attempt-goal g:+ 1)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-retry-wait)
    (enable-timer bt-siege-tower-retry-timer bt-siege-tower-retry-interval)
)

; If no replacement wall remains, terminate the project for this attack cycle.
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-approach)
    (up-compare-goal bt-siege-tower-execution-search-state-goal == 0)
    (up-compare-goal bt-siege-tower-wall-attempt-goal >= bt-siege-tower-last-wall-attempt)
=>
    (up-ungarrison c: siege-tower)
    (set-goal bt-siege-tower-failure-goal bt-siege-tower-approach-exhausted-failure)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-cycle-complete-goal 1)
)

; Approach watchdog: if the loaded tower never reaches the selected wall,
; move on to the next candidate rather than repeatedly issuing the same order.
(defrule
    (timer-triggered bt-siege-tower-approach-watchdog-timer)
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-unload-pending)
    (up-compare-goal bt-siege-tower-wall-attempt-goal < bt-siege-tower-last-wall-attempt)
=>
    (disable-timer bt-siege-tower-approach-watchdog-timer)
    (up-ungarrison c: siege-tower)
    (set-strategic-number sn-number-garrison-units 0)
    (set-strategic-number sn-maximum-garrison-fill 0)
    (up-modify-goal bt-siege-tower-wall-attempt-goal g:+ 1)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-retry-wait)
    (enable-timer bt-siege-tower-retry-timer bt-siege-tower-retry-interval)
)

(defrule
    (timer-triggered bt-siege-tower-approach-watchdog-timer)
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-unload-pending)
    (up-compare-goal bt-siege-tower-wall-attempt-goal >= bt-siege-tower-last-wall-attempt)
=>
    (up-ungarrison c: siege-tower)
    (disable-timer bt-siege-tower-approach-watchdog-timer)
    (set-goal bt-siege-tower-failure-goal bt-siege-tower-approach-exhausted-failure)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-cycle-complete-goal 1)
)

; Check whether the loaded tower has actually arrived at the wall.  Arrival
; alone does not count as crossing; that is the next unload-pending state.
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-unload-pending)
=>
    (up-full-reset-search)
    (up-set-target-point bt-siege-tower-wall-point-goal)
    (up-filter-distance c: -1 c: 8)
    (up-find-local c: siege-tower c: 1)
    (up-get-search-state bt-siege-tower-execution-search-state-goal)
)

(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-unload-pending)
    (up-compare-goal bt-siege-tower-execution-search-state-goal >= 1)
=>
    (disable-timer bt-siege-tower-approach-watchdog-timer)
    (enable-timer bt-siege-tower-unload-watchdog-timer bt-siege-tower-unload-watchdog-seconds)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-unload-pending)
)

; Once the native wall-target behavior empties the tower, the crossing action
; has completed.  Stage 8 then gives the normal attack system time to own the
; delivered infantry.
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-unload-pending)
=>
    (up-full-reset-search)
    (up-set-target-point bt-siege-tower-wall-point-goal)
    (up-filter-distance c: -1 c: 8)
    (up-filter-garrison c: 0 c: 0)
    (up-find-local c: siege-tower c: 1)
    (up-get-search-state bt-siege-tower-execution-search-state-goal)
)

(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-unload-pending)
    (up-compare-goal bt-siege-tower-execution-search-state-goal >= 1)
=>
    (disable-timer bt-siege-tower-unload-watchdog-timer)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-assault)
    (enable-timer bt-siege-tower-assault-watchdog-timer bt-siege-tower-assault-watchdog-seconds)
)

; Unload watchdog: try another wall if the tower reached the first wall but
; never completed its native cross-wall unload.
(defrule
    (timer-triggered bt-siege-tower-unload-watchdog-timer)
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-unload-pending)
    (up-compare-goal bt-siege-tower-wall-attempt-goal < bt-siege-tower-last-wall-attempt)
=>
    (disable-timer bt-siege-tower-unload-watchdog-timer)
    (up-ungarrison c: siege-tower)
    (set-strategic-number sn-number-garrison-units 0)
    (set-strategic-number sn-maximum-garrison-fill 0)
    (up-modify-goal bt-siege-tower-wall-attempt-goal g:+ 1)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-retry-wait)
    (enable-timer bt-siege-tower-retry-timer bt-siege-tower-retry-interval)
)

(defrule
    (timer-triggered bt-siege-tower-unload-watchdog-timer)
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-unload-pending)
    (up-compare-goal bt-siege-tower-wall-attempt-goal >= bt-siege-tower-last-wall-attempt)
=>
    (up-ungarrison c: siege-tower)
    (disable-timer bt-siege-tower-unload-watchdog-timer)
    (set-goal bt-siege-tower-failure-goal bt-siege-tower-unload-exhausted-failure)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-cycle-complete-goal 1)
)

; A delivered payload is now owned by the ordinary attack lifecycle.
(defrule
    (timer-triggered bt-siege-tower-assault-watchdog-timer)
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-assault)
=>
    (up-ungarrison c: siege-tower)
    (disable-timer bt-siege-tower-assault-watchdog-timer)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-cycle-complete-goal 1)
)

; Target collapse ends the project early.
(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-assault)
    (players-building-count target-player == 0)
=>
    (up-ungarrison c: siege-tower)
    (disable-timer bt-siege-tower-assault-watchdog-timer)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-cycle-complete-goal 1)
)

; Retry/re-probe transition. Wall execution failures preserve the
; candidate index so the next probe selects the next wall. Production,
; payload, and no-target failures reset to candidate zero because the
; selected wall has not been proven unusable.
(defrule
    (timer-triggered bt-siege-tower-retry-timer)
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-retry-wait)
    (goal bt-siege-tower-failure-goal bt-siege-tower-approach-exhausted-failure)
=>
    (disable-timer bt-siege-tower-retry-timer)
    (set-goal bt-siege-tower-failure-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-wall-probe)
)

(defrule
    (timer-triggered bt-siege-tower-retry-timer)
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-retry-wait)
    (goal bt-siege-tower-failure-goal bt-siege-tower-unload-exhausted-failure)
=>
    (disable-timer bt-siege-tower-retry-timer)
    (set-goal bt-siege-tower-failure-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-wall-probe)
)

(defrule
    (timer-triggered bt-siege-tower-retry-timer)
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-retry-wait)
=>
    (disable-timer bt-siege-tower-retry-timer)
    (set-goal bt-siege-tower-failure-goal 0)
    (set-goal bt-siege-tower-wall-attempt-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-wall-probe)
)

; The attack cycle itself owns the final reset. This releases cycle-complete
; so the next attack may create a fresh project.
(defrule
    (goal attack-goal 0)
    (or (goal bt-siege-tower-demand-goal 1) (or (up-compare-goal bt-siege-tower-stage-goal > 0) (up-compare-goal bt-siege-tower-cycle-complete-goal == 1)))
=>
    (up-ungarrison c: siege-tower)
    (disable-timer bt-siege-tower-tower-watchdog-timer)
    (disable-timer bt-siege-tower-payload-watchdog-timer)
    (disable-timer bt-siege-tower-garrison-watchdog-timer)
    (disable-timer bt-siege-tower-approach-watchdog-timer)
    (disable-timer bt-siege-tower-unload-watchdog-timer)
    (disable-timer bt-siege-tower-assault-watchdog-timer)
    (disable-timer bt-siege-tower-retry-timer)
    (set-strategic-number sn-number-garrison-units 0)
    (set-strategic-number sn-maximum-garrison-fill 0)
    (set-goal bt-siege-tower-demand-goal 0)
    (set-goal bt-siege-tower-stage-goal bt-siege-tower-stage-idle)
    (set-goal bt-siege-tower-wall-attempt-goal 0)
    (set-goal bt-siege-tower-failure-goal 0)
    (set-goal bt-siege-tower-failure-retry-goal 0)
    (set-goal bt-siege-tower-cycle-complete-goal 0)
)
 
;---------------------------------------------------------------
; 18B. UNIVERSITY CAPABILITY
;---------------------------------------------------------------
; University is a shared capability provider for the live Castle/Imperial
; research packages that explicitly require this building.
(defrule
    (goal bt-university-demand-goal 0)
    (current-age >= castle-age)
    (building-type-count-total university == 0)
    (up-pending-objects c: university == 0)
    (goal bt-university-backoff-goal 0)
    (or
        (goal bt-research-siege-package-goal ri-ballistics)
        (goal bt-research-siege-package-goal ri-chemistry)
    )
=>
    (set-goal bt-university-demand-goal 1)
)
(defrule
    (goal bt-university-demand-goal 1)
    (building-type-count-total university >= 1)
=>
    (disable-timer bt-university-watchdog-timer)
    (disable-timer bt-university-backoff-timer)
    (set-goal bt-university-demand-goal 0)
    (set-goal bt-university-backoff-goal 0)
)
(defrule
    (goal bt-university-demand-goal 1)
    (strategic-number sn-resource-control != bt-university-claim)
    (goal bt-research-siege-package-goal 0)
    (goal bt-research-ranged-counter-package-goal 0)
=>
    (disable-timer bt-university-backoff-timer)
    (set-goal bt-university-demand-goal 0)
    (set-goal bt-university-backoff-goal 0)
)
(defrule
    (goal bt-university-demand-goal 1)
    (goal bt-university-backoff-goal 0)
    (strategic-number sn-resource-control == 0)
    (up-pending-objects c: university == 0)
    (can-build-with-escrow university)
=>
    (set-strategic-number sn-resource-control bt-university-claim)
    (release-escrow wood)
    (enable-timer bt-university-watchdog-timer bt-university-watchdog-seconds)
    (build university)
)
(defrule
    (strategic-number sn-resource-control == bt-university-claim)
    (building-type-count university >= 1)
=>
    (disable-timer bt-university-watchdog-timer)
    (set-goal bt-university-demand-goal 0)
    (set-goal bt-university-backoff-goal 0)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-university-demand-goal 0)
    (up-pending-objects c: university == 0)
=>
    (disable-timer bt-university-backoff-timer)
    (set-goal bt-university-backoff-goal 0)
)

;----------------------------------------------------------------
; UNIVERSITY CONSTRUCTION WATCHDOG
(defrule
    (strategic-number sn-resource-control == bt-university-claim)
    (timer-triggered bt-university-watchdog-timer)
    (up-pending-objects c: university > 0)
=>
    (disable-timer bt-university-watchdog-timer)
    (up-assign-builders c: university c: bt-foundation-stall-builder-count)
    (enable-timer bt-university-watchdog-timer bt-university-watchdog-seconds)
)
(defrule
    (strategic-number sn-resource-control == bt-university-claim)
    (timer-triggered bt-university-watchdog-timer)
    (up-pending-objects c: university == 0)
=>
    (disable-timer bt-university-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-university-backoff-goal 1)
    (enable-timer bt-university-backoff-timer bt-university-backoff-seconds)
)
(defrule
    (goal bt-university-backoff-goal 1)
    (timer-triggered bt-university-backoff-timer)
=>
    (disable-timer bt-university-backoff-timer)
    (set-goal bt-university-backoff-goal 0)
)

;---------------------------------------------------------------
; 18C. MILITARY SIEGE WORKSHOP CAPABILITY
;---------------------------------------------------------------
; Any siege demand can own the Workshop capability edge. This block is the
; single construction provider for every current Workshop consumer.
;
; The military Workshop claim is transient execution state. It uses the
; existing resource mutex but never reuses the Imperial prerequisite claim,
; watchdog, retry, or backoff state.
;
; building-type-count excludes pending foundations, while up-pending-objects
; explicitly guards the construction queue. This prevents duplicate
; Workshop attempts and keeps the completion witness honest.
(defrule
    (or (goal bt-mangonel-demand-goal 1) (or (goal bt-scorpion-demand-goal 1) (or (goal bt-onager-demand-goal 1) (or (goal bt-bombard-cannon-demand-goal 1) (or (goal bt-ram-demand-goal 1) (goal bt-siege-tower-demand-goal 1))))))
    (goal bt-military-siege-workshop-backoff-goal 0)
    (building-type-count siege-workshop == 0)
    (up-pending-objects c: siege-workshop == 0)
    (strategic-number sn-resource-control == 0)
    (can-build-with-escrow siege-workshop)
=>
    (set-strategic-number sn-resource-control bt-military-siege-workshop-claim)
    (release-escrow wood)
    (enable-timer bt-military-siege-workshop-watchdog-timer bt-military-siege-workshop-watchdog-seconds)
    (build siege-workshop)
)

; Completed Workshop is the actual capability witness.
(defrule
    (strategic-number sn-resource-control == bt-military-siege-workshop-claim)
    (building-type-count siege-workshop >= 1)
=>
    (disable-timer bt-military-siege-workshop-watchdog-timer)
    (disable-timer bt-military-siege-workshop-backoff-timer)
    (set-goal bt-military-siege-workshop-backoff-goal 0)
    (set-strategic-number sn-resource-control 0)
)

; A timed-out Workshop foundation may finish after the watchdog has

; owner of sn-resource-control.
(defrule
    (building-type-count siege-workshop >= 1)
    (strategic-number sn-resource-control != bt-military-siege-workshop-claim)
=>
    (disable-timer bt-military-siege-workshop-backoff-timer)
    (set-goal bt-military-siege-workshop-backoff-goal 0)
)

; Clear stale cooldown state when all Workshop demand disappears and no foundation remains.
(defrule
    ; No Workshop demand owner remains.  Only then may a stale construction
    ; stale cooldown state be discarded.
    (goal bt-mangonel-demand-goal 0)
    (goal bt-scorpion-demand-goal 0)
    (goal bt-onager-demand-goal 0)
    (goal bt-bombard-cannon-demand-goal 0)
    (goal bt-ram-demand-goal 0)
    (goal bt-siege-tower-demand-goal 0)
    (strategic-number sn-resource-control != bt-military-siege-workshop-claim)
    (up-pending-objects c: siege-workshop == 0)
=>
    (disable-timer bt-military-siege-workshop-backoff-timer)
    (set-goal bt-military-siege-workshop-backoff-goal 0)
)

; Backoff is a flat cooldown only. It never claims the resource mutex.
(defrule
    (goal bt-military-siege-workshop-backoff-goal 1)
    (timer-triggered bt-military-siege-workshop-backoff-timer)
=>
    (disable-timer bt-military-siege-workshop-backoff-timer)
    (set-goal bt-military-siege-workshop-backoff-goal 0)
)

;----------------------------------------------------------------
; MILITARY SIEGE WORKSHOP CONSTRUCTION WATCHDOG
; Siege demand is persistent. A live Workshop foundation is the execution
; state; a missing foundation after the watchdog fires is one flat cooldown.
(defrule
    (strategic-number sn-resource-control == bt-military-siege-workshop-claim)
    (timer-triggered bt-military-siege-workshop-watchdog-timer)
    (up-pending-objects c: siege-workshop > 0)
=>
    (disable-timer bt-military-siege-workshop-watchdog-timer)
    (up-assign-builders c: siege-workshop c: bt-foundation-stall-builder-count)
    (enable-timer bt-military-siege-workshop-watchdog-timer bt-military-siege-workshop-watchdog-seconds)
)
(defrule
    (strategic-number sn-resource-control == bt-military-siege-workshop-claim)
    (timer-triggered bt-military-siege-workshop-watchdog-timer)
    (up-pending-objects c: siege-workshop == 0)
=>
    (disable-timer bt-military-siege-workshop-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-military-siege-workshop-backoff-goal 1)
    (enable-timer bt-military-siege-workshop-backoff-timer bt-military-siege-workshop-backoff-seconds)
)

(defrule
    (timer-triggered bt-attack-timer)
    (current-age >= feudal-age)
    (players-building-count any-enemy > 0)
    (players-building-count target-player > 0)
    (up-compare-goal bt-attack-reserve-goal >= 10)
    (up-compare-goal bt-relative-force-goal >= 0)
    ; Every strategy must first satisfy the existing standing-army
    ; completion witness. Castle-Power additionally requires its selected
    ; Crossbow core as completed units.
    (or
        (not (goal strategy-goal bt-strategy-castle-power))
        (and
            (up-compare-goal bt-standing-crossbow-target-goal > 0)
            (unit-type-count crossbowman >= bt-standing-crossbow-target-goal)
        )
    )
    (goal bt-counter-veto-goal 0)
    (goal bt-standing-army-demand-goal 0)
    (goal attack-goal 0)
    (goal retreat-now-goal 0)
    (not (town-under-attack))
=>
    ; Mark the attack cycle active BEFORE attack-now.
    (set-goal attack-goal 1)
    (enable-timer bt-attack-gather-watchdog-timer bt-attack-gather-watchdog-seconds)

    ; Force the available attack units into an attack-group.
    ;
    ; attack-now should NOT be spammed.
    (attack-now)

    ; Hold the attack cycle for five minutes before resetting it.
    (enable-timer bt-attack-timer 300)
    

)

;---------------------------------------------------------------
; 18A.2. IMPERIAL SIEGE CONVERSION PACKAGE
;---------------------------------------------------------------
; Persistent strategic intent. The package survives attack resets and retreat.
; Its children own actual capabilities and close independently.
(defrule
    (goal bt-imperial-siege-package-goal 0)
    (current-age >= imperial-age)
    (player-in-game target-player)
    (players-building-count target-player > 0)
    (up-compare-goal bt-standing-army-floor-goal >= bt-imperial-siege-army-floor)
    (up-compare-goal bt-standing-army-deficit-goal >= 0)
    (up-compare-goal bt-attack-reserve-goal >= bt-imperial-siege-reserve-floor)
    (up-compare-goal bt-relative-force-goal >= bt-imperial-siege-force-floor)
    (goal bt-counter-veto-goal 0)
    (goal retreat-now-goal 0)
    (not (town-under-attack))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
=>
    (set-goal bt-imperial-siege-package-goal 1)
)

(defrule
    (goal bt-imperial-siege-package-goal 1)
    (or
        (current-age < imperial-age)
        (or
            (not (player-in-game target-player))
            (players-building-count target-player == 0)
        )
    )
=>
    (set-goal bt-imperial-siege-package-goal 0)
    (set-goal bt-trebuchet-demand-goal 0)
    (set-goal bt-trebuchet-target-goal 0)
)

; Missing Castle recovery reuses the existing Castle demand/capability owner.
; Do not require 650 stone before creating the demand: the Castle-stone
; resource mode exists precisely to accumulate the missing stone.
(defrule
    (goal bt-imperial-siege-package-goal 1)
    (current-age >= imperial-age)
    (building-type-count-total castle < 1)
    (up-pending-objects c: castle == 0)
    (goal bt-castle-cataphract-demand-goal 0)
    (goal bt-castle-cataphract-backoff-goal 0)
    (player-in-game target-player)
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal >= bt-forward-castle-force-floor)
    (up-compare-goal bt-attack-reserve-goal >= bt-forward-castle-reserve-floor)
=>
    (set-goal bt-castle-cataphract-demand-goal 1)
)

; Trebuchets are only demanded for defended/high-value structures.
(defrule
    (goal bt-trebuchet-demand-goal 0)
    (goal bt-imperial-siege-package-goal 1)
    (current-age >= imperial-age)
    (building-type-count castle >= 1)
    (player-in-game target-player)
    (players-building-count target-player > 0)
    (or
        (players-building-type-count target-player castle >= 2)
        (players-building-type-count target-player town-center >= 4)
    )
=>
    (set-goal bt-trebuchet-target-goal bt-trebuchet-fortified-target)
    (set-goal bt-trebuchet-demand-goal 1)
)

(defrule
    (goal bt-trebuchet-demand-goal 0)
    (goal bt-imperial-siege-package-goal 1)
    (current-age >= imperial-age)
    (building-type-count castle >= 1)
    (player-in-game target-player)
    (players-building-count target-player > 0)
    (or
        (players-building-type-count target-player castle >= 1)
        (players-building-type-count target-player town-center >= 3)
    )
=>
    (set-goal bt-trebuchet-target-goal bt-trebuchet-target)
    (set-goal bt-trebuchet-demand-goal 1)
)

(defrule
    ; Completed Trebs are the demand witness. Queued Trebs only gate the
    ; production action below and must not close the strategic demand early.
    (goal bt-trebuchet-demand-goal 1)
    (goal bt-imperial-siege-package-goal 1)
    (unit-type-count trebuchet-set >= bt-trebuchet-target-goal)
=>
    (set-goal bt-trebuchet-demand-goal 0)
)

(defrule
    (goal bt-trebuchet-demand-goal 1)
    (goal bt-imperial-siege-package-goal 1)
    (or
        (players-building-count target-player == 0)
        (or
            (not (player-in-game target-player))
            (or
                (current-age < imperial-age)
                (building-type-count castle < 1)
            )
        )
    )
=>
    (set-goal bt-trebuchet-demand-goal 0)
    (set-goal bt-trebuchet-target-goal 0)
)

(defrule
    ; Direct community-native production pattern: total-count target,
    ; engine feasibility, then train.
    (goal bt-trebuchet-demand-goal 1)
    (current-age >= imperial-age)
    (building-type-count castle >= 1)
    (strategic-number sn-resource-control == 0)
    (goal bt-counter-veto-goal 0)
    (goal retreat-now-goal 0)
    (not (town-under-attack))
    (unit-type-count-total trebuchet-set < bt-trebuchet-target-goal)
    (can-train-with-escrow trebuchet)
=>
    (release-escrow wood)
    (release-escrow gold)
    (train trebuchet)
)

;---------------------------------------------------------------
; 18A.2. ATTACK / BUILDING-PRESSURE RAM DEMAND
;---------------------------------------------------------------
; Attack authority already proves the army package is active. This state
; narrows that attack to the building-assault purpose.
(defrule
    ; Castle-age Ram pressure is a finite two-Ram package.
    (goal bt-ram-demand-goal 0)
    (current-age == castle-age)
    (goal attack-goal 1)
    (players-building-count target-player > 0)
    (up-compare-goal bt-attack-reserve-goal >= 10)
    (up-compare-goal bt-relative-force-goal >= 0)
    (goal bt-counter-veto-goal 0)
    (goal retreat-now-goal 0)
    (not (town-under-attack))
    (unit-type-count battering-ram-line < bt-ram-response-target)
=>
    (set-goal bt-ram-demand-goal 1)
)

(defrule
    ; Imperial Rams belong to the persistent siege package, not the transient
    ; attack-goal latch. Castle Rams retain the normal attack lifecycle.
    (goal bt-ram-demand-goal 0)
    (goal bt-imperial-siege-package-goal 1)
    (current-age >= imperial-age)
    (players-building-count target-player > 0)
    (up-compare-goal bt-attack-reserve-goal >= 10)
    (up-compare-goal bt-relative-force-goal >= 0)
    (goal bt-counter-veto-goal 0)
    (goal retreat-now-goal 0)
    (not (town-under-attack))
    (or
        (unit-type-count battering-ram-line < bt-ram-imperial-response-target)
        (not (up-research-status c: ri-siege-ram == research-complete))
    )
=>
    (set-goal bt-ram-demand-goal 1)
)

(defrule
    (goal bt-ram-demand-goal 1)
    (or
        (players-building-count target-player == 0)
        (or
            (and
                (current-age == castle-age)
                (goal attack-goal 0)
            )
            (and
                (current-age >= imperial-age)
                (goal bt-imperial-siege-package-goal 0)
            )
        )
    )
=>
    (set-goal bt-ram-demand-goal 0)
)

; Once the package exists, the gather watchdog is no longer relevant.
(defrule
    (goal attack-goal 1)
    (attack-soldier-count >= 10)
=>
    (disable-timer bt-attack-gather-watchdog-timer)
)
; If attack-now fails to assemble the minimum package, release the
; cycle instead of leaving attack-goal latched for the long reset.
(defrule
    (timer-triggered bt-attack-gather-watchdog-timer)
    (goal attack-goal 1)
    (attack-soldier-count < 10)
=>
    (disable-timer bt-attack-gather-watchdog-timer)
    (up-reset-attack-now)
    (set-goal attack-goal 0)
    (enable-timer bt-attack-timer 180)
)

; attack-soldier-count >= 10 is the terminal attack-package witness.
;================================================================
; 19. ATTACK CYCLE RESET
;================================================================
;
; Q: "How do we regain script control after attack-now?"
;
; UserPatch supplies up-reset-attack-now for exactly this purpose.
(defrule
    (timer-triggered bt-attack-timer)
    (goal attack-goal 1)
=>
    (up-reset-attack-now)
    (disable-timer bt-attack-gather-watchdog-timer)

    ; End this attack cycle.
    (set-goal attack-goal 0)

    ; Cooldown before another attack command.
    (enable-timer bt-attack-timer 180)
    

)

;================================================================
; 20. RETREAT
;================================================================
;
; Q: "When does a human player abandon the attack?"
;
; Here:
;
;   attack is active
;   +
;   town is under attack
;   ->
;   recall military
;
; The rule is deliberately broad and conservative.
;
; up-retreat-now recalls military units toward the home Town Center.
(defrule
    (goal attack-goal 1)
    (goal retreat-now-goal 0)
    (or (town-under-attack) (or (up-compare-goal bt-attack-reserve-goal < 0) (and
            (players-building-count target-player > 0)
            (up-compare-goal bt-relative-force-goal < -5)
        )))
=>
    (set-goal retreat-now-goal 1)

    
    ; Stop the persistent attack-now targeting.
    (up-reset-attack-now)
    (disable-timer bt-attack-gather-watchdog-timer)

    ; Recall military forces.
    (up-retreat-now)

    ; End the attack cycle.
    (set-goal attack-goal 0)

    ; Stop the existing attack cooldown.
    (disable-timer bt-attack-timer)

    ; Prevent repeated retreat commands.
    (enable-timer bt-retreat-timer 120)
    

)

;================================================================
; 21. RETREAT RELEASE
;================================================================
(defrule
    (timer-triggered bt-retreat-timer)
    (goal retreat-now-goal 1)
=>
    (set-goal retreat-now-goal 0)

    
    ; Let the army regroup at home before another attack opportunity.
    (enable-timer bt-attack-timer 180)
    

)

;================================================================
; 22. RAM UPGRADES
;================================================================
; Capped Ram is the first building-pressure investment. Two actual Rams
; plus live attack/building pressure justify the Imperial upgrade.
(defrule
    (goal bt-ram-demand-goal 1)
    (goal bt-imperial-siege-package-goal 1)
    (current-age >= imperial-age)
    (building-type-count siege-workshop >= 1)
    (unit-type-count battering-ram-line >= 2)
    (up-compare-goal bt-attack-reserve-goal >= 10)
    (up-compare-goal bt-relative-force-goal >= 0)
    (goal bt-counter-veto-goal 0)
    (goal retreat-now-goal 0)
    (up-compare-goal bt-research-siege-workshop-failure-backoff-goal != ri-capped-ram)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-capped-ram)
    (goal bt-research-siege-workshop-claim-goal 0)
    (goal bt-research-siege-package-goal ri-capped-ram)
=>
    (set-strategic-number sn-resource-control ri-capped-ram)
    (release-escrow food)
    (release-escrow gold)
    (research ri-capped-ram)
    (set-goal bt-research-siege-workshop-claim-goal ri-capped-ram)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-research-siege-workshop-claim-goal ri-capped-ram)
    (up-research-status c: ri-capped-ram == research-complete)
=>
    (set-goal bt-research-siege-workshop-claim-goal 0)
)

; Siege Ram is the second-stage investment. Four actual Rams plus completed
; Capped Ram establish an actual building-assault package before the larger
; Imperial upgrade is purchased.
(defrule
    (goal bt-ram-demand-goal 1)
    (current-age >= imperial-age)
    (building-type-count siege-workshop >= 1)
    (unit-type-count battering-ram-line >= 4)
    (up-research-status c: ri-capped-ram == research-complete)
    (up-compare-goal bt-attack-reserve-goal >= 10)
    (up-compare-goal bt-relative-force-goal >= 0)
    (goal bt-counter-veto-goal 0)
    (goal retreat-now-goal 0)
    (up-compare-goal bt-research-siege-workshop-failure-backoff-goal != ri-siege-ram)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-siege-ram)
    (goal bt-research-siege-workshop-claim-goal 0)
    (goal bt-research-siege-package-goal ri-siege-ram)
=>
    (set-strategic-number sn-resource-control ri-siege-ram)
    (release-escrow food)
    (release-escrow gold)
    (research ri-siege-ram)
    (set-goal bt-research-siege-workshop-claim-goal ri-siege-ram)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-research-siege-workshop-claim-goal ri-siege-ram)
    (up-research-status c: ri-siege-ram == research-complete)
=>
    (set-goal bt-research-siege-workshop-claim-goal 0)
)

(defrule
    ; Castle Ram package is complete at the actual two-Ram response target.
    (goal bt-ram-demand-goal 1)
    (current-age == castle-age)
    (unit-type-count battering-ram-line >= bt-ram-response-target)
=>
    (set-goal bt-ram-demand-goal 0)
)

(defrule
    ; Imperial Ram package remains live through Capped/Siege Ram research.
    ; Completion requires the full four-Ram package and completed Siege Ram.
    (goal bt-ram-demand-goal 1)
    (current-age >= imperial-age)
    (unit-type-count battering-ram-line >= bt-ram-imperial-response-target)
    (up-research-status c: ri-siege-ram == research-complete)
=>
    (set-goal bt-ram-demand-goal 0)
)

;================================================================
; 22. CASTLE / IMPERIAL PRIMARY MILITARY RESEARCH
;================================================================

; Scale Mail belongs to a real Spear response package.
; It waits for both strategic demand and a queue-inclusive six-Spear package,
; and remains reachable in Castle when the Feudal prerequisite was skipped.
(defrule
    (current-age >= feudal-age)
    (building-type-count blacksmith >= 1)
    (up-compare-goal bt-standing-spear-target-goal >= bt-spear-target-1)
    (current-age > castle-age)
    (unit-type-count-total spearman-line >= bt-spear-target-1)
    (up-research-status c: ri-scale-mail < research-pending)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-scale-mail)
    (strategic-number sn-resource-control == 0)
    (or
        (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
        (and (up-compare-goal bt-cavalry-counter-level-goal >= 1) (and (up-compare-goal bt-scale-mail-bank-delta-food-goal >= 0) (and
            (up-compare-goal bt-scale-mail-bank-delta-wood-goal >= 0)
            (up-compare-goal bt-scale-mail-bank-delta-gold-goal >= 0))))
    )
    (can-research-with-escrow ri-scale-mail)
    (goal bt-research-blacksmith-claim-goal 0)
    (goal bt-research-cavalry-counter-package-goal ri-scale-mail)
=>
    (set-strategic-number sn-resource-control ri-scale-mail)
    (release-escrow food)
    (research ri-scale-mail)
    (set-goal bt-research-blacksmith-claim-goal ri-scale-mail)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (current-age >= feudal-age)
    (building-type-count blacksmith >= 1)
    (up-compare-goal bt-standing-spear-target-goal >= bt-spear-target-1)
    (and (current-age == castle-age) (not (goal bt-imperial-commitment-goal 1)))
    (unit-type-count-total spearman-line >= bt-spear-target-1)
    (up-research-status c: ri-scale-mail < research-pending)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-scale-mail)
    (strategic-number sn-resource-control == 0)
    (or
        (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
        (and (up-compare-goal bt-cavalry-counter-level-goal >= 1) (and (up-compare-goal bt-scale-mail-bank-delta-food-goal >= 0) (and
            (up-compare-goal bt-scale-mail-bank-delta-wood-goal >= 0)
            (up-compare-goal bt-scale-mail-bank-delta-gold-goal >= 0))))
    )
    (can-research-with-escrow ri-scale-mail)
    (goal bt-research-blacksmith-claim-goal 0)
    (goal bt-research-cavalry-counter-package-goal ri-scale-mail)
=>
    (set-strategic-number sn-resource-control ri-scale-mail)
    (release-escrow food)
    (research ri-scale-mail)
    (set-goal bt-research-blacksmith-claim-goal ri-scale-mail)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (current-age >= feudal-age)
    (building-type-count blacksmith >= 1)
    (up-compare-goal bt-standing-spear-target-goal >= bt-spear-target-1)
    (current-age == feudal-age)
    (not (goal bt-castle-commitment-goal 1))
    (unit-type-count-total spearman-line >= bt-spear-target-1)
    (up-research-status c: ri-scale-mail < research-pending)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-scale-mail)
    (strategic-number sn-resource-control == 0)
    (or
        (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
        (and (up-compare-goal bt-cavalry-counter-level-goal >= 1) (and (up-compare-goal bt-scale-mail-bank-delta-food-goal >= 0) (and
            (up-compare-goal bt-scale-mail-bank-delta-wood-goal >= 0)
            (up-compare-goal bt-scale-mail-bank-delta-gold-goal >= 0))))
    )
    (can-research-with-escrow ri-scale-mail)
    (goal bt-research-blacksmith-claim-goal 0)
    (goal bt-research-cavalry-counter-package-goal ri-scale-mail)
=>
    (set-strategic-number sn-resource-control ri-scale-mail)
    (release-escrow food)
    (research ri-scale-mail)
    (set-goal bt-research-blacksmith-claim-goal ri-scale-mail)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-research-blacksmith-claim-goal ri-scale-mail)
    (up-research-status c: ri-scale-mail == research-complete)
=>
    (set-goal bt-research-blacksmith-claim-goal 0)
)

; Castle Chain Mail continues the standing Spear package after Scale Mail.
; A queue-inclusive six-Spear package must exist before the investment is made.
(defrule
    (current-age >= castle-age)
    (building-type-count blacksmith >= 1)
    (up-compare-goal bt-standing-spear-target-goal >= bt-spear-target-1)
    (or (current-age > castle-age) (not (goal bt-imperial-commitment-goal 1)))
    (unit-type-count-total spearman-line >= bt-spear-target-1)
    (up-research-status c: ri-scale-mail == research-complete)
    (up-research-status c: ri-chain-mail < research-pending)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-chain-mail)
    (strategic-number sn-resource-control == 0)
    (or
        (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
        (and (up-compare-goal bt-cavalry-counter-level-goal >= 1) (and (up-compare-goal bt-chain-mail-bank-delta-food-goal >= 0) (and
            (up-compare-goal bt-chain-mail-bank-delta-wood-goal >= 0)
            (up-compare-goal bt-chain-mail-bank-delta-gold-goal >= 0))))
    )
    (can-research-with-escrow ri-chain-mail)
    (goal bt-research-blacksmith-claim-goal 0)
    (goal bt-research-cavalry-counter-package-goal ri-chain-mail)
=>
    (set-strategic-number sn-resource-control ri-chain-mail)
    (release-escrow food)
    (release-escrow gold)
    (research ri-chain-mail)
    (set-goal bt-research-blacksmith-claim-goal ri-chain-mail)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-research-blacksmith-claim-goal ri-chain-mail)
    (up-research-status c: ri-chain-mail == research-complete)
=>
    (set-goal bt-research-blacksmith-claim-goal 0)
)

; Crossbow support: Fletching -> Crossbow -> Bodkin.
; Feudal ranged packages earn Fletching before Castle transition.
; Standing targets identify the intended ranged role; the queue-inclusive
; unit count prevents spending the tech for a merely declared role.
(defrule
    (current-age == feudal-age)
    (building-type-count blacksmith >= 1)
    (or
        (and
            (up-compare-goal bt-standing-archer-target-goal > 0)
            (unit-type-count-total archer-line >= 3)
        )
        (and
            (up-compare-goal bt-standing-skirm-target-goal > 0)
            (unit-type-count-total skirmisher-line >= 3)
        )
        (unit-type-count-total cavalry-archer-line >= 3)
    )
    (not (goal bt-castle-commitment-goal 1))
    (up-research-status c: ri-fletching < research-pending)
    (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-fletching)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-fletching)
    (goal bt-research-blacksmith-claim-goal 0)
    (goal bt-research-ranged-counter-package-goal ri-fletching)
=>
    (set-strategic-number sn-resource-control ri-fletching)
    (release-escrow food)
    (release-escrow gold)
    (research ri-fletching)
    (set-goal bt-research-blacksmith-claim-goal ri-fletching)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (current-age >= castle-age)
    (or (current-age > castle-age) (not (goal bt-imperial-commitment-goal 1)))
    (building-type-count blacksmith >= 1)
    (up-research-status c: ri-fletching < research-pending)
    (or
        (goal bt-ranged-threat-goal 1)
        (goal bt-blacksmith-ranged-army-goal 1)
    )
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-fletching)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-fletching)
    (goal bt-research-blacksmith-claim-goal 0)
    (goal bt-research-ranged-counter-package-goal ri-fletching)
=>
    (set-strategic-number sn-resource-control ri-fletching)
    (release-escrow food)
    (release-escrow gold)
    (research ri-fletching)
    (set-goal bt-research-blacksmith-claim-goal ri-fletching)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-research-blacksmith-claim-goal ri-fletching)
    (up-research-status c: ri-fletching == research-complete)
=>
    (set-goal bt-research-blacksmith-claim-goal 0)
)

; Castle catch-up for a previously skipped ranged foundation.
; Fletching is required by Bodkin and also benefits Skirmishers, so a fast
; Castle transition must not permanently strand the ranged upgrade chain.

(defrule
    (current-age >= castle-age)
    (up-research-status c: ri-fletching == research-complete)
    (up-research-status c: ri-crossbow < research-pending)
    (building-type-count archery-range >= 1)
    (or
        (goal strategy-goal bt-strategy-boom)
        (goal strategy-goal bt-strategy-castle-power)
    )
    (goal bt-any-threat-goal 0)
    (goal bt-ranged-threat-goal 0)
    (or
        (goal bt-resource-mode-goal bt-resource-mode-castle-boom)
        (goal bt-resource-mode-goal bt-resource-mode-premium-gold)
    )
    (up-compare-goal bt-research-archery-range-failure-backoff-goal != ri-crossbow)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-crossbow)
    (goal bt-research-archery-range-claim-goal 0)
    (goal bt-research-ranged-counter-package-goal ri-crossbow)
=>
    (set-strategic-number sn-resource-control ri-crossbow)
    (release-escrow food)
    (release-escrow gold)
    (research ri-crossbow)
    (set-goal bt-research-archery-range-claim-goal ri-crossbow)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-research-archery-range-claim-goal ri-crossbow)
    (up-research-status c: ri-crossbow == research-complete)
=>
    (set-goal bt-research-archery-range-claim-goal 0)
)

