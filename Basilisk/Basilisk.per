    (set-strategic-number sn-resource-control 0)
)

(defrule
    (not (town-under-attack))
    (goal bt-preempt-active-goal 1)
    (goal bt-preempt-original-owner-goal bt-tc2-claim)
    (goal bt-tc-project-goal 2)
    (strategic-number sn-resource-control == bt-preempt-emergency-claim)
    (or
        (goal bt-tc-stage-goal bt-tc-stage-idle)
        (or
            (not (goal strategy-goal bt-strategy-boom))
            (not (can-afford-building town-center-foundation))
        )
    )
=>
    (set-goal bt-tc-stage-goal bt-tc-stage-demanded)
    (set-goal bt-preempt-active-goal 0)
    (set-goal bt-preempt-result-goal bt-preempt-result-abort)
    (set-goal bt-preempt-defense-issued-goal 0)
    (set-goal bt-telemetry-event-type-goal 3)
