; 14E. DOUBLE-BIT AXE DEMAND
;================================================================
;
; DBA demand is an explicit early-Feudal wood-productivity investment.
; The predicate uses only existing world state plus fixed tuning buffers:
;   - Feudal age
;   - 450 food
;   - 100 wood
;   - Castle commitment is not already active
;   - technology is still available
;
; The demand signal does not own sn-resource-control. The existing
; research lifecycle below remains the only claim/action authority.
(defrule
    (goal bt-double-bit-axe-demand-goal 0)
    (current-age == feudal-age)
    (up-research-status c: ri-double-bit-axe == research-available)
    (food-amount >= bt-double-bit-axe-food-buffer)
    (wood-amount >= bt-double-bit-axe-wood-buffer)
=>
    (set-goal bt-double-bit-axe-demand-goal 1)
)

; Demand release is allowed to clear only when no DBA claim owns the
; shared resource register. An active DBA research attempt stays alive
; until completion or watchdog recovery.
(defrule
    (goal bt-double-bit-axe-demand-goal 1)
    (goal bt-research-lumber-camp-claim-goal 0)
    (or (current-age != feudal-age) (or (not (food-amount >= bt-double-bit-axe-food-buffer)) (or (not (wood-amount >= bt-double-bit-axe-wood-buffer)) (up-research-status c: ri-double-bit-axe >=
research-pending))))
=>
    (set-goal bt-double-bit-axe-demand-goal 0)
)

;================================================================
; 14E-B. DOUBLE-BIT AXE RESEARCH LIFECYCLE
;================================================================
;
; Existing claim -> escrow -> watchdog -> research -> completion
; control remains authoritative. Demand never performs the action.
(defrule
    (goal bt-double-bit-axe-demand-goal 1)
    (current-age == feudal-age)
    (not (goal bt-castle-commitment-goal 1))
    (up-compare-goal bt-research-lumber-camp-failure-backoff-goal != ri-double-bit-axe)
    (strategic-number sn-resource-control == 0)
    (building-type-count lumber-camp >= 1)
    (can-research-with-escrow ri-double-bit-axe)
    (goal bt-research-lumber-camp-claim-goal 0)
=>
    (set-strategic-number sn-resource-control ri-double-bit-axe)
    (release-escrow food)
    (release-escrow wood)
    (research ri-double-bit-axe)
    (set-goal bt-research-lumber-camp-claim-goal ri-double-bit-axe)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-research-lumber-camp-claim-goal ri-double-bit-axe)
    (up-research-status c: ri-double-bit-axe == research-complete)
=>
    (set-goal bt-research-lumber-camp-claim-goal 0)
    (set-goal bt-double-bit-axe-demand-goal 0)
)

;================================================================
; 14E. GOLD MINING DEMAND
;================================================================
;
; Gold Mining is downstream of SUSTAINED premium-gold demand.
;
; "Sustained" means an existing gold-paying consumer remains active:
;   - Cataphract demand
;   - existing Castle mixed-composition Camel demand
;
; It is NOT driven by:
;   - low gold stockpile
;   - Castle Age by itself
;   - an age-up gold bank
;   - the resource allocator inventing a new strategy
;
; Imperial-age preparation is explicitly excluded while the age is
; researchable. The existing age-up rule remains the only authority
; that spends the bank for the age transition.
;
; This is a technology-demand state. It creates no strategy, unit-goal,
; Cataphract demand, or resource claim.
;
; Initial value is established once in section 2 initialization.
; This section owns only demand/release transitions.
;
; Existing premium consumer -> Gold Mining demand.
(defrule
    (current-age >= castle-age)
    (or
        (goal bt-cataphract-demand-goal 1)
        (and (goal strategy-goal bt-strategy-flush) (and (goal unit-goal bt-unit-mix) (and (unit-type-count-total spearman-line >= bt-spear-target-1) (and (up-compare-goal bt-noncav-cavalry-level-goal >= 1) (and (building-type-count-total
stable >= 1) (unit-type-count-total camel-line < bt-camel-target-1))))))
    )
    (research-available ri-gold-mining)
    (not (can-research-with-escrow imperial-age))
    (strategic-number sn-resource-control != imperial-age)
=>
    (set-goal bt-gold-mining-demand-goal 1)
)

; When premium demand disappears, the technology-demand signal clears.
; An active Gold Mining claim keeps the demand alive until completion or
; watchdog recovery. The demand layer never cancels research.
(defrule
    (goal bt-gold-mining-demand-goal 1)
    (goal bt-research-mining-camp-claim-goal 0)
    (or (can-research-with-escrow imperial-age) (or (strategic-number sn-resource-control == imperial-age) (not
            (or
                (goal bt-cataphract-demand-goal 1)
                (and (current-age >= castle-age) (and (goal strategy-goal bt-strategy-flush) (and (goal unit-goal bt-unit-mix) (and (unit-type-count-total spearman-line >= bt-spear-target-1) (and (up-compare-goal
bt-noncav-cavalry-level-goal >= 1) (and (building-type-count-total stable >= 1) (unit-type-count-total camel-line < bt-camel-target-1)))))))
            )
        )))
=>
    (set-goal bt-gold-mining-demand-goal 0)
)

;================================================================
; 14F. GOLD MINING RESEARCH LIFECYCLE
;================================================================
;
; Existing sn-resource-control arbitration remains authoritative.
; can-research-with-escrow remains the final research feasibility gate.
(defrule
    (goal bt-gold-mining-demand-goal 1)
    (current-age >= feudal-age)
    (up-compare-goal bt-research-mining-camp-failure-backoff-goal != ri-gold-mining)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow feudal-age))
    (not (or
        (can-research-with-escrow castle-age)
        (goal bt-castle-commitment-goal 1)
    ))
    (not (can-research-with-escrow imperial-age))
    (building-type-count mining-camp >= 1)
    (can-research-with-escrow ri-gold-mining)
    (goal bt-research-mining-camp-claim-goal 0)
=>
    (set-strategic-number sn-resource-control ri-gold-mining)
    (release-escrow food)
    (release-escrow wood)
    (research ri-gold-mining)
    (set-goal bt-research-mining-camp-claim-goal ri-gold-mining)
    (set-strategic-number sn-resource-control 0)
)

; Completion witness releases only the Gold Mining claim.
(defrule
    (goal bt-research-mining-camp-claim-goal ri-gold-mining)
    (up-research-status c: ri-gold-mining == research-complete)
=>
    (set-goal bt-research-mining-camp-claim-goal 0)
    (set-goal bt-gold-mining-demand-goal 0)
)

;================================================================
; 14G. WHEELBARROW DEMAND / RESEARCH LIFECYCLE
;================================================================
;
; Wheelbarrow is a late-Feudal / early-Castle eco upgrade, not a
; three-TC-only luxury.  The Feudal path uses a 30-villager maturity
; witness but yields to an immediately executable Castle transition.
; The Castle path becomes valid at two TCs or 30 villagers.
(defrule
    (goal bt-wheelbarrow-demand-goal 0)
    (goal strategy-goal bt-strategy-boom)
    (up-research-status c: ri-wheel-barrow == research-available)
    (or
        (and
            (current-age == feudal-age)
            (and
                (unit-type-count villager >= bt-wheelbarrow-feudal-villagers)
                (and
                    (goal bt-castle-commitment-goal 0)
                    (not (can-research-with-escrow castle-age))
                )
            )
        )
        (and
            (current-age >= castle-age)
            (and
                (or
                    (building-type-count-total town-center >= 2)
                    (unit-type-count villager >= bt-wheelbarrow-castle-villagers)
                )
                (not (can-research-with-escrow imperial-age))
            )
        )
    )
=>
    (set-goal bt-wheelbarrow-demand-goal 1)
)

; Withdraw pending demand only when its maturity window or opportunity
; priority disappears. Active Wheelbarrow research remains claim-owned.
(defrule
    (goal bt-wheelbarrow-demand-goal 1)
    (goal bt-research-town-center-claim-goal 0)
    (or
        (can-research-with-escrow imperial-age)
        (or
            (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
            (not
                (and
                (up-research-status c: ri-wheel-barrow == research-available)
                (or
                    (and
                        (current-age == feudal-age)
                        (and
                            (unit-type-count villager >= bt-wheelbarrow-feudal-villagers)
                            (and
                                (goal bt-castle-commitment-goal 0)
                                (not (can-research-with-escrow castle-age))
                            )
                        )
                    )
                    (and
                        (current-age >= castle-age)
                        (and
                            (or
                                (building-type-count-total town-center >= 2)
                                (unit-type-count villager >= bt-wheelbarrow-castle-villagers)
                            )
                            (not (can-research-with-escrow imperial-age))
                        )
                    )
                )
            )
        )
    ))
=>
    (set-goal bt-wheelbarrow-demand-goal 0)
)

; Demand -> claim -> release Food + Wood escrow -> research.
(defrule
    (goal bt-wheelbarrow-demand-goal 1)
    (current-age >= feudal-age)
    (up-compare-goal bt-research-town-center-failure-backoff-goal != ri-wheel-barrow)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow feudal-age))
    (not (goal bt-castle-commitment-goal 1))
    (not (can-research-with-escrow imperial-age))
    (building-type-count town-center >= 1)
    (can-research-with-escrow ri-wheel-barrow)
    (goal bt-research-town-center-claim-goal 0)
=>
    (set-strategic-number sn-resource-control ri-wheel-barrow)
    (release-escrow food)
    (release-escrow wood)
    (research ri-wheel-barrow)
    (set-goal bt-research-town-center-claim-goal ri-wheel-barrow)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-research-town-center-claim-goal ri-wheel-barrow)
    (up-research-status c: ri-wheel-barrow == research-complete)
=>
    (set-goal bt-research-town-center-claim-goal 0)
    (set-goal bt-wheelbarrow-demand-goal 0)
)

;----------------------------------------------------------------
; WHEELBARROW WATCHDOG EXPIRY
(defrule
    (goal bt-research-town-center-claim-goal ri-wheel-barrow)
    (up-research-status c: ri-wheel-barrow <= research-available)
=>
    (set-goal bt-research-town-center-failure-backoff-goal ri-wheel-barrow)
    (enable-timer bt-research-town-center-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-town-center-claim-goal 0)
)

;================================================================
; 14G-A. IMPERIAL BANK-SAFE RESEARCH COST WITNESS
;================================================================
; UserPatch/DE cost-data support calculates the exact composite obligation
; from engine-defined technology costs. The delta is raw player resources
; minus that composite cost; it does not account for escrow semantics.
; The research action therefore retains can-research-with-escrow as its
; final execution feasibility witness.
;
; Bow Saw safe delta = resources - (Imperial Age + Bow Saw).
; Stone Mining safe delta = resources - (Imperial Age + Stone Mining).
; Response-tech deltas use the same obligation model for Scale Mail,
; Chain Mail, Pikeman, and Elite Skirmisher.
;
; Cost data is recalculated every pass. These delta goals are persistent
; derived witnesses consumed by the bank-prep exception rules below.
(defrule
    (true)
=>
    (up-setup-cost-data 1 bt-bow-saw-bank-cost-goal)
    (up-add-research-cost c: imperial-age c: 1)
    (up-add-research-cost c: ri-bow-saw c: 1)
    (up-get-cost-delta bt-bow-saw-bank-delta-food-goal)
)

(defrule
    (true)
=>
    (up-setup-cost-data 1 bt-stone-mining-bank-cost-goal)
    (up-add-research-cost c: imperial-age c: 1)
    (up-add-research-cost c: ri-stone-mining c: 1)
    (up-get-cost-delta bt-stone-mining-bank-delta-food-goal)
)

(defrule
    (true)
=>
    (up-setup-cost-data 1 bt-scale-mail-bank-cost-goal)
    (up-add-research-cost c: imperial-age c: 1)
    (up-add-research-cost c: ri-scale-mail c: 1)
    (up-get-cost-delta bt-scale-mail-bank-delta-food-goal)
)

(defrule
    (true)
=>
    (up-setup-cost-data 1 bt-chain-mail-bank-cost-goal)
    (up-add-research-cost c: imperial-age c: 1)
    (up-add-research-cost c: ri-chain-mail c: 1)
    (up-get-cost-delta bt-chain-mail-bank-delta-food-goal)
)

(defrule
    (true)
=>
    (up-setup-cost-data 1 bt-pikeman-bank-cost-goal)
    (up-add-research-cost c: imperial-age c: 1)
    (up-add-research-cost c: ri-pikeman c: 1)
    (up-get-cost-delta bt-pikeman-bank-delta-food-goal)
)

(defrule
    (true)
=>
    (up-setup-cost-data 1 bt-elite-skirmisher-bank-cost-goal)
    (up-add-research-cost c: imperial-age c: 1)
    (up-add-research-cost c: ri-elite-skirmisher c: 1)
    (up-get-cost-delta bt-elite-skirmisher-bank-delta-food-goal)
)

;================================================================
; 14H. HAND CART DEMAND / RESEARCH LIFECYCLE
;================================================================
;
; Hand Cart is a late-Castle economic investment. Wheelbarrow must be
; complete, and the controller must show a mature BOOM economy through
; either three Town Centers or 36 villagers. Do not spend the Castle economy's Food/Wood on Hand Cart
; while the existing Imperial-bank-prep state owns that priority.
;
; The existing Imperial feasibility veto also prevents an immediate
; Imperial-age bank from being cannibalized.
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-boom)
    (up-research-status c: ri-wheel-barrow >= research-complete)
    (or
        (building-type-count-total town-center >= 3)
        (unit-type-count villager >= bt-hand-cart-villagers)
    )
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (up-research-status c: ri-hand-cart == research-available)
=>
    (set-goal bt-hand-cart-demand-goal 1)
)

; Withdraw only a pending demand when its maturity or opportunity-cost
; witness disappears. An active Hand Cart claim owns the mutex until
; completion or watchdog recovery.
(defrule
    (goal bt-hand-cart-demand-goal 1)
    (goal bt-research-town-center-claim-goal 0)
    (or (can-research-with-escrow imperial-age) (or (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep) (not
            (and (current-age >= castle-age) (and (goal strategy-goal bt-strategy-boom) (and (up-research-status c: ri-wheel-barrow >= research-complete) (and (or
                    (building-type-count-total town-center >= 3)
                    (unit-type-count villager >= bt-hand-cart-villagers)
                ) (and (not (can-research-with-escrow imperial-age)) (and (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)) (up-research-status c: ri-hand-cart == research-available)))))))
        )))
=>
    (set-goal bt-hand-cart-demand-goal 0)
)

; Demand -> claim -> release Food + Wood escrow -> research.
(defrule
    (goal bt-hand-cart-demand-goal 1)
    (current-age >= castle-age)
    (up-compare-goal bt-research-town-center-failure-backoff-goal != ri-hand-cart)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (building-type-count town-center >= 1)
    (can-research-with-escrow ri-hand-cart)
    (goal bt-research-town-center-claim-goal 0)
=>
    (set-strategic-number sn-resource-control ri-hand-cart)
    (release-escrow food)
    (release-escrow wood)
    (research ri-hand-cart)
    (set-goal bt-research-town-center-claim-goal ri-hand-cart)
    (set-strategic-number sn-resource-control 0)
)

; research-complete is the terminal witness for the Hand Cart claim.
(defrule
    (goal bt-research-town-center-claim-goal ri-hand-cart)
    (up-research-status c: ri-hand-cart == research-complete)
=>
    (set-goal bt-research-town-center-claim-goal 0)
    (set-goal bt-hand-cart-demand-goal 0)
)

;----------------------------------------------------------------
; HAND CART WATCHDOG EXPIRY
(defrule
    (goal bt-research-town-center-claim-goal ri-hand-cart)
    (up-research-status c: ri-hand-cart <= research-available)
=>
    (set-goal bt-research-town-center-failure-backoff-goal ri-hand-cart)
    (enable-timer bt-research-town-center-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-town-center-claim-goal 0)
)

;================================================================
; 14I. BOW SAW DEMAND / RESEARCH LIFECYCLE
;================================================================
;
; Bow Saw is the first Castle BOOM wood-efficiency investment. The
; controller's existing two-Town-Center milestone is the maturity
; witness: it proves the economy has crossed from Castle transition
; into sustained expansion before spending Food + Wood on the upgrade.
;
; During Imperial-bank-prep, Bow Saw is allowed only when the exact
; composite obligation Imperial Age + Bow Saw remains fundable.
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-boom)
    (or
        (building-type-count-total town-center >= 2)
        (unit-type-count villager >= bt-bow-saw-villagers)
    )
    (not (can-research-with-escrow imperial-age))
    (or
        (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
        (and (up-compare-goal bt-bow-saw-bank-delta-food-goal >= 0) (and (up-compare-goal bt-bow-saw-bank-delta-wood-goal >= 0) (and (up-compare-goal bt-bow-saw-bank-delta-stone-goal >= 0) (up-compare-goal bt-bow-saw-bank-delta-gold-goal
>= 0))))
    )
    (up-research-status c: ri-bow-saw == research-available)
=>
    (set-goal bt-bow-saw-demand-goal 1)
)

; Withdraw only a pending Bow Saw demand when its maturity or resource
; priority disappears. An active claim owns sn-resource-control until
; completion or watchdog recovery.
(defrule
    (goal bt-bow-saw-demand-goal 1)
    (goal bt-research-lumber-camp-claim-goal 0)
    (can-research-with-escrow imperial-age)
=>
    (set-goal bt-bow-saw-demand-goal 0)
)
(defrule
    (goal bt-bow-saw-demand-goal 1)
    (goal bt-research-lumber-camp-claim-goal 0)
    (and
            (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
            (not
                (and (up-compare-goal bt-bow-saw-bank-delta-food-goal >= 0) (and (up-compare-goal bt-bow-saw-bank-delta-wood-goal >= 0) (and (up-compare-goal bt-bow-saw-bank-delta-stone-goal >= 0) (up-compare-goal
bt-bow-saw-bank-delta-gold-goal >= 0))))
            )
        )
=>
    (set-goal bt-bow-saw-demand-goal 0)
)
(defrule
    (goal bt-bow-saw-demand-goal 1)
    (goal bt-research-lumber-camp-claim-goal 0)
    (not
            (and (current-age >= castle-age) (and (goal strategy-goal bt-strategy-boom) (and (or (building-type-count-total town-center >= 2) (unit-type-count villager >= bt-bow-saw-villagers)) (and (not (can-research-with-escrow imperial-age)) (and (or
                    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
                    (and (up-compare-goal bt-bow-saw-bank-delta-food-goal >= 0) (and (up-compare-goal bt-bow-saw-bank-delta-wood-goal >= 0) (and (up-compare-goal bt-bow-saw-bank-delta-stone-goal >= 0) (up-compare-goal
bt-bow-saw-bank-delta-gold-goal >= 0))))
                ) (up-research-status c: ri-bow-saw == research-available))))))
        )
=>
    (set-goal bt-bow-saw-demand-goal 0)
)

; Demand -> claim -> release Food + Wood escrow -> research.
(defrule
    (goal bt-bow-saw-demand-goal 1)
    (current-age >= castle-age)
    (up-compare-goal bt-research-lumber-camp-failure-backoff-goal != ri-bow-saw)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow imperial-age))
    (or
        (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
        (and (up-compare-goal bt-bow-saw-bank-delta-food-goal >= 0) (and (up-compare-goal bt-bow-saw-bank-delta-wood-goal >= 0) (and (up-compare-goal bt-bow-saw-bank-delta-stone-goal >= 0) (up-compare-goal bt-bow-saw-bank-delta-gold-goal
>= 0))))
    )
    (building-type-count lumber-camp >= 1)
    (can-research-with-escrow ri-bow-saw)
    (goal bt-research-lumber-camp-claim-goal 0)
=>
    (set-strategic-number sn-resource-control ri-bow-saw)
    (release-escrow food)
    (release-escrow wood)
    (research ri-bow-saw)
    (set-goal bt-research-lumber-camp-claim-goal ri-bow-saw)
    (set-strategic-number sn-resource-control 0)
)

; research-complete is the terminal witness for the Bow Saw claim.
(defrule
    (goal bt-research-lumber-camp-claim-goal ri-bow-saw)
    (up-research-status c: ri-bow-saw == research-complete)
=>
    (set-goal bt-research-lumber-camp-claim-goal 0)
    (set-goal bt-bow-saw-demand-goal 0)
)

;----------------------------------------------------------------
; BOW SAW WATCHDOG EXPIRY
(defrule
    (goal bt-research-lumber-camp-claim-goal ri-bow-saw)
    (up-research-status c: ri-bow-saw <= research-available)
=>
    (set-goal bt-research-lumber-camp-failure-backoff-goal ri-bow-saw)
    (enable-timer bt-research-lumber-camp-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-lumber-camp-claim-goal 0)
)

;================================================================
; 14K. TWO-MAN SAW DEMAND / RESEARCH LIFECYCLE
;================================================================
;
; Two-Man Saw is the terminal Imperial wood-productivity investment.
; Imperial BOOM is the strategic owner, but the upgrade also waits for a
; mature villager economy and a real lumberjack base so the 300F/200W,
; 100-second investment has time to pay back.
(defrule
    (current-age >= imperial-age)
    (unit-type-count villager >= bt-two-man-saw-villagers)
    (unit-type-count villager-wood >= bt-two-man-saw-lumberjacks)
    (goal strategy-goal bt-strategy-boom)
    (not (goal bt-cataphract-demand-goal 1))
    (research-available ri-two-man-saw)
=>
    (set-goal bt-two-man-saw-demand-goal 1)
)

; Withdraw only a pending demand when Imperial power demand takes
; priority or the technology is no longer available. An active
; Two-Man Saw claim remains protected by sn-resource-control.
(defrule
    (goal bt-two-man-saw-demand-goal 1)
    (goal bt-research-lumber-camp-claim-goal 0)
    (or
        (goal bt-cataphract-demand-goal 1)
        (not
            (and (current-age >= imperial-age) (and (goal strategy-goal bt-strategy-boom) (and (not (goal bt-cataphract-demand-goal 1)) (research-available ri-two-man-saw))))
        )
    )
=>
    (set-goal bt-two-man-saw-demand-goal 0)
)

; Demand -> claim -> release Food + Wood escrow -> research.
(defrule
    (goal bt-two-man-saw-demand-goal 1)
    (current-age >= imperial-age)
    (unit-type-count villager >= bt-two-man-saw-villagers)
    (unit-type-count villager-wood >= bt-two-man-saw-lumberjacks)
    (goal strategy-goal bt-strategy-boom)
    (up-compare-goal bt-research-lumber-camp-failure-backoff-goal != ri-two-man-saw)
    (strategic-number sn-resource-control == 0)
    (not (goal bt-cataphract-demand-goal 1))
    (building-type-count lumber-camp >= 1)
    (can-research-with-escrow ri-two-man-saw)
    (goal bt-research-lumber-camp-claim-goal 0)
    (goal bt-research-cavalry-counter-package-goal 0)
    (goal bt-research-ranged-counter-package-goal 0)
    (goal bt-research-cataphract-package-goal 0)
    (goal bt-research-siege-package-goal 0)
    (goal bt-research-monk-package-goal 0)
=>
    (set-strategic-number sn-resource-control ri-two-man-saw)
    (release-escrow food)
    (release-escrow wood)
    (research ri-two-man-saw)
    (set-goal bt-research-lumber-camp-claim-goal ri-two-man-saw)
    (set-strategic-number sn-resource-control 0)
)

; research-complete is the terminal witness for the Two-Man Saw claim.
(defrule
    (goal bt-research-lumber-camp-claim-goal ri-two-man-saw)
    (up-research-status c: ri-two-man-saw == research-complete)
=>
    (set-goal bt-research-lumber-camp-claim-goal 0)
    (set-goal bt-two-man-saw-demand-goal 0)
)

;----------------------------------------------------------------
; TWO-MAN SAW WATCHDOG EXPIRY
(defrule
    (goal bt-research-lumber-camp-claim-goal ri-two-man-saw)
    (up-research-status c: ri-two-man-saw <= research-available)
=>
    (set-goal bt-research-lumber-camp-failure-backoff-goal ri-two-man-saw)
    (enable-timer bt-research-lumber-camp-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-lumber-camp-claim-goal 0)
)

;================================================================
; 14J. GOLD SHAFT MINING DEMAND / RESEARCH
;================================================================
;
; Gold Shaft Mining has a real strategic owner now.  The demand state is
; deliberately separate from the research claim so a failed engine action
; does not become a false strategic cancellation.
;
; Strategic witness:
;   Castle BOOM
;   + Gold Mining complete
;   + TC2 matured
;   + Imperial preparation is not currently taking precedence
;
; Demand persists through temporary resource contention and provider loss.
; The Mining Camp claim remains execution state; failure cooldown is local to
; this capability until the strategic demand disappears.
(defrule
    (goal bt-gold-shaft-mining-demand-goal 0)
    (current-age == castle-age)
    (goal strategy-goal bt-strategy-boom)
    (up-research-status c: ri-gold-mining >= research-complete)
    (building-type-count-total town-center >= 2)
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (up-research-status c: ri-gold-shaft-mining < research-complete)
=>
    (set-goal bt-gold-shaft-mining-demand-goal 1)
)

; Strategic invalidation only.  Do not cancel because the Mining Camp is
; temporarily absent or resources are temporarily insufficient.
(defrule
    (goal bt-gold-shaft-mining-demand-goal 1)
    (goal bt-research-mining-camp-claim-goal 0)
    (or
        (current-age > castle-age)
        (or
            (not (goal strategy-goal bt-strategy-boom))
            (or
                (up-research-status c: ri-gold-mining < research-complete)
                (or
                    (can-research-with-escrow imperial-age)
                    (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
                )
            )
        )
    )
=> 
    (set-goal bt-gold-shaft-mining-demand-goal 0)
)

; Execution is reliability-owned.  The strategic demand above is the only
; policy witness this provider consumes; feasibility/claim/package gates
; remain engine-execution constraints.
(defrule
    (goal bt-gold-shaft-mining-demand-goal 1)
    (up-compare-goal bt-research-mining-camp-failure-backoff-goal != ri-gold-shaft-mining)
    (strategic-number sn-resource-control == 0)
    (building-type-count mining-camp >= 1)
    (can-research-with-escrow ri-gold-shaft-mining)
    (goal bt-research-mining-camp-claim-goal 0)
=>
    (set-strategic-number sn-resource-control ri-gold-shaft-mining)
    (release-escrow food)
    (release-escrow wood)
    (research ri-gold-shaft-mining)
    (set-goal bt-research-mining-camp-claim-goal ri-gold-shaft-mining)
    (set-strategic-number sn-resource-control 0)
)

; research-complete is the terminal witness for the Gold Shaft Mining claim.
(defrule
    (goal bt-research-mining-camp-claim-goal ri-gold-shaft-mining)
    (up-research-status c: ri-gold-shaft-mining == research-complete)
=>
    (set-goal bt-research-mining-camp-claim-goal 0)
    (set-goal bt-gold-shaft-mining-demand-goal 0)
)

;----------------------------------------------------------------
; GOLD SHAFT MINING WATCHDOG EXPIRY
(defrule
    (goal bt-research-mining-camp-claim-goal ri-gold-shaft-mining)
    (up-research-status c: ri-gold-shaft-mining <= research-available)
=>
    (set-goal bt-research-mining-camp-failure-backoff-goal ri-gold-shaft-mining)
    (enable-timer bt-research-mining-camp-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-mining-camp-claim-goal 0)
)

;================================================================
; 14L. STONE MINING / STONE SHAFT MINING
;================================================================
;
; Stone technology is a project-economics investment, not a generic
; age-based economic upgrade.
;
; The existing resource-mode controller is the stone-project witness.
; During Imperial-bank-prep, the additional composite-cost witness prevents
; Stone Mining from consuming any part of the protected Imperial obligation.
;
; STONE MINING:
;   - Castle-stone modes are direct evidence of an active Castle project.
;   - Late TC expansion after a Castle is a secondary sustained-project
;     witness once the economy has reached the existing 50-villager mark.
;   - The current controller has no Feudal stone-allocation mode, so the
;     Feudal branch remains intentionally dormant until a real stone
;     project can feed it. Do not invent a predictive stone subsystem.
;
; STONE SHAFT MINING:
;   - Requires completed Stone Mining.
;   - Requires Castle BOOM.
;   - Requires the existing late TC3 stone-project witness:
;       TC >= 2, villagers >= 50, TC stone mode active.
;   - This is deliberately much stricter than Stone Mining.
;   - The current controller has no persistent multi-Castle demand signal,
;     so do not synthesize one merely to force the technology.
;
; Both lifecycles use the existing resource-control mutex, escrow release,
; research-complete witness, and research watchdog.
;
;----------------------------------------------------------------
; 14L-A. STONE MINING DEMAND
;----------------------------------------------------------------
(defrule
    (goal bt-stone-mining-demand-goal 0)
    (current-age >= feudal-age)
    (goal strategy-goal bt-strategy-boom)
    (not (town-under-attack))
    (research-available ri-stone-mining)
    (goal bt-resource-mode-goal bt-resource-mode-castle-stone-premium)
    (not (can-research-with-escrow feudal-age))
    (not (can-research-with-escrow castle-age))
    (not (goal bt-castle-commitment-goal 1))
    (not (can-research-with-escrow imperial-age))
    (or
        (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
        (and (up-compare-goal bt-stone-mining-bank-delta-food-goal >= 0) (and (up-compare-goal bt-stone-mining-bank-delta-wood-goal >= 0) (and (up-compare-goal bt-stone-mining-bank-delta-stone-goal >= 0) (up-compare-goal
bt-stone-mining-bank-delta-gold-goal >= 0))))
    )
    (strategic-number sn-resource-control != imperial-age)
=>
    (set-goal bt-stone-mining-demand-goal 1)
)
(defrule
    (goal bt-stone-mining-demand-goal 0)
    (current-age >= feudal-age)
    (goal strategy-goal bt-strategy-boom)
    (not (town-under-attack))
    (research-available ri-stone-mining)
    (goal bt-resource-mode-goal bt-resource-mode-tc-stone-premium)
    (building-type-count-total castle >= 1)
    (unit-type-count villager >= bt-imperial-villagers)
    (not (can-research-with-escrow feudal-age))
    (not (can-research-with-escrow castle-age))
    (not (goal bt-castle-commitment-goal 1))
    (not (can-research-with-escrow imperial-age))
    (or
        (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
        (and (up-compare-goal bt-stone-mining-bank-delta-food-goal >= 0) (and (up-compare-goal bt-stone-mining-bank-delta-wood-goal >= 0) (and (up-compare-goal bt-stone-mining-bank-delta-stone-goal >= 0) (up-compare-goal
bt-stone-mining-bank-delta-gold-goal >= 0))))
    )
    (strategic-number sn-resource-control != imperial-age)
=>
    (set-goal bt-stone-mining-demand-goal 1)
)
(defrule
    (goal bt-stone-mining-demand-goal 0)
    (current-age >= feudal-age)
    (goal strategy-goal bt-strategy-boom)
    (not (town-under-attack))
    (research-available ri-stone-mining)
    (goal bt-resource-mode-goal bt-resource-mode-tc-stone)
    (building-type-count-total castle >= 1)
    (unit-type-count villager >= bt-imperial-villagers)
    (not (can-research-with-escrow feudal-age))
    (not (can-research-with-escrow castle-age))
    (not (goal bt-castle-commitment-goal 1))
    (not (can-research-with-escrow imperial-age))
    (or
        (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
        (and (up-compare-goal bt-stone-mining-bank-delta-food-goal >= 0) (and (up-compare-goal bt-stone-mining-bank-delta-wood-goal >= 0) (and (up-compare-goal bt-stone-mining-bank-delta-stone-goal >= 0) (up-compare-goal
bt-stone-mining-bank-delta-gold-goal >= 0))))
    )
    (strategic-number sn-resource-control != imperial-age)
=>
    (set-goal bt-stone-mining-demand-goal 1)
)

; Withdraw pending demand when the project or its economic priority
; disappears. An active claim remains protected by sn-resource-control.
(defrule
    (goal bt-stone-mining-demand-goal 1)
    (goal bt-research-mining-camp-claim-goal 0)
    (can-research-with-escrow feudal-age)
=>
    (set-goal bt-stone-mining-demand-goal 0)
)
(defrule
    (goal bt-stone-mining-demand-goal 1)
    (goal bt-research-mining-camp-claim-goal 0)
    (can-research-with-escrow castle-age)
=>
    (set-goal bt-stone-mining-demand-goal 0)
)
(defrule
    (goal bt-stone-mining-demand-goal 1)
    (goal bt-research-mining-camp-claim-goal 0)
    (can-research-with-escrow imperial-age)
=>
    (set-goal bt-stone-mining-demand-goal 0)
)
(defrule
    (goal bt-stone-mining-demand-goal 1)
    (goal bt-research-mining-camp-claim-goal 0)
    (strategic-number sn-resource-control == imperial-age)
=>
    (set-goal bt-stone-mining-demand-goal 0)
)
(defrule
    (goal bt-stone-mining-demand-goal 1)
    (goal bt-research-mining-camp-claim-goal 0)
    (and
            (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
            (not
                (and (up-compare-goal bt-stone-mining-bank-delta-food-goal >= 0) (and (up-compare-goal bt-stone-mining-bank-delta-wood-goal >= 0) (and (up-compare-goal bt-stone-mining-bank-delta-stone-goal >= 0) (up-compare-goal
bt-stone-mining-bank-delta-gold-goal >= 0))))
            )
        )
=>
    (set-goal bt-stone-mining-demand-goal 0)
)
(defrule
    (goal bt-stone-mining-demand-goal 1)
    (goal bt-research-mining-camp-claim-goal 0)
    (or (not (goal strategy-goal bt-strategy-boom)) (or (town-under-attack) (or (not (research-available ri-stone-mining)) (not
            (or (goal bt-resource-mode-goal bt-resource-mode-castle-stone-premium) (or (and (goal bt-resource-mode-goal bt-resource-mode-tc-stone-premium) (and (building-type-count-total castle >= 1) (unit-type-count villager >=
bt-imperial-villagers))) (and (goal bt-resource-mode-goal bt-resource-mode-tc-stone) (and (building-type-count-total castle >= 1) (unit-type-count villager >= bt-imperial-villagers)))))
        ))))
=>
    (set-goal bt-stone-mining-demand-goal 0)
)

;----------------------------------------------------------------
; 14L-B. STONE MINING RESEARCH
;----------------------------------------------------------------
(defrule
    (goal bt-stone-mining-demand-goal 1)
    (current-age >= feudal-age)
    (up-compare-goal bt-research-mining-camp-failure-backoff-goal != ri-stone-mining)
    (strategic-number sn-resource-control == 0)
    (not (or
        (can-research-with-escrow castle-age)
        (goal bt-castle-commitment-goal 1)
    ))
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (building-type-count mining-camp >= 1)
    (can-research-with-escrow ri-stone-mining)
    (goal bt-research-mining-camp-claim-goal 0)
    (goal bt-research-cavalry-counter-package-goal 0)
    (goal bt-research-ranged-counter-package-goal 0)
    (goal bt-research-cataphract-package-goal 0)
    (goal bt-research-siege-package-goal 0)
    (goal bt-research-monk-package-goal 0)
=>
    (set-strategic-number sn-resource-control ri-stone-mining)
    (release-escrow food)
    (release-escrow wood)
    (research ri-stone-mining)
    (set-goal bt-research-mining-camp-claim-goal ri-stone-mining)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-stone-mining-demand-goal 1)
    (current-age >= feudal-age)
    (up-compare-goal bt-research-mining-camp-failure-backoff-goal != ri-stone-mining)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow castle-age))
    (not (goal bt-castle-commitment-goal 1))
    (not (can-research-with-escrow imperial-age))
    (up-compare-goal bt-stone-mining-bank-delta-food-goal >= 0)
    (up-compare-goal bt-stone-mining-bank-delta-wood-goal >= 0)
    (up-compare-goal bt-stone-mining-bank-delta-stone-goal >= 0)
    (up-compare-goal bt-stone-mining-bank-delta-gold-goal >= 0)
    (building-type-count mining-camp >= 1)
    (can-research-with-escrow ri-stone-mining)
    (goal bt-research-mining-camp-claim-goal 0)
    (goal bt-research-cavalry-counter-package-goal 0)
    (goal bt-research-ranged-counter-package-goal 0)
    (goal bt-research-cataphract-package-goal 0)
    (goal bt-research-siege-package-goal 0)
    (goal bt-research-monk-package-goal 0)
=>
    (set-strategic-number sn-resource-control ri-stone-mining)
    (release-escrow food)
    (release-escrow wood)
    (research ri-stone-mining)
    (set-goal bt-research-mining-camp-claim-goal ri-stone-mining)
    (set-strategic-number sn-resource-control 0)
)

; research-complete is the terminal world-state witness.
(defrule
    (goal bt-research-mining-camp-claim-goal ri-stone-mining)
    (up-research-status c: ri-stone-mining == research-complete)
=>
    (set-goal bt-research-mining-camp-claim-goal 0)
    (set-goal bt-stone-mining-demand-goal 0)
)

; 14L-C. STONE SHAFT MINING DEMAND
;----------------------------------------------------------------
;
; Shaft Mining is deliberately gated behind a much larger Castle
; economy. The existing TC3 stone mode is the only persistent late-Castle
; stone-project witness available without introducing another state store.
(defrule
    (goal bt-stone-shaft-mining-demand-goal 0)
    (current-age == castle-age)
    (goal strategy-goal bt-strategy-boom)
    (not (town-under-attack))
    (up-research-status c: ri-stone-mining == research-complete)
    (research-available ri-stone-shaft-mining)
    (not
        (and (building-type-count-total castle >= 2) (and (unit-type-count villager >= bt-stone-shaft-villagers) (stone-amount >= 650)))
    )
    (and (goal bt-resource-mode-goal bt-resource-mode-tc-stone) (and (building-type-count-total town-center >= 2) (and (unit-type-count villager >= bt-stone-shaft-villagers) (and (food-amount >= bt-stone-shaft-food-buffer) (wood-amount
>= bt-stone-shaft-wood-buffer)))))
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (strategic-number sn-resource-control != imperial-age)
=>
    (set-goal bt-stone-shaft-mining-demand-goal 1)
)
(defrule
    (goal bt-stone-shaft-mining-demand-goal 0)
    (current-age == castle-age)
    (goal strategy-goal bt-strategy-boom)
    (not (town-under-attack))
    (up-research-status c: ri-stone-mining == research-complete)
    (research-available ri-stone-shaft-mining)
    (not
        (and (building-type-count-total castle >= 2) (and (unit-type-count villager >= bt-stone-shaft-villagers) (stone-amount >= 650)))
    )
    (and (building-type-count-total castle >= 2) (and (unit-type-count villager >= bt-stone-shaft-villagers) (and (food-amount >= bt-stone-shaft-food-buffer) (and (wood-amount >= bt-stone-shaft-wood-buffer) (stone-amount < 650)))))
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (strategic-number sn-resource-control != imperial-age)
=>
    (set-goal bt-stone-shaft-mining-demand-goal 1)
)

; Withdraw pending Shaft demand when an immediate late-Castle
; prerequisite or safety condition disappears. Active Shaft research
; remains protected by sn-resource-control.
(defrule
    (goal bt-stone-shaft-mining-demand-goal 1)
    (goal bt-research-mining-camp-claim-goal 0)
    (or (current-age != castle-age) (or (can-research-with-escrow imperial-age) (or (strategic-number sn-resource-control == imperial-age) (or (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep) (or (town-under-attack) (or
(not (goal strategy-goal bt-strategy-boom)) (or (not (up-research-status c: ri-stone-mining == research-complete)) (not (research-available ri-stone-shaft-mining)))))))))
=>
    (set-goal bt-stone-shaft-mining-demand-goal 0)
)

; Withdraw pending Shaft demand when neither accepted Castle/TC stone
; maturity path remains valid.
(defrule
    (goal bt-stone-shaft-mining-demand-goal 1)
    (goal bt-research-mining-camp-claim-goal 0)
    (not
            (and
                        (unit-type-count villager >= bt-stone-shaft-villagers)
                        (and
                                        (food-amount >= bt-stone-shaft-food-buffer)
                                        (and
                                                            (wood-amount >= bt-stone-shaft-wood-buffer)
                                                            (and
                                                                                    (not
                                                                                                                (can-research-with-escrow imperial-age)
                                                                                                            )
                                                                                    (not
                                                                                                                (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
                                                                                                            )
                                                                                )
                                                        )
                                    )
                    )
        )
=>
    (set-goal bt-stone-shaft-mining-demand-goal 0)
)
(defrule
    (goal bt-stone-shaft-mining-demand-goal 1)
    (goal bt-research-mining-camp-claim-goal 0)
    (and
            (not
                        (and
                                        (current-age == castle-age)
                                        (and
                                                            (goal strategy-goal bt-strategy-boom)
                                                            (and
                                                                                    (not
                                                                                                                (town-under-attack)
                                                                                                            )
                                                                                    (and
                                                                                                                (up-research-status c: ri-stone-mining == research-complete)
                                                                                                                (and
                                                                                                                                                (research-available ri-stone-shaft-mining)
                                                                                                                                                (and
                                                                                                                                                                                    (goal bt-resource-mode-goal bt-resource-mode-tc-stone)
                                                                                                                                                                                    (building-type-count-total town-center >= 2)
                                                                                                                                                                                )
                                                                                                                                            )
                                                                                                            )
                                                                                )
                                                        )
                                    )
                    )
            (not
                        (and
                                        (building-type-count-total castle >= 2)
                                        (stone-amount < 650)
                                    )
                    )
        )
=>
    (set-goal bt-stone-shaft-mining-demand-goal 0)
)

;----------------------------------------------------------------
; 14L-D. STONE SHAFT MINING RESEARCH
;----------------------------------------------------------------
(defrule
    (goal bt-stone-shaft-mining-demand-goal 1)
    (current-age == castle-age)
    (goal strategy-goal bt-strategy-boom)
    (up-research-status c: ri-stone-mining == research-complete)
    (up-compare-goal bt-research-mining-camp-failure-backoff-goal != ri-stone-shaft-mining)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (building-type-count mining-camp >= 1)
    (can-research-with-escrow ri-stone-shaft-mining)
    (goal bt-research-mining-camp-claim-goal 0)
    (goal bt-research-cavalry-counter-package-goal 0)
    (goal bt-research-ranged-counter-package-goal 0)
    (goal bt-research-cataphract-package-goal 0)
    (goal bt-research-siege-package-goal 0)
    (goal bt-research-monk-package-goal 0)
=>
    (set-strategic-number sn-resource-control ri-stone-shaft-mining)
    (release-escrow food)
    (release-escrow wood)
    (research ri-stone-shaft-mining)
    (set-goal bt-research-mining-camp-claim-goal ri-stone-shaft-mining)
    (set-strategic-number sn-resource-control 0)
)

; research-complete is the terminal witness for Stone Shaft Mining.
(defrule
    (goal bt-research-mining-camp-claim-goal ri-stone-shaft-mining)
    (up-research-status c: ri-stone-shaft-mining == research-complete)
=>
    (set-goal bt-research-mining-camp-claim-goal 0)
    (set-goal bt-stone-shaft-mining-demand-goal 0)
)

;================================================================

; Economic research demand resets only after the strategic demand disappears
; and no provider claim remains active.

; 15. PRODUCTION CAPACITY
;================================================================
;================================================================
; 15. PRODUCTION CAPACITY
;================================================================
;
; Q: "How do strategy and unit-goal change actual production?"
;
; They become prerequisites for production-building rules.
;
; IMPORTANT:
;   sn-resource-control must be 0.
;
; If an age/research claim owns the bank, military production waits.
; This is the conservative resource arbitration rule.
;---------------------------------------------------------------
; 15A. BARRACK CAPACITY
;---------------------------------------------------------------
; Standing-army demand supplies the persistent late-game capacity
; signal.  It does not replace threat-driven FLUSH capacity.
(defrule
    (goal bt-standing-army-demand-goal 1)
    (current-age == feudal-age)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal bt-standing-army-demand-goal 1)
    (goal strategy-goal bt-strategy-flush)
    (current-age == feudal-age)
    (up-compare-goal bt-standing-army-floor-goal >= bt-flush-army-floor-feudal)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 2)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal bt-standing-army-demand-goal 1)
    (current-age == castle-age)
    (up-compare-goal bt-standing-army-floor-goal >= 16)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 2)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal bt-standing-army-demand-goal 1)
    (current-age == castle-age)
    (up-compare-goal bt-standing-army-floor-goal >= 20)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 3)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal bt-standing-army-demand-goal 1)
    (current-age >= imperial-age)
    (up-compare-goal bt-standing-army-floor-goal >= 26)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 4)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal bt-standing-army-demand-goal 1)
    (current-age >= imperial-age)
    (up-compare-goal bt-standing-army-floor-goal >= 34)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 6)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal bt-standing-army-demand-goal 1)
    (current-age >= imperial-age)
    (up-compare-goal bt-standing-army-floor-goal >= 42)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 8)
    (can-build barracks)
=>
    (build barracks)
)






;---------------------------------------------------------------
; 15A.1 ROLE-TARGET BARRACK CAPACITY
; Barracks capacity is owned by standing role targets. Cavalry threat does not
; get a second, parallel capacity scalar.
;---------------------------------------------------------------
(defrule
    (goal bt-standing-army-demand-goal 1)
    (up-compare-goal bt-standing-spear-target-goal > 0)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)
(defrule
    (goal bt-standing-army-demand-goal 1)
    (up-compare-goal bt-standing-spear-target-goal >= 7)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 2)
    (can-build barracks)
=>
    (build barracks)
)
(defrule
    (goal bt-standing-army-demand-goal 1)
    (up-compare-goal bt-standing-spear-target-goal >= 13)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 3)
    (can-build barracks)
=>
    (build barracks)
)
(defrule
    (goal bt-standing-army-demand-goal 1)
    (up-compare-goal bt-standing-spear-target-goal >= 21)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 4)
    (can-build barracks)
=>
    (build barracks)
)

;---------------------------------------------------------------
; 15B. ARCHERY-RANGE CAPACITY
; Standing roles require active standing demand. RUSH Archer is the
; explicit non-standing consumer of this shared Range capability.
;---------------------------------------------------------------
(defrule
    (or
        (goal bt-standing-army-demand-goal 1)
        (and
            (goal strategy-goal bt-strategy-rush)
            (goal unit-goal archer-line)
        )
    )
    (or (up-compare-goal bt-standing-skirm-target-goal > 0) (or (up-compare-goal bt-standing-archer-target-goal > 0) (up-compare-goal bt-standing-crossbow-target-goal > 0)))
    (strategic-number sn-resource-control == 0)
    (building-type-count-total archery-range < 1)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (or
        (goal bt-standing-army-demand-goal 1)
        (and
            (goal strategy-goal bt-strategy-rush)
            (goal unit-goal archer-line)
        )
    )
    (or (up-compare-goal bt-standing-skirm-target-goal >= 7) (or (up-compare-goal bt-standing-archer-target-goal >= 7) (up-compare-goal bt-standing-crossbow-target-goal >= 8)))
    (strategic-number sn-resource-control == 0)
    (building-type-count-total archery-range < 2)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (or
        (goal bt-standing-army-demand-goal 1)
        (and
            (goal strategy-goal bt-strategy-rush)
            (goal unit-goal archer-line)
        )
    )
    (or (up-compare-goal bt-standing-skirm-target-goal >= 13) (or (up-compare-goal bt-standing-archer-target-goal >= 13) (up-compare-goal bt-standing-crossbow-target-goal >= 12)))
    (strategic-number sn-resource-control == 0)
    (building-type-count-total archery-range < 3)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (or
        (goal bt-standing-army-demand-goal 1)
        (and
            (goal strategy-goal bt-strategy-rush)
            (goal unit-goal archer-line)
        )
    )
    (or
        (up-compare-goal bt-standing-skirm-target-goal >= 21)
        (up-compare-goal bt-standing-archer-target-goal >= 21)
    )
    (strategic-number sn-resource-control == 0)
    (building-type-count-total archery-range < 4)
    (can-build archery-range)
=>
    (build archery-range)
)

;---------------------------------------------------------------
; 15C. FEUDAL STABLE CAPABILITY FOR SCOUT PRESSURE
;---------------------------------------------------------------
; The Scout demand owns this one direct capability edge.  It does not
; alter the Castle stable-capacity rules below.
(defrule
    (goal bt-scout-pressure-demand-goal 1)
    (current-age == feudal-age)
    (goal strategy-goal bt-strategy-boom)
    (goal bt-any-threat-goal 0)
    (strategic-number sn-resource-control == 0)
    (not (or
        (can-research-with-escrow castle-age)
        (goal bt-castle-commitment-goal 1)
    ))
    (building-type-count-total stable < 1)
    (wood-amount >= bt-scout-stable-wood)
    (can-build stable)
=>
    (build stable)
)

;---------------------------------------------------------------
; 15D. STABLE CAPACITY
;---------------------------------------------------------------
; Camel capability edge:
;
;   bt-standing-camel-target-goal > 0
;       -> one Stable capability
;       -> existing Camel train authority in section 16H
;
; The Camel target is the sole Camel demand authority. These rules
; provide production capability only; they do not create a second
; Camel demand state.
(defrule
    (current-age >= castle-age)
    (or
        (up-compare-goal bt-standing-camel-target-goal > 0)
        (up-compare-goal bt-standing-knight-target-goal > 0)
    )
    (strategic-number sn-resource-control == 0)
    (building-type-count-total stable < 1)
    (can-build stable)
=>
    (build stable)
)
(defrule
    (current-age >= castle-age)
    (or
        (up-compare-goal bt-standing-camel-target-goal >= 5)
        (up-compare-goal bt-standing-knight-target-goal >= 8)
    )
    (strategic-number sn-resource-control == 0)
    (building-type-count-total stable < 2)
    (can-build stable)
=>
    (build stable)
)

(defrule
    (current-age >= castle-age)
    (up-compare-goal bt-standing-knight-target-goal >= 12)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total stable < 3)
    (can-build stable)
=>
    (build stable)
)

; Manual diagnostic reset for the age-prerequisite state.
; Trigger this through the scenario editor's AI Script Goal effect
; using trigger ID 60.  The event stays pending while another
; subsystem owns sn-resource-control, then is acknowledged only after
; the reset can safely release the mutex.
(defrule
    (event-detected trigger bt-castle-prereq-manual-reset-trigger)
    (or
        (up-compare-goal bt-castle-prereq-failure-history-goal != 0)
        (or
            (up-compare-goal bt-imperial-prereq-failure-history-goal != 0)
            (up-compare-goal bt-blacksmith-repair-failure-history-goal != 0)
        )
    )
    (strategic-number sn-resource-control == 0)
=>
    (acknowledge-event trigger bt-castle-prereq-manual-reset-trigger)
    (disable-timer bt-castle-prereq-watchdog-timer)
    (disable-timer bt-castle-prereq-backoff-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-castle-prereq-failure-history-goal 0)
    (set-goal bt-castle-prereq-backoff-goal 0)
    (set-goal bt-imperial-prereq-failure-history-goal 0)
    (set-goal bt-imperial-prereq-backoff-goal 0)
    (set-goal bt-blacksmith-repair-failure-history-goal 0)
    (set-goal bt-blacksmith-repair-backoff-goal 0)
    (disable-timer bt-blacksmith-repair-watchdog-timer)
    (disable-timer bt-blacksmith-repair-backoff-timer)
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (disable-timer bt-imperial-prereq-backoff-timer)
)

;---------------------------------------------------------------
; 15E. CASTLE PREREQUISITE: BLACKSMITH
;---------------------------------------------------------------
; Failed Castle-age feasibility is the demand witness.
; The shared resource mutex prevents collision with age/research,
; TC, and other capital-consuming systems.
(defrule
    (current-age == feudal-age)
    (goal bt-castle-prereq-failure-history-goal 0)
    (goal bt-castle-prereq-backoff-goal 0)
    (not (can-research-with-escrow castle-age))
    (building-type-count-total blacksmith < 1)
    (up-pending-objects c: blacksmith == 0)
    (strategic-number sn-resource-control == 0)
    (can-build-with-escrow blacksmith)
=>
    (set-strategic-number sn-resource-control bt-castle-blacksmith-claim)
    (release-escrow wood)
    (enable-timer bt-castle-prereq-watchdog-timer bt-castle-prereq-watchdog-seconds)
    (build blacksmith)
)

;---------------------------------------------------------------
; CASTLE/IMPERIAL BLACKSMITH CAPABILITY RECOVERY
;---------------------------------------------------------------
; The normal Blacksmith is a Feudal -> Castle prerequisite. After Castle Age,
; losing that building creates a different lifecycle: all downstream
; Blacksmith technologies and Siege Workshop capability become permanently
; unreachable unless the capability is rebuilt. This repair lifecycle is
; isolated from the Castle-age prerequisite failure state so a failed Feudal
; construction cannot poison post-Castle recovery, and a post-Castle timeout
; cannot reset itself forever.
(defrule
    (current-age >= castle-age)
    (not (town-under-attack))
    (goal bt-blacksmith-repair-failure-history-goal 0)
    (goal bt-blacksmith-repair-backoff-goal 0)
    (building-type-count-total blacksmith < 1)
    (up-pending-objects c: blacksmith == 0)
    (strategic-number sn-resource-control == 0)
    (can-build-with-escrow blacksmith)
=>
    (set-strategic-number sn-resource-control bt-blacksmith-repair-claim)
    (release-escrow wood)
    (enable-timer bt-blacksmith-repair-watchdog-timer bt-blacksmith-repair-watchdog-seconds)
    (build blacksmith)
)

(defrule
    (strategic-number sn-resource-control == bt-blacksmith-repair-claim)
    (building-type-count blacksmith >= 1)
=>
    (disable-timer bt-blacksmith-repair-watchdog-timer)
    (set-goal bt-blacksmith-repair-backoff-goal 0)
    (set-goal bt-blacksmith-repair-failure-history-goal 0)
    (set-strategic-number sn-resource-control 0)
)

; Construction failure is temporary execution state. The flat cooldown reopens the normal feasibility path.

; Repair backoff is an isolated cooldown; it never claims the mutex.
(defrule
    (building-type-count blacksmith >= 1)
    (goal bt-blacksmith-repair-failure-history-goal 1)
=>
    (disable-timer bt-blacksmith-repair-watchdog-timer)
    (disable-timer bt-blacksmith-repair-backoff-timer)
    (set-goal bt-blacksmith-repair-failure-history-goal 0)
    (set-goal bt-blacksmith-repair-backoff-goal 0)
)

;----------------------------------------------------------------
; BLACKSMITH REPAIR CONSTRUCTION WATCHDOG
(defrule
    (strategic-number sn-resource-control == bt-blacksmith-repair-claim)
    (timer-triggered bt-blacksmith-repair-watchdog-timer)
    (up-pending-objects c: blacksmith > 0)
=>
    (disable-timer bt-blacksmith-repair-watchdog-timer)
    (up-assign-builders c: blacksmith c: bt-foundation-stall-builder-count)
    (enable-timer bt-blacksmith-repair-watchdog-timer bt-blacksmith-repair-watchdog-seconds)
)
(defrule
    (strategic-number sn-resource-control == bt-blacksmith-repair-claim)
    (timer-triggered bt-blacksmith-repair-watchdog-timer)
    (up-pending-objects c: blacksmith == 0)
=>
    (disable-timer bt-blacksmith-repair-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-blacksmith-repair-failure-history-goal 1)
    (set-goal bt-blacksmith-repair-backoff-goal 1)
    (enable-timer bt-blacksmith-repair-backoff-timer bt-blacksmith-repair-backoff-seconds)
)
(defrule
    (goal bt-blacksmith-repair-backoff-goal 1)
    (timer-triggered bt-blacksmith-repair-backoff-timer)
=>
    (disable-timer bt-blacksmith-repair-backoff-timer)
    (set-goal bt-blacksmith-repair-failure-history-goal 0)
    (set-goal bt-blacksmith-repair-backoff-goal 0)
)

; Blacksmith completion is the world-state witness.
(defrule
    (strategic-number sn-resource-control == bt-castle-blacksmith-claim)
    (building-type-count blacksmith >= 1)
=>
    (disable-timer bt-castle-prereq-watchdog-timer)
    (disable-timer bt-castle-prereq-backoff-timer)
    (set-goal bt-castle-prereq-backoff-goal 0)
    (set-strategic-number sn-resource-control 0)
)

;---------------------------------------------------------------
; 15F. CASTLE PREREQUISITE: MARKET
;---------------------------------------------------------------
; Market is downstream of Blacksmith completion.  If Castle becomes
; researchable through Blacksmith + another qualifying Feudal building,
; no redundant Market is forced.
(defrule
    (current-age == feudal-age)
    (goal bt-castle-prereq-failure-history-goal 0)
    (goal bt-castle-prereq-backoff-goal 0)
    (building-type-count blacksmith >= 1)
    (not (can-research-with-escrow castle-age))
    (building-type-count-total market < 1)
    (up-pending-objects c: market == 0)
    (strategic-number sn-resource-control == 0)
    (can-build-with-escrow market)
=>
    (set-strategic-number sn-resource-control bt-castle-market-claim)
    (enable-timer bt-castle-prereq-watchdog-timer bt-castle-prereq-watchdog-seconds)
    (release-escrow wood)
    (build market)
)

; Market completion is the world-state witness.
(defrule
    (strategic-number sn-resource-control == bt-castle-market-claim)
    (building-type-count market >= 1)
=>
    (disable-timer bt-castle-prereq-watchdog-timer)
    (disable-timer bt-castle-prereq-backoff-timer)
    (set-goal bt-castle-prereq-backoff-goal 0)
    (set-strategic-number sn-resource-control 0)
)

;---------------------------------------------------------------
; 15G. CASTLE CAPABILITY FOR CATAPHRACTS
;---------------------------------------------------------------

(defrule
    ; Package-owned Castle placement. Field control and stone are prerequisites,
    ; and place-control remains the engine-native placement executor.
    (goal bt-castle-cataphract-demand-goal 1)
    (goal bt-imperial-siege-package-goal 1)
    (goal bt-castle-cataphract-failure-history-goal 0)
    (goal bt-castle-cataphract-backoff-goal 0)
    (current-age >= imperial-age)
    (building-type-count-total castle < 1)
    (up-pending-objects c: castle == 0)
    (strategic-number sn-resource-control == 0)
    (building-available castle)
    (can-build-with-escrow castle)
    (player-in-game target-player)
    (players-building-count target-player > 0)
    (stone-amount >= bt-forward-castle-stone-floor)
    (up-compare-goal bt-relative-force-goal >= bt-forward-castle-force-floor)
    (up-compare-goal bt-attack-reserve-goal >= bt-forward-castle-reserve-floor)
=>
    (set-strategic-number sn-resource-control bt-castle-cataphract-claim)
    (release-escrow stone)
    (set-strategic-number sn-placement-to-center 0)
    (set-strategic-number sn-placement-zone-size 5)
    (set-strategic-number sn-placement-fail-delta 0)
    (up-set-placement-data target-player -1 c: -6)
    (up-assign-builders c: castle c: 4)
    (enable-timer bt-castle-cataphract-watchdog-timer bt-castle-cataphract-watchdog-seconds)
    (up-build place-control 0 c: castle)
    (set-strategic-number sn-placement-to-center 1)
)


(defrule
    ; Original pre-Imperial Cataphract Castle executor.
    (goal bt-castle-cataphract-demand-goal 1)
    (goal bt-imperial-siege-package-goal 0)
    (goal bt-castle-cataphract-failure-history-goal 0)
    (goal bt-castle-cataphract-backoff-goal 0)
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (up-pending-objects c: castle == 0)
    (strategic-number sn-resource-control == 0)
    (building-available castle)
    (can-build-with-escrow castle)
=>
    (set-strategic-number sn-resource-control bt-castle-cataphract-claim)
    (release-escrow stone)
    (enable-timer bt-castle-cataphract-watchdog-timer bt-castle-cataphract-watchdog-seconds)
    (build castle)
)

; Completed Castle is the actual capability witness.
(defrule
    (strategic-number sn-resource-control == bt-castle-cataphract-claim)
    (building-type-count castle >= 1)
=>
    (disable-timer bt-castle-cataphract-watchdog-timer)
    (disable-timer bt-castle-cataphract-backoff-timer)
    (set-goal bt-castle-cataphract-demand-goal 0)
    (set-goal bt-castle-mature-commitment-goal 0)
    (set-goal bt-castle-cataphract-failure-history-goal 0)
    (set-goal bt-castle-cataphract-backoff-goal 0)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (building-type-count castle >= 1)
    (goal bt-castle-cataphract-demand-goal 1)
    (strategic-number sn-resource-control != bt-castle-cataphract-claim)
=>
    (disable-timer bt-castle-cataphract-backoff-timer)
    (set-goal bt-castle-cataphract-demand-goal 0)
    (set-goal bt-castle-mature-commitment-goal 0)
    (set-goal bt-castle-cataphract-failure-history-goal 0)
    (set-goal bt-castle-cataphract-backoff-goal 0)
)

;----------------------------------------------------------------
; CASTLE CATAPHRACT CONSTRUCTION WATCHDOG
; A live Castle foundation is an owned construction obligation. The
; watchdog restores builder support while it exists. If it disappears
; without completing, one flat capability-local cooldown is armed.
(defrule
    (strategic-number sn-resource-control == bt-castle-cataphract-claim)
    (timer-triggered bt-castle-cataphract-watchdog-timer)
    (up-pending-objects c: castle > 0)
=>
    (disable-timer bt-castle-cataphract-watchdog-timer)
    (up-assign-builders c: castle c: bt-foundation-stall-builder-count)
    (enable-timer bt-castle-cataphract-watchdog-timer bt-castle-cataphract-watchdog-seconds)
)
(defrule
    (strategic-number sn-resource-control == bt-castle-cataphract-claim)
    (timer-triggered bt-castle-cataphract-watchdog-timer)
    (up-pending-objects c: castle == 0)
=>
    (disable-timer bt-castle-cataphract-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-castle-cataphract-failure-history-goal 1)
    (set-goal bt-castle-cataphract-backoff-goal 1)
    (enable-timer bt-castle-cataphract-backoff-timer bt-castle-cataphract-backoff-seconds)
)
(defrule
    (goal bt-castle-cataphract-backoff-goal 1)
    (timer-triggered bt-castle-cataphract-backoff-timer)
=>
    (disable-timer bt-castle-cataphract-backoff-timer)
    (set-goal bt-castle-cataphract-backoff-goal 0)
    (set-goal bt-castle-cataphract-failure-history-goal 0)
)

;---------------------------------------------------------------
; 15H. CASTLE -> IMPERIAL PREREQUISITE: SECOND QUALIFYING BUILDING
;---------------------------------------------------------------
; Imperial uses any two qualifying Castle-age buildings from:
;   Monastery, Siege Workshop, University.
;
; The Monastery is already a live Castle-age capability in Basilisk. Once
; one qualifying building exists, either missing alternative is a valid
; second provider. Castle/Cataphract demand must not own this prerequisite
; path; it is a separate strategic capability decision.
;
; Siege Workshop is first in source order, so when Monastery exists and both
; alternatives are absent it is the deterministic preferred second provider.
; If Siege Workshop is not currently buildable, University can claim the same
; one-of-three completion path later in the pass.
(defrule
    (current-age == castle-age)
    (goal bt-imperial-prereq-demand-goal 1)
    (goal bt-imperial-prereq-failure-history-goal 0)
    (goal bt-imperial-prereq-backoff-goal 0)
    (building-type-count-total castle < 1)
    (not (can-research-with-escrow imperial-age))
    (or
        (building-type-count-total monastery >= 1)
        (building-type-count-total university >= 1)
    )
    (building-type-count-total siege-workshop < 1)
    (up-pending-objects c: siege-workshop == 0)
    (strategic-number sn-resource-control == 0)
    (can-build-with-escrow siege-workshop)
=>
    (set-strategic-number sn-resource-control bt-imperial-siege-claim)
    (enable-timer bt-imperial-prereq-watchdog-timer bt-imperial-prereq-watchdog-seconds)
    (release-escrow wood)
    (build siege-workshop)
)

(defrule
    (strategic-number sn-resource-control == bt-imperial-siege-claim)
    (building-type-count siege-workshop >= 1)
=>
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (disable-timer bt-imperial-prereq-backoff-timer)
    (set-goal bt-imperial-prereq-backoff-goal 0)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (building-type-count siege-workshop >= 1)
    (goal bt-imperial-prereq-failure-history-goal 0)
    (or
        (strategic-number sn-resource-control == 0)
        (strategic-number sn-resource-control == bt-imperial-siege-claim)
    )
=>
    (disable-timer bt-imperial-prereq-backoff-timer)
    (set-goal bt-imperial-prereq-backoff-goal 0)
)

;---------------------------------------------------------------
; 15I. CASTLE -> IMPERIAL PREREQUISITE: UNIVERSITY FALLBACK
;---------------------------------------------------------------
; University is the alternate second provider. When Monastery or Siege
; Workshop already exists, completing University gives the second qualifying
; Castle-age building and should immediately satisfy the Imperial prerequisite.
(defrule
    (current-age == castle-age)
    (goal bt-imperial-prereq-demand-goal 1)
    (goal bt-imperial-prereq-failure-history-goal 0)
    (goal bt-imperial-prereq-backoff-goal 0)
    (building-type-count-total castle < 1)
    (not (can-research-with-escrow imperial-age))
    (or
        (building-type-count-total monastery >= 1)
        (building-type-count-total siege-workshop >= 1)
    )
    (building-type-count-total university < 1)
    (up-pending-objects c: university == 0)
    (strategic-number sn-resource-control == 0)
    (can-build-with-escrow university)
=>
    (set-strategic-number sn-resource-control bt-imperial-university-claim)
    (enable-timer bt-imperial-prereq-watchdog-timer bt-imperial-prereq-watchdog-seconds)
    (release-escrow wood)
    (build university)
)

(defrule
    (strategic-number sn-resource-control == bt-imperial-university-claim)
    (building-type-count university >= 1)
=>
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (disable-timer bt-imperial-prereq-backoff-timer)
    (set-goal bt-imperial-prereq-backoff-goal 0)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (building-type-count university >= 1)
    (goal bt-imperial-prereq-failure-history-goal 0)
    (or
        (strategic-number sn-resource-control == 0)
        (strategic-number sn-resource-control == bt-imperial-university-claim)
    )
=>
    (disable-timer bt-imperial-prereq-backoff-timer)
    (set-goal bt-imperial-prereq-backoff-goal 0)
)

;---------------------------------------------------------------
; 15J. CASTLE -> IMPERIAL PREREQUISITE WATCHDOG
;---------------------------------------------------------------

; Live Imperial-prerequisite foundations remain owned construction
; obligations. Keep the claim and continue builder support indefinitely.


;----------------------------------------------------------------
; CASTLE PREREQUISITE CONSTRUCTION WATCHDOG
; Blacksmith and Market use one transient prerequisite claim. The claim
; identifies the live provider; the foundation itself is the execution state.
(defrule
    (strategic-number sn-resource-control == bt-castle-blacksmith-claim)
    (timer-triggered bt-castle-prereq-watchdog-timer)
    (up-pending-objects c: blacksmith > 0)
=>
    (disable-timer bt-castle-prereq-watchdog-timer)
    (up-assign-builders c: blacksmith c: bt-foundation-stall-builder-count)
    (enable-timer bt-castle-prereq-watchdog-timer bt-castle-prereq-watchdog-seconds)
)
(defrule
    (strategic-number sn-resource-control == bt-castle-market-claim)
    (timer-triggered bt-castle-prereq-watchdog-timer)
    (up-pending-objects c: market > 0)
=>
    (disable-timer bt-castle-prereq-watchdog-timer)
    (up-assign-builders c: market c: bt-foundation-stall-builder-count)
    (enable-timer bt-castle-prereq-watchdog-timer bt-castle-prereq-watchdog-seconds)
)
(defrule
    (strategic-number sn-resource-control == bt-castle-blacksmith-claim)
    (timer-triggered bt-castle-prereq-watchdog-timer)
    (up-pending-objects c: blacksmith == 0)
=>
    (disable-timer bt-castle-prereq-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-castle-prereq-failure-history-goal bt-castle-prereq-failure-blacksmith)
    (set-goal bt-castle-prereq-backoff-goal 1)
    (enable-timer bt-castle-prereq-backoff-timer bt-castle-prereq-backoff-seconds)
)
(defrule
    (strategic-number sn-resource-control == bt-castle-market-claim)
    (timer-triggered bt-castle-prereq-watchdog-timer)
    (up-pending-objects c: market == 0)
=>
    (disable-timer bt-castle-prereq-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-castle-prereq-failure-history-goal bt-castle-prereq-failure-market)
    (set-goal bt-castle-prereq-backoff-goal 1)
    (enable-timer bt-castle-prereq-backoff-timer bt-castle-prereq-backoff-seconds)
)
(defrule
    (goal bt-castle-prereq-backoff-goal 1)
    (timer-triggered bt-castle-prereq-backoff-timer)
=>
    (disable-timer bt-castle-prereq-backoff-timer)
    (set-goal bt-castle-prereq-failure-history-goal 0)
    (set-goal bt-castle-prereq-backoff-goal 0)
)

;----------------------------------------------------------------
; IMPERIAL PREREQUISITE CONSTRUCTION WATCHDOG
; Siege Workshop and University are serialized capability providers. Their
; live foundation is sufficient execution state; no counter is needed.
(defrule
    (strategic-number sn-resource-control == bt-imperial-siege-claim)
    (timer-triggered bt-imperial-prereq-watchdog-timer)
    (up-pending-objects c: siege-workshop > 0)
=>
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (up-assign-builders c: siege-workshop c: bt-foundation-stall-builder-count)
    (enable-timer bt-imperial-prereq-watchdog-timer bt-imperial-prereq-watchdog-seconds)
)
(defrule
    (strategic-number sn-resource-control == bt-imperial-university-claim)
    (timer-triggered bt-imperial-prereq-watchdog-timer)
    (up-pending-objects c: university > 0)
=>
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (up-assign-builders c: university c: bt-foundation-stall-builder-count)
    (enable-timer bt-imperial-prereq-watchdog-timer bt-imperial-prereq-watchdog-seconds)
)
(defrule
    (strategic-number sn-resource-control == bt-imperial-siege-claim)
    (timer-triggered bt-imperial-prereq-watchdog-timer)
    (up-pending-objects c: siege-workshop == 0)
=>
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-imperial-prereq-failure-history-goal bt-imperial-prereq-failure-siege)
    (set-goal bt-imperial-prereq-backoff-goal 1)
    (enable-timer bt-imperial-prereq-backoff-timer bt-imperial-prereq-backoff-seconds)
)
(defrule
    (strategic-number sn-resource-control == bt-imperial-university-claim)
    (timer-triggered bt-imperial-prereq-watchdog-timer)
    (up-pending-objects c: university == 0)
=>
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-imperial-prereq-failure-history-goal bt-imperial-prereq-failure-university)
    (set-goal bt-imperial-prereq-backoff-goal 1)
    (enable-timer bt-imperial-prereq-backoff-timer bt-imperial-prereq-backoff-seconds)
)
(defrule
    (goal bt-imperial-prereq-backoff-goal 1)
    (timer-triggered bt-imperial-prereq-backoff-timer)
=>
    (disable-timer bt-imperial-prereq-backoff-timer)
    (set-goal bt-imperial-prereq-failure-history-goal 0)
    (set-goal bt-imperial-prereq-backoff-goal 0)
)

;----------------------------------------------------------------
; MONASTERY CONSTRUCTION WATCHDOG
(defrule
    (strategic-number sn-resource-control == bt-monastery-claim)
    (timer-triggered bt-monastery-watchdog-timer)
    (up-pending-objects c: monastery > 0)
=>
    (disable-timer bt-monastery-watchdog-timer)
    (up-assign-builders c: monastery c: bt-foundation-stall-builder-count)
    (enable-timer bt-monastery-watchdog-timer bt-monastery-watchdog-seconds)
)
(defrule
    (strategic-number sn-resource-control == bt-monastery-claim)
    (timer-triggered bt-monastery-watchdog-timer)
    (up-pending-objects c: monastery == 0)
=>
    (disable-timer bt-monastery-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-monastery-failure-history-goal 1)
    (set-goal bt-monastery-backoff-goal 1)
    (enable-timer bt-monastery-backoff-timer bt-monastery-backoff-seconds)
)
(defrule
    (goal bt-monastery-backoff-goal 1)
    (timer-triggered bt-monastery-backoff-timer)
=>
    (disable-timer bt-monastery-backoff-timer)
    (set-goal bt-monastery-failure-history-goal 0)
    (set-goal bt-monastery-backoff-goal 0)
)

;================================================================
; MONASTERY CAPABILITY LIFECYCLE
;================================================================
(defrule
    (goal bt-monk-demand-goal 1)
    (current-age >= castle-age)
    (goal bt-monastery-failure-history-goal 0)
    (goal bt-monastery-backoff-goal 0)
    (building-type-count-total monastery < 1)
    (up-pending-objects c: monastery == 0)
    (strategic-number sn-resource-control == 0)
    (can-build-with-escrow monastery)
=>
    (set-strategic-number sn-resource-control bt-monastery-claim)
    (release-escrow wood)
    (enable-timer bt-monastery-watchdog-timer bt-monastery-watchdog-seconds)
    (build monastery)
)
(defrule
    (strategic-number sn-resource-control == bt-monastery-claim)
    (building-type-count monastery >= 1)
=>
    (disable-timer bt-monastery-watchdog-timer)
    (disable-timer bt-monastery-backoff-timer)
    (set-goal bt-monastery-backoff-goal 0)
    (set-goal bt-monastery-failure-history-goal 0)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (building-type-count monastery >= 1)
    (strategic-number sn-resource-control != bt-monastery-claim)
=>
    (disable-timer bt-monastery-watchdog-timer)
    (disable-timer bt-monastery-backoff-timer)
    (set-goal bt-monastery-backoff-goal 0)
    (set-goal bt-monastery-failure-history-goal 0)
)

;================================================================
; 15Z. STANDING ARMY FLOOR
;================================================================
; The floor is a derived requirement, not a strategy.
; It scales only when age, civilian economy, and existing military
; infrastructure prove that the economy can support the larger army.
;
; Infrastructure = completed + queued Barracks + Archery Ranges +
; Stable capacity, using building-type-count-total.
;
; Controller tuning:
;   Feudal:          4
;   Castle:         12
;   Castle mature:  16
;   Castle late:    20
;   Imperial:       26
;   Imperial mature:34
;   Imperial late:  42
;
; These are standing-force targets, not attack-group sizes.
;
; Community note: building-type-count-total is queue-aware, so a
; production-building commitment counts toward infrastructure before
; construction is complete.  Soldier-count is used for the actual
; standing-force deficit rather than military-population.
(defrule
    (true)
=>
    (up-get-fact building-type-count-total barracks bt-standing-army-barracks-scratch-goal)
    (up-get-fact building-type-count-total archery-range bt-standing-army-range-scratch-goal)
    (up-get-fact building-type-count-total stable bt-standing-army-stable-scratch-goal)
    (set-goal bt-standing-army-infra-goal 0)
    (up-modify-goal bt-standing-army-infra-goal g:+ bt-standing-army-barracks-scratch-goal)
    (up-modify-goal bt-standing-army-infra-goal g:+ bt-standing-army-range-scratch-goal)
    (up-modify-goal bt-standing-army-infra-goal g:+ bt-standing-army-stable-scratch-goal)
)

(defrule
    (current-age < feudal-age)
=>
    (set-goal bt-standing-army-floor-goal 0)
)

(defrule
    (current-age == feudal-age)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal bt-standing-army-floor-goal 4)
)

(defrule
    (current-age == castle-age)
    (not (goal strategy-goal bt-strategy-flush))
    (or
        (unit-type-count villager < 45)
        (and
            (unit-type-count villager >= 45)
            (up-compare-goal bt-standing-army-infra-goal < 2)
        )
    )
=>
    (set-goal bt-standing-army-floor-goal 12)
)

(defrule
    (current-age == castle-age)
    (not (goal strategy-goal bt-strategy-flush))
    (unit-type-count villager >= 45)
    (up-compare-goal bt-standing-army-infra-goal >= 2)
    (or
        (unit-type-count villager < 60)
        (up-compare-goal bt-standing-army-infra-goal < 3)
    )
=>
    (set-goal bt-standing-army-floor-goal 16)
)

(defrule
    (current-age == castle-age)
    (not (goal strategy-goal bt-strategy-flush))
    (unit-type-count villager >= 60)
    (up-compare-goal bt-standing-army-infra-goal >= 3)
=>
    (set-goal bt-standing-army-floor-goal 20)
)

(defrule
    (current-age >= imperial-age)
    (not (goal strategy-goal bt-strategy-flush))
    (or
        (unit-type-count villager < 60)
        (up-compare-goal bt-standing-army-infra-goal < 4)
    )
=>
    (set-goal bt-standing-army-floor-goal 26)
)

(defrule
    (current-age >= imperial-age)
    (not (goal strategy-goal bt-strategy-flush))
    (unit-type-count villager >= 60)
    (up-compare-goal bt-standing-army-infra-goal >= 4)
    (or
        (unit-type-count villager < 80)
        (up-compare-goal bt-standing-army-infra-goal < 6)
    )
=>
    (set-goal bt-standing-army-floor-goal 34)
)

(defrule
    (current-age >= imperial-age)
    (not (goal strategy-goal bt-strategy-flush))
    (unit-type-count villager >= 80)
    (up-compare-goal bt-standing-army-infra-goal >= 6)
=>
    (set-goal bt-standing-army-floor-goal 42)
)

; FLUSH reinforcement floor.
; This is deliberately independent of enemy counter classification.
; Once the town enters FLUSH, the standing requirement cannot collapse
; back to the four-unit Feudal baseline while the enemy is still in the
; decisive-attack posture.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (current-age == feudal-age)
=>
    (set-goal bt-standing-army-floor-goal bt-flush-army-floor-feudal)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (current-age == castle-age)
    (up-compare-goal bt-standing-army-floor-goal < bt-flush-army-floor-castle)
=>
    (set-goal bt-standing-army-floor-goal bt-flush-army-floor-castle)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (current-age >= imperial-age)
    (up-compare-goal bt-standing-army-floor-goal < bt-flush-army-floor-imperial)
=>
    (set-goal bt-standing-army-floor-goal bt-flush-army-floor-imperial)
)

;---------------------------------------------------------------
; 15Z.1 ROLE-AWARE STANDING TARGETS
;---------------------------------------------------------------
(defrule
    (true)
=>
    (set-goal bt-standing-spear-target-goal 0)
    (set-goal bt-standing-skirm-target-goal 0)
    (set-goal bt-standing-archer-target-goal 0)
)
(defrule
    (true)
=>
    (set-goal bt-standing-camel-target-goal 0)
    (set-goal bt-standing-knight-target-goal 0)
    (set-goal bt-standing-crossbow-target-goal 0)
)
(defrule (up-compare-goal bt-standing-army-floor-goal == 4) =>
    (set-goal bt-standing-spear-target-goal 2)
    (set-goal bt-standing-skirm-target-goal 2)
)
(defrule (up-compare-goal bt-standing-army-floor-goal == 6) =>
    (set-goal bt-standing-spear-target-goal 3)
    (set-goal bt-standing-skirm-target-goal 3)
)
(defrule (up-compare-goal bt-standing-army-floor-goal == 8) =>
    (set-goal bt-standing-spear-target-goal 4)
    (set-goal bt-standing-skirm-target-goal 4)
)
(defrule (up-compare-goal bt-standing-army-floor-goal == 12) =>
    (set-goal bt-standing-spear-target-goal 6)
    (set-goal bt-standing-skirm-target-goal 6)
)
(defrule (up-compare-goal bt-standing-army-floor-goal == 16) =>
    (set-goal bt-standing-spear-target-goal 6)
    (set-goal bt-standing-skirm-target-goal 6)
    (set-goal bt-standing-archer-target-goal 4)
)
(defrule (up-compare-goal bt-standing-army-floor-goal == 20) =>
    (set-goal bt-standing-spear-target-goal 8)
    (set-goal bt-standing-skirm-target-goal 8)
    (set-goal bt-standing-archer-target-goal 4)
)
(defrule (up-compare-goal bt-standing-army-floor-goal == 26) =>
    (set-goal bt-standing-spear-target-goal 10)
    (set-goal bt-standing-skirm-target-goal 10)
    (set-goal bt-standing-archer-target-goal 6)
)
(defrule (up-compare-goal bt-standing-army-floor-goal == 30) =>
    (set-goal bt-standing-spear-target-goal 12)
    (set-goal bt-standing-skirm-target-goal 10)
    (set-goal bt-standing-archer-target-goal 8)
)
(defrule (up-compare-goal bt-standing-army-floor-goal == 34) =>
    (set-goal bt-standing-spear-target-goal 14)
    (set-goal bt-standing-skirm-target-goal 12)
    (set-goal bt-standing-archer-target-goal 8)
)
(defrule (up-compare-goal bt-standing-army-floor-goal == 42) =>
    (set-goal bt-standing-spear-target-goal 18)
    (set-goal bt-standing-skirm-target-goal 16)
    (set-goal bt-standing-archer-target-goal 8)
)
(defrule (up-compare-goal bt-cavalry-counter-level-goal >= 1) =>
    (up-modify-goal bt-standing-spear-target-goal c:max bt-spear-target-1)
)
(defrule (up-compare-goal bt-cavalry-counter-level-goal >= 2) =>
    (up-modify-goal bt-standing-spear-target-goal c:max bt-spear-target-2)
)
(defrule (up-compare-goal bt-cavalry-counter-level-goal >= 3) =>
    (up-modify-goal bt-standing-spear-target-goal c:max bt-spear-target-3)
)
(defrule (up-compare-goal bt-ranged-counter-level-goal >= 1) =>
    (up-modify-goal bt-standing-skirm-target-goal c:max bt-skirm-target-1)
)
(defrule (up-compare-goal bt-ranged-counter-level-goal >= 2) =>
    (up-modify-goal bt-standing-skirm-target-goal c:max bt-skirm-target-2)
)
(defrule (up-compare-goal bt-ranged-counter-level-goal >= 3) =>
    (up-modify-goal bt-standing-skirm-target-goal c:max bt-skirm-target-3)
)
(defrule (up-compare-goal bt-spear-counter-level-goal >= 1) =>
    (up-modify-goal bt-standing-archer-target-goal c:max 3)
)

; Feudal counter normalization.
; The generic counter levels above are intentionally retained for
; Castle/Imperial systems. In Feudal they would otherwise overwrite
; the small 2+2 defensive floor with six/16/24-unit targets.
; Normalize only the live Feudal role targets:
;   no threat     -> existing floor target
;   first pressure -> 3 of the relevant counter
;   second level   -> 4
;   heavy level    -> 6
; FLUSH's four-per-role floor is preserved until cavalry/ranged level 3.
(defrule
    (current-age == feudal-age)
    (up-compare-goal bt-standing-army-floor-goal >= 8)
=>
    (set-goal bt-standing-spear-target-goal 4)
    (set-goal bt-standing-skirm-target-goal 4)
)
(defrule
    (current-age == feudal-age)
    (up-compare-goal bt-standing-army-floor-goal <= 6)
    (up-compare-goal bt-cavalry-counter-level-goal >= 1)
=>
    (set-goal bt-standing-spear-target-goal bt-feudal-spear-counter-1)
)
(defrule
    (current-age == feudal-age)
    (up-compare-goal bt-standing-army-floor-goal <= 6)
    (up-compare-goal bt-cavalry-counter-level-goal >= 2)
=>
    (set-goal bt-standing-spear-target-goal bt-feudal-spear-counter-2)
)
(defrule
    (current-age == feudal-age)
    (up-compare-goal bt-cavalry-counter-level-goal >= 3)
=>
    (set-goal bt-standing-spear-target-goal bt-feudal-spear-counter-3)
)
(defrule
    (current-age == feudal-age)
    (up-compare-goal bt-standing-army-floor-goal <= 6)
    (up-compare-goal bt-ranged-counter-level-goal >= 1)
=>
    (set-goal bt-standing-skirm-target-goal bt-feudal-skirm-counter-1)
)
(defrule
    (current-age == feudal-age)
    (up-compare-goal bt-standing-army-floor-goal <= 6)
    (up-compare-goal bt-ranged-counter-level-goal >= 2)
=>
    (set-goal bt-standing-skirm-target-goal bt-feudal-skirm-counter-2)
)
(defrule
    (current-age == feudal-age)
    (up-compare-goal bt-ranged-counter-level-goal >= 3)
=>
    (set-goal bt-standing-skirm-target-goal bt-feudal-skirm-counter-3)
)
;---------------------------------------------------------------
; 15Z.1.0 PRIMARY MILITARY ROLE TARGETS
;---------------------------------------------------------------
(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= castle-age)
    (goal unit-goal knight-line)
    (not (goal bt-any-threat-goal 1))
=>
    (set-goal bt-standing-knight-target-goal bt-knight-target-castle)
)
(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= castle-age)
    (goal unit-goal knight-line)
    (unit-type-count villager >= 45)
=>
    (up-modify-goal bt-standing-knight-target-goal c:max bt-knight-target-mature)
)
(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= castle-age)
    (goal unit-goal knight-line)
    (unit-type-count villager >= 60)
=>
    (up-modify-goal bt-standing-knight-target-goal c:max bt-knight-target-late)
)

(defrule
    (or
        (goal strategy-goal bt-strategy-boom)
        (goal strategy-goal bt-strategy-castle-power)
    )
    (current-age >= castle-age)
    (goal unit-goal crossbowman)
    (not (goal bt-any-threat-goal 1))
=>
    (set-goal bt-standing-crossbow-target-goal bt-crossbow-target-castle)
)
(defrule
    (or
        (goal strategy-goal bt-strategy-boom)
        (goal strategy-goal bt-strategy-castle-power)
    )
    (current-age >= castle-age)
    (goal unit-goal crossbowman)
    (unit-type-count villager >= 45)
=>
    (up-modify-goal bt-standing-crossbow-target-goal c:max bt-crossbow-target-mature)
)
(defrule
    (or
        (goal strategy-goal bt-strategy-boom)
        (goal strategy-goal bt-strategy-castle-power)
    )
    (current-age >= castle-age)
    (goal unit-goal crossbowman)
    (unit-type-count villager >= 60)
=>
    (up-modify-goal bt-standing-crossbow-target-goal c:max bt-crossbow-target-late)
)

(defrule
    (goal bt-knight-demand-goal 0)
    (up-compare-goal bt-standing-knight-target-goal > 0)
    (unit-type-count-total knight-line < bt-standing-knight-target-goal)
    (goal strategy-goal bt-strategy-boom)
    (not (goal bt-any-threat-goal 1))
=>
    (set-goal bt-knight-demand-goal 1)
)
(defrule
    (goal bt-knight-demand-goal 1)
    (or (goal strategy-goal bt-strategy-flush) (or (goal strategy-goal bt-strategy-rush) (or (current-age < castle-age) (or (goal bt-any-threat-goal 1) (or (up-compare-goal bt-standing-knight-target-goal == 0) (or (unit-type-count-total
knight-line >= bt-standing-knight-target-goal) (not (goal unit-goal knight-line))))))))
=>
    (set-goal bt-knight-demand-goal 0)
)

(defrule
    (goal bt-crossbow-demand-goal 0)
    (up-compare-goal bt-standing-crossbow-target-goal > 0)
    (or
        (and
            (up-research-status c: ri-arbalest != research-complete)
            (unit-type-count-total crossbowman < bt-standing-crossbow-target-goal)
        )
        (and
            (up-research-status c: ri-arbalest == research-complete)
            (unit-type-count-total arbalest < bt-standing-crossbow-target-goal)
        )
    )
    (or
        (goal strategy-goal bt-strategy-boom)
        (goal strategy-goal bt-strategy-castle-power)
    )
    (not (goal bt-any-threat-goal 1))
=>
    (set-goal bt-crossbow-demand-goal 1)
)
(defrule
    (goal bt-crossbow-demand-goal 1)
    (or (goal strategy-goal bt-strategy-flush) (or (goal strategy-goal bt-strategy-rush) (or (current-age < castle-age) (or (goal bt-any-threat-goal 1) (or (up-compare-goal bt-standing-crossbow-target-goal == 0) (or (and
            (up-research-status c: ri-arbalest != research-complete)
            (unit-type-count-total crossbowman >= bt-standing-crossbow-target-goal)
        ) (or (and
            (up-research-status c: ri-arbalest == research-complete)
            (unit-type-count-total arbalest >= bt-standing-crossbow-target-goal)
        ) (not (goal unit-goal crossbowman)))))))))
=>
    (set-goal bt-crossbow-demand-goal 0)
)

;---------------------------------------------------------------
; 15Z.1.1 CAMEL TARGET RESET ASSUMPTION
;---------------------------------------------------------------
; bt-standing-camel-target-goal is a DERIVED target.
;
; The unconditional role-target reset rule above runs every pass:
;
;     (set-goal bt-standing-camel-target-goal 0)
;
; These Camel witness rules therefore only RAISE the target during
; the current evaluation pass. No persistent Camel release rule is
; required.
;
; The generic cavalry counter remains separate. It may still raise
; the Spear target, but it no longer directly authorizes Camels.

;---------------------------------------------------------------
; 15Z.1.2 KNIGHT-LINE CAMEL WITNESSES
;---------------------------------------------------------------
; Camel targets are RESPONSE PACKAGES, not parity targets.
; The four- and eight-Camel values are minimum standing responses;
; they do not mean the bot is trying to match the enemy unit count.
;
; 6+ enemy Knight-line units -> four Camels.
(defrule
    (players-unit-type-count any-enemy knight-line >= 6)
=>
    (up-modify-goal bt-standing-camel-target-goal c:max bt-camel-target-1)
)

; 12+ enemy Knight-line units -> eight Camels.
(defrule
    (players-unit-type-count any-enemy knight-line >= 12)
=>
    (up-modify-goal bt-standing-camel-target-goal c:max bt-camel-target-2)
)

;---------------------------------------------------------------
; 15Z.1.3 WAR ELEPHANT-LINE CAMEL WITNESSES
;---------------------------------------------------------------
; War Elephants use the same four/eight response packages, but their
; threat thresholds are lower because each Elephant is a much larger
; strategic investment than ordinary cavalry.
;
; These are RESPONSE PACKAGE triggers, not parity claims:
; four Camels are not asserted to be a direct numerical equivalent
; to three Elephants, nor are eight Camels asserted to be equal to
; six Elephants in combat.
(defrule
    (players-unit-type-count any-enemy war-elephant-line >= 3)
=>
    (up-modify-goal bt-standing-camel-target-goal c:max bt-camel-target-1)
)

; 6+ enemy War Elephants -> eight Camels.
(defrule
    (players-unit-type-count any-enemy war-elephant-line >= 6)
=>
    (up-modify-goal bt-standing-camel-target-goal c:max bt-camel-target-2)
)

;---------------------------------------------------------------
; 15Z.1.4 LIGHT CAVALRY / HUSSAR CAMEL WITNESSES
;---------------------------------------------------------------
; Castle Age is required so Feudal Scout presence cannot authorize
; Camel production.
;
; scout-cavalry-line is the existing Scout upgrade line. This means
; surviving Scouts can still contribute to the line count after
; Castle Age. That is a known classifier limitation, not a Camel
; lifecycle failure.
;
; The four/eight values are RESPONSE PACKAGES, not parity targets.
; They are minimum standing Camel commitments once the Light
; Cavalry/Hussar mass is large enough to matter.
;
; 10+ Scout/Light Cavalry/Hussar line units -> four Camels.
(defrule
    (current-age >= castle-age)
    (players-unit-type-count any-enemy scout-cavalry-line >= 10)
=>
    (up-modify-goal bt-standing-camel-target-goal c:max bt-camel-target-1)
)

; 20+ Scout/Light Cavalry/Hussar line units -> eight Camels.
(defrule
    (current-age >= castle-age)
    (players-unit-type-count any-enemy scout-cavalry-line >= 20)
=>
    (up-modify-goal bt-standing-camel-target-goal c:max bt-camel-target-2)
)

;---------------------------------------------------------------
; 15Z.1.5 EXPLICIT NO-TRIGGER: ENEMY CAMELS
;---------------------------------------------------------------
; There is deliberately NO camel-line -> Camel-target rule.
;
; Enemy Camel Riders may still contribute to the generic cavalry
; counter and therefore increase Spear demand elsewhere. They do
; not authorize a Camel target.

;---------------------------------------------------------------
; 15Z.1.6 EXPLICIT NO-TRIGGER: ENEMY CATAPHRACTS
;---------------------------------------------------------------
; There is deliberately NO cataphract-line -> Camel-target rule.
;
; Enemy Cataphracts may still contribute to the generic cavalry
; counter and therefore increase Spear demand elsewhere. They do
; not authorize a Camel target.
;
; This exclusion is matchup-specific: the Camel's cavalry bonus
; is heavily reduced by Cataphract cavalry armor, so Cataphracts
; should not be treated as ordinary Camel targets.

(defrule
    (true)
=>
    (up-get-fact soldier-count 0 bt-standing-army-deficit-goal)
    (up-modify-goal bt-standing-army-deficit-goal g:- bt-standing-army-floor-goal)
)

; Siege Tower payload availability is current soldiers above the standing
; army floor.  A non-negative army deficit does not itself prove that six
; infantry can be detached without collapsing the standing requirement.
(defrule
    (true)
=>
    (up-get-fact soldier-count 0 bt-siege-tower-spare-army-goal)
    (up-modify-goal bt-siege-tower-spare-army-goal g:- bt-standing-army-floor-goal)
)

; Standing-army demand stays live until both constraints are
; satisfied: the aggregate military floor AND every live role target.
; The floor answers "how many soldiers?" while the role targets answer
; "which composition minima?"  Reaching the floor must not suppress an
; unmet Spear/Skirmisher/Archer target.
(defrule
    (current-age >= feudal-age)
    (or
        (goal strategy-goal bt-strategy-boom)
        (or
            (goal strategy-goal bt-strategy-flush)
            (goal strategy-goal bt-strategy-castle-power)
        )
    )
    (or (up-compare-goal bt-standing-army-deficit-goal < 0) (or (unit-type-count-total spearman-line < bt-standing-spear-target-goal) (or (unit-type-count-total skirmisher-line < bt-standing-skirm-target-goal) (or (unit-type-count-total
archer-line < bt-standing-archer-target-goal) (or (unit-type-count-total knight-line < bt-standing-knight-target-goal) (or (and
            (up-research-status c: ri-arbalest != research-complete)
            (unit-type-count-total crossbowman < bt-standing-crossbow-target-goal)
        ) (and
            (up-research-status c: ri-arbalest == research-complete)
            (unit-type-count-total arbalest < bt-standing-crossbow-target-goal)
        )))))))
=>
    (set-goal bt-standing-army-demand-goal 1)
)

(defrule
    (or (current-age < feudal-age) (or (not
            (or
                (goal strategy-goal bt-strategy-boom)
                (or
                    (goal strategy-goal bt-strategy-flush)
                    (goal strategy-goal bt-strategy-castle-power)
                )
            )
        ) (and (up-compare-goal bt-standing-army-deficit-goal >= 0) (and (unit-type-count-total spearman-line >= bt-standing-spear-target-goal) (and (unit-type-count-total skirmisher-line >= bt-standing-skirm-target-goal) (and
(unit-type-count-total archer-line >= bt-standing-archer-target-goal) (and (unit-type-count-total knight-line >= bt-standing-knight-target-goal) (or
                (and
                    (up-research-status c: ri-arbalest != research-complete)
                    (unit-type-count-total crossbowman >= bt-standing-crossbow-target-goal)
                )
                (and
                    (up-research-status c: ri-arbalest == research-complete)
                    (unit-type-count-total arbalest >= bt-standing-crossbow-target-goal)
                )
            ))))))))
=>
    (set-goal bt-standing-army-demand-goal 0)
)

;================================================================
; 16. MILITARY PRODUCTION ARBITRATION
;================================================================
;
;---------------------------------------------------------------
; 16A. FEUDAL SCOUT PRESSURE PRODUCTION
;---------------------------------------------------------------
; This is the sole direct Scout-production authority.
; unit-type-count-total scout-cavalry is intentionally exact here:
; it counts Scout Cavalry, including queued objects, without treating
; later Light Cavalry/Hussar as unfinished Scout production.
(defrule
    (goal bt-scout-pressure-demand-goal 1)
    (current-age == feudal-age)
    (goal strategy-goal bt-strategy-boom)
    (goal bt-any-threat-goal 0)
    (not (town-under-attack))
    (strategic-number sn-resource-control == 0)
    (not (or
        (can-research-with-escrow castle-age)
        (goal bt-castle-commitment-goal 1)
    ))
    (building-type-count stable >= 1)
    (unit-type-count-total scout-cavalry < bt-scout-feudal-cap)
    (food-amount >= bt-scout-safe-food)
    (can-train scout-cavalry)
=>
    (train scout-cavalry)
)

;---------------------------------------------------------------
; 16B. CATAPHRact PRODUCTION
;---------------------------------------------------------------
;
; Cataphract production consumes the explicit strategic demand.
; The Castle is the production capability; no Stable is required.
; unit-type-count-total is queue-inclusive and follows the active enemy tier.
(defrule
    (goal bt-cataphract-demand-goal 1)
    (strategic-number sn-resource-control == 0)
    (building-type-count castle >= 1)
    (or (and
            (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-3)
            (unit-type-count-total cataphract-line < bt-cataphract-target-3)
        ) (or (and (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-2) (and (players-unit-type-count any-enemy militiaman-line < bt-cataphract-enemy-threshold-3) (unit-type-count-total cataphract-line <
bt-cataphract-target-2))) (and (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-1) (and (players-unit-type-count any-enemy militiaman-line < bt-cataphract-enemy-threshold-2) (unit-type-count-total
cataphract-line < bt-cataphract-target-1)))))
    (can-train-with-escrow cataphract-line)
=>
    (release-escrow food)
    (release-escrow gold)
    (train cataphract-line)
)
;---------------------------------------------------------------
; 16B.1 VARANGIAN GUARD PRODUCTION
; The Castle-age Guard uses existing Barracks capability. Production is
; demand-driven and queue-inclusive; no new production subsystem exists.
(defrule
    (goal bt-varangian-demand-goal 1)
    (current-age >= imperial-age)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks >= 1)
    (up-compare-goal bt-varangian-fielded-goal < bt-varangian-target-goal)
    (up-pending-objects c: elite-varangian-guard == 0)
    (can-train-with-escrow elite-varangian-guard)
=>
    (release-escrow food)
    (release-escrow gold)
    (train elite-varangian-guard)
)

(defrule
    (goal bt-varangian-demand-goal 1)
    (current-age >= castle-age)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks >= 1)
    (up-compare-goal bt-varangian-fielded-goal < bt-varangian-target-goal)
    (up-pending-objects c: varangian-guard == 0)
    (can-train-with-escrow varangian-guard)
=>
    (release-escrow food)
    (release-escrow gold)
    (train varangian-guard)
)


; 16B.0. MONK RESPONSE PRODUCTION
;---------------------------------------------------------------
(defrule
    (goal bt-monk-demand-goal 1)
    (current-age >= castle-age)
    (building-type-count monastery >= 1)
    (unit-type-count-total monk < bt-monk-target-goal)
    (strategic-number sn-resource-control == 0)
    (can-train-with-escrow monk)
=>
    (release-escrow gold)
    (train monk)
)

; 16B.1. MANGONEL RESPONSE PRODUCTION
;---------------------------------------------------------------
; Persistent demand is the strategic authority; this rule is only the
; queueing edge after the completed Workshop capability exists.
;
; unit-type-count-total is deliberately used here because it counts the
; existing Mangonels plus queued Mangonel production. Without that witness,
; a persistent demand would issue repeated train commands while the queue
; is still filling.
;
; The response target stops at two Mangonels for this repair. The later
; package-completion/reset lifecycle will own what happens after the target
; is reached.
(defrule
    (goal bt-mangonel-demand-goal 1)
    (current-age >= castle-age)
    (strategic-number sn-resource-control == 0)
    (building-type-count siege-workshop >= 1)
    (unit-type-count-total mangonel-line < bt-mangonel-response-target)
    (can-train mangonel-line)
=>
    (train mangonel-line)
)

;---------------------------------------------------------------
; 16B.1A. SCORPION RESPONSE PRODUCTION
;---------------------------------------------------------------
; Queue-aware target prevents repeated train commands while Scorpions are
; already in the Workshop queue. Escrow-aware feasibility matches the BBC
; production standard: release the resources actually consumed by this train,
; then issue the engine action.
(defrule
    (goal bt-scorpion-demand-goal 1)
    (current-age >= castle-age)
    (players-unit-type-count target-player militiaman-line >= bt-scorpion-trigger-infantry)
    (players-building-count target-player > 0)
    (player-in-game target-player)
    (up-compare-goal bt-scout-target-player-goal > 0)
    (up-compare-goal bt-cavalry-counter-level-goal < 2)
    (up-compare-goal bt-ranged-counter-level-goal < 2)
    (players-unit-type-count target-player mangonel-line < 2)
    (players-unit-type-count target-player scorpion-line < 4)
    (goal bt-mangonel-demand-goal 0)
    (goal bt-onager-demand-goal 0)
    (goal bt-bombard-cannon-demand-goal 0)
    (goal bt-ram-demand-goal 0)
    (goal retreat-now-goal 0)
    (not (town-under-attack))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (strategic-number sn-resource-control == 0)
    (building-type-count siege-workshop >= 1)
    (unit-type-count-total scorpion-line < bt-scorpion-response-target)
    (can-train-with-escrow scorpion-line)
=>
    (release-escrow food)
    (release-escrow gold)
    (train scorpion-line)
)

; Imperial escalation keeps the existing anti-ranged demand alive long enough
; to build the predecessor mass required for Onager. Queue-aware counting is
; deliberate: queued Mangonels count toward the four-unit execution ceiling.
(defrule
    (goal bt-onager-demand-goal 1)
    (current-age >= imperial-age)
    (strategic-number sn-resource-control == 0)
    (building-type-count siege-workshop >= 1)
    (unit-type-count-total mangonel-line < bt-mangonel-imperial-escalation-target)
    (can-train mangonel-line)
=>
    (train mangonel-line)
)

; Once Onager is researched, produce a finite Imperial response package.
(defrule
    (goal bt-onager-demand-goal 1)
    (current-age >= imperial-age)
    (building-type-count siege-workshop >= 1)
    (up-research-status c: ri-onager == research-complete)
    (strategic-number sn-resource-control == 0)
    (unit-type-count-total mangonel-line < bt-onager-response-target)
    (can-train onager)
=>
    (train onager)
)

; Precision Imperial artillery is a finite response package against an
; observed enemy Trebuchet. Chemistry is the prerequisite capability and is
; handled by the demand/research lifecycle below.
(defrule
    (goal bt-bombard-cannon-demand-goal 1)
    (current-age >= imperial-age)
    (building-type-count siege-workshop >= 1)
    (up-research-status c: ri-chemistry == research-complete)
    (strategic-number sn-resource-control == 0)
    (unit-type-count-total bombard-cannon-line < bt-imperial-siege-bbc-target)
    (goal retreat-now-goal 0)
    (not (town-under-attack))
    (can-train-with-escrow bombard-cannon-line)
=>
    (release-escrow wood)
    (release-escrow gold)
    (train bombard-cannon-line)
)

;---------------------------------------------------------------
; 16B.2. RAM RESPONSE PRODUCTION
;---------------------------------------------------------------
; Attack/building-pressure demand is the strategic authority. This rule
; only queues the finite ram package through the completed Workshop.
;
; unit-type-count-total is deliberately queue-aware: completed plus queued
; Rams count against bt-ram-response-target, preventing duplicate orders.
(defrule
    (goal bt-ram-demand-goal 1)
    (current-age >= castle-age)
    (strategic-number sn-resource-control == 0)
    (building-type-count siege-workshop >= 1)
    (or
        (current-age == castle-age)
        (goal bt-imperial-siege-package-goal 1)
    )
    (goal retreat-now-goal 0)
    (not (town-under-attack))
    (or
        (unit-type-count-total battering-ram-line < bt-ram-response-target)
        (and (current-age >= imperial-age) (and (up-research-status c: ri-capped-ram == research-complete) (unit-type-count-total battering-ram-line < bt-ram-imperial-response-target)))
    )
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)

(defrule
    (goal bt-siege-tower-demand-goal 1)
    (goal bt-siege-tower-stage-goal bt-siege-tower-stage-tower-pending)
    (current-age >= castle-age)
    (strategic-number sn-resource-control == 0)
    (building-type-count siege-workshop >= 1)
    (unit-type-count-total siege-tower < 1)
    (can-train-with-escrow siege-tower)
=>
    (release-escrow wood)
    (release-escrow gold)
    (train siege-tower)
)

; Scout and Cataphract production are explicit capability exceptions;
; the composition goals below own the remaining military queue.
;
; The goals above decide what is wanted.
; These rules decide what actually gets queued.
;
; Explicit composition train rules require:
;
;   strategy
;   unit-goal
;   resource claim free
;   counter/pressure condition
;   queue-aware unit target
;   legal training
;
; The standing floor uses soldier-count for the aggregate deficit.
; Each live role target uses unit-type-count-total as its queue-aware
; completion witness.
;---------------------------------------------------------------
; 16C. PERSISTENT BOOM MILITARY FLOOR
;---------------------------------------------------------------
; BOOM prioritizes economic expansion, but it does not abandon a
; minimum defensive army.  This floor is independent of transient
; enemy observation and remains separate from the attack lifecycle.
;
; The BOOM floor is four units; FLUSH can raise the defensive floor to eight.
(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= feudal-age)
    (goal bt-standing-army-demand-goal 1)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (or
        (goal strategy-goal bt-strategy-boom)
        (or
            (goal strategy-goal bt-strategy-flush)
            (goal strategy-goal bt-strategy-castle-power)
        )
    )
    (current-age >= feudal-age)
    (goal bt-standing-army-demand-goal 1)
    (goal bt-castle-commitment-goal 0)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks >= 1)
    (unit-type-count-total spearman-line < bt-standing-spear-target-goal)
    (can-train spearman-line)
=>
    (train spearman-line)
)
(defrule
    (or
        (goal strategy-goal bt-strategy-boom)
        (or
            (goal strategy-goal bt-strategy-flush)
            (goal strategy-goal bt-strategy-castle-power)
        )
    )
    (current-age >= feudal-age)
    (goal bt-standing-army-demand-goal 1)
    (goal bt-castle-commitment-goal 0)
    (strategic-number sn-resource-control == 0)
    (building-type-count archery-range >= 1)
    (unit-type-count-total skirmisher-line < bt-standing-skirm-target-goal)
    (can-train skirmisher-line)
=>
    (train skirmisher-line)
)
(defrule
    (or
        (goal strategy-goal bt-strategy-boom)
        (or
            (goal strategy-goal bt-strategy-flush)
            (goal strategy-goal bt-strategy-castle-power)
        )
    )
    (current-age >= feudal-age)
    (goal bt-standing-army-demand-goal 1)
    (goal bt-castle-commitment-goal 0)
    (strategic-number sn-resource-control == 0)
    (building-type-count archery-range >= 1)
    (unit-type-count-total archer-line < bt-standing-archer-target-goal)
    (can-train archer-line)
=>
    (train archer-line)
)

; 16D. PERSISTENT FLUSH MILITARY FLOOR
;---------------------------------------------------------------
; FLUSH is a defensive posture, not a momentary reaction to a
; currently visible enemy unit. Once entered, the bot must rebuild
; a minimum army before it is allowed to recover out of FLUSH.
;
; This floor deliberately does not require a current enemy threat or
; a specific unit-goal.  It closes the FLUSH -> temporary observation
; gap -> no production failure.
;
; The FLUSH fallback stream consumes the live soldier deficit.
; It remains active after six units until the FLUSH reinforcement floor
; is restored, even when no specific enemy counter has been classified.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (current-age >= feudal-age)
    (goal bt-standing-army-demand-goal 1)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)

; The FLUSH reserve is now served by the shared role-target producers.
; No quantity-only Spear fallback remains.

;---------------------------------------------------------------
; 16G. EXPLICIT ARCHER GOAL
(defrule
    (goal strategy-goal bt-strategy-rush)
    (goal unit-goal archer-line)
    (goal bt-castle-commitment-goal 0)
    (strategic-number sn-resource-control == 0)
    (building-type-count archery-range >= 1)
    (unit-type-count-total archer-line < 10)
    (can-train archer-line)
=>
    (train archer-line)
)
; RUSH is the explicit unit-goal exception. FLUSH/BOOM standing
; production is owned by the role-target producers above.

;---------------------------------------------------------------
; 16H. PRIMARY CASTLE MILITARY PRODUCTION
;---------------------------------------------------------------
(defrule
    (goal bt-knight-demand-goal 1)
    (current-age >= castle-age)
    (building-type-count stable >= 1)
    (goal bt-resource-mode-goal bt-resource-mode-castle-boom)
    (strategic-number sn-resource-control == 0)
    (unit-type-count-total knight-line < bt-standing-knight-target-goal)
    (can-train knight-line)
    (up-get-fact building-type-count-total stable bt-primary-capacity-scratch-goal)
    (up-pending-objects c: knight-line g:< bt-primary-capacity-scratch-goal)
=>
    (train knight-line)
)

(defrule
    (goal bt-crossbow-demand-goal 1)
    (current-age >= castle-age)
    (building-type-count archery-range >= 1)
    (up-research-status c: ri-crossbow == research-complete)
    (or
        (goal bt-resource-mode-goal bt-resource-mode-castle-boom)
        (goal bt-resource-mode-goal bt-resource-mode-premium-gold)
    )
    (strategic-number sn-resource-control == 0)
    (up-research-status c: ri-arbalest != research-complete)
    (unit-type-count-total crossbowman < bt-standing-crossbow-target-goal)
    (can-train crossbowman)
    (up-get-fact building-type-count-total archery-range bt-primary-capacity-scratch-goal)
    (up-pending-objects c: crossbowman g:< bt-primary-capacity-scratch-goal)
=>
    (train crossbowman)
)

;---------------------------------------------------------------
; 16H.1. PRIMARY IMPERIAL RANGED PRODUCTION
;---------------------------------------------------------------
; The Arbalest demand lifecycle deliberately survives the Castle-boom
; resource mode into Imperial power/trash modes. Do not inherit the
; Castle-only producer gate from Crossbow production.
;
; Demand ownership remains bt-crossbow-demand-goal. Arbalester research
; completion switches the terminal unit witness from Crossbowman to
; Arbalester; this rule closes the missing demand -> engine-action edge.
;
; completed Archery Range is the capability witness. The total Range count
; remains the queue-capacity source, matching the existing primary producer.
(defrule
    (goal bt-crossbow-demand-goal 1)
    (current-age >= imperial-age)
    (building-type-count archery-range >= 1)
    (up-research-status c: ri-arbalest == research-complete)
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (not (goal bt-resource-mode-goal bt-resource-mode-food-crisis))
    (not (goal bt-resource-mode-goal bt-resource-mode-gold-crisis))
    (strategic-number sn-resource-control == 0)
    (unit-type-count-total arbalest < bt-standing-crossbow-target-goal)
    (can-train arbalest)
    (up-get-fact building-type-count-total archery-range bt-primary-capacity-scratch-goal)
    (up-pending-objects c: arbalest g:< bt-primary-capacity-scratch-goal)
=>
    (train arbalest)
)

;---------------------------------------------------------------
; 16H. DIRECT CAMEL ROLE
;---------------------------------------------------------------
; Camel support is a direct standing-role demand, independent of MIX.
(defrule
    (current-age >= castle-age)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-standing-camel-target-goal > 0)
    (building-type-count stable >= 1)
    (unit-type-count-total camel-line < bt-standing-camel-target-goal)
    (can-train camel)
=>
    (train camel)
)

;----------------------------------------------------------------
; BASILISK STRATEGIC NARRATION: MAJOR ECO RESEARCH
; Demand, active research, and completion are observed without touching
; technology authority or resource-claim predicates.
;----------------------------------------------------------------
(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal bt-horse-collar-demand-goal 1)
    (up-compare-goal bt-debug-last-eco-event-goal != 1)
=>
    (chat-local-to-self "BASILISK | ECO | Horse Collar: demand active.")
    (set-goal bt-debug-last-eco-event-goal 1)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal bt-research-mill-claim-goal ri-horse-collar)
    (up-compare-goal bt-debug-last-eco-event-goal != 2)
=>
    (chat-local-to-self "BASILISK | ECO | Horse Collar: research started.")
    (set-goal bt-debug-last-eco-event-goal 2)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (up-research-status c: ri-horse-collar == research-complete)
    (up-compare-goal bt-debug-last-eco-event-goal != 3)
=>
    (chat-local-to-self "BASILISK | ECO | Horse Collar: complete.")
    (set-goal bt-debug-last-eco-event-goal 3)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 2)
    (goal bt-double-bit-axe-demand-goal 1)
    (up-compare-goal bt-debug-last-eco-event-goal != 4)
=>
