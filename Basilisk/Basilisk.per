    (unit-type-count-total spearman-line >= bt-spear-target-2)
    (or
        (up-compare-goal bt-cavalry-counter-level-goal >= 2)
        (goal bt-blacksmith-infantry-army-goal 1)
    )
    (up-research-status c: ri-plate-mail < research-pending)
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (not (goal bt-resource-mode-goal bt-resource-mode-food-crisis))
    (not (goal bt-resource-mode-goal bt-resource-mode-gold-crisis))
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-plate-mail)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-plate-mail)
    (goal bt-research-blacksmith-claim-goal 0)
    (goal bt-research-cavalry-counter-package-goal ri-plate-mail)
=>
    (set-strategic-number sn-resource-control ri-plate-mail)
    (release-escrow food)
    (release-escrow gold)
    (research ri-plate-mail)
    (set-goal bt-research-blacksmith-claim-goal ri-plate-mail)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-research-blacksmith-claim-goal ri-plate-mail)
    (up-research-status c: ri-plate-mail == research-complete)
=>
    (set-goal bt-research-blacksmith-claim-goal 0)
)

;================================================================
; 23. MATURE MILITARY RESEARCH
;================================================================
; Spear and Camel production already consume their unit lines. These
; research lifecycles therefore upgrade the existing production stream
; rather than introducing new unit-goal state.
(defrule
    (goal bt-halberdier-demand-goal 0)
    (current-age >= imperial-age)
    (up-research-status c: ri-pikeman == research-complete)
    (up-compare-goal bt-cavalry-counter-level-goal >= 2)
    (up-compare-goal bt-standing-spear-target-goal >= bt-spear-target-2)
    (research-available ri-halberdier)
=>
    (set-goal bt-halberdier-demand-goal 1)
)
(defrule
    (goal bt-halberdier-demand-goal 1)
    (strategic-number sn-resource-control != ri-halberdier)
    (or (not (research-available ri-halberdier)) (or (current-age < imperial-age) (or (up-compare-goal bt-cavalry-counter-level-goal < 2) (up-compare-goal bt-standing-spear-target-goal < bt-spear-target-2))))
=>
    (set-goal bt-halberdier-demand-goal 0)
)
(defrule
    (goal bt-halberdier-demand-goal 1)
    (current-age >= imperial-age)
    (up-compare-goal bt-research-barracks-failure-backoff-goal != ri-halberdier)
    (strategic-number sn-resource-control == 0)
    (building-type-count barracks >= 1)
    (can-research-with-escrow ri-halberdier)
    (goal bt-research-barracks-claim-goal 0)
    (goal bt-research-cavalry-counter-package-goal ri-halberdier)
=>
    (set-strategic-number sn-resource-control ri-halberdier)
    (release-escrow food)
    (release-escrow gold)
    (research ri-halberdier)
    (set-goal bt-research-barracks-claim-goal ri-halberdier)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-research-barracks-claim-goal ri-halberdier)
    (up-research-status c: ri-halberdier == research-complete)
=>
    (set-goal bt-research-barracks-claim-goal 0)
    (set-goal bt-halberdier-demand-goal 0)
)

(defrule
    (goal bt-heavy-camel-demand-goal 0)
    (current-age >= imperial-age)
    (building-type-count stable >= 1)
    (up-compare-goal bt-cavalry-counter-level-goal >= 2)
    (up-compare-goal bt-standing-camel-target-goal >= bt-camel-target-1)
    (unit-type-count-total camel-line >= bt-camel-target-1)
    (research-available ri-heavy-camel)
=>
    (set-goal bt-heavy-camel-demand-goal 1)
)
(defrule
    (goal bt-heavy-camel-demand-goal 1)
    (strategic-number sn-resource-control != ri-heavy-camel)
    (or (not (research-available ri-heavy-camel)) (or (current-age < imperial-age) (or (up-compare-goal bt-cavalry-counter-level-goal < 2) (or (up-compare-goal bt-standing-camel-target-goal < bt-camel-target-1) (unit-type-count-total
camel-line < bt-camel-target-1)))))
=>
    (set-goal bt-heavy-camel-demand-goal 0)
)
(defrule
    (goal bt-heavy-camel-demand-goal 1)
    (current-age >= imperial-age)
    (up-compare-goal bt-research-stable-failure-backoff-goal != ri-heavy-camel)
    (strategic-number sn-resource-control == 0)
    (building-type-count stable >= 1)
    (can-research-with-escrow ri-heavy-camel)
    (goal bt-research-stable-claim-goal 0)
=>
    (set-strategic-number sn-resource-control ri-heavy-camel)
    (release-escrow food)
    (release-escrow gold)
    (research ri-heavy-camel)
    (set-goal bt-research-stable-claim-goal ri-heavy-camel)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-research-stable-claim-goal ri-heavy-camel)
    (up-research-status c: ri-heavy-camel == research-complete)
=>
    (set-goal bt-research-stable-claim-goal 0)
    (set-goal bt-heavy-camel-demand-goal 0)
)

(defrule
    (goal bt-research-barracks-claim-goal ri-halberdier)
    (up-research-status c: ri-halberdier <= research-available)
=>
    (set-goal bt-research-barracks-failure-backoff-goal ri-halberdier)
    (enable-timer bt-research-barracks-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-barracks-claim-goal 0)
)

(defrule
    (goal bt-research-stable-claim-goal ri-heavy-camel)
    (up-research-status c: ri-heavy-camel <= research-available)
=>
    (set-goal bt-research-stable-failure-backoff-goal ri-heavy-camel)
    (enable-timer bt-research-stable-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-stable-claim-goal 0)
)

;================================================================
; RESEARCH CAPABILITY LOSS
;================================================================
; A capability-local claim dies when every instance of its research
; building disappears. This is world-state cleanup, not a research-action
; failure. The package/demand layer remains live and can reassert the tech
; after the capability is rebuilt. No global strategic claim is touched.
(defrule
    (up-compare-goal bt-research-town-center-claim-goal != 0)
    (building-type-count town-center == 0)
=>
    (set-goal bt-research-town-center-claim-goal 0)
)

(defrule
    (up-compare-goal bt-research-mill-claim-goal != 0)
    (building-type-count mill == 0)
=>
    (set-goal bt-research-mill-claim-goal 0)
)

(defrule
    (up-compare-goal bt-research-lumber-camp-claim-goal != 0)
    (building-type-count lumber-camp == 0)
=>
    (set-goal bt-research-lumber-camp-claim-goal 0)
)

(defrule
    (up-compare-goal bt-research-mining-camp-claim-goal != 0)
    (building-type-count mining-camp == 0)
=>
    (set-goal bt-research-mining-camp-claim-goal 0)
)

(defrule
    (up-compare-goal bt-research-blacksmith-claim-goal != 0)
    (building-type-count blacksmith == 0)
=>
    (set-goal bt-research-blacksmith-claim-goal 0)
)
(defrule
    (building-type-count blacksmith == 0)
    (or
        (goal bt-research-cavalry-counter-package-goal ri-scale-mail)
        (or
            (goal bt-research-cavalry-counter-package-goal ri-chain-mail)
            (goal bt-research-cavalry-counter-package-goal ri-plate-mail)
        )
    )
=>
    (set-goal bt-research-cavalry-counter-package-goal 0)
)
(defrule
    (building-type-count blacksmith == 0)
    (or
        (goal bt-research-ranged-counter-package-goal ri-fletching)
        (or
            (goal bt-research-ranged-counter-package-goal ri-bodkin-arrow)
            (or
                (goal bt-research-ranged-counter-package-goal ri-padded-archer-armor)
                (or
                    (goal bt-research-ranged-counter-package-goal ri-leather-archer-armor)
                    (or
                        (goal bt-research-ranged-counter-package-goal ri-ring-archer-armor)
                        (goal bt-research-ranged-counter-package-goal ri-bracer)
                    )
                )
            )
        )
    )
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; Failure state is represented only by the capability-local fairness
; backoff goal and timer, so a valid package can recover automatically.

; Failure is represented only by capability-local fairness backoff and
; the active package demand. A valid package may recover automatically.
(defrule
    (up-compare-goal bt-research-university-claim-goal != 0)
    (building-type-count university == 0)
=>
    (set-goal bt-research-university-claim-goal 0)
)
(defrule
    (building-type-count university == 0)
    (or
        (goal bt-research-siege-package-goal ri-ballistics)
        (goal bt-research-siege-package-goal ri-chemistry)
    )
=>
    (set-goal bt-research-siege-package-goal 0)
)

(defrule
    (up-compare-goal bt-research-castle-claim-goal != 0)
    (building-type-count castle == 0)
=>
    (set-goal bt-research-castle-claim-goal 0)
    (set-goal bt-research-cataphract-package-goal 0)
)

(defrule
    (up-compare-goal bt-research-barracks-claim-goal != 0)
    (building-type-count barracks == 0)
=>
    (set-goal bt-research-barracks-claim-goal 0)
)
