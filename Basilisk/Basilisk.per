; Knight support: Forging -> Iron Casting and cavalry armor.
; Feudal Forging belongs to a real Scout-pressure package.
(defrule
    (current-age == feudal-age)
    (building-type-count blacksmith >= 1)
    (or
        (and
            (goal bt-scout-pressure-demand-goal 1)
            (and
                (goal strategy-goal bt-strategy-boom)
                (and
                    (goal bt-any-threat-goal 0)
                    (unit-type-count-total scout-cavalry >= 3)
                )
            )
        )
        (goal bt-research-cavalry-counter-package-goal ri-forging)
    )
    (not (goal bt-castle-commitment-goal 1))
    (up-research-status c: ri-forging < research-pending)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-forging)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-forging)
    (goal bt-research-blacksmith-claim-goal 0)
    (or
        (goal bt-research-cavalry-counter-package-goal ri-forging)
        (and
            (goal bt-research-cavalry-counter-package-goal 0)
            (goal bt-research-ranged-counter-package-goal 0)
        )
    )
=>
    (set-strategic-number sn-resource-control ri-forging)
    (release-escrow food)
    (research ri-forging)
    (set-goal bt-research-blacksmith-claim-goal ri-forging)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-research-blacksmith-claim-goal ri-forging)
    (up-research-status c: ri-forging == research-complete)
=>
    (set-goal bt-research-blacksmith-claim-goal 0)
)

; Castle catch-up for a previously skipped Forging investment.
; Without it, Iron Casting becomes unreachable after a fast Castle transition.
(defrule
    (current-age >= castle-age)
    (building-type-count blacksmith >= 1)
    (or
        (unit-type-count-total knight-line >= bt-knight-target-castle)
        (or
            (unit-type-count-total cataphract-line >= bt-cataphract-target-1)
            (or
                (unit-type-count-total camel-line >= bt-camel-target-1)
                (or
                    (goal bt-blacksmith-infantry-army-goal 1)
                    (goal bt-research-cavalry-counter-package-goal ri-forging)
                )
            )
        )
    )
    (up-research-status c: ri-forging < research-pending)
    (not (goal bt-imperial-commitment-goal 1))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-forging)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-forging)
    (goal bt-research-blacksmith-claim-goal 0)
    (or
        (goal bt-research-cavalry-counter-package-goal ri-forging)
        (and
            (goal bt-research-cavalry-counter-package-goal 0)
            (goal bt-research-ranged-counter-package-goal 0)
        )
    )
=>
    (set-strategic-number sn-resource-control ri-forging)
    (release-escrow food)
    (research ri-forging)
    (set-goal bt-research-blacksmith-claim-goal ri-forging)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (current-age >= castle-age)
    (or (current-age > castle-age) (not (goal bt-imperial-commitment-goal 1)))
    (building-type-count blacksmith >= 1)
    (up-research-status c: ri-forging == research-complete)
    (or
        (unit-type-count-total knight-line >= bt-knight-target-castle)
        (or
            (unit-type-count-total cataphract-line >= bt-cataphract-target-1)
