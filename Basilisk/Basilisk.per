    (set-goal bt-debug-last-opening-goal 0)
    (set-goal bt-debug-last-threat-goal 0)
    (set-goal bt-debug-last-resource-mode-goal 0)
    (set-goal bt-debug-last-unit-goal 0)
    (set-goal bt-debug-last-castle-block-goal 0)
    (set-goal bt-debug-last-tc-stage-goal 0)
    (set-goal bt-debug-last-tc-complete-goal 1)
    (set-goal bt-debug-last-age-event-goal 0)
    (set-goal bt-debug-age-feudal-bank-goal 0)
    (set-goal bt-debug-age-feudal-start-goal 0)
    (set-goal bt-debug-age-feudal-complete-goal 0)
    (set-goal bt-debug-age-castle-bank-goal 0)
    (set-goal bt-debug-age-castle-start-goal 0)
    (set-goal bt-debug-age-castle-complete-goal 0)
    (set-goal bt-debug-age-imperial-bank-goal 0)
