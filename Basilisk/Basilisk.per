    (set-goal bt-telemetry-event-flags-goal 300)
    (up-modify-goal bt-telemetry-event-flags-goal g:+ bt-preempt-original-mode-goal)
    (up-get-fact game-time 0 bt-telemetry-event-time-goal)
    (set-goal bt-telemetry-event-pending-goal 1)
    (set-strategic-number sn-resource-control 0)
)
