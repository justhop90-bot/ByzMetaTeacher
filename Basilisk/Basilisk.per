    (goal bt-telemetry-event-pending-goal 1)
    (up-compare-goal bt-telemetry-count-goal < 4)
    (goal bt-telemetry-write-head-goal 2)
=>
    (up-modify-goal bt-telemetry-slot2-event-goal g:= bt-telemetry-event-type-goal)
    (up-modify-goal bt-telemetry-slot2-owner-goal g:= bt-telemetry-event-owner-goal)
    (up-modify-goal bt-telemetry-slot2-flags-goal g:= bt-telemetry-event-flags-goal)
    (up-modify-goal bt-telemetry-slot2-time-goal g:= bt-telemetry-event-time-goal)
    (up-modify-goal bt-telemetry-sequence-goal c:+ 1)
    (up-modify-goal bt-telemetry-slot2-sequence-goal g:= bt-telemetry-sequence-goal)
    (up-modify-goal bt-telemetry-count-goal c:+ 1)
    (set-goal bt-telemetry-write-head-goal 3)
    (set-goal bt-telemetry-event-pending-goal 0)
)
(defrule
    (goal bt-telemetry-event-pending-goal 1)
    (up-compare-goal bt-telemetry-count-goal < 4)
    (goal bt-telemetry-write-head-goal 3)
=>
    (up-modify-goal bt-telemetry-slot3-event-goal g:= bt-telemetry-event-type-goal)
    (up-modify-goal bt-telemetry-slot3-owner-goal g:= bt-telemetry-event-owner-goal)
    (up-modify-goal bt-telemetry-slot3-flags-goal g:= bt-telemetry-event-flags-goal)
    (up-modify-goal bt-telemetry-slot3-time-goal g:= bt-telemetry-event-time-goal)
    (up-modify-goal bt-telemetry-sequence-goal c:+ 1)
    (up-modify-goal bt-telemetry-slot3-sequence-goal g:= bt-telemetry-sequence-goal)
    (up-modify-goal bt-telemetry-count-goal c:+ 1)
    (set-goal bt-telemetry-write-head-goal 0)
    (set-goal bt-telemetry-event-pending-goal 0)
)
(defrule
    (goal bt-telemetry-event-pending-goal 1)
    (up-compare-goal bt-telemetry-count-goal >= 4)
=>
    (up-modify-goal bt-telemetry-overflow-goal c:+ 1)
    (set-goal bt-telemetry-overflow-state-goal 1)
    (set-goal bt-telemetry-event-pending-goal 0)
)

(defrule
    (timer-triggered bt-telemetry-timer)
=>
    (xs-script-call "basiliskTelemetryDrain")
    (disable-timer bt-telemetry-timer)
    (enable-timer bt-telemetry-timer 1)
)

; 14D. BYZANTINE RESOURCE ALLOCATION
;================================================================
; CONSUMES existing strategy/composition/project state. Never writes it.
; One economic mode resolves demand overlays, then one guarded allocator
; owns all four gatherer-percentage strategic numbers.
;
; Priority:
;   P0 survival -> P1 age bank -> P2 capital project
;   -> P3 military demand -> P4 base economic posture
;
; Percentages are controller tuning, not engine constants.
(defrule
    (true)
=>
    (set-goal bt-resource-mode-goal 0)
)

; P0 FOOD.
(defrule
    (goal bt-resource-mode-goal 0)
    (unit-type-count villager >= 15)
    (food-amount < 150)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-food-crisis)
)

; P0 GOLD. Low gold without an active gold consumer is not a crisis.
(defrule
    (goal bt-resource-mode-goal 0)
    (gold-amount < 100)
    (or (goal bt-cataphract-demand-goal 1) (or (and (current-age >= castle-age) (and (goal strategy-goal bt-strategy-flush) (and (goal unit-goal bt-unit-mix) (and (unit-type-count-total spearman-line >= bt-spear-target-1) (and
(up-compare-goal bt-noncav-cavalry-level-goal >= 1) (and (building-type-count-total stable >= 1) (unit-type-count-total camel-line < bt-camel-target-1))))))) (or (and (current-age == dark-age) (unit-type-count villager >=
bt-feudal-villagers)) (or (and (current-age == feudal-age) (unit-type-count villager >= bt-castle-villagers)) (and (current-age == castle-age) (unit-type-count villager >= bt-imperial-villagers))))))
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-gold-crisis)
)

; P0 WOOD. Requires a real existing wood consumer.
(defrule
    (goal bt-resource-mode-goal 0)
    (current-age >= feudal-age)
    (wood-amount < 100)
    (or (building-type-count-total farm < bt-farm-castle-cap) (or (building-type-count-total barracks >= 1) (or (building-type-count-total archery-range >= 1) (or (building-type-count-total stable >= 1) (building-type-count-total
town-center >= 2)))))
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-wood-crisis)
)

;----------------------------------------------------------------
; FEUDAL ECO WINDOW / CASTLE COMMITMENT ARBITRATION
; Compute this immediately before Castle commitment so the decision uses
; the current resource mutex and current research prerequisites.
;----------------------------------------------------------------
(defrule
    (true)
=>
    (set-goal bt-feudal-eco-hold-goal 0)
)

; Feudal eco priority. This state is evaluated immediately before Castle
; commitment so a ready Horse Collar or Double-Bit Axe blocks ownership
; of the transition.
(defrule
    (current-age == feudal-age)
    (unit-type-count villager < bt-castle-villagers)
    (goal bt-horse-collar-demand-goal 1)
    (or
        (can-research-with-escrow ri-horse-collar)
        (goal bt-research-mill-claim-goal ri-horse-collar)
    )
=>
    (set-goal bt-feudal-eco-hold-goal 1)
)

(defrule
    (current-age == feudal-age)
    (unit-type-count villager < bt-castle-villagers)
    (goal bt-double-bit-axe-demand-goal 1)
    (or
        (can-research-with-escrow ri-double-bit-axe)
        (goal bt-research-lumber-camp-claim-goal ri-double-bit-axe)
    )
=>
    (set-goal bt-feudal-eco-hold-goal 1)
)

; A first-pass DBA demand can be created later in this source file, so keep
; the direct feasibility witness as the immediate Castle-preemption fallback.
(defrule
    (current-age == feudal-age)
    (unit-type-count villager < bt-castle-villagers)
    (up-research-status c: ri-double-bit-axe == research-available)
    (food-amount >= bt-double-bit-axe-food-buffer)
    (wood-amount >= bt-double-bit-axe-wood-buffer)
    (up-compare-goal bt-research-lumber-camp-failure-backoff-goal != ri-double-bit-axe)
    (strategic-number sn-resource-control == 0)
    (building-type-count lumber-camp >= 1)
    (can-research-with-escrow ri-double-bit-axe)
    (goal bt-research-lumber-camp-claim-goal 0)
=>
    (set-goal bt-feudal-eco-hold-goal 1)
)

; P1 OPENING FAST-CASTLE BANK. This consumes opening intent but
; does not issue the age-up action.
(defrule
    (goal bt-resource-mode-goal 0)
    (current-age == feudal-age)
    (or
        (goal bt-opening-plan-goal bt-opening-plan-arabia-fast-castle)
        (goal bt-opening-plan-goal bt-opening-plan-arena-fast-castle)
    )
    (goal bt-castle-cataphract-demand-goal 0)
    (goal bt-castle-commitment-goal 0)
    (goal bt-feudal-eco-hold-goal 0)
    (not (goal bt-opening-plan-goal bt-opening-plan-anti-rush))
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-castle-bank)
    (set-goal bt-castle-commitment-goal 1)
)

; P1 AGE-UP BANKS. Existing age rules remain the action authority.
(defrule
    (goal bt-resource-mode-goal 0)
    (current-age == dark-age)
    (unit-type-count villager >= bt-feudal-villagers)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-feudal-bank)
)

(defrule
    ; HARD CASTLE OWNERSHIP BOUNDARY WHEN NO P0 CRISIS IS ACTIVE.
    ; At 30 villagers, lower-priority Feudal eco, military posture, opening
    ; labels, and transient modes no longer own the TC decision. A P0 food,
    ; gold, or wood crisis remains sovereign until resolved.
    (goal bt-resource-mode-goal 0)
    (current-age == feudal-age)
    (unit-type-count villager >= bt-castle-villagers)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-castle-bank)
    (set-goal bt-castle-commitment-goal 1)
    (set-goal train-civ-goal -1)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (strategic-number sn-resource-control == imperial-age)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-imperial-bank)
)

(defrule
    ; HARD IMPERIAL OWNERSHIP BOUNDARY WHEN NO P0 CRISIS IS ACTIVE.
    ; At 50 villagers, lower-priority Castle eco, military posture, capability
    ; projects, and transient modes no longer own the TC decision. A P0 food,
    ; gold, or wood crisis remains sovereign until resolved.
    (goal bt-resource-mode-goal 0)
    (current-age == castle-age)
    (unit-type-count villager >= bt-imperial-villagers)
    (or
        (building-type-count-total castle >= 1)
        (not
            (or
                (goal strategy-goal bt-strategy-boom)
                (goal strategy-goal bt-strategy-castle-power)
            )
        )
    )
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
    (set-goal bt-imperial-commitment-goal 1)
    (set-goal train-civ-goal -1)
)

;----------------------------------------------------------------
; IMPERIAL PREREQUISITE DEMAND / FUNDING
;----------------------------------------------------------------
; One existing qualifying Castle-age building creates a persistent demand
; for the second provider. Siege is first in source order; University
; Workshop is therefore the deterministic first choice; University remains the fallback. This state is independent of Cataphract strategy.
(defrule
    (current-age == castle-age)
    (goal bt-imperial-prereq-demand-goal 0)
    (building-type-count-total castle < 1)
    (not (can-research-with-escrow imperial-age))
    (or
        (building-type-count-total monastery >= 1)
        (or
            (building-type-count-total university >= 1)
            (building-type-count-total siege-workshop >= 1)
        )
    )
=>
    (set-goal bt-imperial-prereq-demand-goal 1)
)

; Clear prerequisite demand when the world already proves Imperial/Castle completion.
(defrule
    (goal bt-imperial-prereq-demand-goal 1)
    (or
        (current-age >= imperial-age)
        (building-type-count-total castle >= 1)
    )
=>
    (set-goal bt-imperial-prereq-demand-goal 0)
)

; Clear prerequisite demand when the engine proves Imperial is immediately researchable.
(defrule
    (goal bt-imperial-prereq-demand-goal 1)
    (can-research-with-escrow imperial-age)
=>
    (set-goal bt-imperial-prereq-demand-goal 0)
)

; Temporarily favor wood while the second Castle-age provider is outstanding.
(defrule
    ; Imperial prerequisite funding overrides age-bank arbitration, but P0
    ; resource crises retain ownership until the crisis clears.
    (current-age == castle-age)
    (goal bt-imperial-prereq-demand-goal 1)
    (building-type-count-total castle < 1)
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-food-crisis))
    (not (goal bt-resource-mode-goal bt-resource-mode-gold-crisis))
    (not (goal bt-resource-mode-goal bt-resource-mode-wood-crisis))
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-imperial-prereq)
)

;----------------------------------------------------------------
; BASILISK STRATEGIC NARRATION: CASTLE GATE
; Pure diagnostics. These rules never write strategic state.
;----------------------------------------------------------------
(defrule
    (goal bt-castle-commitment-goal 0)
    (up-compare-goal bt-debug-last-castle-block-goal != 0)
=>
    (set-goal bt-debug-last-castle-block-goal 0)
)


(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-castle-commitment-goal 1)
    (up-compare-goal bt-debug-last-castle-block-goal != bt-debug-castle-block-backoff)
    (up-compare-goal bt-research-age-failure-backoff-goal == castle-age)
=>
    (chat-local-to-self "BASILISK | AGE | Castle blocked: research backoff.")
    (set-goal bt-debug-last-castle-block-goal bt-debug-castle-block-backoff)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-castle-commitment-goal 1)
    (up-compare-goal bt-debug-last-castle-block-goal != bt-debug-castle-block-mutex)
    (up-compare-goal bt-research-age-failure-backoff-goal != castle-age)
    (strategic-number sn-resource-control != 0)
=>
    (chat-local-to-self "BASILISK | AGE | Castle blocked: resource mutex busy.")
    (set-goal bt-debug-last-castle-block-goal bt-debug-castle-block-mutex)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-castle-commitment-goal 1)
    (up-compare-goal bt-debug-last-castle-block-goal != bt-debug-castle-block-feasibility)
    (up-compare-goal bt-research-age-failure-backoff-goal != castle-age)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow castle-age))
=>
    (chat-local-to-self "BASILISK | AGE | Castle blocked: engine feasibility.")
    (set-goal bt-debug-last-castle-block-goal bt-debug-castle-block-feasibility)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-castle-commitment-goal 1)
    (up-compare-goal bt-debug-last-castle-block-goal != bt-debug-castle-block-villagers)
    (up-compare-goal bt-research-age-failure-backoff-goal != castle-age)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow castle-age)
    (unit-type-count villager < bt-castle-villagers)
=>
    (chat-local-to-self "BASILISK | AGE | Castle blocked: waiting for 30 villagers.")
    (set-goal bt-debug-last-castle-block-goal bt-debug-castle-block-villagers)
)

(defrule
    (up-compare-goal bt-debug-verbosity-goal >= 1)
    (goal bt-castle-commitment-goal 1)
    (up-compare-goal bt-debug-last-castle-block-goal != bt-debug-castle-block-ready)
    (up-compare-goal bt-research-age-failure-backoff-goal != castle-age)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow castle-age)
    (unit-type-count villager >= bt-castle-villagers)
=>
    (chat-local-to-self "BASILISK | AGE | Castle ready to research.")
    (set-goal bt-debug-last-castle-block-goal bt-debug-castle-block-ready)
)


; P2 CASTLE STONE. Stone exists only while an existing
; Castle-oriented military project has earned the stone allocation.
(defrule
    (goal bt-resource-mode-goal 0)
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (stone-amount < 650)
    (or
        (goal bt-castle-cataphract-demand-goal 1)
        (or
        (goal bt-cataphract-demand-goal 1)
        (and (goal strategy-goal bt-strategy-flush) (and (goal unit-goal bt-unit-mix) (and (unit-type-count-total spearman-line >= bt-spear-target-1) (and (up-compare-goal bt-noncav-cavalry-level-goal >= 1) (and (building-type-count-total
        stable >= 1) (unit-type-count-total camel-line < bt-camel-target-1))))))
            )
    )
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-castle-stone-premium)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (or
        (goal bt-castle-cataphract-demand-goal 1)
        (goal bt-cataphract-demand-goal 1)
    )
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (stone-amount < 650)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-castle-stone)
)

; P2 TC STONE. Consume persistent TC project state; never recreate demand here.
(defrule
    (goal bt-resource-mode-goal 0)
    (goal bt-tc-project-goal 2)
    (or
        (goal bt-tc-stage-goal bt-tc-stage-demanded)
        (or
            (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
            (or
                (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
                (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
            )
        )
    )
    (goal strategy-goal bt-strategy-boom)
    (stone-amount < 100)
    (goal bt-cataphract-demand-goal 1)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-tc-stone-premium)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (goal bt-tc-project-goal 2)
    (or
        (goal bt-tc-stage-goal bt-tc-stage-demanded)
        (or
            (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
            (or
                (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
                (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
            )
        )
    )
    (goal strategy-goal bt-strategy-boom)
    (stone-amount < 100)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-tc-stone)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (goal bt-tc-project-goal 3)
    (or
        (goal bt-tc-stage-goal bt-tc-stage-demanded)
        (or
            (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
            (or
                (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
                (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
            )
        )
    )
    (goal strategy-goal bt-strategy-boom)
    (stone-amount < 100)
    (goal bt-cataphract-demand-goal 1)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-tc-stone-premium)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (goal bt-tc-project-goal 3)
    (or
        (goal bt-tc-stage-goal bt-tc-stage-demanded)
        (or
            (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
            (or
                (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
                (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
            )
        )
    )
    (goal strategy-goal bt-strategy-boom)
    (stone-amount < 100)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-tc-stone)
)

; Imperial siege conversion keeps the existing Byzantine premium-gold posture
; active while the package owns the strategic resource-mode decision.
(defrule
    (goal bt-resource-mode-goal 0)
    (current-age == imperial-age)
    (goal bt-imperial-siege-package-goal 1)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-imperial-power)
)

; P3 PREMIUM-GOLD.
; P3 PREMIUM-GOLD.
(defrule
    (goal bt-resource-mode-goal 0)
    (or
        (goal strategy-goal bt-strategy-castle-power)
        (or
            (goal bt-varangian-demand-goal 1)
            (or
                (goal bt-bombard-cannon-demand-goal 1)
                (or
                    (goal bt-cataphract-demand-goal 1)
                    (or
                        (goal bt-research-cataphract-package-goal ri-elite-varangian-guard)
                        (and
                            (current-age >= castle-age)
                            (and
                                (goal strategy-goal bt-strategy-flush)
                                (and
                                    (goal unit-goal bt-unit-mix)
                                    (and
                                        (unit-type-count-total spearman-line >= bt-spear-target-1)
                                        (and
                                            (up-compare-goal bt-noncav-cavalry-level-goal >= 1)
                                            (and
                                                (building-type-count-total stable >= 1)
                                                (unit-type-count-total camel-line < bt-camel-target-1)
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-premium-gold)
)
; P3 CHEAP-TRASH. Existing Spear/Skirm demand drives food/wood-heavy mode.
(defrule
    (goal bt-resource-mode-goal 0)
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (or (goal unit-goal spearman-line) (or (goal unit-goal skirmisher-line) (goal unit-goal bt-unit-mix)))
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-cheap-trash)
)

; P4 BASE MODES.
(defrule
    (goal bt-resource-mode-goal 0)
    (current-age >= imperial-age)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-imperial-trash)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-castle-flush)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-boom)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-castle-boom)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (current-age == feudal-age)
    (goal strategy-goal bt-strategy-flush)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-feudal-flush)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (current-age == feudal-age)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-feudal-rush)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (current-age == dark-age)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-dark)
)

;----------------------------------------------------------------
; 14D-B. FINAL GATHERER ALLOCATION
;----------------------------------------------------------------
; Only this section owns the four gatherer-percentage SNs.
; Every write is guarded so unchanged values are not rewritten.
(defrule
    (goal bt-resource-mode-goal bt-resource-mode-dark)
    (or (not (strategic-number sn-food-gatherer-percentage == 65)) (or (not (strategic-number sn-wood-gatherer-percentage == 30)) (or (not (strategic-number sn-gold-gatherer-percentage == 5)) (not (strategic-number
sn-stone-gatherer-percentage == 0)))))
=>
    (set-strategic-number sn-food-gatherer-percentage 65)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 5)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (or
        (goal bt-resource-mode-goal bt-resource-mode-feudal-rush)
        (goal bt-resource-mode-goal bt-resource-mode-feudal-flush)
    )
    (or (not (strategic-number sn-food-gatherer-percentage == 50)) (or (not (strategic-number sn-wood-gatherer-percentage == 40)) (or (not (strategic-number sn-gold-gatherer-percentage == 10)) (not (strategic-number
sn-stone-gatherer-percentage == 0)))))
=>
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-gold-gatherer-percentage 10)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (goal bt-resource-mode-goal bt-resource-mode-castle-boom)
    (or (not (strategic-number sn-food-gatherer-percentage == 50)) (or (not (strategic-number sn-wood-gatherer-percentage == 35)) (or (not (strategic-number sn-gold-gatherer-percentage == 15)) (not (strategic-number
sn-stone-gatherer-percentage == 0)))))
=>
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 35)
    (set-strategic-number sn-gold-gatherer-percentage 15)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (goal bt-resource-mode-goal bt-resource-mode-castle-flush)
    (or (not (strategic-number sn-food-gatherer-percentage == 45)) (or (not (strategic-number sn-wood-gatherer-percentage == 40)) (or (not (strategic-number sn-gold-gatherer-percentage == 15)) (not (strategic-number
sn-stone-gatherer-percentage == 0)))))
=>
    (set-strategic-number sn-food-gatherer-percentage 45)
    (set-strategic-number sn-wood-gatherer-percentage 40)
