    (not (goal bt-resource-mode-goal bt-resource-mode-gold-crisis))
=>
    (set-goal bt-arbalest-demand-goal 1)
)
(defrule
    (goal bt-arbalest-demand-goal 1)
    (or (current-age < imperial-age) (or (not (goal unit-goal crossbowman)) (or (up-research-status c: ri-crossbow != research-complete) (or (unit-type-count-total crossbowman < bt-crossbow-target-mature) (or (not (up-research-status c:
ri-arbalest < research-pending)) (or (goal bt-bombard-cannon-demand-goal 1) (or (goal bt-resource-mode-goal bt-resource-mode-imperial-bank) (or (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep) (or (goal
bt-resource-mode-goal bt-resource-mode-food-crisis) (goal bt-resource-mode-goal bt-resource-mode-gold-crisis))))))))))
=>
    (set-goal bt-arbalest-demand-goal 0)
)
