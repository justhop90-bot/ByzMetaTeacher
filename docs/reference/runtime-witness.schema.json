{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/justhop90-bot/ByzMetaTeacher/schema/runtime-witness-v1.json",
  "title": "Byzantine runtime witness contract",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "scenario_id",
    "status",
    "artifact",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "enum": [
        "SCENARIO",
        "WITNESS"
      ]
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OPEN",
        "EXPECTED",
        "CONFIRMED",
        "REJECTED"
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "sha256_required_at_capture"
      ],
      "properties": {
        "path": {
          "const": "Byzantine.per"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha256_required_at_capture": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "match": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "map": {
          "type": [
            "string",
            "null"
          ]
        },
        "difficulty": {
          "type": [
            "string",
            "null"
          ]
        },
        "our_civ": {
          "type": [
            "string",
            "null"
          ]
        },
        "opponent_civ": {
          "type": [
            "string",
            "null"
          ]
        },
        "population": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "lifecycle_edge",
          "evidence_class",
          "rule_identities",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle_edge": {
            "type": "string",
            "minLength": 1
          },
          "evidence_class": {
            "enum": [
              "ENGINE FACT",
              "COMMUNITY PRACTICE",
              "COMPILER POLICY",
              "OPEN / UNKNOWN"
            ]
          },
          "rule_identities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "checkpoint": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "assessment",
          "game_time_seconds",
          "lifecycle_edge",
          "evidence_class",
          "observed_facts"
        ],
        "properties": {
          "game_time_seconds": {
            "type": "number",
            "minimum": 0
          },
          "lifecycle_edge": {
            "type": "string"
          },
          "evidence_class": {
            "enum": [
              "ENGINE FACT",
              "COMMUNITY PRACTICE",
              "COMPILER POLICY",
              "OPEN / UNKNOWN"
            ]
          },
          "observed_facts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "world_witness": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rule_identities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "assessment": {
            "enum": [
              "OPEN",
              "CONFIRMED",
              "FAILED"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
