    (and (map-type islands) (players-building-type-count any-ally market >= 1))
=>
    (set-goal demand-water-trade-cog-floor 1)
)

; Completion witness: water-trade-cog-floor | PENDING/ISSUED -> COMPLETE
(defrule
    (or
        (goal demand-water-trade-cog-floor 140)
        (goal demand-water-trade-cog-floor 138)
    )
    (unit-type-count 17 >= 2)
=>
    (set-goal demand-water-trade-cog-floor 139)
)

; Pending admission: water-trade-cog-floor | ISSUED/PENDING -> PENDING
(defrule
    (or
        (goal demand-water-trade-cog-floor 140)
        (goal demand-water-trade-cog-floor 138)
    )
    (not (unit-type-count 17 >= 2))
    (up-pending-objects c: 17 >= 1)
=>
    (set-goal demand-water-trade-cog-floor 138)
)

; RETRY | ISSUED/PENDING -> ACTIVE
(defrule
    (or
        (goal demand-water-trade-cog-floor 140)
        (goal demand-water-trade-cog-floor 138)
    )
    (not (unit-type-count 17 >= 2))
    (not (up-pending-objects c: 17 >= 1))
=>
    (set-goal demand-water-trade-cog-floor 1)
    (set-goal production-retry-barrier-water-trade-cog-floor 1)
)

; Action issuance: water-trade-cog-floor | ACTIVE -> ISSUED
(defrule
    (goal demand-water-trade-cog-floor 1)
    (not (unit-type-count 17 >= 2))
    (goal production-retry-barrier-water-trade-cog-floor 0)
    (not (up-pending-objects c: 17 >= 1))
    (not (unit-type-count 17 >= 2))
    (goal action-claim-train-arbitration 0)
    (current-age >= feudal-age)
    (can-train-with-escrow 17)
    (unit-type-count-total 17 < 2)
=>
    (train 17)
    (set-goal action-claim-train-arbitration 1)
    (set-goal demand-water-trade-cog-floor 140)
)