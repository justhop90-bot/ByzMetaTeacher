        (or (food-amount < 350) (or (wood-amount < 150) (gold-amount < 150)))
        (or
            (goal strategic-primary-intent 2)
            (or
                (goal opening-plan 3)
                (goal demand-castle-age-transition 1)
            )
        )
    )
    (can-build market)
    (building-type-count-total market < 1)
=>
    (build market)
    (set-goal action-claim-build-pass-singleton 1)
    (set-goal demand-economy-market-floor-1 79)
)

