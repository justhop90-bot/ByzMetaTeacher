; BYZANTINE META DEFENSE / ECONOMY EXTENSIONS
; These are native .per state channels. They deliberately reuse the existing
; demand/claim/lifecycle machinery rather than creating a second scheduler.
; -----------------------------------------------------------------------------
; Wall geometry: 0 idle, 1 acquiring points, 2 selected, 3 armed.
(defconst byzantine-wall-geometry-state 468)
(defconst byzantine-wall-tc-point 469)
(defconst byzantine-wall-castle-point 471)
(defconst byzantine-wall-keep-point 473)
(defconst byzantine-wall-bombard-point 475)
(defconst byzantine-wall-guard-point 477)
(defconst byzantine-wall-watch-point 479)
(defconst byzantine-wall-outpost-point 481)
(defconst byzantine-wall-anchor-pair 483)
(defconst byzantine-wall-pair-none 0)
(defconst byzantine-wall-pair-town-center-castle 1)
(defconst byzantine-wall-pair-town-center-keep 2)
(defconst byzantine-wall-pair-town-center-bombard-tower 3)
(defconst byzantine-wall-pair-town-center-guard-tower 4)
(defconst byzantine-wall-pair-town-center-watch-tower 5)
(defconst byzantine-wall-pair-town-center-outpost 6)
(defconst byzantine-wall-pair-castle-keep 7)
(defconst byzantine-wall-pair-castle-bombard-tower 8)
(defconst byzantine-wall-pair-castle-guard-tower 9)
