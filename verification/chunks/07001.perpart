    (goal byzantine-siege-scale byzantine-siege-scale-fortified)
    (unit-type-count-total bombard-cannon < bt-imperial-late-bombard-target)
    (gold-amount > 2500)
=>
    (set-goal demand-imperial-bombard-floor 1)
    (set-goal byzantine-surplus-spend-claim 1)
    (set-goal byzantine-surplus-spend-resource byzantine-surplus-resource-wood)
)

; Imperial farm boom is split by TC count so each native rule stays comfortably
