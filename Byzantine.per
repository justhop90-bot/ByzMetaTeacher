; Resource-centered camp placement state bootstrap.
(defrule
    (goal byzantine-resource-camp-state -1)
=>
    (set-goal byzantine-resource-camp-state byzantine-resource-camp-state-idle)
    (set-goal byzantine-resource-camp-kind 0)
    (set-goal byzantine-resource-camp-target-valid 0)
    (set-goal byzantine-resource-camp-building-kind 0)
)

(defrule
    (goal byzantine-resource-camp-building-kind -1)
=>
    (set-goal byzantine-resource-camp-building-kind 0)
)

; Native control rule: strategy-posture-initialize-000
(defrule
    (goal strategy-posture 0)
=>
    (set-goal strategy-posture 0)
    (disable-self)
)

; Native control rule: strategy-posture-transition-001
(defrule
    (and (or (goal strategy-posture 1) (goal strategy-posture 3)) (and (current-age >= castle-age) (building-type-count-total castle >= 1)))
=>
    (set-goal strategy-posture 4)
)

; Native control rule: strategy-posture-transition-002
(defrule
    (and (or (goal strategy-posture 3) (goal strategy-posture 4)) (players-unit-type-count any-enemy knight >= 3))
=>
    (set-goal strategy-posture 1)
)

; Native control rule: strategy-posture-transition-003
(defrule
    (and (goal strategy-posture 1) (players-unit-type-count any-enemy knight < 3))
=>
    (set-goal strategy-posture 3)
)

; Native control rule: strategy-posture-transition-004
(defrule
    (and (goal strategy-posture 0) (current-age == dark-age))
=>
    (set-goal strategy-posture 3)
)

; Native control rule: strategy-posture-transition-005
(defrule
    (and (goal strategy-posture 0) (current-age >= feudal-age))
=>
    (set-goal strategy-posture 3)
)

; Native control rule: strategic-arbitration-state-initialize
(defrule
    (goal strategic-primary-intent 0)
=>
    (set-goal arb-o01 0)
    (set-goal arb-o02 0)
    (set-goal arb-o03 0)
    (set-goal arb-o04 0)
    (set-goal arb-o05 0)
    (set-goal arb-o06 0)
    (set-goal arb-o07 0)
    (set-goal arb-o08 0)
    (set-goal arb-o09 0)
    (set-goal arb-c01 0)
    (set-goal arb-c02 0)
    (set-goal arb-c03 0)
    (disable-self)
)

; Native control rule: strategic-arbitration-observation-enable-strategy-water-islands
(defrule
    (goal arb-o01 0)
    (map-type islands)
=>
    (set-goal arb-o01 1)
)

; Native control rule: strategic-arbitration-observation-disable-strategy-water-islands
(defrule
    (goal arb-o01 1)
    (not (map-type islands))
=>
    (set-goal arb-o01 0)
)

; Native control rule: strategic-arbitration-observation-enable-current-feudal-age
(defrule
    (goal arb-o02 0)
    (current-age >= feudal-age)
=>
    (set-goal arb-o02 1)
)

; Native control rule: strategic-arbitration-observation-disable-current-feudal-age
(defrule
    (goal arb-o02 1)
    (not (current-age >= feudal-age))
=>
    (set-goal arb-o02 0)
)

; Native control rule: strategic-arbitration-observation-enable-castle-complete
(defrule
    (goal arb-o03 0)
    (and (current-age >= castle-age) (building-type-count-total castle >= 1))
=>
    (set-goal arb-o03 1)
)

; Native control rule: strategic-arbitration-observation-disable-castle-complete
(defrule
    (goal arb-o03 1)
    (not (and (current-age >= castle-age) (building-type-count-total castle >= 1)))
=>
    (set-goal arb-o03 0)
)

; Native control rule: strategic-arbitration-observation-enable-current-imperial-age
(defrule
    (goal arb-o04 0)
    (current-age >= imperial-age)
=>
    (set-goal arb-o04 1)
)

; Native control rule: strategic-arbitration-observation-disable-current-imperial-age
(defrule
    (goal arb-o04 1)
    (not (current-age >= imperial-age))
=>
    (set-goal arb-o04 0)
)

; Native control rule: strategic-arbitration-observation-enable-strategy-enemy-pressure
(defrule
    (goal arb-o05 0)
    (or (players-unit-type-count any-enemy knight >= 3) (or (players-unit-type-count any-enemy archer-line >= 4) (players-unit-type-count any-enemy militia-line >= 5)))
=>
    (set-goal arb-o05 1)
)

; Native control rule: strategic-arbitration-observation-disable-strategy-enemy-pressure
(defrule
    (goal arb-o05 1)
    (not (or (players-unit-type-count any-enemy knight >= 3) (or (players-unit-type-count any-enemy archer-line >= 4) (players-unit-type-count any-enemy militia-line >= 5))))
=>
    (set-goal arb-o05 0)
)

; Native control rule: strategic-arbitration-observation-enable-strategy-castle-age
(defrule
    (goal arb-o06 0)
    (current-age >= castle-age)
=>
    (set-goal arb-o06 1)
)

; Native control rule: strategic-arbitration-observation-disable-strategy-castle-age
(defrule
    (goal arb-o06 1)
    (not (current-age >= castle-age))
=>
    (set-goal arb-o06 0)
)

; Native control rule: strategic-arbitration-observation-enable-strategy-arena-map
(defrule
    (goal arb-o07 0)
    (map-type arena)
=>
    (set-goal arb-o07 1)
)

; Native control rule: strategic-arbitration-observation-disable-strategy-arena-map
(defrule
    (goal arb-o07 1)
    (not (map-type arena))
=>
    (set-goal arb-o07 0)
)

; Native control rule: strategic-arbitration-observation-enable-strategy-town-center-capability
(defrule
    (goal arb-o08 0)
    (building-type-count-total 109 < 2)
=>
    (set-goal arb-o08 1)
)

; Native control rule: strategic-arbitration-observation-disable-strategy-town-center-capability
(defrule
    (goal arb-o08 1)
    (not (building-type-count-total 109 < 2))
=>
    (set-goal arb-o08 0)
)

; Native control rule: strategic-arbitration-observation-enable-strategy-town-center-complete
(defrule
    (goal arb-o09 0)
    (building-type-count-total 109 >= 2)
=>
    (set-goal arb-o09 1)
)

; Native control rule: strategic-arbitration-observation-disable-strategy-town-center-complete
(defrule
    (goal arb-o09 1)
    (not (building-type-count-total 109 >= 2))
=>
    (set-goal arb-o09 0)
)

; Native control rule: strategic-arbitration-candidate-enable-water-investment
(defrule
    (goal arb-c01 0)
    (goal arb-o01 1)
=>
    (set-goal arb-c01 1)
)

; Native control rule: strategic-arbitration-candidate-disable-water-investment
(defrule
    (goal arb-c01 1)
    (not (goal arb-o01 1))
=>
    (set-goal arb-c01 0)
)

; Native control rule: strategic-arbitration-candidate-enable-castle-trajectory
(defrule
    (goal arb-c02 0)
    (and (and (and (goal arb-o02 1) (goal arb-o03 0)) (goal arb-o04 0)) (goal arb-o01 0))
=>
    (set-goal arb-c02 1)
)

; Native control rule: strategic-arbitration-candidate-disable-castle-trajectory
; Castle trajectory is strategic intent, not a pressure veto.
; Enemy pressure is owned by the military layer; it may delay execution but must not
; erase the Castle/boom path and strand the construction demand.
(defrule
    (goal arb-c02 1)
    (not (and (and (and (goal arb-o02 1) (goal arb-o03 0)) (goal arb-o04 0)) (goal arb-o01 0)))
=>
    (set-goal arb-c02 0)
)

; Native control rule: strategic-arbitration-candidate-enable-two-tc-expansion
(defrule
    (goal arb-c03 0)
    (and (and (and (goal arb-o06 1) (goal arb-o08 1)) (goal arb-o03 1)) (goal arb-o01 0))
=>
    (set-goal arb-c03 1)
)

; Native control rule: strategic-arbitration-candidate-disable-two-tc-expansion
(defrule
    (goal arb-c03 1)
    (not (and (and (and (goal arb-o06 1) (goal arb-o08 1)) (goal arb-o03 1)) (goal arb-o01 0)))
=>
    (set-goal arb-c03 0)
)

; Native control rule: strategic-primary-intent-select-water-investment-from-0
(defrule
    (and (goal strategic-primary-intent 0) (goal arb-c01 1))
=>
    (set-goal strategic-primary-intent 1)
)

; Native control rule: strategic-primary-intent-select-castle-trajectory-from-0
(defrule
    (and (and (goal strategic-primary-intent 0) (goal arb-c02 1)) (not (goal arb-c01 1)))
=>
    (set-goal strategic-primary-intent 2)
)

; Native control rule: strategic-primary-intent-select-two-tc-expansion-from-0
(defrule
    (and (and (and (goal strategic-primary-intent 0) (goal arb-c03 1)) (not (goal arb-c01 1))) (not (goal arb-c02 1)))
=>
    (set-goal strategic-primary-intent 3)
)

; Native control rule: strategic-primary-intent-select-two-tc-expansion-from-2
(defrule
    (and (goal strategic-primary-intent 2) (goal arb-c03 1))
=>
    (set-goal strategic-primary-intent 3)
)

; Native control rule: strategic-primary-intent-release-castle-trajectory
(defrule
    (and (and (goal strategic-primary-intent 2) (goal arb-o03 1)) (not (goal arb-c03 1)))
=>
    (set-goal strategic-primary-intent 0)
)

; Native control rule: strategic-primary-intent-invalidate-castle-trajectory
(defrule
    (and (goal strategic-primary-intent 2) (goal arb-o04 1))
=>
    (set-goal strategic-primary-intent 0)
)

; Native control rule: counter-package-selection-reset-000
(defrule
    (current-age >= dark-age)
=>
    (set-goal counter-package-siege_pressure_castle 0)
    (set-goal counter-package-mounted_pressure_castle 0)
    (set-goal counter-package-infantry_pressure_castle 0)
    (set-goal counter-package-mounted_pressure_feudal 0)
    (set-goal counter-package-ranged_pressure_feudal 0)
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-minimal)
)

; Native control rule: counter-package-selection-001-infantry_pressure_castle
(defrule
    (and (current-age >= castle-age)
         (and (goal byzantine-focus-military-pop >= 6)
              (players-unit-type-count target-player militia-line >= 5)))
=>
    (set-goal counter-package-infantry_pressure_castle 1)
)

; Native control rule: counter-package-selection-002-mounted_pressure_castle
(defrule
    (players-unit-type-count target-player knight >= 3)
=>
    (set-goal counter-package-mounted_pressure_castle 1)
)

; Native control rule: counter-package-selection-003-mounted_pressure_feudal
(defrule
    (current-age == feudal-age)
    (or
        (players-unit-type-count focus-player scout-cavalry-line >= 3)
        (players-unit-type-count target-player knight >= 1)
    )
=>
    (set-goal counter-package-mounted_pressure_feudal 1)
)

; Native control rule: counter-package-selection-004-ranged_pressure_feudal
(defrule
    (and (current-age == feudal-age)
         (players-unit-type-count target-player archer-line >= 3))
=>
    (set-goal counter-package-ranged_pressure_feudal 1)
)

; Native control rule: counter-package-selection-005-siege_pressure_castle
(defrule
    (and (current-age >= castle-age)
         (and (goal byzantine-focus-military-pop >= 6)
              (players-unit-type-count target-player mangonel-line >= 2)))
=>
    (set-goal counter-package-siege_pressure_castle 1)
)

;---------------------------------------------------------------
; PERSISTENT FEUDAL MILITARY PACKAGE ARBITRATION
; Community pattern translated into Byzantine policy:
; choose one executable Feudal package from observed enemy composition,
; then let the package's demand/recovery channels maintain the floor.
; Threat priority: mounted > ranged > infantry > anti-spear mobility.

; Standard open-land Feudal pressure starts from Archers rather than
; blindly provisioning every production building. Fast-Castle and water
; openings stay minimal unless an actual land threat is observed.
(defrule
    (current-age == feudal-age)
    (or
        (goal opening-plan 1)
        (goal opening-plan 2)
    )
    (not (players-unit-type-count any-enemy scout-cavalry-line >= 3))
    (not (players-unit-type-count any-enemy knight >= 1))
    (not (players-unit-type-count any-enemy archer-line >= 3))
    (not (players-unit-type-count any-enemy militia-line >= 5))
    (not (players-unit-type-count any-enemy spearman-line >= 4))
=>
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-archer)
)

; MAA is a supported offensive branch when sustained Barracks pressure is
; observed without a current ranged/cavalry threat. The branch then follows
; the community MAA -> Archer transition once the melee floor is reached.
(defrule
    (current-age == feudal-age)
    (goal opening-plan 1)
    (players-building-type-count any-enemy barracks >= 2)
    (players-unit-type-count any-enemy militia-line < 3)
    (players-unit-type-count any-enemy archer-line < 3)
    (players-unit-type-count any-enemy scout-cavalry-line < 3)
    (players-unit-type-count any-enemy knight < 1)
    (players-unit-type-count any-enemy spearman-line < 4)
=>
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-maa)
)

; Anti-infantry branch. Community scripting uses Archers as the standard
; switch when the opponent commits to Feudal infantry.
(defrule
    (current-age == feudal-age)
    (players-unit-type-count any-enemy militia-line >= 5)
    (players-unit-type-count any-enemy scout-cavalry-line < 3)
    (players-unit-type-count any-enemy knight < 1)
=>
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-archer)
)

; Anti-ranged branch. Byzantine cheap Skirmishers are the direct response.
(defrule
    (current-age == feudal-age)
    (players-unit-type-count any-enemy archer-line >= 3)
    (players-unit-type-count any-enemy scout-cavalry-line < 3)
    (players-unit-type-count any-enemy knight < 1)
=>
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-skirmisher)
)

; Anti-scout branch. Spears remain the hard floor, with the mobile
; Scout -> Archer package available against spear walls.
(defrule
    (current-age == feudal-age)
    (players-unit-type-count any-enemy spearman-line >= 4)
    (players-unit-type-count any-enemy scout-cavalry-line < 3)
    (players-unit-type-count any-enemy knight < 1)
    (players-unit-type-count any-enemy archer-line < 3)
=>
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-scout)
)

; Mixed mounted+ranged pressure gets the explicit cheap trash package. Pure
; mounted pressure keeps its spear-only floor instead of wasting food on skirms.
(defrule
    (current-age == feudal-age)
    (goal counter-package-mounted_pressure_feudal 1)
    (goal counter-package-ranged_pressure_feudal 1)
=>
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-trash)
)

; Fast-Castle and water openings remain minimal unless one of the explicit
; threat selectors above has already forced a response package.
(defrule
    (current-age == feudal-age)
    (or
        (goal opening-plan 3)
        (or (goal opening-plan 4) (goal opening-plan 5))
    )
    (players-unit-type-count any-enemy scout-cavalry-line < 3)
    (players-unit-type-count any-enemy archer-line < 3)
    (players-unit-type-count any-enemy militia-line < 5)
    (players-unit-type-count any-enemy spearman-line < 4)
=>
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-minimal)
)

; Package -> demand activation. Demands are reasserted persistently; the
; lifecycle itself owns completion, release, and loss recovery.
(defrule
    (current-age == feudal-age)
    (or
        (goal byzantine-feudal-army-package byzantine-feudal-package-archer)
        (or
            (goal byzantine-feudal-army-package byzantine-feudal-package-scout)
            (and
                (goal byzantine-feudal-army-package byzantine-feudal-package-maa)
                (unit-type-count-total militia-line >= bt-feudal-maa-floor)
            )
        )
    )
    (goal demand-feudal-archer-floor 0)
    (unit-type-count-total archer-line < bt-feudal-archer-floor)
=>
    (set-goal demand-feudal-archer-floor 1)
)

(defrule
    (current-age == feudal-age)
    (goal byzantine-feudal-army-package byzantine-feudal-package-scout)
    (goal demand-feudal-scout-floor 0)
    (unit-type-count-total scout-cavalry-line < bt-feudal-scout-floor)
=>
    (set-goal demand-feudal-scout-floor 1)
)

(defrule
    (current-age == feudal-age)
    (goal byzantine-feudal-army-package byzantine-feudal-package-maa)
    (goal demand-feudal-maa-upgrade 0)
    (not (research-completed ri-man-at-arms))
=>
    (set-goal demand-feudal-maa-upgrade 1)
)

(defrule
    (current-age == feudal-age)
    (goal byzantine-feudal-army-package byzantine-feudal-package-maa)
    (research-completed ri-man-at-arms)
    (goal demand-feudal-maa-floor 0)
    (unit-type-count-total militia-line < bt-feudal-maa-floor)
=>
    (set-goal demand-feudal-maa-floor 1)
)

(defrule
    (current-age == feudal-age)
    (goal byzantine-feudal-army-package byzantine-feudal-package-trash)
=>
    (set-goal demand-counter-mounted-spears 1)
    (set-goal demand-counter-ranged-skirmishers 1)
)

; Scout package and MAA package both gain ranged follow-up, matching common
; Scouts->Archers and MAA->Archers community transitions.
(defrule
    (current-age == feudal-age)
    (or
        (goal byzantine-feudal-army-package byzantine-feudal-package-scout)
        (and
            (goal byzantine-feudal-army-package byzantine-feudal-package-maa)
            (unit-type-count-total militia-line >= bt-feudal-maa-floor)
        )
    )
    (goal demand-feudal-archer-floor 0)
    (unit-type-count-total archer-line < bt-feudal-archer-floor)
=>
    (set-goal demand-feudal-archer-floor 1)
)

; Conditional infrastructure: do not spend a Feudal building on a Stable
; or Range until the selected military package actually needs it.
(defrule
    (current-age == feudal-age)
    (or
        (goal byzantine-feudal-army-package byzantine-feudal-package-archer)
        (or
            (goal byzantine-feudal-army-package byzantine-feudal-package-skirmisher)
            (or
                (goal byzantine-feudal-army-package byzantine-feudal-package-scout)
                (or
                    (goal byzantine-feudal-army-package byzantine-feudal-package-maa)
                    (goal byzantine-feudal-army-package byzantine-feudal-package-trash)
                )
            )
        )
    )
    (goal demand-castle-archery-capability 0)
    (not (building-type-count archery-range >= 1))
=>
    (set-goal demand-castle-archery-capability 1)
)

(defrule
    (current-age == feudal-age)
    (goal byzantine-feudal-army-package byzantine-feudal-package-scout)
    (goal demand-castle-stable-capability 0)
    (not (building-type-count stable >= 1))
=>
    (set-goal demand-castle-stable-capability 1)
)

