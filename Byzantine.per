; Native role rule: role-recovery-to-idle
(defrule
    (goal 161 byzantine-army-role-recovering)
    (or (goal byzantine-army-attack-ready 0) (goal byzantine-offensive-objective-claim 0))
=>
    (set-goal 161 byzantine-army-role-idle)
    (set-goal 228 0)
    (set-goal 160 0)
)

; Native role rule: role-raid-admission
(defrule
    (goal 161 byzantine-army-role-committed)
    (goal byzantine-offensive-objective-state byzantine-offensive-objective-state-production)
    (goal byzantine-fortification-threat 0)
    (up-compare-goal 198 >= bt-role-screen-floor)
    (up-compare-goal 195 >= bt-role-main-floor)
    (up-compare-goal 199 >= bt-role-siege-floor-standard)
    (up-compare-goal 197 >= bt-role-raid-floor)
    (or (unit-type-count-total knight-line >= bt-role-raid-floor) (or (unit-type-count-total camel-line >= bt-role-raid-floor) (unit-type-count-total cataphract-line >= bt-role-raid-floor)))
=>
    (up-reset-group c: 8)
    (up-full-reset-search)
    (up-set-target-point byzantine-offensive-objective-point)
    (up-filter-distance c: -1 c: 60)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-local c: 912 c: 40)
    (up-remove-objects search-local 19 != 2)
    (up-remove-objects search-local 73 != 9)
    (set-goal 194 2)
    (up-create-group 0 194 c: 8)
    (up-modify-group-flag 1 c: 8)
    (up-full-reset-search)
    (up-find-local c: -1 c: 240)
    (up-remove-objects search-local 19 != 2)
    (up-remove-objects search-local 73 != 8)
    (up-modify-group-flag 0 c: 9)
    (set-goal 228 40)
)

; Native role rule: role-raid-size-witness
(defrule
    (goal 161 byzantine-army-role-committed)
    (goal 228 40)
=>
    (up-get-group-size c: 5 198)
    (up-get-group-size c: 6 195)
    (up-get-group-size c: 7 199)
    (up-get-group-size c: 8 196)
    (set-goal 228 41)
)

; Native role rule: role-raid-commit
(defrule
    (goal 161 byzantine-army-role-committed)
    (goal 228 41)
    (up-compare-goal 196 >= bt-role-raid-floor)
    (up-compare-goal 198 >= bt-role-screen-floor)
    (up-compare-goal 195 >= bt-role-main-floor)
    (up-compare-goal 199 >= bt-role-siege-floor-standard)
=>
    (set-goal 161 byzantine-army-role-raid-split)
)

; Native role rule: role-raid-fail-rejoin
(defrule
    (goal 161 byzantine-army-role-committed)
    (goal 228 41)
    (up-compare-goal 196 < bt-role-raid-floor)
=>
    (set-goal 161 byzantine-army-role-recovering)
    (set-goal 228 0)
    (up-reset-group c: 5)
    (up-reset-group c: 6)
    (up-reset-group c: 7)
    (up-reset-group c: 8)
    (up-reset-group c: 9)
)

