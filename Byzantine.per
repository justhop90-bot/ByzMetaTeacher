    (set-goal byzantine-focus-civilian-pop 0)
    (set-goal byzantine-focus-stables 0)
    (set-goal byzantine-focus-ranges 0)
    (set-goal byzantine-focus-barracks 0)
    (set-goal byzantine-focus-siege-workshops 0)
    (set-goal byzantine-focus-castles 0)
    (set-goal byzantine-natural-food-deer-state 0)
    (set-goal byzantine-natural-food-deer-id -1)
    (set-goal byzantine-natural-food-deer-distance -1)
    (disable-self)
)

