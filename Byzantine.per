; Demand initialization
(defrule
    (true)
=>
    (set-goal demand-feudal-transition 1)
    (set-goal demand-castle-age-transition 1)
    (set-goal demand-early-defensive-spears 1)
    (set-goal demand-feudal-infrastructure 1)
    (set-goal demand-castle-commitment 0)
    (set-goal demand-counter-mounted-spears 0)
    (set-goal demand-counter-ranged-skirmishers 0)
    (set-goal demand-counter-castle-camels 0)
    (set-goal demand-counter-castle-cataphracts 0)
