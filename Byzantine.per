(defconst pending-byzantine-university-murder-holes 537)
(defconst complete-byzantine-university-murder-holes 538)
(defconst research-retry-barrier-byzantine-university-murder-holes 539)
(defconst demand-byzantine-university-treadmill-crane 540)
(defconst issued-byzantine-university-treadmill-crane 541)
(defconst pending-byzantine-university-treadmill-crane 542)
(defconst complete-byzantine-university-treadmill-crane 543)
(defconst research-retry-barrier-byzantine-university-treadmill-crane 544)
(defconst demand-byzantine-university-arrowslits 545)
(defconst issued-byzantine-university-arrowslits 546)
(defconst pending-byzantine-university-arrowslits 547)
(defconst complete-byzantine-university-arrowslits 548)
(defconst research-retry-barrier-byzantine-university-arrowslits 549)

; Native DUC execution plan
; Native DUC rule: byzantine-castle-target-knight
; The new building system is enabled once, before the bot can create any
; production foundations. This is the native community mechanism for parallel
; construction; it is not a replacement scheduler.
(defrule
    (true)
=>
    (set-strategic-number sn-enable-new-building-system 1)
    ; Mature community retry bound: avoid an unbounded construction retry loop.
    (set-strategic-number sn-number-build-attempts-before-skip 20)
    (disable-self)
)

; Byzantine construction worker policy. Two builders keep military capacity
; moving; castles get four because their stone opportunity cost justifies faster
; completion, while the global builder cap remains 200.
(defrule
    (true)
=>
    (up-assign-builders c: barracks c: 2)
    (up-assign-builders c: archery-range c: 2)
    (up-assign-builders c: stable c: 2)
    (up-assign-builders c: siege-workshop c: 3)
    (up-assign-builders c: castle c: 4)
    (disable-self)
)

(defrule
    (current-age >= castle-age)
    (up-compare-sn 227 >= 75)
    (players-unit-type-count any-enemy knight >= 3)
=>
    (up-full-reset-search)
    (up-find-remote c: 38 c: 1)
    (up-set-target-object search-remote c: 0)
    (up-get-object-data object-data-id 166)
)

; Native DUC rule: byzantine-castle-target-infantry
(defrule
    (current-age >= castle-age)
    (up-compare-sn 227 >= 75)
    (players-unit-type-count any-enemy militia-line >= 5)
=>
    (up-full-reset-search)
    (up-find-remote c: 74 c: 1)
    (up-set-target-object search-remote c: 0)
    (up-get-object-data object-data-id 165)
)

; Native relic behavior defaults. Keep the standard return path enabled so a
; Monk carrying a relic can complete the pickup-and-drop cycle instead of
; wandering indefinitely.
(defrule
    (true)
=>
    (set-strategic-number sn-relic-return-distance 255)
    (set-strategic-number sn-relic-defend-priority 1)
    (disable-self)
)

; Native DUC rule: byzantine-relic-control-init
(defrule
    (goal byzantine-relic-control-state -1)
=>
    (set-goal byzantine-relic-control-state byzantine-relic-control-idle)
    (disable-timer byzantine-relic-control-timer)
    (set-goal byzantine-monk-defense-state byzantine-monk-defense-idle)
    (disable-timer byzantine-monk-defense-heal-timer)
    (disable-timer byzantine-monk-defense-convert-timer)
)

; Relic acquisition: a single newly-trained Monk is sufficient to start the
; relic race. Relics are Gaia object 285, not Monk object 125. Reset the focus
; to Gaia for this search, then let the normal focus-setting rules own it again.
(defrule
    (current-age >= castle-age)
    (goal byzantine-relic-control-state byzantine-relic-control-idle)
    (building-type-count-total monastery >= 1)
    (unit-type-count-total monk >= 1)
    (or
        (up-timer-status byzantine-relic-control-timer c:== timer-disabled)
        (up-timer-status byzantine-relic-control-timer c:== timer-triggered)
    )
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number c:= 0)
    (up-find-remote c: relic c: 1)
    (up-set-target-object search-remote c: 0)
    (up-find-local c: monk c: 1)
    (up-target-objects 0 action-default -1 stance-defensive)
    (set-goal byzantine-relic-control-state byzantine-relic-control-acquire)
    (enable-timer byzantine-relic-control-timer bt-byzantine-relic-control-seconds)
)

; Denial: contest relics only when enemy monk pressure justifies spending monk
; movement on denial rather than routine wandering.
(defrule
    (current-age >= castle-age)
    (goal byzantine-relic-control-state byzantine-relic-control-idle)
    (building-type-count-total monastery >= 1)
    (unit-type-count-total monk >= 1)
    (players-unit-type-count any-enemy monk >= 2)
    (or
        (up-timer-status byzantine-relic-control-timer c:== timer-disabled)
        (up-timer-status byzantine-relic-control-timer c:== timer-triggered)
    )
=>
    (up-full-reset-search)
    (up-find-remote c: monk c: 1)
    (up-set-target-object search-remote c: 0)
    (up-find-local c: monk c: 1)
    (up-target-objects 0 action-default -1 stance-aggressive)
    (set-goal byzantine-relic-control-state byzantine-relic-control-deny)
    (enable-timer byzantine-relic-control-timer bt-byzantine-relic-control-seconds)
)

; Target-task expiry is a cadence reset. It is not a claim that the relic was
; acquired or denied; the next pass must observe the world again.
(defrule
    (or
        (goal byzantine-relic-control-state byzantine-relic-control-acquire)
        (goal byzantine-relic-control-state byzantine-relic-control-deny)
    )
    (timer-triggered byzantine-relic-control-timer)
=>
    (disable-timer byzantine-relic-control-timer)
    (set-goal byzantine-relic-control-state byzantine-relic-control-idle)
)



; -----------------------------------------------------------------------------
; BYZANTINE MONK DEFENSE / CONVERSION CONTROL
; Community doctrine: keep a small Castle-age Monk core, grow it under real
; defensive/siege pressure, keep it on the defensive anchor, and use Redemption
; against high-value siege/cavalry rather than wandering Monks around the map.
; -----------------------------------------------------------------------------

; Defensive Monk state activation.
(defrule
    (goal byzantine-monk-defense-state byzantine-monk-defense-idle)
    (current-age >= castle-age)
    (building-type-count-total monastery >= 1)
    (or
        (town-under-attack)
        (or
            (goal byzantine-frontier-state byzantine-frontier-state-anchored)
            (or
                (goal byzantine-frontier-state byzantine-frontier-state-wall-pending)
                (or
                    (goal byzantine-frontier-state byzantine-frontier-state-protected)
                    (players-unit-type-count any-enemy mangonel-line >= 2)
                )
            )
        )
    )
=>
    (set-goal byzantine-monk-defense-state byzantine-monk-defense-active)
    (disable-timer byzantine-monk-defense-heal-timer)
    (disable-timer byzantine-monk-defense-convert-timer)
    (enable-timer byzantine-monk-defense-heal-timer bt-byzantine-monk-defense-heal-seconds)
    (enable-timer byzantine-monk-defense-convert-timer bt-byzantine-monk-defense-convert-seconds)
)

; Drop the defensive Monk package when the pressure witness disappears.
(defrule
    (goal byzantine-monk-defense-state byzantine-monk-defense-active)
    (not
        (or
            (town-under-attack)
            (or
                (goal byzantine-frontier-state byzantine-frontier-state-anchored)
                (or
                    (goal byzantine-frontier-state byzantine-frontier-state-wall-pending)
                    (or
                        (goal byzantine-frontier-state byzantine-frontier-state-protected)
                        (players-unit-type-count any-enemy mangonel-line >= 2)
                    )
                )
            )
        )
    )
=>
    (set-goal byzantine-monk-defense-state byzantine-monk-defense-idle)
    (disable-timer byzantine-monk-defense-heal-timer)
    (disable-timer byzantine-monk-defense-convert-timer)
)

; Conditional four-Monk floor. The existing Castle Monk lifecycle owns the
; actual train command and this package reuses the same train arbitration mutex.
(defrule
    (goal demand-castle-monk-defense-floor 0)
    (goal byzantine-monk-defense-state byzantine-monk-defense-active)
    (building-type-count-total monastery >= 1)
    (unit-type-count-total monk < bt-byzantine-defense-monk-floor)
=>
    (set-goal demand-castle-monk-defense-floor 1)
)

; Invalidate unfinished defensive Monk production when the defense witness ends.
(defrule
    (or
        (goal demand-castle-monk-defense-floor 1)
        (or
            (goal demand-castle-monk-defense-floor 55)
            (goal demand-castle-monk-defense-floor 53)
        )
    )
    (goal byzantine-monk-defense-state byzantine-monk-defense-idle)
=>
    (set-goal demand-castle-monk-defense-floor 0)
)

; Monk healing posture: move the local Monk group to the live frontier anchor.
; Monks heal automatically once stationary; the Byzantine team bonus doubles
; their healing speed. This rule is cadence-limited so it does not spam pathing.
(defrule
    (goal byzantine-monk-defense-state byzantine-monk-defense-active)
    (up-compare-goal byzantine-frontier-anchor-point > 0)
    (unit-type-count-total monk >= 2)
    (or
        (up-timer-status byzantine-monk-defense-heal-timer c:== timer-disabled)
        (up-timer-status byzantine-monk-defense-heal-timer c:== timer-triggered)
    )
=>
    (up-full-reset-search)
    (up-set-target-point byzantine-frontier-anchor-point)
    (up-filter-distance c: -1 c: 16)
    (up-filter-include cmdid-monk -1 -1 -1)
    (up-find-local c: all-units-class c: 12)
    (up-target-point 0 action-move -1 stance-defensive)
    (disable-timer byzantine-monk-defense-heal-timer)
    (enable-timer byzantine-monk-defense-heal-timer bt-byzantine-monk-defense-heal-seconds)
)

; Fallback healing posture: if the frontier has no anchor yet, stage Monks at
; the actual Town Center rather than inventing a synthetic target point.
(defrule
    (goal byzantine-monk-defense-state byzantine-monk-defense-active)
    (up-compare-goal byzantine-frontier-anchor-point == 0)
    (unit-type-count-total monk >= 2)
    (or
        (up-timer-status byzantine-monk-defense-heal-timer c:== timer-disabled)
        (up-timer-status byzantine-monk-defense-heal-timer c:== timer-triggered)
    )
=>
    (up-full-reset-search)
    (up-find-local c: town-center c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object byzantine-army-reposition-point)
    (up-set-target-point byzantine-army-reposition-point)
    (up-filter-distance c: -1 c: 12)
    (up-filter-include cmdid-monk -1 -1 -1)
    (up-find-local c: all-units-class c: 12)
    (up-target-point 0 action-move -1 stance-defensive)
    (disable-timer byzantine-monk-defense-heal-timer)
    (enable-timer byzantine-monk-defense-heal-timer bt-byzantine-monk-defense-heal-seconds)
)

; Direct conversion is deliberately narrow. Only visible high-value enemy units
; are placed in the remote target list, while only nearby Monks are selected.
; action-default is native right-click behavior; with Redemption researched it
; permits the Monk to convert the selected siege/cavalry target.
(defrule
    (goal byzantine-monk-defense-state byzantine-monk-defense-active)
    (research-completed redemption)
    (unit-type-count-total monk >= 2)
    (up-compare-goal byzantine-frontier-anchor-point > 0)
    (or
        (players-unit-type-count any-enemy mangonel-line >= 1)
        (or
            (players-unit-type-count any-enemy bombard-cannon >= 1)
            (players-unit-type-count any-enemy knight-line >= 1)
        )
    )
    (or
        (up-timer-status byzantine-monk-defense-convert-timer c:== timer-disabled)
        (up-timer-status byzantine-monk-defense-convert-timer c:== timer-triggered)
    )
=>
    (up-full-reset-search)
    (up-set-target-point byzantine-frontier-anchor-point)
    (up-filter-distance c: -1 c: 12)
    (up-find-remote c: 36 c: 2)
    (up-find-remote c: 280 c: 2)
    (up-find-remote c: 283 c: 2)
    (up-find-remote c: 38 c: 2)
    (up-find-local c: all-units-class c: 4)
    (up-filter-include cmdid-monk -1 -1 -1)
    (up-target-objects 0 action-default -1 stance-aggressive)
    (disable-timer byzantine-monk-defense-convert-timer)
    (enable-timer byzantine-monk-defense-convert-timer bt-byzantine-monk-defense-convert-seconds)
)

; Monk-specific research arbitration is demand-driven rather than a blanket
; Imperial/Castle checklist.
(defrule
    (goal demand-research-redemption 0)
    (current-age >= castle-age)
    (building-type-count-total monastery >= 1)
    (unit-type-count-total monk >= 2)
    (not (research-completed redemption))
    (or
        (players-unit-type-count any-enemy mangonel-line >= 2)
        (or
            (players-unit-type-count any-enemy bombard-cannon >= 1)
            (town-under-attack)
        )
    )
=>
    (set-goal demand-research-redemption 1)
)

(defrule
    (goal demand-research-atonement 0)
    (current-age >= castle-age)
    (unit-type-count-total monk >= 2)
    (players-unit-type-count any-enemy monk >= 2)
    (not (research-completed atonement))
=>
    (set-goal demand-research-atonement 1)
)

(defrule
    (goal demand-research-theocracy 0)
    (current-age >= imperial-age)
    (unit-type-count-total monk >= 4)
    (goal byzantine-monk-defense-state byzantine-monk-defense-active)
    (research-completed redemption)
    (not (research-completed theocracy))
=>
    (set-goal demand-research-theocracy 1)
)

(defrule
    (goal demand-research-block-printing 0)
    (current-age >= imperial-age)
    (unit-type-count-total monk >= 4)
    (goal byzantine-monk-defense-state byzantine-monk-defense-active)
    (research-completed redemption)
    (or
        (players-unit-type-count any-enemy mangonel-line >= 1)
        (or
            (players-unit-type-count any-enemy bombard-cannon >= 1)
            (town-under-attack)
        )
    )
    (not (research-completed block-printing))
=>
    (set-goal demand-research-block-printing 1)
)

(defrule
    (goal demand-research-illumination 0)
    (current-age >= imperial-age)
    (unit-type-count-total monk >= 4)
    (goal byzantine-monk-defense-state byzantine-monk-defense-active)
    (research-completed redemption)
    (research-completed theocracy)
    (not (research-completed illumination))
=>
    (set-goal demand-research-illumination 1)
)

; -----------------------------------------------------------------------------
; DEFENSIVE GEOMETRY OBSERVATION / PAIR ARBITRATION

; Existing demand-adaptive-stone-wall remains the strategic owner.
; Geometry persists the selected anchor pair and reuses it after wall loss while
; both anchors survive. A destroyed anchor invalidates only that pair.
; Static score order: anchor value + pair synergy + compactness - stone cost.
; -----------------------------------------------------------------------------
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-idle)
    (goal demand-adaptive-stone-wall 1)
    (not (building-type-count 72 >= 1))
    (not (building-type-count 117 >= 1))
    (or
        (up-timer-status byzantine-wall-geometry-timer c:== timer-disabled)
        (up-timer-status byzantine-wall-geometry-timer c:== timer-triggered)
    )
    (current-age >= feudal-age)
    (up-compare-goal byzantine-wall-anchor-pair > 0)
=>
    (disable-timer byzantine-wall-geometry-timer)
    (set-goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-idle)
    (goal demand-adaptive-stone-wall 1)
    (not (building-type-count 72 >= 1))
    (not (building-type-count 117 >= 1))
    (or
        (up-timer-status byzantine-wall-geometry-timer c:== timer-disabled)
        (up-timer-status byzantine-wall-geometry-timer c:== timer-triggered)
    )
    (current-age >= feudal-age)
    (goal byzantine-wall-anchor-pair 0)
=>
    (disable-timer byzantine-wall-geometry-timer)
    (set-goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (building-type-count town-center >= 1)
=>
    (up-full-reset-search)
    (up-find-local c: town-center c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object byzantine-wall-tc-point)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (building-type-count castle >= 1)
=>
    (up-full-reset-search)
    (up-find-local c: castle c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object byzantine-wall-castle-point)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (building-type-count keep >= 1)
=>
    (up-full-reset-search)
    (up-find-local c: keep c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object byzantine-wall-keep-point)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (building-type-count bombard-tower >= 1)
=>
    (up-full-reset-search)
    (up-find-local c: bombard-tower c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object byzantine-wall-bombard-point)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (building-type-count guard-tower >= 1)
=>
    (up-full-reset-search)
    (up-find-local c: guard-tower c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object byzantine-wall-guard-point)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (building-type-count watch-tower >= 1)
=>
    (up-full-reset-search)
    (up-find-local c: watch-tower c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object byzantine-wall-watch-point)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (building-type-count outpost >= 1)
=>
    (up-full-reset-search)
    (up-find-local c: outpost c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object byzantine-wall-outpost-point)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (goal byzantine-wall-anchor-pair 0)
    (building-type-count town-center >= 1)
    (building-type-count castle >= 1)
    (current-age >= castle-age)
    (up-point-distance byzantine-wall-tc-point byzantine-wall-castle-point <= 8)
=>
    (set-goal byzantine-wall-anchor-pair byzantine-wall-pair-town-center-castle)
    (set-goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (goal byzantine-wall-anchor-pair 0)
    (building-type-count town-center >= 1)
    (building-type-count keep >= 1)
    (current-age >= castle-age)
    (up-point-distance byzantine-wall-tc-point byzantine-wall-keep-point <= 8)
=>
    (set-goal byzantine-wall-anchor-pair byzantine-wall-pair-town-center-keep)
    (set-goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (goal byzantine-wall-anchor-pair 0)
    (building-type-count castle >= 1)
    (building-type-count keep >= 1)
    (current-age >= castle-age)
    (up-point-distance byzantine-wall-castle-point byzantine-wall-keep-point <= 8)
=>
    (set-goal byzantine-wall-anchor-pair byzantine-wall-pair-castle-keep)
    (set-goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (goal byzantine-wall-anchor-pair 0)
    (building-type-count town-center >= 1)
    (building-type-count bombard-tower >= 1)
    (current-age >= castle-age)
    (up-point-distance byzantine-wall-tc-point byzantine-wall-bombard-point <= 8)
=>
    (set-goal byzantine-wall-anchor-pair byzantine-wall-pair-town-center-bombard-tower)
    (set-goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (goal byzantine-wall-anchor-pair 0)
    (building-type-count castle >= 1)
    (building-type-count bombard-tower >= 1)
    (current-age >= castle-age)
    (up-point-distance byzantine-wall-castle-point byzantine-wall-bombard-point <= 8)
=>
    (set-goal byzantine-wall-anchor-pair byzantine-wall-pair-castle-bombard-tower)
    (set-goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (goal byzantine-wall-anchor-pair 0)
    (building-type-count town-center >= 1)
    (building-type-count guard-tower >= 1)
    (current-age >= feudal-age)
    (up-point-distance byzantine-wall-tc-point byzantine-wall-guard-point <= 8)
=>
    (set-goal byzantine-wall-anchor-pair byzantine-wall-pair-town-center-guard-tower)
    (set-goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (goal byzantine-wall-anchor-pair 0)
    (building-type-count keep >= 1)
    (building-type-count bombard-tower >= 1)
    (current-age >= castle-age)
    (up-point-distance byzantine-wall-keep-point byzantine-wall-bombard-point <= 8)
=>
    (set-goal byzantine-wall-anchor-pair byzantine-wall-pair-keep-bombard-tower)
    (set-goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (goal byzantine-wall-anchor-pair 0)
    (building-type-count town-center >= 1)
    (building-type-count watch-tower >= 1)
    (current-age >= feudal-age)
    (up-point-distance byzantine-wall-tc-point byzantine-wall-watch-point <= 8)
=>
    (set-goal byzantine-wall-anchor-pair byzantine-wall-pair-town-center-watch-tower)
    (set-goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (goal byzantine-wall-anchor-pair 0)
    (building-type-count town-center >= 1)
    (building-type-count castle >= 1)
    (current-age >= castle-age)
    (up-point-distance byzantine-wall-tc-point byzantine-wall-castle-point > 8)
    (up-point-distance byzantine-wall-tc-point byzantine-wall-castle-point <= 16)
=>
    (set-goal byzantine-wall-anchor-pair byzantine-wall-pair-town-center-castle)
    (set-goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (goal byzantine-wall-anchor-pair 0)
    (building-type-count town-center >= 1)
