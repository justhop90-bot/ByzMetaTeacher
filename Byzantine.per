; Native control rule: camp-placement-buffer-and-separation
(defrule
    (or (up-compare-sn sn-allow-adjacent-dropsites != 0) (up-compare-sn sn-dropsite-separation-distance != 6))
=>
    (set-strategic-number sn-allow-adjacent-dropsites 0)
    (set-strategic-number sn-dropsite-separation-distance 6)
)

; Native control rule: camp-placement-radius-dark
(defrule
    (current-age < feudal-age)
=>
    (set-strategic-number sn-lumber-camp-max-distance 16)
    (set-strategic-number sn-mining-camp-max-distance 16)
)

; Native control rule: camp-placement-radius-feudal
(defrule
    (and (current-age >= feudal-age) (current-age < castle-age))
=>
    (set-strategic-number sn-lumber-camp-max-distance 20)
    (set-strategic-number sn-mining-camp-max-distance 20)
)

; Native control rule: camp-placement-radius-castle
(defrule
    (and (current-age >= castle-age) (current-age < imperial-age))
=>
    (set-strategic-number sn-lumber-camp-max-distance 28)
    (set-strategic-number sn-mining-camp-max-distance 28)
)

; Native control rule: camp-placement-radius-imperial
(defrule
    (current-age >= imperial-age)
=>
    (set-strategic-number sn-lumber-camp-max-distance 36)
    (set-strategic-number sn-mining-camp-max-distance 36)
)

; Native control rule: camp-placement-widen-wood
(defrule
    (or (dropsite-min-distance wood <= -1) (dropsite-min-distance wood s:>= sn-lumber-camp-max-distance))
    (strategic-number sn-lumber-camp-max-distance < 36)
=>
    (up-modify-sn sn-lumber-camp-max-distance c:+ 4)
)

; Native control rule: camp-placement-widen-gold
(defrule
    (or (dropsite-min-distance gold <= -1) (dropsite-min-distance gold s:>= sn-mining-camp-max-distance))
    (strategic-number sn-mining-camp-max-distance < 36)
=>
    (up-modify-sn sn-mining-camp-max-distance c:+ 4)
)

; Native control rule: camp-placement-widen-stone
(defrule
    (or (dropsite-min-distance stone <= -1) (dropsite-min-distance stone s:>= sn-mining-camp-max-distance))
    (strategic-number sn-mining-camp-max-distance < 36)
=>
    (up-modify-sn sn-mining-camp-max-distance c:+ 4)
)

; Native control rule: byzantine-relic-control-initialize
(defrule
    (goal byzantine-relic-control-state -1)
=>
    (set-goal byzantine-relic-control-state 0)
    (disable-timer byzantine-relic-control-timer)
    (set-strategic-number sn-focus-player-number 0)
)

; Native control rule: byzantine-relic-control-focus-gaia
(defrule
    (goal byzantine-relic-control-state 0)
=>
    (set-strategic-number sn-focus-player-number 0)
)

; Native control rule: byzantine-relic-control-mark-dispatch
(defrule
    (current-age >= castle-age)
    (goal byzantine-relic-control-state 0)
    (building-type-count-total 104 >= 1)
    (unit-type-count-total 125 >= 1)
    (unit-type-count-total 286 < 1)
    (or (up-timer-status byzantine-relic-control-timer c:== timer-disabled) (up-timer-status byzantine-relic-control-timer c:== timer-triggered))
=>
    (set-goal byzantine-relic-control-state 1)
    (enable-timer byzantine-relic-control-timer 45)
)

; Native control rule: byzantine-relic-control-pickup-witness
(defrule
    (goal byzantine-relic-control-state 1)
    (unit-type-count-total 286 >= 1)
=>
    (set-goal byzantine-relic-control-state 2)
    (disable-timer byzantine-relic-control-timer)
)

; Native control rule: byzantine-relic-control-resume-carrier
(defrule
    (goal byzantine-relic-control-state 0)
    (unit-type-count-total 286 >= 1)
=>
    (set-goal byzantine-relic-control-state 2)
)

; Native control rule: byzantine-relic-control-start-return
(defrule
    (goal byzantine-relic-control-state 2)
    (unit-type-count-total 286 >= 1)
    (building-type-count-total 104 >= 1)
    (up-timer-status byzantine-relic-control-timer c:== timer-disabled)
=>
    (enable-timer byzantine-relic-control-timer 45)
)

; Native control rule: byzantine-relic-control-carrier-loss-recovery
(defrule
    (goal byzantine-relic-control-state 2)
    (unit-type-count-total 286 < 1)
=>
    (disable-timer byzantine-relic-control-timer)
    (set-goal byzantine-relic-control-state 0)
)

; Native control rule: byzantine-relic-control-expiry
(defrule
    (or (goal byzantine-relic-control-state 1) (goal byzantine-relic-control-state 2))
    (timer-triggered byzantine-relic-control-timer)
=>
    (disable-timer byzantine-relic-control-timer)
    (set-goal byzantine-relic-control-state 0)
)

