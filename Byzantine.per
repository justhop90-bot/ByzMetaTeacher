; Native control rule: byzantine-opening-bootstrap
; Extended goals default to -1; initialize only the Byzantine state slots that
; require a concrete zero-state before their consumers can run.
(defrule
    (true)
=>
    (set-goal byzantine-resource-claim 0)
    (set-goal byzantine-scout-phase 0)
    (set-goal byzantine-scout-focus-player 0)
    (set-goal byzantine-scout-search-state 0)
    (set-goal 383 0)
    (set-goal 384 0)
    (set-goal 385 0)
    (set-goal byzantine-scout-sighted-stable 0)
    (set-goal byzantine-scout-sighted-range 0)
    (set-goal byzantine-scout-sighted-barracks 0)
    (set-goal byzantine-scout-sighted-siege 0)
    (set-goal byzantine-scout-wood-point 0)
    (set-goal 391 0)
    (set-goal byzantine-scout-gold-point 0)
    (set-goal 393 0)
    (disable-timer byzantine-scout-intel-timer)
    (set-goal strategic-primary-intent 0)
    (set-goal byzantine-natural-food-state byzantine-natural-food-stable)
    (set-goal demand-economy-barracks-floor-1 1)
    (disable-self)
)

; Native control rule: opening-selector-water-control
(defrule
