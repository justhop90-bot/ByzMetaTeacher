; Native DUC rule: byzantine-relic-control-acquire
(defrule
    (current-age >= castle-age)
    (goal byzantine-relic-control-state 0)
    (building-type-count-total 104 >= 1)
    (unit-type-count-total 125 >= 1)
    (unit-type-count-total 286 < 1)
    (up-gaia-type-count-total c: 285 > 0)
    (up-timer-status byzantine-relic-control-timer c:== timer-disabled)
=>
    (up-full-reset-search)
    (up-find-remote c: 285 c: 1)
    (up-set-target-object search-remote c: 0)
    (up-find-local c: 125 c: 1)
    (up-target-objects 0 0 -1 stance-defensive)
)

; Native DUC rule: byzantine-relic-control-pickup-witness
(defrule
    (goal byzantine-relic-control-state 1)
=>
    (up-find-local c: 286 c: 1)
)

; Native DUC rule: byzantine-relic-control-return
(defrule
    (goal byzantine-relic-control-state 2)
    (unit-type-count-total 286 >= 1)
    (building-type-count-total 104 >= 1)
    (up-timer-status byzantine-relic-control-timer c:== timer-disabled)
=>
    (up-full-reset-search)
    (up-find-local c: 104 c: 1)
    (up-set-target-object search-local c: 0)
    (up-find-local c: 286 c: 1)
    (up-target-objects 0 0 -1 stance-defensive)
)

; Native DUC rule: byzantine-relic-control-release-witness
(defrule
