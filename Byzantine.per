;----------------------------------------------------------------
; PROFESSIONAL BYZANTINE UNIVERSITY RESEARCH LIFECYCLES
;----------------------------------------------------------------
; Native tech IDs are pinned to the current Byzantine factual inventory:
;   Fortified Wall 194, Guard Tower 140, Ballistics 93, Murder Holes 322,
;   Treadmill Crane 54, Arrowslits 608.
; Research is serialized by byzantine-university-research-claim. Native
; research status remains the only pending truth; completion remains
; research-completed.

; Fortified Wall: harden an actual stone perimeter.
(defrule
    (goal demand-byzantine-university-fortified-wall 523)
    (research-completed 194)
=>
    (set-goal demand-byzantine-university-fortified-wall 0)
)
(defrule
    (or
        (goal demand-byzantine-university-fortified-wall 521)
        (goal demand-byzantine-university-fortified-wall 522)
    )
    (research-completed 194)
=>
    (set-goal demand-byzantine-university-fortified-wall 523)
)
(defrule
    (or
        (goal demand-byzantine-university-fortified-wall 521)
        (goal demand-byzantine-university-fortified-wall 522)
    )
    (not (research-completed 194))
    (up-research-status c: 194 >= 2)
=>
    (set-goal demand-byzantine-university-fortified-wall 522)
)
(defrule
    (or
        (goal demand-byzantine-university-fortified-wall 521)
        (goal demand-byzantine-university-fortified-wall 522)
    )
    (not (research-completed 194))
    (not (up-research-status c: 194 >= 2))
=>
    (set-goal demand-byzantine-university-fortified-wall 520)
    (set-goal research-retry-barrier-byzantine-university-fortified-wall 524)
)
(defrule
    (goal demand-byzantine-university-fortified-wall 520)
    (not (research-completed 194))
    (goal research-retry-barrier-byzantine-university-fortified-wall 0)
    (goal byzantine-university-research-claim 0)
    (not (up-research-status c: 194 >= 2))
    (building-type-count university >= 1)
    (or
        (goal byzantine-university-state byzantine-university-state-hardened-perimeter)
        (goal byzantine-university-state byzantine-university-state-tower-network)
    )
    (or
        (goal byzantine-wall-resource-state byzantine-wall-resource-secured)
        (or
            (goal byzantine-frontier-state byzantine-frontier-state-protected)
            (or
                (building-type-count 117 >= 2)
                (and
                    (wall-completed-percentage byzantine-wall-native-perimeter >= 42)
                    (gate-count byzantine-wall-native-perimeter >= 1)
                )
            )
        )
    )
    (can-research-with-escrow ri-fortified-wall)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-fortified-wall)
    (set-goal byzantine-university-research-claim 1)
    (set-goal demand-byzantine-university-fortified-wall 521)
)

