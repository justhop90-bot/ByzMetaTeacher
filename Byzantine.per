; Native control rule: opening-selector-water-control
(defrule
    (and (goal opening-plan -1) (and (map-type islands) (or (players-unit-type-count any-enemy galley-line >= 2) (players-unit-type-count any-enemy fire-galley-line >= 2))))
=>
    (set-goal opening-plan 5)
)

; Native control rule: opening-selector-water-economy
(defrule
    (and (goal opening-plan -1) (and (map-type islands) (not (or (players-unit-type-count any-enemy galley-line >= 2) (players-unit-type-count any-enemy fire-galley-line >= 2)))))
=>
    (set-goal opening-plan 4)
)

; Native control rule: opening-selector-fast-castle
(defrule
    (and (goal opening-plan -1) (and (map-type arena) (not (or (players-unit-type-count any-enemy knight >= 3) (or (players-unit-type-count any-enemy archer-line >= 4) (players-unit-type-count any-enemy militia-line >= 5))))))
=>
    (set-goal opening-plan 3)
)

; Native control rule: opening-selector-counter-feudal
(defrule
    (and (goal opening-plan -1)
         (and (not (map-type arena))
              (or (players-unit-type-count any-enemy knight >= 3)
                  (or (players-unit-type-count any-enemy archer-line >= 4)
                      (players-unit-type-count any-enemy militia-line >= 5)))))
=>
    (set-goal opening-plan 2)
)

; Native control rule: opening-selector-fast-castle-standard-land
(defrule
    (and (goal opening-plan -1)
         (and (not (map-type arena))
              (not (or (players-unit-type-count any-enemy knight >= 3) (or (players-unit-type-count any-enemy archer-line >= 4) (players-unit-type-count any-enemy militia-line >= 5))))))
=>
    (set-goal opening-plan 3)
)

; Native control rule: opening-selector-defensive-standard-arabia
(defrule
    (and (goal opening-plan -1)
         (and (map-type arabia)
              (not (or (players-unit-type-count any-enemy knight >= 3)
                       (or (players-unit-type-count any-enemy archer-line >= 4)
                           (players-unit-type-count any-enemy militia-line >= 5))))))
=>
    (set-goal opening-plan 1)
)

; Native economy rule: byzantine-community-economy-initialize
(defrule
    (true)
=>
    (set-strategic-number sn-intelligent-gathering 1)
    (set-strategic-number sn-retask-gather-amount 0)
    (set-strategic-number sn-livestock-to-town-center 1)
    (set-strategic-number sn-wild-animal-exploration 1)
    (set-strategic-number sn-maximum-hunt-drop-distance 32)
    (set-strategic-number sn-maximum-food-drop-distance 16)
    (set-strategic-number sn-preferred-mill-placement 1)
    (set-strategic-number sn-boar-lure-destination 0)
    (set-strategic-number sn-maximum-wood-drop-distance 16)
    (set-strategic-number sn-maximum-gold-drop-distance 16)
    ; Keep automatic repair on critical structures, siege, houses, towers, walls, and gates.
    ; AIRef defines sn-object-repair-level as a bitmask: 1 critical castle/monastery,
    ; 2 town center, 4 barracks, 2048 houses, 4096 towers, 8192 walls/gates,
    ; and 16384 siege. 30727 selects that defensive shell plus siege.
    (set-strategic-number sn-object-repair-level 30727)
    ; Naga-style wall controls: target nearby walls/gates, raise the civilian builder cap,
    ; and select palisade gates by default. Stone perimeter rules switch gate type to 0.
    (set-strategic-number sn-wall-targeting-mode 1)
    (set-strategic-number sn-cap-civilian-builders 200)
    (set-strategic-number sn-gate-type-for-wall 1)
    (disable-self)
)

; Native economy rule: byzantine-boar-lure-enable
(defrule
    (current-age == dark-age)
    (not (map-type islands))
    (unit-type-count-total villager >= 9)
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 32)
=>
    (set-strategic-number sn-enable-boar-hunting 2)
    (set-strategic-number sn-minimum-boar-lure-group-size 1)
    (set-strategic-number sn-minimum-boar-hunt-group-size 1)
    (set-strategic-number sn-minimum-number-hunters 1)
    (set-strategic-number sn-maximum-hunt-drop-distance 32)
    (up-retask-gatherers food c: 1)
    (up-request-hunters c: 1)
)

; Native economy rule: byzantine-boar-lure-support
(defrule
    (current-age == dark-age)
    (not (map-type islands))
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 16)
    (strategic-number sn-enable-boar-hunting >= 1)
=>
    (set-strategic-number sn-minimum-number-hunters 2)
    (set-strategic-number sn-minimum-boar-hunt-group-size 2)
    (up-retask-gatherers food c: 1)
    (up-request-hunters c: 1)
)

; Native economy rule: byzantine-boar-hunt-group
(defrule
    (current-age == dark-age)
    (not (map-type islands))
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 10)
    (strategic-number sn-enable-boar-hunting >= 1)
    (unit-type-count villager-hunter < 7)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 7)
    (set-strategic-number sn-minimum-number-hunters 7)
    (up-retask-gatherers food c: 1)
    (up-request-hunters c: 6)
)

; Native economy rule: byzantine-boar-second-lure
(defrule
    (strategic-number sn-enable-boar-hunting == 2)
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 32)
    (dropsite-min-distance boar-hunting >= 0)
    (dropsite-min-distance boar-hunting <= 10)
    (up-remaining-boar-amount < 195)
    (strategic-number sn-minimum-number-hunters > 2)
=>
    (set-strategic-number sn-minimum-number-hunters 1)
    (set-strategic-number sn-minimum-boar-hunt-group-size 1)
    (set-strategic-number sn-minimum-boar-lure-group-size 1)
    (up-retask-gatherers food c: 1)
    (up-request-hunters c: 1)
)

; Native economy rule: byzantine-boar-hunt-release-feudal-transition
(defrule
    (current-age >= feudal-age)
    (goal byzantine-natural-food-state byzantine-natural-food-transition)
=>
    (set-strategic-number sn-enable-boar-hunting 1)
    (set-strategic-number sn-minimum-boar-lure-group-size 0)
    (set-strategic-number sn-minimum-boar-hunt-group-size 0)
    (set-strategic-number sn-minimum-number-hunters 0)
)

; Native economy rule: byzantine-boar-hunt-release-distance
(defrule
    (dropsite-min-distance live-boar > 32)
=>
    (set-strategic-number sn-enable-boar-hunting 1)
    (set-strategic-number sn-minimum-boar-lure-group-size 0)
    (set-strategic-number sn-minimum-boar-hunt-group-size 0)
    (set-strategic-number sn-minimum-number-hunters 0)
)

; Native economy rule: byzantine-boar-hunt-release-none
(defrule
    (dropsite-min-distance live-boar <= -1)
=>
    (set-strategic-number sn-enable-boar-hunting 1)
    (set-strategic-number sn-minimum-boar-lure-group-size 0)
    (set-strategic-number sn-minimum-boar-hunt-group-size 0)
    (set-strategic-number sn-minimum-number-hunters 0)
)

;---------------------------------------------------------------
;---------------------------------------------------------------
; TARGET PLAYER + FOCUS PROFILE PLANE
;---------------------------------------------------------------
; Focus-player is observation context. Target-player is the persistent offensive
; identity. They may synchronize, but one is never silently treated as the other.

(defrule
    (or
        (strategic-number sn-target-player-number <= 0)
        (or
            (strategic-number sn-target-player-number >= 9)
            (or
                (not (player-in-game target-player))
                (stance-toward target-player ally)
            )
        )
    )
=>
    (set-strategic-number sn-target-player-number 0)
    (set-goal byzantine-target-player-lock 0)
)

(defrule
    (strategic-number sn-target-player-number <= 0)
    (strategic-number sn-focus-player-number >= 1)
    (strategic-number sn-focus-player-number <= 8)
    (player-in-game focus-player)
    (not (stance-toward focus-player ally))
=>
    (up-modify-sn sn-target-player-number s:= sn-focus-player-number)
)

(defrule
    (goal byzantine-scout-phase >= 2)
    (strategic-number sn-target-player-number >= 1)
    (strategic-number sn-target-player-number <= 8)
    (player-in-game target-player)
    (not (stance-toward target-player ally))
    (strategic-number sn-focus-player-number s:!= sn-target-player-number)
=>
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
)

(defrule
    (goal byzantine-target-player-lock 0)
    (or
        (goal byzantine-army-attack-ready 1)
        (goal byzantine-army-attack-ready 2)
    )
    (strategic-number sn-target-player-number >= 1)
    (strategic-number sn-target-player-number <= 8)
    (player-in-game target-player)
    (not (stance-toward target-player ally))
=>
    (set-goal byzantine-target-player-lock 1)
)

(defrule
    (goal byzantine-target-player-lock 1)
    (or
        (goal byzantine-army-attack-ready 1)
        (goal byzantine-army-attack-ready 2)
    )
    (strategic-number sn-target-player-number >= 1)
    (strategic-number sn-target-player-number <= 8)
    (player-in-game target-player)
    (not (stance-toward target-player ally))
    (strategic-number sn-focus-player-number s:!= sn-target-player-number)
=>
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
)

(defrule
    (goal byzantine-target-player-lock 1)
    (goal byzantine-army-attack-ready 0)
=>
    (set-goal byzantine-target-player-lock 0)
)

(defrule
    (strategic-number sn-focus-player-number >= 1)
    (strategic-number sn-focus-player-number <= 8)
    (player-in-game focus-player)
=>
    (up-get-focus-fact military-population 0 byzantine-focus-military-pop)
    (up-get-focus-fact civilian-population 0 byzantine-focus-civilian-pop)
    (up-get-focus-fact building-type-count stable byzantine-focus-stables)
    (up-get-focus-fact building-type-count archery-range byzantine-focus-ranges)
    (up-get-focus-fact building-type-count barracks byzantine-focus-barracks)
    (up-get-focus-fact building-type-count siege-workshop byzantine-focus-siege-workshops)
    (up-get-focus-fact building-type-count castle byzantine-focus-castles)
)

; Building intent is now usable as corroborating enemy evidence, not a substitute
; for actual unit-count observations.
(defrule
    (current-age == feudal-age)
    (goal byzantine-focus-ranges >= 2)
=>
    (set-goal counter-package-ranged_pressure_feudal 1)
)

(defrule
    (current-age >= castle-age)
    (goal byzantine-focus-stables >= 2)
=>
    (set-goal counter-package-mounted_pressure_castle 1)
)

(defrule
    (current-age >= castle-age)
    (goal byzantine-focus-siege-workshops >= 1)
=>
    (set-goal counter-package-siege_pressure_castle 1)
)

(defrule
    (current-age >= castle-age)
    (goal byzantine-focus-military-pop >= 6)
    (players-unit-type-count target-player militia-line >= 5)
=>
    (set-goal counter-package-infantry_pressure_castle 1)
)

; NATIVE NATURAL-FOOD DEER CONTROLLER
(defrule
    (goal byzantine-natural-food-deer-state 0)
    (current-age == dark-age)
    (not (map-type islands))
    (unit-type-count scout-cavalry-line >= 1)
    (resource-found food)
    (or
        (up-timer-status byzantine-natural-food-deer-timer c:== timer-disabled)
        (up-timer-status byzantine-natural-food-deer-timer c:== timer-triggered)
    )
=>
    (up-full-reset-search)
    (up-filter-distance c: -1 c: 40)
    (up-find-resource c: deer-class c: 40)
    (disable-timer byzantine-natural-food-deer-timer)
    (set-goal byzantine-natural-food-deer-state 1)
)

(defrule
    (goal byzantine-natural-food-deer-state 1)
    (up-set-target-object search-remote c: 0)
=>
    (up-get-object-data object-data-id byzantine-natural-food-deer-id)
    (up-get-point position-self byzantine-natural-food-deer-home-point)
    (up-get-point position-object byzantine-natural-food-deer-point)
    (up-get-point-distance byzantine-natural-food-deer-home-point byzantine-natural-food-deer-point byzantine-natural-food-deer-distance)
    (set-goal byzantine-natural-food-deer-state 2)
)

(defrule
    (goal byzantine-natural-food-deer-state 1)
    (not (up-set-target-object search-remote c: 0))
=>
    (set-goal byzantine-natural-food-deer-state 0)
    (enable-timer byzantine-natural-food-deer-timer bt-byzantine-natural-food-deer-seconds)
)

(defrule
    (goal byzantine-natural-food-deer-state 2)
    (up-set-target-by-id g: byzantine-natural-food-deer-id)
    (up-compare-goal byzantine-natural-food-deer-distance <= 3400)
    (current-age <= feudal-age)
=>
    ; Retask the scout and nearby food villagers through the existing DUC path.
    (set-strategic-number sn-maximum-hunt-drop-distance 34)
    (up-get-point position-object byzantine-natural-food-deer-point)

    (up-full-reset-search)
    (up-find-local c: scout-cavalry-line c: 1)
    (up-set-target-point byzantine-natural-food-deer-point)
    (up-target-objects 0 action-move -1 stance-defensive)

    (up-full-reset-search)
    (up-filter-distance c: -1 c: 20)
    (up-filter-exclude -1 actionid-attack orderid-build -1)
    (up-find-local c: villager-class g: villager-count)
    (up-remove-objects search-local object-data-gather-type != food)
    (up-remove-objects search-local object-data-tasks-count >= 1)
    (up-set-target-point byzantine-natural-food-deer-point)
    (up-target-objects 1 action-default -1 -1)

    (set-goal byzantine-natural-food-deer-state 3)
    (enable-timer byzantine-natural-food-deer-timer bt-byzantine-natural-food-deer-seconds)
)

(defrule
    (goal byzantine-natural-food-deer-state 2)
    (or
        (not (up-set-target-by-id g: byzantine-natural-food-deer-id))
        (or
            (goal byzantine-natural-food-deer-distance > 3400)
            (current-age > feudal-age)
        )
    )
=>
    (set-goal byzantine-natural-food-deer-id -1)
    (set-goal byzantine-natural-food-deer-distance -1)
    (set-goal byzantine-natural-food-deer-state 0)
    (set-strategic-number sn-maximum-hunt-drop-distance -1)
)

(defrule
    (goal byzantine-natural-food-deer-state 3)
    (up-timer-status byzantine-natural-food-deer-timer c:== timer-triggered)
    (up-set-target-by-id g: byzantine-natural-food-deer-id)
    (current-age <= feudal-age)
    (building-type-count-total mill < 2)
=>
    (up-get-point position-object byzantine-natural-food-deer-point)
    (up-full-reset-search)
    (up-filter-distance c: -1 c: 20)
    (up-filter-exclude -1 actionid-attack orderid-build -1)
    (up-find-local c: villager-class g: villager-count)
    (up-remove-objects search-local object-data-gather-type != food)
    (up-remove-objects search-local object-data-tasks-count >= 1)
    (up-set-target-point byzantine-natural-food-deer-point)
    (up-target-objects 1 action-default -1 -1)
    (enable-timer byzantine-natural-food-deer-timer bt-byzantine-natural-food-deer-seconds)
)

(defrule
    (goal byzantine-natural-food-deer-state 3)
    (or
        (not (up-set-target-by-id g: byzantine-natural-food-deer-id))
        (or
            (building-type-count-total mill >= 2)
            (or
                (current-age >= castle-age)
                (or
                    (up-object-data object-data-status != status-ready)
                    (up-object-data object-data-hitpoints <= 0)
                )
            )
        )
    )
=>
    (set-goal byzantine-natural-food-deer-state 0)
    (set-goal byzantine-natural-food-deer-id -1)
    (set-goal byzantine-natural-food-deer-distance -1)
    (set-strategic-number sn-maximum-hunt-drop-distance -1)
    (enable-timer byzantine-natural-food-deer-timer bt-byzantine-natural-food-deer-seconds)
)

; NATIVE FOOD RESOURCE SELECTOR
; Side-state for mill placement. The demand goal retains construction ownership.
(defrule
    (goal demand-economy-food-mill-feudal-berries 1)
    (goal byzantine-food-source-selector 0)
    (current-age == feudal-age)
    (building-type-count-total mill == 1)
    (resource-found food)
=>
    (up-full-reset-search)
    (up-filter-distance c: -1 c: 16)
    (up-find-resource c: forage-bush-class c: 16)
    (set-goal byzantine-food-source-selector 1)
)

(defrule
    (goal byzantine-food-source-selector 1)
    (up-set-target-object search-remote c: 0)
=>
    (set-strategic-number sn-preferred-mill-placement 0)
    (set-goal byzantine-food-source-selector 0)
)

(defrule
    (goal byzantine-food-source-selector 1)
    (not (up-set-target-object search-remote c: 0))
=>
    (up-full-reset-search)
    (up-filter-distance c: -1 c: 16)
    (up-find-resource c: deer-class c: 16)
    (set-goal byzantine-food-source-selector 2)
)

(defrule
    (goal byzantine-food-source-selector 2)
    (up-set-target-object search-remote c: 0)
=>
    (set-strategic-number sn-preferred-mill-placement 1)
    (set-goal byzantine-food-source-selector 0)
)

(defrule
    (goal byzantine-food-source-selector 2)
    (not (up-set-target-object search-remote c: 0))
=>
    (set-strategic-number sn-preferred-mill-placement 0)
    (set-goal byzantine-food-source-selector 0)
)

(defrule
    (goal byzantine-food-source-selector 0)
    (or
        (goal demand-economy-food-mill-feudal-berries 0)
        (goal demand-economy-food-mill-feudal-berries 702)
        (goal demand-economy-food-mill-feudal-berries 701)
    )
=>
    (set-strategic-number sn-preferred-mill-placement 0)
)

;---------------------------------------------------------------
; PRO SCOUTING / NAGA INFORMATION LOOP
;---------------------------------------------------------------
; Doctrine:
;   Dark: the starting Scout owns local exploration and the economy does not
;         pay a civilian-explorer tax while that Scout exists.
;   Feudal: convert the Scout from generic exploration into a repeatable intel
;           route: enemy anchor -> wood -> gold -> production intent.
;   Castle/Imperial: keep revisiting enemy intent. Scouting is not a one-shot
;           opening action; it is persistent observation feeding arbitration.
;   Raid geometry is retained as typed point state for later military execution.
; Timer is cadence only. Search-result counts are the actual observation witness.

; Native scouting ownership: no civilian explorer while the Scout is alive.
(defrule
    (unit-type-count scout-cavalry-line >= 1)
    (strategic-number sn-cap-civilian-explorers != 0)
=>
    (set-strategic-number sn-percent-civilian-explorers 0)
    (set-strategic-number sn-cap-civilian-explorers 0)
)

; Native scouting recovery: permit exactly one civilian fallback when the real
; Scout is gone during the information-critical land game.
(defrule
    (current-age < imperial-age)
    (not (map-type islands))
    (not (unit-type-count scout-cavalry-line >= 1))
    (strategic-number sn-cap-civilian-explorers == 0)
=>
    (set-strategic-number sn-percent-civilian-explorers 100)
    (set-strategic-number sn-cap-civilian-explorers 1)
)

; Native scouting ownership restoration: Scout return closes the civilian
; fallback again.
(defrule
    (unit-type-count scout-cavalry-line >= 1)
    (strategic-number sn-cap-civilian-explorers == 1)
=>
    (set-strategic-number sn-percent-civilian-explorers 0)
    (set-strategic-number sn-cap-civilian-explorers 0)
)

; Dark Age: preserve the existing native flank exploration pattern.
(defrule
    (goal byzantine-scout-phase 0)
    (current-age == dark-age)
    (not (map-type islands))
    (unit-type-count scout-cavalry-line >= 1)
=>
    (up-send-scout group-type-land-explore scout-flank)
    (set-goal byzantine-scout-phase 1)
)

; Feudal handoff: reassert native flank exploration once, then begin the
; persistent information loop after the scout has had a chance to travel.
(defrule
    (or
        (goal byzantine-scout-phase 0)
        (goal byzantine-scout-phase 1)
    )