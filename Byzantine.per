)

; Native economy rule: byzantine-community-economy-initialize
(defrule
    (true)
=>
    (set-strategic-number sn-intelligent-gathering 1)
    (set-strategic-number sn-retask-gather-amount 0)
    (set-strategic-number sn-livestock-to-town-center 1)
    (set-strategic-number sn-wild-animal-exploration 1)
    (set-strategic-number sn-maximum-hunt-drop-distance 32)
    (set-strategic-number sn-maximum-food-drop-distance 16)
    (set-strategic-number sn-preferred-mill-placement 1)
    (set-strategic-number sn-boar-lure-destination 0)
    (set-strategic-number sn-maximum-wood-drop-distance 16)
    (set-strategic-number sn-maximum-gold-drop-distance 16)
    ; Keep automatic repair on critical structures, siege, houses, towers, walls, and gates.
    ; AIRef defines sn-object-repair-level as a bitmask: 1 critical castle/monastery,
    ; 2 town center, 4 barracks, 2048 houses, 4096 towers, 8192 walls/gates,
    ; and 16384 siege. 30727 selects that defensive shell plus siege.
    (set-strategic-number sn-object-repair-level 30727)
    ; Naga-style wall controls: target nearby walls/gates, raise the civilian builder cap,
    ; and select palisade gates by default. Stone perimeter rules switch gate type to 0.
    (set-strategic-number sn-wall-targeting-mode 1)
    (set-strategic-number sn-cap-civilian-builders 200)
    (set-strategic-number sn-gate-type-for-wall 1)
    (disable-self)
)

; Native economy rule: byzantine-boar-lure-enable
(defrule
    (current-age == dark-age)
    (not (map-type islands))
    (unit-type-count-total villager >= 9)
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 32)
=>
    (set-strategic-number sn-enable-boar-hunting 2)
    (set-strategic-number sn-minimum-boar-lure-group-size 1)
    (set-strategic-number sn-minimum-boar-hunt-group-size 1)
    (set-strategic-number sn-minimum-number-hunters 1)
    (set-strategic-number sn-maximum-hunt-drop-distance 32)
    (up-retask-gatherers food c: 1)
    (up-request-hunters c: 1)
)

; Native economy rule: byzantine-boar-lure-support
(defrule
    (current-age == dark-age)
    (not (map-type islands))
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 16)
    (strategic-number sn-enable-boar-hunting >= 1)
=>
    (set-strategic-number sn-minimum-number-hunters 2)
    (set-strategic-number sn-minimum-boar-hunt-group-size 2)
    (up-retask-gatherers food c: 1)
    (up-request-hunters c: 1)
)

; Native economy rule: byzantine-boar-hunt-group
(defrule
    (current-age == dark-age)
    (not (map-type islands))
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 10)
    (strategic-number sn-enable-boar-hunting >= 1)
    (unit-type-count villager-hunter < 7)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 7)
    (set-strategic-number sn-minimum-number-hunters 7)
    (up-retask-gatherers food c: 1)
    (up-request-hunters c: 6)
)

; Native economy rule: byzantine-boar-second-lure
(defrule
    (strategic-number sn-enable-boar-hunting == 2)
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 32)
    (dropsite-min-distance boar-hunting >= 0)
    (dropsite-min-distance boar-hunting <= 10)
    (up-remaining-boar-amount < 195)
    (strategic-number sn-minimum-number-hunters > 2)
=>
    (set-strategic-number sn-minimum-number-hunters 1)
    (set-strategic-number sn-minimum-boar-hunt-group-size 1)
    (set-strategic-number sn-minimum-boar-lure-group-size 1)
    (up-retask-gatherers food c: 1)
    (up-request-hunters c: 1)
)

; Native economy rule: byzantine-boar-hunt-release-feudal-transition
(defrule
    (current-age >= feudal-age)
    (goal byzantine-natural-food-state byzantine-natural-food-transition)
=>
    (set-strategic-number sn-enable-boar-hunting 1)
    (set-strategic-number sn-minimum-boar-lure-group-size 0)
    (set-strategic-number sn-minimum-boar-hunt-group-size 0)
    (set-strategic-number sn-minimum-number-hunters 0)
)

; Native economy rule: byzantine-boar-hunt-release-distance
(defrule
    (dropsite-min-distance live-boar > 32)
=>
    (set-strategic-number sn-enable-boar-hunting 1)
    (set-strategic-number sn-minimum-boar-lure-group-size 0)
    (set-strategic-number sn-minimum-boar-hunt-group-size 0)
    (set-strategic-number sn-minimum-number-hunters 0)
)

; Native economy rule: byzantine-boar-hunt-release-none
(defrule
    (dropsite-min-distance live-boar <= -1)
=>
    (set-strategic-number sn-enable-boar-hunting 1)
    (set-strategic-number sn-minimum-boar-lure-group-size 0)
    (set-strategic-number sn-minimum-boar-hunt-group-size 0)
    (set-strategic-number sn-minimum-number-hunters 0)
)

;---------------------------------------------------------------
;---------------------------------------------------------------
; PRO SCOUTING / NAGA INFORMATION LOOP
;---------------------------------------------------------------
; Doctrine:
;   Dark: the starting Scout owns local exploration and the economy does not
;         pay a civilian-explorer tax while that Scout exists.
;   Feudal: convert the Scout from generic exploration into a repeatable intel
;           route: enemy anchor -> wood -> gold -> production intent.
;   Castle/Imperial: keep revisiting enemy intent. Scouting is not a one-shot
;           opening action; it is persistent observation feeding arbitration.
;   Raid geometry is retained as typed point state for later military execution.
; Timer is cadence only. Search-result counts are the actual observation witness.

; Native scouting ownership: no civilian explorer while the Scout is alive.
(defrule
    (unit-type-count scout-cavalry-line >= 1)
    (strategic-number sn-cap-civilian-explorers != 0)
=>
    (set-strategic-number sn-percent-civilian-explorers 0)
    (set-strategic-number sn-cap-civilian-explorers 0)
)

; Native scouting recovery: permit exactly one civilian fallback when the real
; Scout is gone during the information-critical land game.
(defrule
    (current-age < imperial-age)
    (not (map-type islands))
    (not (unit-type-count scout-cavalry-line >= 1))
    (strategic-number sn-cap-civilian-explorers == 0)
=>
    (set-strategic-number sn-percent-civilian-explorers 100)
    (set-strategic-number sn-cap-civilian-explorers 1)
)

; Native scouting ownership restoration: Scout return closes the civilian
; fallback again.
(defrule
    (unit-type-count scout-cavalry-line >= 1)
    (strategic-number sn-cap-civilian-explorers == 1)
=>
    (set-strategic-number sn-percent-civilian-explorers 0)
    (set-strategic-number sn-cap-civilian-explorers 0)
)

; Dark Age: preserve the existing native flank exploration pattern.
(defrule
    (goal byzantine-scout-phase 0)
    (current-age == dark-age)
    (not (map-type islands))
    (unit-type-count scout-cavalry-line >= 1)
=>
    (up-send-scout group-type-land-explore scout-flank)
    (set-goal byzantine-scout-phase 1)
)

; Feudal handoff: reassert native flank exploration once, then begin the
; persistent information loop after the scout has had a chance to travel.
(defrule
    (or
        (goal byzantine-scout-phase 0)
        (goal byzantine-scout-phase 1)
    )
    (current-age >= feudal-age)
    (not (map-type islands))
    (unit-type-count scout-cavalry-line >= 1)
=>
    (up-send-scout group-type-land-explore scout-flank)
    (set-goal byzantine-scout-phase 2)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)

; Mission 2: identify the enemy anchor. If the enemy TC has not been sighted,
; do not pretend that an intel mission succeeded; keep native exploration alive.
(defrule
    (goal byzantine-scout-phase 2)
    (current-age >= feudal-age)
    (not (map-type islands))
    (unit-type-count scout-cavalry-line >= 1)
    (or
        (up-timer-status byzantine-scout-intel-timer c:== timer-disabled)
        (up-timer-status byzantine-scout-intel-timer c:== timer-triggered)
    )
=>
    (up-full-reset-search)
    (up-find-player enemy find-closest byzantine-scout-focus-player)
    (up-modify-sn sn-focus-player-number g:= byzantine-scout-focus-player)
    (up-find-remote c: town-center c: 1)
    (up-get-search-state byzantine-scout-search-state)
    (set-goal byzantine-scout-phase 20)
    (disable-timer byzantine-scout-intel-timer)
)

(defrule
    (goal byzantine-scout-phase 20)
    (up-compare-goal 384 > 0)
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number g:= byzantine-scout-focus-player)
    (up-find-local c: scout-cavalry-line c: 1)
    (up-find-remote c: town-center c: 1)
    (up-target-objects 0 action-move -1 -1)
    (set-goal byzantine-scout-phase 3)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)

(defrule
    (goal byzantine-scout-phase 20)
    (up-compare-goal 384 <= 0)
    (unit-type-count scout-cavalry-line >= 1)
=>
    (up-send-scout group-type-land-explore scout-flank)
    (set-goal byzantine-scout-phase 2)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)

; Mission 3: locate enemy wood economy. This is both high-value intel and a
; future raid waypoint. A missing camp is not treated as a missing fact forever.
(defrule
    (goal byzantine-scout-phase 3)
    (current-age >= feudal-age)
    (unit-type-count scout-cavalry-line >= 1)
    (or
        (up-timer-status byzantine-scout-intel-timer c:== timer-disabled)
        (up-timer-status byzantine-scout-intel-timer c:== timer-triggered)
    )
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number g:= byzantine-scout-focus-player)
    (up-find-remote c: lumber-camp c: 1)
    (up-get-search-state byzantine-scout-search-state)
    (set-goal byzantine-scout-phase 21)
    (disable-timer byzantine-scout-intel-timer)
)

(defrule
    (goal byzantine-scout-phase 21)
    (up-compare-goal 384 > 0)
=>
    (up-modify-sn sn-focus-player-number g:= byzantine-scout-focus-player)
    (up-set-target-object search-remote c: 0)
    (up-get-point position-object byzantine-scout-wood-point)
    (up-find-local c: scout-cavalry-line c: 1)
    (up-find-remote c: lumber-camp c: 1)
    (up-target-objects 0 action-move -1 -1)
    (set-goal byzantine-scout-phase 4)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)

(defrule
    (goal byzantine-scout-phase 21)
    (up-compare-goal 384 <= 0)
    (unit-type-count scout-cavalry-line >= 1)
=>
    (up-send-scout group-type-land-explore scout-flank)
    (set-goal byzantine-scout-phase 2)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)

; Mission 4: locate enemy gold economy. This is the other core raid/intel point.
(defrule
    (goal byzantine-scout-phase 4)
    (current-age >= feudal-age)
    (unit-type-count scout-cavalry-line >= 1)
    (or
        (up-timer-status byzantine-scout-intel-timer c:== timer-disabled)
        (up-timer-status byzantine-scout-intel-timer c:== timer-triggered)
    )
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number g:= byzantine-scout-focus-player)
    (up-find-remote c: mining-camp c: 1)
    (up-get-search-state byzantine-scout-search-state)
    (set-goal byzantine-scout-phase 22)
    (disable-timer byzantine-scout-intel-timer)
)

(defrule
    (goal byzantine-scout-phase 22)
    (up-compare-goal 384 > 0)
=>
    (up-modify-sn sn-focus-player-number g:= byzantine-scout-focus-player)
    (up-set-target-object search-remote c: 0)
    (up-get-point position-object byzantine-scout-gold-point)
    (up-find-local c: scout-cavalry-line c: 1)
    (up-find-remote c: mining-camp c: 1)
    (up-target-objects 0 action-move -1 -1)
    (set-goal byzantine-scout-phase 5)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)

(defrule
    (goal byzantine-scout-phase 22)
    (up-compare-goal 384 <= 0)
    (unit-type-count scout-cavalry-line >= 1)
=>
    (up-send-scout group-type-land-explore scout-flank)
    (set-goal byzantine-scout-phase 2)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)

; Mission 5: probe the enemy stable. A sighted stable is intent evidence, not a
; conclusion; actual units/upgrades remain stronger confirmation elsewhere.
(defrule
    (goal byzantine-scout-phase 5)
    (current-age >= feudal-age)
    (unit-type-count scout-cavalry-line >= 1)
    (or
        (up-timer-status byzantine-scout-intel-timer c:== timer-disabled)
        (up-timer-status byzantine-scout-intel-timer c:== timer-triggered)
    )
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number g:= byzantine-scout-focus-player)
    (up-find-remote c: stable c: 1)
    (up-get-search-state byzantine-scout-search-state)
    (set-goal byzantine-scout-phase 15)
    (disable-timer byzantine-scout-intel-timer)
)

(defrule
    (goal byzantine-scout-phase 15)
    (up-compare-goal 384 > 0)
=>
    (set-goal byzantine-scout-sighted-stable 1)
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number g:= byzantine-scout-focus-player)
    (up-find-local c: scout-cavalry-line c: 1)
    (up-find-remote c: stable c: 1)
    (up-target-objects 0 action-move -1 -1)
    (set-goal byzantine-scout-phase 6)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)
(defrule
    (goal byzantine-scout-phase 15)
    (up-compare-goal 384 <= 0)
=>
    (set-goal byzantine-scout-phase 6)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)

; Mission 6: probe the enemy archery range.
(defrule
    (goal byzantine-scout-phase 6)
    (current-age >= feudal-age)
    (unit-type-count scout-cavalry-line >= 1)
    (or
        (up-timer-status byzantine-scout-intel-timer c:== timer-disabled)
        (up-timer-status byzantine-scout-intel-timer c:== timer-triggered)
    )
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number g:= byzantine-scout-focus-player)
    (up-find-remote c: archery-range c: 1)
    (up-get-search-state byzantine-scout-search-state)
    (set-goal byzantine-scout-phase 16)
    (disable-timer byzantine-scout-intel-timer)
)
(defrule
    (goal byzantine-scout-phase 16)
    (up-compare-goal 384 > 0)
=>
    (set-goal byzantine-scout-sighted-range 1)
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number g:= byzantine-scout-focus-player)
    (up-find-local c: scout-cavalry-line c: 1)
    (up-find-remote c: archery-range c: 1)
    (up-target-objects 0 action-move -1 -1)
    (set-goal byzantine-scout-phase 7)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)
(defrule
    (goal byzantine-scout-phase 16)
    (up-compare-goal 384 <= 0)
=>
    (set-goal byzantine-scout-phase 7)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)

; Mission 7: probe the enemy barracks. One barracks is weak intent evidence, so
; this is recorded but is not itself an army-package conclusion.
(defrule
    (goal byzantine-scout-phase 7)
    (current-age >= feudal-age)
    (unit-type-count scout-cavalry-line >= 1)
    (or
        (up-timer-status byzantine-scout-intel-timer c:== timer-disabled)
        (up-timer-status byzantine-scout-intel-timer c:== timer-triggered)
    )
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number g:= byzantine-scout-focus-player)
    (up-find-remote c: barracks c: 1)
    (up-get-search-state byzantine-scout-search-state)
    (set-goal byzantine-scout-phase 17)
    (disable-timer byzantine-scout-intel-timer)
)
(defrule
    (goal byzantine-scout-phase 17)
    (up-compare-goal 384 > 0)
=>
    (set-goal byzantine-scout-sighted-barracks 1)
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number g:= byzantine-scout-focus-player)
    (up-find-local c: scout-cavalry-line c: 1)
    (up-find-remote c: barracks c: 1)
    (up-target-objects 0 action-move -1 -1)
    (set-goal byzantine-scout-phase 8)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)
(defrule
    (goal byzantine-scout-phase 17)
    (up-compare-goal 384 <= 0)
=>
    (set-goal byzantine-scout-phase 8)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)

; Mission 8: probe for a Siege Workshop once Castle Age is plausible.
(defrule
    (goal byzantine-scout-phase 8)
    (current-age >= castle-age)
    (unit-type-count scout-cavalry-line >= 1)
    (or
        (up-timer-status byzantine-scout-intel-timer c:== timer-disabled)
        (up-timer-status byzantine-scout-intel-timer c:== timer-triggered)
    )
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number g:= byzantine-scout-focus-player)
    (up-find-remote c: siege-workshop c: 1)
    (up-get-search-state byzantine-scout-search-state)
    (set-goal byzantine-scout-phase 18)
    (disable-timer byzantine-scout-intel-timer)
)
(defrule
    (goal byzantine-scout-phase 18)
    (up-compare-goal 384 > 0)
=>
    (set-goal byzantine-scout-sighted-siege 1)
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number g:= byzantine-scout-focus-player)
    (up-find-local c: scout-cavalry-line c: 1)
    (up-find-remote c: siege-workshop c: 1)
    (up-target-objects 0 action-move -1 -1)
    (set-goal byzantine-scout-phase 9)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)
(defrule
    (goal byzantine-scout-phase 18)
    (up-compare-goal 384 <= 0)
=>
    (set-goal byzantine-scout-phase 9)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)

; Completed information sweep: return to native exploration before the next
; intelligence cycle. Persistent sighting goals intentionally remain until the
; corresponding information is no longer relevant to the current age.
(defrule
    (goal byzantine-scout-phase 9)
    (unit-type-count scout-cavalry-line >= 1)
    (or
        (up-timer-status byzantine-scout-intel-timer c:== timer-disabled)
        (up-timer-status byzantine-scout-intel-timer c:== timer-triggered)
    )
=>
    (up-send-scout group-type-land-explore scout-flank)
    (set-goal byzantine-scout-phase 2)
    (enable-timer byzantine-scout-intel-timer bt-byzantine-scout-intel-seconds)
)

; Full loss recovery: clear the scouting phase so a rebuilt Scout gets the same
; information loop instead of inheriting a stale mission.
(defrule
    (up-compare-goal byzantine-scout-phase > 0)
    (not (unit-type-count scout-cavalry-line >= 1))
=>
    (set-goal byzantine-scout-phase 0)
    (disable-timer byzantine-scout-intel-timer)
)

; NAGA-style pre-warning: sighted production buildings change arbitration before
; the first combat unit is visible. Actual unit counts remain stronger proof.
(defrule
    (current-age == feudal-age)
    (goal byzantine-scout-sighted-stable 1)
=>
    (set-goal counter-package-mounted_pressure_feudal 1)
)

(defrule
    (current-age == feudal-age)
    (goal byzantine-scout-sighted-range 1)
=>
    (set-goal counter-package-ranged_pressure_feudal 1)
)

(defrule
    (current-age >= castle-age)
    (goal byzantine-scout-sighted-siege 1)
=>
    (set-goal counter-package-siege_pressure_castle 1)
)

; Native control rule: economy-controller-select-counter-pressure
(defrule
    (and (and (current-age >= feudal-age) (current-age < castle-age)) (players-unit-type-count any-enemy militia-line >= 5))
=>
    (set-goal economy-posture 2)
)

; Native control rule: economy-controller-select-fast-castle
(defrule
    (and (and (current-age >= feudal-age) (current-age < castle-age)) (and (not (players-unit-type-count any-enemy militia-line >= 5)) (goal opening-plan 3)))
=>
    (set-goal economy-posture 3)
)

; Native control rule: economy-controller-select-counter-feudal
(defrule
    (and (and (current-age >= feudal-age) (current-age < castle-age)) (and (not (players-unit-type-count any-enemy militia-line >= 5)) (goal opening-plan 2)))
=>
    (set-goal economy-posture 2)
)

; Native control rule: economy-controller-select-water-economy
(defrule
    (and (and (current-age >= feudal-age) (current-age < castle-age)) (and (not (players-unit-type-count any-enemy militia-line >= 5)) (goal opening-plan 4)))
=>
    (set-goal economy-posture 4)
)

; Native control rule: economy-controller-select-water-control
(defrule
    (and (and (current-age >= feudal-age) (current-age < castle-age)) (and (not (players-unit-type-count any-enemy militia-line >= 5)) (goal opening-plan 5)))
=>
    (set-goal economy-posture 5)
)

; Native control rule: economy-controller-select-base
(defrule
    (and (current-age < castle-age) (and (not (players-unit-type-count any-enemy militia-line >= 5)) (goal opening-plan 1)))
=>
    (set-goal economy-posture 1)
)

; Native control rule: economy-controller-select-castle-conversion
; Native control rule: economy-controller-select-fast-imperial
(defrule
    (and (current-age >= castle-age)
         (and (current-age < imperial-age)
              (and (map-type arena)
                   (and (goal opening-plan 3)
                        (not (or (players-unit-type-count any-enemy knight >= 3) (or (players-unit-type-count any-enemy archer-line >= 4) (players-unit-type-count any-enemy militia-line >= 5))))))))
=>
    (set-goal economy-posture 9)
)

; Native control rule: economy-controller-select-castle-conversion
(defrule
    (and (current-age >= castle-age)
         (and (current-age < imperial-age)
              (not (and (map-type arena)
                        (and (goal opening-plan 3)
                             (not (players-unit-type-count any-enemy militia-line >= 5)))))))
=>
    (set-goal economy-posture 6)
)

; Native control rule: economy-controller-select-imperial-conversion
(defrule
    (current-age >= imperial-age)
=>
    (set-goal economy-posture 7)
)

; Native control rule: economy-controller-select-food-recovery
(defrule
    (food-amount < 350)
=>
    (set-goal economy-posture 8)
)

; Native control rule: economy-controller-write-base-sn-food-gatherer-percentage
(defrule
    (goal economy-posture 1)
    (up-compare-sn sn-food-gatherer-percentage != 55)
=>
    (set-strategic-number sn-food-gatherer-percentage 55)
)

