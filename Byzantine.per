; Native control rule: water-execution-initialize
(defrule
    (goal transport-phase 0)
    (goal water-posture 0)
=>
    (set-goal transport-phase 0)
    (set-goal water-posture 0)
    (disable-self)
)

; Native control rule: transport-phase-no-longer-required
(defrule
    (not (map-type islands))
    (or (goal transport-phase 1) (or (goal transport-phase 2) (goal transport-phase 3)))
=>
    (set-goal transport-phase 0)
)

; Native control rule: transport-phase-recover-on-capability-loss
(defrule
    (map-type islands)
    (goal transport-phase 2)
    (not (unit-type-count transport-ship >= 1))
=>
    (set-goal transport-phase 3)
)

; Native control rule: transport-phase-prepare
(defrule
    (map-type islands)
    (or (goal transport-phase 0) (goal transport-phase 3))
    (not (unit-type-count transport-ship >= 1))
=>
    (set-goal transport-phase 1)
)

; Native control rule: transport-phase-ready
(defrule
    (map-type islands)
    (unit-type-count transport-ship >= 1)
    (not (goal transport-phase 2))
=>
    (set-goal transport-phase 2)
)

; Native control rule: water-posture-transport
(defrule
    (map-type islands)
=>
