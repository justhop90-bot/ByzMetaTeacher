)

; Native control rule: byzantine-attack-phase-complete-cataphract
(defrule
    (goal byzantine-attack-phase 2)
    (players-unit-type-count any-enemy knight < 3)
=>
    (set-goal byzantine-attack-phase 0)
)

; Native control rule: byzantine-attack-phase-complete-knight
(defrule
