; Native role rule: role-enter-forming
(defrule
    (goal 161 byzantine-army-role-idle)
    (goal byzantine-army-attack-ready 1)
    (goal byzantine-offensive-objective-claim 1)
=>
    (set-goal 161 byzantine-army-role-forming)
    (set-goal 228 0)
    (set-goal 229 0)
)

; Native role rule: role-forming-reset
(defrule
    (goal 161 byzantine-army-role-forming)
    (goal 228 0)
=>
    (up-full-reset-search)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-filter-include cmdid-monk -1 -1 -1)
    (up-find-local c: -1 c: 240)
    (up-remove-objects search-local 19 != 2)
    (up-modify-group-flag 0 c: 5)
    (up-modify-group-flag 0 c: 6)
    (up-modify-group-flag 0 c: 7)
    (up-modify-group-flag 0 c: 8)
    (up-modify-group-flag 0 c: 9)
    (up-reset-group c: 5)
    (up-reset-group c: 6)
    (up-reset-group c: 7)
    (up-reset-group c: 8)
    (up-reset-group c: 9)
    (set-goal 194 4)
    (set-goal 228 1)
)

