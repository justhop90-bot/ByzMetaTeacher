; Native control rule: economy-controller-write-castle_conversion-sn-percent-civilian-builders
(defrule
    (goal economy-posture 6)
    (up-compare-sn sn-percent-civilian-builders != 7)
=>
    (set-strategic-number sn-percent-civilian-builders 7)
)

