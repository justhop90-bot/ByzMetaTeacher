    (set-goal construction-retry-barrier-economy-barracks-floor-1 1)
)

; Action issuance: economy-barracks-floor-1 | ACTIVE -> ISSUED
(defrule
    (goal demand-economy-barracks-floor-1 1)
    (not (building-type-count barracks >= 1))
