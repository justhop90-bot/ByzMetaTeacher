)

; Native control rule: byzantine-endgame-push-admit
(defrule
    (goal byzantine-endgame-push-state 1)
    (current-age >= imperial-age)
    (goal byzantine-offensive-objective-claim 0)
    (attack-soldier-count <= 0)
    (up-compare-goal byzantine-imperial-band-state >= 1)
    (unit-type-count halberdier >= 18)
    (unit-type-count 6 >= 18)
    (unit-type-count hussar >= 12)
    (or (unit-type-count cataphract >= 12) (or (unit-type-count varangian-guard >= 12) (unit-type-count 492 >= 12)))
    (up-compare-goal byzantine-imperial-band-state != 2)
    (or (unit-type-count trebuchet >= 4) (or (unit-type-count bombard-cannon >= 4) (unit-type-count-total mangonel-line >= 4)))
    (strategic-number sn-native-16 >= 6)
    (strategic-number sn-native-26 >= 40)
=>
    (enable-timer byzantine-endgame-push-timer 20)
    (set-goal byzantine-endgame-push-state 2)
)

; Native control rule: byzantine-endgame-push-admit-fortified
(defrule
    (goal byzantine-endgame-push-state 1)
    (current-age >= imperial-age)
    (goal byzantine-offensive-objective-claim 0)
    (attack-soldier-count <= 0)
    (up-compare-goal byzantine-imperial-band-state >= 1)
    (unit-type-count halberdier >= 18)
    (unit-type-count 6 >= 18)
    (unit-type-count hussar >= 12)
    (or (unit-type-count cataphract >= 12) (or (unit-type-count varangian-guard >= 12) (unit-type-count 492 >= 12)))
    (goal byzantine-imperial-band-state 2)
    (or (unit-type-count trebuchet >= 6) (or (unit-type-count bombard-cannon >= 6) (unit-type-count-total mangonel-line >= 6)))
    (strategic-number sn-native-16 >= 6)
    (strategic-number sn-native-26 >= 40)
=>
    (enable-timer byzantine-endgame-push-timer 20)
    (set-goal byzantine-endgame-push-state 2)
)

; Native control rule: byzantine-endgame-push-admit-trash
(defrule
    (goal byzantine-endgame-push-state 1)
    (current-age >= imperial-age)
    (goal byzantine-offensive-objective-claim 0)
    (attack-soldier-count <= 0)
    (goal byzantine-imperial-band-state 3)
    (unit-type-count halberdier >= 18)
    (unit-type-count 6 >= 18)
