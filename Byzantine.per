; Persistent housing safety valve: the old milestone floors stop at 16 houses, which is
; insufficient for a Castle/Imperial economy. Reassert housing whenever headroom gets low.
(defrule
    (housing-headroom < 5)
    (population-headroom > 0)
    (up-pending-objects c: 70 == 0)
    (goal action-claim-build-pass-singleton 0)
    (current-age >= dark-age)
    (can-build house)
=>
    (build house)
    (set-goal action-claim-build-pass-singleton 1)
)

; Native economy rule: byzantine-natural-food-stable
(defrule
    (goal byzantine-natural-food-state byzantine-natural-food-stable)
    (current-age >= feudal-age)
    (not (map-type islands))
    (unit-type-count-total villager >= 24)
    (or
        (dropsite-min-distance live-boar <= -1)
        (dropsite-min-distance live-boar > 32)
    )
    (or
        (dropsite-min-distance deer-hunting <= -1)
        (dropsite-min-distance deer-hunting > 32)
    )
    (sheep-and-forage-too-far)
    (or
        (building-type-count-total farm >= 4)
        (unit-type-count-total villager >= 30)
    )
=>
    (set-goal byzantine-natural-food-state byzantine-natural-food-transition)
)

; Native economy rule: byzantine-natural-food-early-transition
; Naga/community practice starts farm continuity when natural food is no longer
; the reliable cheap source. We deliberately wait until Feudal + 24 villagers so
; the Byzantine opening has had time to exploit sheep/boar/deer instead of
; prematurely replacing a healthy food bank with wood-expensive farms.
(defrule
    (goal byzantine-natural-food-state byzantine-natural-food-stable)
    (current-age >= feudal-age)
    (not (map-type islands))
    (unit-type-count-total villager >= 24)
    (or
        (dropsite-min-distance live-boar <= -1)
        (dropsite-min-distance live-boar > 32)
    )
    (or
        (dropsite-min-distance deer-hunting <= -1)
        (dropsite-min-distance deer-hunting > 32)
    )
    (sheep-and-forage-too-far)
=>
    (set-goal demand-economy-farm-floor-feudal-4 1)
    (set-strategic-number sn-maximum-food-drop-distance 15)
    (up-retask-gatherers fisher-food c: 4)
    (up-retask-gatherers forage-food c: 4)
    (up-retask-gatherers livestock-food c: 4)
    (up-retask-gatherers hunting-food c: 2)
    (up-retask-gatherers food c: byzantine-economy-delta-step)
    (set-goal byzantine-natural-food-state byzantine-natural-food-transition)
)

; Native economy rule: byzantine-natural-food-depleted
; Once the first farm block exists, explicitly move remaining villagers off
; shore fish/forage/livestock/hunt food so the engine's farm-first food priority
; can take over. This fixes the classic AI failure where farms are constructed
; but natural food remains the effective gather target.
(defrule
    (goal byzantine-natural-food-state byzantine-natural-food-transition)
    (current-age >= feudal-age)
    (not (map-type islands))
    (building-type-count-total farm >= 4)
    (unit-type-count-total villager >= 24)
=>
    (set-strategic-number sn-maximum-food-drop-distance 15)
    (up-retask-gatherers fisher-food c: 6)
    (up-retask-gatherers forage-food c: 6)
    (up-retask-gatherers livestock-food c: 6)
    (up-retask-gatherers hunting-food c: 4)
    (up-retask-gatherers food c: 4)
    (set-goal byzantine-natural-food-state byzantine-natural-food-farms)
)

; Pending diagnostics: economy-farm-floor-feudal-4
; PENDING-DIAGNOSTIC [INFO] PENDING-ACTION-GUARD: action is gated by active goal 65 and cannot reissue from pending goal 66
; PENDING-DIAGNOSTIC [INFO] PENDING-WITNESS-GUARD: completion witness is evaluated only while pending goal 66 is active
; PENDING-DIAGNOSTIC [INFO] PENDING-RELEASE-GUARD: release is evaluated only after completion goal 67 is reached
; PENDING-DIAGNOSTIC [INFO] PENDING-ACTION-WITNESS-SEPARATE: action 'build' is not treated as completion evidence; witness 'building-type-count' owns completion
; PENDING-DIAGNOSTIC [INFO] PENDING-RELEASE-SEPARATE: release remains separate from witness 'building-type-count' and may clear the demand only from complete state
; Issuance failure: economy-farm-floor-feudal-4 | RETAIN-ACTIVE
; An unsatisfied issuance guard leaves demand-economy-farm-floor-feudal-4 in ACTIVE; it is not PENDING.
; Release: economy-farm-floor-feudal-4 | COMPLETE -> RELEASED
(defrule
    (goal demand-economy-farm-floor-feudal-4 67)
    (building-type-count farm >= 4)
=>
    (set-goal demand-economy-farm-floor-feudal-4 0)
)

; Recovery: economy-farm-floor-feudal-4 | RELEASED -> ACTIVE on world-state loss
(defrule
    (goal demand-economy-farm-floor-feudal-4 0)
    (not (building-type-count farm >= 4))
    (food-amount < 600)
=>
    (set-goal demand-economy-farm-floor-feudal-4 1)
)

; Construction observation: economy-farm-floor-feudal-4
; Precedence: COMPLETE > FOUNDATION_PENDING > PLACEMENT_PENDING > RETRY
; Completion witness: economy-farm-floor-feudal-4 | PENDING/ISSUED -> COMPLETE
; COMPLETE | ISSUED/PENDING -> COMPLETE
(defrule
    (or
        (goal demand-economy-farm-floor-feudal-4 68)
        (goal demand-economy-farm-floor-feudal-4 66)
    )
    (building-type-count farm >= 4)
=>
    (set-goal demand-economy-farm-floor-feudal-4 67)
)

; Pending admission: economy-farm-floor-feudal-4 | ISSUED/PENDING -> PENDING
(defrule
    (or
        (goal demand-economy-farm-floor-feudal-4 68)
        (goal demand-economy-farm-floor-feudal-4 66)
    )
    (not (building-type-count farm >= 4))
    (up-pending-objects c: 50 >= 1)
=>
    (set-goal demand-economy-farm-floor-feudal-4 66)
)

; PLACEMENT_PENDING | ISSUED/PENDING -> PENDING
(defrule
    (or
        (goal demand-economy-farm-floor-feudal-4 68)
        (goal demand-economy-farm-floor-feudal-4 66)
    )
    (not (building-type-count farm >= 4))
    (up-pending-objects c: 50 == 0)
    (up-pending-placement c: 50)
=>
    (set-goal demand-economy-farm-floor-feudal-4 66)
)

; RETRY | ISSUED/PENDING -> ACTIVE
(defrule
    (or
        (goal demand-economy-farm-floor-feudal-4 68)
        (goal demand-economy-farm-floor-feudal-4 66)
    )
    (not (building-type-count farm >= 4))
    (up-pending-objects c: 50 == 0)
    (not (up-pending-placement c: 50))
=>
    (set-goal demand-economy-farm-floor-feudal-4 1)
    (set-goal construction-retry-barrier-economy-farm-floor-feudal-4 1)
)

; Action issuance: economy-farm-floor-feudal-4 | ACTIVE -> ISSUED
(defrule
    (goal demand-economy-farm-floor-feudal-4 1)
    (not (building-type-count farm >= 4))
    (goal construction-retry-barrier-economy-farm-floor-feudal-4 0)
    (up-pending-objects c: 50 == 0)
    (not (up-pending-placement c: 50))
    (not (building-type-count farm >= 4))
    (goal action-claim-build-pass-singleton 0)
    (current-age >= feudal-age)
    (building-type-count-total mill >= 1)
    (unit-type-count-total villager >= 18)
    (can-build-with-escrow farm)
    (idle-farm-count < 2)
    (food-amount < 650)
    (building-type-count-total farm < 4)
=>
    (build farm)
    (set-goal action-claim-build-pass-singleton 1)
    (set-goal demand-economy-farm-floor-feudal-4 68)
)

