(defconst byzantine-relic-control-idle 0)
(defconst byzantine-relic-control-acquire 1)
(defconst byzantine-relic-control-deny 2)
(defconst bt-byzantine-relic-control-seconds 45)

; Emergency food recovery state. Timer is cadence, not truth.
(defconst byzantine-food-recovery-state 486)
(defconst byzantine-food-recovery-timer 13)
(defconst byzantine-food-recovery-idle 0)
(defconst byzantine-food-recovery-active 1)
(defconst bt-byzantine-food-recovery-seconds 30)

; Monk defensive controller. It turns the Byzantine healing bonus into a
; persistent defensive capability without creating a second army scheduler.
(defconst byzantine-monk-defense-state 1001)
(defconst byzantine-monk-defense-idle 0)
(defconst byzantine-monk-defense-active 1)
(defconst byzantine-monk-defense-heal-timer 16)
(defconst byzantine-monk-defense-convert-timer 17)
(defconst bt-byzantine-monk-defense-heal-seconds 30)
(defconst bt-byzantine-monk-defense-convert-seconds 20)

; Conditional defensive Monk floor: 4 total only while a real defensive/siege
; pressure condition exists. Baseline Monk floor remains 2 from Castle onward.
(defconst demand-castle-monk-defense-floor 1002)
(defconst issued-castle-monk-defense-floor 1005)
(defconst pending-castle-monk-defense-floor 1003)
(defconst complete-castle-monk-defense-floor 1004)
(defconst production-retry-barrier-castle-monk-defense-floor 1006)

; -----------------------------------------------------------------------------
; NATIVE STATIC-DEFENSE CHOKE / RESOURCE SCORER
; -----------------------------------------------------------------------------
; Candidate 1: exact persisted resource-front point.
; Candidate 2: existing fortified-front anchor geometry / forward placement.
; The weights are compiler policy. Native evidence is supplied by:
;   up-point-distance + existing wall-resource state + anchor-pair geometry.
; Equal scores prefer the resource point because it is an exact economic target.

; Native load-order closure: every local constant referenced by the earliest
; rules is defined before any defrule. This is semantically equivalent to the
; prior scattered declarations, but avoids native forward-reference ambiguity.
(defconst byzantine-wall-resource-state 494)
(defconst byzantine-wall-resource-selected 2)
(defconst byzantine-wall-resource-armed 3)
(defconst byzantine-wall-resource-secured 4)
(defconst byzantine-wall-resource-target 495)
(defconst byzantine-wall-resource-target-gold 1)
(defconst byzantine-wall-resource-target-stone 2)
(defconst byzantine-wall-resource-target-wood 3)
(defconst byzantine-wall-resource-point 496)
(defconst byzantine-university-state 515)
(defconst byzantine-university-state-tower-network 3)
(defconst byzantine-university-state-imperial-gunline 4)
(defconst byzantine-army-attack-ready 299)
(defconst byzantine-fortification-threat 353)
(defconst bt-byzantine-defense-monk-floor 6)
(defconst sn-number-attack-groups 36)
(defconst sn-percent-attack-soldiers 227)
(defconst sn-minimum-attack-group-size 16)
(defconst sn-maximum-attack-group-size 26)

(defrule
    (goal byzantine-static-defense-score-state -1)
=>
    (set-goal byzantine-static-defense-score-state byzantine-static-defense-score-idle)
    (set-goal byzantine-static-defense-resource-score 0)
    (set-goal byzantine-static-defense-fortified-score 0)
    (set-goal byzantine-static-defense-placement-kind byzantine-static-defense-placement-none)
    (disable-timer byzantine-static-defense-score-timer)
    (disable-self)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-resource-selected)
    (timer-triggered byzantine-static-defense-score-timer)
=>
    (disable-timer byzantine-static-defense-score-timer)
    (set-goal byzantine-static-defense-score-state byzantine-static-defense-score-idle)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-fortified-selected)
    (timer-triggered byzantine-static-defense-score-timer)
=>
    (disable-timer byzantine-static-defense-score-timer)
    (set-goal byzantine-static-defense-score-state byzantine-static-defense-score-idle)
)

; Start an evaluation whenever a resource-front candidate exists.
(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-idle)
    (current-age >= castle-age)
    (or
        (goal byzantine-wall-resource-state byzantine-wall-resource-selected)
        (or
            (goal byzantine-wall-resource-state byzantine-wall-resource-armed)
            (goal byzantine-wall-resource-state byzantine-wall-resource-secured)
        )
    )
    (or
        (up-timer-status byzantine-static-defense-score-timer c:== timer-disabled)
        (up-timer-status byzantine-static-defense-score-timer c:== timer-triggered)
    )
=>
    (disable-timer byzantine-static-defense-score-timer)
    (set-goal byzantine-static-defense-resource-score 0)
    (set-goal byzantine-static-defense-fortified-score 0)
    (set-goal byzantine-static-defense-placement-kind byzantine-static-defense-placement-none)
    (set-goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
)

; A fortified candidate can also be scored from already selected wall geometry.
(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-idle)
    (current-age >= castle-age)
    (or
        (goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
        (goal byzantine-wall-geometry-state byzantine-wall-geometry-armed)
    )
    (up-compare-goal byzantine-wall-anchor-pair > 0)
    (or
        (up-timer-status byzantine-static-defense-score-timer c:== timer-disabled)
        (up-timer-status byzantine-static-defense-score-timer c:== timer-triggered)
    )
=>
    (disable-timer byzantine-static-defense-score-timer)
    (set-goal byzantine-static-defense-resource-score 0)
    (set-goal byzantine-static-defense-fortified-score 0)
    (set-goal byzantine-static-defense-placement-kind byzantine-static-defense-placement-none)
    (set-goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
)

; Resource-front score.
(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (or
        (goal byzantine-wall-resource-state byzantine-wall-resource-selected)
        (or
            (goal byzantine-wall-resource-state byzantine-wall-resource-armed)
            (goal byzantine-wall-resource-state byzantine-wall-resource-secured)
        )
    )
=>
    (up-modify-goal byzantine-static-defense-resource-score c:+ 600)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (goal byzantine-wall-resource-target byzantine-wall-resource-target-gold)
=>
    (up-modify-goal byzantine-static-defense-resource-score c:+ 250)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (goal byzantine-wall-resource-target byzantine-wall-resource-target-stone)
=>
    (up-modify-goal byzantine-static-defense-resource-score c:+ 170)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (goal byzantine-wall-resource-target byzantine-wall-resource-target-wood)
=>
    (up-modify-goal byzantine-static-defense-resource-score c:+ 100)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (goal byzantine-wall-resource-state byzantine-wall-resource-secured)
=>
    (up-modify-goal byzantine-static-defense-resource-score c:+ 120)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (goal byzantine-wall-resource-state byzantine-wall-resource-armed)
=>
    (up-modify-goal byzantine-static-defense-resource-score c:+ 80)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (goal byzantine-wall-resource-state byzantine-wall-resource-selected)
=>
    (up-modify-goal byzantine-static-defense-resource-score c:+ 40)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (goal byzantine-wall-resource-state byzantine-wall-resource-secured)
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
    (or
        (up-point-distance byzantine-wall-resource-point byzantine-wall-tc-point <= 12)
        (or
            (up-point-distance byzantine-wall-resource-point byzantine-wall-castle-point <= 12)
            (or
                (up-point-distance byzantine-wall-resource-point byzantine-wall-keep-point <= 12)
                (or
                    (up-point-distance byzantine-wall-resource-point byzantine-wall-bombard-point <= 12)
                    (or
                        (up-point-distance byzantine-wall-resource-point byzantine-wall-guard-point <= 12)
                        (or
                            (up-point-distance byzantine-wall-resource-point byzantine-wall-watch-point <= 12)
                            (up-point-distance byzantine-wall-resource-point byzantine-wall-outpost-point <= 12)
                        )
                    )
                )
            )
        )
    )
=>
    (up-modify-goal byzantine-static-defense-resource-score c:+ 100)
)

; Fortified-front score.
(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
    (up-compare-goal byzantine-wall-anchor-pair > 0)
=>
    (up-modify-goal byzantine-static-defense-fortified-score c:+ 500)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-armed)
    (up-compare-goal byzantine-wall-anchor-pair > 0)
=>
    (up-modify-goal byzantine-static-defense-fortified-score c:+ 580)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (or
        (goal byzantine-wall-anchor-pair byzantine-wall-pair-town-center-bombard-tower)
        (or
            (goal byzantine-wall-anchor-pair byzantine-wall-pair-castle-bombard-tower)
            (or
                (goal byzantine-wall-anchor-pair byzantine-wall-pair-keep-bombard-tower)
                (or
                    (goal byzantine-wall-anchor-pair byzantine-wall-pair-bombard-tower-guard-tower)
                    (or
                        (goal byzantine-wall-anchor-pair byzantine-wall-pair-bombard-tower-watch-tower)
                        (goal byzantine-wall-anchor-pair byzantine-wall-pair-bombard-tower-outpost)
                    )
                )
            )
        )
    )
=>
    (up-modify-goal byzantine-static-defense-fortified-score c:+ 280)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (or
        (goal byzantine-wall-anchor-pair byzantine-wall-pair-town-center-keep)
        (or
            (goal byzantine-wall-anchor-pair byzantine-wall-pair-castle-keep)
            (or
                (goal byzantine-wall-anchor-pair byzantine-wall-pair-keep-guard-tower)
                (or
                    (goal byzantine-wall-anchor-pair byzantine-wall-pair-keep-watch-tower)
                    (goal byzantine-wall-anchor-pair byzantine-wall-pair-keep-outpost)
                )
            )
        )
    )
=>
    (up-modify-goal byzantine-static-defense-fortified-score c:+ 240)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (or
        (goal byzantine-wall-anchor-pair byzantine-wall-pair-town-center-castle)
        (or
            (goal byzantine-wall-anchor-pair byzantine-wall-pair-castle-guard-tower)
            (or
                (goal byzantine-wall-anchor-pair byzantine-wall-pair-castle-watch-tower)
                (or
                    (goal byzantine-wall-anchor-pair byzantine-wall-pair-castle-outpost)
                    (or
                        (goal byzantine-wall-anchor-pair byzantine-wall-pair-town-center-guard-tower)
                        (or
                            (goal byzantine-wall-anchor-pair byzantine-wall-pair-town-center-watch-tower)
                            (or
                                (goal byzantine-wall-anchor-pair byzantine-wall-pair-town-center-outpost)
                                (or
                                    (goal byzantine-wall-anchor-pair byzantine-wall-pair-guard-tower-watch-tower)
                                    (or
                                        (goal byzantine-wall-anchor-pair byzantine-wall-pair-guard-tower-outpost)
                                        (goal byzantine-wall-anchor-pair byzantine-wall-pair-watch-tower-outpost)
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
=>
    (up-modify-goal byzantine-static-defense-fortified-score c:+ 170)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (goal byzantine-fortification-threat 1)
=>
    (up-modify-goal byzantine-static-defense-fortified-score c:+ 180)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (or
        (goal byzantine-university-state byzantine-university-state-tower-network)
        (goal byzantine-university-state byzantine-university-state-imperial-gunline)
    )
=>
    (up-modify-goal byzantine-static-defense-fortified-score c:+ 120)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (goal byzantine-army-attack-ready 2)
=>
    (up-modify-goal byzantine-static-defense-fortified-score c:+ 80)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (goal byzantine-wall-resource-state byzantine-wall-resource-secured)
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
    (up-compare-goal byzantine-wall-anchor-pair > 0)
    (or
        (up-point-distance byzantine-wall-resource-point byzantine-wall-tc-point <= 16)
        (or
            (up-point-distance byzantine-wall-resource-point byzantine-wall-castle-point <= 16)
            (or
                (up-point-distance byzantine-wall-resource-point byzantine-wall-keep-point <= 16)
                (or
                    (up-point-distance byzantine-wall-resource-point byzantine-wall-bombard-point <= 16)
                    (or
                        (up-point-distance byzantine-wall-resource-point byzantine-wall-guard-point <= 16)
                        (or
                            (up-point-distance byzantine-wall-resource-point byzantine-wall-watch-point <= 16)
                            (up-point-distance byzantine-wall-resource-point byzantine-wall-outpost-point <= 16)
                        )
                    )
                )
            )
        )
    )
=>
    (up-modify-goal byzantine-static-defense-fortified-score c:+ 120)
)

; Resource-front wins when no viable fortified anchor exists.
(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (or
        (goal byzantine-wall-resource-state byzantine-wall-resource-selected)
        (or
            (goal byzantine-wall-resource-state byzantine-wall-resource-armed)
            (goal byzantine-wall-resource-state byzantine-wall-resource-secured)
        )
    )
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-idle)
=>
    (set-goal byzantine-static-defense-placement-kind byzantine-static-defense-placement-resource)
    (set-goal byzantine-static-defense-score-state byzantine-static-defense-score-resource-selected)
    (enable-timer byzantine-static-defense-score-timer 45)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (or
        (goal byzantine-wall-resource-state byzantine-wall-resource-selected)
        (or
            (goal byzantine-wall-resource-state byzantine-wall-resource-armed)
            (goal byzantine-wall-resource-state byzantine-wall-resource-secured)
        )
    )
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
    (up-compare-goal byzantine-static-defense-resource-score g:>= byzantine-static-defense-fortified-score)
=>
    (set-goal byzantine-static-defense-placement-kind byzantine-static-defense-placement-resource)
    (set-goal byzantine-static-defense-score-state byzantine-static-defense-score-resource-selected)
    (enable-timer byzantine-static-defense-score-timer 45)
)

(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (or
        (goal byzantine-wall-resource-state byzantine-wall-resource-selected)
        (or
            (goal byzantine-wall-resource-state byzantine-wall-resource-armed)
            (goal byzantine-wall-resource-state byzantine-wall-resource-secured)
        )
    )
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-armed)
    (up-compare-goal byzantine-static-defense-resource-score g:>= byzantine-static-defense-fortified-score)
=>
    (set-goal byzantine-static-defense-placement-kind byzantine-static-defense-placement-resource)
    (set-goal byzantine-static-defense-score-state byzantine-static-defense-score-resource-selected)
    (enable-timer byzantine-static-defense-score-timer 45)
)

; Fortified front wins only on a strict score advantage.
(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-evaluating)
    (or
        (goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
        (goal byzantine-wall-geometry-state byzantine-wall-geometry-armed)
    )
    (up-compare-goal byzantine-wall-anchor-pair > 0)
    (up-compare-goal byzantine-static-defense-fortified-score g:> byzantine-static-defense-resource-score)
=>
    (set-goal byzantine-static-defense-placement-kind byzantine-static-defense-placement-fortified)
    (set-goal byzantine-static-defense-score-state byzantine-static-defense-score-fortified-selected)
    (enable-timer byzantine-static-defense-score-timer 45)
)


; Evidence-loss invalidation: a scored resource placement is no longer valid
; once its persisted resource-front witness leaves the selected/armed/secured
; lifecycle. The 45-second timer remains the normal cadence expiry; this rule
; handles hard witness loss immediately.
(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-resource-selected)
    (and
        (not (goal byzantine-wall-resource-state byzantine-wall-resource-selected))
        (and
            (not (goal byzantine-wall-resource-state byzantine-wall-resource-armed))
            (not (goal byzantine-wall-resource-state byzantine-wall-resource-secured))
        )
    )
=>
    (disable-timer byzantine-static-defense-score-timer)
    (set-goal byzantine-static-defense-placement-kind byzantine-static-defense-placement-none)
    (set-goal byzantine-static-defense-score-state byzantine-static-defense-score-idle)
)

; Evidence-loss invalidation: a fortified placement expires immediately when
; its anchor geometry disappears, rather than trusting the 45-second cadence.
(defrule
    (goal byzantine-static-defense-score-state byzantine-static-defense-score-fortified-selected)
    (or
        (and
            (not (goal byzantine-wall-geometry-state byzantine-wall-geometry-selected))
            (not (goal byzantine-wall-geometry-state byzantine-wall-geometry-armed))
        )
        (up-compare-goal byzantine-wall-anchor-pair <= 0)
    )
=>
    (disable-timer byzantine-static-defense-score-timer)
    (set-goal byzantine-static-defense-placement-kind byzantine-static-defense-placement-none)
    (set-goal byzantine-static-defense-score-state byzantine-static-defense-score-idle)
)

