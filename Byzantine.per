    (and (and (and (and (current-age >= feudal-age) (current-age < imperial-age)) (goal strategy-posture 2)) (not (goal sn-controller-byz-push-227-active 1))) (or (up-compare-sn sn-native-227 != 50) (goal sn-reassert-227 1)))
=>
    (set-strategic-number sn-native-227 50)
    (set-goal sn-reassert-227 0)
)

; Native control rule: byzantine-attack-phase-initialize
(defrule
    (goal byzantine-attack-phase 0)
=>
    (set-goal byzantine-attack-phase 0)
    (disable-self)
)

; Native control rule: byzantine-attack-phase-prepare-cataphract
(defrule
    (goal byzantine-attack-phase 0)
    (and (current-age >= castle-age) (and (goal strategy-posture 4) (and (players-unit-type-count any-enemy knight >= 3) (unit-type-count cataphract >= 2))))
=>
    (set-goal byzantine-attack-phase 1)
)

; Native control rule: byzantine-attack-phase-attack-cataphract
(defrule
    (goal byzantine-attack-phase 1)
    (and (current-age >= castle-age) (and (goal strategy-posture 4) (and (players-unit-type-count any-enemy knight >= 3) (unit-type-count cataphract >= 2))))
=>
    (set-goal byzantine-attack-phase 2)
)

; Native control rule: byzantine-attack-phase-prepare-knight
(defrule
    (goal byzantine-attack-phase 0)
    (and (current-age >= castle-age) (and (goal strategy-posture 4) (and (players-unit-type-count any-enemy militia-line >= 5) (unit-type-count knight >= 3))))
=>
    (set-goal byzantine-attack-phase 3)
)

; Native control rule: byzantine-attack-phase-attack-knight
