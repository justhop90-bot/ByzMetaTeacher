)

; Five Siege Workshops. This is intentionally the strictest branch: it needs an
; already-fortified siege posture and an actual siege battery, not just cash.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-army-attack-ready 2)
    (goal byzantine-siege-scale byzantine-siege-scale-fortified)
