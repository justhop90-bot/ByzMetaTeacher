=>
    (up-full-reset-search)
    (up-find-local c: guard-tower c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object byzantine-wall-guard-point)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
