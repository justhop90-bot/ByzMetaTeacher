;----------------------------------------------------------------
; PERSISTENT BYZANTINE DEFENSIVE FRONTIER
;----------------------------------------------------------------
; The frontier is deliberately small: resource sector -> forward anchor ->
; connecting wall -> protected sector. It extends the existing DUC wall/tower
; mechanisms instead of replacing them with another scheduler.

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-idle)
    (current-age >= castle-age)
    (up-compare-goal byzantine-frontier-generation < 2)
    (not (town-under-attack))
    (not (town-under-attack))
    (or
        (goal strategic-primary-intent 3)
        (or
            (gold-amount > 6500)
            (or
                (wood-amount > 6500)
                (stone-amount > 1800)
            )
        )
    )
=>
    (set-goal byzantine-frontier-state byzantine-frontier-state-acquire)
    (set-goal byzantine-frontier-target-kind byzantine-frontier-target-none)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-acquire)
    (goal byzantine-frontier-generation 0)
=>
    (up-full-reset-search)
    (up-find-local c: town-center c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object byzantine-frontier-home-point)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-acquire)
    (up-compare-goal byzantine-frontier-generation >= 1)
    (up-compare-goal byzantine-frontier-anchor-point > 0)
=>
    (up-copy-point byzantine-frontier-home-point byzantine-frontier-anchor-point)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-acquire)
    (goal byzantine-frontier-target-kind byzantine-frontier-target-none)
    (goal byzantine-frontier-generation 0)
    (up-compare-goal byzantine-frontier-home-point > 0)
    (resource-found gold)
    (or
        (dropsite-min-distance gold == -1)
        (dropsite-min-distance gold > 12)
    )
=>
    (up-full-reset-search)
    (up-find-resource c: gold c: 8)
    (up-get-search-state byzantine-frontier-search-state)
    (set-goal byzantine-frontier-target-kind byzantine-frontier-target-gold)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-acquire)
    (goal byzantine-frontier-target-kind byzantine-frontier-target-none)
    (goal byzantine-frontier-generation 0)
    (up-compare-goal byzantine-frontier-home-point > 0)
    (not (resource-found gold))
    (resource-found stone)
    (or
        (dropsite-min-distance stone == -1)
        (dropsite-min-distance stone > 12)
    )
=>
    (up-full-reset-search)
    (up-find-resource c: stone c: 8)
    (up-get-search-state byzantine-frontier-search-state)
    (set-goal byzantine-frontier-target-kind byzantine-frontier-target-stone)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-acquire)
    (goal byzantine-frontier-target-kind byzantine-frontier-target-none)
    (goal byzantine-frontier-generation 1)
    (up-compare-goal byzantine-frontier-home-point > 0)
    (resource-found stone)
    (or
        (dropsite-min-distance stone == -1)
        (dropsite-min-distance stone > 12)
    )
=>
    (up-full-reset-search)
    (up-find-resource c: stone c: 8)
    (up-get-search-state byzantine-frontier-search-state)
    (set-goal byzantine-frontier-target-kind byzantine-frontier-target-stone)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-acquire)
    (goal byzantine-frontier-target-kind byzantine-frontier-target-none)
    (goal byzantine-frontier-generation 1)
    (up-compare-goal byzantine-frontier-home-point > 0)
    (not (resource-found stone))
    (resource-found wood)
    (or
        (dropsite-min-distance wood == -1)
        (dropsite-min-distance wood > 12)
    )
=>
    (up-full-reset-search)
    (up-find-resource c: wood c: 8)
    (up-get-search-state byzantine-frontier-search-state)
    (set-goal byzantine-frontier-target-kind byzantine-frontier-target-wood)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-acquire)
    (or
        (goal byzantine-frontier-target-kind byzantine-frontier-target-gold)
        (or
            (goal byzantine-frontier-target-kind byzantine-frontier-target-stone)
            (goal byzantine-frontier-target-kind byzantine-frontier-target-wood)
        )
    )
    (up-compare-goal byzantine-frontier-search-remote-list > 0)
=>
    (up-set-target-object search-remote c: 0)
    (up-get-point position-object byzantine-frontier-target-point)
    (set-goal byzantine-frontier-state byzantine-frontier-state-selected)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-acquire)
    (goal byzantine-frontier-target-kind byzantine-frontier-target-gold)
    (up-compare-goal byzantine-frontier-search-remote-list == 0)
=>
    (set-goal byzantine-frontier-state byzantine-frontier-state-idle)
    (set-goal byzantine-frontier-target-kind byzantine-frontier-target-none)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-acquire)
    (goal byzantine-frontier-target-kind byzantine-frontier-target-stone)
    (up-compare-goal byzantine-frontier-search-remote-list == 0)
=>
    (set-goal byzantine-frontier-state byzantine-frontier-state-idle)
    (set-goal byzantine-frontier-target-kind byzantine-frontier-target-none)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-acquire)
    (goal byzantine-frontier-target-kind byzantine-frontier-target-wood)
    (up-compare-goal byzantine-frontier-search-remote-list == 0)
=>
    (set-goal byzantine-frontier-state byzantine-frontier-state-idle)
    (set-goal byzantine-frontier-target-kind byzantine-frontier-target-none)
)

; Naga placement idiom: persist the point, then use place-point.
(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-selected)
    (goal action-claim-build-pass-singleton 0)
    (goal construction-retry-barrier-adaptive-guard-tower 0)
    (not (town-under-attack))
    (current-age >= castle-age)
    (up-pending-objects c: 234 == 0)
    (not (up-pending-placement c: 234))
    (can-build guard-tower)
=>
    (up-set-target-point byzantine-frontier-target-point)
    (set-strategic-number sn-placement-zone-size 4)
    (up-build place-point 0 c: guard-tower)
    (set-goal byzantine-frontier-anchor-type byzantine-frontier-anchor-guard-tower)
    (set-goal action-claim-build-pass-singleton 1)
    (set-goal demand-adaptive-guard-tower 44)
    (set-goal byzantine-frontier-state byzantine-frontier-state-anchor-pending)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-selected)
    (goal action-claim-build-pass-singleton 0)
    (goal construction-retry-barrier-adaptive-guard-tower 0)
    (not (town-under-attack))
    (current-age >= castle-age)
    (up-pending-objects c: 79 == 0)
    (not (up-pending-placement c: 79))
    (can-build watch-tower)
=>
    (up-set-target-point byzantine-frontier-target-point)
    (set-strategic-number sn-placement-zone-size 4)
    (up-build place-point 0 c: watch-tower)
    (set-goal byzantine-frontier-anchor-type byzantine-frontier-anchor-watch-tower)
    (set-goal action-claim-build-pass-singleton 1)
    (set-goal demand-adaptive-guard-tower 44)
    (set-goal byzantine-frontier-state byzantine-frontier-state-anchor-pending)
)

; World-state anchor witness.
(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-anchor-pending)
    (goal byzantine-frontier-anchor-type byzantine-frontier-anchor-guard-tower)
    (or
        (up-point-contains byzantine-frontier-target-point c: guard-tower)
        (up-point-contains byzantine-frontier-target-point c: 234)
    )
=>
    (up-copy-point byzantine-frontier-anchor-point byzantine-frontier-target-point)
    (set-goal demand-adaptive-guard-tower 43)
    (set-goal byzantine-frontier-state byzantine-frontier-state-anchored)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-anchor-pending)
    (goal byzantine-frontier-anchor-type byzantine-frontier-anchor-watch-tower)
    (up-point-contains byzantine-frontier-target-point c: watch-tower)
=>
    (up-copy-point byzantine-frontier-anchor-point byzantine-frontier-target-point)
    (set-goal demand-adaptive-guard-tower 43)
    (set-goal byzantine-frontier-state byzantine-frontier-state-anchored)
)

; Failed placement retries the same target.
(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-anchor-pending)
    (goal byzantine-frontier-anchor-type byzantine-frontier-anchor-guard-tower)
    (not (up-point-contains byzantine-frontier-target-point c: guard-tower))
    (not (up-point-contains byzantine-frontier-target-point c: 234))
    (up-pending-objects c: 234 == 0)
    (not (up-pending-placement c: 234))
    (goal demand-adaptive-guard-tower 1)
=>
    (set-goal byzantine-frontier-state byzantine-frontier-state-selected)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-anchor-pending)
    (goal byzantine-frontier-anchor-type byzantine-frontier-anchor-watch-tower)
    (not (up-point-contains byzantine-frontier-target-point c: watch-tower))
    (up-pending-objects c: 79 == 0)
    (not (up-pending-placement c: 79)
    )
    (goal demand-adaptive-guard-tower 1)
=>
    (set-goal byzantine-frontier-state byzantine-frontier-state-selected)
)

; Frontier wall demand and execution.
(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-anchored)
    (current-age >= castle-age)
    (stone-amount >= 650)
    (not (town-under-attack))
    (goal demand-adaptive-stone-wall 0)
=>
    (set-goal byzantine-wall-material byzantine-wall-material-stone)
    (set-goal byzantine-wall-gate-policy byzantine-wall-gate-required)
    (set-goal demand-adaptive-stone-wall 1)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-anchored)
    (goal demand-adaptive-stone-wall 1)
    (goal construction-retry-barrier-adaptive-stone-wall 0)
    (goal action-claim-build-pass-singleton 0)
    (up-pending-objects c: 117 == 0)
    (not (up-pending-placement c: 117))
    (up-can-build-line 0 byzantine-frontier-home-point c: 117)
=>
    (up-build-line byzantine-frontier-home-point byzantine-frontier-anchor-point c: 117)
    (set-goal action-claim-build-pass-singleton 1)
    (set-goal demand-adaptive-stone-wall 46)
    (set-goal byzantine-frontier-wall-witness-point 0)
    (up-copy-point byzantine-frontier-wall-witness-point byzantine-frontier-anchor-point)
    (set-goal byzantine-frontier-state byzantine-frontier-state-wall-pending)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-wall-pending)
    (goal demand-adaptive-stone-wall 1)
    (goal construction-retry-barrier-adaptive-stone-wall 0)
    (goal action-claim-build-pass-singleton 0)
    (up-pending-objects c: 117 == 0)
    (not (up-pending-placement c: 117))
    (up-can-build-line 0 byzantine-frontier-home-point c: 117)
=>
    (up-build-line byzantine-frontier-home-point byzantine-frontier-anchor-point c: 117)
    (set-goal action-claim-build-pass-singleton 1)
    (set-goal demand-adaptive-stone-wall 46)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-wall-pending)
    (or
        (up-point-contains byzantine-frontier-wall-witness-point c: wall-class)
        (up-point-contains byzantine-frontier-home-point c: wall-class)
    )
=>
    (set-goal demand-adaptive-stone-wall 45)
    (set-goal byzantine-frontier-state byzantine-frontier-state-protected)
    (up-modify-goal byzantine-frontier-generation c:+ 1)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-anchored)
    (not
        (or
            (up-point-contains byzantine-frontier-anchor-point c: guard-tower)
            (or
                (up-point-contains byzantine-frontier-anchor-point c: 234)
                (up-point-contains byzantine-frontier-anchor-point c: watch-tower)
            )
        )
    )
=>
    (set-goal byzantine-frontier-state byzantine-frontier-state-selected)
    (set-goal demand-adaptive-guard-tower 1)
)

(defrule
    (goal byzantine-frontier-state byzantine-frontier-state-protected)
    (up-compare-goal byzantine-frontier-generation < 2)
    (not (town-under-attack))
    (or
        (goal strategic-primary-intent 3)
        (or
            (gold-amount > 6500)
            (or
                (wood-amount > 6500)
                (food-amount > 6500)
            )
        )
    )
=>
    (set-goal byzantine-frontier-state byzantine-frontier-state-acquire)
    (set-goal byzantine-frontier-target-kind byzantine-frontier-target-none)
    (set-goal byzantine-frontier-target-point 0)
)

;----------------------------------------------------------------
; PROFESSIONAL BYZANTINE UNIVERSITY / DEFENSIVE MAP CONTROL
;----------------------------------------------------------------
; The University state is posture, not a research queue. Research demands stay
; persistent and use native research completion/pending witnesses. The posture
; only advances when the defensive world state actually exists.
;
; Aggressive-defense principle:
;   Castle -> harden the protected perimeter
;   hard perimeter -> establish a multi-anchor tower network
;   tower network + expansion intent -> project a second tower forward
;   Imperial + real artillery -> activate the gunline layer.
;
; The second tower is deliberately issued through build-forward when the
; two-TC expansion intent owns the map. Native placement then grows the wall /
; anchor network around the new forward defensive position instead of treating
; defense as a permanent shell around the starting TC.

; University recovery. Losing the building invalidates the current
; University posture, while completed technologies remain world truth.
(defrule
    (current-age >= castle-age)
    (not (building-type-count university >= 1))
    (not (goal byzantine-university-state byzantine-university-state-idle))
=>
    (set-goal byzantine-university-state byzantine-university-state-castle)
    (set-goal demand-castle-university-capability 1)
)

; CASTLE: Castle Age establishes the University capability.
(defrule
    (goal byzantine-university-state byzantine-university-state-idle)
    (current-age >= castle-age)
=>
    (set-goal byzantine-university-state byzantine-university-state-castle)
    (set-goal demand-castle-university-capability 1)
)

; CASTLE -> HARDENED_PERIMETER:
; one wall/tower is not a perimeter. Require persistent closure/funnel evidence.
(defrule
    (goal byzantine-university-state byzantine-university-state-castle)
    (building-type-count university >= 1)
    (or
        (goal byzantine-wall-resource-state byzantine-wall-resource-secured)
        (or
            (and
                (up-compare-goal byzantine-wall-anchor-pair > 0)
                (building-type-count 117 >= 2)
            )
            (and
                (wall-completed-percentage byzantine-wall-native-perimeter >= 42)
                (gate-count byzantine-wall-native-perimeter >= 1)
            )
        )
    )
=>
    (set-goal byzantine-university-state byzantine-university-state-hardened-perimeter)
)

; HARDENED_PERIMETER -> TOWER_NETWORK:
; require two meaningful firing anchors plus a spatial relationship.
(defrule
    (goal byzantine-university-state byzantine-university-state-hardened-perimeter)
    (building-type-count university >= 1)
    (up-compare-goal byzantine-wall-anchor-pair > 0)
    (or
        (and
            (building-type-count guard-tower >= 2)
            (building-type-count guard-tower >= 2)
        )
        (or
            (and
                (building-type-count guard-tower >= 1)
                (building-type-count keep >= 1)
            )
            (or
                (and
                    (building-type-count guard-tower >= 1)
                    (building-type-count bombard-tower >= 1)
                )
                (and
                    (building-type-count keep >= 1)
                    (building-type-count bombard-tower >= 1)
                )
            )
        )
    )
=>
    (set-goal byzantine-university-state byzantine-university-state-tower-network)
)

; TOWER_NETWORK -> IMPERIAL_GUNLINE:
; Chemistry plus real artillery remains the witness.
(defrule
    (goal byzantine-university-state byzantine-university-state-tower-network)
    (current-age >= imperial-age)
    (research-completed chemistry)
    (or
        (building-type-count bombard-tower >= 1)
        (unit-type-count bombard-cannon >= 1)
    )
=>
    (set-goal byzantine-university-state byzantine-university-state-imperial-gunline)
)

; Network degradation preserves the hard perimeter when tower-network evidence disappears.
(defrule
    (goal byzantine-university-state byzantine-university-state-tower-network)
    (building-type-count university >= 1)
    (or
        (goal byzantine-wall-resource-state byzantine-wall-resource-secured)
        (or
            (and
                (up-compare-goal byzantine-wall-anchor-pair > 0)
                (building-type-count 117 >= 2)
            )
            (and
                (wall-completed-percentage byzantine-wall-native-perimeter >= 42)
                (gate-count byzantine-wall-native-perimeter >= 1)
            )
        )
    )
    (not
        (and
            (up-compare-goal byzantine-wall-anchor-pair > 0)
            (or
                (and (building-type-count guard-tower >= 2) (building-type-count guard-tower >= 2))
                (or
                    (and (building-type-count guard-tower >= 1) (building-type-count keep >= 1))
                    (or
                        (and (building-type-count guard-tower >= 1) (building-type-count bombard-tower >= 1))
                        (and (building-type-count keep >= 1) (building-type-count bombard-tower >= 1))
                    )
                )
            )
        )
    )
=>
    (set-goal byzantine-university-state byzantine-university-state-hardened-perimeter)
)

; Perimeter degradation returns to Castle posture only after durable evidence disappears.
(defrule
    (goal byzantine-university-state byzantine-university-state-hardened-perimeter)
    (building-type-count university >= 1)
    (not (goal byzantine-wall-resource-state byzantine-wall-resource-secured))
    (up-compare-goal byzantine-wall-anchor-pair <= 0)
    (not
        (and
            (wall-completed-percentage byzantine-wall-native-perimeter >= 42)
            (gate-count byzantine-wall-native-perimeter >= 1)
        )
    )
=>
    (set-goal byzantine-university-state byzantine-university-state-castle)
)

; -----------------------------------------------------------------------------
; PROFESSIONAL BYZANTINE PRODUCTION CAPACITY CONTROLLER
; -----------------------------------------------------------------------------
; Community-convergent pattern:
;   desired capacity -> completed/under-construction capacity ->
;   build admission -> repeated reassertion.
;
; Unlike the old ad-hoc Imperial sinks, this does not wait for a foundation
; to finish before issuing the next capacity expansion. The new building
; system plus up-pending-objects lets the controller sustain multiple
; simultaneous foundations while the per-pass build mutex still limits this
; script to one new build action per pass.
;
; Byzantine policy:
;   - Barracks scale with infantry/trash backbone.
;   - Archery Ranges scale with ranged posture / ranged pressure.
;   - Stables scale with Cataphract/camel cavalry pressure.
;   - Siege Workshops scale with siege/fortification pressure.
;   - Castles scale only in Imperial when stone, population, map-control,
;     and military demand justify another expensive anchor.
;
; The first building is still owned by the established capability lifecycles.
; This controller only builds when total capacity is at least 2.

; Recompute total capacity targets every pass. Later rules raise the targets
; from these conservative defaults.
(defrule
    (true)
=>
    (set-goal byzantine-production-barracks-target 1)
    (set-goal byzantine-production-archery-target 0)
    (set-goal byzantine-production-stable-target 0)
    (set-goal byzantine-production-siege-target 0)
    (set-goal byzantine-production-castle-target 0)
)

; CASTLE-AGE CAPACITY EXPANSION
; The first Barracks/Range/Stable remain owned by their existing capability
; lifecycles. These rules only raise shared capacity targets when the existing
; army-demand graph has a concrete reason for another production lane.
;
; .per logical operators are binary. Larger alternatives are deliberately nested.

(defrule
    (current-age == castle-age)
    (goal byzantine-army-plan-phase 1)
    (unit-type-count-total villager >= 45)
    (population-headroom > 8)
    (not (town-under-attack))
    (or
        (goal demand-counter-mounted-spears 1)
        (players-unit-type-count any-enemy knight >= 3)
    )
=>
    (set-goal byzantine-production-barracks-target 2)
)

(defrule
    (current-age == castle-age)
    (goal byzantine-army-plan-phase 1)
    (unit-type-count-total villager >= 45)
    (population-headroom > 8)
    (not (town-under-attack))
    (or
        (goal demand-counter-ranged-skirmishers 1)
        (or
            (players-unit-type-count any-enemy archer-line >= 3)
            (players-unit-type-count any-enemy cavalry-archer-line >= 3)
        )
    )
=>
    (set-goal byzantine-production-archery-target 2)
)

(defrule
    (current-age == castle-age)
    (goal byzantine-army-plan-phase 1)
    (unit-type-count-total villager >= 48)
    (population-headroom > 8)
    (not (town-under-attack))
    (or
        (goal demand-castle-cataphract-floor 1)
        (unit-type-count-total cataphract-line >= 4)
    )
=>
    (set-goal byzantine-production-stable-target 2)
)

; Mature Imperial infantry backbone: second Barracks.
(defrule
    (current-age >= imperial-age)
    (unit-type-count-total villager >= 55)
    (or
        (goal byzantine-imperial-composition-posture byzantine-imperial-posture-infantry)
        (or
            (goal byzantine-imperial-composition-posture byzantine-imperial-posture-balanced)
            (or
                (unit-type-count-total 359 >= 8)
                (unit-type-count-total varangian-guard-line >= 6)
            )
        )
    )
=>
    (set-goal byzantine-production-barracks-target 2)
)

; Imperial infantry production expansion.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (unit-type-count-total villager >= 70)
    (wood-amount > 3000)
    (or
        (goal byzantine-imperial-composition-posture byzantine-imperial-posture-infantry)
        (goal byzantine-imperial-composition-posture byzantine-imperial-posture-balanced)
    )
=>
    (set-goal byzantine-production-barracks-target 3)
)

; Full late-game infantry capacity. Four Barracks is deliberately a surge
; condition, not a permanent baseline.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (unit-type-count-total villager >= 85)
    (population-headroom > 20)
    (wood-amount > 5000)
    (goal byzantine-imperial-composition-posture byzantine-imperial-posture-infantry)
=>
    (set-goal byzantine-production-barracks-target 4)
)

; Second Range when the ranged branch is real, not merely possible.
(defrule
    (current-age >= imperial-age)
    (unit-type-count-total villager >= 55)
    (or
        (goal byzantine-imperial-composition-posture byzantine-imperial-posture-ranged)
        (or
            (players-unit-type-count any-enemy archer-line >= 4)
            (players-unit-type-count any-enemy cavalry-archer-line >= 4)
        )
    )
=>
    (set-goal byzantine-production-archery-target 2)
)

; Third Range for sustained ranged Imperial output.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (unit-type-count-total villager >= 70)
    (population-headroom > 10)
    (wood-amount > 3000)
    (goal byzantine-imperial-composition-posture byzantine-imperial-posture-ranged)
=>
    (set-goal byzantine-production-archery-target 3)
)

; Second Stable for Cataphract/camel production.
(defrule
    (current-age >= imperial-age)
    (unit-type-count-total villager >= 55)
    (or
        (goal byzantine-imperial-composition-posture byzantine-imperial-posture-mounted)
        (or
            (goal byzantine-imperial-composition-posture byzantine-imperial-posture-balanced)
            (unit-type-count-total cataphract-line >= 8)
        )
    )
=>
    (set-goal byzantine-production-stable-target 2)
)

; Third Stable for sustained mounted pressure.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (unit-type-count-total villager >= 70)
    (population-headroom > 10)
    (wood-amount > 3000)
    (or
        (goal byzantine-imperial-composition-posture byzantine-imperial-posture-mounted)
        (goal byzantine-imperial-composition-posture byzantine-imperial-posture-balanced)
    )
=>
    (set-goal byzantine-production-stable-target 3)
)

; Second Siege Workshop when siege demand is durable, including Castle-age
; fortified positions and persistent Mangonel pressure.
(defrule
    (current-age >= castle-age)
    (unit-type-count-total villager >= 50)
    (or
        (goal byzantine-siege-scale byzantine-siege-scale-fortified)
        (goal byzantine-fortification-threat 1)
    )
=>
    (set-goal byzantine-production-siege-target 2)
)

; Third Siege Workshop is an Imperial mass-siege condition.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (unit-type-count-total villager >= 75)
    (population-headroom > 10)
    (wood-amount > 3000)
    (goal byzantine-siege-scale byzantine-siege-scale-fortified)
=>
    (set-goal byzantine-production-siege-target 3)
)

; Second Bombard Tower: convert true late-game surplus into a positional
; artillery anchor only after the first Castle exists and its stone bank is not
; currently being expanded.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-bombard-tower-target byzantine-bombard-tower-target-one)
    (building-type-count-total castle >= 1)
    (building-type-count-total bombard-tower >= 1)
    (stone-amount > bt-byzantine-bombard-stone-surplus)
    (gold-amount > bt-byzantine-bombard-gold-surplus)
    (population-headroom > 8)
    (not (town-under-attack))
    (not (goal byzantine-production-castle-target 2))
    (not (goal byzantine-production-castle-target 3))
    (or
        (goal byzantine-fortification-threat 1)
        (or
            (goal byzantine-university-state byzantine-university-state-tower-network)
            (goal byzantine-university-state byzantine-university-state-imperial-gunline)
        )
    )
    (or
        (goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
        (goal byzantine-wall-geometry-state byzantine-wall-geometry-armed)
    )
=>
    (set-goal byzantine-bombard-tower-target byzantine-bombard-tower-target-two)
)

; When stone becomes committed to the next Castle, or the late surplus/posture
; disappears, return to the single-tower floor.
(defrule
    (goal byzantine-bombard-tower-target byzantine-bombard-tower-target-two)
    (or
        (goal byzantine-production-castle-target 2)
        (or
            (goal byzantine-production-castle-target 3)
            (or
                (goal byzantine-late-resource-burn 0)
                (or
                    (stone-amount < 400)
                    (population-headroom <= 4)
                )
            )
        )
    )
=>
    (set-goal byzantine-bombard-tower-target byzantine-bombard-tower-target-one)
)

; Second Castle: only an Imperial, stone-rich, population-safe Byzantine can
; justify the cost. Castle is both a defensive anchor and a Cataphract outlet.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (stone-amount > 1200)
    (population-headroom > 20)
    (not (town-under-attack))
    (or
        (goal byzantine-university-state byzantine-university-state-tower-network)
        (or
            (goal byzantine-university-state byzantine-university-state-imperial-gunline)
            (goal byzantine-army-attack-ready 2)
        )
    )
=>
    (set-goal byzantine-production-castle-target 2)
)

; Third Castle: an exceptional Byzantine late-game fortress/production
; investment, requiring both the stone bank and a real Cataphract/army reason.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (stone-amount > 2000)
    (population-headroom > 35)
    (not (town-under-attack))
    (or
        (unit-type-count-total cataphract-line >= 12)
        (and
            (goal byzantine-imperial-composition-posture byzantine-imperial-posture-mounted)
            (unit-type-count-total cataphract-line >= 6)
        )
    )
    (or
        (goal byzantine-university-state byzantine-university-state-tower-network)
        (or
            (goal byzantine-university-state byzantine-university-state-imperial-gunline)
            (goal byzantine-army-attack-ready 2)
        )
    )
=>
    (set-goal byzantine-production-castle-target 3)
)

; EXTREME SURPLUS / THROUGHPUT SURGE
; These higher ceilings are deliberately gated by the existing late-bank state,
; mature population, available headroom, and sustained composition pressure.
; They feed the existing production targets; they do not create another scheduler.

(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (unit-type-count-total villager >= 95)
    (population-headroom > 25)
    (wood-amount > 6000)
    (or
        (goal byzantine-imperial-composition-posture byzantine-imperial-posture-infantry)
        (or
            (goal byzantine-imperial-composition-posture byzantine-imperial-posture-balanced)
            (or
                (unit-type-count-total 359 >= 12)
                (unit-type-count-total varangian-guard-line >= 10)
            )
        )
    )
=>
    (set-goal byzantine-production-barracks-target 5)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (unit-type-count-total villager >= 90)
    (population-headroom > 20)
    (wood-amount > 6000)
    (or
        (goal byzantine-imperial-composition-posture byzantine-imperial-posture-ranged)
        (or
            (unit-type-count-total arbalest >= 12)
            (players-unit-type-count any-enemy archer-line >= 6)
        )
    )
=>
    (set-goal byzantine-production-archery-target 4)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (unit-type-count-total villager >= 90)
    (population-headroom > 20)
    (wood-amount > 6000)
    (or
        (goal byzantine-imperial-composition-posture byzantine-imperial-posture-mounted)
        (or
            (goal byzantine-imperial-composition-posture byzantine-imperial-posture-balanced)
            (unit-type-count-total cataphract-line >= 12)
        )
    )
=>
    (set-goal byzantine-production-stable-target 4)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (unit-type-count-total villager >= 95)
    (population-headroom > 20)
    (wood-amount > 6000)
    (goal byzantine-siege-scale byzantine-siege-scale-fortified)
    (or
        (unit-type-count-total mangonel-line >= 6)
        (or
            (unit-type-count-total bombard-cannon >= 3)
            (unit-type-count-total trebuchet >= 2)
        )
    )
=>
    (set-goal byzantine-production-siege-target 4)
)

; ---------------------------------------------------------------------------
; FINAL EXTREME-SURPLUS PRODUCTION CAPACITY
; ---------------------------------------------------------------------------
; This is the last conversion tier for a mature Imperial bank. It exists because
; static defense alone cannot burn an all-resource surplus: 125 stone/gold per
; Bombard Tower is a tiny sink compared with 7.5k+ wood and 4k+ gold/4.5k+ food.
;
; The tier does NOT start a new scheduler. It only raises the existing shared
; capacity goals so the already-native production/build pipeline can turn excess
; wood into additional production lanes and then consume food/gold through the
; existing army floors.
;
; Six Barracks.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-army-attack-ready 2)
    (unit-type-count-total villager >= bt-extreme-production-villagers)
    (population-headroom > bt-extreme-production-headroom)
    (not (town-under-attack))
    (wood-amount > bt-extreme-production-wood)
    (gold-amount > bt-extreme-production-gold)
    (food-amount > bt-extreme-production-food)
    (or
        (goal byzantine-imperial-composition-posture byzantine-imperial-posture-infantry)
        (or
            (goal byzantine-imperial-composition-posture byzantine-imperial-posture-balanced)
            (or
                (unit-type-count-total 359 >= 16)
                (unit-type-count-total varangian-guard-line >= 12)
            )
        )
    )
=>
    (set-goal byzantine-production-barracks-target 6)
)

; Five Archery Ranges.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-army-attack-ready 2)
    (unit-type-count-total villager >= bt-extreme-production-villagers)
    (population-headroom > bt-extreme-production-headroom)
    (not (town-under-attack))
    (wood-amount > bt-extreme-production-wood)
    (gold-amount > bt-extreme-production-gold)
    (food-amount > 3500)
    (or
        (goal byzantine-imperial-composition-posture byzantine-imperial-posture-ranged)
        (or
            (goal byzantine-imperial-composition-posture byzantine-imperial-posture-balanced)
            (or
                (unit-type-count-total arbalest >= 16)
                (unit-type-count-total skirmisher-line >= 16)
            )
        )
    )
=>
    (set-goal byzantine-production-archery-target 5)
)

; Five Stables.
(defrule
