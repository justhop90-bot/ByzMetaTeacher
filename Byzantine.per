; ============================================================
; Byzantine military role separation
; Role ownership:
;   screen/main/siege/raid/reserve membership -> this controller
;   objective class/target -> offensive objective controller
;   attack/move issuance -> existing objective/siege actuators only
;
; Group identities: 5 screen, 6 main, 7 siege, 8 raid, 9 reserve.
; Formation is edge-triggered. Group size proves membership at the
; formation/split witness boundary, not combat success.
(defconst byzantine-army-role-state 420)
(defconst byzantine-army-role-formation-mask 421)
(defconst byzantine-army-role-selection-cap 422)
(defconst byzantine-army-role-screen-size 423)
(defconst byzantine-army-role-main-size 424)
(defconst byzantine-army-role-siege-size 425)
(defconst byzantine-army-role-raid-size 426)
(defconst byzantine-army-role-reserve-size 427)
(defconst byzantine-army-role-fortified-latch 430)
(defconst byzantine-army-role-recovery-request 431)

(defconst byzantine-army-role-id-screen 5)
(defconst byzantine-army-role-id-main 6)
(defconst byzantine-army-role-id-siege 7)
(defconst byzantine-army-role-id-raid 8)
(defconst byzantine-army-role-id-reserve 9)
(defconst byzantine-army-role-idle 0)
(defconst byzantine-army-role-forming 1)
(defconst byzantine-army-role-committed 2)
(defconst byzantine-army-role-raid-split 3)
(defconst byzantine-army-role-recovering 4)
(defconst bt-role-screen-floor 2)
(defconst bt-role-main-floor 4)
(defconst bt-role-siege-floor-standard 1)
(defconst bt-role-siege-floor-fortified 2)
(defconst bt-role-raid-floor 2)

; Goal defaults are zero. Do not add recurring initialization, because it would
; turn persistent state into a per-pass scheduler.
(defrule
    (goal byzantine-army-role-state byzantine-army-role-idle)
    (goal byzantine-army-attack-ready 1)
    (goal byzantine-offensive-objective-claim 1)
=>
    (set-goal byzantine-army-role-state byzantine-army-role-forming)
    (set-goal byzantine-army-role-formation-mask 0)
)

(defrule
    (goal byzantine-army-role-state byzantine-army-role-forming)
    (goal byzantine-army-role-formation-mask 0)
=>
    (up-full-reset-search)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-filter-include cmdid-monk -1 -1 -1)
    (up-find-local c: all-units-class c: 240)
    (up-remove-objects search-local 19 != 2)
    (up-modify-group-flag 0 c: 5)
    (up-modify-group-flag 0 c: 6)
    (up-modify-group-flag 0 c: 7)
    (up-modify-group-flag 0 c: 8)
    (up-modify-group-flag 0 c: 9)
    (up-reset-group c: 5)
    (up-reset-group c: 6)
    (up-reset-group c: 7)
    (up-reset-group c: 8)
    (up-reset-group c: 9)
    (set-goal byzantine-army-role-selection-cap 4)
    (set-goal byzantine-army-role-fortified-latch 0)
    (set-goal byzantine-army-role-formation-mask 1)
)

; Screen first.
(defrule
    (goal byzantine-army-role-state byzantine-army-role-forming)
    (goal byzantine-army-role-formation-mask 1)
=>
    (up-full-reset-search)
    (up-set-target-point byzantine-offensive-objective-point)
    (up-filter-distance c: -1 c: 60)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-local c: 93 c: 40)
    (up-find-local c: 358 c: 40)
    (up-find-local c: 359 c: 40)
    (up-remove-objects search-local 19 != 2)
    (up-create-group 0 byzantine-army-role-selection-cap c: 5)
    (up-modify-group-flag 1 c: 5)
    (set-goal byzantine-army-role-formation-mask 3)
)

; Siege second.
(defrule
    (goal byzantine-army-role-state byzantine-army-role-forming)
    (goal byzantine-army-role-formation-mask 3)
=>
    (up-full-reset-search)
    (up-set-target-point byzantine-offensive-objective-point)
    (up-filter-distance c: -1 c: 60)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-local c: mangonel-line c: 40)
    (up-find-local c: bombard-cannon c: 40)
    (up-find-local c: 36 c: 40)
    (up-find-local c: battering-ram-line c: 40)
    (up-remove-objects search-local 19 != 2)
    (set-goal byzantine-army-role-selection-cap 2)
    (up-create-group 0 byzantine-army-role-selection-cap c: 7)
    (up-modify-group-flag 1 c: 7)
    (set-goal byzantine-army-role-formation-mask 7)
)

; Reserve BEFORE main so raid capacity is deliberate, not leftover.
(defrule
    (goal byzantine-army-role-state byzantine-army-role-forming)
    (goal byzantine-army-role-formation-mask 7)
=>
    (up-full-reset-search)
    (up-set-target-point byzantine-offensive-objective-point)
    (up-filter-distance c: -1 c: 60)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-filter-include cmdid-monk -1 -1 -1)
    (up-find-local c: cavalry-class c: 40)
    (up-find-local c: monk c: 40)
    (up-remove-objects search-local 19 != 2)
    (up-remove-objects search-local 73 == 5)
    (up-remove-objects search-local 73 == 7)
    (set-goal byzantine-army-role-selection-cap 4)
    (up-create-group 0 byzantine-army-role-selection-cap c: 9)
    (up-modify-group-flag 1 c: 9)
    (set-goal byzantine-army-role-formation-mask 15)
)

; Main gets every remaining ready combat unit except screen/siege/reserve/monks.
(defrule
    (goal byzantine-army-role-state byzantine-army-role-forming)
    (goal byzantine-army-role-formation-mask 15)
=>
    (up-full-reset-search)
    (up-set-target-point byzantine-offensive-objective-point)
    (up-filter-distance c: -1 c: 60)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-local c: all-units-class c: 240)
    (up-remove-objects search-local 19 != 2)
    (up-remove-objects search-local 73 == 5)
    (up-remove-objects search-local 73 == 7)
    (up-remove-objects search-local 73 == 9)
    (up-remove-objects search-local 1 == monk)
    (set-goal byzantine-army-role-selection-cap 40)
    (up-create-group 0 byzantine-army-role-selection-cap c: 6)
    (up-modify-group-flag 1 c: 6)
    (set-goal byzantine-army-role-formation-mask 23)
)

; Native group-size witness.
(defrule
    (goal byzantine-army-role-state byzantine-army-role-forming)
    (goal byzantine-army-role-formation-mask 23)
    (goal byzantine-army-attack-ready 1)
=>
    (up-get-group-size c: 5 byzantine-army-role-screen-size)
    (up-get-group-size c: 6 byzantine-army-role-main-size)
    (up-get-group-size c: 7 byzantine-army-role-siege-size)
    (up-get-group-size c: 8 byzantine-army-role-raid-size)
    (up-get-group-size c: 9 byzantine-army-role-reserve-size)
    (set-goal byzantine-army-role-formation-mask 31)
)

(defrule
    (goal byzantine-army-role-state byzantine-army-role-forming)
    (goal byzantine-army-role-formation-mask 31)
    (goal byzantine-army-attack-ready 1)
    (up-compare-goal byzantine-army-role-screen-size >= bt-role-screen-floor)
    (up-compare-goal byzantine-army-role-main-size >= bt-role-main-floor)
    (or
        (and
            (goal byzantine-fortification-threat 0)
            (up-compare-goal byzantine-army-role-siege-size >= bt-role-siege-floor-standard)
        )
        (and
            (goal byzantine-fortification-threat 1)
            (up-compare-goal byzantine-army-role-siege-size >= bt-role-siege-floor-fortified)
        )
    )
=>
    (set-goal byzantine-army-role-state byzantine-army-role-committed)
)

(defrule
    (goal byzantine-army-role-state byzantine-army-role-forming)
    (goal byzantine-army-role-formation-mask 31)
    (goal byzantine-army-attack-ready 1)
    (or
        (up-compare-goal byzantine-army-role-screen-size < bt-role-screen-floor)
        (or
            (up-compare-goal byzantine-army-role-main-size < bt-role-main-floor)
            (or
                (and
                    (goal byzantine-fortification-threat 0)
                    (up-compare-goal byzantine-army-role-siege-size < bt-role-siege-floor-standard)
                )
                (and
                    (goal byzantine-fortification-threat 1)
                    (up-compare-goal byzantine-army-role-siege-size < bt-role-siege-floor-fortified)
                )
            )
        )
    )
=>
    (set-goal byzantine-army-role-state byzantine-army-role-recovering)
    (set-goal byzantine-army-role-recovery-request 1)
    (up-reset-group c: 5)
    (up-reset-group c: 6)
    (up-reset-group c: 7)
    (up-reset-group c: 8)
    (up-reset-group c: 9)
    (set-goal byzantine-army-role-formation-mask 0)
    (set-goal byzantine-army-role-fortified-latch 0)
)

(defrule
    (or
        (goal byzantine-army-role-state byzantine-army-role-committed)
        (goal byzantine-army-role-state byzantine-army-role-raid-split)
    )
    (goal byzantine-army-attack-ready 0)
=>
    (set-goal byzantine-army-role-state byzantine-army-role-recovering)
    (up-reset-group c: 5)
    (up-reset-group c: 6)
    (up-reset-group c: 7)
    (up-reset-group c: 8)
    (up-reset-group c: 9)
    (set-goal byzantine-army-role-formation-mask 0)
    (set-goal byzantine-army-role-fortified-latch 0)
)

(defrule
    (or
        (goal byzantine-army-role-state byzantine-army-role-committed)
        (goal byzantine-army-role-state byzantine-army-role-raid-split)
    )
    (goal byzantine-army-overmatch-state byzantine-army-overmatch-triggered)
=>
    (set-goal byzantine-army-role-state byzantine-army-role-recovering)
    (set-goal byzantine-army-role-recovery-request 1)
    (up-reset-group c: 5)
    (up-reset-group c: 6)
    (up-reset-group c: 7)
    (up-reset-group c: 8)
    (up-reset-group c: 9)
    (set-goal byzantine-army-role-formation-mask 0)
    (set-goal byzantine-army-role-fortified-latch 0)
)

(defrule
    (or
        (goal byzantine-army-role-state byzantine-army-role-committed)
        (goal byzantine-army-role-state byzantine-army-role-raid-split)
    )
    (or
        (goal byzantine-offensive-objective-state byzantine-offensive-objective-state-witness)
        (goal byzantine-offensive-objective-claim 0)
    )
=>
    (set-goal byzantine-army-role-state byzantine-army-role-idle)
    (set-goal byzantine-army-role-formation-mask 0)
    (set-goal byzantine-army-role-fortified-latch 0)
    (up-reset-group c: 5)
    (up-reset-group c: 6)
    (up-reset-group c: 7)
    (up-reset-group c: 8)
    (up-reset-group c: 9)
)

(defrule
    (goal byzantine-army-role-state byzantine-army-role-recovering)
    (goal byzantine-army-attack-ready 1)
    (goal byzantine-offensive-objective-claim 1)
=>
    (set-goal byzantine-army-role-state byzantine-army-role-forming)
)

(defrule
    (goal byzantine-army-role-state byzantine-army-role-recovering)
    (or
        (goal byzantine-army-attack-ready 0)
        (goal byzantine-offensive-objective-claim 0)
    )
=>
    (set-goal byzantine-army-role-state byzantine-army-role-idle)
    (set-goal byzantine-army-role-formation-mask 0)
    (set-goal byzantine-army-role-fortified-latch 0)
    (set-goal byzantine-army-role-recovery-request 0)
)

; Raid is limited to production/TC objectives and only steals from reserve.
(defrule
    (goal byzantine-army-role-state byzantine-army-role-committed)
    (or
        (goal byzantine-offensive-objective-class byzantine-offensive-objective-class-production)
        (goal byzantine-offensive-objective-class byzantine-offensive-objective-class-town-center)
    )
    (goal byzantine-fortification-threat 0)
    (up-compare-goal byzantine-army-role-screen-size >= bt-role-screen-floor)
    (up-compare-goal byzantine-army-role-main-size >= bt-role-main-floor)
    (up-compare-goal byzantine-army-role-siege-size >= bt-role-siege-floor-standard)
    (up-compare-goal byzantine-army-role-reserve-size >= bt-role-raid-floor)
    (or
        (unit-type-count-total knight-line >= bt-role-raid-floor)
        (or
            (unit-type-count-total camel-line >= bt-role-raid-floor)
            (unit-type-count-total cataphract-line >= bt-role-raid-floor)
        )
    )
=>
    (up-reset-group c: 8)
    (up-full-reset-search)
    (up-set-target-point byzantine-offensive-objective-point)
    (up-filter-distance c: -1 c: 60)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-local c: cavalry-class c: 40)
    (up-remove-objects search-local 19 != 2)
    (up-remove-objects search-local 73 != 9)
    (set-goal byzantine-army-role-selection-cap 4)
    (up-create-group 0 byzantine-army-role-selection-cap c: 8)
    (up-modify-group-flag 1 c: 8)
    (set-goal byzantine-army-role-formation-mask 40)
)

(defrule
    (goal byzantine-army-role-state byzantine-army-role-committed)
    (goal byzantine-army-role-formation-mask 40)
=>
    (up-get-group-size c: 5 byzantine-army-role-screen-size)
    (up-get-group-size c: 6 byzantine-army-role-main-size)
    (up-get-group-size c: 7 byzantine-army-role-siege-size)
    (up-get-group-size c: 8 byzantine-army-role-raid-size)
    (set-goal byzantine-army-role-formation-mask 41)
)

(defrule
    (goal byzantine-army-role-state byzantine-army-role-committed)
    (goal byzantine-army-role-formation-mask 41)
    (up-compare-goal byzantine-army-role-raid-size >= bt-role-raid-floor)
    (up-compare-goal byzantine-army-role-screen-size >= bt-role-screen-floor)
    (up-compare-goal byzantine-army-role-main-size >= bt-role-main-floor)
    (up-compare-goal byzantine-army-role-siege-size >= bt-role-siege-floor-standard)
=>
    (set-goal byzantine-army-role-state byzantine-army-role-raid-split)
)

(defrule
    (goal byzantine-army-role-state byzantine-army-role-committed)
    (goal byzantine-army-role-formation-mask 41)
    (up-compare-goal byzantine-army-role-raid-size < bt-role-raid-floor)
=>
    (up-reset-group c: 8)
    (set-goal byzantine-army-role-formation-mask 31)
)

; Raid returns when its world-state admission disappears.
(defrule
    (goal byzantine-army-role-state byzantine-army-role-raid-split)
    (or
        (goal byzantine-fortification-threat 1)
        (or
            (goal byzantine-offensive-objective-class byzantine-offensive-objective-class-siege)
            (or
                (goal byzantine-offensive-objective-class byzantine-offensive-objective-class-defense)
                (or
                    (goal byzantine-offensive-objective-claim 0)
                    (or
                        (goal byzantine-army-attack-ready 0)
                        (goal byzantine-army-overmatch-state byzantine-army-overmatch-triggered)
                    )
                )
            )
        )
    )
=>
    (set-goal byzantine-army-role-state byzantine-army-role-forming)
    (set-goal byzantine-army-role-formation-mask 0)
    (set-goal byzantine-army-role-fortified-latch 0)
    (up-reset-group c: 5)
    (up-reset-group c: 6)
    (up-reset-group c: 7)
    (up-reset-group c: 8)
    (up-reset-group c: 9)
)

; Fortified siege is a posture-edge witness, not a timer.
(defrule
    (goal byzantine-army-role-state byzantine-army-role-committed)
    (goal byzantine-siege-approach byzantine-siege-approach-normal)
    (goal byzantine-army-role-fortified-latch 1)
=>
    (set-goal byzantine-army-role-fortified-latch 0)
)

(defrule
    (goal byzantine-army-role-state byzantine-army-role-committed)
    (goal byzantine-fortification-threat 1)
    (goal byzantine-siege-approach byzantine-siege-approach-fortified)
    (goal byzantine-army-role-fortified-latch 0)
=>
    (up-get-group-size c: 7 byzantine-army-role-siege-size)
    (set-goal byzantine-army-role-formation-mask 50)
    (set-goal byzantine-army-role-fortified-latch 1)
)

(defrule
    (goal byzantine-army-role-state byzantine-army-role-committed)
    (goal byzantine-fortification-threat 1)
    (goal byzantine-army-role-formation-mask 50)
    (up-compare-goal byzantine-army-role-siege-size < bt-role-siege-floor-fortified)
=>
    (set-goal byzantine-army-role-state byzantine-army-role-recovering)
    (set-goal byzantine-army-role-recovery-request 1)
    (up-reset-group c: 5)
    (up-reset-group c: 6)
    (up-reset-group c: 7)
    (up-reset-group c: 8)
    (up-reset-group c: 9)
    (set-goal byzantine-army-role-formation-mask 0)
    (set-goal byzantine-army-role-fortified-latch 0)
)

(defrule
    (goal byzantine-army-role-state byzantine-army-role-committed)
    (goal byzantine-fortification-threat 1)
    (goal byzantine-army-role-formation-mask 50)
    (up-compare-goal byzantine-army-role-siege-size >= bt-role-siege-floor-fortified)
=>
    (set-goal byzantine-army-role-formation-mask 31)
)


; Recovery bridge: role controller requests; army recovery owner clears attack-ready.
; No generic up-reset-attack-now is emitted here because that command is
; deliberately unsupported by the compiler's generic semantic adapter.
(defrule
    (goal byzantine-army-role-recovery-request 1)
=>
    (set-goal byzantine-army-role-recovery-request 0)
)

(defconst bt-imperial-fortified-trebuchet-target 3)
(defconst bt-imperial-fortified-bombard-target 3)
(defconst bt-imperial-fortified-ram-target 4)
; Persistent TC-aware farm policy. Values are unit/building counts, not goal IDs.
(defconst bt-castle-farm-target-1tc 12)
(defconst bt-castle-farm-target-2tc 20)
(defconst bt-castle-farm-target-3tc 30)
(defconst bt-imperial-farm-target-1tc 18)
(defconst bt-imperial-farm-target-2tc 26)
(defconst bt-imperial-farm-target-3tc 48)
(defconst bt-boom-mill-target-1tc 1)
(defconst bt-boom-mill-target-2tc 2)
(defconst bt-boom-mill-target-3tc 3)
(defconst construction-retry-barrier-economy-barracks-floor-1 266)

; Native control rule: strategy-posture-initialize-000
(defrule
    (goal strategy-posture 0)
=>
    (set-goal strategy-posture 0)
    (disable-self)
)

; Native control rule: strategy-posture-transition-001
(defrule
    (and (or (goal strategy-posture 1) (goal strategy-posture 3)) (and (current-age >= castle-age) (building-type-count-total castle >= 1)))
=>
    (set-goal strategy-posture 4)
)

; Native control rule: strategy-posture-transition-002
(defrule
    (and (or (goal strategy-posture 3) (goal strategy-posture 4)) (players-unit-type-count any-enemy knight >= 3))
=>
    (set-goal strategy-posture 1)
)

; Native control rule: strategy-posture-transition-003
(defrule
    (and (goal strategy-posture 1) (players-unit-type-count any-enemy knight < 3))
=>
    (set-goal strategy-posture 3)
)

; Native control rule: strategy-posture-transition-004
(defrule
    (and (goal strategy-posture 0) (current-age == dark-age))
=>
    (set-goal strategy-posture 3)
)

; Native control rule: strategy-posture-transition-005
(defrule
    (and (goal strategy-posture 0) (current-age >= feudal-age))
=>
    (set-goal strategy-posture 3)
)

; Native control rule: strategic-arbitration-state-initialize
(defrule
    (goal strategic-primary-intent 0)
=>
    (set-goal arb-o01 0)
    (set-goal arb-o02 0)
    (set-goal arb-o03 0)
    (set-goal arb-o04 0)
    (set-goal arb-o05 0)
    (set-goal arb-o06 0)
    (set-goal arb-o07 0)
    (set-goal arb-o08 0)
    (set-goal arb-o09 0)
    (set-goal arb-c01 0)
    (set-goal arb-c02 0)
    (set-goal arb-c03 0)
    (disable-self)
)

; Native control rule: strategic-arbitration-observation-enable-strategy-water-islands
(defrule
    (goal arb-o01 0)
    (map-type islands)
=>
    (set-goal arb-o01 1)
)

; Native control rule: strategic-arbitration-observation-disable-strategy-water-islands
(defrule
    (goal arb-o01 1)
    (not (map-type islands))
=>
    (set-goal arb-o01 0)
)

; Native control rule: strategic-arbitration-observation-enable-current-feudal-age
(defrule
    (goal arb-o02 0)
    (current-age >= feudal-age)
=>
    (set-goal arb-o02 1)
)

; Native control rule: strategic-arbitration-observation-disable-current-feudal-age
(defrule
    (goal arb-o02 1)
    (not (current-age >= feudal-age))
=>
    (set-goal arb-o02 0)
)

; Native control rule: strategic-arbitration-observation-enable-castle-complete
(defrule
    (goal arb-o03 0)
    (and (current-age >= castle-age) (building-type-count-total castle >= 1))
=>
    (set-goal arb-o03 1)
)

; Native control rule: strategic-arbitration-observation-disable-castle-complete
(defrule
    (goal arb-o03 1)
    (not (and (current-age >= castle-age) (building-type-count-total castle >= 1)))
=>
    (set-goal arb-o03 0)
)

; Native control rule: strategic-arbitration-observation-enable-current-imperial-age
(defrule
    (goal arb-o04 0)
    (current-age >= imperial-age)
=>
    (set-goal arb-o04 1)
)

; Native control rule: strategic-arbitration-observation-disable-current-imperial-age
(defrule
    (goal arb-o04 1)
    (not (current-age >= imperial-age))
=>
    (set-goal arb-o04 0)
)

; Native control rule: strategic-arbitration-observation-enable-strategy-enemy-pressure
(defrule
    (goal arb-o05 0)
    (or (players-unit-type-count any-enemy knight >= 3) (or (players-unit-type-count any-enemy archer-line >= 4) (players-unit-type-count any-enemy militia-line >= 5)))
=>
    (set-goal arb-o05 1)
)

; Native control rule: strategic-arbitration-observation-disable-strategy-enemy-pressure
(defrule
    (goal arb-o05 1)
    (not (or (players-unit-type-count any-enemy knight >= 3) (or (players-unit-type-count any-enemy archer-line >= 4) (players-unit-type-count any-enemy militia-line >= 5))))
=>
    (set-goal arb-o05 0)
)

; Native control rule: strategic-arbitration-observation-enable-strategy-castle-age
(defrule
    (goal arb-o06 0)
    (current-age >= castle-age)
=>
    (set-goal arb-o06 1)
)

; Native control rule: strategic-arbitration-observation-disable-strategy-castle-age
(defrule
    (goal arb-o06 1)
    (not (current-age >= castle-age))
=>
    (set-goal arb-o06 0)
)

; Native control rule: strategic-arbitration-observation-enable-strategy-arena-map
(defrule
    (goal arb-o07 0)
    (map-type arena)
=>
    (set-goal arb-o07 1)
)

; Native control rule: strategic-arbitration-observation-disable-strategy-arena-map
(defrule
    (goal arb-o07 1)
    (not (map-type arena))
=>
    (set-goal arb-o07 0)
)

; Native control rule: strategic-arbitration-observation-enable-strategy-town-center-capability
(defrule
    (goal arb-o08 0)
    (building-type-count-total 109 < 2)
=>
    (set-goal arb-o08 1)
)

; Native control rule: strategic-arbitration-observation-disable-strategy-town-center-capability
(defrule
    (goal arb-o08 1)
    (not (building-type-count-total 109 < 2))
=>
    (set-goal arb-o08 0)
)

; Native control rule: strategic-arbitration-observation-enable-strategy-town-center-complete
(defrule
    (goal arb-o09 0)
    (building-type-count-total 109 >= 2)
=>
    (set-goal arb-o09 1)
)

; Native control rule: strategic-arbitration-observation-disable-strategy-town-center-complete
(defrule
    (goal arb-o09 1)
    (not (building-type-count-total 109 >= 2))
=>
    (set-goal arb-o09 0)
)

; Native control rule: strategic-arbitration-candidate-enable-water-investment
(defrule
    (goal arb-c01 0)
    (goal arb-o01 1)
=>
    (set-goal arb-c01 1)
)

; Native control rule: strategic-arbitration-candidate-disable-water-investment
(defrule
    (goal arb-c01 1)
    (not (goal arb-o01 1))
=>
    (set-goal arb-c01 0)
)

; Native control rule: strategic-arbitration-candidate-enable-castle-trajectory
(defrule
    (goal arb-c02 0)
    (and (and (and (goal arb-o02 1) (goal arb-o03 0)) (goal arb-o04 0)) (goal arb-o01 0))
=>
    (set-goal arb-c02 1)
)

; Native control rule: strategic-arbitration-candidate-disable-castle-trajectory
; Castle trajectory is strategic intent, not a pressure veto.
; Enemy pressure is owned by the military layer; it may delay execution but must not
; erase the Castle/boom path and strand the construction demand.
(defrule
    (goal arb-c02 1)
    (not (and (and (and (goal arb-o02 1) (goal arb-o03 0)) (goal arb-o04 0)) (goal arb-o01 0)))
=>
    (set-goal arb-c02 0)
)

; Native control rule: strategic-arbitration-candidate-enable-two-tc-expansion
(defrule
    (goal arb-c03 0)
    (and (and (and (goal arb-o06 1) (goal arb-o08 1)) (goal arb-o03 1)) (goal arb-o01 0))
=>
    (set-goal arb-c03 1)
)

; Native control rule: strategic-arbitration-candidate-disable-two-tc-expansion
(defrule
    (goal arb-c03 1)
    (not (and (and (and (goal arb-o06 1) (goal arb-o08 1)) (goal arb-o03 1)) (goal arb-o01 0)))
=>
    (set-goal arb-c03 0)
)

; Native control rule: strategic-primary-intent-select-water-investment-from-0
(defrule
    (and (goal strategic-primary-intent 0) (goal arb-c01 1))
=>
    (set-goal strategic-primary-intent 1)
)

; Native control rule: strategic-primary-intent-select-castle-trajectory-from-0
(defrule
    (and (and (goal strategic-primary-intent 0) (goal arb-c02 1)) (not (goal arb-c01 1)))
=>
    (set-goal strategic-primary-intent 2)
)

; Native control rule: strategic-primary-intent-select-two-tc-expansion-from-0
(defrule
    (and (and (and (goal strategic-primary-intent 0) (goal arb-c03 1)) (not (goal arb-c01 1))) (not (goal arb-c02 1)))
=>
    (set-goal strategic-primary-intent 3)
)

; Native control rule: strategic-primary-intent-select-two-tc-expansion-from-2
(defrule
    (and (goal strategic-primary-intent 2) (goal arb-c03 1))
=>
    (set-goal strategic-primary-intent 3)
)

; Native control rule: strategic-primary-intent-release-castle-trajectory
(defrule
    (and (and (goal strategic-primary-intent 2) (goal arb-o03 1)) (not (goal arb-c03 1)))
=>
    (set-goal strategic-primary-intent 0)
)

; Native control rule: strategic-primary-intent-invalidate-castle-trajectory
(defrule
    (and (goal strategic-primary-intent 2) (goal arb-o04 1))
=>
    (set-goal strategic-primary-intent 0)
)

; Native control rule: counter-package-selection-reset-000
(defrule
    (current-age >= dark-age)
=>
    (set-goal counter-package-siege_pressure_castle 0)
    (set-goal counter-package-mounted_pressure_castle 0)
    (set-goal counter-package-infantry_pressure_castle 0)
    (set-goal counter-package-mounted_pressure_feudal 0)
    (set-goal counter-package-ranged_pressure_feudal 0)
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-minimal)
)

; Native control rule: counter-package-selection-001-infantry_pressure_castle
(defrule
    (and (current-age >= castle-age) (players-unit-type-count any-enemy militia-line >= 5))
=>
    (set-goal counter-package-infantry_pressure_castle 1)
)

; Native control rule: counter-package-selection-002-mounted_pressure_castle
(defrule
    (players-unit-type-count any-enemy knight >= 3)
=>
    (set-goal counter-package-mounted_pressure_castle 1)
)

; Native control rule: counter-package-selection-003-mounted_pressure_feudal
(defrule
    (current-age == feudal-age)
    (or
        (players-unit-type-count any-enemy scout-cavalry-line >= 3)
        (players-unit-type-count any-enemy knight >= 1)
    )
=>
    (set-goal counter-package-mounted_pressure_feudal 1)
)

; Native control rule: counter-package-selection-004-ranged_pressure_feudal
(defrule
    (and (current-age == feudal-age) (players-unit-type-count any-enemy archer-line >= 3))
=>
    (set-goal counter-package-ranged_pressure_feudal 1)
)

; Native control rule: counter-package-selection-005-siege_pressure_castle
(defrule
    (and (current-age >= castle-age) (players-unit-type-count any-enemy mangonel-line >= 2))
=>
    (set-goal counter-package-siege_pressure_castle 1)
)

;---------------------------------------------------------------
; PERSISTENT FEUDAL MILITARY PACKAGE ARBITRATION
; Community pattern translated into Byzantine policy:
; choose one executable Feudal package from observed enemy composition,
; then let the package's demand/recovery channels maintain the floor.
; Threat priority: mounted > ranged > infantry > anti-spear mobility.

; Standard open-land Feudal pressure starts from Archers rather than
; blindly provisioning every production building. Fast-Castle and water
; openings stay minimal unless an actual land threat is observed.
(defrule
    (current-age == feudal-age)
    (or
        (goal opening-plan 1)
        (goal opening-plan 2)
    )
    (not (players-unit-type-count any-enemy scout-cavalry-line >= 3))
    (not (players-unit-type-count any-enemy knight >= 1))
    (not (players-unit-type-count any-enemy archer-line >= 3))
    (not (players-unit-type-count any-enemy militia-line >= 5))
    (not (players-unit-type-count any-enemy 93 >= 4))
=>
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-archer)
)

; MAA is a supported offensive branch when sustained Barracks pressure is
; observed without a current ranged/cavalry threat. The branch then follows
; the community MAA -> Archer transition once the melee floor is reached.
(defrule
    (current-age == feudal-age)
    (goal opening-plan 1)
    (players-building-type-count any-enemy barracks >= 2)
    (players-unit-type-count any-enemy militia-line < 3)
    (players-unit-type-count any-enemy archer-line < 3)
    (players-unit-type-count any-enemy scout-cavalry-line < 3)
    (players-unit-type-count any-enemy knight < 1)
    (players-unit-type-count any-enemy 93 < 4)
=>
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-maa)
)

; Anti-infantry branch. Community scripting uses Archers as the standard
; switch when the opponent commits to Feudal infantry.
(defrule
    (current-age == feudal-age)
    (players-unit-type-count any-enemy militia-line >= 5)
    (players-unit-type-count any-enemy scout-cavalry-line < 3)
    (players-unit-type-count any-enemy knight < 1)
=>
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-archer)
)

; Anti-ranged branch. Byzantine cheap Skirmishers are the direct response.
(defrule
    (current-age == feudal-age)
    (players-unit-type-count any-enemy archer-line >= 3)
    (players-unit-type-count any-enemy scout-cavalry-line < 3)
    (players-unit-type-count any-enemy knight < 1)
=>
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-skirmisher)
)

; Anti-scout branch. Spears remain the hard floor, with the mobile
; Scout -> Archer package available against spear walls.
(defrule
    (current-age == feudal-age)
    (players-unit-type-count any-enemy 93 >= 4)
    (players-unit-type-count any-enemy scout-cavalry-line < 3)
    (players-unit-type-count any-enemy knight < 1)
    (players-unit-type-count any-enemy archer-line < 3)
=>
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-scout)
)

; Mixed mounted+ranged pressure gets the explicit cheap trash package. Pure
; mounted pressure keeps its spear-only floor instead of wasting food on skirms.
(defrule
    (current-age == feudal-age)
    (goal counter-package-mounted_pressure_feudal 1)
    (goal counter-package-ranged_pressure_feudal 1)
=>
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-trash)
)

; Fast-Castle and water openings remain minimal unless one of the explicit
; threat selectors above has already forced a response package.
(defrule
    (current-age == feudal-age)
    (or
        (goal opening-plan 3)
        (or (goal opening-plan 4) (goal opening-plan 5))
    )
    (players-unit-type-count any-enemy scout-cavalry-line < 3)
    (players-unit-type-count any-enemy archer-line < 3)
    (players-unit-type-count any-enemy militia-line < 5)
    (players-unit-type-count any-enemy 93 < 4)
=>
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-minimal)
)

; Package -> demand activation. Demands are reasserted persistently; the
; lifecycle itself owns completion, release, and loss recovery.
(defrule
    (current-age == feudal-age)
    (or
        (goal byzantine-feudal-army-package byzantine-feudal-package-archer)
        (or
            (goal byzantine-feudal-army-package byzantine-feudal-package-scout)
            (and
                (goal byzantine-feudal-army-package byzantine-feudal-package-maa)
                (unit-type-count-total militia-line >= bt-feudal-maa-floor)
            )
        )
    )
    (goal demand-feudal-archer-floor 0)
    (unit-type-count-total archer-line < bt-feudal-archer-floor)
=>
    (set-goal demand-feudal-archer-floor 1)
)

(defrule
    (current-age == feudal-age)
    (goal byzantine-feudal-army-package byzantine-feudal-package-scout)
    (goal demand-feudal-scout-floor 0)
    (unit-type-count-total scout-cavalry-line < bt-feudal-scout-floor)
=>
    (set-goal demand-feudal-scout-floor 1)
)

(defrule
    (current-age == feudal-age)
    (goal byzantine-feudal-army-package byzantine-feudal-package-maa)
    (goal demand-feudal-maa-upgrade 0)
    (not (research-completed ri-man-at-arms))
=>
    (set-goal demand-feudal-maa-upgrade 1)
)

(defrule
    (current-age == feudal-age)
    (goal byzantine-feudal-army-package byzantine-feudal-package-maa)
    (research-completed ri-man-at-arms)
    (goal demand-feudal-maa-floor 0)
    (unit-type-count-total militia-line < bt-feudal-maa-floor)
=>
    (set-goal demand-feudal-maa-floor 1)
)

(defrule
    (current-age == feudal-age)
    (goal byzantine-feudal-army-package byzantine-feudal-package-trash)
=>
    (set-goal demand-counter-mounted-spears 1)
    (set-goal demand-counter-ranged-skirmishers 1)
)

; Scout package and MAA package both gain ranged follow-up, matching common
; Scouts->Archers and MAA->Archers community transitions.
(defrule
    (current-age == feudal-age)
    (or
        (goal byzantine-feudal-army-package byzantine-feudal-package-scout)
        (and
            (goal byzantine-feudal-army-package byzantine-feudal-package-maa)
            (unit-type-count-total militia-line >= bt-feudal-maa-floor)
        )
    )
    (goal demand-feudal-archer-floor 0)
    (unit-type-count-total archer-line < bt-feudal-archer-floor)
=>
    (set-goal demand-feudal-archer-floor 1)
)

; Conditional infrastructure: do not spend a Feudal building on a Stable
; or Range until the selected military package actually needs it.
(defrule
    (current-age == feudal-age)
    (or
        (goal byzantine-feudal-army-package byzantine-feudal-package-archer)
        (or
            (goal byzantine-feudal-army-package byzantine-feudal-package-skirmisher)
            (or
                (goal byzantine-feudal-army-package byzantine-feudal-package-scout)
                (or
                    (goal byzantine-feudal-army-package byzantine-feudal-package-maa)
                    (goal byzantine-feudal-army-package byzantine-feudal-package-trash)
                )
            )
        )
    )
    (goal demand-castle-archery-capability 0)
    (not (building-type-count archery-range >= 1))
=>
    (set-goal demand-castle-archery-capability 1)
)

(defrule
    (current-age == feudal-age)
    (goal byzantine-feudal-army-package byzantine-feudal-package-scout)
    (goal demand-castle-stable-capability 0)
    (not (building-type-count stable >= 1))
=>
    (set-goal demand-castle-stable-capability 1)
)

