;----------------------------------------------------------------
; CASTLE-AGE RESEARCH LIFECYCLE
;----------------------------------------------------------------
; This lifecycle advances the civilization to Castle Age. It does not build
; a Castle and never touches demand-castle-commitment.
;
; Community-derived policy:
;   Feudal maturity (28 villagers)
;   + Blacksmith + Market witnessed
;   + native Castle research feasibility
;   + Byzantine resource claim
;   -> stop ordinary civilian spending while the Castle bank owns food/gold
;   -> issue Castle Age research
;   -> witness current-age >= castle-age
;   -> release the claim and resume normal economy.
;
; The Market is the same existing Market demand used elsewhere in this bot;
; the research lifecycle merely makes the Market an explicit prerequisite for
; the Castle bank rather than treating Market construction as Castle building.

; Release: castle-age-transition | COMPLETE -> RELEASED
(defrule
    (goal demand-castle-age-transition 277)
    (current-age >= castle-age)
=>
    (set-goal demand-castle-age-transition 0)
    (set-goal byzantine-resource-claim 0)
)

; Completion witness: castle-age-transition | PENDING/ISSUED -> COMPLETE
(defrule
    (or
        (goal demand-castle-age-transition 278)
        (goal demand-castle-age-transition 276)
    )
    (current-age >= castle-age)
=>
    (set-goal demand-castle-age-transition 277)
)

; Pending admission: Castle research is already in flight.
(defrule
    (or
        (goal demand-castle-age-transition 278)
        (goal demand-castle-age-transition 276)
    )
    (not (current-age >= castle-age))
    (up-research-status c: 102 >= 2)
=>
    (set-goal demand-castle-age-transition 276)
)

; RETRY | ISSUED/PENDING -> ACTIVE when native research is no longer pending.
(defrule
    (or
        (goal demand-castle-age-transition 278)
        (goal demand-castle-age-transition 276)
    )
    (not (current-age >= castle-age))
    (not (up-research-status c: 102 >= 2))
=>
    (set-goal demand-castle-age-transition 1)
    (set-goal research-retry-barrier-castle-age-transition 1)
)

; Action issuance: Castle Age research owns the existing Byzantine resource claim.
; Market and Blacksmith are completed Feudal prerequisites; the native
; can-research-with-escrow fact remains the final engine feasibility gate.
(defrule
    (goal demand-castle-age-transition 1)
    (goal research-retry-barrier-castle-age-transition 0)
    (not (current-age >= castle-age))
    (current-age == feudal-age)
    (unit-type-count-total villager >= bt-castle-age-villager-maturity)
    (building-type-count-total blacksmith >= 1)
    (building-type-count-total market >= 1)
    (goal byzantine-resource-claim 0)
    (can-research-with-escrow castle-age)
=>
    (set-goal byzantine-resource-claim 2)
    (release-escrow food)
    (release-escrow gold)
    (research castle-age)
    (set-goal demand-castle-age-transition 278)
)

; Resource-claim cleanup after Castle Age witness.
(defrule
    (goal byzantine-resource-claim 2)
    (goal demand-castle-age-transition 0)
=>
    (set-goal byzantine-resource-claim 0)
)

; Persistent civilian production

; Community-native arbitration: civilian production runs while population capacity
; and the Byzantine resource claim are both available. The Feudal claim is asserted
; only after maturity and native research feasibility are simultaneously true.
(defrule
    (unit-type-count-total villager < 110)
    (population-headroom > 0)
    (can-train villager)
    (not (goal byzantine-resource-claim 1))
    (not (goal byzantine-resource-claim 2))
    (not (goal byzantine-resource-claim 3))
=>
    (train villager)
)

