; Aggressive defensive expansion: once the tower network exists and the
; strategic arbiter owns the two-TC expansion intent, the guard-tower lifecycle
; remains open until a second Guard Tower exists. Its higher-priority action
; below uses build-forward so the defense projects toward the map instead of
; collapsing back around the home TC.
(defrule
    (goal byzantine-university-state byzantine-university-state-tower-network)
    (goal strategic-primary-intent 3)
    (not (town-under-attack))
    (building-type-count guard-tower < 2)
    (goal demand-adaptive-guard-tower 0)
=>
    (set-goal demand-adaptive-guard-tower 1)
)

; Chemistry is a gunline capability unlock, not an unconditional Imperial purchase.
(defrule
    (current-age >= imperial-age)
    (building-type-count university >= 1)
    (not (research-completed chemistry))
    (goal demand-research-chemistry 0)
    (or
        (goal byzantine-university-state byzantine-university-state-imperial-gunline)
        (or
            (goal demand-imperial-bombard-floor 1)
            (or
                (unit-type-count bombard-cannon >= 1)
                (building-type-count bombard-tower >= 1)
            )
        )
    )
=>
    (set-goal demand-research-chemistry 1)
)

; Defensive research demand arming is state-driven and world-state-driven.
(defrule
    (or
        (goal byzantine-university-state byzantine-university-state-hardened-perimeter)
        (goal byzantine-university-state byzantine-university-state-tower-network)
    )
    (goal demand-byzantine-university-fortified-wall 0)
    (not (research-completed 194))
    (building-type-count 117 >= 1)
=>
    (set-goal demand-byzantine-university-fortified-wall 1)
)

(defrule
    (or
        (goal byzantine-university-state byzantine-university-state-castle)
        (or
                (goal byzantine-university-state byzantine-university-state-hardened-perimeter)
                (goal byzantine-university-state byzantine-university-state-tower-network)
            )
    )
    (goal demand-byzantine-university-guard-tower 0)
    (not (research-completed 140))
    (goal demand-adaptive-guard-tower 1)
=>
    (set-goal demand-byzantine-university-guard-tower 1)
)

(defrule
    (or
        (goal byzantine-university-state byzantine-university-state-hardened-perimeter)
        (or
                (goal byzantine-university-state byzantine-university-state-tower-network)
                (goal byzantine-university-state byzantine-university-state-imperial-gunline)
            )
    )
    (goal demand-byzantine-university-ballistics 0)
    (not (research-completed 93))
    (or
        (building-type-count guard-tower >= 1)
        (or
                (building-type-count castle >= 1)
                (or
                        (building-type-count keep >= 1)
                        (building-type-count bombard-tower >= 1)
                    )
            )
    )
=>
    (set-goal demand-byzantine-university-ballistics 1)
)

(defrule
    (or
        (goal byzantine-university-state byzantine-university-state-hardened-perimeter)
        (goal byzantine-university-state byzantine-university-state-tower-network)
    )
    (goal demand-byzantine-university-murder-holes 0)
    (not (research-completed 322))
    (or
        (town-under-attack)
        (town-under-attack)
    )
    (or
        (players-unit-type-count any-enemy knight >= 2)
        (players-unit-type-count any-enemy militia-line >= 4)
    )
=>
    (set-goal demand-byzantine-university-murder-holes 1)
)

(defrule
    (or
        (goal byzantine-university-state byzantine-university-state-hardened-perimeter)
        (goal byzantine-university-state byzantine-university-state-tower-network)
    )
    (goal demand-byzantine-university-treadmill-crane 0)
    (not (research-completed 54))
    (or
        (up-pending-objects c: 117 >= 1)
        (or
                (up-pending-objects c: 72 >= 1)
                (or
                        (up-pending-objects c: 234 >= 1)
                        (up-pending-objects c: 235 >= 1)
                    )
            )
    )
=>
    (set-goal demand-byzantine-university-treadmill-crane 1)
)

(defrule
    (goal byzantine-university-state byzantine-university-state-imperial-gunline)
    (goal demand-byzantine-university-arrowslits 0)
    (not (research-completed 608))
    (or
        (building-type-count guard-tower >= 2)
        (or
                (building-type-count keep >= 1)
                (building-type-count bombard-tower >= 1)
            )
    )
=>
    (set-goal demand-byzantine-university-arrowslits 1)
)

; Shared Byzantine Greek Fire channel. The existing water lifecycle owns
; execution so naval and land-defensive demands can never issue the same tech twice.
(defrule
    (goal demand-water-greek-fire 0)
    (not (research-completed 464))
    (building-type-count castle >= 1)
    (or
        (building-type-count-total bombard-tower >= 1)
        (or
            (building-type-count-total bombard-cannon >= 1)
            (goal byzantine-university-state byzantine-university-state-imperial-gunline)
        )
    )
=>
    (set-goal demand-water-greek-fire 1)
)


; Pending diagnostics: adaptive-outpost
; PENDING-DIAGNOSTIC [INFO] PENDING-ACTION-GUARD: action is gated by active goal 42 and cannot reissue from pending goal 43
; PENDING-DIAGNOSTIC [INFO] PENDING-WITNESS-GUARD: completion witness is evaluated only while pending goal 43 is active
; PENDING-DIAGNOSTIC [INFO] PENDING-RELEASE-GUARD: release is evaluated only after completion goal 44 is reached
; PENDING-DIAGNOSTIC [INFO] PENDING-ACTION-WITNESS-SEPARATE: action 'build' is not treated as completion evidence; witness 'building-type-count' owns completion
; PENDING-DIAGNOSTIC [INFO] PENDING-RELEASE-SEPARATE: release remains separate from witness 'building-type-count' and may clear the demand only from complete state
; Issuance failure: adaptive-outpost | RETAIN-ACTIVE
; An unsatisfied issuance guard leaves demand-adaptive-outpost in ACTIVE; it is not PENDING.
; Release: adaptive-outpost | COMPLETE -> RELEASED
(defrule
    (goal demand-adaptive-outpost 44)
    (building-type-count outpost > 0)
=>
    (set-goal demand-adaptive-outpost 0)
)

; Recovery: adaptive-outpost | RELEASED -> ACTIVE on world-state loss
(defrule
    (goal demand-adaptive-outpost 0)
    (not (building-type-count outpost >= 1))
    (or (players-unit-type-count any-enemy knight >= 3) (or (players-unit-type-count any-enemy archer-line >= 4) (players-unit-type-count any-enemy militia-line >= 5)))
=>
    (set-goal demand-adaptive-outpost 1)
)

; Construction observation: adaptive-outpost
; Precedence: COMPLETE > FOUNDATION_PENDING > PLACEMENT_PENDING > RETRY
; Completion witness: adaptive-outpost | PENDING/ISSUED -> COMPLETE
; COMPLETE | ISSUED/PENDING -> COMPLETE
(defrule
    (or
        (goal demand-adaptive-outpost 45)
        (goal demand-adaptive-outpost 43)
    )
    (building-type-count outpost >= 1)
=>
    (set-goal demand-adaptive-outpost 44)
)

; Pending admission: adaptive-outpost | ISSUED/PENDING -> PENDING
(defrule
    (or
        (goal demand-adaptive-outpost 45)
        (goal demand-adaptive-outpost 43)
    )
    (not (building-type-count outpost >= 1))
    (up-pending-objects c: 598 >= 1)
=>
    (set-goal demand-adaptive-outpost 43)
)

; PLACEMENT_PENDING | ISSUED/PENDING -> PENDING
(defrule
    (or
        (goal demand-adaptive-outpost 45)
        (goal demand-adaptive-outpost 43)
    )
    (not (building-type-count outpost >= 1))
    (up-pending-objects c: 598 == 0)
    (up-pending-placement c: 598)
=>
    (set-goal demand-adaptive-outpost 43)
)

; RETRY | ISSUED/PENDING -> ACTIVE
(defrule
    (or
        (goal demand-adaptive-outpost 45)
        (goal demand-adaptive-outpost 43)
    )
    (not (building-type-count outpost >= 1))
    (up-pending-objects c: 598 == 0)
    (not (up-pending-placement c: 598))
=>
    (set-goal demand-adaptive-outpost 1)
    (set-goal construction-retry-barrier-adaptive-outpost 1)
)

; Action issuance: adaptive-outpost | ACTIVE -> ISSUED
(defrule
    (goal demand-adaptive-outpost 1)
    (not (building-type-count outpost >= 1))
    (goal construction-retry-barrier-adaptive-outpost 0)
    (up-pending-objects c: 598 == 0)
    (not (up-pending-placement c: 598))
    (not (building-type-count outpost > 0))
    (goal action-claim-build-pass-singleton 0)
    (can-build outpost)
=>
    (build outpost)
    (set-goal action-claim-build-pass-singleton 1)
    (set-goal demand-adaptive-outpost 45)
)

; Pending diagnostics: adaptive-watch-tower
; PENDING-DIAGNOSTIC [INFO] PENDING-ACTION-GUARD: action is gated by active goal 44 and cannot reissue from pending goal 45
; PENDING-DIAGNOSTIC [INFO] PENDING-WITNESS-GUARD: completion witness is evaluated only while pending goal 45 is active
; PENDING-DIAGNOSTIC [INFO] PENDING-RELEASE-GUARD: release is evaluated only after completion goal 46 is reached
; PENDING-DIAGNOSTIC [INFO] PENDING-ACTION-WITNESS-SEPARATE: action 'build' is not treated as completion evidence; witness 'building-type-count' owns completion
; PENDING-DIAGNOSTIC [INFO] PENDING-RELEASE-SEPARATE: release remains separate from witness 'building-type-count' and may clear the demand only from complete state
; Issuance failure: adaptive-watch-tower | RETAIN-ACTIVE
; An unsatisfied issuance guard leaves demand-adaptive-watch-tower in ACTIVE; it is not PENDING.
; Release: adaptive-watch-tower | COMPLETE -> RELEASED
(defrule
    (goal demand-adaptive-watch-tower 46)
    (building-type-count 79 > 0)
=>
    (set-goal demand-adaptive-watch-tower 0)
)

; Recovery: adaptive-watch-tower | RELEASED -> ACTIVE on world-state loss
(defrule
    (goal demand-adaptive-watch-tower 0)
    (not (building-type-count 79 >= 1))
    (or (players-unit-type-count any-enemy knight >= 3) (or (players-unit-type-count any-enemy archer-line >= 4) (players-unit-type-count any-enemy militia-line >= 5)))
    (not (current-age >= imperial-age))
=>
    (set-goal demand-adaptive-watch-tower 1)
)

; Construction observation: adaptive-watch-tower
; Precedence: COMPLETE > FOUNDATION_PENDING > PLACEMENT_PENDING > RETRY
; Completion witness: adaptive-watch-tower | PENDING/ISSUED -> COMPLETE
; COMPLETE | ISSUED/PENDING -> COMPLETE
(defrule
    (or
        (goal demand-adaptive-watch-tower 47)
        (goal demand-adaptive-watch-tower 45)
    )
    (building-type-count 79 >= 1)
=>
    (set-goal demand-adaptive-watch-tower 46)
)

; Pending admission: adaptive-watch-tower | ISSUED/PENDING -> PENDING
(defrule
    (or
        (goal demand-adaptive-watch-tower 47)
        (goal demand-adaptive-watch-tower 45)
    )
    (not (building-type-count 79 >= 1))
    (up-pending-objects c: 79 >= 1)
=>
    (set-goal demand-adaptive-watch-tower 45)
)

; PLACEMENT_PENDING | ISSUED/PENDING -> PENDING
(defrule
    (or
        (goal demand-adaptive-watch-tower 47)
        (goal demand-adaptive-watch-tower 45)
    )
    (not (building-type-count 79 >= 1))
    (up-pending-objects c: 79 == 0)
    (up-pending-placement c: 79)
=>
    (set-goal demand-adaptive-watch-tower 45)
)

; RETRY | ISSUED/PENDING -> ACTIVE
(defrule
    (or
        (goal demand-adaptive-watch-tower 47)
        (goal demand-adaptive-watch-tower 45)
    )
    (not (building-type-count 79 >= 1))
    (up-pending-objects c: 79 == 0)
    (not (up-pending-placement c: 79))
=>
    (set-goal demand-adaptive-watch-tower 1)
    (set-goal construction-retry-barrier-adaptive-watch-tower 1)
)

; Action issuance: adaptive-watch-tower | ACTIVE -> ISSUED
(defrule
    (goal demand-adaptive-watch-tower 1)
    (not (building-type-count 79 >= 1))
    (goal construction-retry-barrier-adaptive-watch-tower 0)
    (up-pending-objects c: 79 == 0)
    (not (up-pending-placement c: 79))
    (not (building-type-count 79 > 0))
    (goal action-claim-build-pass-singleton 0)
    (current-age >= feudal-age)
    (can-build 79)
    (or (players-unit-type-count any-enemy knight >= 3) (players-unit-type-count any-enemy militia-line >= 5))
=>
    (build 79)
    (set-goal action-claim-build-pass-singleton 1)
    (set-goal demand-adaptive-watch-tower 47)
)


; =============================================================================
; PROFESSIONAL BYZANTINE WALL CONTROL
; Naga/community-derived execution pattern, adapted to Byzantine priorities.
;
; Policy:
;   DARK/FEUDAL: short palisade resource funnel, only when pressure + exposure
;                justify wood. Prefer gold, then stone, then wood.
;   CASTLE+:     stone wall only after the Castle stone floor survives.
;   NATIVE:      native perimeter is a late fallback when local DUC geometry
;                has no viable anchor pair. Native perimeter gets a gate.
;
; Resource walls use one persisted local point. Pending is queue protection;
; completion uses a world-position wall witness. Wall/gate repair is already
; covered by sn-object-repair-level 30727 above.
; =============================================================================

; Wall admission: reset material policy when there is no live wall demand.
(defrule
    (goal demand-adaptive-stone-wall 0)
    (goal demand-adaptive-resource-palisade 0)
    (up-compare-goal byzantine-wall-material != byzantine-wall-material-none)
=>
    (set-goal byzantine-wall-material byzantine-wall-material-none)
    (set-goal byzantine-wall-gate-policy byzantine-wall-gate-none)
)

; DARK emergency: under immediate attack, spend a small wood reserve on a
; short local palisade around an exposed resource. This is the step-one
; Byzantine defensive signature, not an unconditional Dark wall.
(defrule
    (goal demand-adaptive-resource-palisade 0)
    (goal byzantine-wall-resource-state byzantine-wall-resource-idle)
    (current-age == dark-age)
    (or
        (town-under-attack)
        (town-under-attack)
    )
    (or
        (dropsite-min-distance gold >= 7)
        (or
                (dropsite-min-distance stone >= 7)
                (dropsite-min-distance wood >= 7)
            )
    )
    (wood-amount >= 75)
=>
    (set-goal demand-adaptive-resource-palisade 1)
    (set-goal byzantine-wall-resource-state byzantine-wall-resource-acquire)
    (set-goal byzantine-wall-resource-target 0)
    (set-goal byzantine-wall-material byzantine-wall-material-palisade)
)

; DARK standard: use the normal 60-80 wood defensive budget when the position
; is threatened but not yet in emergency mode.
(defrule
    (goal demand-adaptive-resource-palisade 0)
    (goal byzantine-wall-resource-state byzantine-wall-resource-idle)
    (current-age == dark-age)
    (or
        (town-under-attack)
        (town-under-attack)
    )
    (or
        (dropsite-min-distance gold >= 7)
        (or
                (dropsite-min-distance stone >= 7)
                (dropsite-min-distance wood >= 7)
            )
    )
    (wood-amount >= 100)
=>
    (set-goal demand-adaptive-resource-palisade 1)
    (set-goal byzantine-wall-resource-state byzantine-wall-resource-acquire)
    (set-goal byzantine-wall-resource-target 0)
    (set-goal byzantine-wall-material byzantine-wall-material-palisade)
)

; FEUDAL: preserve the Castle trajectory while using cheap palisades as the
; first defensive layer. Existing tower/anchor geometry remains available.
(defrule
    (goal demand-adaptive-resource-palisade 0)
    (goal byzantine-wall-resource-state byzantine-wall-resource-idle)
    (current-age == feudal-age)
    (or
        (players-unit-type-count any-enemy knight >= 2)
        (or
                (players-unit-type-count any-enemy archer-line >= 4)
                (or
                        (players-unit-type-count any-enemy militia-line >= 5)
                        (town-under-attack)
                    )
            )
    )
    (or
        (dropsite-min-distance gold >= 7)
        (or
                (dropsite-min-distance stone >= 7)
                (dropsite-min-distance wood >= 7)
            )
    )
    (wood-amount >= 60)
=>
    (set-goal demand-adaptive-resource-palisade 1)
    (set-goal byzantine-wall-resource-state byzantine-wall-resource-acquire)
    (set-goal byzantine-wall-resource-target 0)
    (set-goal byzantine-wall-material byzantine-wall-material-palisade)
)

; CASTLE+: stone becomes available for defensive capital only after the
; Castle-reserve floor is satisfied. The wall demand is still threat-driven.
(defrule
    (goal demand-adaptive-stone-wall 0)
    (not (building-type-count 117 >= 1))
    (current-age >= castle-age)
    (or
        (players-unit-type-count any-enemy knight >= 3)
        (or
                (players-unit-type-count any-enemy archer-line >= 4)
                (or
                        (players-unit-type-count any-enemy militia-line >= 5)
                        (or
                                (players-unit-type-count any-enemy mangonel-line >= 2)
                                (or
                                        (players-building-type-count any-enemy 82 >= 1)
                                        (town-under-attack)
                                    )
                            )
                    )
            )
    )
    (stone-amount >= 650)
=>
    (set-goal demand-adaptive-stone-wall 1)
    (set-goal byzantine-wall-material byzantine-wall-material-stone)
    (set-goal byzantine-wall-gate-policy byzantine-wall-gate-required)
)

; -------------------------------------------------------------------------
; Resource-front target acquisition.
; Gold is first priority; stone is next once Feudal is reached; wood is the
; fallback. This follows Naga's proven up-find-resource + point-line pattern.
; -------------------------------------------------------------------------
(defrule
    (goal demand-adaptive-resource-palisade 1)
    (goal byzantine-wall-resource-state byzantine-wall-resource-acquire)
    (goal byzantine-wall-resource-target 0)
    (resource-found gold)
    (dropsite-min-distance gold >= 7)
=>
    (up-full-reset-search)
    (up-find-resource c: gold c: 8)
    (set-goal byzantine-wall-resource-target byzantine-wall-resource-target-gold)
    (set-goal byzantine-wall-resource-state byzantine-wall-resource-selected)
)

(defrule
    (goal demand-adaptive-resource-palisade 1)
    (goal byzantine-wall-resource-state byzantine-wall-resource-acquire)
    (goal byzantine-wall-resource-target 0)
    (current-age >= feudal-age)
    (not (dropsite-min-distance gold >= 7))
    (resource-found stone)
    (dropsite-min-distance stone >= 7)
=>
    (up-full-reset-search)
    (up-find-resource c: stone c: 8)
    (set-goal byzantine-wall-resource-target byzantine-wall-resource-target-stone)
    (set-goal byzantine-wall-resource-state byzantine-wall-resource-selected)
)

(defrule
    (goal demand-adaptive-resource-palisade 1)
    (goal byzantine-wall-resource-state byzantine-wall-resource-acquire)
    (goal byzantine-wall-resource-target 0)
    (not (dropsite-min-distance gold >= 7))
    (not (dropsite-min-distance stone >= 7))
    (resource-found wood)
    (dropsite-min-distance wood >= 7)
=>
    (up-full-reset-search)
    (up-find-resource c: wood c: 8)
    (set-goal byzantine-wall-resource-target byzantine-wall-resource-target-wood)
    (set-goal byzantine-wall-resource-state byzantine-wall-resource-selected)
)

(defrule
    (goal demand-adaptive-resource-palisade 1)
    (goal byzantine-wall-resource-state byzantine-wall-resource-selected)
    (up-set-target-object search-remote c: 0)
=>
    (up-get-point position-object byzantine-wall-resource-point)
    (up-copy-point byzantine-wall-resource-line-a byzantine-wall-resource-point)
    (up-copy-point byzantine-wall-resource-line-b byzantine-wall-resource-point)
    (up-modify-goal byzantine-wall-resource-line-a c:- 2)
    (up-modify-goal byzantine-wall-resource-line-b c:+ 2)
    (set-goal byzantine-wall-resource-state byzantine-wall-resource-armed)
)

; Resource-front palisade action. One pass, one build claim, two wall-class
; builders, exactly as the practical community pattern uses them.
(defrule
    (goal demand-adaptive-resource-palisade 1)
    (goal byzantine-wall-resource-state byzantine-wall-resource-armed)
    (goal action-claim-build-pass-singleton 0)
    (goal construction-retry-barrier-adaptive-resource-palisade 0)
    (up-pending-objects c: 72 == 0)
    (not (up-pending-placement c: 72))
    (not (up-pending-objects c: house >= 1))
    (not (up-pending-placement c: house))
    (not (up-pending-objects c: barracks >= 1))
    (not (up-pending-placement c: barracks))
    (up-can-build-line 0 byzantine-wall-resource-line-a c: 72)
=>
    (up-assign-builders c: wall-class c: 1)
    (up-build-line byzantine-wall-resource-line-a byzantine-wall-resource-line-b c: 72)
    (set-goal action-claim-build-pass-singleton 1)
    (set-goal demand-adaptive-resource-palisade 490)
)

; Resource-wall completion witness. The wall must actually occupy the intended
; resource point; generic wall existence is deliberately not sufficient.
(defrule
    (or
        (goal demand-adaptive-resource-palisade 490)
        (goal demand-adaptive-resource-palisade 491)
    )
    (up-point-contains byzantine-wall-resource-point c: wall-class)
=>
    (set-goal demand-adaptive-resource-palisade 492)
    (set-goal byzantine-wall-resource-state byzantine-wall-resource-secured)
)

; Pending object / placement protection.
(defrule
    (or
        (goal demand-adaptive-resource-palisade 490)
        (goal demand-adaptive-resource-palisade 491)
    )
    (not (up-point-contains byzantine-wall-resource-point c: wall-class))
    (or
        (up-pending-objects c: 72 >= 1)
        (up-pending-placement c: 72)
    )
=>
    (set-goal demand-adaptive-resource-palisade 491)
)

; Retry after pending clears. Failure is execution loss, not strategic
; invalidation.
(defrule
    (or
        (goal demand-adaptive-resource-palisade 490)
        (goal demand-adaptive-resource-palisade 491)
    )
    (not (up-point-contains byzantine-wall-resource-point c: wall-class))
    (up-pending-objects c: 72 == 0)
    (not (up-pending-placement c: 72))
=>
    (set-goal demand-adaptive-resource-palisade 1)
    (set-goal construction-retry-barrier-adaptive-resource-palisade 1)
    (set-goal byzantine-wall-resource-state byzantine-wall-resource-armed)
)

; Release only from world-state completion.
(defrule
    (goal demand-adaptive-resource-palisade 492)
    (up-point-contains byzantine-wall-resource-point c: wall-class)
=>
    (set-goal demand-adaptive-resource-palisade 0)
)

; Reopen only after the actual local wall is gone and the original pressure
; still exists. Repair remains automatic through sn-object-repair-level.
(defrule
    (goal demand-adaptive-resource-palisade 0)
    (goal byzantine-wall-resource-state byzantine-wall-resource-secured)
    (not (up-point-contains byzantine-wall-resource-point c: wall-class))
    (or
        (town-under-attack)
        (town-under-attack)
    )
    (or
        (dropsite-min-distance gold >= 7)
        (or
                (dropsite-min-distance stone >= 7)
                (dropsite-min-distance wood >= 7)
            )
    )
=>
    (set-goal byzantine-wall-resource-state byzantine-wall-resource-idle)
    (set-goal demand-adaptive-resource-palisade 1)
)

; If no usable resource point survived acquisition, abandon this local funnel
; cleanly and let the broader anchor/perimeter wall demand reassess.
(defrule
    (goal demand-adaptive-resource-palisade 1)
    (goal byzantine-wall-resource-state byzantine-wall-resource-selected)
    (not (up-set-target-object search-remote c: 0))
=>
    (set-goal demand-adaptive-resource-palisade 0)
    (set-goal byzantine-wall-resource-state byzantine-wall-resource-idle)
)

; -------------------------------------------------------------------------
; Native perimeter fallback. This is deliberately lower priority than the
; existing local DUC anchor geometry because DUC is better for Byzantine
; resource/camp funnels. The native path is for a strategic enclosure.
; -------------------------------------------------------------------------
(defrule
    (goal demand-adaptive-stone-wall 1)
    (goal byzantine-wall-material byzantine-wall-material-stone)
    (goal byzantine-wall-native-state byzantine-wall-native-idle)
    (goal byzantine-wall-anchor-pair 0)
    (current-age >= castle-age)
    (stone-amount >= 650)
    (goal action-claim-build-pass-singleton 0)
    (up-pending-objects c: 117 == 0)
    (not (up-pending-placement c: 117))
    (can-afford-complete-wall byzantine-wall-native-perimeter stone-wall-line)
    (can-build-wall byzantine-wall-native-perimeter stone-wall-line)
=>
    (set-strategic-number sn-gate-type-for-wall 0)
    (set-goal byzantine-wall-gate-policy byzantine-wall-gate-required)
    (build-wall byzantine-wall-native-perimeter stone-wall-line)
    (set-goal action-claim-build-pass-singleton 1)
    (set-goal byzantine-wall-native-state byzantine-wall-native-wall-armed)
    (set-goal demand-adaptive-stone-wall 46)
)

(defrule
    (goal byzantine-wall-native-state byzantine-wall-native-wall-armed)
    (wall-completed-percentage byzantine-wall-native-perimeter >= 42)
    (goal action-claim-build-pass-singleton 0)
    (gate-count byzantine-wall-native-perimeter == 0)
    (can-build-gate byzantine-wall-native-perimeter)
=>
    (set-strategic-number sn-gate-type-for-wall 0)
    (build-gate byzantine-wall-native-perimeter)
    (set-goal action-claim-build-pass-singleton 1)
    (set-goal byzantine-wall-native-state byzantine-wall-native-gate-armed)
)

(defrule
    (goal byzantine-wall-native-state byzantine-wall-native-gate-armed)
    (gate-count byzantine-wall-native-perimeter >= 1)
=>
    (set-goal byzantine-wall-native-state byzantine-wall-native-idle)
    (set-goal byzantine-wall-gate-policy byzantine-wall-gate-none)
    (set-goal byzantine-wall-material byzantine-wall-material-none)
)

; Native perimeter completion is independent of action issuance. The existing
; wall lifecycle still owns demand release through a world-state building witness.

; Pending diagnostics: adaptive-stone-wall
; PENDING-DIAGNOSTIC [INFO] PENDING-ACTION-GUARD: action is gated by active goal 43 and cannot reissue from pending goal 44
; PENDING-DIAGNOSTIC [INFO] PENDING-WITNESS-GUARD: completion witness is evaluated only while pending goal 44 is active
; PENDING-DIAGNOSTIC [INFO] PENDING-RELEASE-GUARD: release is evaluated only after completion goal 45 is reached
; PENDING-DIAGNOSTIC [INFO] PENDING-ACTION-WITNESS-SEPARATE: action 'build' is not treated as completion evidence; witness 'building-type-count' owns completion
; PENDING-DIAGNOSTIC [INFO] PENDING-RELEASE-SEPARATE: release remains separate from witness 'building-type-count' and may clear the demand only from complete state
; Issuance failure: adaptive-stone-wall | RETAIN-ACTIVE
; An unsatisfied issuance guard leaves demand-adaptive-stone-wall in ACTIVE; it is not PENDING.
; Release: adaptive-stone-wall | COMPLETE -> RELEASED
(defrule
    (goal demand-adaptive-stone-wall 45)
    (or
        (building-type-count 72 > 0)
        (building-type-count 117 > 0)
    )
=>
    (set-goal demand-adaptive-stone-wall 0)
)

; Recovery: adaptive-stone-wall | RELEASED -> ACTIVE on world-state loss
(defrule
    (goal demand-adaptive-stone-wall 0)
    (not (building-type-count 72 >= 1))
    (not (building-type-count 117 >= 1))
    (or (players-unit-type-count any-enemy knight >= 3) (or (players-unit-type-count any-enemy archer-line >= 4) (players-unit-type-count any-enemy militia-line >= 5)))
    (not (current-age >= imperial-age))
    (or
        (current-age < castle-age)
        (or
                (stone-amount >= 650)
                (town-under-attack)
            )
    )
=>
    (set-goal demand-adaptive-stone-wall 1)
)

; Construction observation: adaptive-stone-wall
; Precedence: COMPLETE > FOUNDATION_PENDING > PLACEMENT_PENDING > RETRY
; Completion witness: adaptive-stone-wall | PENDING/ISSUED -> COMPLETE
; COMPLETE | ISSUED/PENDING -> COMPLETE
(defrule
    (or
        (goal demand-adaptive-stone-wall 46)
        (goal demand-adaptive-stone-wall 44)
    )
    (or
        (building-type-count 72 >= 1)
        (building-type-count 117 >= 1)
    )
=>
    (set-goal demand-adaptive-stone-wall 45)
)

; Pending admission: adaptive-stone-wall | ISSUED/PENDING -> PENDING
; Both wall materials are valid because the same demand emits Palisade in Feudal
; and Stone in Castle+. Pending is queue protection, never completion truth.
(defrule
    (or
        (goal demand-adaptive-stone-wall 46)
        (goal demand-adaptive-stone-wall 44)
    )
    (not (building-type-count 72 >= 1))
    (not (building-type-count 117 >= 1))
    (or
        (up-pending-objects c: 72 >= 1)
        (up-pending-objects c: 117 >= 1)
    )
=>
    (set-goal demand-adaptive-stone-wall 44)
)

; PLACEMENT_PENDING | ISSUED/PENDING -> PENDING
(defrule
    (or
        (goal demand-adaptive-stone-wall 46)
        (goal demand-adaptive-stone-wall 44)
    )
    (not (building-type-count 72 >= 1))
    (not (building-type-count 117 >= 1))
    (or
        (up-pending-placement c: 72)
        (up-pending-placement c: 117)
    )
=>
    (set-goal demand-adaptive-stone-wall 44)
)

; RETRY | ISSUED/PENDING -> ACTIVE only after both wall queues are clear.
(defrule
    (or
        (goal demand-adaptive-stone-wall 46)
        (goal demand-adaptive-stone-wall 44)
    )
    (not (building-type-count 72 >= 1))
    (not (building-type-count 117 >= 1))
    (up-pending-objects c: 72 == 0)
    (up-pending-objects c: 117 == 0)
    (not (up-pending-placement c: 72))
    (not (up-pending-placement c: 117))
=>
    (set-goal demand-adaptive-stone-wall 1)
    (set-goal construction-retry-barrier-adaptive-stone-wall 1)
)

; Action issuance is intentionally owned by the geometry rules above.
; The old generic (build 117) placement path is retired; wall construction now
; enters through up-build-line after a bounded, persisted point plan.

; Pending diagnostics: adaptive-guard-tower
; PENDING-DIAGNOSTIC [INFO] PENDING-ACTION-GUARD: action is gated by active goal 41 and cannot reissue from pending goal 42
; PENDING-DIAGNOSTIC [INFO] PENDING-WITNESS-GUARD: completion witness is evaluated only while pending goal 42 is active
; PENDING-DIAGNOSTIC [INFO] PENDING-RELEASE-GUARD: release is evaluated only after completion goal 43 is reached
; PENDING-DIAGNOSTIC [INFO] PENDING-ACTION-WITNESS-SEPARATE: action 'build' is not treated as completion evidence; witness 'building-type-count' owns completion
; PENDING-DIAGNOSTIC [INFO] PENDING-RELEASE-SEPARATE: release remains separate from witness 'building-type-count' and may clear the demand only from complete state
; Issuance failure: adaptive-guard-tower | RETAIN-ACTIVE
; An unsatisfied issuance guard leaves demand-adaptive-guard-tower in ACTIVE; it is not PENDING.
; Release: adaptive-guard-tower | COMPLETE -> RELEASED
(defrule
    (goal demand-adaptive-guard-tower 43)
    (or
        (and
            (or
                (goal byzantine-university-state byzantine-university-state-tower-network)
                (goal byzantine-university-state byzantine-university-state-imperial-gunline)
            )
            (building-type-count 234 >= 2)
        )
        (and
            (or
                (goal byzantine-university-state byzantine-university-state-castle)
                (goal byzantine-university-state byzantine-university-state-hardened-perimeter)
            )
            (building-type-count 234 >= 1)
        )
    )
=>
    (set-goal demand-adaptive-guard-tower 0)
)

; Recovery: adaptive-guard-tower | RELEASED -> ACTIVE on world-state loss
(defrule
    (goal demand-adaptive-guard-tower 0)
    (not (building-type-count 234 >= 1))
    (or (players-unit-type-count any-enemy knight >= 3) (or (players-unit-type-count any-enemy archer-line >= 4) (players-unit-type-count any-enemy militia-line >= 5)))
    (not (current-age >= imperial-age))
=>
    (set-goal demand-adaptive-guard-tower 1)
)

; Construction observation: adaptive-guard-tower
; Precedence: COMPLETE > FOUNDATION_PENDING > PLACEMENT_PENDING > RETRY
; Completion witness: adaptive-guard-tower | PENDING/ISSUED -> COMPLETE
; COMPLETE | ISSUED/PENDING -> COMPLETE
(defrule
    (or
        (goal demand-adaptive-guard-tower 44)
        (goal demand-adaptive-guard-tower 42)
    )
    (or
        (and
            (or
                (goal byzantine-university-state byzantine-university-state-tower-network)
                (goal byzantine-university-state byzantine-university-state-imperial-gunline)
            )
            (building-type-count 234 >= 2)
        )
        (and
