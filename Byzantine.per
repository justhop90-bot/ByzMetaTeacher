; Pending diagnostics: economy-farm-boom-castle
; The farm target follows active TC count. Naga/community practice increases farm
; pressure after TC2/TC3 instead of waiting for a famine. Our lifecycle still uses
; issued/pending/world-state witness semantics.
(defrule
    (goal demand-economy-farm-boom-castle 66)
    (or
        (and (not (building-type-count-total town-center >= 2)) (building-type-count farm >= bt-castle-farm-target-1tc))
        (or
            (and
                (building-type-count-total town-center >= 2)
                (and
                    (not (building-type-count-total town-center >= 3))
                    (building-type-count farm >= bt-castle-farm-target-2tc)
