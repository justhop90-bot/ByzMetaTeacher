;----------------------------------------------------------------
; BOUNDED LATE-GAME GATHERER DELTA CONTROL
;----------------------------------------------------------------
; Efficiency rule: late-game gatherer pressure is a small correction, not a
; second economy scheduler. The posture percentages remain the baseline. This
; layer only moves two actual gatherers when one resource is materially overbanked
; and another is materially short, then holds that direction behind a 45-second
; cooldown and a separate release threshold. This creates hysteresis instead of
; villager ping-pong when banks cross a single threshold.
;
; State values:
;   0 idle
;   1 wood -> gold
;   2 wood -> food
;   3 gold -> food
;   4 gold -> wood
;   5 food -> gold
;   6 food -> wood
;
; The delta block is strictly lower priority than upgrade/research work, existing
; surplus-spend arbitration, remote-resource recovery, and market balancing.

; Release: wood -> gold. Re-arm the cooldown when the direction is released so
; the next correction cannot immediately point somewhere else.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-economy-delta-state byzantine-economy-delta-wood-gold)
    (or
        (wood-amount <= bt-economy-delta-wood-release)
        (gold-amount >= bt-economy-delta-gold-release)
    )
=>
    (set-goal byzantine-economy-delta-state byzantine-economy-delta-idle)
    (enable-timer byzantine-economy-delta-timer bt-economy-delta-cooldown-seconds)
)

; Release: wood -> food.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-economy-delta-state byzantine-economy-delta-wood-food)
    (or
        (wood-amount <= bt-economy-delta-wood-release)
        (food-amount >= 2500)
    )
=>
    (set-goal byzantine-economy-delta-state byzantine-economy-delta-idle)
    (enable-timer byzantine-economy-delta-timer bt-economy-delta-cooldown-seconds)
)

; Release: gold -> food.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-economy-delta-state byzantine-economy-delta-gold-food)
    (or
        (gold-amount <= bt-economy-delta-gold-release)
        (food-amount >= 2500)
    )
=>
    (set-goal byzantine-economy-delta-state byzantine-economy-delta-idle)
    (enable-timer byzantine-economy-delta-timer bt-economy-delta-cooldown-seconds)
)

; Release: gold -> wood.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-economy-delta-state byzantine-economy-delta-gold-wood)
    (or
        (gold-amount <= bt-economy-delta-gold-release)
        (wood-amount >= bt-economy-delta-wood-recovered)
    )
=>
    (set-goal byzantine-economy-delta-state byzantine-economy-delta-idle)
    (enable-timer byzantine-economy-delta-timer bt-economy-delta-cooldown-seconds)
)

; Release: food -> gold.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-economy-delta-state byzantine-economy-delta-food-gold)
    (or
        (food-amount <= bt-economy-delta-food-release)
        (gold-amount >= bt-economy-delta-gold-release)
    )
=>
    (set-goal byzantine-economy-delta-state byzantine-economy-delta-idle)
    (enable-timer byzantine-economy-delta-timer bt-economy-delta-cooldown-seconds)
)

; Release: food -> wood.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-economy-delta-state byzantine-economy-delta-food-wood)
    (or
        (food-amount <= bt-economy-delta-food-release)
        (wood-amount >= bt-economy-delta-wood-recovered)
    )
=>
    (set-goal byzantine-economy-delta-state byzantine-economy-delta-idle)
    (enable-timer byzantine-economy-delta-timer bt-economy-delta-cooldown-seconds)
)

; Wood surplus -> gold shortage. Gold is the first target because it unlocks
; upgrades and the Byzantine gold-heavy late army. No percentage rewrite occurs.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-late-upgrade-priority 0)
    (goal byzantine-army-reinforcement 0)
    (goal byzantine-remote-resource-state byzantine-remote-resource-idle)
    (goal byzantine-market-state byzantine-market-idle)
    (goal byzantine-surplus-spend-claim 0)
    (goal byzantine-economy-delta-state byzantine-economy-delta-idle)
    (or
        (up-timer-status byzantine-economy-delta-timer c:== timer-disabled)
        (up-timer-status byzantine-economy-delta-timer c:== timer-triggered)
    )
    (wood-amount > bt-economy-delta-wood-surplus)
    (gold-amount < bt-economy-delta-gold-low)
=>
    (up-retask-gatherers wood c: byzantine-economy-delta-step)
    (up-modify-sn sn-wood-gatherer-percentage c:- 5)
    (up-modify-sn sn-gold-gatherer-percentage c:+ 5)
    (set-goal byzantine-economy-delta-state byzantine-economy-delta-wood-gold)
    (enable-timer byzantine-economy-delta-timer bt-economy-delta-cooldown-seconds)
)

; Wood surplus -> food shortage. Lower priority than the gold repair.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-late-upgrade-priority 0)
    (goal byzantine-army-reinforcement 0)
    (goal byzantine-remote-resource-state byzantine-remote-resource-idle)
    (goal byzantine-market-state byzantine-market-idle)
    (goal byzantine-surplus-spend-claim 0)
    (goal byzantine-economy-delta-state byzantine-economy-delta-idle)
    (or
        (up-timer-status byzantine-economy-delta-timer c:== timer-disabled)
        (up-timer-status byzantine-economy-delta-timer c:== timer-triggered)
    )
    (wood-amount > bt-economy-delta-wood-surplus)
    (gold-amount >= bt-economy-delta-gold-low)
    (food-amount < bt-economy-delta-food-low)
=>
    (up-retask-gatherers wood c: byzantine-economy-delta-step)
    (up-modify-sn sn-wood-gatherer-percentage c:- 5)
    (up-modify-sn sn-food-gatherer-percentage c:+ 5)
    (set-goal byzantine-economy-delta-state byzantine-economy-delta-wood-food)
    (enable-timer byzantine-economy-delta-timer bt-economy-delta-cooldown-seconds)
)

; Gold surplus -> food shortage.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-late-upgrade-priority 0)
    (goal byzantine-army-reinforcement 0)
    (goal byzantine-remote-resource-state byzantine-remote-resource-idle)
    (goal byzantine-market-state byzantine-market-idle)
    (goal byzantine-surplus-spend-claim 0)
    (goal byzantine-economy-delta-state byzantine-economy-delta-idle)
    (or
        (up-timer-status byzantine-economy-delta-timer c:== timer-disabled)
        (up-timer-status byzantine-economy-delta-timer c:== timer-triggered)
    )
    (gold-amount > bt-economy-delta-gold-surplus)
    (food-amount < bt-economy-delta-food-low)
=>
    (up-retask-gatherers gold c: byzantine-economy-delta-step)
    (up-modify-sn sn-gold-gatherer-percentage c:- 5)
    (up-modify-sn sn-food-gatherer-percentage c:+ 5)
    (set-goal byzantine-economy-delta-state byzantine-economy-delta-gold-food)
    (enable-timer byzantine-economy-delta-timer bt-economy-delta-cooldown-seconds)
)

; Gold surplus -> wood shortage.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-late-upgrade-priority 0)
    (goal byzantine-army-reinforcement 0)
    (goal byzantine-remote-resource-state byzantine-remote-resource-idle)
    (goal byzantine-market-state byzantine-market-idle)
    (goal byzantine-surplus-spend-claim 0)
    (goal byzantine-economy-delta-state byzantine-economy-delta-idle)
    (or
        (up-timer-status byzantine-economy-delta-timer c:== timer-disabled)
        (up-timer-status byzantine-economy-delta-timer c:== timer-triggered)
    )
    (gold-amount > bt-economy-delta-gold-surplus)
    (food-amount >= bt-economy-delta-food-low)
    (wood-amount < bt-economy-delta-wood-low)
=>
    (up-retask-gatherers gold c: byzantine-economy-delta-step)
    (up-modify-sn sn-gold-gatherer-percentage c:- 5)
    (up-modify-sn sn-wood-gatherer-percentage c:+ 5)
    (set-goal byzantine-economy-delta-state byzantine-economy-delta-gold-wood)
    (enable-timer byzantine-economy-delta-timer bt-economy-delta-cooldown-seconds)
)

; Food surplus -> gold shortage. Food is the last source to be drained, and only
; when gold is genuinely deficient, which prevents the common feast/famine flip.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-late-upgrade-priority 0)
    (goal byzantine-army-reinforcement 0)
    (goal byzantine-remote-resource-state byzantine-remote-resource-idle)
    (goal byzantine-market-state byzantine-market-idle)
    (goal byzantine-surplus-spend-claim 0)
    (goal byzantine-economy-delta-state byzantine-economy-delta-idle)
    (or
        (up-timer-status byzantine-economy-delta-timer c:== timer-disabled)
        (up-timer-status byzantine-economy-delta-timer c:== timer-triggered)
    )
    (food-amount > bt-economy-delta-food-surplus)
    (gold-amount < bt-economy-delta-gold-low)
=>
    (up-retask-gatherers food c: byzantine-economy-delta-step)
    (up-modify-sn sn-food-gatherer-percentage c:- 5)
    (up-modify-sn sn-gold-gatherer-percentage c:+ 5)
    (set-goal byzantine-economy-delta-state byzantine-economy-delta-food-gold)
    (enable-timer byzantine-economy-delta-timer bt-economy-delta-cooldown-seconds)
)

; Food surplus -> wood shortage.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-late-upgrade-priority 0)
    (goal byzantine-army-reinforcement 0)
    (goal byzantine-remote-resource-state byzantine-remote-resource-idle)
    (goal byzantine-market-state byzantine-market-idle)
    (goal byzantine-surplus-spend-claim 0)
    (goal byzantine-economy-delta-state byzantine-economy-delta-idle)
    (or
        (up-timer-status byzantine-economy-delta-timer c:== timer-disabled)
        (up-timer-status byzantine-economy-delta-timer c:== timer-triggered)
    )
    (food-amount > bt-economy-delta-food-surplus)
    (gold-amount >= bt-economy-delta-gold-low)
    (wood-amount < bt-economy-delta-wood-low)
=>
    (up-retask-gatherers food c: byzantine-economy-delta-step)
    (up-modify-sn sn-food-gatherer-percentage c:- 5)
    (up-modify-sn sn-wood-gatherer-percentage c:+ 5)
    (set-goal byzantine-economy-delta-state byzantine-economy-delta-food-wood)
    (enable-timer byzantine-economy-delta-timer bt-economy-delta-cooldown-seconds)
)

;----------------------------------------------------------------
; PETARD / STATIC-DEFENSE BREAK PACKAGE
;----------------------------------------------------------------
; Byzantine has no reason to feed the main army into a persistent wall. A small
; Castle-built petard packet is cheaper and cleaner when a large enemy stone-wall
; presence has been observed. This is a demand-light execution overlay, not a
; second siege scheduler.
(defrule
    (current-age >= castle-age)
    (building-type-count castle >= 1)
    (goal byzantine-army-reinforcement 0)
    (not (town-under-attack))
    (players-building-type-count any-enemy 117 >= 5)
    (unit-type-count-total petard < 3)
    (goal action-claim-train-arbitration 0)
    (can-train petard)
=>
    (train petard)
    (set-goal action-claim-train-arbitration 1)
)

;----------------------------------------------------------------
; EXISTING-DEMAND MARKET RESIDUAL BALANCE
;----------------------------------------------------------------
; Market remains the last resort. The explicit surplus claim prevents it from
; firing in the same pass that an existing higher-value demand was reasserted.
; Stand up the first offensive siege battery as soon as Imperial is reached.
; Target escalation is driven only by the localized fortification witness.

(defrule
    (current-age >= imperial-age)
    (goal byzantine-siege-scale 0)
=>
    (set-goal byzantine-siege-scale byzantine-siege-scale-standard)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-siege-scale byzantine-siege-scale-standard)
    (goal byzantine-army-attack-ready 2)
    (goal byzantine-fortification-threat 1)
=>
    (set-goal byzantine-siege-scale byzantine-siege-scale-fortified)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-siege-scale byzantine-siege-scale-fortified)
    (not (goal byzantine-fortification-threat 1))
=>
    (set-goal byzantine-siege-scale byzantine-siege-scale-standard)
)

;----------------------------------------------------------------
; UPGRADE SEQUENCING
;----------------------------------------------------------------
; Standing army first establishes the useful mass, then spends Imperial gold
; on the Byzantine-specific package in this order:
;   Logistica -> Elite Cataphract -> Elite Varangian Guard -> Elite Skirmisher.
; Existing ordinary research demands remain responsible for blacksmith/ranged/
; siege upgrades; these unique upgrades must not race each other for the bank.

;----------------------------------------------------------------
; BOUNDED MARKET RESIDUAL BALANCE
;----------------------------------------------------------------
; Market is the last direct spending tier. High-value research, siege, army
; reinforcement, and remote resource recovery must all be idle before it can act.
; Standard buy/sell actions are used deliberately because the exact variable-
; amount UP command shape remains EVIDENCE-ONLY in the compiler registry.

(defrule
    (current-age >= imperial-age)
    (goal byzantine-market-state byzantine-market-idle)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-late-upgrade-priority 0)
    (goal byzantine-army-reinforcement 0)
    (goal byzantine-remote-resource-state byzantine-remote-resource-idle)
    (goal byzantine-siege-approach byzantine-siege-approach-normal)
    (goal byzantine-army-attack-ready 2)
    (goal byzantine-surplus-spend-claim 0)
    (goal demand-castle-cataphract-floor 0)
    (goal demand-castle-varangian-guard-floor 0)
    (goal demand-imperial-arbalester-floor 0)
    (goal demand-imperial-halberdier-floor 0)
    (goal demand-imperial-siege-ram-floor 0)
    (goal demand-imperial-trebuchet-floor 0)
    (goal demand-imperial-bombard-floor 0)
    (building-type-count-total market >= 1)
    (wood-amount > 5000)
    (gold-amount < 1800)
    (can-sell-commodity wood)
=>
    (sell-commodity wood)
    (set-goal byzantine-market-state byzantine-market-sell-wood)
)

(defrule
    (goal byzantine-market-state byzantine-market-sell-wood)
    (or
        (wood-amount <= 3500)
        (gold-amount >= 2200)
    )
=>
    (set-goal byzantine-market-state byzantine-market-idle)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-market-state byzantine-market-idle)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-late-upgrade-priority 0)
    (goal byzantine-army-reinforcement 0)
    (goal byzantine-remote-resource-state byzantine-remote-resource-idle)
    (goal byzantine-siege-approach byzantine-siege-approach-normal)
    (goal byzantine-army-attack-ready 2)
    (goal byzantine-surplus-spend-claim 0)
    (goal demand-castle-cataphract-floor 0)
    (goal demand-castle-varangian-guard-floor 0)
    (goal demand-imperial-arbalester-floor 0)
    (goal demand-imperial-halberdier-floor 0)
    (goal demand-imperial-siege-ram-floor 0)
    (goal demand-imperial-trebuchet-floor 0)
    (goal demand-imperial-bombard-floor 0)
    (building-type-count-total market >= 1)
    (gold-amount > 3500)
    (food-amount < 1400)
    (can-buy-commodity food)
=>
    (buy-commodity food)
    (set-goal byzantine-market-state byzantine-market-buy-food)
)

(defrule
    (goal byzantine-market-state byzantine-market-buy-food)
    (or
        (food-amount >= 1800)
        (gold-amount <= 2500)
    )
=>
    (set-goal byzantine-market-state byzantine-market-idle)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-market-state byzantine-market-idle)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-late-upgrade-priority 0)
    (goal byzantine-army-reinforcement 0)
    (goal byzantine-remote-resource-state byzantine-remote-resource-idle)
    (goal byzantine-siege-approach byzantine-siege-approach-normal)
    (goal byzantine-army-attack-ready 2)
    (goal byzantine-surplus-spend-claim 0)
    (goal demand-castle-cataphract-floor 0)
    (goal demand-castle-varangian-guard-floor 0)
    (goal demand-imperial-arbalester-floor 0)
    (goal demand-imperial-halberdier-floor 0)
    (goal demand-imperial-siege-ram-floor 0)
    (goal demand-imperial-trebuchet-floor 0)
    (goal demand-imperial-bombard-floor 0)
    (building-type-count-total market >= 1)
    (gold-amount > 4000)
    (wood-amount < 900)
    (can-buy-commodity wood)
=>
    (buy-commodity wood)
    (set-goal byzantine-market-state byzantine-market-buy-wood)
)

(defrule
    (goal byzantine-market-state byzantine-market-buy-wood)
    (or
        (wood-amount >= 1400)
        (gold-amount <= 2500)
    )
=>
    (set-goal byzantine-market-state byzantine-market-idle)
)



; -----------------------------------------------------------------------------
; LATE-GAME SPEND / RECOVERY OVERLAY
; -----------------------------------------------------------------------------
; Food crisis: do not wait for the broad market controller to notice starvation.
(defrule
    (current-age >= feudal-age)
    (goal byzantine-food-recovery-state byzantine-food-recovery-idle)
    (goal byzantine-army-reinforcement 0)
    (or (food-amount < 450) (and (current-age >= imperial-age) (food-amount < 700)))
    (or (wood-amount > 900) (gold-amount > 900))
    (or
        (up-timer-status byzantine-food-recovery-timer c:== timer-disabled)
        (up-timer-status byzantine-food-recovery-timer c:== timer-triggered)
    )
=>
    (up-retask-gatherers food c: 4)
    (set-goal byzantine-food-recovery-state byzantine-food-recovery-active)
    (enable-timer byzantine-food-recovery-timer bt-byzantine-food-recovery-seconds)
)

(defrule
    (goal byzantine-food-recovery-state byzantine-food-recovery-active)
    (food-amount >= 900)
=>
    (set-goal byzantine-food-recovery-state byzantine-food-recovery-idle)
    (disable-timer byzantine-food-recovery-timer)
)

(defrule
    (goal byzantine-food-recovery-state byzantine-food-recovery-active)
    (timer-triggered byzantine-food-recovery-timer)
    (food-amount < 900)
=>
    (disable-timer byzantine-food-recovery-timer)
    (enable-timer byzantine-food-recovery-timer bt-byzantine-food-recovery-seconds)
    (up-retask-gatherers food c: 2)
)

; Team trade is a resource sink only after direct production/research pressure
; has been given first refusal. The six-cart ceiling is intentionally modest.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-late-upgrade-priority 0)
    (goal byzantine-army-reinforcement 0)
    (goal action-claim-train-arbitration 0)
    (not (town-under-attack))
    (population-headroom > 8)
    (building-type-count market >= 1)
    (players-building-type-count any-ally market >= 1)
    (unit-type-count-total trade-cart < 12)
    (food-amount > 900)
    (wood-amount > 900)
    (gold-amount > 1400)
    (can-train trade-cart)
=>
    (train trade-cart)
    (set-goal action-claim-train-arbitration 1)
)

; Emergency food purchase is the final fallback for genuine hunger, not a
; standing market policy. It only fires with a large gold bank.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-market-state byzantine-market-idle)
    (goal byzantine-army-reinforcement 0)
    (goal byzantine-surplus-spend-claim 0)
    (building-type-count-total market >= 1)
    (gold-amount > 3000)
    (food-amount < 600)
    (can-buy-commodity food)
=>
    (buy-commodity food)
    (set-goal byzantine-market-state byzantine-market-buy-food)
)

;----------------------------------------------------------------
; ATTACK THRESHOLDS AND REINFORCEMENT
;----------------------------------------------------------------
; The attack gate is persistent and army-based. Enemy composition changes the
; selected backbone, but does not create the need to attack.
; Castle: 4 Cataphracts + 4 Skirmishers + 2 Mangonels + 1 Monk.
; Imperial: selected 6-unit backbone + 8 Halberdiers + 2/2/2 siege.

(defrule
    (current-age == castle-age)
    (goal byzantine-army-plan-phase 1)
    (goal byzantine-army-attack-ready 0)
    (up-compare-sn 227 >= 75)
    (attack-soldier-count >= 8)
    (or
        (and
            (goal counter-package-infantry_pressure_castle 1)
            (unit-type-count-total cataphract-line >= bt-castle-cataphract-floor)
        )
        (or
            (and
                (not (goal counter-package-infantry_pressure_castle 1))
                (unit-type-count-total knight-line >= 2)
            )
            (unit-type-count-total skirmisher-line >= bt-castle-skirmisher-floor)
        )
    )
=>
    (set-goal byzantine-army-attack-ready 1)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-army-plan-phase 2)
    (goal byzantine-army-attack-ready 0)
    (up-compare-sn 227 >= 75)
    (or
        (goal byzantine-imperial-composition-posture byzantine-imperial-posture-balanced)
        (or
            (goal byzantine-imperial-composition-posture byzantine-imperial-posture-mounted)
            (goal byzantine-imperial-composition-posture byzantine-imperial-posture-siege)
        )
    )
    (unit-type-count-total cataphract-line >= bt-imperial-cataphract-floor)
    (unit-type-count-total 359 >= bt-imperial-halberdier-floor)
    (or
        (and
            (goal byzantine-siege-scale byzantine-siege-scale-standard)
            (and
                (unit-type-count-total trebuchet >= bt-imperial-trebuchet-target)
                (and
                    (unit-type-count-total bombard-cannon >= bt-imperial-bombard-floor)
                    (unit-type-count-total battering-ram-line >= bt-imperial-attack-siege-target)
                )
            )
        )
        (and
            (goal byzantine-siege-scale byzantine-siege-scale-fortified)
            (and
                (unit-type-count-total trebuchet >= bt-imperial-fortified-trebuchet-target)
                (and
                    (unit-type-count-total bombard-cannon >= bt-imperial-fortified-bombard-target)
                    (unit-type-count-total battering-ram-line >= bt-imperial-fortified-ram-target)
                )
            )
        )
    )
=>
    (set-goal byzantine-army-attack-ready 1)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-army-plan-phase 2)
    (goal byzantine-army-attack-ready 0)
    (up-compare-sn 227 >= 75)
    (goal byzantine-imperial-composition-posture byzantine-imperial-posture-infantry)
    (unit-type-count-total varangian-guard-line >= bt-imperial-varangian-floor)
    (unit-type-count-total 359 >= bt-imperial-halberdier-floor)
    (or
        (and
            (goal byzantine-siege-scale byzantine-siege-scale-standard)
            (and
                (unit-type-count-total trebuchet >= bt-imperial-trebuchet-target)
                (and
                    (unit-type-count-total bombard-cannon >= bt-imperial-bombard-floor)
                    (unit-type-count-total battering-ram-line >= bt-imperial-attack-siege-target)
                )
            )
        )
        (and
            (goal byzantine-siege-scale byzantine-siege-scale-fortified)
            (and
                (unit-type-count-total trebuchet >= bt-imperial-fortified-trebuchet-target)
                (and
                    (unit-type-count-total bombard-cannon >= bt-imperial-fortified-bombard-target)
                    (unit-type-count-total battering-ram-line >= bt-imperial-fortified-ram-target)
                )
            )
        )
    )
=>
    (set-goal byzantine-army-attack-ready 1)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-army-plan-phase 2)
    (goal byzantine-army-attack-ready 0)
    (up-compare-sn 227 >= 75)
    (goal byzantine-imperial-composition-posture byzantine-imperial-posture-ranged)
    (unit-type-count-total arbalest >= bt-imperial-arbalester-floor)
    (unit-type-count-total 359 >= bt-imperial-halberdier-floor)
    (or
        (and
            (goal byzantine-siege-scale byzantine-siege-scale-standard)
            (and
                (unit-type-count-total trebuchet >= bt-imperial-trebuchet-target)
                (and
                    (unit-type-count-total bombard-cannon >= bt-imperial-bombard-floor)
                    (unit-type-count-total battering-ram-line >= bt-imperial-attack-siege-target)
                )
            )
        )
        (and
            (goal byzantine-siege-scale byzantine-siege-scale-fortified)
            (and
                (unit-type-count-total trebuchet >= bt-imperial-fortified-trebuchet-target)
                (and
                    (unit-type-count-total bombard-cannon >= bt-imperial-fortified-bombard-target)
                    (unit-type-count-total battering-ram-line >= bt-imperial-fortified-ram-target)
                )
            )
        )
    )
=>
    (set-goal byzantine-army-attack-ready 1)
)

;----------------------------------------------------------------
;----------------------------------------------------------------
; ARMY REPOSITION / WITHDRAWAL CONTROLLER
;----------------------------------------------------------------
; Naga-style mechanism: cancel the active attack control, regroup surviving
; military around a defensible anchor, then let normal reinforcement/reassessment
; decide when the army can re-enter the fight.

(defrule
    (goal byzantine-army-reposition-state byzantine-army-reposition-idle)
    (goal byzantine-army-attack-ready 2)
    (or
        (town-under-attack)
        (town-under-attack)
    )
=>
    (up-reset-attack-now)
    (set-goal byzantine-army-attack-ready 0)
    (set-goal byzantine-army-reinforcement 1)
    (set-goal byzantine-army-reposition-state byzantine-army-reposition-withdraw)
)

(defrule
    (goal byzantine-army-reposition-state byzantine-army-reposition-idle)
    (goal byzantine-army-attack-ready 2)
    (goal byzantine-siege-approach byzantine-siege-approach-fortified)
    (attack-soldier-count < 6)
=>
    (up-reset-attack-now)
    (set-goal byzantine-army-attack-ready 0)
    (set-goal byzantine-army-reinforcement 1)
    (set-goal byzantine-army-reposition-state byzantine-army-reposition-withdraw)
)

(defrule
    (goal byzantine-army-reposition-state byzantine-army-reposition-withdraw)
    (or
        (goal byzantine-frontier-state byzantine-frontier-state-anchored)
        (or
            (goal byzantine-frontier-state byzantine-frontier-state-wall-pending)
            (goal byzantine-frontier-state byzantine-frontier-state-protected)
        )
    )
    (up-compare-goal byzantine-frontier-anchor-point > 0)
=>
    (up-copy-point byzantine-army-reposition-point byzantine-frontier-anchor-point)
    (set-goal byzantine-army-reposition-state byzantine-army-reposition-staging)
    (disable-timer byzantine-army-reposition-timer)
    (enable-timer byzantine-army-reposition-timer bt-byzantine-army-reposition-seconds)
)

(defrule
    (goal byzantine-army-reposition-state byzantine-army-reposition-withdraw)
    (not (goal byzantine-frontier-state byzantine-frontier-state-anchored))
    (not (goal byzantine-frontier-state byzantine-frontier-state-wall-pending))
    (not (goal byzantine-frontier-state byzantine-frontier-state-protected))
=>
    (up-full-reset-search)
    (up-find-local c: town-center c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object byzantine-army-reposition-point)
    (set-goal byzantine-army-reposition-state byzantine-army-reposition-staging)
    (disable-timer byzantine-army-reposition-timer)
    (enable-timer byzantine-army-reposition-timer bt-byzantine-army-reposition-seconds)
)

(defrule
    (goal byzantine-army-reposition-state byzantine-army-reposition-staging)
    (or
        (up-timer-status byzantine-army-reposition-timer c:== timer-disabled)
        (up-timer-status byzantine-army-reposition-timer c:== timer-triggered)
    )
=>
    (up-full-reset-search)
    (up-set-target-point byzantine-army-reposition-point)
    (up-filter-distance c: -1 c: 16)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-local c: all-units-class c: 240)
    (up-filter-include cmdid-monk -1 -1 -1)
    (up-find-local c: all-units-class c: 240)
    (up-target-point 0 action-move -1 stance-defensive)
    (disable-timer byzantine-army-reposition-timer)
    (enable-timer byzantine-army-reposition-timer bt-byzantine-army-reposition-seconds)
)

(defrule
    (goal byzantine-army-reposition-state byzantine-army-reposition-staging)
    (or
        (goal byzantine-army-reinforcement 1)
        (goal byzantine-army-attack-ready 1)
    )
=>
    (disable-timer byzantine-army-reposition-timer)
    (set-goal byzantine-army-reposition-state byzantine-army-reposition-idle)
)

; FORTIFICATION-AWARE SIEGE APPROACH
;----------------------------------------------------------------
; Locality contract: fortifications only affect the offensive controller when
; they are near the current enemy objective anchor. The anchor is the nearest
; enemy TC, discovered through DUC. The DUC distance filter is then applied to
; the saved TC point, so an unrelated tower/castle/wall elsewhere cannot turn an
; open-ground attack into a fortified assault.
;
; This intentionally avoids the unproven claim that attack-now exposes a stable
; target position. Target-local micro remains OPEN.

(defrule
    (current-age >= castle-age)
    (or
        (goal byzantine-army-attack-ready 1)
        (goal byzantine-army-attack-ready 2)
    )
    (goal byzantine-siege-approach byzantine-siege-approach-normal)
    (goal byzantine-fortification-probe-state byzantine-fortification-probe-idle)
    (goal byzantine-fortification-probe-found 0)
    (goal byzantine-fortification-threat 0)
    (or
        (up-timer-status byzantine-fortification-probe-timer c:== timer-disabled)
        (up-timer-status byzantine-fortification-probe-timer c:== timer-triggered)
    )
=>
    (disable-timer byzantine-fortification-probe-timer)
    (set-goal byzantine-fortification-probe-found 0)
    (up-find-player enemy find-closest byzantine-fortification-probe-player)
    (up-modify-sn sn-focus-player-number g:= byzantine-fortification-probe-player)
    (up-full-reset-search)
    (up-find-remote c: town-center c: 1)
    (up-get-search-state byzantine-fortification-probe-search)
    (set-goal byzantine-fortification-probe-state byzantine-fortification-probe-anchor)
)

(defrule
    (goal byzantine-fortification-probe-state byzantine-fortification-probe-anchor)
    (up-compare-goal 368 c:> 0)
=>
    (up-set-target-object search-remote c: 0)
    (up-get-point position-object byzantine-fortification-probe-point)
    (up-reset-search 1 1 1 1)
    (up-set-target-point byzantine-fortification-probe-point)
    (up-filter-distance c: 0 c: bt-castle-fortification-local-radius)
    (up-find-remote c: 82 c: 1)
    (up-get-search-state byzantine-fortification-probe-search)
    (set-goal byzantine-fortification-probe-state byzantine-fortification-probe-castle)
)

(defrule
    (goal byzantine-fortification-probe-state byzantine-fortification-probe-anchor)
    (up-compare-goal 368 c:== 0)
=>
    (set-goal byzantine-fortification-probe-state byzantine-fortification-probe-finish)
)

(defrule
    (goal byzantine-fortification-probe-state byzantine-fortification-probe-castle)
    (up-compare-goal 368 c:> 0)
=>
    (up-set-target-object search-remote c: 0)
    (up-get-point position-object byzantine-offensive-castle-point)
    (set-goal byzantine-offensive-castle-valid 1)
    (set-goal byzantine-fortification-probe-found 1)
    (up-reset-search 1 1 1 1)
    (up-set-target-point byzantine-fortification-probe-point)
    (up-filter-distance c: 0 c: bt-castle-fortification-local-radius)
    (up-find-remote c: bt-tower-class c: 1)
    (up-get-search-state byzantine-fortification-probe-search)
    (set-goal byzantine-fortification-probe-state byzantine-fortification-probe-tower)
)

(defrule
    (goal byzantine-fortification-probe-state byzantine-fortification-probe-castle)
    (up-compare-goal 368 c:== 0)
=>
    (up-reset-search 1 1 1 1)
    (up-set-target-point byzantine-fortification-probe-point)
    (up-filter-distance c: 0 c: bt-castle-fortification-local-radius)
    (up-find-remote c: bt-tower-class c: 1)
    (up-get-search-state byzantine-fortification-probe-search)
    (set-goal byzantine-fortification-probe-state byzantine-fortification-probe-tower)
)

(defrule
    (goal byzantine-fortification-probe-state byzantine-fortification-probe-tower)
    (up-compare-goal 368 c:> 0)
=>
    (set-goal byzantine-fortification-probe-found 1)
    (up-reset-search 1 1 1 1)
    (up-set-target-point byzantine-fortification-probe-point)
    (up-filter-distance c: 0 c: bt-castle-fortification-local-radius)
    (up-find-remote c: bt-wall-class c: 1)
    (up-get-search-state byzantine-fortification-probe-search)
    (set-goal byzantine-fortification-probe-state byzantine-fortification-probe-wall)
)

(defrule
    (goal byzantine-fortification-probe-state byzantine-fortification-probe-tower)
    (up-compare-goal 368 c:== 0)
=>
    (up-reset-search 1 1 1 1)
    (up-set-target-point byzantine-fortification-probe-point)
    (up-filter-distance c: 0 c: bt-castle-fortification-local-radius)
    (up-find-remote c: bt-wall-class c: 1)
    (up-get-search-state byzantine-fortification-probe-search)
    (set-goal byzantine-fortification-probe-state byzantine-fortification-probe-wall)
)

(defrule
    (goal byzantine-fortification-probe-state byzantine-fortification-probe-wall)
    (up-compare-goal 368 c:>= bt-local-wall-count)
=>
    (set-goal byzantine-fortification-probe-found 1)
    (set-goal byzantine-fortification-probe-state byzantine-fortification-probe-finish)
)

(defrule
    (goal byzantine-fortification-probe-state byzantine-fortification-probe-wall)
    (up-compare-goal 368 c:< bt-local-wall-count)
=>
    (set-goal byzantine-fortification-probe-state byzantine-fortification-probe-finish)
)

(defrule
    (goal byzantine-fortification-probe-state byzantine-fortification-probe-finish)
    (goal byzantine-fortification-probe-found 1)
=>
    (up-reset-filters)
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number c:= 0)
    (set-goal byzantine-fortification-threat 1)
    (set-goal byzantine-fortification-probe-state byzantine-fortification-probe-idle)
    (enable-timer byzantine-fortification-probe-timer bt-fortification-probe-seconds)
)

(defrule
    (goal byzantine-fortification-probe-state byzantine-fortification-probe-finish)
    (goal byzantine-fortification-probe-found 0)
=>
    (up-reset-filters)
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number c:= 0)
    (set-goal byzantine-fortification-threat 0)
    (set-goal byzantine-offensive-castle-valid 0)
    (set-goal byzantine-fortification-probe-state byzantine-fortification-probe-idle)
    (enable-timer byzantine-fortification-probe-timer bt-fortification-probe-seconds)
)

(defrule
    (current-age >= castle-age)
    (goal byzantine-army-attack-ready 1)
    (goal byzantine-siege-approach byzantine-siege-approach-normal)
    (goal byzantine-fortification-probe-state byzantine-fortification-probe-idle)
    (goal byzantine-fortification-probe-found 0)
    (goal byzantine-fortification-threat 1)
=>
    (set-goal byzantine-fortification-threat 0)
)

(defrule
    (current-age >= castle-age)
    (goal byzantine-army-attack-ready 1)
    (goal byzantine-siege-approach byzantine-siege-approach-normal)
    (goal byzantine-fortification-threat 1)
=>
    (set-goal byzantine-siege-approach-claim 1)
    (set-goal byzantine-siege-approach byzantine-siege-approach-fortified)
)
(defrule
    (or
        (goal byzantine-siege-approach byzantine-siege-approach-fortified)
        (or
            (goal byzantine-siege-approach byzantine-siege-approach-staging)
            (or
                (goal byzantine-siege-approach byzantine-siege-approach-escorted)
                (goal byzantine-siege-approach byzantine-siege-approach-breach)
            )
        )
    )
    (not (goal byzantine-fortification-threat 1))
=>
    (set-goal byzantine-siege-approach byzantine-siege-approach-normal)
    (set-goal byzantine-siege-approach-claim 0)
    (set-goal byzantine-siege-breach-witness 0)
    (set-goal byzantine-siege-muster-state byzantine-siege-muster-idle)
    (set-goal byzantine-siege-muster-witness 0)
    (disable-timer byzantine-siege-muster-timer)
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-minimum-attack-group-size 0)
    (set-strategic-number sn-maximum-attack-group-size 0)
)


(defrule
    (current-age >= castle-age)
    (goal byzantine-siege-approach byzantine-siege-approach-normal)
    (goal byzantine-fortification-threat 0)
=>
    (set-goal byzantine-siege-approach-claim 0)
)

; Fortified Castle repair: the probe now owns an exact Castle point.
; The Castle point is the OBJECTIVE. It is never used as the muster point.
;
; Naga/community pattern cross-reference:
;   - native attack-group SNs provide execution cohesion;
;   - DUC local searches build target-local unit sets;
;   - siege is kept separate from the escort measurement;
;   - retreat/recovery clears attack-group state instead of silently reusing it.
;
; Byzantine policy:
;   objective -> 24-tile muster point toward self -> 6-tile muster disk.
;   The disk therefore sits outside the existing 16-tile fortification-locality
;   probe by policy geometry (24 - 6 = 18). The distance is a policy invariant,
;   not a fabricated engine-distance witness.
(defrule
    (current-age >= castle-age)
    (goal byzantine-army-attack-ready 1)
    (goal byzantine-siege-approach byzantine-siege-approach-fortified)
    (goal byzantine-siege-approach-claim 1)
    (goal byzantine-offensive-castle-valid 1)
=>
    (up-copy-point byzantine-siege-muster-objective-point byzantine-offensive-castle-point)
    (up-copy-point byzantine-siege-muster-point byzantine-offensive-castle-point)
    (up-lerp-tiles byzantine-siege-muster-point self-x c: bt-byzantine-muster-objective-distance)
    (set-goal byzantine-siege-muster-state byzantine-siege-muster-positioning)
    (set-goal byzantine-siege-muster-witness 0)
    (disable-timer byzantine-siege-muster-timer)
    (set-strategic-number sn-percent-attack-soldiers 100)
    (set-strategic-number sn-number-attack-groups 1)
    (set-strategic-number sn-minimum-attack-group-size 8)
    (set-strategic-number sn-maximum-attack-group-size 40)
    (set-strategic-number sn-attack-group-gather-spacing 6)
    (set-goal byzantine-offensive-push-state byzantine-offensive-push-staging)
)

; Position the existing army at the persistent rally point. No attack command
; is issued here. This is assembly, not assault.
(defrule
    (goal byzantine-siege-approach byzantine-siege-approach-staging)
    (goal byzantine-siege-muster-state byzantine-siege-muster-positioning)
    (goal byzantine-army-attack-ready 1)
    (goal byzantine-siege-approach-claim 1)
    (goal byzantine-offensive-castle-valid 1)
=>
    (up-full-reset-search)
    (up-set-target-point byzantine-siege-muster-point)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-local c: all-units-class c: 240)
    (up-target-point 0 action-move -1 stance-no-attack)
)

; Refresh the physical muster witness: army group.
(defrule
    (or
        (goal byzantine-siege-muster-state byzantine-siege-muster-positioning)
        (or
            (goal byzantine-siege-muster-state byzantine-siege-muster-holding)
            (goal byzantine-siege-muster-state byzantine-siege-muster-confirmed)
        )
    )
    (goal byzantine-siege-approach-claim 1)
    (goal byzantine-offensive-castle-valid 1)
=>
    (up-full-reset-search)
    (up-set-target-point byzantine-siege-muster-point)
    (up-filter-distance c: 0 c: bt-byzantine-muster-radius)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-local c: all-units-class c: 40)
    (up-remove-objects search-local object-data-class == siege-weapon-class)
    (up-remove-objects search-local object-data-class == packed-trebuchet-class)
    (up-remove-objects search-local object-data-class == unpacked-trebuchet-class)
    (up-create-group 0 40 c: byzantine-siege-muster-army-group)
)

; Refresh the physical muster witness: trebuchet group.
(defrule
    (or
        (goal byzantine-siege-muster-state byzantine-siege-muster-positioning)
        (or
            (goal byzantine-siege-muster-state byzantine-siege-muster-holding)
            (goal byzantine-siege-muster-state byzantine-siege-muster-confirmed)
        )
    )
    (goal byzantine-siege-approach-claim 1)
    (goal byzantine-offensive-castle-valid 1)
=>
    (up-full-reset-search)
    (up-set-target-point byzantine-siege-muster-point)
    (up-filter-distance c: 0 c: bt-byzantine-muster-radius)
    (up-find-local c: packed-trebuchet-class c: 40)
    (up-find-local c: unpacked-trebuchet-class c: 40)
    (up-create-group 0 40 c: byzantine-siege-muster-trebuchet-group)
)

; Refresh the physical muster witness: Bombard Cannon group.
(defrule
    (or
        (goal byzantine-siege-muster-state byzantine-siege-muster-positioning)
        (or
            (goal byzantine-siege-muster-state byzantine-siege-muster-holding)
            (goal byzantine-siege-muster-state byzantine-siege-muster-confirmed)
        )
    )
    (goal byzantine-siege-approach-claim 1)
    (goal byzantine-offensive-castle-valid 1)
=>
    (up-full-reset-search)
    (up-set-target-point byzantine-siege-muster-point)
    (up-filter-distance c: 0 c: bt-byzantine-muster-radius)
    (up-find-local c: bombard-cannon-line c: 40)
    (up-create-group 0 40 c: byzantine-siege-muster-bombard-group)
)

; Refresh the physical muster witness: Ram group.
(defrule
    (or
        (goal byzantine-siege-muster-state byzantine-siege-muster-positioning)
        (or
            (goal byzantine-siege-muster-state byzantine-siege-muster-holding)
            (goal byzantine-siege-muster-state byzantine-siege-muster-confirmed)
        )
    )
    (goal byzantine-siege-approach-claim 1)
    (goal byzantine-offensive-castle-valid 1)
=>
    (up-full-reset-search)
    (up-set-target-point byzantine-siege-muster-point)
    (up-filter-distance c: 0 c: bt-byzantine-muster-radius)
    (up-find-local c: battering-ram-line c: 40)
    (up-create-group 0 40 c: byzantine-siege-muster-ram-group)
)

; Fresh physical package witness. Siege thresholds intentionally mirror the
; existing Byzantine attack-ready package. This rule does not create a second
; production floor.
(defrule
    (goal byzantine-siege-muster-state byzantine-siege-muster-positioning)
    (goal byzantine-siege-approach-claim 1)
    (goal byzantine-offensive-castle-valid 1)
    (up-group-size c: byzantine-siege-muster-army-group >= bt-byzantine-muster-castle-army)
    (up-group-size c: byzantine-siege-muster-trebuchet-group >= bt-castle-mangonel-floor)
=>
    (set-goal byzantine-siege-muster-witness 1)
    (set-goal byzantine-siege-muster-state byzantine-siege-muster-holding)
    (enable-timer byzantine-siege-muster-timer bt-byzantine-muster-confirm-seconds)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-siege-muster-state byzantine-siege-muster-positioning)
    (goal byzantine-siege-approach-claim 1)
    (goal byzantine-offensive-castle-valid 1)
    (up-group-size c: byzantine-siege-muster-army-group >= bt-byzantine-muster-imperial-army)
    (or
        (and
            (goal byzantine-siege-scale byzantine-siege-scale-standard)
            (and
                (up-group-size c: byzantine-siege-muster-trebuchet-group >= bt-imperial-trebuchet-target)
                (and
                    (up-group-size c: byzantine-siege-muster-bombard-group >= bt-imperial-bombard-floor)
                    (up-group-size c: byzantine-siege-muster-ram-group >= bt-imperial-attack-siege-target)
                )
            )
        )
        (and
            (goal byzantine-siege-scale byzantine-siege-scale-fortified)
            (and
                (up-group-size c: byzantine-siege-muster-trebuchet-group >= bt-imperial-fortified-trebuchet-target)
                (and
                    (up-group-size c: byzantine-siege-muster-bombard-group >= bt-imperial-fortified-bombard-target)
                    (up-group-size c: byzantine-siege-muster-ram-group >= bt-imperial-fortified-ram-target)
                )
            )
        )
    )
=>
    (set-goal byzantine-siege-muster-witness 1)
    (set-goal byzantine-siege-muster-state byzantine-siege-muster-holding)
    (enable-timer byzantine-siege-muster-timer bt-byzantine-muster-confirm-seconds)
)

; Holding remains a world-state witness, never a timer-only state.
(defrule
    (goal byzantine-siege-muster-state byzantine-siege-muster-holding)
    (goal byzantine-siege-muster-witness 1)
    (not
        (and
            (up-group-size c: byzantine-siege-muster-army-group >= bt-byzantine-muster-castle-army)
            (up-group-size c: byzantine-siege-muster-trebuchet-group >= bt-castle-mangonel-floor)
        )
    )
=>
    (set-goal byzantine-siege-muster-state byzantine-siege-muster-positioning)
    (set-goal byzantine-siege-muster-witness 0)
    (disable-timer byzantine-siege-muster-timer)
)

; Imperial holding-loss recovery. The same package thresholds used for admission
; own the invalidation boundary.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-siege-muster-state byzantine-siege-muster-holding)
    (goal byzantine-siege-muster-witness 1)
    (not
        (and
            (up-group-size c: byzantine-siege-muster-army-group >= bt-byzantine-muster-imperial-army)
            (or
                (and
                    (goal byzantine-siege-scale byzantine-siege-scale-standard)
                    (and
                        (up-group-size c: byzantine-siege-muster-trebuchet-group >= bt-imperial-trebuchet-target)
                        (and
                            (up-group-size c: byzantine-siege-muster-bombard-group >= bt-imperial-bombard-floor)
                            (up-group-size c: byzantine-siege-muster-ram-group >= bt-imperial-attack-siege-target)
                        )
                    )
                )
                (and
                    (goal byzantine-siege-scale byzantine-siege-scale-fortified)
                    (and
                        (up-group-size c: byzantine-siege-muster-trebuchet-group >= bt-imperial-fortified-trebuchet-target)
                        (and
                            (up-group-size c: byzantine-siege-muster-bombard-group >= bt-imperial-fortified-bombard-target)
                            (up-group-size c: byzantine-siege-muster-ram-group >= bt-imperial-fortified-ram-target)
                        )
                    )
                )
            )
        )
    )
=>
    (set-goal byzantine-siege-muster-state byzantine-siege-muster-positioning)
    (set-goal byzantine-siege-muster-witness 0)
    (disable-timer byzantine-siege-muster-timer)
)

; Confirmation requires the physical witness to survive the debounce interval.
(defrule
    (timer-triggered byzantine-siege-muster-timer)
    (goal byzantine-siege-muster-state byzantine-siege-muster-holding)
    (goal byzantine-siege-muster-witness 1)
    (goal byzantine-siege-approach-claim 1)
    (goal byzantine-offensive-castle-valid 1)
    (goal byzantine-army-attack-ready 1)
=>
    (disable-timer byzantine-siege-muster-timer)
    (set-goal byzantine-siege-muster-state byzantine-siege-muster-confirmed)
    (set-goal byzantine-offensive-push-state byzantine-offensive-push-assault)
    (set-goal byzantine-siege-approach byzantine-siege-approach-escorted)
)

; Once the formation is physically confirmed, issue ONE target-point
; attack-move from the muster disk to the real objective. This is the Naga-like
; "local assembled force -> target point" handoff.
(defrule
    (goal byzantine-siege-muster-state byzantine-siege-muster-confirmed)
    (goal byzantine-siege-approach byzantine-siege-approach-escorted)
    (goal byzantine-siege-approach-claim 1)
    (goal byzantine-army-attack-ready 1)
    (goal byzantine-offensive-castle-valid 1)
=>
    (set-strategic-number sn-percent-attack-soldiers 100)
    (set-strategic-number sn-number-attack-groups 1)
    (set-strategic-number sn-minimum-attack-group-size 8)
    (set-strategic-number sn-maximum-attack-group-size 40)
    (set-strategic-number sn-attack-group-gather-spacing 6)
    (up-full-reset-search)
    (up-set-target-point byzantine-siege-muster-point)
    (up-filter-distance c: 0 c: bt-byzantine-muster-radius)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-local c: all-units-class c: 40)
    (up-set-target-point byzantine-siege-muster-objective-point)
    (up-target-point 0 action-attack-move -1 stance-aggressive)
    (set-goal byzantine-army-attack-ready 2)
    (set-goal byzantine-siege-approach byzantine-siege-approach-breach)
)

; Breach release remains guarded. The target-point assault above has already
; moved the assembled formation; attack-now is reserved for the later assault
; phase once the fortification witness changes.
(defrule
    (current-age >= castle-age)
    (goal byzantine-siege-approach byzantine-siege-approach-breach)
    (goal byzantine-siege-approach-claim 1)
    (goal byzantine-army-attack-ready 2)
=>
    (disable-timer byzantine-army-stale-timer)
    (enable-timer byzantine-army-stale-timer bt-army-stale-seconds)
)

; Breach truth is world-state truth, not action issuance.
(defrule
    (goal byzantine-siege-approach byzantine-siege-approach-breach)
    (goal byzantine-siege-approach-claim 1)
    (goal byzantine-army-attack-ready 2)
    (goal byzantine-fortification-threat 0)
=>
    (set-goal byzantine-siege-breach-witness 1)
    (set-goal byzantine-siege-approach byzantine-siege-approach-assault)
    (set-goal byzantine-siege-muster-state byzantine-siege-muster-confirmed)
)

; The assault state re-enters attack-now only after the breach witness, including
; after a reinforcement cycle.
(defrule
    (current-age >= castle-age)
    (goal byzantine-siege-approach byzantine-siege-approach-assault)
    (goal byzantine-siege-approach-claim 1)
    (goal byzantine-siege-breach-witness 1)
    (goal byzantine-army-attack-ready 2)
    (goal byzantine-army-stale-state byzantine-army-stale-ready)
=>
    (set-strategic-number sn-percent-attack-soldiers 100)
    (attack-now)
    (disable-timer byzantine-army-stale-timer)
    (enable-timer byzantine-army-stale-timer bt-army-stale-seconds)
    (set-goal byzantine-army-stale-state byzantine-army-stale-armed)
)
 
; Package loss during a fortified approach returns through the existing army
; reinforcement path, never directly back to assault.
(defrule
    (or
        (goal byzantine-siege-approach byzantine-siege-approach-staging)
        (or
            (goal byzantine-siege-approach byzantine-siege-approach-escorted)
            (or
                (goal byzantine-siege-approach byzantine-siege-approach-breach)
                (or
                    (goal byzantine-siege-approach byzantine-siege-approach-assault)
                    (goal byzantine-siege-approach byzantine-siege-approach-recover)
                )
            )
        )
    )
    (goal byzantine-army-attack-ready 2)
    (or
        (and
            (current-age == castle-age)
            (or
                (unit-type-count-total cataphract-line < bt-castle-cataphract-floor)
                (or
                    (unit-type-count-total skirmisher-line < bt-castle-skirmisher-floor)
                    (or
                        (unit-type-count-total mangonel-line < bt-castle-mangonel-floor)
                        (unit-type-count-total monk < bt-castle-monk-floor)
                    )
                )
            )
        )
        (and
            (current-age >= imperial-age)
            (or
                (unit-type-count-total 359 < bt-imperial-halberdier-floor)
                (or
                    (unit-type-count-total trebuchet < bt-imperial-attack-siege-target)
                    (or
                        (unit-type-count-total bombard-cannon < bt-imperial-bombard-floor)
                        (unit-type-count-total battering-ram-line < bt-imperial-attack-siege-target)
                    )
                )
            )
        )
    )
=>
    (set-goal byzantine-siege-approach byzantine-siege-approach-recover)
    (set-goal byzantine-army-attack-ready 0)
    (set-goal byzantine-siege-breach-witness 0)
    (set-goal byzantine-siege-muster-state byzantine-siege-muster-idle)
    (set-goal byzantine-siege-muster-witness 0)
    (disable-timer byzantine-siege-muster-timer)
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-minimum-attack-group-size 0)
    (set-strategic-number sn-maximum-attack-group-size 0)
)

(defrule
    (goal byzantine-siege-approach byzantine-siege-approach-recover)
    (goal byzantine-army-reinforcement 0)
    (goal byzantine-army-attack-ready 1)
    (goal byzantine-fortification-threat 1)
=>
    (set-goal byzantine-siege-approach byzantine-siege-approach-staging)
    (set-goal byzantine-siege-approach-claim 1)
)

(defrule
    (goal byzantine-siege-approach byzantine-siege-approach-recover)
    (not (goal byzantine-fortification-threat 1))
=>
    (set-goal byzantine-siege-approach byzantine-siege-approach-normal)
    (set-goal byzantine-siege-approach-claim 0)
    (set-goal byzantine-siege-breach-witness 0)
)

; Bounded stale-army recovery. The attack-now group gets one 90-second
; productivity probe per attack cycle. With a meaningful military population,
; three or fewer attack soldiers means the attack group has effectively dissolved
; or become non-operative. Fortified staging/breach states are left alone because
; their slower movement is intentional. The existing reinforcement controller
; owns the recovery.
(defrule
    (timer-triggered byzantine-army-stale-timer)
    (goal byzantine-army-stale-state byzantine-army-stale-armed)
    (goal byzantine-army-attack-ready 2)
    (goal byzantine-army-reinforcement 0)
    (or
        (goal byzantine-siege-approach byzantine-siege-approach-normal)
        (goal byzantine-siege-approach byzantine-siege-approach-assault)
    )
    ; attack-ready already proves the selected package exists; do not add a
    ; military-population floor that is larger than the 11-unit Castle package.
    (attack-soldier-count <= 3)
=>
    (disable-timer byzantine-army-stale-timer)
    (up-reset-attack-now)
    (disable-timer byzantine-fortification-probe-timer)
    (set-goal byzantine-fortification-probe-found 0)
    (set-goal byzantine-fortification-threat 0)
    (set-goal byzantine-army-stale-state byzantine-army-stale-triggered)
    (set-goal byzantine-army-attack-ready 0)
    (set-goal byzantine-army-reinforcement 1)
    (set-goal byzantine-army-reposition-state byzantine-army-reposition-withdraw)
)

; Timer expires while an army is deliberately in fortified staging/breach.
; Do not call that a failure; re-arm the same bounded watchdog for the later
; assault state rather than injecting a second tactical scheduler.
(defrule
    (timer-triggered byzantine-army-stale-timer)
    (goal byzantine-army-stale-state byzantine-army-stale-armed)
    (goal byzantine-army-attack-ready 2)
    (or
        (goal byzantine-siege-approach byzantine-siege-approach-fortified)
        (or
            (goal byzantine-siege-approach byzantine-siege-approach-staging)
            (or
                (goal byzantine-siege-approach byzantine-siege-approach-escorted)
                (goal byzantine-siege-approach byzantine-siege-approach-breach)
            )
        )
    )
=>
    (disable-timer byzantine-army-stale-timer)
    (enable-timer byzantine-army-stale-timer bt-army-stale-seconds)
)

(defrule
    (goal byzantine-army-stale-state byzantine-army-stale-triggered)
    (goal byzantine-army-attack-ready 1)
=>
    (set-goal byzantine-army-stale-state byzantine-army-stale-ready)
)

; Ordinary open-ground attack remains exactly where it belonged: behind the
; tactical admission gate. Fortified states cannot bypass it.
(defrule
    (current-age >= castle-age)
    (goal byzantine-army-attack-ready 1)
    (goal byzantine-siege-approach byzantine-siege-approach-normal)
    (goal byzantine-army-stale-state byzantine-army-stale-ready)
=>
    (attack-now)
    (disable-timer byzantine-army-stale-timer)
    (enable-timer byzantine-army-stale-timer bt-army-stale-seconds)
    (set-goal byzantine-army-stale-state byzantine-army-stale-armed)
    (set-goal byzantine-army-attack-ready 2)
)

; Reinforcement is driven by loss of the attack package, not by enemy sighting.
(defrule
    (current-age == castle-age)
    (goal byzantine-army-attack-ready 2)
    (or
        (unit-type-count-total cataphract-line < bt-castle-cataphract-floor)
        (or
            (unit-type-count-total skirmisher-line < bt-castle-skirmisher-floor)
            (or
                (unit-type-count-total mangonel-line < bt-castle-mangonel-floor)
                (unit-type-count-total monk < bt-castle-monk-floor)
            )
        )
    )
=> 
    (set-goal byzantine-army-attack-ready 0)
    (set-goal byzantine-army-reinforcement 1)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-army-attack-ready 2)
    (or
        (unit-type-count-total 359 < bt-imperial-halberdier-floor)
        (or
            (and
                (goal byzantine-siege-scale byzantine-siege-scale-standard)
                (or
                    (unit-type-count-total trebuchet < bt-imperial-trebuchet-target)
                    (or
                        (unit-type-count-total bombard-cannon < bt-imperial-bombard-floor)
                        (unit-type-count-total battering-ram-line < bt-imperial-attack-siege-target)
                    )
                )
            )
            (and
                (goal byzantine-siege-scale byzantine-siege-scale-fortified)
                (or
                    (unit-type-count-total trebuchet < bt-imperial-fortified-trebuchet-target)
                    (or
                        (unit-type-count-total bombard-cannon < bt-imperial-fortified-bombard-target)
                        (unit-type-count-total battering-ram-line < bt-imperial-fortified-ram-target)
                    )
                )
            )
        )
    )
=> 
    (set-goal byzantine-army-attack-ready 0)
    (set-goal byzantine-army-reinforcement 1)
)

(defrule
    (goal byzantine-army-reinforcement 1)
    (current-age == castle-age)
    (unit-type-count-total cataphract-line >= bt-castle-cataphract-floor)
    (unit-type-count-total skirmisher-line >= bt-castle-skirmisher-floor)
    (unit-type-count-total mangonel-line >= bt-castle-mangonel-floor)
    (unit-type-count-total monk >= bt-castle-monk-floor)
=>
    (set-goal byzantine-army-reinforcement 0)
    (set-goal byzantine-army-attack-ready 1)
)

(defrule
    (goal byzantine-army-reinforcement 1)
    (current-age >= imperial-age)
    (unit-type-count-total 359 >= bt-imperial-halberdier-floor)
    (or
        (goal byzantine-imperial-composition-posture byzantine-imperial-posture-balanced)
        (or
            (goal byzantine-imperial-composition-posture byzantine-imperial-posture-mounted)
            (goal byzantine-imperial-composition-posture byzantine-imperial-posture-siege)
        )
    )
    (unit-type-count-total cataphract-line >= bt-imperial-cataphract-floor)
    (or
        (and
            (goal byzantine-siege-scale byzantine-siege-scale-standard)
            (and
                (unit-type-count-total trebuchet >= bt-imperial-trebuchet-target)
                (and
                    (unit-type-count-total bombard-cannon >= bt-imperial-bombard-floor)
                    (unit-type-count-total battering-ram-line >= bt-imperial-attack-siege-target)
                )
            )
        )
        (and
            (goal byzantine-siege-scale byzantine-siege-scale-fortified)
            (and
                (unit-type-count-total trebuchet >= bt-imperial-fortified-trebuchet-target)
                (and
                    (unit-type-count-total bombard-cannon >= bt-imperial-fortified-bombard-target)
                    (unit-type-count-total battering-ram-line >= bt-imperial-fortified-ram-target)
                )
            )
        )
    )
=>
    (set-goal byzantine-army-reinforcement 0)
    (set-goal byzantine-army-attack-ready 1)
)

(defrule
    (goal byzantine-army-reinforcement 1)
    (current-age >= imperial-age)
    (unit-type-count-total 359 >= bt-imperial-halberdier-floor)
    (goal byzantine-imperial-composition-posture byzantine-imperial-posture-infantry)
    (unit-type-count-total varangian-guard-line >= bt-imperial-varangian-floor)
    (or
        (and
            (goal byzantine-siege-scale byzantine-siege-scale-standard)
            (and
                (unit-type-count-total trebuchet >= bt-imperial-trebuchet-target)
                (and
                    (unit-type-count-total bombard-cannon >= bt-imperial-bombard-floor)
                    (unit-type-count-total battering-ram-line >= bt-imperial-attack-siege-target)
                )
            )
        )
        (and
            (goal byzantine-siege-scale byzantine-siege-scale-fortified)
            (and
                (unit-type-count-total trebuchet >= bt-imperial-fortified-trebuchet-target)
                (and
                    (unit-type-count-total bombard-cannon >= bt-imperial-fortified-bombard-target)
                    (unit-type-count-total battering-ram-line >= bt-imperial-fortified-ram-target)
                )
            )
        )
    )
=>
    (set-goal byzantine-army-reinforcement 0)
    (set-goal byzantine-army-attack-ready 1)
)

(defrule
    (goal byzantine-army-reinforcement 1)
    (current-age >= imperial-age)
    (unit-type-count-total 359 >= bt-imperial-halberdier-floor)
    (goal byzantine-imperial-composition-posture byzantine-imperial-posture-ranged)
    (unit-type-count-total arbalest >= bt-imperial-arbalester-floor)
    (or
        (and
            (goal byzantine-siege-scale byzantine-siege-scale-standard)
            (and
                (unit-type-count-total trebuchet >= bt-imperial-trebuchet-target)
                (and
                    (unit-type-count-total bombard-cannon >= bt-imperial-bombard-floor)
                    (unit-type-count-total battering-ram-line >= bt-imperial-attack-siege-target)
                )
            )
        )
        (and
            (goal byzantine-siege-scale byzantine-siege-scale-fortified)
            (and
                (unit-type-count-total trebuchet >= bt-imperial-fortified-trebuchet-target)
                (and
                    (unit-type-count-total bombard-cannon >= bt-imperial-fortified-bombard-target)
                    (unit-type-count-total battering-ram-line >= bt-imperial-fortified-ram-target)
                )
            )
        )
    )
=>
    (set-goal byzantine-army-reinforcement 0)
    (set-goal byzantine-army-attack-ready 1)
)

