; Pending diagnostics: economy-barracks-floor-1
; PENDING-DIAGNOSTIC [INFO] PENDING-ACTION-GUARD: action is gated by active goal 271 and cannot reissue from pending goal 272
; PENDING-DIAGNOSTIC [INFO] PENDING-WITNESS-GUARD: completion witness is evaluated only while pending goal 272 is active
; PENDING-DIAGNOSTIC [INFO] PENDING-RELEASE-GUARD: release is evaluated only after completion goal 274 is reached
; PENDING-DIAGNOSTIC [INFO] PENDING-ACTION-WITNESS-SEPARATE: action 'build' is not treated as completion evidence; witness 'building-type-count' owns completion
; PENDING-DIAGNOSTIC [INFO] PENDING-RELEASE-SEPARATE: release remains separate from witness 'building-type-count' and may clear the demand only from complete state
; Issuance failure: economy-barracks-floor-1 | RETAIN-ACTIVE
; An unsatisfied issuance guard leaves demand-economy-barracks-floor-1 in ACTIVE; it is not PENDING.
; Release: economy-barracks-floor-1 | COMPLETE -> RELEASED
(defrule
    (goal demand-economy-barracks-floor-1 274)
    (building-type-count barracks >= 1)
=>
    (set-goal demand-economy-barracks-floor-1 0)
)

; Recovery: economy-barracks-floor-1 | RELEASED -> ACTIVE on world-state loss
(defrule
    (goal demand-economy-barracks-floor-1 0)
    (not (building-type-count barracks >= 1))
    (current-age >= dark-age)
=>
    (set-goal demand-economy-barracks-floor-1 1)
)

; Construction observation: economy-barracks-floor-1
; Precedence: COMPLETE > FOUNDATION_PENDING > PLACEMENT_PENDING > RETRY
; Completion witness: economy-barracks-floor-1 | PENDING/ISSUED -> COMPLETE
(defrule
    (or
        (goal demand-economy-barracks-floor-1 272)
        (goal demand-economy-barracks-floor-1 273)
    )
    (building-type-count barracks >= 1)
=>
    (set-goal demand-economy-barracks-floor-1 274)
)

; Pending admission: economy-barracks-floor-1 | ISSUED/PENDING -> PENDING
(defrule
    (or
        (goal demand-economy-barracks-floor-1 272)
        (goal demand-economy-barracks-floor-1 273)
    )
    (not (building-type-count barracks >= 1))
    (up-pending-objects c: 12 >= 1)
=>
    (set-goal demand-economy-barracks-floor-1 273)
)

; PLACEMENT_PENDING | ISSUED/PENDING -> PENDING
(defrule
    (or
        (goal demand-economy-barracks-floor-1 272)
        (goal demand-economy-barracks-floor-1 273)
    )
    (not (building-type-count barracks >= 1))
    (up-pending-objects c: 12 == 0)
    (up-pending-placement c: 12)
=>
    (set-goal demand-economy-barracks-floor-1 273)
)

; RETRY | ISSUED/PENDING -> ACTIVE
