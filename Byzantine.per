    (up-get-point position-object byzantine-wall-outpost-point)
)
(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (goal byzantine-wall-anchor-pair 0)
    (building-type-count town-center >= 1)
    (building-type-count castle >= 1)
    (current-age >= castle-age)
    (up-point-distance byzantine-wall-tc-point byzantine-wall-castle-point <= 8)
=>
    (set-goal byzantine-wall-anchor-pair byzantine-wall-pair-town-center-castle)
    (set-goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
)
