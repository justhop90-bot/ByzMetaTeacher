(defrule
    (goal economy-posture 9)
    (up-compare-sn sn-gold-gatherer-percentage != 38)
=>
    (set-strategic-number sn-gold-gatherer-percentage 38)
)

; Native control rule: economy-controller-write-fast_imperial-sn-percent-civilian-builders
(defrule
    (goal economy-posture 9)
    (up-compare-sn sn-percent-civilian-builders != 7)
=>
    (set-strategic-number sn-percent-civilian-builders 7)
)

; Community-derived Byzantine boom override: once TC2/TC3 is active, wood must fund
; farms and the extra TC network instead of leaving Castle conversion at 25% wood.
(defrule
    (current-age == castle-age)
    (goal strategic-primary-intent 3)
    (building-type-count-total town-center >= 2)
    (up-compare-sn sn-food-gatherer-percentage != 45)
=>
    (set-strategic-number sn-food-gatherer-percentage 45)
)

(defrule
    (current-age == castle-age)
    (goal strategic-primary-intent 3)
    (building-type-count-total town-center >= 2)
    (up-compare-sn sn-wood-gatherer-percentage != 35)
=>
    (set-strategic-number sn-wood-gatherer-percentage 35)
)

(defrule
    (current-age == castle-age)
    (goal strategic-primary-intent 3)
    (building-type-count-total town-center >= 2)
    (up-compare-sn sn-gold-gatherer-percentage != 20)
=>
    (set-strategic-number sn-gold-gatherer-percentage 20)
)

; Imperial 3-TC boom retains a dedicated wood share for reseeding and farm expansion.
(defrule
    (current-age >= imperial-age)
    (goal strategic-primary-intent 3)
    (building-type-count-total town-center >= 3)
    (building-type-count farm < bt-imperial-farm-target-3tc)
    (up-compare-sn sn-food-gatherer-percentage != 40)
=>
    (set-strategic-number sn-food-gatherer-percentage 40)
)

(defrule
    (current-age >= imperial-age)
    (goal strategic-primary-intent 3)
    (building-type-count-total town-center >= 3)
    (building-type-count farm < bt-imperial-farm-target-3tc)
    (up-compare-sn sn-wood-gatherer-percentage != 30)
=>
    (set-strategic-number sn-wood-gatherer-percentage 30)
)

(defrule
    (current-age >= imperial-age)
    (goal strategic-primary-intent 3)
    (building-type-count-total town-center >= 3)
    (building-type-count farm < bt-imperial-farm-target-3tc)
    (up-compare-sn sn-gold-gatherer-percentage != 30)
=>
    (set-strategic-number sn-gold-gatherer-percentage 30)
)

; Native control rule: economy-controller-write-food_recovery-sn-food-gatherer-percentage
(defrule
    (goal economy-posture 8)
    (up-compare-sn sn-food-gatherer-percentage != 70)
=>
    (set-strategic-number sn-food-gatherer-percentage 70)
)

; Native control rule: economy-controller-write-food_recovery-sn-wood-gatherer-percentage
(defrule
    (goal economy-posture 8)
    (up-compare-sn sn-wood-gatherer-percentage != 20)
=>
    (set-strategic-number sn-wood-gatherer-percentage 20)
)

; Native control rule: economy-controller-write-food_recovery-sn-gold-gatherer-percentage
(defrule
    (goal economy-posture 8)
    (up-compare-sn sn-gold-gatherer-percentage != 10)
=>
    (set-strategic-number sn-gold-gatherer-percentage 10)
)

; Feudal Castle-transition economy keeps stone at zero. Stone is opened only from Castle Age.

(defrule
    (current-age == castle-age)
    (not (goal economy-posture 8))
    (building-type-count-total castle < 1)
    (stone-amount < 650)
    (up-compare-sn sn-stone-gatherer-percentage != 20)
=>
    (set-strategic-number sn-food-gatherer-percentage 40)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 10)
    (set-strategic-number sn-stone-gatherer-percentage 20)
)

(defrule
    (current-age == castle-age)
    (goal strategic-primary-intent 3)
    (not (goal economy-posture 8))
    (building-type-count-total castle >= 1)
    (building-type-count-total town-center < 2)
    (stone-amount < 100)
    (up-compare-sn sn-stone-gatherer-percentage != 10)
=>
    (set-strategic-number sn-food-gatherer-percentage 45)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 15)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)

(defrule
    (current-age == castle-age)
    (goal strategic-primary-intent 3)
    (not (goal economy-posture 8))
    (building-type-count-total town-center >= 2)
    (building-type-count-total town-center < 3)
    (stone-amount < 100)
    (up-compare-sn sn-stone-gatherer-percentage != 10)
=>
    (set-strategic-number sn-food-gatherer-percentage 45)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 15)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)

; After the Castle boom reaches TC3, release the temporary stone mode.
; Naga-style economy control treats stone as a demand resource, not a permanent tax.
(defrule
    (current-age == castle-age)
    (goal strategic-primary-intent 0)
    (building-type-count-total town-center >= 3)
    (up-compare-sn sn-stone-gatherer-percentage != 0)
=>
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

; Native control rule: economy-controller-write-food_recovery-sn-percent-civilian-builders
(defrule
    (goal economy-posture 8)
    (up-compare-sn sn-percent-civilian-builders != 5)
=>
    (set-strategic-number sn-percent-civilian-builders 5)
)

; Native tower geometry policy: preserve elevation preference for every
; point/forward tower placement. The placement command remains the engine
; executor; this rule only selects its native policy.
(defrule
    (up-compare-sn sn-ignore-tower-elevation != 0)
=>
    (set-strategic-number sn-ignore-tower-elevation 0)
)

;----------------------------------------------------------------
; BYZANTINE THREE-LAYER CAMP PLACEMENT CONTROLLER
; Resource-front observation -> bounded native placement radius -> construction.
; The controller deliberately refuses to widen camp/drop distances indefinitely:
; near resources get a new dropsite, distant resources do not drag villagers
; across the map to feed a singleton resource node.
(defrule
    (or
        (up-compare-sn sn-allow-adjacent-dropsites != 0)
        (up-compare-sn sn-dropsite-separation-distance != 6)
    )
=>
    (set-strategic-number sn-allow-adjacent-dropsites 0)
    (set-strategic-number sn-dropsite-separation-distance 6)
)

(defrule
    (current-age < feudal-age)
=>
    (set-strategic-number sn-lumber-camp-max-distance 14)
    (set-strategic-number sn-mining-camp-max-distance 14)
)

(defrule
    (and (current-age >= feudal-age) (current-age < castle-age))
=>
    (set-strategic-number sn-lumber-camp-max-distance 18)
    (set-strategic-number sn-mining-camp-max-distance 18)
)

(defrule
    (and (current-age >= castle-age) (current-age < imperial-age))
=>
    (set-strategic-number sn-lumber-camp-max-distance 18)
    (set-strategic-number sn-mining-camp-max-distance 18)
)

(defrule
    (current-age >= imperial-age)
=>
    (set-strategic-number sn-lumber-camp-max-distance 20)
    (set-strategic-number sn-mining-camp-max-distance 20)
)

; Byzantine near-resource lumber-camp recovery
(defrule
    (resource-found wood)
    (dropsite-min-distance wood > 6)
    (dropsite-min-distance wood <= 18)
    (can-build lumber-camp)
    (building-type-count-total lumber-camp < 6)
    (goal action-claim-build-pass-singleton 0)
    (not (town-under-attack))
    (not (goal byzantine-fortification-threat 1))
=>
    (set-strategic-number sn-maximum-wood-drop-distance 16)
    (build lumber-camp)
    (set-goal action-claim-build-pass-singleton 1)
)

; Byzantine near-resource mining-camp recovery
(defrule
    (resource-found gold)
    (dropsite-min-distance gold > 6)
    (dropsite-min-distance gold <= 18)
    (can-build mining-camp)
    (building-type-count-total mining-camp < 5)
    (goal action-claim-build-pass-singleton 0)
    (not (town-under-attack))
    (not (goal byzantine-fortification-threat 1))
=>
    (set-strategic-number sn-maximum-gold-drop-distance 16)
    (set-strategic-number sn-gold-dropsite-distance 3)
    (set-strategic-number sn-stone-dropsite-distance 40)
    (build mining-camp)
    (set-strategic-number sn-gold-dropsite-distance 3)
    (set-strategic-number sn-stone-dropsite-distance 3)
    (set-goal action-claim-build-pass-singleton 1)
)

; The same bounded front rule applies to stone, but Castle/Imperial stone is
; strategic and therefore does not bypass the existing castle-stone policy.
(defrule
    (current-age >= castle-age)
    (resource-found stone)
    (dropsite-min-distance stone > 6)
    (dropsite-min-distance stone <= 18)
    (can-build mining-camp)
    (building-type-count-total mining-camp < 5)
    (goal action-claim-build-pass-singleton 0)
    (not (town-under-attack))
    (not (goal byzantine-fortification-threat 1))
=>
    (set-strategic-number sn-gold-dropsite-distance 40)
    (set-strategic-number sn-stone-dropsite-distance 3)
    (build mining-camp)
    (set-strategic-number sn-gold-dropsite-distance 3)
    (set-strategic-number sn-stone-dropsite-distance 3)
    (set-goal action-claim-build-pass-singleton 1)
)

