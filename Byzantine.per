    (goal action-claim-train-arbitration 0)
    (current-age >= imperial-age)
    (can-train-with-escrow 528)
    (unit-type-count-total 528 < 1)
=>
    (train 528)
    (set-goal action-claim-train-arbitration 1)
    (set-goal demand-water-heavy-demolition-ship-floor 135)
)

; Pending diagnostics: water-trade-cog-floor
; PENDING-DIAGNOSTIC [INFO] PENDING-ACTION-GUARD: action is gated by active goal 137 and cannot reissue from pending goal 138
; PENDING-DIAGNOSTIC [INFO] PENDING-WITNESS-GUARD: completion witness is evaluated only while pending goal 138 is active
; PENDING-DIAGNOSTIC [INFO] PENDING-RELEASE-GUARD: release is evaluated only after completion goal 139 is reached
; PENDING-DIAGNOSTIC [INFO] PENDING-ACTION-WITNESS-SEPARATE: action 'train' is not treated as completion evidence; witness 'unit-type-count' owns completion
; PENDING-DIAGNOSTIC [INFO] PENDING-RELEASE-SEPARATE: release remains separate from witness 'unit-type-count' and may clear the demand only from complete state
; Issuance failure: water-trade-cog-floor | RETAIN-ACTIVE
; An unsatisfied issuance guard leaves demand-water-trade-cog-floor in ACTIVE; it is not PENDING.
; Release: water-trade-cog-floor | COMPLETE -> RELEASED
(defrule
    (goal demand-water-trade-cog-floor 139)
    (unit-type-count 17 >= 2)
=>
    (set-goal demand-water-trade-cog-floor 0)
)

; Recovery: water-trade-cog-floor | RELEASED -> ACTIVE on world-state loss
(defrule
    (goal demand-water-trade-cog-floor 0)
    (not (unit-type-count 17 >= 2))
    (goal strategic-primary-intent 1)
    (and (map-type islands) (players-building-type-count any-ally market >= 1))
=>
    (set-goal demand-water-trade-cog-floor 1)
)

; Completion witness: water-trade-cog-floor | PENDING/ISSUED -> COMPLETE
(defrule
    (or
        (goal demand-water-trade-cog-floor 140)
        (goal demand-water-trade-cog-floor 138)
    )
    (unit-type-count 17 >= 2)
=>
    (set-goal demand-water-trade-cog-floor 139)
)

; Pending admission: water-trade-cog-floor | ISSUED/PENDING -> PENDING
(defrule
    (or
        (goal demand-water-trade-cog-floor 140)
        (goal demand-water-trade-cog-floor 138)
    )
    (not (unit-type-count 17 >= 2))
    (up-pending-objects c: 17 >= 1)
=>
    (set-goal demand-water-trade-cog-floor 138)
)

; RETRY | ISSUED/PENDING -> ACTIVE
(defrule
    (or
        (goal demand-water-trade-cog-floor 140)
        (goal demand-water-trade-cog-floor 138)
    )
    (not (unit-type-count 17 >= 2))
    (not (up-pending-objects c: 17 >= 1))
=>
    (set-goal demand-water-trade-cog-floor 1)
    (set-goal production-retry-barrier-water-trade-cog-floor 1)
)

; Action issuance: water-trade-cog-floor | ACTIVE -> ISSUED
(defrule
    (goal demand-water-trade-cog-floor 1)
    (not (unit-type-count 17 >= 2))
    (goal production-retry-barrier-water-trade-cog-floor 0)
    (not (up-pending-objects c: 17 >= 1))
    (not (unit-type-count 17 >= 2))
    (goal action-claim-train-arbitration 0)
    (current-age >= feudal-age)
    (can-train-with-escrow 17)
    (unit-type-count-total 17 < 2)
=>
    (train 17)
    (set-goal action-claim-train-arbitration 1)
    (set-goal demand-water-trade-cog-floor 140)
)