; FRANKS ARABIA BOT
; Current target: Age of Empires II: Definitive Edition update 185872.
; Standalone native .per artifact. This is not loaded alongside another controller.
;
; STRATEGIC CONTRACT
; Dark Age economy -> Feudal Scouts -> Castle Age Knights.
; Counter infantry with Throwing Axemen, use Mounted Crossbowmen after Castle Age,
; and finish with Paladins, Trebuchets, Capped Rams and controlled attack cycles.
;
; FACTUAL BOUNDARY
; Mounted Crossbowman=2700, Heavy Mounted Crossbowman=2701,
; Throwing Axeman=281, Elite Throwing Axeman=531,
; Heavy Mounted Crossbowman upgrade=1451, Capped Ram=96, Cranequins=1452 and
; Ordonnance Companies=1496 are pinned to the current DE technology data. Standard
; technology aliases remain native AI symbols.
;
; BOT POLICIES
; * Explicitly researches the free Frankish Mill technologies at their legal ages.
; * Selects a valid enemy target-player before evaluating counters or attacking.
; * Cavalry Archers and Bearded Axe are obsolete in patch 185872. Neither is used.
; * Dark Age always has a second-building fallback when the preferred forage Mill is unavailable.
; * Castle Age has an explicit University fallback when a Castle is not available.
; * Counter technologies are researched only when the matching unit demand is active.
; * Stone mining is held until Castle Age; remote dropsite overrides are restored.
; * Unit counts include queued production where the native count primitive permits it.

(defconst sn-resource-control 191)
(defconst train-civ-goal 5)
(defconst attack-goal 2)
(defconst frank-initialized-goal 740)
(defconst frank-cavalry-target-goal 741)
(defconst frank-scout-target-goal 742)
(defconst frank-spear-target-goal 743)
(defconst frank-thrower-target-goal 744)
(defconst frank-mounted-crossbow-target-goal 745)
(defconst frank-skirmisher-target-goal 746)
(defconst frank-monk-target-goal 747)
(defconst frank-ram-target-goal 748)
(defconst frank-trebuchet-target-goal 749)
(defconst frank-attack-state-goal 750)
(defconst frank-attack-timer 10)
(defconst frank-attack-cooldown-timer 11)
(defconst frank-age-failure-backoff-goal 751)
(defconst frank-target-player-goal 752)
(defconst frank-economy-recovery-goal 753)
(defconst frank-mounted-crossbowman 2700)
(defconst frank-heavy-mounted-crossbowman 2701)
(defconst frank-throwing-axeman 281)
(defconst frank-elite-throwing-axeman 531)
(defconst ri-ordonnance-companies 1496)
(defconst ri-cranequins 1452)
; Native aliases for strategic-number parameters used by this standalone script.
(defconst sn-intelligent-gathering 142)
(defconst sn-food-gatherer-percentage 117)
(defconst sn-wood-gatherer-percentage 120)
(defconst sn-gold-gatherer-percentage 118)
(defconst sn-stone-gatherer-percentage 119)
(defconst sn-allow-adjacent-dropsites 272)
(defconst sn-dropsite-separation-distance 248)
(defconst sn-target-player-number 249)
; Building object IDs used only in c: parameter positions.
(defconst frank-c-house 70)
(defconst frank-c-lumber-camp 562)
(defconst frank-c-mill 68)
(defconst frank-c-mining-camp 584)
(defconst frank-c-farm 50)
(defconst frank-c-barracks 12)
(defconst frank-c-stable 101)
(defconst frank-c-blacksmith 103)
(defconst frank-c-market 84)
(defconst frank-c-archery-range 87)
(defconst frank-c-siege-workshop 49)
(defconst frank-c-castle 82)
(defconst frank-c-town-center 109)
(defconst frank-c-monastery 104)
(defconst frank-c-university 209)
; Canonical current native technology IDs for c: research-status probes.
(defconst frank-c-feudal-age-tech 101)
(defconst frank-c-loom-tech 22)
(defconst frank-c-horse-collar-tech 14)
(defconst frank-c-heavy-plow-tech 13)
(defconst frank-c-crop-rotation-tech 12)
(defconst frank-c-castle-age-tech 102)
(defconst frank-c-imperial-age-tech 103)
(defconst frank-c-elite-throwing-axeman-tech 363)
(defconst frank-c-heavy-mounted-crossbowman-tech 1451)
(defconst frank-c-pikeman-tech 197)
(defconst frank-c-halberdier-tech 429)
(defconst frank-c-elite-skirmisher-tech 98)
(defconst frank-c-fletching-tech 199)
(defconst frank-c-bodkin-arrow-tech 200)
(defconst frank-c-ballistics-tech 93)
(defconst frank-c-capped-ram-tech 96)
(defconst frank-c-double-bit-axe-tech 202)
(defconst frank-c-wheelbarrow-tech 213)
(defconst frank-c-gold-mining-tech 55)
(defconst frank-c-scale-barding-tech 81)
(defconst frank-c-forging-tech 67)
(defconst frank-c-chain-barding-tech 82)
(defconst frank-c-plate-barding-tech 80)
(defconst frank-c-iron-casting-tech 68)
(defconst frank-c-blast-furnace-tech 75)
(defconst frank-c-husbandry-tech 39)
(defconst frank-c-gold-shaft-mining-tech 182)
(defconst frank-c-bow-saw-tech 203)
(defconst frank-c-hand-cart-tech 249)
(defconst frank-c-cavalier-tech 209)
(defconst frank-c-paladin-tech 265)
(defconst frank-c-conscription-tech 315)
(defconst frank-c-chivalry-tech 493)
(defconst frank-c-siege-engineers-tech 377)
(defconst frank-feudal-villagers 21)
(defconst frank-castle-villagers 31)
(defconst frank-imperial-villagers 55)

; Initialize all Frankish strategic state once.
(defrule
    (goal frank-initialized-goal 0)
=>
    (set-goal frank-initialized-goal 1)
    (set-goal train-civ-goal 1)
    (set-goal frank-cavalry-target-goal 0)
    (set-goal frank-scout-target-goal 0)
    (set-goal frank-spear-target-goal 0)
    (set-goal frank-thrower-target-goal 0)
    (set-goal frank-mounted-crossbow-target-goal 0)
    (set-goal frank-skirmisher-target-goal 0)
    (set-goal frank-monk-target-goal 0)
    (set-goal frank-ram-target-goal 0)
    (set-goal frank-trebuchet-target-goal 0)
    (set-goal frank-attack-state-goal 0)
    (set-goal frank-target-player-goal 0)
    (set-goal frank-economy-recovery-goal 0)
    (set-strategic-number sn-target-player-number 0)
    (set-strategic-number sn-intelligent-gathering 1)
    (set-strategic-number sn-food-gatherer-percentage 55)
    (set-strategic-number sn-wood-gatherer-percentage 45)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

; Acquire a valid enemy player before target-player facts and attack control depend on it.
(defrule
    (or
        (strategic-number sn-target-player-number <= 0)
        (not (player-in-game target-player))
    )
=>
    (up-find-player enemy find-closest frank-target-player-goal)
)
(defrule
    (up-compare-goal frank-target-player-goal >= 1)
    (strategic-number sn-target-player-number != frank-target-player-goal)
=>
    (up-modify-sn sn-target-player-number g:= frank-target-player-goal)
)

; Feudal completion restores Town Center economy and Scout pressure.
(defrule
    (current-age >= feudal-age)
    (goal train-civ-goal 0)
=>
    (set-goal train-civ-goal 1)
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 35)
    (set-strategic-number sn-gold-gatherer-percentage 15)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

; Castle completion switches to cavalry and Castle infrastructure.
(defrule
    (current-age >= castle-age)
    (goal frank-cavalry-target-goal 0)
=>
    (set-goal frank-scout-target-goal 0)
    (set-goal frank-cavalry-target-goal 6)
    (set-goal frank-mounted-crossbow-target-goal 4)
    (set-strategic-number sn-food-gatherer-percentage 42)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 23)
    (set-strategic-number sn-stone-gatherer-percentage 5)
)

; Imperial completion expands endgame production targets.
(defrule
    (current-age >= imperial-age)
    (unit-type-count villager >= frank-imperial-villagers)
    (goal frank-trebuchet-target-goal 0)
=>
    (set-goal frank-cavalry-target-goal 24)
    (set-goal frank-mounted-crossbow-target-goal 10)
    (set-goal frank-thrower-target-goal 8)
    (set-goal frank-trebuchet-target-goal 3)
    (set-goal frank-ram-target-goal 4)
    (set-strategic-number sn-food-gatherer-percentage 35)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 30)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)

; Research Loom late and only when the Feudal click is not currently feasible.
; This avoids spending the opening food bank while an age-up can already start.
(defrule
    (current-age == dark-age)
    (unit-type-count villager >= 18)
    (unit-type-count villager < frank-feudal-villagers)
    (not (can-research-with-escrow feudal-age))
    (food-amount >= 600)
    (up-research-status c: frank-c-loom-tech < research-pending)
    (can-research-with-escrow ri-loom)
=>
    (release-escrow food)
    (research ri-loom)
)

; Frankish Mill technologies are free in the target patch, but still require
; explicit research actions and verified completion state.
(defrule
    (current-age >= feudal-age)
    (building-type-count mill >= 1)
    (up-research-status c: frank-c-horse-collar-tech < research-pending)
    (can-research-with-escrow ri-horse-collar)
=>
    (research ri-horse-collar)
)
(defrule
    (current-age >= castle-age)
    (building-type-count mill >= 1)
    (up-research-status c: frank-c-heavy-plow-tech < research-pending)
    (can-research-with-escrow ri-heavy-plow)
=>
    (research ri-heavy-plow)
)
(defrule
    (current-age >= imperial-age)
    (building-type-count mill >= 1)
    (up-research-status c: frank-c-crop-rotation-tech < research-pending)
    (can-research-with-escrow ri-crop-rotation)
=>
    (research ri-crop-rotation)
)

; Commit Feudal Age at a focused 21-villager opening.
(defrule
    (current-age == dark-age)
    (goal train-civ-goal 1)
    (unit-type-count villager >= frank-feudal-villagers)
    (up-research-status c: frank-c-feudal-age-tech < research-pending)
    (can-research-with-escrow feudal-age)
=>
    (set-goal train-civ-goal 0)
    (release-escrow food)
    (release-escrow gold)
    (research feudal-age)
)

; Commit Castle Age once Scout opening infrastructure is ready.
(defrule
    (current-age == feudal-age)
    (goal train-civ-goal 1)
    (unit-type-count villager >= frank-castle-villagers)
    (building-type-count stable >= 1)
    (building-type-count blacksmith >= 1)
    (up-research-status c: frank-c-castle-age-tech < research-pending)
    (can-research-with-escrow castle-age)
=>
    (set-goal train-civ-goal 0)
    (release-escrow food)
    (release-escrow gold)
    (research castle-age)
)

; Commit Imperial Age with a developed economy and live army.
(defrule
    (current-age == castle-age)
    (goal train-civ-goal 1)
    (unit-type-count villager >= frank-imperial-villagers)
    (military-population >= 18)
    (up-research-status c: frank-c-imperial-age-tech < research-pending)
    (can-research-with-escrow imperial-age)
=>
    (set-goal train-civ-goal 0)
    (release-escrow food)
    (release-escrow gold)
    (research imperial-age)
)

; Keep Town Centers producing villagers until the sustainable target.
(defrule
    (goal train-civ-goal 1)
    (unit-type-count-total villager < 90)
    (population-headroom > 0)
    (can-train villager)
=>
    (train villager)
)

; Build houses before population pressure blocks villager and army production.
(defrule
    (population-headroom < 8)
    (building-type-count-total house < 36)
    (up-pending-objects c: frank-c-house == 0)
    (can-build house)
=>
    (build house)
)

; Build the first lumber camp when wood is being gathered.
(defrule
    (unit-type-count villager >= 6)
    (resource-found wood)
    (building-type-count-total lumber-camp < 1)
    (up-pending-objects c: frank-c-lumber-camp == 0)
    (can-build lumber-camp)
=>
    (build lumber-camp)
    (set-strategic-number sn-allow-adjacent-dropsites 0)
    (set-strategic-number sn-dropsite-separation-distance 10)
)

; Refresh remote wood dropsites during sustained wood gathering.
(defrule
    (current-age >= feudal-age)
    (strategic-number sn-wood-gatherer-percentage > 0)
    (resource-found wood)
    (dropsite-min-distance wood > 10)
    (unit-type-count villager >= 25)
    (building-type-count-total lumber-camp < 4)
    (up-pending-objects c: frank-c-lumber-camp == 0)
    (can-build lumber-camp)
=>
    (set-strategic-number sn-allow-adjacent-dropsites 1)
    (set-strategic-number sn-dropsite-separation-distance 5)
    (build lumber-camp)
    (set-strategic-number sn-allow-adjacent-dropsites 0)
    (set-strategic-number sn-dropsite-separation-distance 10)
)

; Build a mill on a real forage resource before spending on farms.
(defrule
    (resource-found forage)
    (building-type-count-total mill < 1)
    (up-pending-objects c: frank-c-mill == 0)
    (can-build mill)
=>
    (build mill)
    (set-strategic-number sn-allow-adjacent-dropsites 0)
    (set-strategic-number sn-dropsite-separation-distance 10)
)

; Refresh a remote forage dropsite when current Mill coverage is insufficient.
(defrule
    (current-age >= feudal-age)
    (resource-found forage)
    (dropsite-min-distance forage > 10)
    (unit-type-count villager >= 24)
    (building-type-count mill >= 1)
    (building-type-count-total mill < 3)
    (up-pending-objects c: frank-c-mill == 0)
    (can-build mill)
=>
    (set-strategic-number sn-allow-adjacent-dropsites 1)
    (set-strategic-number sn-dropsite-separation-distance 5)
    (build mill)
    (set-strategic-number sn-allow-adjacent-dropsites 0)
    (set-strategic-number sn-dropsite-separation-distance 10)
)

; If forage is absent, a resource-adjacent Mining Camp is the Dark Age second-building fallback.
; This keeps the Feudal transition from depending on one resource-class placement succeeding.
(defrule
    (current-age == dark-age)
    (unit-type-count villager >= 8)
    (not (resource-found forage))
    (resource-found gold)
    (building-type-count-total mill < 1)
    (building-type-count-total mining-camp < 1)
    (up-pending-objects c: frank-c-mill == 0)
    (up-pending-objects c: frank-c-mining-camp == 0)
    (can-build mining-camp)
=>
    (build mining-camp)
)

; Build a gold camp only when Gold is an active resource priority.
(defrule
    (current-age >= feudal-age)
    (strategic-number sn-gold-gatherer-percentage > 0)
    (resource-found gold)
    (dropsite-min-distance gold > 8)
    (unit-type-count villager >= 24)
    (building-type-count-total mining-camp < 5)
    (up-pending-objects c: frank-c-mining-camp == 0)
    (can-build mining-camp)
=>
    (set-strategic-number sn-allow-adjacent-dropsites 1)
    (build mining-camp)
    (set-strategic-number sn-allow-adjacent-dropsites 0)
    (set-strategic-number sn-dropsite-separation-distance 10)
)

; Build a stone camp only after Castle Age or when the first Castle is planned.
(defrule
    (current-age >= castle-age)
    (strategic-number sn-stone-gatherer-percentage > 0)
    (resource-found stone)
    (dropsite-min-distance stone > 8)
    (unit-type-count villager >= 30)
    (building-type-count-total mining-camp < 5)
    (up-pending-objects c: frank-c-mining-camp == 0)
    (can-build mining-camp)
=>
    (set-strategic-number sn-allow-adjacent-dropsites 1)
    (build mining-camp)
    (set-strategic-number sn-allow-adjacent-dropsites 0)
    (set-strategic-number sn-dropsite-separation-distance 10)
)

; Expand renewable farm capacity at 16 villagers.
(defrule
    (current-age >= feudal-age)
    (unit-type-count villager >= 16)
    (building-type-count mill >= 1)
    (building-type-count-total farm < 5)
    (food-amount < 900)
    (wood-amount >= 60)
    (up-pending-objects c: frank-c-farm == 0)
    (can-build farm)
=>
    (build farm)
)

; Expand renewable farm capacity at 28 villagers.
(defrule
    (current-age >= feudal-age)
    (unit-type-count villager >= 28)
    (building-type-count mill >= 1)
    (building-type-count-total farm < 12)
    (food-amount < 900)
    (wood-amount >= 60)
    (up-pending-objects c: frank-c-farm == 0)
    (can-build farm)
=>
    (build farm)
)

; Expand renewable farm capacity at 42 villagers.
(defrule
    (current-age >= feudal-age)
    (unit-type-count villager >= 42)
    (building-type-count mill >= 1)
    (building-type-count-total farm < 22)
    (food-amount < 900)
    (wood-amount >= 60)
    (up-pending-objects c: frank-c-farm == 0)
    (can-build farm)
=>
    (build farm)
)

; Expand renewable farm capacity at 58 villagers.
(defrule
    (current-age >= feudal-age)
    (unit-type-count villager >= 58)
    (building-type-count mill >= 1)
    (building-type-count-total farm < 32)
    (food-amount < 900)
    (wood-amount >= 60)
    (up-pending-objects c: frank-c-farm == 0)
    (can-build farm)
=>
    (build farm)
)

; Expand renewable farm capacity at 72 villagers.
(defrule
    (current-age >= feudal-age)
    (unit-type-count villager >= 72)
    (building-type-count mill >= 1)
    (building-type-count-total farm < 42)
    (food-amount < 900)
    (wood-amount >= 60)
    (up-pending-objects c: frank-c-farm == 0)
    (can-build farm)
=>
    (build farm)
)

; Establish a Barracks for Spearmen and the second-building age-up path.
(defrule
    (current-age >= feudal-age)
    (building-type-count-total barracks < 1)
    (up-pending-objects c: frank-c-barracks == 0)
    (can-build barracks)
=>
    (build barracks)
)

; Open the Stable as the Feudal military production anchor.
(defrule
    (current-age >= feudal-age)
    (building-type-count-total stable < 1)
    (up-pending-objects c: frank-c-stable == 0)
    (can-build stable)
=>
    (build stable)
)

; Build a Blacksmith for Castle prerequisites and cavalry upgrades.
(defrule
    (current-age >= feudal-age)
    (building-type-count-total blacksmith < 1)
    (up-pending-objects c: frank-c-blacksmith == 0)
    (can-build blacksmith)
=>
    (build blacksmith)
)

; Build a Market for the alternate Castle prerequisite and late-game recovery.
(defrule
    (current-age >= feudal-age)
    (building-type-count blacksmith >= 1)
    (building-type-count-total market < 1)
    (up-pending-objects c: frank-c-market == 0)
    (can-build market)
=>
    (build market)
)

; Add Stable capacity once Castle Age Knight production is funded.
(defrule
    (current-age >= castle-age)
    (unit-type-count villager >= 40)
    (building-type-count-total stable < 2)
    (up-pending-objects c: frank-c-stable == 0)
    (can-build stable)
=>
    (build stable)
)

; Add a third Stable for the Imperial replacement loop.
(defrule
    (current-age >= castle-age)
    (unit-type-count villager >= 55)
    (building-type-count-total stable < 3)
    (up-pending-objects c: frank-c-stable == 0)
    (can-build stable)
=>
    (build stable)
)

; Expand to a fourth Stable when the economy can replace heavy cavalry losses.
(defrule
    (current-age >= imperial-age)
    (unit-type-count villager >= 70)
    (building-type-count-total stable < 4)
    (up-pending-objects c: frank-c-stable == 0)
    (can-build stable)
=>
    (build stable)
)

; Build the Archery Range for Mounted Crossbowmen and ranged counters.
(defrule
    (current-age >= castle-age)
    (building-type-count-total archery-range < 1)
    (up-pending-objects c: frank-c-archery-range == 0)
    (can-build archery-range)
=>
    (build archery-range)
)

; Add a second Archery Range when the mounted-ranged package is active.
(defrule
    (current-age >= castle-age)
    (unit-type-count villager >= 50)
    (building-type-count-total archery-range < 2)
    (up-pending-objects c: frank-c-archery-range == 0)
    (can-build archery-range)
=>
    (build archery-range)
)

; Build a Siege Workshop before the first sustained Castle Age push.
(defrule
    (current-age >= castle-age)
    (military-population >= 8)
    (building-type-count-total siege-workshop < 1)
    (up-pending-objects c: frank-c-siege-workshop == 0)
    (can-build siege-workshop)
=>
    (build siege-workshop)
)

; If a Castle is not presently buildable, secure the University + Siege Workshop path to Imperial Age.
; The negative capability guard preserves the Castle as the preferred first investment when feasible.
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (not (can-build castle))
    (building-type-count siege-workshop >= 1)
    (building-type-count-total university < 1)
    (up-pending-objects c: frank-c-university == 0)
    (can-build university)
=>
    (build university)
)

; Add a second Siege Workshop for Imperial replacement throughput.
(defrule
    (current-age >= imperial-age)
    (unit-type-count villager >= 65)
    (building-type-count-total siege-workshop < 2)
    (up-pending-objects c: frank-c-siege-workshop == 0)
    (can-build siege-workshop)
=>
    (build siege-workshop)
)

; Build one Castle for Throwing Axemen and Ordonnance Companies.
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (stone-amount >= 500)
    (up-pending-objects c: frank-c-castle == 0)
    (can-build castle)
=>
    (build castle)
)

; Use Frankish cheaper Castles to secure a second production and forward anchor.
(defrule
    (current-age >= imperial-age)
    (building-type-count castle >= 1)
    (building-type-count-total castle < 3)
    (stone-amount >= 400)
    (unit-type-count villager >= 65)
    (up-pending-objects c: frank-c-castle == 0)
    (can-build castle)
=>
    (build castle)
)

; Build a second Town Center when Castle Age economy can sustain expansion.
(defrule
    (current-age >= castle-age)
    (building-type-count castle >= 1)
    (unit-type-count villager >= 42)
    (building-type-count-total town-center < 2)
    (wood-amount >= 300)
    (stone-amount >= 100)
    (up-pending-objects c: frank-c-town-center == 0)
    (can-build town-center)
=>
    (build town-center)
)

; Build a third Town Center only after military and villager production are stable.
(defrule
    (current-age >= castle-age)
    (building-type-count castle >= 1)
    (unit-type-count villager >= 58)
    (military-population >= 10)
    (building-type-count-total town-center < 3)
    (wood-amount >= 350)
    (stone-amount >= 100)
    (up-pending-objects c: frank-c-town-center == 0)
    (can-build town-center)
=>
    (build town-center)
)

; Scout target remains four units during the Feudal pressure window.
(defrule
    (current-age == feudal-age)
    (goal frank-scout-target-goal 0)
=>
    (set-goal frank-scout-target-goal 4)
)

; Retire Scout expansion when Castle Age is reached.
(defrule
    (current-age >= castle-age)
    (up-compare-goal frank-scout-target-goal >= 1)
=>
    (set-goal frank-scout-target-goal 0)
)

; Set Castle Age Knight target to six during initial transition.
(defrule
    (current-age == castle-age)
    (unit-type-count villager < 45)
    (up-compare-goal frank-cavalry-target-goal != 6)
=>
    (set-goal frank-cavalry-target-goal 6)
)

; Scale the Castle Age Knight target to twelve with forty-five villagers.
(defrule
    (current-age == castle-age)
    (unit-type-count villager >= 45)
    (unit-type-count villager < 60)
    (up-compare-goal frank-cavalry-target-goal != 12)
=>
    (set-goal frank-cavalry-target-goal 12)
)

; Scale the Castle Age Knight target to eighteen with sixty villagers.
(defrule
    (current-age == castle-age)
    (unit-type-count villager >= 60)
    (up-compare-goal frank-cavalry-target-goal != 18)
=>
    (set-goal frank-cavalry-target-goal 18)
)

; Scale Imperial cavalry target to twenty-four.
(defrule
    (current-age >= imperial-age)
    (up-compare-goal frank-cavalry-target-goal != 24)
=>
    (set-goal frank-cavalry-target-goal 24)
)

; Train Scouts only while Castle Age is not ready to start.
(defrule
    (current-age == feudal-age)
    (up-compare-goal frank-scout-target-goal >= 1)
    (building-type-count stable >= 1)
    (unit-type-count-total scout-cavalry < frank-scout-target-goal)
    (not (can-research-with-escrow castle-age))
    (can-train scout-cavalry)
=>
    (train scout-cavalry)
)

; Produce Knights as the primary Castle Age army.
(defrule
    (current-age >= castle-age)
    (building-type-count stable >= 1)
    (up-compare-goal frank-cavalry-target-goal >= 1)
    (unit-type-count-total knight-line < frank-cavalry-target-goal)
    (can-train-with-escrow knight-line)
=>
    (release-escrow food)
    (release-escrow gold)
    (train knight-line)
)

; Clear anti-cavalry target when mounted enemy pressure is absent.
(defrule
    (current-age >= feudal-age)
    (players-unit-type-count any-enemy knight-line < 3)
    (players-unit-type-count any-enemy camel-rider-line < 3)
    (players-unit-type-count any-enemy scout-cavalry-line < 5)
    (up-compare-goal frank-spear-target-goal != 0)
=>
    (set-goal frank-spear-target-goal 0)
)

; Set an eight-Spearman counter against a committed enemy cavalry force.
(defrule
    (current-age >= feudal-age)
    (or (players-unit-type-count any-enemy knight-line >= 3) (players-unit-type-count any-enemy camel-rider-line >= 3))
    (up-compare-goal frank-spear-target-goal != 8)
=>
    (set-goal frank-spear-target-goal 8)
)

; Scale Spearmen against very heavy mounted-unit pressure.
(defrule
    (current-age >= castle-age)
    (or (players-unit-type-count any-enemy knight-line >= 8) (players-unit-type-count any-enemy camel-rider-line >= 8))
    (up-compare-goal frank-spear-target-goal != 14)
=>
    (set-goal frank-spear-target-goal 14)
)

; Research Pikeman when the anti-cavalry demand has become a real Castle Age package.
(defrule
    (current-age >= castle-age)
    (up-compare-goal frank-spear-target-goal >= 8)
    (unit-type-count-total spearman-line >= 4)
    (goal train-civ-goal 1)
    (not (can-research-with-escrow imperial-age))
    (up-research-status c: frank-c-pikeman-tech < research-pending)
    (can-research-with-escrow ri-pikeman)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-pikeman)
)

; Train the current Spearman-line counter upgrade against enemy cavalry.
(defrule
    (current-age >= feudal-age)
    (up-compare-goal frank-spear-target-goal >= 1)
    (unit-type-count-total spearman-line < frank-spear-target-goal)
    (can-train-with-escrow spearman-line)
=>
    (release-escrow food)
    (release-escrow wood)
    (train spearman-line)
)

; Upgrade the anti-cavalry line again in Imperial Age when the counter remains needed.
(defrule
    (current-age >= imperial-age)
    (up-compare-goal frank-spear-target-goal >= 8)
    (unit-type-count-total spearman-line >= 8)
    (up-research-status c: frank-c-halberdier-tech < research-pending)
    (can-research-with-escrow ri-halberdier)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-halberdier)
)

; Clear Throwing Axeman demand when no enemy infantry wall is observed.
(defrule
    (current-age >= castle-age)
    (players-unit-type-count any-enemy spearman-line < 4)
    (players-unit-type-count any-enemy militiaman-line < 6)
    (up-compare-goal frank-thrower-target-goal != 0)
=>
    (set-goal frank-thrower-target-goal 0)
)

; Deploy Throwing Axemen against infantry and Spearman-line bodies.
(defrule
    (current-age >= castle-age)
    (building-type-count castle >= 1)
    (or (players-unit-type-count any-enemy spearman-line >= 4) (players-unit-type-count any-enemy militiaman-line >= 6))
    (up-compare-goal frank-thrower-target-goal != 8)
=>
    (set-goal frank-thrower-target-goal 8)
)

; Scale Throwing Axemen against mass infantry.
(defrule
    (current-age >= castle-age)
    (building-type-count castle >= 1)
    (or (players-unit-type-count any-enemy spearman-line >= 9) (players-unit-type-count any-enemy militiaman-line >= 12))
    (up-compare-goal frank-thrower-target-goal != 14)
=>
    (set-goal frank-thrower-target-goal 14)
)

; Research Elite Throwing Axeman before adding more base units when Imperial pressure warrants it.
; This rule precedes base-unit production so the upgrade and training demand cannot race each other.
(defrule
    (current-age >= imperial-age)
    (building-type-count castle >= 1)
    (unit-type-count frank-throwing-axeman >= 6)
    (up-research-status c: frank-c-elite-throwing-axeman-tech < research-pending)
    (can-research-with-escrow ri-elite-throwing-axeman)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-elite-throwing-axeman)
)

; Base Throwing Axemen may enter in Imperial Age if the counter demand starts late.
; Stop adding base units once the Elite upgrade has been queued.
(defrule
    (current-age >= castle-age)
    (building-type-count castle >= 1)
    (or
        (current-age == castle-age)
        (up-research-status c: frank-c-elite-throwing-axeman-tech < research-pending)
    )
    (unit-type-count-total frank-throwing-axeman < frank-thrower-target-goal)
    (can-train-with-escrow frank-throwing-axeman)
=>
    (release-escrow food)
    (release-escrow gold)
    (train frank-throwing-axeman)
)

; Train Elite Throwing Axemen after the verified upgrade completes.
(defrule
    (current-age >= imperial-age)
    (building-type-count castle >= 1)
    (up-research-status c: frank-c-elite-throwing-axeman-tech == research-complete)
    (unit-type-count-total frank-elite-throwing-axeman < frank-thrower-target-goal)
    (can-train-with-escrow frank-elite-throwing-axeman)
=>
    (release-escrow food)
    (release-escrow gold)
    (train frank-elite-throwing-axeman)
)

; Add Mounted Crossbowmen to support Knights against spear-heavy armies.
(defrule
    (current-age >= castle-age)
    (building-type-count archery-range >= 1)
    (or (players-unit-type-count any-enemy spearman-line >= 4) (players-unit-type-count any-enemy militiaman-line >= 8))
    (up-compare-goal frank-mounted-crossbow-target-goal != 6)
=>
    (set-goal frank-mounted-crossbow-target-goal 6)
)

; Scale Mounted Crossbowmen after Ordonnance Companies reduces gold pressure.
(defrule
    (current-age >= castle-age)
    (up-research-status c: ri-ordonnance-companies == research-complete)
    (up-compare-goal frank-mounted-crossbow-target-goal != 8)
=>
    (set-goal frank-mounted-crossbow-target-goal 8)
)

; Train Mounted Crossbowmen by the verified update-185872 unit ID.
(defrule
    (current-age >= castle-age)
    (building-type-count archery-range >= 1)
    (up-research-status c: frank-c-heavy-mounted-crossbowman-tech < research-pending)
    (unit-type-count-total frank-mounted-crossbowman < frank-mounted-crossbow-target-goal)
    (can-train-with-escrow frank-mounted-crossbowman)
=>
    (release-escrow wood)
    (release-escrow gold)
    (train frank-mounted-crossbowman)
)

; Upgrade the Mounted Crossbowman line explicitly in Imperial Age after a real package is fielded.
; Tech 1451 is the DE 185872 Heavy Mounted Crossbowman upgrade.
(defrule
    (current-age >= imperial-age)
    (building-type-count archery-range >= 1)
    (unit-type-count frank-mounted-crossbowman >= 6)
    (up-research-status c: frank-c-heavy-mounted-crossbowman-tech < research-pending)
    (can-research-with-escrow 1451)
=>
    (release-escrow food)
    (release-escrow gold)
    (research 1451)
)

; Train the Heavy line only after its technology is confirmed complete.
(defrule
    (current-age >= imperial-age)
    (building-type-count archery-range >= 1)
    (up-research-status c: frank-c-heavy-mounted-crossbowman-tech == research-complete)
    (unit-type-count-total frank-heavy-mounted-crossbowman < frank-mounted-crossbow-target-goal)
    (can-train-with-escrow frank-heavy-mounted-crossbowman)
=>
    (release-escrow wood)
    (release-escrow gold)
    (train frank-heavy-mounted-crossbowman)
)

; Research Ordonnance Companies once Mounted Crossbowmen are a real package.
(defrule
    (current-age >= castle-age)
    (building-type-count castle >= 1)
    (unit-type-count-total frank-mounted-crossbowman >= 4)
    (up-research-status c: ri-ordonnance-companies < research-pending)
    (can-research-with-escrow ri-ordonnance-companies)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-ordonnance-companies)
)

; Research Cranequins when the current-patch Mounted Crossbowman package is active.
(defrule
    (current-age >= imperial-age)
    (building-type-count archery-range >= 1)
    (up-research-status c: frank-c-heavy-mounted-crossbowman-tech == research-complete)
    (up-research-status c: ri-cranequins < research-pending)
    (can-research-with-escrow ri-cranequins)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-cranequins)
)

; Ranged attack upgrades are secondary: preserve the Imperial bank before spending.
(defrule
    (current-age >= castle-age)
    (goal train-civ-goal 1)
    (not (can-research-with-escrow imperial-age))
    (or
        (unit-type-count-total frank-mounted-crossbowman >= 4)
        (unit-type-count-total frank-heavy-mounted-crossbowman >= 4)
    )
    (food-amount >= 1100)
    (gold-amount >= 850)
    (up-research-status c: frank-c-fletching-tech < research-pending)
    (can-research-with-escrow ri-fletching)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-fletching)
)

(defrule
    (current-age >= castle-age)
    (goal train-civ-goal 1)
    (not (can-research-with-escrow imperial-age))
    (or
        (unit-type-count-total frank-mounted-crossbowman >= 4)
        (unit-type-count-total frank-heavy-mounted-crossbowman >= 4)
    )
    (food-amount >= 1200)
    (gold-amount >= 900)
    (up-research-status c: frank-c-bodkin-arrow-tech < research-pending)
    (can-research-with-escrow ri-bodkin-arrow)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-bodkin-arrow)
)

; Ballistics requires a University and an active mounted-ranged package.
(defrule
    (current-age >= castle-age)
    (building-type-count university >= 1)
    (goal train-civ-goal 1)
    (not (can-research-with-escrow imperial-age))
    (or
        (unit-type-count-total frank-mounted-crossbowman >= 4)
        (unit-type-count-total frank-heavy-mounted-crossbowman >= 4)
    )
    (food-amount >= 1300)
    (gold-amount >= 975)
    (up-research-status c: frank-c-ballistics-tech < research-pending)
    (can-research-with-escrow ri-ballistics)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-ballistics)
)

; Set a limited skirmisher target against a large enemy foot-archer mass.
(defrule
    (current-age >= feudal-age)
    (players-unit-type-count any-enemy archer-line >= 8)
    (up-compare-goal frank-skirmisher-target-goal != 8)
=>
    (set-goal frank-skirmisher-target-goal 8)
)

; Remove skirmisher demand when the enemy ranged threat recedes.
(defrule
    (current-age >= feudal-age)
    (players-unit-type-count any-enemy archer-line < 5)
    (up-compare-goal frank-skirmisher-target-goal != 0)
=>
    (set-goal frank-skirmisher-target-goal 0)
)

; Research Elite Skirmisher when the ranged counter is materially committed.
(defrule
    (current-age >= castle-age)
    (up-compare-goal frank-skirmisher-target-goal >= 8)
    (unit-type-count-total skirmisher-line >= 4)
    (goal train-civ-goal 1)
    (not (can-research-with-escrow imperial-age))
    (up-research-status c: frank-c-elite-skirmisher-tech < research-pending)
    (can-research-with-escrow ri-elite-skirmisher)
=>
    (release-escrow wood)
    (release-escrow gold)
    (research ri-elite-skirmisher)
)

; Train Skirmishers as a bounded defensive counter.
(defrule
    (current-age >= feudal-age)
    (building-type-count archery-range >= 1)
    (unit-type-count-total skirmisher-line < frank-skirmisher-target-goal)
    (can-train-with-escrow skirmisher-line)
=>
    (release-escrow food)
    (release-escrow wood)
    (train skirmisher-line)
)

; Activate a small Monk package against elephant-heavy enemy armies.
(defrule
    (current-age >= castle-age)
    (players-unit-type-count any-enemy elephant-line >= 3)
    (up-compare-goal frank-monk-target-goal != 3)
=>
    (set-goal frank-monk-target-goal 3)
)

; Build a Monastery only when the Monk package is active.
(defrule
    (current-age >= castle-age)
    (up-compare-goal frank-monk-target-goal >= 1)
    (building-type-count-total monastery < 1)
    (up-pending-objects c: frank-c-monastery == 0)
    (can-build monastery)
=>
    (build monastery)
)

; Train Monks for conversion and emergency healing support.
(defrule
    (current-age >= castle-age)
    (building-type-count monastery >= 1)
    (unit-type-count-total monk < frank-monk-target-goal)
    (can-train-with-escrow monk)
=>
    (release-escrow gold)
    (train monk)
)

; Set Siege Ram demand once Castle Age pressure is established.
(defrule
    (current-age >= castle-age)
    (players-building-count any-enemy > 0)
    (military-population >= 14)
    (up-compare-goal frank-ram-target-goal != 2)
=>
    (set-goal frank-ram-target-goal 2)
)

; Train Siege Rams after the Workshop is complete.
(defrule
    (current-age >= castle-age)
    (building-type-count siege-workshop >= 1)
    (unit-type-count-total battering-ram-line < frank-ram-target-goal)
    (can-train-with-escrow battering-ram-line)
=>
    (release-escrow wood)
    (release-escrow gold)
    (train battering-ram-line)
)

; Train Trebuchets in Imperial for fortified building closure.
(defrule
    (current-age >= imperial-age)
    (building-type-count castle >= 1)
    (unit-type-count-total trebuchet < frank-trebuchet-target-goal)
    (can-train-with-escrow trebuchet)
=>
    (release-escrow wood)
    (release-escrow gold)
    (train trebuchet)
)

; Upgrade to Capped Ram in Imperial Age; the Siege Ram endpoint is unavailable to Franks.
(defrule
    (current-age >= imperial-age)
    (unit-type-count battering-ram-line >= 2)
    (up-research-status c: frank-c-capped-ram-tech < research-pending)
    (can-research-with-escrow ri-capped-ram)
=>
    (release-escrow food)
    (research ri-capped-ram)
)

; Research: Double Bit Axe after Feudal, before Castle Age is affordable.
(defrule
    (current-age >= feudal-age)
    (not (can-research-with-escrow castle-age))
    (up-research-status c: frank-c-double-bit-axe-tech < research-pending)
    (can-research-with-escrow ri-double-bit-axe)
=>
    (release-escrow food)
    (release-escrow wood)
    (research ri-double-bit-axe)
)

; Research: Wheelbarrow when villager count makes it worthwhile and Castle Age is not ready.
(defrule
    (current-age >= feudal-age)
    (unit-type-count villager >= 28)
    (not (can-research-with-escrow castle-age))
    (up-research-status c: frank-c-wheelbarrow-tech < research-pending)
    (can-research-with-escrow ri-wheel-barrow)
=>
    (release-escrow food)
    (research ri-wheel-barrow)
)

; Research: Gold Mining when the Gold economy is live.
(defrule
    (current-age >= feudal-age)
    (strategic-number sn-gold-gatherer-percentage > 0)
    (not (can-research-with-escrow castle-age))
    (up-research-status c: frank-c-gold-mining-tech < research-pending)
    (can-research-with-escrow ri-gold-mining)
=>
    (release-escrow food)
    (research ri-gold-mining)
)

; Research: Scale Barding Armor for the mounted core.
(defrule
    (current-age >= feudal-age)
    (unit-type-count-total scout-cavalry >= 3)
    (not (can-research-with-escrow castle-age))
    (up-research-status c: frank-c-scale-barding-tech < research-pending)
    (can-research-with-escrow ri-scale-barding)
=>
    (release-escrow food)
    (research ri-scale-barding)
)

; Research: Forging after cavalry pressure is already fielded.
(defrule
    (current-age >= feudal-age)
    (unit-type-count-total scout-cavalry >= 3)
    (not (can-research-with-escrow castle-age))
    (up-research-status c: frank-c-forging-tech < research-pending)
    (can-research-with-escrow ri-forging)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-forging)
)

; Research: Chain Barding Armor in Castle Age.
(defrule
    (current-age >= castle-age)
    (unit-type-count-total knight-line >= 4)
    (up-research-status c: frank-c-chain-barding-tech < research-pending)
    (can-research-with-escrow ri-chain-barding)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-chain-barding)
)

; Research: Plate Barding Armor for the Imperial cavalry core.
(defrule
    (current-age >= imperial-age)
    (unit-type-count-total knight-line >= 8)
    (up-research-status c: frank-c-plate-barding-tech < research-pending)
    (can-research-with-escrow ri-plate-barding)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-plate-barding)
)

; Research: Iron Casting for Castle Age cavalry.
(defrule
    (current-age >= castle-age)
    (unit-type-count-total knight-line >= 6)
    (up-research-status c: frank-c-iron-casting-tech < research-pending)
    (can-research-with-escrow ri-iron-casting)
=>
