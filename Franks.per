    (release-escrow gold)
    (research ri-iron-casting)
)

; Research: Blast Furnace once Imperial cavalry is committed.
(defrule
    (current-age >= imperial-age)
    (unit-type-count-total knight-line >= 10)
    (up-research-status c: frank-c-blast-furnace-tech < research-pending)
    (can-research-with-escrow ri-blast-furnace)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-blast-furnace)
)

; Research: Husbandry after the Knight core exists.
(defrule
    (current-age >= castle-age)
    (unit-type-count-total knight-line >= 4)
    (up-research-status c: frank-c-husbandry-tech < research-pending)
    (can-research-with-escrow ri-husbandry)
=>
    (release-escrow food)
    (research ri-husbandry)
)

; Research: Gold Shaft Mining after the Castle transition.
(defrule
    (current-age >= castle-age)
    (strategic-number sn-gold-gatherer-percentage > 0)
    (not (can-research-with-escrow imperial-age))
    (up-research-status c: frank-c-gold-shaft-mining-tech < research-pending)
    (can-research-with-escrow ri-gold-shaft-mining)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-gold-shaft-mining)
)

; Research: Bow Saw when wood income supports military buildings.
(defrule
    (current-age >= castle-age)
    (unit-type-count villager >= 40)
    (not (can-research-with-escrow imperial-age))
    (up-research-status c: frank-c-bow-saw-tech < research-pending)
    (can-research-with-escrow ri-bow-saw)
=>
    (release-escrow food)
    (release-escrow wood)
    (research ri-bow-saw)
)

; Research: Hand Cart after sustainable multi-TC economy.
(defrule
    (current-age >= castle-age)
    (unit-type-count villager >= 52)
