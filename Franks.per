)

; Research: Conscription for sustained Imperial production.
(defrule
    (current-age >= imperial-age)
    (unit-type-count-total knight-line >= 10)
    (up-research-status c: frank-c-conscription-tech < research-pending)
    (can-research-with-escrow ri-conscription)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-conscription)
)

; Research: Chivalry to accelerate Stable throughput.
(defrule
    (current-age >= imperial-age)
    (building-type-count castle >= 1)
    (building-type-count stable >= 2)
    (up-research-status c: frank-c-chivalry-tech < research-pending)
    (can-research-with-escrow ri-chivalry)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-chivalry)
)

; Research: Siege Engineers for the Imperial building push.
(defrule
    (current-age >= imperial-age)
    (building-type-count siege-workshop >= 1)
    (unit-type-count-total battering-ram-line >= 2)
    (up-research-status c: frank-c-siege-engineers-tech < research-pending)
    (can-research-with-escrow ri-siege-engineers)
=>
    (release-escrow food)
    (release-escrow wood)
    (research ri-siege-engineers)
)

; Issue a coherent attack only when a viable force exists and the town is not under attack.
(defrule
    (goal frank-attack-state-goal 0)
    (goal attack-goal 0)
    (current-age >= feudal-age)
    (player-in-game target-player)
    (players-building-count target-player > 0)
    (military-population >= 12)
    (not (town-under-attack))
=>
    (set-goal attack-goal 1)
    (set-goal frank-attack-state-goal 1)
    (attack-now)
    (enable-timer frank-attack-timer 180)
)

; Complete the timed attack cycle and start a short reassessment cooldown.
(defrule
    (goal frank-attack-state-goal 1)
    (timer-triggered frank-attack-timer)
=>
    (disable-timer frank-attack-timer)
    (up-reset-attack-now)
    (set-goal attack-goal 0)
    (set-goal frank-attack-state-goal 2)
    (enable-timer frank-attack-cooldown-timer 45)
)

; Reassess attack readiness after cooldown.
(defrule
    (goal frank-attack-state-goal 2)
    (timer-triggered frank-attack-cooldown-timer)
=>
    (disable-timer frank-attack-cooldown-timer)
    (set-goal frank-attack-state-goal 0)
)

; Recovery clears are evaluated before the normal allocation policy, allowing
; one recovery owner at a time and deterministic return to the age baseline.
(defrule
    (goal frank-economy-recovery-goal 1)
    (food-amount >= 400)
=>
    (set-goal frank-economy-recovery-goal 0)
)
(defrule
    (goal frank-economy-recovery-goal 2)
    (gold-amount >= 400)
=>
    (set-goal frank-economy-recovery-goal 0)
)
(defrule
    (goal frank-economy-recovery-goal 3)
    (wood-amount >= 300)
=>
    (set-goal frank-economy-recovery-goal 0)
)

; Restore one age baseline whenever no recovery mode owns the gatherer allocation.
(defrule
    (current-age == dark-age)
    (goal frank-economy-recovery-goal 0)
    (strategic-number sn-food-gatherer-percentage != 55)
=>
    (set-strategic-number sn-food-gatherer-percentage 55)
    (set-strategic-number sn-wood-gatherer-percentage 45)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
    (current-age == feudal-age)
    (goal frank-economy-recovery-goal 0)
    (strategic-number sn-food-gatherer-percentage != 50)
=>
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 35)
    (set-strategic-number sn-gold-gatherer-percentage 15)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
    (current-age == castle-age)
    (goal frank-economy-recovery-goal 0)
    (strategic-number sn-food-gatherer-percentage != 42)
=>
    (set-strategic-number sn-food-gatherer-percentage 42)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 23)
    (set-strategic-number sn-stone-gatherer-percentage 5)
)
(defrule
    (current-age >= imperial-age)
    (goal frank-economy-recovery-goal 0)
    (strategic-number sn-food-gatherer-percentage != 35)
=>
    (set-strategic-number sn-food-gatherer-percentage 35)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 30)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)

; Recovery modes have strict priority: food first, then gold, then wood.
(defrule
    (current-age >= feudal-age)
    (food-amount < 250)
    (up-compare-goal frank-economy-recovery-goal != 1)
=>
    (set-goal frank-economy-recovery-goal 1)
)
(defrule
    (current-age >= castle-age)
    (goal frank-economy-recovery-goal 0)
    (food-amount >= 300)
    (gold-amount < 250)
=>
    (set-goal frank-economy-recovery-goal 2)
)
(defrule
    (current-age >= feudal-age)
    (goal frank-economy-recovery-goal 0)
    (food-amount >= 300)
    (gold-amount >= 250)
    (wood-amount < 150)
=>
    (set-goal frank-economy-recovery-goal 3)
)

; Enforce only the selected recovery allocation; no peer controller can overwrite it.
(defrule
    (goal frank-economy-recovery-goal 1)
    (strategic-number sn-food-gatherer-percentage != 60)
=>
    (set-strategic-number sn-food-gatherer-percentage 60)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 15)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
    (goal frank-economy-recovery-goal 2)
    (strategic-number sn-food-gatherer-percentage != 40)
=>
    (set-strategic-number sn-food-gatherer-percentage 40)
    (set-strategic-number sn-wood-gatherer-percentage 20)
    (set-strategic-number sn-gold-gatherer-percentage 35)
    (set-strategic-number sn-stone-gatherer-percentage 5)
)
(defrule
    (goal frank-economy-recovery-goal 3)
    (strategic-number sn-food-gatherer-percentage != 45)
=>
    (set-strategic-number sn-food-gatherer-percentage 45)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-gold-gatherer-percentage 15)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

; END FRANKS ARABIA BOT
