(defconst byz-feudal-pop 21)
(defconst byz-castle-pop 27)
(defconst byz-imperial-vils 55)
(defconst byz-house-limit 80)
(defconst byz-skirm-feudal 6)
(defconst byz-spear-feudal 4)
(defconst byz-camel-castle 8)
(defconst byz-knight-castle 8)
(defconst byz-skirm-castle 10)
(defconst byz-imp-skirm 18)
(defconst byz-imp-halbs 18)

(defrule
    (true)
=>
    (set-strategic-number sn-intelligent-gathering 1)
    (set-strategic-number sn-food-gatherer-percentage 60)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 10)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (set-strategic-number sn-cap-civilian-explorers 0)
    (set-strategic-number sn-percent-civilian-explorers 0)
    (set-strategic-number sn-number-explore-groups 1)
    (set-strategic-number sn-total-number-explorers 1)
    (up-reset-scouts)
    (set-strategic-number sn-allow-adjacent-dropsites 0)
    (set-strategic-number sn-dropsite-separation-distance 8)
    (disable-self)
)

(defrule
    (unit-type-count scout-cavalry-line >= 1)
=>
    (up-send-scout group-type-land-explore scout-flank)
)

(defrule
    (population-headroom < 4)
    (building-type-count-total house < byz-house-limit)
    (can-build house)
=>
    (build house)
)

(defrule
    (unit-type-count-total villager < 90)
    (can-train villager)
=>
    (train villager)
)

(defrule
    (current-age == dark-age)
    (building-type-count-total lumber-camp < 1)
    (resource-found wood)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)

(defrule
    (current-age == dark-age)
    (building-type-count-total mill < 1)
    (resource-found food)
    (can-build mill)
=>
    (build mill)
)

(defrule
    (current-age == dark-age)
    (building-type-count-total mining-camp < 1)
    (resource-found gold)
    (can-build mining-camp)
=>
    (build mining-camp)
)

(defrule
    (current-age == dark-age)
    (unit-type-count-total barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (current-age == dark-age)
    (unit-type-count-total villager >= byz-feudal-pop)
    (can-research-with-escrow feudal-age)
=>
    (release-escrow food)
    (release-escrow gold)
    (research feudal-age)
)

(defrule
    (current-age == feudal-age)
    (building-type-count-total blacksmith < 1)
    (can-build blacksmith)
=>
    (build blacksmith)
)

(defrule
    (current-age == feudal-age)
    (building-type-count-total stable < 1)
    (can-build stable)
=>
    (build stable)
)

(defrule
    (current-age == feudal-age)
    (players-unit-type-count any-enemy archer-line >= 4)
    (building-type-count-total archery-range < 1)
    (can-build archery-range)
=>
    (build archery-range)
)

(defrule
    (current-age == feudal-age)
    (players-unit-type-count any-enemy archer-line >= 4)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total skirmisher-line < byz-skirm-feudal)
    (can-train-with-escrow skirmisher-line)
=>
    (train skirmisher-line)
)

(defrule
    (current-age == feudal-age)
    (players-unit-type-count any-enemy scout-cavalry-line >= 3)
    (unit-type-count-total spearman-line < byz-spear-feudal)
    (can-train-with-escrow spearman-line)
=>
    (train spearman-line)
)

(defrule
    (current-age == feudal-age)
    (unit-type-count-total villager >= byz-castle-pop)
    (building-type-count-total blacksmith >= 1)
    (building-type-count-total stable >= 1)
    (can-research-with-escrow castle-age)
=>
    (release-escrow food)
    (release-escrow gold)
    (research castle-age)
)

(defrule
    (current-age == feudal-age)
    (players-unit-type-count any-enemy archer-line < 4)
    (up-compare-sn sn-food-gatherer-percentage != 50)
=>
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 20)
)

(defrule
    (current-age == feudal-age)
    (players-unit-type-count any-enemy archer-line >= 4)
    (up-compare-sn sn-food-gatherer-percentage != 45)
=>
    (set-strategic-number sn-food-gatherer-percentage 45)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-gold-gatherer-percentage 15)
)

(defrule
    (current-age == castle-age)
    (up-compare-sn sn-food-gatherer-percentage != 50)
=>
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 25)
)

(defrule
    (current-age == castle-age)
    (players-unit-type-count any-enemy knight >= 3)
    (building-type-count-total stable >= 1)
    (unit-type-count-total camel-rider-line < byz-camel-castle)
    (can-train-with-escrow camel-rider-line)
=>
    (train camel-rider-line)
)

(defrule
    (current-age == castle-age)
    (players-unit-type-count any-enemy knight < 3)
    (building-type-count-total stable >= 1)
    (unit-type-count-total knight-line < byz-knight-castle)
    (can-train-with-escrow knight-line)
=>
    (train knight-line)
)

(defrule
    (current-age == castle-age)
    (players-unit-type-count any-enemy archer-line >= 4)
    (building-type-count-total archery-range < 1)
    (can-build archery-range)
=>
    (build archery-range)
)

(defrule
    (current-age == castle-age)
    (players-unit-type-count any-enemy archer-line >= 4)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total skirmisher-line < byz-skirm-castle)
    (can-train-with-escrow skirmisher-line)
=>
    (train skirmisher-line)
)

(defrule
    (current-age == castle-age)
    (building-type-count-total town-center < 2)
    (wood-amount >= 350)
    (stone-amount >= 350)
    (can-build town-center)
=>
    (build town-center)
)

(defrule
    (current-age == castle-age)
    (unit-type-count-total villager >= 35)
    (building-type-count-total town-center >= 2)
    (can-train villager)
=>
    (train villager)
)

(defrule
    (current-age == castle-age)
    (unit-type-count-total villager >= byz-imperial-vils)
    (military-population >= 18)
    (can-research-with-escrow imperial-age)
=>
    (release-escrow food)
    (release-escrow gold)
    (research imperial-age)
)

(defrule
    (current-age == imperial-age)
    (up-compare-sn sn-food-gatherer-percentage != 45)
=>
    (set-strategic-number sn-food-gatherer-percentage 45)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 30)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (current-age >= feudal-age)
    (wood-amount < 300)
    (up-compare-sn sn-wood-gatherer-percentage < 35)
=>
    (set-strategic-number sn-wood-gatherer-percentage 35)
)

(defrule
    (current-age >= feudal-age)
    (food-amount < 350)
    (up-compare-sn sn-food-gatherer-percentage < 60)
=>
    (set-strategic-number sn-food-gatherer-percentage 60)
)

(defrule
    (current-age >= imperial-age)
    (players-unit-type-count any-enemy knight >= 4)
    (building-type-count-total barracks < 2)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (current-age >= imperial-age)
    (building-type-count-total barracks >= 1)
    (unit-type-count-total halberdier < byz-imp-halbs)
    (can-train-with-escrow halberdier)
=>
    (train halberdier)
)

(defrule
    (current-age >= imperial-age)
    (players-unit-type-count any-enemy archer-line >= 6)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total skirmisher-line < byz-imp-skirm)
    (can-train-with-escrow skirmisher-line)
=>
    (train skirmisher-line)
)

(defrule
    (current-age >= castle-age)
    (building-type-count-total farm < 8)
    (wood-amount >= 60)
    (food-amount < 900)
    (can-build farm)
=>
    (build farm)
)

(defrule
    (current-age >= castle-age)
    (building-type-count-total farm < 16)
    (unit-type-count-total villager >= 35)
    (wood-amount >= 60)
    (food-amount < 1100)
    (can-build farm)
=>
    (build farm)
)

(defrule
    (current-age >= imperial-age)
    (building-type-count-total farm < 30)
    (unit-type-count-total villager >= 55)
    (wood-amount >= 60)
    (food-amount < 1200)
    (can-build farm)
=>
    (build farm)
)
