;----------------------------------------------------------------
; SURPLUS RESOURCE ARBITRATION / EXISTING SPENDS
;----------------------------------------------------------------
; Efficiency rule: one overbanked resource, one existing spend channel per
; execution pass. Higher-value upgrade/research arbitration already runs above;
; this layer only reasserts an existing demand when that higher-value work is
; not consuming the bank. Nothing here trains, builds, researches, buys, or
; sells directly. The native demand lifecycles remain the sole action owners.
;
; Resource order is deliberately deterministic: gold -> wood -> food.
; Spend order within each resource is also deterministic and biased toward
; already-fielded capabilities rather than speculative expansion.

; GOLD: selected military gold spend, then composition floor.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-late-upgrade-priority 0)
    (goal byzantine-army-reinforcement 0)
    (goal byzantine-remote-resource-state byzantine-remote-resource-idle)
    (goal byzantine-market-state byzantine-market-idle)
    (goal demand-castle-cataphract-floor 0)
    (goal demand-castle-varangian-guard-floor 0)
    (goal demand-imperial-arbalester-floor 0)
    (goal demand-imperial-halberdier-floor 0)
    (goal demand-imperial-siege-ram-floor 0)
    (goal demand-imperial-trebuchet-floor 0)
    (goal demand-imperial-bombard-floor 0)
    (goal demand-economy-farm-boom-imperial 0)
    (goal demand-economy-house-floor-16 0)
    (goal byzantine-surplus-spend-claim 0)
    (gold-amount > 4500)
    (goal demand-castle-cataphract-floor 0)
    (or
        (goal byzantine-imperial-composition-posture byzantine-imperial-posture-balanced)
        (or
            (goal byzantine-imperial-composition-posture byzantine-imperial-posture-mounted)
            (goal byzantine-imperial-composition-posture byzantine-imperial-posture-siege)
        )
    )
    (unit-type-count-total cataphract-line < bt-imperial-late-cataphract-target)
=>
    (set-goal demand-castle-cataphract-floor 1)
    (set-goal byzantine-surplus-spend-claim 1)
    (set-goal byzantine-surplus-spend-resource byzantine-surplus-resource-gold)
)

