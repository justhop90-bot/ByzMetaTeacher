        (unit-type-count-total varangian-guard-line >= 3)
    )
    (research-completed 76)
    (not (research-completed 77))
    (can-research-with-escrow ri-plate-mail)
=>
    (release-escrow gold)
    (set-goal byzantine-late-upgrade-priority 1)
    (research ri-plate-mail)
    (set-goal byzantine-late-research-claim 1)
)

; Ranged upgrades complete the archer branch when Arbalesters/Skirmishers are active.
(defrule
    (current-age >= imperial-age)
    (goal byzantine-late-resource-burn 1)
    (goal byzantine-late-research-claim 0)
    (building-type-count-total blacksmith >= 1)
    (or
        (wood-amount > 3000)
        (gold-amount > 2500)
    )
    (or
        (unit-type-count-total arbalest >= 4)
        (unit-type-count-total skirmisher-line >= 4)
    )
    (not (research-completed 199))
    (can-research-with-escrow ri-fletching)
=>
    (release-escrow food)
    (release-escrow gold)
    (set-goal byzantine-late-upgrade-priority 1)
    (research ri-fletching)
    (set-goal byzantine-late-research-claim 1)
)

