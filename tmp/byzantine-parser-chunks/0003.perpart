(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-acquire)
    (goal byzantine-wall-anchor-pair 0)
    (building-type-count keep >= 1)
    (building-type-count watch-tower >= 1)
    (current-age >= castle-age)
    (up-point-distance byzantine-wall-keep-point byzantine-wall-watch-point > 32)
    (up-point-distance byzantine-wall-keep-point byzantine-wall-watch-point <= 48)
=>
    (set-goal byzantine-wall-anchor-pair byzantine-wall-pair-keep-watch-tower)
    (set-goal byzantine-wall-geometry-state byzantine-wall-geometry-selected)
)
