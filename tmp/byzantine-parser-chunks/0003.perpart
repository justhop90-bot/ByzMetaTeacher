(defrule
    (goal byzantine-wall-geometry-state byzantine-wall-geometry-armed)
    (goal demand-adaptive-stone-wall 1)
    (goal action-claim-build-pass-singleton 0)
    (goal byzantine-wall-anchor-pair byzantine-wall-pair-town-center-castle)
    (current-age >= castle-age)
    (building-type-count town-center >= 1)
    (building-type-count castle >= 1)
    (up-pending-objects c: 117 == 0)
    (not (up-pending-placement c: 117))
    (up-can-build-line 0 byzantine-wall-tc-point c: 117)
=>
    (up-build-line byzantine-wall-tc-point byzantine-wall-castle-point c: 117)
    (set-goal action-claim-build-pass-singleton 1)
    (set-goal demand-adaptive-stone-wall 46)
    (set-goal byzantine-wall-geometry-state byzantine-wall-geometry-idle)
    (enable-timer byzantine-wall-geometry-timer bt-byzantine-wall-geometry-seconds)
)
