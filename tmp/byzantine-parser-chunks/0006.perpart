(defrule
    (current-age >= imperial-age)
=>
    (set-goal byzantine-late-upgrade-priority 0)
    (set-goal byzantine-late-research-claim 0)
    (set-goal byzantine-surplus-spend-claim 0)
    (set-goal byzantine-surplus-spend-resource byzantine-surplus-resource-idle)
)

(defrule
    (true)
=>
    (set-strategic-number sn-defer-dropsite-update 1)
    (disable-self)
)

; Late Imperial bank pressure: only activate after the army/economy is mature.
; This is a spend-pressure state, not a new strategy. It re-arms existing
; production demands while excess resources coexist with population headroom.
(defrule
    (goal byzantine-late-resource-burn 0)
    (current-age >= imperial-age)
    (unit-type-count-total villager >= 60)
    (population-headroom > 0)
    (or
        (gold-amount > 3000)
        (or
            (wood-amount > 3000)
            (food-amount > 3500)
        )
    )
=>
    (set-goal byzantine-late-resource-burn 1)
)

(defrule
    (goal byzantine-late-resource-burn 1)
    (or
        (current-age < imperial-age)
        (or
            (population-headroom <= 0)
            (and
                (gold-amount < 1500)
                (and
                    (wood-amount < 1500)
                    (food-amount < 2000)
                )
            )
        )
    )
=>
    (set-goal byzantine-late-resource-burn 0)
)


(defrule
    (goal byzantine-siege-scale -1)
=>
    (set-goal byzantine-siege-scale 0)
)

(defrule
    (current-age == castle-age)
    (goal byzantine-army-plan-phase 0)
=>
    (set-goal byzantine-army-plan-phase 1)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-army-plan-phase 1)
=>
    (set-goal byzantine-army-plan-phase 2)
)

;----------------------------------------------------------------
;----------------------------------------------------------------
; REMOTE RESOURCE RECOVERY / PRODUCTIVITY-WITNESSED CAMP CONTROL
;----------------------------------------------------------------
; Efficiency contract: camp count is not productivity. We probe the active
; resource, locate the nearest owned camp, and count villagers assigned to that
; dropsite inside a bounded local radius. Two assigned gatherers is the minimum
; productive witness. The existing camp lifecycle still owns construction.

(defrule
    (true)
=>
    (enable-timer byzantine-remote-resource-productivity-timer bt-resource-productivity-seconds)
    (disable-self)
)

(defrule
    (timer-triggered byzantine-remote-resource-productivity-timer)
=>
    (disable-timer byzantine-remote-resource-productivity-timer)
    (enable-timer byzantine-remote-resource-productivity-timer bt-resource-productivity-seconds)
)

(defrule
    (current-age >= castle-age)
    (goal byzantine-remote-resource-state byzantine-remote-resource-idle)
    (goal byzantine-remote-resource-kind byzantine-remote-resource-none)
    (goal byzantine-remote-resource-productivity-state byzantine-remote-productivity-idle)
    (unit-type-count-total villager >= 45)
    (not (town-under-attack))
    (goal byzantine-army-reinforcement 0)
    (timer-triggered byzantine-remote-resource-productivity-timer)
    (resource-found gold)
    (gold-amount < 1800)
    (dropsite-min-distance gold == -1)
=>
    (set-goal byzantine-remote-resource-state byzantine-remote-resource-observe)
)

(defrule
    (current-age >= castle-age)
    (goal byzantine-remote-resource-state byzantine-remote-resource-idle)
    (goal byzantine-remote-resource-kind byzantine-remote-resource-none)
    (goal byzantine-remote-resource-productivity-state byzantine-remote-productivity-idle)
    (unit-type-count-total villager >= 45)
    (not (town-under-attack))
    (goal byzantine-army-reinforcement 0)
    (timer-triggered byzantine-remote-resource-productivity-timer)
    (resource-found gold)
    (gold-amount < 1800)
    (dropsite-min-distance gold > 18)
=>
    (set-goal byzantine-remote-resource-state byzantine-remote-resource-observe)
)

(defrule
    (current-age >= castle-age)
    (goal byzantine-remote-resource-state byzantine-remote-resource-idle)
    (goal byzantine-remote-resource-kind byzantine-remote-resource-none)
    (goal byzantine-remote-resource-productivity-state byzantine-remote-productivity-idle)
    (unit-type-count-total villager >= 45)
    (not (town-under-attack))
    (goal byzantine-army-reinforcement 0)
    (timer-triggered byzantine-remote-resource-productivity-timer)
    (resource-found wood)
    (wood-amount < 1400)
    (dropsite-min-distance wood == -1)
=>
    (set-goal byzantine-remote-resource-state byzantine-remote-resource-observe)
)

(defrule
    (current-age >= castle-age)
    (goal byzantine-remote-resource-state byzantine-remote-resource-idle)
    (goal byzantine-remote-resource-kind byzantine-remote-resource-none)
    (goal byzantine-remote-resource-productivity-state byzantine-remote-productivity-idle)
    (unit-type-count-total villager >= 45)
    (not (town-under-attack))
    (goal byzantine-army-reinforcement 0)
    (timer-triggered byzantine-remote-resource-productivity-timer)
    (resource-found wood)
    (wood-amount < 1400)
    (dropsite-min-distance wood > 18)
=>
    (set-goal byzantine-remote-resource-state byzantine-remote-resource-observe)
)

; Deterministic resource winner: gold first, then wood.
(defrule
    (goal byzantine-remote-resource-state byzantine-remote-resource-observe)
    (goal byzantine-remote-resource-kind byzantine-remote-resource-none)
    (resource-found gold)
    (gold-amount < 1800)
    (or
        (dropsite-min-distance gold == -1)
        (dropsite-min-distance gold > 18)
    )
=>
    (set-goal byzantine-remote-resource-kind byzantine-remote-resource-gold)
    (set-goal byzantine-remote-resource-productivity-state byzantine-remote-productivity-find-resource)