(defrule
    (and (goal opening-plan -1) (and (map-type islands) (or (players-unit-type-count any-enemy galley-line >= 2) (players-unit-type-count any-enemy fire-galley-line >= 2))))
=>
    (set-goal opening-plan 5)
)

; Native control rule: opening-selector-water-economy
(defrule
    (and (goal opening-plan -1) (and (map-type islands) (not (or (players-unit-type-count any-enemy galley-line >= 2) (players-unit-type-count any-enemy fire-galley-line >= 2)))))
=>
    (set-goal opening-plan 4)
)

; Native control rule: opening-selector-fast-castle
(defrule
    (and (goal opening-plan -1) (and (map-type arena) (not (players-unit-type-count any-enemy militia-line >= 5))))
=>
    (set-goal opening-plan 3)
)

; Native control rule: opening-selector-counter-feudal
(defrule
    (and (goal opening-plan -1) (and (not (map-type islands)) (and (not (map-type arena)) (players-unit-type-count any-enemy militia-line >= 5))))
=>
    (set-goal opening-plan 2)
)

; Native control rule: opening-selector-defensive-standard
(defrule
    (and (goal opening-plan -1) (and (not (map-type islands)) (and (not (map-type arena)) (not (players-unit-type-count any-enemy militia-line >= 5)))))
=>
