    (train scout-cavalry-line)
    (set-goal action-claim-train-arbitration 1)
    (set-goal demand-feudal-scout-floor 334)
)

;---------------------------------------------------------------
; FEUDAL MAN-AT-ARMS UPGRADE
;---------------------------------------------------------------
(defrule
    (goal demand-feudal-maa-upgrade 345)
    (research-completed ri-man-at-arms)
=>
    (set-goal demand-feudal-maa-upgrade 0)
)

(defrule
    (goal demand-feudal-maa-upgrade 0)
    (current-age == feudal-age)
    (goal byzantine-feudal-army-package byzantine-feudal-package-maa)
    (not (research-completed ri-man-at-arms))
=>
    (set-goal demand-feudal-maa-upgrade 1)
)

(defrule
    (or
        (goal demand-feudal-maa-upgrade 346)
        (goal demand-feudal-maa-upgrade 344)
    )
    (research-completed ri-man-at-arms)
=>
    (set-goal demand-feudal-maa-upgrade 345)
)

(defrule
    (or
        (goal demand-feudal-maa-upgrade 346)
        (goal demand-feudal-maa-upgrade 344)
    )
    (not (research-completed ri-man-at-arms))
    (up-research-status c: ri-man-at-arms >= research-pending)
=>
    (set-goal demand-feudal-maa-upgrade 344)
)

(defrule
    (or
        (goal demand-feudal-maa-upgrade 346)
        (goal demand-feudal-maa-upgrade 344)
    )
    (not (research-completed ri-man-at-arms))
    (not (up-research-status c: ri-man-at-arms >= research-pending))
=>
    (set-goal demand-feudal-maa-upgrade 1)
    (set-goal research-retry-barrier-feudal-maa-upgrade 1)
)

(defrule
    (goal demand-feudal-maa-upgrade 1)
    (goal research-retry-barrier-feudal-maa-upgrade 0)
    (current-age == feudal-age)
    (goal byzantine-feudal-army-package byzantine-feudal-package-maa)
    (not (research-completed ri-man-at-arms))
    (can-research-with-escrow ri-man-at-arms)
=>
    (release-escrow food)
    (release-escrow gold)
    (research ri-man-at-arms)
    (set-goal demand-feudal-maa-upgrade 346)
)

;---------------------------------------------------------------
; FEUDAL MAN-AT-ARMS FLOOR
;---------------------------------------------------------------
(defrule
    (goal demand-feudal-maa-floor 341)
    (unit-type-count militia-line >= bt-feudal-maa-floor)
=>
    (set-goal demand-feudal-maa-floor 0)
)

(defrule
    (goal demand-feudal-maa-floor 0)
    (current-age == feudal-age)
    (goal byzantine-feudal-army-package byzantine-feudal-package-maa)
    (research-completed ri-man-at-arms)
    (unit-type-count-total militia-line < bt-feudal-maa-floor)
=>
    (set-goal demand-feudal-maa-floor 1)
)

(defrule
    (or
        (goal demand-feudal-maa-floor 339)
        (goal demand-feudal-maa-floor 340)
    )
    (unit-type-count militia-line >= bt-feudal-maa-floor)
=>
    (set-goal demand-feudal-maa-floor 341)
)

(defrule
    (or
        (goal demand-feudal-maa-floor 339)
        (goal demand-feudal-maa-floor 340)
    )
    (not (unit-type-count militia-line >= bt-feudal-maa-floor))
    (up-pending-objects c: 74 >= 1)
=>
    (set-goal demand-feudal-maa-floor 340)
)

(defrule
    (or
        (goal demand-feudal-maa-floor 339)
        (goal demand-feudal-maa-floor 340)
    )
    (not (unit-type-count militia-line >= bt-feudal-maa-floor))
    (not (up-pending-objects c: 74 >= 1))
=>
    (set-goal demand-feudal-maa-floor 1)
    (set-goal production-retry-barrier-feudal-maa-floor 1)
)

(defrule
    (goal demand-feudal-maa-floor 1)
    (goal production-retry-barrier-feudal-maa-floor 0)
    (current-age == feudal-age)
    (goal byzantine-feudal-army-package byzantine-feudal-package-maa)
    (research-completed ri-man-at-arms)
    (goal action-claim-train-arbitration 0)
    (goal byzantine-resource-claim 0)
    (can-train-with-escrow militia-line)
    (unit-type-count-total militia-line < bt-feudal-maa-floor)
=>
    (train militia-line)
    (set-goal action-claim-train-arbitration 1)
    (set-goal demand-feudal-maa-floor 339)
)

; Feudal package handoff: any unsatisfied Feudal-only production/research
; demand is dropped when Castle Age is reached. A queued native action may
; still finish and is witnessed normally; the demand no longer authorizes new work.
(defrule
    (current-age >= castle-age)
    (or
        (goal demand-early-defensive-spears 1)
        (or
            (goal demand-early-defensive-spears 66)
            (goal demand-early-defensive-spears 64)
        )
    )
=>
    (set-goal demand-early-defensive-spears 0)
)

(defrule
    (current-age >= castle-age)
    (or
        (goal demand-counter-mounted-spears 1)
        (or
            (goal demand-counter-mounted-spears 64)
            (goal demand-counter-mounted-spears 62)
        )
    )
=>
    (set-goal demand-counter-mounted-spears 0)
)

(defrule
    (current-age >= castle-age)
    (or
        (goal demand-counter-ranged-skirmishers 1)
        (or
            (goal demand-counter-ranged-skirmishers 65)
            (goal demand-counter-ranged-skirmishers 63)
        )
    )
=>
    (set-goal demand-counter-ranged-skirmishers 0)
)

(defrule
    (current-age >= castle-age)
    (or
        (goal demand-feudal-maa-upgrade 1)
        (or
            (goal demand-feudal-maa-upgrade 346)
            (goal demand-feudal-maa-upgrade 344)
        )
    )
=>
    (set-goal demand-feudal-maa-upgrade 0)
)

; The Feudal package is no longer authorized to add new offensive units after
; Castle is reached; Castle standing-army policy owns the handoff.
(defrule
    (current-age >= castle-age)
    (or
        (goal demand-feudal-archer-floor 1)
        (or
            (goal demand-feudal-archer-floor 329)
            (goal demand-feudal-archer-floor 330)
        )
    )
=>
    (set-goal demand-feudal-archer-floor 0)
)

(defrule
    (current-age >= castle-age)
    (or
        (goal demand-feudal-scout-floor 1)
        (or
            (goal demand-feudal-scout-floor 334)
            (goal demand-feudal-scout-floor 335)
        )
    )
=>
    (set-goal demand-feudal-scout-floor 0)
)

(defrule
    (current-age >= castle-age)
    (or
        (goal demand-feudal-maa-floor 1)
        (or
            (goal demand-feudal-maa-floor 339)
            (goal demand-feudal-maa-floor 340)
        )
    )
=>
    (set-goal demand-feudal-maa-floor 0)
)

