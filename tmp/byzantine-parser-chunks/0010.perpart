)

; Completion witness: counter-castle-camels | PENDING/ISSUED -> COMPLETE
(defrule
    (or
        (goal demand-counter-castle-camels 61)
        (goal demand-counter-castle-camels 59)
    )
    (unit-type-count 329 >= 3)
=>
    (set-goal demand-counter-castle-camels 60)
)

; Pending admission: counter-castle-camels | ISSUED/PENDING -> PENDING
(defrule
    (or
        (goal demand-counter-castle-camels 61)
        (goal demand-counter-castle-camels 59)
    )
    (not (unit-type-count 329 >= 3))
    (up-pending-objects c: 329 >= 1)
=>
    (set-goal demand-counter-castle-camels 59)
)

; RETRY | ISSUED/PENDING -> ACTIVE
(defrule
    (or
        (goal demand-counter-castle-camels 61)
        (goal demand-counter-castle-camels 59)
    )
    (not (unit-type-count 329 >= 3))
    (not (up-pending-objects c: 329 >= 1))
=>
    (set-goal demand-counter-castle-camels 1)
    (set-goal production-retry-barrier-counter-castle-camels 1)
)

; Action issuance: counter-castle-camels | ACTIVE -> ISSUED
(defrule
    (goal demand-counter-castle-camels 1)
    (not (unit-type-count 329 >= 3))
    (goal production-retry-barrier-counter-castle-camels 0)
    (not (up-pending-objects c: 329 >= 1))
    (not (unit-type-count 329 >= 3))
    (goal action-claim-train-arbitration 0)
    (current-age >= castle-age)
    (can-train-with-escrow 329)
    (unit-type-count-total camel-rider-line < 3)
=>
    (train 329)
    (set-goal action-claim-train-arbitration 1)
    (set-goal demand-counter-castle-camels 61)
)

