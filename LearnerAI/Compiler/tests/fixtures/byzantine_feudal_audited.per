;----------------------------------------------------------------
; IMPERIAL MILITARY COMPOSITION ARBITRATION
;----------------------------------------------------------------
; The existing counter-package control plane already records persistent
; Castle-age threat observations. Imperial composition adds one post-Castle
; policy overlay. The existing training mutex remains the execution arbiter.
;
; Priority: mounted > ranged > infantry > siege > balanced.
; Existing Byzantine thresholds are reused where they already exist.

(defrule
    (current-age >= imperial-age)
    (or
        (goal counter-package-mounted_pressure_castle 1)
        (or
            (players-unit-type-count any-enemy camel-rider-line >= 3)
            (players-unit-type-count any-enemy scout-cavalry-line >= 6)
        )
    )
=>
    (set-goal byzantine-imperial-composition-posture byzantine-imperial-posture-mounted)
)

(defrule
    (current-age >= imperial-age)
    (players-unit-type-count any-enemy archer-line >= 4)
    (not (goal byzantine-imperial-composition-posture byzantine-imperial-posture-mounted))
=>
    (set-goal byzantine-imperial-composition-posture byzantine-imperial-posture-ranged)
)

(defrule
    (current-age >= imperial-age)
    (players-unit-type-count any-enemy cavalry-archer-line >= 4)
    (not (goal byzantine-imperial-composition-posture byzantine-imperial-posture-mounted))
=>
    (set-goal byzantine-imperial-composition-posture byzantine-imperial-posture-ranged)
)

(defrule
    (current-age >= imperial-age)
    (goal counter-package-infantry_pressure_castle 1)
    (not (goal byzantine-imperial-composition-posture byzantine-imperial-posture-mounted))
    (not (goal byzantine-imperial-composition-posture byzantine-imperial-posture-ranged))
=>
    (set-goal byzantine-imperial-composition-posture byzantine-imperial-posture-infantry)
)

(defrule
    (current-age >= imperial-age)
    (goal counter-package-siege_pressure_castle 1)
    (not (goal byzantine-imperial-composition-posture byzantine-imperial-posture-mounted))
    (not (goal byzantine-imperial-composition-posture byzantine-imperial-posture-ranged))
    (not (goal byzantine-imperial-composition-posture byzantine-imperial-posture-infantry))
=>
    (set-goal byzantine-imperial-composition-posture byzantine-imperial-posture-siege)
)

(defrule
    (current-age >= imperial-age)
    (not (goal byzantine-imperial-composition-posture byzantine-imperial-posture-mounted))
    (not (goal byzantine-imperial-composition-posture byzantine-imperial-posture-ranged))
    (not (goal byzantine-imperial-composition-posture byzantine-imperial-posture-infantry))
    (not (goal byzantine-imperial-composition-posture byzantine-imperial-posture-siege))
=>
    (set-goal byzantine-imperial-composition-posture byzantine-imperial-posture-balanced))

