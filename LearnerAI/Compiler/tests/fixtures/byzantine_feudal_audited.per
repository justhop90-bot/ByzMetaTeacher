; Native DUC execution plan
; Native DUC rule: byzantine-castle-target-knight
(defrule
    (current-age >= castle-age)
    (up-compare-sn 227 >= 75)
    (players-unit-type-count any-enemy knight >= 3)
=>
    (up-full-reset-search)
    (up-find-remote c: 38 c: 1)
    (up-set-target-object search-remote c: 0)
    (up-get-object-data object-data-id 166)
)

; Native DUC rule: byzantine-castle-target-infantry
(defrule
    (current-age >= castle-age)
    (up-compare-sn 227 >= 75)
    (players-unit-type-count any-enemy militia-line >= 5)
=>
    (up-full-reset-search)
    (up-find-remote c: 74 c: 1)
    (up-set-target-object search-remote c: 0)
    (up-get-object-data object-data-id 165)
)

; Native DUC rule: byzantine-relic-acquisition-intent
(defrule
    (current-age >= castle-age)
    (building-type-count-total monastery >= 1)
    (unit-type-count-total monk >= 1)
    (unit-type-count-total monk >= 1)
=>
    (up-full-reset-search)
    (up-find-remote c: 125 c: 1)
    (up-set-target-object search-remote c: 0)
    (up-target-objects 1 action-move -1 -1)
)

; Native DUC rule: byzantine-relic-denial-contest
(defrule
    (current-age >= castle-age)
    (building-type-count-total monastery >= 1)
    (unit-type-count-total monk >= 1)
    (players-unit-type-count any-enemy monk-set >= 2)
=>
    (up-full-reset-search)
    (up-find-remote c: 125 c: 1)
    (up-set-target-object search-remote c: 0)
    (up-target-objects 1 action-move -1 -1)
)

