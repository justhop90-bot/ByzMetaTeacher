(defrule
    (goal byzantine-imperial-composition-posture -1)
=>
    (set-goal byzantine-imperial-composition-posture byzantine-imperial-posture-balanced)
)

; Persistent army-plan state bootstrap.
(defrule
    (goal byzantine-army-plan-phase -1)
=>
    (set-goal byzantine-army-plan-phase 0)
)

(defrule
    (goal byzantine-army-attack-ready -1)
=>
    (set-goal byzantine-army-attack-ready 0)
)

(defrule
    (goal byzantine-army-reinforcement -1)
=>
    (set-goal byzantine-army-reinforcement 0)
)

(defrule
    (goal byzantine-siege-scale -1)
=>
    (set-goal byzantine-siege-scale 0)
)

(defrule
    (current-age == castle-age)
    (goal byzantine-army-plan-phase 0)
=>
    (set-goal byzantine-army-plan-phase 1)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-army-plan-phase 1)
=>
    (set-goal byzantine-army-plan-phase 2)
)

;----------------------------------------------------------------
; PERSISTENT BYZANTINE STANDING ARMY FLOORS
;----------------------------------------------------------------
; Recurrent native policy: keep a standing army, then let observations add
; counter branches. The default Byzantine Imperial backbone is Cataphract +
; cheap support + persistent siege. Varangian/Arbalester are selected branches,
; not simultaneous mandatory gold sinks.

(defrule
    (current-age == castle-age)
    (goal demand-castle-cataphract-floor 0)
    (unit-type-count-total cataphract-line < bt-castle-cataphract-floor)
=>
    (set-goal demand-castle-cataphract-floor 1)
)

(defrule
    (current-age == castle-age)
    (goal demand-castle-varangian-guard-floor 0)
    (players-unit-type-count any-enemy knight >= 3)
    (unit-type-count-total varangian-guard-line < bt-castle-varangian-floor)
=>
    (set-goal demand-castle-varangian-guard-floor 1)
)

(defrule
    (current-age == castle-age)
    (goal demand-counter-ranged-skirmishers 0)
    (unit-type-count-total skirmisher-line < bt-castle-skirmisher-floor)
=>
    (set-goal demand-counter-ranged-skirmishers 1)
)

(defrule
    (current-age == castle-age)
    (goal demand-castle-mangonel-floor 0)
    (unit-type-count-total mangonel-line < bt-castle-mangonel-floor)
=>
    (set-goal demand-castle-mangonel-floor 1)
)

(defrule
    (current-age == castle-age)
    (goal demand-castle-monk-floor 0)
    (unit-type-count-total monk < bt-castle-monk-floor)
=>
    (set-goal demand-castle-monk-floor 1)
)

; Imperial default backbone: Cataphracts + Halberdiers + standing siege.
(defrule
    (current-age >= imperial-age)
    (goal demand-castle-cataphract-floor 0)
    (unit-type-count-total cataphract-line < bt-imperial-cataphract-floor)
=>
    (set-goal demand-castle-cataphract-floor 1)
)

; Varangian is a deliberate infantry/cavalry support branch, not a second
; unconditional Imperial gold sink.
(defrule
    (current-age >= imperial-age)
    (goal demand-castle-varangian-guard-floor 0)
    (goal byzantine-imperial-composition-posture byzantine-imperial-posture-infantry)
    (unit-type-count-total varangian-guard-line < bt-imperial-varangian-floor)
=>
    (set-goal demand-castle-varangian-guard-floor 1)
)

; Arbalester is the selected ranged backbone branch. Default balanced/mounted
; play stays on Cataphract + cheap support rather than funding both gold cores.
(defrule
    (current-age >= imperial-age)
    (goal demand-imperial-arbalester-floor 0)
    (goal byzantine-imperial-composition-posture byzantine-imperial-posture-ranged)
    (unit-type-count-total arbalest < bt-imperial-arbalester-floor)
=>
    (set-goal demand-imperial-arbalester-floor 1)
)
(defrule
    (current-age >= imperial-age)
    (goal demand-imperial-halberdier-floor 0)
    (unit-type-count-total 359 < bt-imperial-halberdier-floor)
=>
    (set-goal demand-imperial-halberdier-floor 1)
)

; Stand up the first offensive siege battery as soon as Imperial is reached.
; Target escalation is handled by byzantine-siege-scale below, not by enemy
; sightings turning the entire siege layer on and off.

(defrule
    (current-age >= imperial-age)
    (goal byzantine-siege-scale 0)
=>
    (set-goal byzantine-siege-scale byzantine-siege-scale-standard)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-siege-scale byzantine-siege-scale-standard)
    (goal byzantine-army-attack-ready 2)
    (players-building-type-count any-enemy 82 >= 1)
=>
    (set-goal byzantine-siege-scale byzantine-siege-scale-fortified)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-siege-scale byzantine-siege-scale-fortified)
    (not (players-building-type-count any-enemy 82 >= 1))
=>
    (set-goal byzantine-siege-scale byzantine-siege-scale-standard)
)

;----------------------------------------------------------------
; UPGRADE SEQUENCING
;----------------------------------------------------------------
; Standing army first establishes the useful mass, then spends Imperial gold
; on the Byzantine-specific package in this order:
;   Logistica -> Elite Cataphract -> Elite Varangian Guard -> Elite Skirmisher.
; Existing ordinary research demands remain responsible for blacksmith/ranged/
; siege upgrades; these unique upgrades must not race each other for the bank.

;----------------------------------------------------------------
; ATTACK THRESHOLDS AND REINFORCEMENT
;----------------------------------------------------------------
; The attack gate is persistent and army-based. Enemy composition changes the
; selected backbone, but does not create the need to attack.
; Castle: 4 Cataphracts + 4 Skirmishers + 2 Mangonels + 1 Monk.
; Imperial: selected 6-unit backbone + 8 Halberdiers + 2/2/2 siege.

(defrule
    (current-age == castle-age)
    (goal byzantine-army-plan-phase 1)
    (goal byzantine-army-attack-ready 0)
    (up-compare-sn 227 >= 75)
    (unit-type-count-total cataphract-line >= bt-castle-cataphract-floor)
    (unit-type-count-total skirmisher-line >= bt-castle-skirmisher-floor)
    (unit-type-count-total mangonel-line >= bt-castle-attack-siege-target)
    (unit-type-count-total monk >= bt-castle-monk-floor)
=>
    (set-goal byzantine-army-attack-ready 1)
)

(defrule (current-age >= imperial-age) (goal byzantine-army-plan-phase 2) (goal byzantine-army-attack-ready 0) (up-compare-sn 227 >= 75) (or (or (and (or (goal byzantine-imperial-composition-posture
byzantine-imperial-posture-balanced) (or (goal byzantine-imperial-composition-posture byzantine-imperial-posture-mounted) (goal byzantine-imperial-composition-posture byzantine-imperial-posture-siege)))
(unit-type-count-total cataphract-line >= bt-imperial-cataphract-floor)) (and (goal byzantine-imperial-composition-posture byzantine-imperial-posture-infantry) (unit-type-count-total varangian-guard-line >=
bt-imperial-varangian-floor))) (and (goal byzantine-imperial-composition-posture byzantine-imperial-posture-ranged) (unit-type-count-total arbalest >= bt-imperial-arbalester-floor))) (unit-type-count-total 359 >=
bt-imperial-halberdier-floor) (or (and (and (and (goal byzantine-siege-scale byzantine-siege-scale-standard) (unit-type-count-total trebuchet >= bt-imperial-trebuchet-target)) (unit-type-count-total bombard-cannon >=
bt-imperial-bombard-floor)) (unit-type-count-total battering-ram-line >= bt-imperial-attack-siege-target)) (and (and (and (goal byzantine-siege-scale byzantine-siege-scale-fortified) (unit-type-count-total trebuchet >=
bt-imperial-fortified-trebuchet-target)) (unit-type-count-total bombard-cannon >= bt-imperial-fortified-bombard-target)) (unit-type-count-total battering-ram-line >= bt-imperial-fortified-ram-target))) => (set-goal
byzantine-army-attack-ready 1))

(defrule
    (current-age >= castle-age)
    (goal byzantine-army-attack-ready 1)
=>
    (attack-now)
    (set-goal byzantine-army-attack-ready 2)
)

; Reinforcement is driven by loss of the attack package, not by enemy sighting.
(defrule
    (current-age == castle-age)
    (goal byzantine-army-attack-ready 2)
    (or
        (unit-type-count-total cataphract-line < bt-castle-cataphract-floor)
        (or
            (unit-type-count-total skirmisher-line < bt-castle-skirmisher-floor)
            (or
                (unit-type-count-total mangonel-line < bt-castle-mangonel-floor)
                (unit-type-count-total monk < bt-castle-monk-floor)
            )
        )
    )
=> 
    (set-goal byzantine-army-attack-ready 0)
    (set-goal byzantine-army-reinforcement 1)
)

(defrule
    (current-age >= imperial-age)
    (goal byzantine-army-attack-ready 2)
    (or
        (unit-type-count-total 359 < bt-imperial-halberdier-floor)
        (or
            (and
                (goal byzantine-siege-scale byzantine-siege-scale-standard)
                (or
                    (unit-type-count-total trebuchet < bt-imperial-trebuchet-target)
                    (or
                        (unit-type-count-total bombard-cannon < bt-imperial-bombard-floor)
                        (unit-type-count-total battering-ram-line < bt-imperial-attack-siege-target)
                    )
                )
            )
            (and
                (goal byzantine-siege-scale byzantine-siege-scale-fortified)
                (or
                    (unit-type-count-total trebuchet < bt-imperial-fortified-trebuchet-target)
                    (or
                        (unit-type-count-total bombard-cannon < bt-imperial-fortified-bombard-target)
                        (unit-type-count-total battering-ram-line < bt-imperial-fortified-ram-target)
                    )
                )
            )
        )
    )
=> 
    (set-goal byzantine-army-attack-ready 0)
    (set-goal byzantine-army-reinforcement 1)
)

(defrule
    (goal byzantine-army-reinforcement 1)
    (current-age == castle-age)
    (unit-type-count-total cataphract-line >= bt-castle-cataphract-floor)
    (unit-type-count-total skirmisher-line >= bt-castle-skirmisher-floor)
    (unit-type-count-total mangonel-line >= bt-castle-mangonel-floor)
    (unit-type-count-total monk >= bt-castle-monk-floor)
=>
    (set-goal byzantine-army-reinforcement 0)
    (set-goal byzantine-army-attack-ready 1)
)

(defrule (goal byzantine-army-reinforcement 1) (current-age >= imperial-age) (unit-type-count-total 359 >= bt-imperial-halberdier-floor) (or (and (and (and (goal byzantine-siege-scale byzantine-siege-scale-standard)
(unit-type-count-total trebuchet >= bt-imperial-trebuchet-target)) (unit-type-count-total bombard-cannon >= bt-imperial-bombard-floor)) (unit-type-count-total battering-ram-line >= bt-imperial-attack-siege-target)) (and
(and (and (goal byzantine-siege-scale byzantine-siege-scale-fortified) (unit-type-count-total trebuchet >= bt-imperial-fortified-trebuchet-target)) (unit-type-count-total bombard-cannon >=
bt-imperial-fortified-bombard-target)) (unit-type-count-total battering-ram-line >= bt-imperial-fortified-ram-target))) (or (or (and (or (goal byzantine-imperial-composition-posture byzantine-imperial-posture-balanced)
(or (goal byzantine-imperial-composition-posture byzantine-imperial-posture-mounted) (goal byzantine-imperial-composition-posture byzantine-imperial-posture-siege))) (unit-type-count-total cataphract-line >=
bt-imperial-cataphract-floor)) (and (goal byzantine-imperial-composition-posture byzantine-imperial-posture-infantry) (unit-type-count-total varangian-guard-line >= bt-imperial-varangian-floor))) (and (goal
byzantine-imperial-composition-posture byzantine-imperial-posture-ranged) (unit-type-count-total arbalest >= bt-imperial-arbalester-floor))) => (set-goal byzantine-army-reinforcement 0) (set-goal
byzantine-army-attack-ready 1))

