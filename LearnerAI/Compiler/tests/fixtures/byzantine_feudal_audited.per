; Action issuance: imperial-conversion | ACTIVE -> ISSUED
; Community-native maturity contract translated into the Byzantine lifecycle:
;   Castle Age
;   -> 50-villager civilian maturity
;   -> completed University
;   -> free Byzantine resource claim
;   -> native Imperial research feasibility
; The University prerequisite is witnessed explicitly; resource cost/discount
; remains owned by can-research-with-escrow and the civ's live game data.
(defrule
    (goal demand-imperial-conversion 1)
    (not (current-age >= imperial-age))
    (goal research-retry-barrier-imperial-conversion 0)
    (not (up-research-status c: 103 >= 2))
    (not (current-age >= imperial-age))
    (current-age == castle-age)
    (unit-type-count-total villager >= bt-imperial-age-villager-maturity)
    (building-type-count-total university >= 1)
    (goal byzantine-resource-claim 0)
    (can-research-with-escrow imperial-age)
=>
    (set-goal byzantine-resource-claim 3)
    (release-escrow food)
    (release-escrow gold)
    (research imperial-age)
    (set-goal demand-imperial-conversion 88)
)

; Age handoff: Feudal military package ownership ends at Castle.
(defrule
    (current-age >= castle-age)
    (or
        (goal byzantine-feudal-army-package byzantine-feudal-package-archer)
        (or
            (goal byzantine-feudal-army-package byzantine-feudal-package-skirmisher)
            (or
                (goal byzantine-feudal-army-package byzantine-feudal-package-scout)
                (or
                    (goal byzantine-feudal-army-package byzantine-feudal-package-maa)
                    (goal byzantine-feudal-army-package byzantine-feudal-package-trash)
                )
            )
        )
    )
=>
    (set-goal byzantine-feudal-army-package byzantine-feudal-package-minimal)
)

