; Feudal Scale Barding is a defensive Scout investment against ranged fire.
(defrule
    (current-age >= feudal-age)
    (building-type-count blacksmith >= 1)
    (or
        (and
            (goal bt-scout-pressure-demand-goal 1)
            (and
                (unit-type-count-total scout-cavalry >= 3)
                (goal bt-ranged-threat-goal 1)
            )
        )
        (and
            (current-age >= castle-age)
