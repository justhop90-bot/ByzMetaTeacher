;================================================================

;================================================================
; MONASTERY / MONK DEMAND
;================================================================
(defrule
    (current-age >= castle-age)
    (players-unit-type-count target-player monk >= 1)
=>
    (set-goal bt-monk-target-goal 3)
    (set-goal bt-monk-demand-goal 1)
)
(defrule
    (current-age >= castle-age)
    (players-unit-type-count target-player monk < 1)
    (or
        (players-unit-type-count target-player mangonel-line >= 1)
        (or
            (players-unit-type-count target-player scorpion-line >= 1)
            (or
                (players-unit-type-count target-player battering-ram-line >= 1)
                (or
                    (players-unit-type-count target-player siege-tower >= 1)
                    (or
                        (players-unit-type-count target-player bombard-cannon-line >= 1)
                        (players-unit-type-count target-player trebuchet-set >= 1)
                    )
                )
            )
        )
    )
=>
    (set-goal bt-monk-target-goal 2)
    (set-goal bt-monk-demand-goal 1)
)
(defrule
    (current-age >= imperial-age)
    (or
        (players-unit-type-count target-player mangonel-line >= 1)
        (or
            (players-unit-type-count target-player bombard-cannon-line >= 1)
            (players-unit-type-count target-player trebuchet-set >= 1)
        )
    )
=>
    (set-goal bt-monk-target-goal 4)
    (set-goal bt-monk-demand-goal 1)
)
(defrule
    (goal bt-monk-demand-goal 1)
    (players-unit-type-count target-player monk < 1)
    (players-unit-type-count target-player mangonel-line < 1)
    (players-unit-type-count target-player scorpion-line < 1)
    (players-unit-type-count target-player battering-ram-line < 1)
    (players-unit-type-count target-player siege-tower < 1)
    (players-unit-type-count target-player bombard-cannon-line < 1)
    (players-unit-type-count target-player trebuchet-set < 1)
=>
    (set-goal bt-monk-demand-goal 0)
    (set-goal bt-monk-target-goal 0)
)

; MONK RESEARCH PACKAGE
;================================================================
; The cursor follows the actual monk job rather than a blind monastery
; technology queue. Enemy monks are answered first with Atonement;
; siege is answered with Redemption; Sanctity follows once the active
; monk job is established; Block Printing is an Imperial extension of
; an existing siege-conversion job. Faith and Theocracy are deliberately
; not automatic here: Faith now requires Devotion, while Theocracy needs
; a real grouped-conversion use case rather than a raw monk count.
(defrule
    (goal bt-research-monk-package-goal 0)
    (goal bt-monk-demand-goal 1)
    (unit-type-count-total monk >= 2)
    (players-unit-type-count target-player monk >= 1)
    (up-compare-goal bt-research-monk-atonement-retry-goal < bt-monk-research-max-retries)
    (up-compare-goal bt-research-monastery-failure-backoff-goal != ri-atonement)
    (up-research-status c: ri-atonement < research-complete)
    (research-available ri-atonement)
=>
    (set-goal bt-research-monk-package-goal ri-atonement)
)
(defrule
    (goal bt-research-monk-package-goal 0)
    (goal bt-monk-demand-goal 1)
    (unit-type-count-total monk >= 2)
    (or
        (players-unit-type-count target-player mangonel-line >= 1)
        (or
            (players-unit-type-count target-player scorpion-line >= 1)
            (or
                (players-unit-type-count target-player battering-ram-line >= 1)
                (or
                    (players-unit-type-count target-player siege-tower >= 1)
                    (or
                        (players-unit-type-count target-player bombard-cannon-line >= 1)
                        (players-unit-type-count target-player trebuchet-set >= 1)
                    )
                )
            )
        )
    )
    (or
        (players-unit-type-count target-player monk < 1)
        (or
        (up-research-status c: ri-atonement == research-complete)
        (up-compare-goal bt-research-monk-atonement-retry-goal >= bt-monk-research-max-retries)
            )
    )
    (up-compare-goal bt-research-monk-redemption-retry-goal < bt-monk-research-max-retries)
    (up-compare-goal bt-research-monastery-failure-backoff-goal != ri-redemption)
    (up-research-status c: ri-redemption < research-complete)
    (research-available ri-redemption)
=>
    (set-goal bt-research-monk-package-goal ri-redemption)
)
(defrule
    (goal bt-research-monk-package-goal 0)
    (goal bt-monk-demand-goal 1)
    (unit-type-count-total monk >= 2)
    (or
        (players-unit-type-count target-player monk < 1)
        (or
        (up-research-status c: ri-atonement == research-complete)
        (up-compare-goal bt-research-monk-atonement-retry-goal >= bt-monk-research-max-retries)
            )
    )
    (or
        (and
            (players-unit-type-count target-player mangonel-line < 1)
            (and
            (players-unit-type-count target-player scorpion-line < 1)
            (and
            (players-unit-type-count target-player battering-ram-line < 1)
            (and
            (players-unit-type-count target-player siege-tower < 1)
            (and
            (players-unit-type-count target-player bombard-cannon-line < 1)
            (players-unit-type-count target-player trebuchet-set < 1)
                    )
                    )
                    )
                    )
        )
        (or
        (up-research-status c: ri-redemption == research-complete)
        (up-compare-goal bt-research-monk-redemption-retry-goal >= bt-monk-research-max-retries)
            )
    )
    (up-compare-goal bt-research-monk-sanctity-retry-goal < bt-monk-research-max-retries)
    (up-compare-goal bt-research-monastery-failure-backoff-goal != ri-sanctity)
    (up-research-status c: ri-sanctity < research-complete)
    (research-available ri-sanctity)
=>
    (set-goal bt-research-monk-package-goal ri-sanctity)
)
(defrule
    (goal bt-research-monk-package-goal 0)
    (goal bt-monk-demand-goal 1)
    (current-age >= imperial-age)
    (unit-type-count-total monk >= 4)
    (or
        (players-unit-type-count target-player mangonel-line >= 1)
        (or
            (players-unit-type-count target-player bombard-cannon-line >= 1)
            (players-unit-type-count target-player trebuchet-set >= 1)
        )
    )
    (up-research-status c: ri-redemption == research-complete)
    (or
        (up-research-status c: ri-sanctity == research-complete)
        (up-compare-goal bt-research-monk-sanctity-retry-goal >= bt-monk-research-max-retries)
    )
    (up-compare-goal bt-research-monk-block-printing-retry-goal < bt-monk-research-max-retries)
    (up-compare-goal bt-research-monastery-failure-backoff-goal != ri-block-printing)
    (up-research-status c: ri-block-printing < research-complete)
    (research-available ri-block-printing)
=>
    (set-goal bt-research-monk-package-goal ri-block-printing)
)
; Monk retry budgets reset only when their operational reason disappears.
; Active research claims retain their failure history until the transaction
; completes or capability-loss recovery explicitly releases the claim.
(defrule
    (goal bt-monk-demand-goal 0)
    (goal bt-research-monastery-claim-goal 0)
=>
    (set-goal bt-research-monk-atonement-retry-goal 0)
    (set-goal bt-research-monk-redemption-retry-goal 0)
    (set-goal bt-research-monk-sanctity-retry-goal 0)
    (set-goal bt-research-monk-block-printing-retry-goal 0)
)
(defrule
    (players-unit-type-count target-player monk < 1)
    (goal bt-research-monastery-claim-goal 0)
=>
    (set-goal bt-research-monk-atonement-retry-goal 0)
)
(defrule
    (players-unit-type-count target-player mangonel-line < 1)
    (players-unit-type-count target-player scorpion-line < 1)
    (players-unit-type-count target-player battering-ram-line < 1)
    (players-unit-type-count target-player siege-tower < 1)
    (players-unit-type-count target-player bombard-cannon-line < 1)
    (players-unit-type-count target-player trebuchet-set < 1)
    (goal bt-research-monastery-claim-goal 0)
=>
    (set-goal bt-research-monk-redemption-retry-goal 0)
)
(defrule
    (current-age >= imperial-age)
    (unit-type-count-total monk < 4)
    (goal bt-research-monastery-claim-goal 0)
=>
    (set-goal bt-research-monk-block-printing-retry-goal 0)
)
(defrule
    (current-age >= imperial-age)
    (players-unit-type-count target-player mangonel-line < 1)
    (players-unit-type-count target-player bombard-cannon-line < 1)
    (players-unit-type-count target-player trebuchet-set < 1)
    (goal bt-research-monastery-claim-goal 0)
=>
    (set-goal bt-research-monk-block-printing-retry-goal 0)
)

(defrule
    (goal bt-research-monk-package-goal ri-atonement)
    (up-research-status c: ri-atonement == research-complete)
=>
    (set-goal bt-research-monk-atonement-retry-goal 0)
    (set-goal bt-research-monk-package-goal 0)
)
(defrule
    (goal bt-research-monk-package-goal ri-redemption)
    (up-research-status c: ri-redemption == research-complete)
=>
    (set-goal bt-research-monk-redemption-retry-goal 0)
    (set-goal bt-research-monk-package-goal 0)
)
(defrule
    (goal bt-research-monk-package-goal ri-sanctity)
    (up-research-status c: ri-sanctity == research-complete)
=>
    (set-goal bt-research-monk-sanctity-retry-goal 0)
    (set-goal bt-research-monk-package-goal 0)
)
(defrule
    (goal bt-research-monk-package-goal ri-block-printing)
    (up-research-status c: ri-block-printing == research-complete)
=>
    (set-goal bt-research-monk-block-printing-retry-goal 0)
    (set-goal bt-research-monk-package-goal 0)
)
(defrule
    (up-compare-goal bt-research-monk-package-goal != 0)
    (goal bt-monk-demand-goal 0)
=>
    (set-goal bt-research-monk-package-goal 0)
)
; RESEARCH PACKAGE PRIORITY
;================================================================
; Package goal value:
;   0     = inactive
;   ri-*  = persistent technology cursor
; The cursor follows the existing Shadow progression-pause idea without
; introducing a universal scheduler. Existing research rules remain the
; executor and retain escrow, age, prerequisite, and failure gates.

; CAVALRY COUNTER PACKAGE
(defrule
    (goal bt-research-cavalry-counter-package-goal 0)
    (up-compare-goal bt-research-blacksmith-scale-mail-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-scale-mail)
    (up-compare-goal bt-cavalry-counter-level-goal >= 1)
    (up-research-status c: ri-scale-mail < research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-scale-mail)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal 0)
    (up-compare-goal bt-cavalry-counter-level-goal >= 1)
    (up-research-status c: ri-scale-mail == research-complete)
    (up-compare-goal bt-research-blacksmith-chain-mail-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-chain-mail)
    (up-research-status c: ri-chain-mail < research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-chain-mail)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal 0)
    (up-compare-goal bt-cavalry-counter-level-goal >= 1)
    (up-research-status c: ri-scale-mail == research-complete)
    (up-research-status c: ri-chain-mail == research-complete)
    (current-age >= castle-age)
    (up-research-status c: ri-pikeman < research-complete)
    (up-compare-goal bt-research-barracks-pikeman-retry-goal < bt-research-barracks-max-retries)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-pikeman)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal 0)
    (goal bt-halberdier-demand-goal 1)
    (up-research-status c: ri-pikeman == research-complete)
    (up-research-status c: ri-halberdier < research-complete)
    (up-compare-goal bt-research-barracks-halberdier-retry-goal < bt-research-barracks-max-retries)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-halberdier)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal 0)
    (up-compare-goal bt-cavalry-counter-level-goal >= 2)
    (current-age >= imperial-age)
    (up-compare-goal bt-standing-spear-target-goal >= bt-spear-target-2)
    (up-research-status c: ri-halberdier == research-complete)
    (up-compare-goal bt-research-blacksmith-plate-mail-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-plate-mail)
    (up-research-status c: ri-plate-mail < research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-plate-mail)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal ri-scale-mail)
    (up-research-status c: ri-scale-mail == research-complete)
    (up-compare-goal bt-research-blacksmith-chain-mail-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-chain-mail)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-chain-mail)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal ri-chain-mail)
    (up-research-status c: ri-chain-mail == research-complete)
    (current-age >= castle-age)
    (up-research-status c: ri-pikeman < research-complete)
    (up-compare-goal bt-research-barracks-pikeman-retry-goal < bt-research-barracks-max-retries)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-pikeman)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal ri-pikeman)
    (up-research-status c: ri-pikeman == research-complete)
    (goal bt-halberdier-demand-goal 1)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-halberdier)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal ri-halberdier)
    (up-research-status c: ri-halberdier == research-complete)
    (current-age >= imperial-age)
    (up-compare-goal bt-cavalry-counter-level-goal >= 2)
    (up-compare-goal bt-standing-spear-target-goal >= bt-spear-target-2)
    (up-compare-goal bt-research-blacksmith-plate-mail-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-plate-mail)
    (up-research-status c: ri-plate-mail < research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal ri-plate-mail)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal ri-plate-mail)
    (up-research-status c: ri-plate-mail == research-complete)
=>
    (set-goal bt-research-cavalry-counter-package-goal 0)
)
(defrule
    (up-compare-goal bt-research-cavalry-counter-package-goal != 0)
    (up-compare-goal bt-cavalry-counter-level-goal < 1)
    (goal bt-cavalry-threat-goal 0)
    (goal bt-halberdier-demand-goal 0)
=>
    (set-goal bt-research-cavalry-counter-package-goal 0)
)

; RANGED COUNTER / RANGED ROLE PACKAGE
;----------------------------------------------------------------
; Package selection is strategic policy only. Reliability state is read
; here as an availability constraint; it is never written here.
;
; Counter branch:
;   active enemy ranged threat -> real Skirmisher response.
; Boom branch:
;   explicit Crossbow role -> Crossbow/Bodkin/Thumb Ring.
; Defensive armor:
;   only while a real ranged army and the corresponding threat/role remain.
;
; Crossbow/Arbalest/Thumb Ring are deliberately isolated from the generic
; ranged-threat branch. Enemy archers do not, by themselves, authorize the
; gold-heavy Crossbow line. Byzantines answer the immediate ranged threat
; with the discounted Skirmisher line unless a separate Crossbow role has
; been established.

; FLETCHING: establish a real ranged response package.
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (goal bt-ranged-threat-goal 1)
    (or
        (and
            (up-compare-goal bt-standing-archer-target-goal > 0)
            (unit-type-count-total archer-line >= 3)
        )
        (and
            (up-compare-goal bt-standing-skirm-target-goal > 0)
            (unit-type-count-total skirmisher-line >= 3)
        )
    )
    (up-compare-goal bt-research-blacksmith-fletching-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-fletching)
    (up-research-status c: ri-fletching < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-fletching)
)

; CROSSBOW: separate Castle BOOM ranged-role branch.
; It cannot activate from enemy ranged threat because the standing
; Crossbow role is explicitly a no-immediate-threat investment.
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (goal bt-crossbow-demand-goal 1)
    (goal bt-arbalest-demand-goal 0)
    (goal strategy-goal bt-strategy-boom)
    (goal bt-any-threat-goal 0)
    (goal bt-ranged-threat-goal 0)
    (current-age >= castle-age)
    (up-compare-goal bt-standing-crossbow-target-goal > 0)
    (up-research-status c: ri-fletching == research-complete)
    (up-compare-goal bt-research-archery-range-crossbow-retry-goal < bt-archery-range-research-max-retries)
    (up-compare-goal bt-research-archery-range-failure-backoff-goal != ri-crossbow)
    (up-research-status c: ri-crossbow < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-crossbow)
)

; ELITE SKIRMISHER: primary Byzantine counter branch.
; Crossbow demand must be absent so the two strategic branches cannot
; simultaneously claim the same package slot.
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (goal bt-ranged-threat-goal 1)
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (current-age >= castle-age)
    (up-compare-goal bt-ranged-counter-level-goal >= 1)
    (not (and
             (goal strategy-goal bt-strategy-boom)
             (and
             (goal bt-any-threat-goal 0)
             (up-compare-goal bt-standing-crossbow-target-goal > 0)
                      )
         ))
    (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-1)
    (unit-type-count-total skirmisher-line >= bt-skirm-target-1)
    (up-compare-goal bt-research-archery-range-elite-skirmisher-retry-goal < bt-archery-range-research-max-retries)
    (up-compare-goal bt-research-archery-range-failure-backoff-goal != ri-elite-skirmisher)
    (up-research-status c: ri-elite-skirmisher < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-elite-skirmisher)
)

; FLETCHING -> CROSSBOW: retain the explicit Castle BOOM role after
; the prerequisite completes.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-fletching)
    (goal bt-crossbow-demand-goal 1)
    (goal bt-arbalest-demand-goal 0)
    (goal strategy-goal bt-strategy-boom)
    (goal bt-any-threat-goal 0)
    (goal bt-ranged-threat-goal 0)
    (current-age >= castle-age)
    (up-research-status c: ri-fletching == research-complete)
    (up-compare-goal bt-standing-crossbow-target-goal > 0)
    (up-compare-goal bt-research-archery-range-crossbow-retry-goal < bt-archery-range-research-max-retries)
    (up-compare-goal bt-research-archery-range-failure-backoff-goal != ri-crossbow)
    (up-research-status c: ri-crossbow < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-crossbow)
)

; FLETCHING -> ELITE SKIRMISHER: primary Byzantine ranged counter.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-fletching)
    (goal bt-ranged-threat-goal 1)
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (current-age >= castle-age)
    (up-research-status c: ri-fletching == research-complete)
    (not (and
             (goal strategy-goal bt-strategy-boom)
             (and
             (goal bt-any-threat-goal 0)
             (up-compare-goal bt-standing-crossbow-target-goal > 0)
                      )
         ))
    (up-compare-goal bt-ranged-counter-level-goal >= 1)
    (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-1)
    (unit-type-count-total skirmisher-line >= bt-skirm-target-1)
    (up-compare-goal bt-research-archery-range-elite-skirmisher-retry-goal < bt-archery-range-research-max-retries)
    (up-compare-goal bt-research-archery-range-failure-backoff-goal != ri-elite-skirmisher)
    (up-research-status c: ri-elite-skirmisher < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-elite-skirmisher)
)

; FLETCHING -> PADDED ARMOR: defensive support when the primary counter
; branch does not own the package.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-fletching)
    (goal bt-ranged-threat-goal 1)
    (goal bt-crossbow-demand-goal 0)
    (up-research-status c: ri-fletching == research-complete)
    (or
        (and
            (up-compare-goal bt-standing-archer-target-goal > 0)
            (unit-type-count-total archer-line >= 3)
        )
        (and
            (up-compare-goal bt-standing-skirm-target-goal > 0)
            (unit-type-count-total skirmisher-line >= 3)
        )
    )
    (up-compare-goal bt-research-blacksmith-padded-archer-armor-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-padded-archer-armor)
    (up-research-status c: ri-padded-archer-armor < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-padded-archer-armor)
)

; BODKIN SUPPORT FROM CROSSBOW.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-crossbow)
    (up-research-status c: ri-crossbow == research-complete)
    (or
        (and
            (goal unit-goal crossbowman)
            (or
                (unit-type-count-total crossbowman >= bt-crossbow-target-castle)
                (unit-type-count-total arbalester >= bt-crossbow-target-castle)
            )
        )
        (or
        (and
            (goal bt-ranged-threat-goal 1)
            (and
            (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-1)
            (unit-type-count-total skirmisher-line >= bt-skirm-target-1)
                    )
        )
        (and
            (goal bt-ranged-threat-goal 1)
            (and
            (up-compare-goal bt-standing-archer-target-goal >= 3)
            (unit-type-count-total archer-line >= 3)
                    )
        )
            )
    )
    (up-compare-goal bt-research-blacksmith-bodkin-arrow-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-bodkin-arrow)
    (up-research-status c: ri-bodkin-arrow < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-bodkin-arrow)
)

; BODKIN SUPPORT FROM ELITE SKIRMISHER.
; Bodkin is a prerequisite for Bracer in the existing executor, so do not
; allow the Elite -> Bracer edge to strand the package behind a missing
; prerequisite.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-elite-skirmisher)
    (up-research-status c: ri-elite-skirmisher == research-complete)
    (goal bt-ranged-threat-goal 1)
    (current-age >= castle-age)
    (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-1)
    (unit-type-count-total skirmisher-line >= bt-skirm-target-1)
    (up-compare-goal bt-research-blacksmith-bodkin-arrow-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-bodkin-arrow)
    (up-research-status c: ri-bodkin-arrow < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-bodkin-arrow)
)

; ELITE -> BRACER when Bodkin already exists.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-elite-skirmisher)
    (up-research-status c: ri-elite-skirmisher == research-complete)
    (goal bt-ranged-threat-goal 1)
    (current-age >= imperial-age)
    (up-research-status c: ri-bodkin-arrow == research-complete)
    (or
        (and
            (goal unit-goal crossbowman)
            (and
            (up-research-status c: ri-arbalest == research-complete)
            (unit-type-count-total arbalester >= bt-crossbow-target-mature)
                    )
        )
        (or
        (and
            (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-2)
            (and
            (unit-type-count-total skirmisher-line >= bt-skirm-target-2)
            (up-compare-goal bt-ranged-counter-level-goal >= 2)
                    )
        )
        (unit-type-count-total cavalry-archer >= 6)
            )
    )
    (up-compare-goal bt-research-blacksmith-bracer-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-bracer)
    (up-research-status c: ri-bracer < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-bracer)
)

; BRACER: mature ranged army, active ranged threat, and Bodkin already
; available/completed. Elite completion alone is not strategic authority.
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (goal bt-ranged-threat-goal 1)
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (current-age >= imperial-age)
    (up-research-status c: ri-bodkin-arrow == research-complete)
    (not (and
             (up-compare-goal bt-ranged-counter-level-goal >= 1)
             (and
             (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-2)
             (and
             (unit-type-count-total skirmisher-line >= bt-skirm-target-2)
             (up-research-status c: ri-elite-skirmisher < research-complete)
                      )
                      )
         ))
    (and
            (goal unit-goal crossbowman)
            (and
            (up-research-status c: ri-arbalest == research-complete)
            (unit-type-count-total arbalester >= bt-crossbow-target-mature)
                    )
        )
    (up-compare-goal bt-research-blacksmith-bracer-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-bracer)
    (up-research-status c: ri-bracer < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-bracer)
)
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (goal bt-ranged-threat-goal 1)
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (current-age >= imperial-age)
    (up-research-status c: ri-bodkin-arrow == research-complete)
    (not (and
             (up-compare-goal bt-ranged-counter-level-goal >= 1)
             (and
             (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-2)
             (and
             (unit-type-count-total skirmisher-line >= bt-skirm-target-2)
             (up-research-status c: ri-elite-skirmisher < research-complete)
                      )
                      )
         ))
    (or
        (and
            (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-2)
            (and
            (unit-type-count-total skirmisher-line >= bt-skirm-target-2)
            (up-compare-goal bt-ranged-counter-level-goal >= 2)
                    )
        )
        (and
            (unit-type-count-total cavalry-archer >= 6)
            (goal bt-ranged-threat-goal 1)
        )
            )
    (up-compare-goal bt-research-blacksmith-bracer-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-bracer)
    (up-research-status c: ri-bracer < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-bracer)
)

; BRACER AFTER BODKIN / ELITE.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-bodkin-arrow)
    (up-research-status c: ri-bodkin-arrow == research-complete)
    (goal bt-ranged-threat-goal 1)
    (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-2)
    (unit-type-count-total skirmisher-line >= bt-skirm-target-2)
    (up-compare-goal bt-ranged-counter-level-goal >= 2)
    (current-age >= imperial-age)
    (up-compare-goal bt-research-blacksmith-bracer-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-bracer)
    (up-research-status c: ri-bracer < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-bracer)
)

; PADDED ARCHER ARMOR: defensive support for an actual ranged response.
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (goal bt-ranged-threat-goal 1)
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (not (and
             (current-age >= castle-age)
             (and
             (up-compare-goal bt-ranged-counter-level-goal >= 1)
             (and
             (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-1)
             (unit-type-count-total skirmisher-line >= bt-skirm-target-1)
                      )
                      )
         ))
    (up-research-status c: ri-fletching == research-complete)
    (or
        (and
            (up-compare-goal bt-standing-archer-target-goal > 0)
            (unit-type-count-total archer-line >= 3)
        )
        (and
            (up-compare-goal bt-standing-skirm-target-goal > 0)
            (unit-type-count-total skirmisher-line >= 3)
        )
    )
    (up-compare-goal bt-research-blacksmith-padded-archer-armor-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-padded-archer-armor)
    (up-research-status c: ri-padded-archer-armor < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-padded-archer-armor)
)

; Padded -> Leather only while the ranged threat and army remain.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-padded-archer-armor)
    (up-research-status c: ri-padded-archer-armor == research-complete)
    (goal bt-ranged-threat-goal 1)
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (or
        (and
            (up-compare-goal bt-standing-archer-target-goal > 0)
            (unit-type-count-total archer-line >= 3)
        )
        (and
            (up-compare-goal bt-standing-skirm-target-goal > 0)
            (unit-type-count-total skirmisher-line >= 3)
        )
    )
    (current-age >= castle-age)
    (up-compare-goal bt-research-blacksmith-leather-archer-armor-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-leather-archer-armor)
    (up-research-status c: ri-leather-archer-armor < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-leather-archer-armor)
)

; Leather -> Ring only for an established late ranged army.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-leather-archer-armor)
    (up-research-status c: ri-leather-archer-armor == research-complete)
    (goal bt-ranged-threat-goal 1)
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (not (and
        (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-2)
        (unit-type-count-total skirmisher-line >= bt-skirm-target-2)
    ))
    (current-age >= imperial-age)
    (or
        (and
            (goal unit-goal crossbowman)
            (and
            (up-research-status c: ri-arbalest == research-complete)
            (unit-type-count-total arbalester >= bt-crossbow-target-mature)
                    )
        )
        (or
        (and
            (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-2)
            (unit-type-count-total skirmisher-line >= bt-skirm-target-2)
        )
        (unit-type-count-total cavalry-archer >= 6)
            )
    )
    (up-compare-goal bt-research-blacksmith-ring-archer-armor-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-ring-archer-armor)
    (up-research-status c: ri-ring-archer-armor < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-ring-archer-armor)
)

; THUMB RING: Castle BOOM ranged support, not a counter response.
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (goal strategy-goal bt-strategy-boom)
    (goal bt-any-threat-goal 0)
    (goal bt-ranged-threat-goal 0)
    (goal bt-crossbow-demand-goal 0)
    (goal bt-arbalest-demand-goal 0)
    (goal unit-goal crossbowman)
    (current-age >= castle-age)
    (building-type-count archery-range >= 1)
    (building-type-count university >= 1)
    (goal bt-resource-mode-goal bt-resource-mode-castle-boom)
    (up-research-status c: ri-crossbow == research-complete)
    (or
        (unit-type-count-total crossbowman >= bt-crossbow-target-castle)
        (unit-type-count-total arbalester >= bt-crossbow-target-castle)
    )
    (up-compare-goal bt-research-university-thumb-ring-retry-goal < bt-university-research-max-retries)
    (up-compare-goal bt-research-university-failure-backoff-goal != ri-thumb-ring)
    (up-research-status c: ri-thumb-ring < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-thumb-ring)
)

; ARBALEST: Imperial primary ranged-line branch only.
(defrule
    (goal bt-research-ranged-counter-package-goal 0)
    (goal bt-arbalest-demand-goal 1)
    (goal bt-crossbow-demand-goal 0)
    (goal strategy-goal bt-strategy-boom)
    (goal bt-any-threat-goal 0)
    (goal bt-ranged-threat-goal 0)
    (goal unit-goal crossbowman)
    (current-age >= imperial-age)
    (up-research-status c: ri-crossbow == research-complete)
    (unit-type-count-total crossbowman >= bt-crossbow-target-mature)
    (up-compare-goal bt-research-archery-range-arbalest-retry-goal < bt-archery-range-research-max-retries)
    (up-compare-goal bt-research-archery-range-failure-backoff-goal != ri-arbalest)
    (up-research-status c: ri-arbalest < research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal ri-arbalest)
)

; Crossbow -> Bodkin terminal release.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-bodkin-arrow)
    (up-research-status c: ri-bodkin-arrow == research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; Bracer is terminal after completion.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-bracer)
    (up-research-status c: ri-bracer == research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; Thumb Ring is terminal after completion.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-thumb-ring)
    (up-research-status c: ri-thumb-ring == research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; Arbalest is terminal after completion.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-arbalest)
    (up-research-status c: ri-arbalest == research-complete)
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; Counter branch cancellation: enemy ranged threat disappeared.
(defrule
    (or
        (goal bt-research-ranged-counter-package-goal ri-fletching)
        (or
        (goal bt-research-ranged-counter-package-goal ri-elite-skirmisher)
        (or
        (goal bt-research-ranged-counter-package-goal ri-padded-archer-armor)
        (or
        (goal bt-research-ranged-counter-package-goal ri-leather-archer-armor)
        (or
        (goal bt-research-ranged-counter-package-goal ri-ring-archer-armor)
        (goal bt-research-ranged-counter-package-goal ri-bracer)
            )
            )
            )
            )
    )
    (goal bt-ranged-threat-goal 0)
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; Crossbow package cancellation: its explicit Boom demand disappeared or
; an immediate enemy threat made the Boom investment strategically obsolete.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-crossbow)
    (or
        (goal bt-crossbow-demand-goal 0)
        (goal bt-any-threat-goal 1)
    )
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; Arbalest package cancellation: the primary Crossbow role is no longer a
; valid no-threat Boom investment.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-arbalest)
    (or
        (goal bt-arbalest-demand-goal 0)
        (or
        (goal bt-any-threat-goal 1)
        (or
        (goal strategy-goal bt-strategy-flush)
        (goal strategy-goal bt-strategy-rush)
            )
            )
    )
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

; Thumb Ring package cancellation: preserve only the Castle BOOM role.
(defrule
    (goal bt-research-ranged-counter-package-goal ri-thumb-ring)
    (or
        (goal bt-any-threat-goal 1)
        (or
        (goal strategy-goal bt-strategy-flush)
        (or
        (goal strategy-goal bt-strategy-rush)
        (up-compare-goal bt-resource-mode-goal != bt-resource-mode-castle-boom)
            )
            )
    )
=>
    (set-goal bt-research-ranged-counter-package-goal 0)
)

