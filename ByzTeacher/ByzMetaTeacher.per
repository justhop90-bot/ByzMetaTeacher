    (set-goal bt-tc-stage-goal bt-tc-stage-blocked)
    (enable-timer bt-tc2-watchdog-timer bt-tc-retry-3-seconds)
)

(defrule
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
    (timer-triggered bt-tc2-watchdog-timer)
    (building-type-count-total town-center < 2)
    (strategic-number sn-resource-control == bt-tc2-claim)
    (goal bt-tc-retry-goal 3)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-tc-failure-goal bt-tc-failure-project-invalid)
    (set-goal bt-tc-retry-goal 4)
    (set-goal bt-tc-stage-goal bt-tc-stage-blocked)
    (enable-timer bt-tc2-watchdog-timer bt-tc-retry-4-seconds)
)

(defrule
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-blocked)
    (goal bt-tc-retry-goal 4)
    (timer-triggered bt-tc2-watchdog-timer)
    (or
        (not (goal strategy-goal bt-strategy-boom))
        (building-type-count town-center >= 2)
    )
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-goal bt-tc-project-goal 0)
    (set-goal bt-tc-stage-goal 0)
    (set-goal bt-tc-retry-goal 0)
    (set-goal bt-tc-failure-goal 0)
)

(defrule
    (goal bt-tc-project-goal 0)
    (goal bt-tc-stage-goal bt-tc-stage-idle)
    (goal bt-tc-failure-goal bt-tc-failure-none)
    (goal strategy-goal bt-strategy-boom)
    (current-age >= castle-age)
    (unit-type-count villager >= 45)
    (food-amount >= 500)
    (wood-amount >= 300)
    (building-type-count town-center >= 2)
    (building-type-count-total town-center < 3)
=>
    (set-goal bt-tc-project-goal 3)
    (set-goal bt-tc-stage-goal bt-tc-stage-demanded)
    (set-goal bt-tc-retry-goal 0)
    (set-goal bt-tc-failure-goal bt-tc-failure-none)
)

(defrule
    (goal bt-tc-project-goal 3)
    (goal bt-tc-stage-goal bt-tc-stage-demanded)
    (goal bt-tc-failure-goal bt-tc-failure-none)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total town-center < 3)
    (can-build-with-escrow town-center)
=>
    (set-strategic-number sn-resource-control bt-tc3-claim)
    (release-escrow food)
    (release-escrow wood)
    (set-goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
    (enable-timer bt-tc3-watchdog-timer bt-tc-watchdog-seconds)
)

(defrule
    (goal bt-tc-project-goal 3)
    (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
    (strategic-number sn-resource-control == bt-tc3-claim)
    (building-type-count town-center >= 2)
    (building-type-count-total town-center < 3)
    (goal bt-tc-retry-goal 0)
    (not (up-pending-placement c: town-center))
    (can-afford-building town-center-foundation)
    (can-build town-center)
=>
    (set-strategic-number sn-placement-to-center 1)
    (set-strategic-number sn-placement-zone-size bt-tc-placement-zone-size)
    (set-strategic-number sn-placement-fail-delta 0)
    (up-set-placement-data my-player-number -1 c: bt-tc-placement-distance)
    (up-assign-builders c: town-center-foundation c: bt-tc-builder-count)
    (up-build place-control 0 c: town-center)
    (set-goal bt-tc-stage-goal bt-tc-stage-placement-pending)
)

; TC3 fallback placement:
; The primary home-TC anchor has already failed and the project has
; entered the existing bounded retry path. Use the latest completed
; own Town Center as the next placement anchor.
(defrule
    (goal bt-tc-project-goal 3)
    (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
    (strategic-number sn-resource-control == bt-tc3-claim)
    (building-type-count town-center >= 2)
    (building-type-count-total town-center < 3)
    (up-compare-goal bt-tc-retry-goal >= 1)
    (not (up-pending-placement c: town-center))
    (can-afford-building town-center-foundation)
    (can-build town-center)
=>
    (set-strategic-number sn-placement-to-center 1)
    (set-strategic-number sn-placement-zone-size bt-tc-placement-zone-size)
    (set-strategic-number sn-placement-fail-delta 0)
    (up-set-placement-data my-player-number town-center c: bt-tc-placement-distance)
    (up-assign-builders c: town-center-foundation c: bt-tc-builder-count)
    (up-build place-control 0 c: town-center)
    (set-goal bt-tc-stage-goal bt-tc-stage-placement-pending)
)

(defrule
    (goal bt-tc-project-goal 3)
    (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
    (building-type-count-total town-center >= 3)
    (building-type-count town-center < 3)
=>
    (disable-timer bt-tc3-watchdog-timer)
    (enable-timer bt-tc3-watchdog-timer bt-tc-watchdog-seconds)
    (set-goal bt-tc-stage-goal bt-tc-stage-foundation-active)
)

(defrule
    (goal bt-tc-project-goal 3)
    (building-type-count town-center >= 3)
    (strategic-number sn-resource-control == bt-tc3-claim)
=>
    (disable-timer bt-tc3-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-tc-project-goal 3)
    (building-type-count town-center >= 3)
=>
    (disable-timer bt-tc3-watchdog-timer)
    (set-goal bt-tc-project-goal 0)
    (set-goal bt-tc-stage-goal 0)
    (set-goal bt-tc-retry-goal 0)
    (set-goal bt-tc-failure-goal 0)
)

(defrule
    (goal bt-tc-project-goal 3)
    (or (goal bt-tc-stage-goal bt-tc-stage-demanded) (or (or
            (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
            (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
        ) (and (goal bt-tc-stage-goal bt-tc-stage-blocked) (and (up-compare-goal bt-tc-retry-goal > 0) (or
                (goal bt-tc-failure-goal bt-tc-failure-project-invalid)
                (goal bt-tc-failure-goal bt-tc-failure-placement-timeout)
            )))))
    (not (goal strategy-goal bt-strategy-boom))
    (building-type-count-total town-center < 3)
    (or
        (strategic-number sn-resource-control == 0)
        (strategic-number sn-resource-control == bt-tc3-claim)
    )
=>
    (disable-timer bt-tc3-watchdog-timer)
    (up-reset-placement c: town-center)
    (set-goal bt-tc-failure-goal bt-tc-failure-none)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-tc-project-goal 0)
    (set-goal bt-tc-stage-goal 0)
    (set-goal bt-tc-retry-goal 0)
)

