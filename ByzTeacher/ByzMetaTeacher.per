;================================================================
; 14E. DOUBLE-BIT AXE DEMAND
;================================================================
;
; DBA demand is an explicit Feudal wood-productivity investment.
; The predicate uses only existing world state plus fixed tuning buffers:
;   - Feudal age
;   - 900 food
;   - 225 wood
;   - Castle is not immediately researchable
;   - technology is still available
;
; The demand signal does not own sn-resource-control. The existing
; research lifecycle below remains the only claim/action authority.
(defrule
    (goal bt-double-bit-axe-demand-goal 0)
    (current-age == feudal-age)
    (up-research-status c: ri-double-bit-axe == research-available)
    (food-amount >= bt-double-bit-axe-food-buffer)
    (wood-amount >= bt-double-bit-axe-wood-buffer)
    (not (can-research-with-escrow castle-age))
=>
    (set-goal bt-double-bit-axe-demand-goal 1)
)

; Demand release is allowed to clear only when no DBA claim owns the
; shared resource register. An active DBA research attempt stays alive
; until completion or watchdog recovery.
(defrule
    (goal bt-double-bit-axe-demand-goal 1)
    (strategic-number sn-resource-control != ri-double-bit-axe)
    (or
        (current-age != feudal-age)
        (not (food-amount >= bt-double-bit-axe-food-buffer))
        (not (wood-amount >= bt-double-bit-axe-wood-buffer))
        (can-research-with-escrow castle-age)
        (up-research-status c: ri-double-bit-axe >= research-pending)
    )
=>
    (set-goal bt-double-bit-axe-demand-goal 0)
)

;================================================================
; 14E-B. DOUBLE-BIT AXE RESEARCH LIFECYCLE
;================================================================
;
; Existing claim -> escrow -> watchdog -> research -> completion
; control remains authoritative. Demand never performs the action.
(defrule
    (goal bt-double-bit-axe-demand-goal 1)
    (current-age == feudal-age)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow castle-age))
    (can-research-with-escrow ri-double-bit-axe)
=>
    (set-strategic-number sn-resource-control ri-double-bit-axe)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-double-bit-axe)
)

(defrule
    (strategic-number sn-resource-control == ri-double-bit-axe)
    (up-research-status c: ri-double-bit-axe == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-double-bit-axe-demand-goal 0)
)

;================================================================
; 14E. GOLD MINING DEMAND
;================================================================
;
; Gold Mining is downstream of SUSTAINED premium-gold demand.
;
; "Sustained" means an existing gold-paying consumer remains active:
;   - Cataphract demand
;   - existing Castle mixed-composition Camel demand
;
; It is NOT driven by:
;   - low gold stockpile
;   - Castle Age by itself
;   - an age-up gold bank
;   - the resource allocator inventing a new strategy
;
; Imperial-age preparation is explicitly excluded while the age is
; researchable. The existing age-up rule remains the only authority
; that spends the bank for the age transition.
;
; This is a technology-demand state. It creates no strategy, unit-goal,
; Cataphract demand, or resource claim.
;
; Initial value is established once in section 2 initialization.
; This section owns only demand/release transitions.
;
; Existing premium consumer -> Gold Mining demand.
(defrule
    (current-age >= castle-age)
    (or
        (goal bt-cataphract-demand-goal 1)
        (and
            (goal strategy-goal bt-strategy-flush)
            (goal unit-goal bt-unit-mix)
            (unit-type-count-total spearman-line >= bt-spear-target-1)
            (up-compare-goal bt-noncav-cavalry-level-goal >= 1)
            (building-type-count-total stable >= 1)
            (unit-type-count-total camel-line < bt-camel-target-1)
        )
    )
    (research-available ri-gold-mining)
    (not (can-research-with-escrow imperial-age))
    (strategic-number sn-resource-control != imperial-age)
=>
    (set-goal bt-gold-mining-demand-goal 1)
)

; When premium demand disappears, the technology-demand signal clears.
; An active Gold Mining claim keeps the demand alive until completion or
; watchdog recovery. The demand layer never cancels research.
(defrule
    (goal bt-gold-mining-demand-goal 1)
    (strategic-number sn-resource-control != ri-gold-mining)
    (or
        (can-research-with-escrow imperial-age)
        (strategic-number sn-resource-control == imperial-age)
        (not
            (or
                (goal bt-cataphract-demand-goal 1)
                (and
                    (current-age >= castle-age)
                    (goal strategy-goal bt-strategy-flush)
                    (goal unit-goal bt-unit-mix)
                    (unit-type-count-total spearman-line >= bt-spear-target-1)
                    (up-compare-goal bt-noncav-cavalry-level-goal >= 1)
                    (building-type-count-total stable >= 1)
                    (unit-type-count-total camel-line < bt-camel-target-1)
                )
            )
        )
    )
=>
    (set-goal bt-gold-mining-demand-goal 0)
)

;================================================================
; 14F. GOLD MINING RESEARCH LIFECYCLE
;================================================================
;
; Existing sn-resource-control arbitration remains authoritative.
; can-research-with-escrow remains the final research feasibility gate.
(defrule
    (goal bt-gold-mining-demand-goal 1)
    (current-age >= feudal-age)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow feudal-age))
    (not (can-research-with-escrow castle-age))
    (not (can-research-with-escrow imperial-age))
    (can-research-with-escrow ri-gold-mining)
=>
    (set-strategic-number sn-resource-control ri-gold-mining)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-gold-mining)
)

; Completion witness releases only the Gold Mining claim.
(defrule
    (strategic-number sn-resource-control == ri-gold-mining)
    (up-research-status c: ri-gold-mining == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-gold-mining-demand-goal 0)
)

;================================================================
; 14G. WHEELBARROW DEMAND / RESEARCH LIFECYCLE
;================================================================
;
; Wheelbarrow is downstream of the existing mature Castle BOOM state.
; The demand writer is deliberately conservative: three Town Centers
; and the existing 12-farm Castle ceiling prove that the controller's
; current TC/farm expansion program has reached its intended BOOM
; maturity. Immediate Imperial feasibility retains priority.
;
; The demand is a state, not the research action. The existing shared
; sn-resource-control mutex remains the sole research owner.
(defrule
    (current-age == castle-age)
    (goal strategy-goal bt-strategy-boom)
    (building-type-count-total town-center >= 3)
    (building-type-count-total farm >= bt-farm-castle-cap)
    (not (can-research-with-escrow imperial-age))
    (up-research-status c: ri-wheel-barrow == research-available)
=>
    (set-goal bt-wheelbarrow-demand-goal 1)
)

; If the mature BOOM witness disappears or Imperial becomes immediately
; feasible, withdraw only the pending demand. An active Wheelbarrow claim
; owns the shared mutex until completion or watchdog recovery.
(defrule
    (goal bt-wheelbarrow-demand-goal 1)
    (strategic-number sn-resource-control != ri-wheel-barrow)
    (or
        (can-research-with-escrow imperial-age)
        (strategic-number sn-resource-control == imperial-age)
        (not
            (and
                (current-age == castle-age)
                (goal strategy-goal bt-strategy-boom)
                (building-type-count-total town-center >= 3)
                (building-type-count-total farm >= bt-farm-castle-cap)
                (not (can-research-with-escrow imperial-age))
                (up-research-status c: ri-wheel-barrow == research-available)
            )
        )
    )
=>
    (set-goal bt-wheelbarrow-demand-goal 0)
)

; Demand -> claim -> release Food + Wood escrow -> research.
(defrule
    (goal bt-wheelbarrow-demand-goal 1)
    (current-age >= feudal-age)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow feudal-age))
    (not (can-research-with-escrow castle-age))
    (not (can-research-with-escrow imperial-age))
    (can-research-with-escrow ri-wheel-barrow)
=>
    (set-strategic-number sn-resource-control ri-wheel-barrow)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-wheel-barrow)
)

; research-complete is the terminal world-state witness for the claim.
(defrule
    (strategic-number sn-resource-control == ri-wheel-barrow)
    (up-research-status c: ri-wheel-barrow == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-wheelbarrow-demand-goal 0)
)

;----------------------------------------------------------------
; WHEELBARROW WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == ri-wheel-barrow)
    (up-research-status c: ri-wheel-barrow <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-wheelbarrow-demand-goal 0)
)

;================================================================
; 14H. HAND CART DEMAND / RESEARCH LIFECYCLE
;================================================================
;
; Hand Cart is a late-Castle economic investment. Wheelbarrow must be
; complete, and the controller must show a mature BOOM economy through
; either three Town Centers or the existing 50-villager Imperial-age
; threshold. Do not spend the Castle economy's Food/Wood on Hand Cart
; while the existing Imperial-bank-prep state owns that priority.
;
; The existing Imperial feasibility veto also prevents an immediate
; Imperial-age bank from being cannibalized.
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-boom)
    (up-research-status c: ri-wheel-barrow >= research-complete)
    (or
        (building-type-count-total town-center >= 3)
        (unit-type-count villager >= bt-imperial-villagers)
    )
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (up-research-status c: ri-hand-cart == research-available)
=>
    (set-goal bt-hand-cart-demand-goal 1)
)

; Withdraw only a pending demand when its maturity or opportunity-cost
; witness disappears. An active Hand Cart claim owns the mutex until
; completion or watchdog recovery.
(defrule
    (goal bt-hand-cart-demand-goal 1)
    (strategic-number sn-resource-control != ri-hand-cart)
    (or
        (can-research-with-escrow imperial-age)
        (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
        (not
            (and
                (current-age >= castle-age)
                (goal strategy-goal bt-strategy-boom)
                (up-research-status c: ri-wheel-barrow >= research-complete)
                (or
                    (building-type-count-total town-center >= 3)
                    (unit-type-count villager >= bt-imperial-villagers)
                )
                (not (can-research-with-escrow imperial-age))
                (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
                (up-research-status c: ri-hand-cart == research-available)
            )
        )
    )
=>
    (set-goal bt-hand-cart-demand-goal 0)
)

; Demand -> claim -> release Food + Wood escrow -> research.
(defrule
    (goal bt-hand-cart-demand-goal 1)
    (current-age >= castle-age)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (can-research-with-escrow ri-hand-cart)
=>
    (set-strategic-number sn-resource-control ri-hand-cart)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-hand-cart)
)

; research-complete is the terminal witness for the Hand Cart claim.
(defrule
    (strategic-number sn-resource-control == ri-hand-cart)
    (up-research-status c: ri-hand-cart == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-hand-cart-demand-goal 0)
)

;----------------------------------------------------------------
; HAND CART WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == ri-hand-cart)
    (up-research-status c: ri-hand-cart <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-hand-cart-demand-goal 0)
)

;================================================================
; 14I. BOW SAW DEMAND / RESEARCH LIFECYCLE
;================================================================
;
; Bow Saw is the first Castle BOOM wood-efficiency investment. The
; controller's existing two-Town-Center milestone is the maturity
; witness: it proves the economy has crossed from Castle transition
; into sustained expansion before spending Food + Wood on the upgrade.
;
; The shared resource-control mutex still protects active TC projects
; and age banks. Immediate Imperial feasibility and Imperial-bank-prep
; retain priority over the economic upgrade.
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-boom)
    (building-type-count-total town-center >= 2)
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (up-research-status c: ri-bow-saw == research-available)
=>
    (set-goal bt-bow-saw-demand-goal 1)
)

; Withdraw only a pending Bow Saw demand when its maturity or resource
; priority disappears. An active claim owns sn-resource-control until
; completion or watchdog recovery.
(defrule
    (goal bt-bow-saw-demand-goal 1)
    (strategic-number sn-resource-control != ri-bow-saw)
    (or
        (can-research-with-escrow imperial-age)
        (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
        (not
            (and
                (current-age >= castle-age)
                (goal strategy-goal bt-strategy-boom)
                (building-type-count-total town-center >= 2)
                (not (can-research-with-escrow imperial-age))
                (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
                (up-research-status c: ri-bow-saw == research-available)
            )
        )
    )
=>
    (set-goal bt-bow-saw-demand-goal 0)
)

; Demand -> claim -> release Food + Wood escrow -> research.
(defrule
    (goal bt-bow-saw-demand-goal 1)
    (current-age >= castle-age)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (can-research-with-escrow ri-bow-saw)
=>
    (set-strategic-number sn-resource-control ri-bow-saw)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-bow-saw)
)

; research-complete is the terminal witness for the Bow Saw claim.
(defrule
    (strategic-number sn-resource-control == ri-bow-saw)
    (up-research-status c: ri-bow-saw == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-bow-saw-demand-goal 0)
)

;----------------------------------------------------------------
; BOW SAW WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == ri-bow-saw)
    (up-research-status c: ri-bow-saw <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-bow-saw-demand-goal 0)
)

;================================================================
; 14K. TWO-MAN SAW DEMAND / RESEARCH LIFECYCLE
;================================================================
;
; Two-Man Saw is the terminal Imperial wood-productivity investment.
; Imperial BOOM is the maturity witness. Active Cataphract demand keeps
; the Imperial resource bank focused on the power-unit priority.
(defrule
    (current-age >= imperial-age)
    (goal strategy-goal bt-strategy-boom)
    (not (goal bt-cataphract-demand-goal 1))
    (research-available ri-two-man-saw)
=>
    (set-goal bt-two-man-saw-demand-goal 1)
)

; Withdraw only a pending demand when Imperial power demand takes
; priority or the technology is no longer available. An active
; Two-Man Saw claim remains protected by sn-resource-control.
(defrule
    (goal bt-two-man-saw-demand-goal 1)
    (strategic-number sn-resource-control != ri-two-man-saw)
    (or
        (goal bt-cataphract-demand-goal 1)
        (not
            (and
                (current-age >= imperial-age)
                (goal strategy-goal bt-strategy-boom)
                (not (goal bt-cataphract-demand-goal 1))
                (research-available ri-two-man-saw)
            )
        )
    )
=>
    (set-goal bt-two-man-saw-demand-goal 0)
)

; Demand -> claim -> release Food + Wood escrow -> research.
(defrule
    (goal bt-two-man-saw-demand-goal 1)
    (current-age >= imperial-age)
    (goal strategy-goal bt-strategy-boom)
    (strategic-number sn-resource-control == 0)
    (not (goal bt-cataphract-demand-goal 1))
    (can-research-with-escrow ri-two-man-saw)
=>
    (set-strategic-number sn-resource-control ri-two-man-saw)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-two-man-saw)
)

; research-complete is the terminal witness for the Two-Man Saw claim.
(defrule
    (strategic-number sn-resource-control == ri-two-man-saw)
    (up-research-status c: ri-two-man-saw == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-two-man-saw-demand-goal 0)
)

;----------------------------------------------------------------
; TWO-MAN SAW WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == ri-two-man-saw)
    (up-research-status c: ri-two-man-saw <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-two-man-saw-demand-goal 0)
)

;================================================================
; 14J. GOLD SHAFT MINING RESEARCH
;================================================================
;
; Gold Shaft Mining is a direct Castle BOOM economic investment.
; The existing Gold Mining completion proves the prerequisite tech
; lifecycle is finished, TC2 proves the first Castle expansion has
; matured, and Imperial preparation retains priority.
(defrule
    (current-age == castle-age)
    (goal strategy-goal bt-strategy-boom)
    (up-research-status c: ri-gold-mining >= research-complete)
    (building-type-count-total town-center >= 2)
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-gold-shaft-mining)
=>
    (set-strategic-number sn-resource-control ri-gold-shaft-mining)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-gold-shaft-mining)
)

; research-complete is the terminal witness for the Gold Shaft Mining claim.
(defrule
    (strategic-number sn-resource-control == ri-gold-shaft-mining)
    (up-research-status c: ri-gold-shaft-mining == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

;----------------------------------------------------------------
; GOLD SHAFT MINING WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == ri-gold-shaft-mining)
    (up-research-status c: ri-gold-shaft-mining <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

;================================================================
; 14L. STONE MINING / STONE SHAFT MINING
;================================================================
;
; Stone technology is a project-economics investment, not a generic
; age-based economic upgrade.
;
; The existing resource-mode controller is the stone-project witness.
; Technology demand observes that state; it does not create or modify it.
;
; STONE MINING:
;   - Castle-stone modes are direct evidence of an active Castle project.
;   - Late TC expansion after a Castle is a secondary sustained-project
;     witness once the economy has reached the existing 50-villager mark.
;   - The current controller has no Feudal stone-allocation mode, so the
;     Feudal branch remains intentionally dormant until a real stone
;     project can feed it. Do not invent a predictive stone subsystem.
;
; STONE SHAFT MINING:
;   - Requires completed Stone Mining.
;   - Requires Castle BOOM.
;   - Requires the existing late TC3 stone-project witness:
;       TC >= 2, villagers >= 50, TC stone mode active.
;   - This is deliberately much stricter than Stone Mining.
;   - The current controller has no persistent multi-Castle demand signal,
;     so do not synthesize one merely to force the technology.
;
; Both lifecycles use the existing resource-control mutex, escrow release,
; research-complete witness, and research watchdog.
;
;----------------------------------------------------------------
; 14L-A. STONE MINING DEMAND
;----------------------------------------------------------------
(defrule
    (goal bt-stone-mining-demand-goal 0)
    (current-age >= feudal-age)
    (goal strategy-goal bt-strategy-boom)
    (not (town-under-attack))
    (research-available ri-stone-mining)
    (or
        (goal bt-resource-mode-goal bt-resource-mode-castle-stone-premium)
        (and
            (goal bt-resource-mode-goal bt-resource-mode-tc-stone-premium)
            (building-type-count-total castle >= 1)
            (unit-type-count villager >= bt-imperial-villagers)
        )
        (and
            (goal bt-resource-mode-goal bt-resource-mode-tc-stone)
            (building-type-count-total castle >= 1)
            (unit-type-count villager >= bt-imperial-villagers)
        )
    )
    (not (can-research-with-escrow feudal-age))
    (not (can-research-with-escrow castle-age))
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (strategic-number sn-resource-control != imperial-age)
=>
    (set-goal bt-stone-mining-demand-goal 1)
)

; Withdraw pending demand when the project or its economic priority
; disappears. An active claim remains protected by sn-resource-control.
(defrule
    (goal bt-stone-mining-demand-goal 1)
    (strategic-number sn-resource-control != ri-stone-mining)
    (or
        (can-research-with-escrow feudal-age)
        (can-research-with-escrow castle-age)
        (can-research-with-escrow imperial-age)
        (strategic-number sn-resource-control == imperial-age)
        (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
        (not (goal strategy-goal bt-strategy-boom))
        (town-under-attack)
        (not (research-available ri-stone-mining))
        (not
            (or
                (goal bt-resource-mode-goal bt-resource-mode-castle-stone-premium)
                (and
                    (goal bt-resource-mode-goal bt-resource-mode-tc-stone-premium)
                    (building-type-count-total castle >= 1)
                    (unit-type-count villager >= bt-imperial-villagers)
                )
                (and
                    (goal bt-resource-mode-goal bt-resource-mode-tc-stone)
                    (building-type-count-total castle >= 1)
                    (unit-type-count villager >= bt-imperial-villagers)
                )
            )
        )
    )
=>
    (set-goal bt-stone-mining-demand-goal 0)
)

;----------------------------------------------------------------
; 14L-B. STONE MINING RESEARCH
;----------------------------------------------------------------
(defrule
    (goal bt-stone-mining-demand-goal 1)
    (current-age >= feudal-age)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow feudal-age))
    (not (can-research-with-escrow castle-age))
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (can-research-with-escrow ri-stone-mining)
=>
    (set-strategic-number sn-resource-control ri-stone-mining)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-stone-mining)
)

; research-complete is the terminal world-state witness.
(defrule
    (strategic-number sn-resource-control == ri-stone-mining)
    (up-research-status c: ri-stone-mining == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-stone-mining-demand-goal 0)
)

;----------------------------------------------------------------
; 14L-C. STONE SHAFT MINING DEMAND
;----------------------------------------------------------------
;
; Shaft Mining is deliberately gated behind a much larger Castle
; economy. The existing TC3 stone mode is the only persistent late-Castle
; stone-project witness available without introducing another state store.
(defrule
    (goal bt-stone-shaft-mining-demand-goal 0)
    (current-age == castle-age)
    (goal strategy-goal bt-strategy-boom)
    (not (town-under-attack))
    (up-research-status c: ri-stone-mining == research-complete)
    (research-available ri-stone-shaft-mining)
    (not
        (and
            (building-type-count-total castle >= 2)
            (unit-type-count villager >= bt-stone-shaft-villagers)
            (stone-amount >= 650)
        )
    )
    (or
        (and
            (goal bt-resource-mode-goal bt-resource-mode-tc-stone)
            (building-type-count-total town-center >= 2)
            (unit-type-count villager >= bt-stone-shaft-villagers)
            (food-amount >= bt-stone-shaft-food-buffer)
            (wood-amount >= bt-stone-shaft-wood-buffer)
        )
        (and
            (building-type-count-total castle >= 2)
            (unit-type-count villager >= bt-stone-shaft-villagers)
            (food-amount >= bt-stone-shaft-food-buffer)
            (wood-amount >= bt-stone-shaft-wood-buffer)
            (stone-amount < 650)
        )
    )
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (strategic-number sn-resource-control != imperial-age)
=>
    (set-goal bt-stone-shaft-mining-demand-goal 1)
)

; Withdraw pending Shaft demand when the late-Castle stone project,
; Imperial priority, or prerequisite disappears. An active Shaft claim
; remains protected by sn-resource-control.
(defrule
    (goal bt-stone-shaft-mining-demand-goal 1)
    (strategic-number sn-resource-control != ri-stone-shaft-mining)
    (or
        (current-age != castle-age)
        (can-research-with-escrow imperial-age)
        (strategic-number sn-resource-control == imperial-age)
        (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
        (town-under-attack)
        (not (goal strategy-goal bt-strategy-boom))
        (not (up-research-status c: ri-stone-mining == research-complete))
        (not (research-available ri-stone-shaft-mining))
        (not
            (or
                (and
                    (current-age == castle-age)
                    (goal strategy-goal bt-strategy-boom)
                    (not (town-under-attack))
                    (up-research-status c: ri-stone-mining == research-complete)
                    (research-available ri-stone-shaft-mining)
                    (goal bt-resource-mode-goal bt-resource-mode-tc-stone)
                    (building-type-count-total town-center >= 2)
                    (unit-type-count villager >= bt-stone-shaft-villagers)
                    (food-amount >= bt-stone-shaft-food-buffer)
                    (wood-amount >= bt-stone-shaft-wood-buffer)
                    (not (can-research-with-escrow imperial-age))
                    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
                )
                (and
                    (building-type-count-total castle >= 2)
                    (unit-type-count villager >= bt-stone-shaft-villagers)
                    (food-amount >= bt-stone-shaft-food-buffer)
                    (wood-amount >= bt-stone-shaft-wood-buffer)
                    (stone-amount < 650)
                    (not (can-research-with-escrow imperial-age))
                    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
                )
            )
        )
    )
=>
    (set-goal bt-stone-shaft-mining-demand-goal 0)
)

;----------------------------------------------------------------
; 14L-D. STONE SHAFT MINING RESEARCH
;----------------------------------------------------------------
(defrule
    (goal bt-stone-shaft-mining-demand-goal 1)
    (current-age == castle-age)
    (goal strategy-goal bt-strategy-boom)
    (up-research-status c: ri-stone-mining == research-complete)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow imperial-age))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (can-research-with-escrow ri-stone-shaft-mining)
=>
    (set-strategic-number sn-resource-control ri-stone-shaft-mining)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-stone-shaft-mining)
)

; research-complete is the terminal witness for Stone Shaft Mining.
(defrule
    (strategic-number sn-resource-control == ri-stone-shaft-mining)
    (up-research-status c: ri-stone-shaft-mining == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-stone-shaft-mining-demand-goal 0)
)

;================================================================
;================================================================
; 15. PRODUCTION CAPACITY
;================================================================
;================================================================
; 15. PRODUCTION CAPACITY
;================================================================
;
; Q: "How do strategy and unit-goal change actual production?"
;
; They become prerequisites for production-building rules.
;
; IMPORTANT:
;   sn-resource-control must be 0.
;
; If an age/research claim owns the bank, military production waits.
; This is the conservative resource arbitration rule.
;---------------------------------------------------------------
; 15A. BARRACK CAPACITY
;---------------------------------------------------------------
; Standing-army demand supplies the persistent late-game capacity
; signal.  It does not replace threat-driven FLUSH capacity.
(defrule
    (goal bt-standing-army-demand-goal 1)
    (current-age == feudal-age)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal bt-standing-army-demand-goal 1)
    (goal strategy-goal bt-strategy-flush)
    (current-age == feudal-age)
    (up-compare-goal bt-standing-army-floor-goal >= bt-flush-army-floor-feudal)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 2)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal bt-standing-army-demand-goal 1)
    (current-age == castle-age)
    (up-compare-goal bt-standing-army-floor-goal >= 16)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 2)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal bt-standing-army-demand-goal 1)
    (current-age == castle-age)
    (up-compare-goal bt-standing-army-floor-goal >= 20)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 3)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal bt-standing-army-demand-goal 1)
    (current-age >= imperial-age)
    (up-compare-goal bt-standing-army-floor-goal >= 26)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 4)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal bt-standing-army-demand-goal 1)
    (current-age >= imperial-age)
    (up-compare-goal bt-standing-army-floor-goal >= 34)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 6)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal bt-standing-army-demand-goal 1)
    (current-age >= imperial-age)
    (up-compare-goal bt-standing-army-floor-goal >= 42)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 8)
    (can-build barracks)
=>
    (build barracks)
)


(defrule
    (goal strategy-goal bt-strategy-flush)
    (or
    (goal unit-goal spearman-line)
    (goal unit-goal bt-unit-mix)
    )
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-level-goal >= 1)
    (building-type-count-total barracks < 2)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (or
    (goal unit-goal spearman-line)
    (goal unit-goal bt-unit-mix)
    )
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-level-goal >= 2)
    (building-type-count-total barracks < 4)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (or
    (goal unit-goal spearman-line)
    (goal unit-goal bt-unit-mix)
    )
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-level-goal >= 3)
    (building-type-count-total barracks < 6)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (current-age >= imperial-age)
    (goal strategy-goal bt-strategy-flush)
    (or
    (goal unit-goal spearman-line)
    (goal unit-goal bt-unit-mix)
    )
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-level-goal >= 4)
    (building-type-count-total barracks < 8)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (current-age >= imperial-age)
    (goal strategy-goal bt-strategy-flush)
    (or
    (goal unit-goal spearman-line)
    (goal unit-goal bt-unit-mix)
    )
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-level-goal >= 5)
    (building-type-count-total barracks < bt-max-barracks)
    (can-build barracks)
=>
    (build barracks)
)

;---------------------------------------------------------------
; 15B. ARCHERY-RANGE CAPACITY
;---------------------------------------------------------------
(defrule
    (or (goal unit-goal skirmisher-line) (or (goal unit-goal archer-line) (goal unit-goal bt-unit-mix)))
    (or (goal strategy-goal bt-strategy-rush) (goal strategy-goal bt-strategy-flush))
    (strategic-number sn-resource-control == 0)
    (or (goal bt-ranged-threat-goal 1) (or (goal bt-spear-threat-goal 1) (goal strategy-goal bt-strategy-rush)))
    (building-type-count-total archery-range < 1)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (or (goal unit-goal skirmisher-line) (or (goal unit-goal archer-line) (goal unit-goal bt-unit-mix)))
    (not (goal strategy-goal bt-strategy-boom))
    (strategic-number sn-resource-control == 0)
    (or (up-compare-goal bt-ranged-level-goal >= 1) (up-compare-goal bt-spear-level-goal >= 1))
    (building-type-count-total archery-range < 2)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (or (goal unit-goal skirmisher-line) (or (goal unit-goal archer-line) (goal unit-goal bt-unit-mix)))
    (strategic-number sn-resource-control == 0)
    (or (up-compare-goal bt-ranged-level-goal >= 2) (up-compare-goal bt-spear-level-goal >= 2))
    (building-type-count-total archery-range < 4)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (current-age >= imperial-age)
    (goal strategy-goal bt-strategy-flush)
    (or (goal unit-goal skirmisher-line) (or (goal unit-goal archer-line) (goal unit-goal bt-unit-mix)))
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-ranged-level-goal >= 3)
    (building-type-count-total archery-range < 6)
    (can-build archery-range)
=>
    (build archery-range)
)

;---------------------------------------------------------------
; 15C. FEUDAL STABLE CAPABILITY FOR SCOUT PRESSURE
;---------------------------------------------------------------
; The Scout demand owns this one direct capability edge.  It does not
; alter the Castle stable-capacity rules below.
(defrule
    (goal bt-scout-pressure-demand-goal 1)
    (current-age == feudal-age)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow castle-age))
    (building-type-count-total stable < 1)
    (wood-amount >= bt-scout-stable-wood)
    (can-build stable)
=>
    (build stable)
)

;---------------------------------------------------------------
; 15D. STABLE CAPACITY
;---------------------------------------------------------------
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal bt-unit-mix)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-noncav-cavalry-level-goal >= 1)
    (building-type-count-total stable < 1)
    (can-build stable)
=>
    (build stable)
)
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal bt-unit-mix)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-noncav-cavalry-level-goal >= 2)
    (building-type-count-total stable < 2)
    (can-build stable)
=>
    (build stable)
)

; Permanent age-prerequisite manual reset.
; Trigger this through the scenario editor's AI Script Goal effect
; using trigger ID 60.  The event stays pending while another
; subsystem owns sn-resource-control, then is acknowledged only after
; the reset can safely release the mutex.
(defrule
    (event-detected trigger bt-castle-prereq-manual-reset-trigger)
    (or
        (goal bt-castle-prereq-failure-goal != 0)
        (goal bt-imperial-prereq-failure-goal != 0)
    )
    (strategic-number sn-resource-control == 0)
=>
    (acknowledge-event trigger bt-castle-prereq-manual-reset-trigger)
    (disable-timer bt-castle-prereq-watchdog-timer)
    (disable-timer bt-castle-prereq-backoff-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-castle-prereq-failure-goal 0)
    (set-goal bt-castle-prereq-diagnostic-goal 0)
    (set-goal bt-castle-prereq-retry-goal 0)
    (set-goal bt-castle-prereq-backoff-goal 0)
    (set-goal bt-imperial-prereq-failure-goal 0)
    (set-goal bt-imperial-prereq-diagnostic-goal 0)
    (set-goal bt-imperial-prereq-retry-goal 0)
    (set-goal bt-imperial-prereq-backoff-goal 0)
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (disable-timer bt-imperial-prereq-backoff-timer)
)

;---------------------------------------------------------------
; 15E. CASTLE PREREQUISITE: BLACKSMITH
;---------------------------------------------------------------
; Failed Castle-age feasibility is the demand witness.
; The shared resource mutex prevents collision with age/research,
; TC, and other capital-consuming systems.
(defrule
    (current-age == feudal-age)
    (goal bt-castle-prereq-failure-goal 0)
    (goal bt-castle-prereq-backoff-goal 0)
    (not (can-research-with-escrow castle-age))
    (building-type-count-total blacksmith < 1)
    (up-pending-objects c: blacksmith == 0)
    (strategic-number sn-resource-control == 0)
    (can-build blacksmith)
=>
    (set-strategic-number sn-resource-control bt-castle-blacksmith-claim)
    (enable-timer bt-castle-prereq-watchdog-timer bt-castle-prereq-watchdog-seconds)
    (build blacksmith)
)

; Blacksmith completion is the world-state witness.
(defrule
    (strategic-number sn-resource-control == bt-castle-blacksmith-claim)
    (building-type-count-total blacksmith >= 1)
=>
    (disable-timer bt-castle-prereq-watchdog-timer)
    (disable-timer bt-castle-prereq-backoff-timer)
    (set-goal bt-castle-prereq-backoff-goal 0)
    (set-goal bt-castle-prereq-retry-goal 0)
    (set-strategic-number sn-resource-control 0)
)

; A timed-out foundation may finish after the watchdog released the
; mutex. Reset retry history without touching a newer resource claim.
(defrule
    (building-type-count-total blacksmith >= 1)
    (up-compare-goal bt-castle-prereq-retry-goal >= 1)
=>
    (disable-timer bt-castle-prereq-backoff-timer)
    (set-goal bt-castle-prereq-backoff-goal 0)
    (set-goal bt-castle-prereq-retry-goal 0)
)

; Castle prerequisite watchdog recovery.
; Timeout only releases the stale claim. Retry delay doubles through
; 30/60/120 seconds, then uses the 240-second cap. The next timeout
; after the capped retry is the permanent-failure cutoff.
; This is terminal for the prerequisite subsystem: release the mutex,
; stop its timers, and leave a diagnostic witness. No retry follows.
(defrule
    (strategic-number sn-resource-control == bt-castle-blacksmith-claim)
    (up-compare-goal bt-castle-prereq-retry-goal >= 4)
    (timer-triggered bt-castle-prereq-watchdog-timer)
=>
    (disable-timer bt-castle-prereq-watchdog-timer)
    (disable-timer bt-castle-prereq-backoff-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-castle-prereq-backoff-goal 0)
    (set-goal bt-castle-prereq-failure-goal bt-castle-prereq-failure-blacksmith)
    (set-goal bt-castle-prereq-diagnostic-goal bt-castle-prereq-reason-timeout)
)

(defrule
    (strategic-number sn-resource-control == bt-castle-market-claim)
    (up-compare-goal bt-castle-prereq-retry-goal >= 4)
    (timer-triggered bt-castle-prereq-watchdog-timer)
=>
    (disable-timer bt-castle-prereq-watchdog-timer)
    (disable-timer bt-castle-prereq-backoff-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-castle-prereq-backoff-goal 0)
    (set-goal bt-castle-prereq-failure-goal bt-castle-prereq-failure-market)
    (set-goal bt-castle-prereq-diagnostic-goal bt-castle-prereq-reason-timeout)
)

(defrule
    (or
        (strategic-number sn-resource-control == bt-castle-blacksmith-claim)
        (strategic-number sn-resource-control == bt-castle-market-claim)
    )
    (goal bt-castle-prereq-retry-goal 2)
    (timer-triggered bt-castle-prereq-watchdog-timer)
=>
    (disable-timer bt-castle-prereq-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-castle-prereq-backoff-goal 1)
    (set-goal bt-castle-prereq-retry-goal 3)
    (enable-timer bt-castle-prereq-backoff-timer bt-castle-prereq-backoff-3-seconds)
)

(defrule
    (or
        (strategic-number sn-resource-control == bt-castle-blacksmith-claim)
        (strategic-number sn-resource-control == bt-castle-market-claim)
    )
    (goal bt-castle-prereq-retry-goal 3)
    (timer-triggered bt-castle-prereq-watchdog-timer)
=>
    (disable-timer bt-castle-prereq-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-castle-prereq-backoff-goal 1)
    (set-goal bt-castle-prereq-retry-goal 4)
    (enable-timer bt-castle-prereq-backoff-timer bt-castle-prereq-backoff-cap-seconds)
)

(defrule
    (or
        (strategic-number sn-resource-control == bt-castle-blacksmith-claim)
        (strategic-number sn-resource-control == bt-castle-market-claim)
    )
    (goal bt-castle-prereq-retry-goal 1)
    (timer-triggered bt-castle-prereq-watchdog-timer)
=>
    (disable-timer bt-castle-prereq-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-castle-prereq-backoff-goal 1)
    (set-goal bt-castle-prereq-retry-goal 2)
    (enable-timer bt-castle-prereq-backoff-timer bt-castle-prereq-backoff-2-seconds)
)

(defrule
    (or
        (strategic-number sn-resource-control == bt-castle-blacksmith-claim)
        (strategic-number sn-resource-control == bt-castle-market-claim)
    )
    (goal bt-castle-prereq-retry-goal 0)
    (timer-triggered bt-castle-prereq-watchdog-timer)
=>
    (disable-timer bt-castle-prereq-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-castle-prereq-backoff-goal 1)
    (set-goal bt-castle-prereq-retry-goal 1)
    (enable-timer bt-castle-prereq-backoff-timer bt-castle-prereq-backoff-seconds)
)

;---------------------------------------------------------------
; 15F. CASTLE PREREQUISITE: MARKET
;---------------------------------------------------------------
; Market is downstream of Blacksmith completion.  If Castle becomes
; researchable through Blacksmith + another qualifying Feudal building,
; no redundant Market is forced.
(defrule
    (current-age == feudal-age)
    (goal bt-castle-prereq-failure-goal 0)
    (goal bt-castle-prereq-backoff-goal 0)
    (building-type-count-total blacksmith >= 1)
    (not (can-research-with-escrow castle-age))
    (building-type-count-total market < 1)
    (up-pending-objects c: market == 0)
    (strategic-number sn-resource-control == 0)
    (can-build market)
=>
    (set-strategic-number sn-resource-control bt-castle-market-claim)
    (enable-timer bt-castle-prereq-watchdog-timer bt-castle-prereq-watchdog-seconds)
    (build market)
)

; Market completion is the world-state witness.
(defrule
    (strategic-number sn-resource-control == bt-castle-market-claim)
    (building-type-count-total market >= 1)
=>
    (disable-timer bt-castle-prereq-watchdog-timer)
    (disable-timer bt-castle-prereq-backoff-timer)
    (set-goal bt-castle-prereq-backoff-goal 0)
    (set-goal bt-castle-prereq-retry-goal 0)
    (set-strategic-number sn-resource-control 0)
)

; A timed-out foundation may finish after the watchdog released the
; mutex. Reset retry history without touching a newer resource claim.
(defrule
    (building-type-count-total market >= 1)
    (up-compare-goal bt-castle-prereq-retry-goal >= 1)
    (goal bt-castle-prereq-failure-goal 0)
=>
    (disable-timer bt-castle-prereq-backoff-timer)
    (set-goal bt-castle-prereq-backoff-goal 0)
    (set-goal bt-castle-prereq-retry-goal 0)
)

; Castle prerequisite retry backoff recovery.
; Timeout releases the cooldown state; it never reclaims the mutex.
(defrule
    (goal bt-castle-prereq-backoff-goal 1)
    (timer-triggered bt-castle-prereq-backoff-timer)
=>
    (disable-timer bt-castle-prereq-backoff-timer)
    (set-goal bt-castle-prereq-backoff-goal 0)
)

;---------------------------------------------------------------
; 15G. CASTLE CAPABILITY FOR CATAPHRACT PRODUCTION
;---------------------------------------------------------------
;
; Cataphract demand owns the strategic decision. This rule only
; closes the required Castle construction capability edge.
(defrule
    (goal bt-cataphract-demand-goal 1)
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (building-available castle)
    (can-build castle)
=>
    (build castle)
)

; Imperial prerequisite retry backoff recovery.
; Timeout releases the cooldown state; it never reclaims the mutex.
(defrule
    (goal bt-imperial-prereq-backoff-goal 1)
    (timer-triggered bt-imperial-prereq-backoff-timer)
=>
    (disable-timer bt-imperial-prereq-backoff-timer)
    (set-goal bt-imperial-prereq-backoff-goal 0)
)

;---------------------------------------------------------------
; 15H. CASTLE -> IMPERIAL PREREQUISITE: SIEGE WORKSHOP
;---------------------------------------------------------------
; Deterministic Imperial path:
;   Siege Workshop -> University.
;
; Imperial feasibility is the demand witness. A Castle is the
; alternate Imperial prerequisite, so these buildings are not forced
; when a Castle already satisfies the engine requirement.
(defrule
    (current-age == castle-age)
    (goal bt-imperial-prereq-failure-goal 0)
    (goal bt-imperial-prereq-backoff-goal 0)
    (building-type-count-total castle < 1)
    (not (can-research-with-escrow imperial-age))
    (or
        (building-type-count-total university < 1)
        (building-type-count-total monastery < 1)
    )
    (building-type-count-total siege-workshop < 1)
    (up-pending-objects c: siege-workshop == 0)
    (strategic-number sn-resource-control == 0)
    (can-build siege-workshop)
=>
    (set-strategic-number sn-resource-control bt-imperial-siege-claim)
    (enable-timer bt-imperial-prereq-watchdog-timer bt-imperial-prereq-watchdog-seconds)
    (build siege-workshop)
)

(defrule
    (strategic-number sn-resource-control == bt-imperial-siege-claim)
    (building-type-count-total siege-workshop >= 1)
=>
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (disable-timer bt-imperial-prereq-backoff-timer)
    (set-goal bt-imperial-prereq-backoff-goal 0)
    (set-goal bt-imperial-prereq-retry-goal 0)
    (set-strategic-number sn-resource-control 0)
)

; A timed-out foundation may finish after the watchdog released the
; mutex. Reset retry history without touching a newer resource claim.
(defrule
    (building-type-count-total siege-workshop >= 1)
    (up-compare-goal bt-imperial-prereq-retry-goal >= 1)
    (goal bt-imperial-prereq-failure-goal 0)
=>
    (disable-timer bt-imperial-prereq-backoff-timer)
    (set-goal bt-imperial-prereq-backoff-goal 0)
    (set-goal bt-imperial-prereq-retry-goal 0)
)

;---------------------------------------------------------------
; 15I. CASTLE -> IMPERIAL PREREQUISITE: UNIVERSITY
;---------------------------------------------------------------
; University is downstream of Siege Workshop so the two-building
; Imperial path is serialized and deterministic.
(defrule
    (current-age == castle-age)
    (goal bt-imperial-prereq-failure-goal 0)
    (goal bt-imperial-prereq-backoff-goal 0)
    (building-type-count-total siege-workshop >= 1)
    (not (can-research-with-escrow imperial-age))
    (building-type-count-total university < 1)
    (building-type-count-total monastery < 1)
    (up-pending-objects c: university == 0)
    (strategic-number sn-resource-control == 0)
    (can-build university)
=>
    (set-strategic-number sn-resource-control bt-imperial-university-claim)
    (enable-timer bt-imperial-prereq-watchdog-timer bt-imperial-prereq-watchdog-seconds)
    (build university)
)

(defrule
    (strategic-number sn-resource-control == bt-imperial-university-claim)
    (building-type-count-total university >= 1)
=>
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (disable-timer bt-imperial-prereq-backoff-timer)
    (set-goal bt-imperial-prereq-backoff-goal 0)
    (set-goal bt-imperial-prereq-retry-goal 0)
    (set-strategic-number sn-resource-control 0)
)

; A timed-out University foundation may finish after the watchdog
; released the mutex. Reset retry history without touching a newer claim.
(defrule
    (building-type-count-total university >= 1)
    (up-compare-goal bt-imperial-prereq-retry-goal >= 1)
    (goal bt-imperial-prereq-failure-goal 0)
=>
    (disable-timer bt-imperial-prereq-backoff-timer)
    (set-goal bt-imperial-prereq-backoff-goal 0)
    (set-goal bt-imperial-prereq-retry-goal 0)
)

;---------------------------------------------------------------
; 15J. CASTLE -> IMPERIAL PREREQUISITE WATCHDOG
;---------------------------------------------------------------
; Same bounded retry lifecycle as the validated Feudal -> Castle pair:
; 30 -> 60 -> 120 -> 240 seconds, then permanent failure.
(defrule
    (strategic-number sn-resource-control == bt-imperial-siege-claim)
    (up-compare-goal bt-imperial-prereq-retry-goal >= 4)
    (timer-triggered bt-imperial-prereq-watchdog-timer)
=>
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (disable-timer bt-imperial-prereq-backoff-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-imperial-prereq-backoff-goal 0)
    (set-goal bt-imperial-prereq-failure-goal bt-imperial-prereq-failure-siege)
    (set-goal bt-imperial-prereq-diagnostic-goal bt-castle-prereq-reason-timeout)
)

(defrule
    (strategic-number sn-resource-control == bt-imperial-university-claim)
    (up-compare-goal bt-imperial-prereq-retry-goal >= 4)
    (timer-triggered bt-imperial-prereq-watchdog-timer)
=>
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (disable-timer bt-imperial-prereq-backoff-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-imperial-prereq-backoff-goal 0)
    (set-goal bt-imperial-prereq-failure-goal bt-imperial-prereq-failure-university)
    (set-goal bt-imperial-prereq-diagnostic-goal bt-castle-prereq-reason-timeout)
)

; Imperial prerequisite retry stage 3 -> stage 4.
; Mirrors the validated Castle retry ladder and preserves the 240-second cap.
(defrule
    (or
        (strategic-number sn-resource-control == bt-imperial-siege-claim)
        (strategic-number sn-resource-control == bt-imperial-university-claim)
    )
    (goal bt-imperial-prereq-retry-goal 3)
    (timer-triggered bt-imperial-prereq-watchdog-timer)
=>
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-imperial-prereq-backoff-goal 1)
    (set-goal bt-imperial-prereq-retry-goal 4)
    (enable-timer bt-imperial-prereq-backoff-timer bt-imperial-prereq-backoff-cap-seconds)
)

(defrule
    (or
        (strategic-number sn-resource-control == bt-imperial-siege-claim)
        (strategic-number sn-resource-control == bt-imperial-university-claim)
    )
    (goal bt-imperial-prereq-retry-goal 2)
    (timer-triggered bt-imperial-prereq-watchdog-timer)
=>
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-imperial-prereq-backoff-goal 1)
    (set-goal bt-imperial-prereq-retry-goal 3)
    (enable-timer bt-imperial-prereq-backoff-timer bt-imperial-prereq-backoff-3-seconds)
)

(defrule
    (or
        (strategic-number sn-resource-control == bt-imperial-siege-claim)
        (strategic-number sn-resource-control == bt-imperial-university-claim)
    )
    (goal bt-imperial-prereq-retry-goal 1)
    (timer-triggered bt-imperial-prereq-watchdog-timer)
=>
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-imperial-prereq-backoff-goal 1)
    (set-goal bt-imperial-prereq-retry-goal 2)
    (enable-timer bt-imperial-prereq-backoff-timer bt-imperial-prereq-backoff-2-seconds)
)

(defrule
    (or
        (strategic-number sn-resource-control == bt-imperial-siege-claim)
        (strategic-number sn-resource-control == bt-imperial-university-claim)
    )
    (goal bt-imperial-prereq-retry-goal 0)
    (timer-triggered bt-imperial-prereq-watchdog-timer)
=>
    (disable-timer bt-imperial-prereq-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-imperial-prereq-backoff-goal 1)
    (set-goal bt-imperial-prereq-retry-goal 1)
    (enable-timer bt-imperial-prereq-backoff-timer bt-imperial-prereq-backoff-seconds)
)

; The current rules establish only repeated construction timeout.
(defrule
    (goal bt-imperial-prereq-diagnostic-goal 0)
    (goal bt-imperial-prereq-failure-goal != 0)
=>
    (set-goal bt-imperial-prereq-diagnostic-goal bt-castle-prereq-reason-timeout)
)

;================================================================
; 15Z. STANDING ARMY FLOOR
;================================================================
; The floor is a derived requirement, not a strategy.
; It scales only when age, civilian economy, and existing military
; infrastructure prove that the economy can support the larger army.
;
; Infrastructure = completed + queued Barracks + Archery Ranges +
; Stable capacity, using building-type-count-total.
;
; Controller tuning:
;   Feudal:          6
;   Castle:         12
;   Castle mature:  16
;   Castle late:    20
;   Imperial:       26
;   Imperial mature:34
;   Imperial late:  42
;
; These are standing-force targets, not attack-group sizes.
;
; Community note: building-type-count-total is queue-aware, so a
; production-building commitment counts toward infrastructure before
; construction is complete.  Soldier-count is used for the actual
; standing-force deficit rather than military-population.
(defrule
    (true)
=>
    (up-get-fact building-type-count-total barracks bt-standing-army-barracks-scratch-goal)
    (up-get-fact building-type-count-total archery-range bt-standing-army-range-scratch-goal)
    (up-get-fact building-type-count-total stable bt-standing-army-stable-scratch-goal)
    (set-goal bt-standing-army-infra-goal 0)
    (up-modify-goal bt-standing-army-infra-goal g:+ bt-standing-army-barracks-scratch-goal)
    (up-modify-goal bt-standing-army-infra-goal g:+ bt-standing-army-range-scratch-goal)
    (up-modify-goal bt-standing-army-infra-goal g:+ bt-standing-army-stable-scratch-goal)
)

(defrule
    (current-age < feudal-age)
=>
    (set-goal bt-standing-army-floor-goal 0)
)

(defrule
    (current-age == feudal-age)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal bt-standing-army-floor-goal 6)
)

(defrule
    (current-age == castle-age)
    (not (goal strategy-goal bt-strategy-flush))
    (or
        (unit-type-count villager < 45)
        (and
            (unit-type-count villager >= 45)
            (up-compare-goal bt-standing-army-infra-goal < 2)
        )
    )
=>
    (set-goal bt-standing-army-floor-goal 12)
)

(defrule
    (current-age == castle-age)
    (not (goal strategy-goal bt-strategy-flush))
    (unit-type-count villager >= 45)
    (up-compare-goal bt-standing-army-infra-goal >= 2)
    (or
        (unit-type-count villager < 60)
        (up-compare-goal bt-standing-army-infra-goal < 3)
    )
=>
    (set-goal bt-standing-army-floor-goal 16)
)

(defrule
    (current-age == castle-age)
    (not (goal strategy-goal bt-strategy-flush))
    (unit-type-count villager >= 60)
    (up-compare-goal bt-standing-army-infra-goal >= 3)
=>
    (set-goal bt-standing-army-floor-goal 20)
)

(defrule
    (current-age >= imperial-age)
    (not (goal strategy-goal bt-strategy-flush))
    (or
        (unit-type-count villager < 60)
        (up-compare-goal bt-standing-army-infra-goal < 4)
    )
=>
    (set-goal bt-standing-army-floor-goal 26)
)

(defrule
    (current-age >= imperial-age)
    (not (goal strategy-goal bt-strategy-flush))
    (unit-type-count villager >= 60)
    (up-compare-goal bt-standing-army-infra-goal >= 4)
    (or
        (unit-type-count villager < 80)
        (up-compare-goal bt-standing-army-infra-goal < 6)
    )
=>
    (set-goal bt-standing-army-floor-goal 34)
)

(defrule
    (current-age >= imperial-age)
    (not (goal strategy-goal bt-strategy-flush))
    (unit-type-count villager >= 80)
    (up-compare-goal bt-standing-army-infra-goal >= 6)
=>
    (set-goal bt-standing-army-floor-goal 42)
)

; FLUSH reinforcement floor.
; This is deliberately independent of enemy counter classification.
; Once the town enters FLUSH, the standing requirement cannot collapse
; back to the six-unit Feudal baseline while the enemy is still in the
; decisive-attack posture.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (current-age == feudal-age)
=>
    (set-goal bt-standing-army-floor-goal bt-flush-army-floor-feudal)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (current-age == castle-age)
    (up-compare-goal bt-standing-army-floor-goal < bt-flush-army-floor-castle)
=>
    (set-goal bt-standing-army-floor-goal bt-flush-army-floor-castle)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (current-age >= imperial-age)
    (up-compare-goal bt-standing-army-floor-goal < bt-flush-army-floor-imperial)
=>
    (set-goal bt-standing-army-floor-goal bt-flush-army-floor-imperial)
)

(defrule
    (true)
=>
    (up-get-fact soldier-count 0 bt-standing-army-deficit-goal)
    (up-modify-goal bt-standing-army-deficit-goal g:- bt-standing-army-floor-goal)
)

(defrule
    (current-age >= feudal-age)
    (or
        (goal strategy-goal bt-strategy-boom)
        (goal strategy-goal bt-strategy-flush)
    )
    (up-compare-goal bt-standing-army-deficit-goal < 0)
=>
    (set-goal bt-standing-army-demand-goal 1)
)

(defrule
    (or
        (current-age < feudal-age)
        (not
            (or
                (goal strategy-goal bt-strategy-boom)
                (goal strategy-goal bt-strategy-flush)
            )
        )
        (up-compare-goal bt-standing-army-deficit-goal >= 0)
    )
=>
    (set-goal bt-standing-army-demand-goal 0)
)

;================================================================
; 16. MILITARY PRODUCTION ARBITRATION
;================================================================
;
;---------------------------------------------------------------
; 16A. FEUDAL SCOUT PRESSURE PRODUCTION
;---------------------------------------------------------------
; This is the sole direct Scout-production authority.
; unit-type-count-total scout-cavalry is intentionally exact here:
; it counts Scout Cavalry, including queued objects, without treating
; later Light Cavalry/Hussar as unfinished Scout production.
(defrule
    (goal bt-scout-pressure-demand-goal 1)
    (current-age == feudal-age)
    (not (town-under-attack))
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow castle-age))
    (building-type-count-total stable >= 1)
    (unit-type-count-total scout-cavalry < bt-scout-feudal-cap)
    (food-amount >= bt-scout-safe-food)
    (can-train scout-cavalry)
=>
    (train scout-cavalry)
)

;---------------------------------------------------------------
; 16B. CATAPHRact PRODUCTION
;---------------------------------------------------------------
;
; Cataphract production consumes the explicit strategic demand.
; The Castle is the production capability; no Stable is required.
; unit-type-count-total is queue-inclusive.
(defrule
    (goal bt-cataphract-demand-goal 1)
    (strategic-number sn-resource-control == 0)
    (building-type-count castle >= 1)
    (unit-type-count-total cataphract-line < 6)
    (can-train cataphract-line)
=>
    (train cataphract-line)
)

; Scout and Cataphract production are explicit capability exceptions;
; the composition goals below own the remaining military queue.
;
; The goals above decide what is wanted.
; These rules decide what actually gets queued.
;
; Explicit composition train rules require:
;
;   strategy
;   unit-goal
;   resource claim free
;   counter/pressure condition
;   queue-aware unit target
;   legal training
;
; The standing floor uses soldier-count for the live army deficit.
; unit-type-count-total remains the queue-aware cap for the fallback
; spear stream.
;---------------------------------------------------------------
; 16C. PERSISTENT BOOM MILITARY FLOOR
;---------------------------------------------------------------
; BOOM prioritizes economic expansion, but it does not abandon a
; minimum defensive army.  This floor is independent of transient
; enemy observation and remains separate from the attack lifecycle.
;
; Six military units is the same minimum floor used by FLUSH recovery.
(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= feudal-age)
    (goal bt-standing-army-demand-goal 1)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= feudal-age)
    (goal unit-goal bt-unit-mix)
    (goal bt-standing-army-demand-goal 1)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks >= 1)
    (unit-type-count-total spearman-line < bt-standing-army-floor-goal)
    (can-train spearman-line)
=>
    (train spearman-line)
)

; 16D. PERSISTENT FLUSH MILITARY FLOOR
;---------------------------------------------------------------
; FLUSH is a defensive posture, not a momentary reaction to a
; currently visible enemy unit. Once entered, the bot must rebuild
; a minimum army before it is allowed to recover out of FLUSH.
;
; This floor deliberately does not require a current enemy threat or
; a specific unit-goal.  It closes the FLUSH -> temporary observation
; gap -> no production failure.
;
; The FLUSH fallback stream consumes the live soldier deficit.
; It remains active after six units until the FLUSH reinforcement floor
; is restored, even when no specific enemy counter has been classified.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (current-age >= feudal-age)
    (goal bt-standing-army-demand-goal 1)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (current-age >= feudal-age)
    (goal bt-standing-army-demand-goal 1)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks >= 1)
    (up-compare-goal bt-standing-army-deficit-goal < 0)
    (can-train spearman-line)
=>
    (train spearman-line)
)

;---------------------------------------------------------------
; 16E. EXPLICIT SPEAR GOAL
;---------------------------------------------------------------
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal spearman-line)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-counter-level-goal >= 1)
    (unit-type-count-total spearman-line < bt-spear-target-1)
    (can-train spearman-line)
=>
    (train spearman-line)
)
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal spearman-line)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-counter-level-goal >= 2)
    (unit-type-count-total spearman-line < bt-spear-target-2)
    (can-train spearman-line)
=>
    (train spearman-line)
)
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal spearman-line)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-counter-level-goal >= 3)
    (unit-type-count-total spearman-line < bt-spear-target-3)
    (can-train spearman-line)
=>
    (train spearman-line)
)

;---------------------------------------------------------------
; 16F. EXPLICIT SKIRMISHER GOAL
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal skirmisher-line)
    (strategic-number sn-resource-control == 0)
    (goal bt-ranged-threat-goal 1)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total skirmisher-line < bt-skirm-target-1)
    (can-train skirmisher-line)
=>
    (train skirmisher-line)
)
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal skirmisher-line)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-ranged-counter-level-goal >= 2)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total skirmisher-line < bt-skirm-target-2)
    (can-train skirmisher-line)
=>
    (train skirmisher-line)
)
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal skirmisher-line)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-ranged-counter-level-goal >= 3)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total skirmisher-line < bt-skirm-target-3)
    (can-train skirmisher-line)
=>
    (train skirmisher-line)
)

;---------------------------------------------------------------
; 16G. EXPLICIT ARCHER GOAL
(defrule
    (or
    (goal strategy-goal bt-strategy-rush)
    (goal strategy-goal bt-strategy-flush)
    )
    (goal unit-goal archer-line)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total archer-line < 10)
    (or
    (goal strategy-goal bt-strategy-rush)
    (goal bt-spear-threat-goal 1)
    )
    (can-train archer-line)
=>
    (train archer-line)
)
; RUSH target is ten archers; attack readiness is military-population >= 10.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal archer-line)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-spear-counter-level-goal >= 2)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total archer-line < 10)
    (can-train archer-line)
=>
    (train archer-line)
)

;---------------------------------------------------------------
; 16H. MIXED COMPOSITION
; MIX #1: cheap cavalry cover first.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal bt-unit-mix)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-counter-level-goal >= 1)
    (unit-type-count-total spearman-line < bt-spear-target-1)
    (can-train spearman-line)
=>
    (train spearman-line)
)
; MIX #2: Camel support after the cheap spear floor.
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal bt-unit-mix)
    (strategic-number sn-resource-control == 0)
    (unit-type-count-total spearman-line >= bt-spear-target-1)
    (up-compare-goal bt-noncav-cavalry-level-goal >= 1)
    (building-type-count-total stable >= 1)
    (unit-type-count-total camel-line < bt-camel-target-1)
    (can-train camel)
=>
    (train camel)
)
; MIX #3: ranged coverage.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal bt-unit-mix)
    (strategic-number sn-resource-control == 0)
    (goal bt-ranged-threat-goal 1)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total skirmisher-line < bt-skirm-target-1)
    (can-train skirmisher-line)
=>
    (train skirmisher-line)
)
; MIX #4: Archer support against Spears.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal bt-unit-mix)
    (strategic-number sn-resource-control == 0)
    (goal bt-spear-threat-goal 1)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total archer-line < 6)
    (can-train archer-line)
=>
    (train archer-line)
)

;================================================================
; 17. BYZANTINE BOOM
;================================================================
;
; Q: "What does BOOM mean in actual code?"
;
; Town Centers.
;
; These rules only fire in BOOM posture, so TC expansion does not
; compete with the military pressure posture for the shared mutex.
; TC2.
; Demand -> claim -> release food/wood escrow -> start watchdog -> build.
(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= castle-age)
    (unit-type-count villager >= 32)
    (food-amount >= 350)
    (wood-amount >= 300)
    (building-type-count-total town-center < 2)
    (strategic-number sn-resource-control == 0)
    (can-build-with-escrow town-center)
=>
    (set-strategic-number sn-resource-control bt-tc2-claim)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-tc2-watchdog-timer bt-tc-watchdog-seconds)
    (build town-center)
)

; TC2 completed-count witness -> release only the TC2 claim.
(defrule
    (strategic-number sn-resource-control == bt-tc2-claim)
    (building-type-count town-center >= 2)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

; TC2 watchdog recovery.
; Timeout only releases the stale claim. It never retries the build.
(defrule
    (strategic-number sn-resource-control == bt-tc2-claim)
    (building-type-count town-center < 2)
    (timer-triggered bt-tc2-watchdog-timer)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

; TC3.
; Demand -> claim -> release food/wood escrow -> start watchdog -> build.
(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= castle-age)
    (unit-type-count villager >= 45)
    (food-amount >= 500)
    (wood-amount >= 300)
    (building-type-count-total town-center < 3)
    (strategic-number sn-resource-control == 0)
    (can-build-with-escrow town-center)
=>
    (set-strategic-number sn-resource-control bt-tc3-claim)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-tc3-watchdog-timer bt-tc-watchdog-seconds)
    (build town-center)
)

; TC3 completed-count witness -> release only the TC3 claim.
(defrule
    (strategic-number sn-resource-control == bt-tc3-claim)
    (building-type-count town-center >= 3)
=>
    (disable-timer bt-tc3-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

; TC3 watchdog recovery.
; Timeout only releases the stale claim. It never retries the build.
(defrule
    (strategic-number sn-resource-control == bt-tc3-claim)
    (building-type-count town-center < 3)
    (timer-triggered bt-tc3-watchdog-timer)
=>
    (disable-timer bt-tc3-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

;================================================================
; 18. SCOUTING -> ATTACK-GROUP GATHERING
;================================================================
(defrule
    (players-building-count target-player > 0)
=>
    (up-get-fact military-population 0 bt-relative-force-goal)
    (up-get-target-fact military-population 0 bt-target-military-scratch-goal)
    (up-modify-goal bt-relative-force-goal g:- bt-target-military-scratch-goal)
)

; Composition readiness is a parity-only attack veto.
; Positive relative force bypasses composition mismatch.
; Negative relative force is already blocked by the 506 gate.
(defrule
    (true)
=>
    (set-goal bt-counter-veto-goal 0)
)

; CAVALRY-MELEE FAMILY #1.
; Generic and high-frequency mounted melee families.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player knight-line >= 3)
            (or
                (players-unit-type-count target-player scout-cavalry-line >= 3)
                (or
                    (players-unit-type-count target-player camel-line >= 3)
                    (or
                        (players-unit-type-count target-player cataphract-line >= 3)
                        (or
                            (players-unit-type-count target-player battle-elephant-line >= 3)
                            (or
                                (players-unit-type-count target-player war-elephant-line >= 3)
                                (or
                                    (players-unit-type-count target-player steppe-lancer-line >= 3)
                                    (or
                                        (players-unit-type-count target-player tarkan-line >= 3)
                                        (or
                                            (players-unit-type-count target-player boyar-line >= 3)
                                            (players-unit-type-count target-player leitis-line >= 3)
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
        (unit-type-count-total spearman-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; CAVALRY-MELEE FAMILY #2.
; Additional current DE civilization-specific mounted melee families.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player keshik-line >= 3)
            (or
                (players-unit-type-count target-player coustillier-line >= 3)
                (or
                    (players-unit-type-count target-player konnik-line >= 3)
                    (or
                        (players-unit-type-count target-player magyar-huszar-line >= 3)
                        (or
                            (players-unit-type-count target-player shrivamsha-rider-line >= 3)
                            (or
                                (players-unit-type-count target-player iron-pagoda-line >= 3)
                                (or
                                    (players-unit-type-count target-player hei-guang-cavalry-line >= 3)
                                    (or
                                        (players-unit-type-count target-player kona-line >= 3)
                                        (or
                                            (players-unit-type-count target-player monaspa-line >= 3)
                                            (or
                                                (players-unit-type-count target-player centurion-line >= 3)
                                                (or
                                                    (players-unit-type-count target-player ratha-melee-line >= 3)
                                                    (players-unit-type-count target-player tiger-cavalry-line >= 3)
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
        (unit-type-count-total spearman-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; BOW-RANGED FAMILY #1.
; Generic archer/crossbow plus the established unique bow families.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player archer-line >= 3)
            (or
                (players-unit-type-count target-player cavalry-archer-line >= 3)
                (or
                    (players-unit-type-count target-player plumed-archer-line >= 3)
                    (or
                        (players-unit-type-count target-player longbowman-line >= 3)
                        (or
                            (players-unit-type-count target-player chu-ko-nu-line >= 3)
                            (or
                                (players-unit-type-count target-player genoese-crossbowman-line >= 3)
                                (or
                                    (players-unit-type-count target-player rattan-archer-line >= 3)
                                    (or
                                        (players-unit-type-count target-player blackwood-archer-line >= 3)
                                        (players-unit-type-count target-player fire-archer-line >= 3)
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
        (unit-type-count-total skirmisher-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; BOW-RANGED FAMILY #2.
; Mounted/unique bow families with a canonical skirmisher response.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player elephant-archer-line >= 3)
            (or
                (players-unit-type-count target-player bolas-rider-line >= 3)
                (or
                    (players-unit-type-count target-player mangudai-line >= 3)
                    (or
                        (players-unit-type-count target-player kipchak-line >= 3)
                        (or
                            (players-unit-type-count target-player camel-archer-line >= 3)
                            (or
                                (players-unit-type-count target-player genitour-line >= 3)
                                (or
                                    (players-unit-type-count target-player war-wagon-line >= 3)
                                    (or
                                        (players-unit-type-count target-player composite-bowman-line >= 3)
                                        (players-unit-type-count target-player ratha-ranged-line >= 3)
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
        (unit-type-count-total skirmisher-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; GUNPOWDER-CAVALRY FAMILY.
; Dedicated Conquistador/Arambai branch. These are mounted gunpowder
; specialists, not ordinary bow-ranged cavalry. At exact parity,
; require at least minimal skirmisher presence before attack authority.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player conquistador-line >= 3)
            (players-unit-type-count target-player arambai-line >= 3)
        )
        (unit-type-count-total skirmisher-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; ELEPHANT-SPECIALIST FAMILY.
; Ballista and Armored/Siege Elephant lines are elephant/siege specialists,
; but their stable Byzantine parity counter remains the Spearman line.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player ballista-elephant-line >= 3)
            (players-unit-type-count target-player armored-elephant-line >= 3)
        )
        (unit-type-count-total spearman-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; SPECIALIST-MELEE-INFANTRY FAMILY.
; Fire Lancer, Liao Dao, and Ibirapema are infantry specialists with a
; stable Archer-line counter relationship.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player fire-lancer-line >= 3)
            (or
                (players-unit-type-count target-player liao-dao-line >= 3)
                (players-unit-type-count target-player ibirapema-warrior-line >= 3)
            )
        )
        (unit-type-count-total archer-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; RANGED-MELEE SPECIALIST FAMILY.
; Throwing Axemen retain a clean Skirmisher counter relationship.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (players-unit-type-count target-player throwing-axeman-line >= 3)
        (unit-type-count-total skirmisher-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; HAND-CANNONEER FAMILY.
; Hand Cannoneers carry the archer armor class, so the canonical cheap
; Byzantine response is a minimum Skirmisher presence at exact parity.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (players-unit-type-count target-player hand-cannoneer >= 3)
        (unit-type-count-total skirmisher-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; MAMELUKE FAMILY.
; Mamelukes are cavalry-class but function as ranged anti-cavalry specialists.
; At exact parity, require minimum archer-line presence before attack authority.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (players-unit-type-count target-player mameluke-line >= 3)
        (unit-type-count-total archer-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; SPEAR / ANTI-CAVALRY INFANTRY FAMILY.
; Generic Spearman -> Pikeman -> Halberdier plus the Kamayuk specialist.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player spearman-line >= 4)
            (players-unit-type-count target-player kamayuk-line >= 3)
        )
        (unit-type-count-total archer-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

;
; Q: "How does the AI actually form an army?"
;
; We do not manually move ten units.
;
; The engine's attack-group system handles gathering.
;
; minimum group size = 10
; gather spacing      = 5
; attack allocation   = 70%
; Q: "When should the first deliberate attack happen?"
;
; After:
;   Feudal+
;   enemy located
;   attack group is actually available
;   town is not currently under attack
;   no other attack cycle is active
(defrule
    (timer-triggered bt-attack-timer)
    (current-age >= feudal-age)
    (players-building-count any-enemy > 0)
    (players-building-count target-player > 0)
    (military-population >= 10)
    (up-compare-goal bt-relative-force-goal >= 0)
    (goal bt-counter-veto-goal 0)
    (goal attack-goal 0)
    (goal retreat-now-goal 0)
    (not (town-under-attack))
=>
    ; Mark the attack cycle active BEFORE attack-now.
    (set-goal attack-goal 1)

    
    ; Force the available attack units into an attack-group.
    ;
    ; attack-now should NOT be spammed.
    (attack-now)

    ; Hold the attack cycle for five minutes before resetting it.
    (enable-timer bt-attack-timer 300)
    

)

;================================================================
; 19. ATTACK CYCLE RESET
;================================================================
;
; Q: "How do we regain script control after attack-now?"
;
; UserPatch supplies up-reset-attack-now for exactly this purpose.
(defrule
    (timer-triggered bt-attack-timer)
    (goal attack-goal 1)
=>
    (up-reset-attack-now)

    
    ; End this attack cycle.
    (set-goal attack-goal 0)

    ; Cooldown before another attack command.
    (enable-timer bt-attack-timer 180)
    

)

;================================================================
; 20. RETREAT
;================================================================
;
; Q: "When does a human player abandon the attack?"
;
; Here:
;
;   attack is active
;   +
;   town is under attack
;   ->
;   recall military
;
; The rule is deliberately broad and conservative.
;
; up-retreat-now recalls military units toward the home Town Center.
(defrule
    (goal attack-goal 1)
    (goal retreat-now-goal 0)
    (or
        (town-under-attack)
        (and
            (players-building-count target-player > 0)
            (up-compare-goal bt-relative-force-goal < -5)
        )
    )
    (attack-soldier-count >= 6)
=>
    (set-goal retreat-now-goal 1)

    
    ; Stop the persistent attack-now targeting.
    (up-reset-attack-now)

    ; Recall military forces.
    (up-retreat-now)

    ; End the attack cycle.
    (set-goal attack-goal 0)

    ; Stop the existing attack cooldown.
    (disable-timer bt-attack-timer)

    ; Prevent repeated retreat commands.
    (enable-timer bt-retreat-timer 120)
    

)

;================================================================
; 21. RETREAT RELEASE
;================================================================
(defrule
    (timer-triggered bt-retreat-timer)
    (goal retreat-now-goal 1)
=>
    (set-goal retreat-now-goal 0)

    
    ; Let the army regroup at home before another attack opportunity.
    (enable-timer bt-attack-timer 180)
    

)

;================================================================
; 22. PIKEMAN RESEARCH
;================================================================
;
; Q: "When does the composition earn its upgrade?"
;
; Existing spear mass + real cavalry threat + free resource claim.
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (or
    (goal unit-goal spearman-line)
    (goal unit-goal bt-unit-mix)
    )
    (unit-type-count-total spearman-line >= 6)
    (or
(players-unit-type-count any-enemy knight-line >= 6)
(or
(players-unit-type-count any-enemy camel-line >= 6)
(or
(players-unit-type-count any-enemy cataphract-line >= 6)
(players-unit-type-count any-enemy scout-cavalry-line >= 6))))
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-pikeman)
=>
    (set-strategic-number sn-resource-control ri-pikeman)
    (release-escrow food)
    (release-escrow gold)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-pikeman)
)

; Q: "What proves the Pikeman claim is finished?"
;
; research-complete is the terminal witness.
(defrule
    (strategic-number sn-resource-control == ri-pikeman)
    (up-research-status c: ri-pikeman == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

;================================================================
; 23. ELITE SKIRMISHER RESEARCH
;================================================================
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (or
    (goal unit-goal skirmisher-line)
    (goal unit-goal bt-unit-mix)
    )
    (unit-type-count-total skirmisher-line >= 6)
    (or
    (players-unit-type-count any-enemy archer-line >= 6)
    (players-unit-type-count any-enemy cavalry-archer-line >= 6)
    )
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-elite-skirmisher)
=>
    (set-strategic-number sn-resource-control ri-elite-skirmisher)
    (release-escrow food)
    (release-escrow gold)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-elite-skirmisher)
)

; Q: "What proves the Elite Skirmisher claim is finished?"
;
; research-complete is the terminal witness.
(defrule
    (strategic-number sn-resource-control == ri-elite-skirmisher)
    (up-research-status c: ri-elite-skirmisher == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

;================================================================
; RESEARCH / AGE CLAIM WATCHDOG RECOVERY
;================================================================
; Q: "When should a research claim be released without success?"
;
; Only when the timer expires AND the claimed research is no longer
; pending.  A pending research remains owner of the shared mutex.
;
; research-available = 1
; research-pending   = 2
; research-complete  = 3
;
; Therefore status <= research-available means the research is not
; pending and has not completed. The watchdog is recovery only.
; It never retries research or starts another claim.
;
; Age recovery also restores normal villager production because the
; age-claim path disabled train-civ-goal during the attempt.
;----------------------------------------------------------------
; LOOM WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == ri-loom)
    (up-research-status c: ri-loom <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

;----------------------------------------------------------------
; FEUDAL AGE WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == feudal-age)
    (current-age < feudal-age)
    (up-research-status c: feudal-age <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal train-civ-goal 1)
)

;----------------------------------------------------------------
; CASTLE AGE WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == castle-age)
    (current-age < castle-age)
    (up-research-status c: castle-age <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal train-civ-goal 1)
)

;----------------------------------------------------------------
; IMPERIAL AGE WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == imperial-age)
    (current-age < imperial-age)
    (up-research-status c: imperial-age <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal train-civ-goal 1)
)

;----------------------------------------------------------------
; COMPLETED AGE RESEARCH WITHOUT AGE-STATE ADVANCE
;
; A completed age research normally implies that current-age advances.
; If the research is already complete but the world-state witness has
; not advanced when the watchdog fires, release only the controller
; claim. Do not cancel/reset research.
(defrule
    (timer-triggered bt-research-watchdog-timer)
    (or
        (and
            (strategic-number sn-resource-control == feudal-age)
            (current-age < feudal-age)
            (up-research-status c: feudal-age == research-complete)
        )
        (and
            (strategic-number sn-resource-control == castle-age)
            (current-age < castle-age)
            (up-research-status c: castle-age == research-complete)
        )
        (and
            (strategic-number sn-resource-control == imperial-age)
            (current-age < imperial-age)
            (up-research-status c: imperial-age == research-complete)
        )
    )
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal train-civ-goal 1)
)

