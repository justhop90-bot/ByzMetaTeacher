    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-scale-barding)
    (goal bt-research-blacksmith-claim-goal 0)
    (goal bt-research-cavalry-counter-package-goal 0)
    (goal bt-research-ranged-counter-package-goal 0)
=>
    (set-strategic-number sn-resource-control ri-scale-barding)
