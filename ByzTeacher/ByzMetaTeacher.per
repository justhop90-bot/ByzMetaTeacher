(defconst bt-castle-prereq-failure-goal 60)
(defconst bt-castle-prereq-diagnostic-goal 61)
(defconst bt-castle-prereq-failure-blacksmith 1)
(defconst bt-castle-prereq-failure-market 2)
(defconst bt-imperial-prereq-failure-goal 62)
