;================================================================
; 2. INITIALIZATION
;================================================================
; Q: "What must be true before any strategic rule starts?"
;
; One initialization rule establishes known runtime state.
















; 15. PRODUCTION CAPACITY
;================================================================
;================================================================
; 15. PRODUCTION CAPACITY
;================================================================
;
; Q: "How do strategy and unit-goal change actual production?"
;
; They become prerequisites for production-building rules.
;
; IMPORTANT:
;   sn-resource-control must be 0.
;
; If an age/research claim owns the bank, military production waits.
; This is the conservative resource arbitration rule.
;---------------------------------------------------------------
; 15A. BARRACK CAPACITY
;---------------------------------------------------------------
; Standing-army demand supplies the persistent late-game capacity
; signal.  It does not replace threat-driven FLUSH capacity.


;================================================================
; 23. PIKEMAN RESEARCH
;================================================================

;
; Q: "When does the composition earn its upgrade?"
;
; Existing spear mass + real cavalry threat + free resource claim.




(defrule
    (up-compare-goal bt-research-archery-range-claim-goal != 0)
    (building-type-count archery-range == 0)
=>
    (set-goal bt-research-archery-range-claim-goal 0)
    (set-goal bt-research-ranged-counter-package-goal 0)
)

(defrule
    (up-compare-goal bt-research-stable-claim-goal != 0)
    (building-type-count stable == 0)
=>
    (set-goal bt-research-stable-claim-goal 0)
    (set-goal bt-research-cavalry-counter-package-goal 0)
)

(defrule
    (up-compare-goal bt-research-siege-workshop-claim-goal != 0)
    (building-type-count siege-workshop == 0)
=>
    (set-goal bt-research-siege-workshop-claim-goal 0)
    (set-goal bt-research-siege-package-goal 0)
)

;----------------------------------------------------------------
; MONASTERY RESEARCH CAPABILITY LOSS / FAILURE RECOVERY
;----------------------------------------------------------------
(defrule
    (up-compare-goal bt-research-monastery-claim-goal != 0)
    (building-type-count monastery == 0)
=>
    (set-goal bt-research-monastery-claim-goal 0)
    (set-goal bt-research-monk-package-goal 0)
)
(defrule
    (goal bt-research-monastery-claim-goal ri-atonement)
    (up-research-status c: ri-atonement <= research-available)
=>
    (set-goal bt-research-monastery-failure-backoff-goal ri-atonement)
    (enable-timer bt-research-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-monastery-claim-goal 0)
    (set-goal bt-research-monk-package-goal 0)
)
(defrule
    (goal bt-research-monastery-claim-goal ri-redemption)
    (up-research-status c: ri-redemption <= research-available)
=>
    (set-goal bt-research-monastery-failure-backoff-goal ri-redemption)
    (enable-timer bt-research-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-monastery-claim-goal 0)
    (set-goal bt-research-monk-package-goal 0)
)
(defrule
    (goal bt-research-monastery-claim-goal ri-sanctity)
    (up-research-status c: ri-sanctity <= research-available)
=>
    (set-goal bt-research-monastery-failure-backoff-goal ri-sanctity)
    (enable-timer bt-research-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-monastery-claim-goal 0)
    (set-goal bt-research-monk-package-goal 0)
)
(defrule
    (goal bt-research-monastery-claim-goal ri-block-printing)
    (up-research-status c: ri-block-printing <= research-available)
=>
    (set-goal bt-research-monastery-failure-backoff-goal ri-block-printing)
    (enable-timer bt-research-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-monastery-claim-goal 0)
    (set-goal bt-research-monk-package-goal 0)
)

;----------------------------------------------------------------
; RESEARCH FAILURE FAIRNESS BACKOFF
;
; A failed Blacksmith research action leaves the technology at
; research-available. The watchdog records that technology here for a
; bounded 30-second exclusion so another eligible research claim can own the
; shared research mutex. This is fairness state, not a retry scheduler.
(defrule
    (timer-triggered bt-research-failure-backoff-timer)
=>
    (disable-timer bt-research-failure-backoff-timer)
    (set-goal bt-research-failure-backoff-goal 0)
    (set-goal bt-research-town-center-failure-backoff-goal 0)
    (set-goal bt-research-mill-failure-backoff-goal 0)
    (set-goal bt-research-lumber-camp-failure-backoff-goal 0)
    (set-goal bt-research-mining-camp-failure-backoff-goal 0)
    (set-goal bt-research-blacksmith-failure-backoff-goal 0)
    (set-goal bt-research-university-failure-backoff-goal 0)
    (set-goal bt-research-castle-failure-backoff-goal 0)
    (set-goal bt-research-barracks-failure-backoff-goal 0)
    (set-goal bt-research-archery-range-failure-backoff-goal 0)
    (set-goal bt-research-stable-failure-backoff-goal 0)
    (set-goal bt-research-siege-workshop-failure-backoff-goal 0)
    (set-goal bt-research-monastery-failure-backoff-goal 0)
)

;================================================================
; RESEARCH / AGE CLAIM WATCHDOG RECOVERY
;================================================================
; Q: "When should a research claim be released without success?"
;
; Only when the timer expires AND the claimed research is no longer
; pending.  A pending research remains owner of the shared mutex.
;
; research-available = 1
; research-pending   = 2
; research-complete  = 3
;
; Therefore status <= research-available means the research is not
; pending and has not completed. The watchdog is recovery only.
; It never retries research or starts another claim.
;
; Age recovery also restores normal villager production because the
; age-claim path disabled train-civ-goal during the attempt.
;----------------------------------------------------------------
; LOOM WATCHDOG EXPIRY
(defrule
    (goal bt-research-town-center-claim-goal ri-loom)
    (up-research-status c: ri-loom <= research-available)
=>
    (set-goal bt-research-town-center-failure-backoff-goal ri-loom)
    (enable-timer bt-research-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-town-center-claim-goal 0)
)

;----------------------------------------------------------------
; FEUDAL AGE WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == feudal-age)
    (current-age < feudal-age)
    (up-research-status c: feudal-age <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-goal bt-research-failure-backoff-goal feudal-age)
    (enable-timer bt-research-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-strategic-number sn-resource-control 0)
    (set-goal train-civ-goal 1)
)

;----------------------------------------------------------------
; CASTLE AGE WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == castle-age)
    (current-age < castle-age)
    (up-research-status c: castle-age <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-goal bt-research-failure-backoff-goal castle-age)
    (enable-timer bt-research-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-strategic-number sn-resource-control 0)
    (set-goal train-civ-goal 1)
)

;----------------------------------------------------------------
; IMPERIAL AGE WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == imperial-age)
    (current-age < imperial-age)
    (up-research-status c: imperial-age <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-goal bt-research-failure-backoff-goal imperial-age)
    (enable-timer bt-research-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-strategic-number sn-resource-control 0)
    (set-goal train-civ-goal 1)
)

;----------------------------------------------------------------
; COMPLETED AGE RESEARCH WITHOUT AGE-STATE ADVANCE
;
; A completed age research normally implies that current-age advances.
; If the research is already complete but the world-state witness has
; not advanced when the watchdog fires, release only the controller
; claim. Do not cancel/reset research.
(defrule
    (timer-triggered bt-research-watchdog-timer)
    (or (and (strategic-number sn-resource-control == feudal-age) (and (current-age < feudal-age) (up-research-status c: feudal-age == research-complete))) (or (and (strategic-number sn-resource-control == castle-age) (and (current-age <
castle-age) (up-research-status c: castle-age == research-complete))) (and (strategic-number sn-resource-control == imperial-age) (and (current-age < imperial-age) (up-research-status c: imperial-age == research-complete)))))
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal train-civ-goal 1)
)

