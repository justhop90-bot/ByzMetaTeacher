;================================================================
; BELISARIUS BYZANTINE TEACHING AI
; FINAL INTEGRATED TEACHING VERSION
;
; PURPOSE
;   Teach practical AoE2DE .per scripting while producing a small,
;   coherent Byzantine AI controller.
;
; CONTROL LOOP
;
;   SCOUT
;      ->
;   OBSERVE
;      ->
;   STRATEGY-GOAL
;      ->
;   UNIT-GOAL
;      ->
;   PRODUCTION ARBITRATION
;      ->
;   ARMY GATHERING
;      ->
;   ATTACK
;      ->
;   RETREAT IF NEEDED
;      ->
;   REASSESS
;
; COMMUNITY-STYLE CONSTANTS
;
;   attack-goal       = 2
;   strategy-goal     = 3
;   unit-goal         = 4
;   train-civ-goal    = 5
;   sn-resource-control = 191
;
;   flush = 200
;   rush  = 201
;   boom  = 202
;   mix   = 1
;
;   scouting timer = 3
;   attack timer   = 4
;   retreat timer  = 15
;
;   group-type-land-explore = 101
;
; IMPORTANT
;   This is a standalone teaching controller.
;   Do not load another controller that defines the same constants,
;   goals, timers, or owns the same strategy/unit-production state.
;
; REMOVE OLD DIRECT MILITARY TRAIN RULES
;
;   Old architecture:
;       enemy cavalry -> train spear
;       enemy archers -> train skirm
;       enemy spears  -> train archer
;
;   New architecture:
;       enemy observation
;           ->
;       strategy-goal
;           ->
;       unit-goal
;           ->
;       centralized military production
;
;================================================================
;================================================================
; 0. ENGINE / COMMUNITY DEFINITIONS
;================================================================
; Q: "What is sn-resource-control?"
;
; Strategic number 191.
; It is the resource-claim register used by established .per AIs.
;
; Teaching values:
;
;   0            = no strategic claim
;   feudal-age   = Feudal claim owns the bank
;   castle-age   = Castle claim owns the bank
;   imperial-age = Imperial claim owns the bank
;   ri-*         = technology owns the bank only for the start action; the
;                  global claim is released immediately after research is issued
;
(defconst sn-resource-control 191)

; Q: "What is attack-goal?"
;
; Community goal 2.
; We use value 1 to mean that an attack cycle is currently active.
(defconst attack-goal 2)

; Q: "What is strategy-goal?"
;
; Community goal 3.
; It stores the broad economic/military posture.
(defconst strategy-goal 3)

; Q: "What is unit-goal?"
;
; Community goal 4.
; It stores the composition the military layer currently wants.
(defconst unit-goal 4)

; Q: "What is train-civ-goal?"
;
; Community goal 5.
;
; Established convention:
;   1  = normal villager production
;   !=1 = normal villager production disabled
(defconst train-civ-goal 5)

; Retreat state is the established community goal 20.
(defconst retreat-now-goal 20)

; Community strategy values.
(defconst bt-strategy-flush 200)
(defconst bt-strategy-rush 201)
(defconst bt-strategy-boom 202)

; TC resource-claim values use currently unused high strategic-number IDs.
; They are state values stored in the existing sn-resource-control mutex.
(defconst bt-tc2-claim 510)
(defconst bt-tc3-claim 509)

; Castle -> Imperial prerequisite build claims.
(defconst bt-imperial-siege-claim 512)
(defconst bt-imperial-university-claim 511)

