    (current-age == feudal-age)
    (strategic-number sn-food-gatherer-percentage < 55)
    (civilian-population >= 40)
    (civilian-population < 50)
=>
    (set-goal bt-farm-demand-band-goal bt-farm-demand-high)
    (set-goal bt-farm-transition-reserve-goal 4)
    (set-goal bt-farm-depleted-reserve-goal 6)
)
