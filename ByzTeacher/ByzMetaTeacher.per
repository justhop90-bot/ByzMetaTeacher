; Mill resource claim. The mill is an owner of the existing
; sn-resource-control mutex while its construction is in flight.
(defconst bt-mill-claim 524)
(defconst bt-mill-backoff-goal 606)

; Military Mangonel Workshop claim. This is a transient owner of the
; existing sn-resource-control mutex while the required Workshop build
; is in flight. It is deliberately distinct from the Imperial prerequisite
; Workshop claim so the two lifecycles cannot release each other's state.
(defconst bt-military-siege-workshop-claim 503)

; Mill food-infrastructure lifecycle state.
;
; target-goal = desired completed mill count.
; project-goal = the completed mill count the current mill project must reach.
;
; The second-mill trigger is a simplified Naga-derived scaling rule:
;   1 completed TC  -> 18 farms
;   2+ completed TCs -> 20 farms
; This is equivalent to a 16 + 2*min(TCs, 2) farm threshold.
; The target deliberately stops at two mills because this controller's
; farm capacity currently stops at 24; a third mill needs a later placement
; and food-density proof rather than another speculative threshold.
(defconst bt-mill-target-goal 525)
(defconst bt-mill-project-goal 526)
(defconst bt-mill-second-farm-threshold-1tc 18)
(defconst bt-mill-second-farm-threshold-2tc 20)
(defconst bt-mill-third-farm-threshold-3tc 22)
(defconst bt-mill-third-farm-threshold-4tc 24)

