                (up-compare-goal bt-standing-skirm-target-goal >= bt-skirm-target-2)
                (and
                    (unit-type-count-total skirmisher-line >= bt-skirm-target-2)
                    (and
                    (up-compare-goal bt-ranged-counter-level-goal >= 2)
                    (goal bt-ranged-threat-goal 1)
                                    )
                )
            )
            (and
                (unit-type-count-total cavalry-archer >= 6)
                (goal bt-ranged-threat-goal 1)
            )
        )
    )
    (up-research-status c: ri-bracer < research-pending)
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (not (goal bt-resource-mode-goal bt-resource-mode-food-crisis))
    (not (goal bt-resource-mode-goal bt-resource-mode-gold-crisis))
    (up-compare-goal bt-research-blacksmith-bracer-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-bracer)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-bracer)
    (goal bt-research-blacksmith-claim-goal 0)
    (goal bt-research-ranged-counter-package-goal ri-bracer)
=>
    (set-strategic-number sn-resource-control ri-bracer)
    (release-escrow food)
    (release-escrow gold)
    (research ri-bracer)
    (set-goal bt-research-blacksmith-claim-goal ri-bracer)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-research-blacksmith-claim-goal ri-bracer)
    (up-research-status c: ri-bracer == research-complete)
=>
    (set-goal bt-research-blacksmith-bracer-retry-goal 0)
    (set-goal bt-research-blacksmith-claim-goal 0)
)

(defrule
    (current-age >= imperial-age)
    (building-type-count blacksmith >= 1)
