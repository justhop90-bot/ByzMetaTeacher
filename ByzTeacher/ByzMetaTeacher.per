;----------------------------------------------------------------
; MONASTERY RESEARCH CAPABILITY LOSS / FAILURE RECOVERY
;----------------------------------------------------------------
(defrule
    (up-compare-goal bt-research-monastery-claim-goal != 0)
    (building-type-count monastery == 0)
=>
    (set-goal bt-research-monastery-claim-goal 0)
    (set-goal bt-research-monk-package-goal 0)
)
(defrule
    (goal bt-research-monastery-claim-goal ri-atonement)
    (up-research-status c: ri-atonement <= research-available)
=>
    (up-modify-goal bt-research-monk-atonement-retry-goal g:+ 1)
    (set-goal bt-research-monastery-failure-backoff-goal ri-atonement)
    (enable-timer bt-research-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-monastery-claim-goal 0)
    (set-goal bt-research-monk-package-goal 0)
)
