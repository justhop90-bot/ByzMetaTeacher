)
(defrule
    (goal bt-paladin-demand-goal 1)
    (or (current-age < imperial-age) (or (not (goal unit-goal knight-line)) (or (up-research-status c: ri-cavalier != research-complete) (or (unit-type-count-total knight-line < bt-knight-target-late) (or (unit-type-count villager < 60)
(or (not (up-research-status c: ri-paladin < research-pending)) (or (goal bt-cataphract-demand-goal 1) (or (goal bt-bombard-cannon-demand-goal 1) (or (goal bt-resource-mode-goal bt-resource-mode-imperial-bank) (or (goal
bt-resource-mode-goal bt-resource-mode-imperial-bank-prep) (or (goal bt-resource-mode-goal bt-resource-mode-food-crisis) (goal bt-resource-mode-goal bt-resource-mode-gold-crisis))))))))))))
=>
