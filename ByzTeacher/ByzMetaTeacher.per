;================================================================
; BELISARIUS BYZANTINE TEACHING AI
; FINAL INTEGRATED TEACHING VERSION
;
; PURPOSE
;   Teach practical AoE2DE .per scripting while producing a small,
;   coherent Byzantine AI controller.
;
; CONTROL LOOP
;
;   SCOUT
;      ->
;   OBSERVE
;      ->
;   STRATEGY-GOAL
;      ->
;   UNIT-GOAL
;      ->
;   PRODUCTION ARBITRATION
;      ->
;   ARMY GATHERING
;      ->
;   ATTACK
;      ->
;   RETREAT IF NEEDED
;      ->
;   REASSESS
;
; COMMUNITY-STYLE CONSTANTS
;
;   attack-goal       = 2
;   strategy-goal     = 3
;   unit-goal         = 4
;   train-civ-goal    = 5
;   sn-resource-control = 191
;
;   flush = 200
;   rush  = 201
;   boom  = 202
;   mix   = 1
;
;   scouting timer = 3
;   attack timer   = 4
;   retreat timer  = 15
;
;   group-type-land-explore = 101
;
; IMPORTANT
;   This is a standalone teaching controller.
;   Do not load another controller that defines the same constants,
;   goals, timers, or owns the same strategy/unit-production state.
;
; REMOVE OLD DIRECT MILITARY TRAIN RULES
;
;   Old architecture:
;       enemy cavalry -> train spear
;       enemy archers -> train skirm
;       enemy spears  -> train archer
;
;   New architecture:
;       enemy observation
;           ->
;       strategy-goal
;           ->
;       unit-goal
;           ->
;       centralized military production
;
;================================================================
;================================================================
; 0. ENGINE / COMMUNITY DEFINITIONS
;================================================================
; Q: "What is sn-resource-control?"
;
; Strategic number 191.
; It is the resource-claim register used by established .per AIs.
;
; Teaching values:
;
;   0            = no strategic claim
;   feudal-age   = Feudal claim owns the bank
;   castle-age   = Castle claim owns the bank
;   imperial-age = Imperial claim owns the bank
;   ri-*         = specific technology owns the bank
;
(defconst sn-resource-control 191)

; Q: "What is attack-goal?"
;
; Community goal 2.
; We use value 1 to mean that an attack cycle is currently active.
(defconst attack-goal 2)

; Q: "What is strategy-goal?"
;
; Community goal 3.
; It stores the broad economic/military posture.
(defconst strategy-goal 3)

; Q: "What is unit-goal?"
;
; Community goal 4.
; It stores the composition the military layer currently wants.
(defconst unit-goal 4)

; Q: "What is train-civ-goal?"
;
; Community goal 5.
;
; Established convention:
;   1  = normal villager production
;   !=1 = normal villager production disabled
(defconst train-civ-goal 5)

; Retreat state is the established community goal 20.
(defconst retreat-now-goal 20)

; Community strategy values.
(defconst bt-strategy-flush 200)
(defconst bt-strategy-rush 201)
(defconst bt-strategy-boom 202)

; TC resource-claim values use currently unused high strategic-number IDs.
; They are state values stored in the existing sn-resource-control mutex.
(defconst bt-tc2-claim 510)
(defconst bt-tc3-claim 509)

; Community mixed-composition value.
(defconst bt-unit-mix 1)

; Existing/community timer identifiers.
(defconst bt-scouting-timer 3)
(defconst bt-attack-timer 4)
(defconst bt-retreat-timer 15)

; Script-local TC watchdog timer IDs, verified unused in this repo.
(defconst bt-tc2-watchdog-timer 16)
(defconst bt-tc3-watchdog-timer 17)

; Script-local research/age watchdog timer.
(defconst bt-research-watchdog-timer 18)

; Watchdog interval is controller tuning, not an engine constant.
; It must exceed the longest legitimate research time it guards.
(defconst bt-research-watchdog-seconds 240)

; Community land-exploration group.
(defconst bt-land-explore-group 101)

(defconst bt-cavalry-threat-goal 33)
(defconst bt-ranged-threat-goal 34)
(defconst bt-spear-threat-goal 35)
(defconst bt-any-threat-goal 36)
(defconst bt-cavalry-level-goal 37)
(defconst bt-cavalry-counter-level-goal 42)
(defconst bt-ranged-level-goal 38)
(defconst bt-ranged-counter-level-goal 43)
(defconst bt-spear-level-goal 39)
(defconst bt-spear-counter-level-goal 44)
(defconst bt-noncav-cavalry-level-goal 41)
(defconst bt-target-military-scratch-goal 505)
(defconst bt-relative-force-goal 506)
(defconst bt-counter-veto-goal 504)

;================================================================
; 1. TEACHING CONSTANTS
;================================================================
; Q: "How do I stop repeating magic numbers?"
;
; defconst creates a fixed compile-time name.
; It is not mutable runtime state.
(defconst bt-feudal-villagers 21)
(defconst bt-castle-villagers 30)
(defconst bt-imperial-villagers 50)

(defconst bt-imperial-food 667)
(defconst bt-imperial-gold 536)

; Farm-tech lifecycle tuning.
(defconst bt-farm-feudal-cap 6)
(defconst bt-farm-castle-cap 12)
(defconst bt-farm-imperial-cap 24)
(defconst bt-farm-feudal-emergency-food 150)
(defconst bt-farm-castle-food-threshold 500)
(defconst bt-farm-castle-emergency-food 200)
(defconst bt-farm-imperial-food-threshold 700)
(defconst bt-farm-build-wood 60)

; Military composition targets.
(defconst bt-spear-target-1 6)
(defconst bt-spear-target-2 16)
(defconst bt-spear-target-3 24)

(defconst bt-skirm-target-1 6)
(defconst bt-skirm-target-2 16)
(defconst bt-skirm-target-3 24)

(defconst bt-camel-target-1 4)
(defconst bt-camel-target-2 8)

; Production-capacity ceilings.
;
; These are teaching/controller tuning values, not engine constants.
(defconst bt-max-barracks 10)
(defconst bt-max-ranges 7)

;================================================================
; 2. INITIALIZATION
;================================================================
; Q: "What must be true before any strategic rule starts?"
;
; One initialization rule establishes known runtime state.
(defrule
    (true)
=>
    (set-strategic-number sn-resource-control 0)
    (set-escrow-percentage food 30)
    (set-escrow-percentage wood 30)
    (set-escrow-percentage gold 30)
    (set-escrow-percentage stone 0)
    (set-goal train-civ-goal 1)
    (disable-self)
)

(defrule
    (true)
=>
    (set-goal strategy-goal bt-strategy-boom)
    (set-goal unit-goal bt-unit-mix)
    (set-goal attack-goal 0)
    (set-goal retreat-now-goal 0)
    (set-goal bt-cavalry-threat-goal 0)
    (set-goal bt-ranged-threat-goal 0)
    (set-goal bt-spear-threat-goal 0)
    (set-goal bt-any-threat-goal 0)
    (set-goal bt-cavalry-level-goal 0)
    (set-goal bt-cavalry-counter-level-goal 0)
    (set-goal bt-ranged-level-goal 0)
    (set-goal bt-ranged-counter-level-goal 0)
    (set-goal bt-spear-level-goal 0)
    (set-goal bt-spear-counter-level-goal 0)
    (set-goal bt-noncav-cavalry-level-goal 0)
    (disable-self)
)

(defrule
    (true)
=>
    (set-strategic-number sn-number-explore-groups 1)
    (set-strategic-number sn-total-number-explorers 1)
    (set-strategic-number sn-minimum-attack-group-size 10)
    (set-strategic-number sn-attack-group-gather-spacing 5)
    (set-strategic-number sn-percent-attack-soldiers 70)
    (set-strategic-number sn-attack-group-size-randomness 0)
    (set-strategic-number sn-scale-minimum-attack-group-size 0)
    (set-strategic-number sn-scale-maximum-attack-group-size 0)
    (set-strategic-number sn-gather-defense-units 1)
    (enable-timer bt-scouting-timer 120)
    (enable-timer bt-attack-timer 900)
    (disable-timer bt-retreat-timer)
    (disable-timer bt-tc2-watchdog-timer)
    (disable-timer bt-tc3-watchdog-timer)
    (disable-timer bt-research-watchdog-timer)
    (disable-self)
)

;================================================================
; 3. LOOM
;================================================================
; Q: "How do I write a technology rule?"
;
;   CONDITION
;       ->
;   CLAIM RESOURCE
;       ->
;   RELEASE ESCROW
;       ->
;   RESEARCH
;
; Loom costs gold, so gold escrow is released.
(defrule
    (current-age == dark-age)
    (unit-type-count villager >= 7)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-loom)
=>
    (set-strategic-number sn-resource-control ri-loom)
    (release-escrow gold)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-loom)
)

; Q: "How do I know the technology actually completed?"
;
; research-pending is not enough.
; The completion witness is research-complete.
; Q: "What proves the Loom claim is finished?"
;
; research-complete is the terminal witness. The watchdog is stopped
; before the shared mutex is released.
(defrule
    (strategic-number sn-resource-control == ri-loom)
    (up-research-status c: ri-loom == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

;================================================================
; 4. NORMAL VILLAGER PRODUCTION
;================================================================
; Q: "When is the TC allowed to make another villager?"
;
; The normal villager-training goal must be enabled.
; An active age claim overrides ordinary production.
(defrule
    (goal train-civ-goal 1)
    (strategic-number sn-resource-control != feudal-age)
    (strategic-number sn-resource-control != castle-age)
    (strategic-number sn-resource-control != imperial-age)
    (can-train villager)
    (population-headroom > 0)
    (not (can-research-with-escrow feudal-age))
    (not (can-research-with-escrow castle-age))
    (not (can-research-with-escrow imperial-age))
=>
    (train villager)
)

;================================================================
; 5. FEUDAL AGE
;================================================================
; Q: "How do I stop normal villager training without idling
; every Town Center?"
;
; Use train-civ-goal.
;
; Do NOT use up-reset-building on Town Centers here.
; That resets all TCs of the specified type.
(defrule
    (current-age == dark-age)
    (unit-type-count villager >= bt-feudal-villagers)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow feudal-age)
=>
    (set-strategic-number sn-resource-control feudal-age)
    (set-goal train-civ-goal -1)
    (release-escrow food)
    (release-escrow gold)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research feudal-age)
)

; Q: "What proves the age transition actually happened?"
;
; current-age is the world-state witness.
; Q: "What proves the Feudal claim is finished?"
;
; current-age is the world-state witness. Only then is the
; research watchdog stopped and normal villager production restored.
(defrule
    (strategic-number sn-resource-control == feudal-age)
    (current-age >= feudal-age)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal train-civ-goal 1)
)

;================================================================
; 6. CASTLE AGE
;================================================================
(defrule
    (current-age == feudal-age)
    (unit-type-count villager >= bt-castle-villagers)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow castle-age)
=>
    (set-strategic-number sn-resource-control castle-age)
    (set-goal train-civ-goal -1)
    (release-escrow food)
    (release-escrow gold)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research castle-age)
)

; Q: "What proves the Castle claim is finished?"
;
; current-age is the world-state witness. The normal villager goal
; stays disabled until the age transition is actually complete.
(defrule
    (strategic-number sn-resource-control == castle-age)
    (current-age >= castle-age)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal train-civ-goal 1)
)

;================================================================
; 7. IMPERIAL AGE
;================================================================
; Byzantine teaching thresholds:
;   667 food
;   536 gold
(defrule
    (current-age == castle-age)
    (unit-type-count villager >= bt-imperial-villagers)
    (food-amount >= bt-imperial-food)
    (gold-amount >= bt-imperial-gold)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow imperial-age)
=>
    (set-strategic-number sn-resource-control imperial-age)
    (set-goal train-civ-goal -1)
    (release-escrow food)
    (release-escrow gold)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research imperial-age)
)

; Q: "What proves the Imperial claim is finished?"
;
; current-age is the world-state witness. The watchdog is not allowed
; to release a still-running age transition.
(defrule
    (strategic-number sn-resource-control == imperial-age)
    (current-age >= imperial-age)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal train-civ-goal 1)
)

;================================================================
; 8. HOUSING
;================================================================
; Q: "How do I prevent a population-cap stall?"
(defrule
    (housing-headroom <= 4)
    (up-pending-objects c: house == 0)
    (can-build house)
=>
    (build house)
)

;================================================================
; 9. BASIC ECONOMIC BUILDINGS
;================================================================
(defrule
    (building-type-count-total lumber-camp == 0)
    (civilian-population >= 7)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)

(defrule
    (building-type-count-total mining-camp == 0)
    (civilian-population >= 8)
    (can-build mining-camp)
=>
    (build mining-camp)
)

(defrule
    (building-type-count-total mill == 0)
    (civilian-population >= 10)
    (can-build mill)
=>
    (build mill)
)

(defrule
    (building-type-count-total barracks == 0)
    (civilian-population >= 12)
    (can-build barracks)
=>
    (build barracks)
)

;================================================================
; 10. BOAR HUNTING / NATURAL-FOOD CONTROL
;================================================================
; Q: "How does a teaching AI turn the engine's native food system
; into a practical early-game food income?"
;
; Do NOT write a villager-by-villager food allocator here.
; The engine already owns normal food-source selection. Our job is
; to configure the native hunt controller when a live boar is close
; enough to justify it, then return control to normal hunting when
; the boar is gone or too far away.
;
; COMMUNITY META PATTERN:
;   live boar detected
;       ->
;   enable boar hunting
;       ->
;   require at least one hunter
;       ->
;   allow a one-villager lure
;       ->
;   request support hunters
;       ->
;   once the boar is under the TC, maintain the hunt group
;       ->
;   current boar nearly exhausted + another live boar available
;       -> reset to one-lurer mode for the next boar
;       ->
;   when no usable live boar remains, restore normal hunting
;
; This is deliberately smaller than a full food-economy model.
; The teaching point is that:
;
;   OBSERVATION
;       !=
;   MANUAL VILLAGER ASSIGNMENT
;
; The observation changes an engine-native subsystem's policy.
;
; The community references use dropsite-min-distance live-boar,
; sn-enable-boar-hunting, sn-minimum-number-hunters,
; sn-minimum-boar-lure-group-size, sn-minimum-boar-hunt-group-size,
; sn-maximum-hunt-drop-distance, and up-request-hunters.
;
; up-request-hunters is a request, not a guarantee. The engine may
; fail to reach the requested total when suitable villagers are not
; available.
;
;----------------------------------------------------------------
; 10A. INITIAL FOOD-HUNT POLICY
;----------------------------------------------------------------
; Start with normal hunting behavior. A later live-boar rule takes
; ownership only when the engine can actually see a live boar.
(defrule
    (true)
=>
    (set-strategic-number sn-enable-boar-hunting 1)
    (set-strategic-number sn-minimum-number-hunters 0)
    (set-strategic-number sn-minimum-boar-lure-group-size 0)
    (set-strategic-number sn-minimum-boar-hunt-group-size 0)
    (set-strategic-number sn-maximum-hunt-drop-distance 8)
    (disable-self)
)

;----------------------------------------------------------------
; 10B. START / MAINTAIN THE BOAR LURE
;----------------------------------------------------------------
; A live boar within 32 tiles is close enough for the engine's native
; hunt controller to use as the preferred early food source.
;
; The minimum hunter count of 1 creates the initial lurer.
; The lure group size of 1 keeps the opening deterministic.
(defrule
    (unit-type-count villager >= 9)
    (unit-type-count villager-hunter == 0)
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 32)
=>
    (set-strategic-number sn-enable-boar-hunting 2)
    (set-strategic-number sn-minimum-number-hunters 1)
    (set-strategic-number sn-minimum-boar-lure-group-size 1)
    (set-strategic-number sn-minimum-boar-hunt-group-size 1)
    (set-strategic-number sn-maximum-hunt-drop-distance 32)
    (set-strategic-number sn-maximum-food-drop-distance 16)
    (up-request-hunters c: 1)
)

;----------------------------------------------------------------
; 10C. SUPPORT THE ACTIVE BOAR UNDER THE TOWN CENTER
;----------------------------------------------------------------
; Once the boar is very close, use the community-standard hunt-group
; behavior: request a larger total hunting group rather than manually
; retasking individual villagers.
;
; Seven is a hunt-group target, not a promise that seven villagers
; will always be available.
(defrule
    (unit-type-count villager >= 9)
    (strategic-number sn-minimum-number-hunters < 7)
    (unit-type-count villager-hunter < 7)
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 10)
=>
    (set-strategic-number sn-enable-boar-hunting 2)
    (set-strategic-number sn-minimum-number-hunters 7)
    (set-strategic-number sn-minimum-boar-hunt-group-size 7)
    (up-request-hunters c: 6)
)

;----------------------------------------------------------------
; 10D. MOVE FROM A FINISHED BOAR TO THE NEXT LURE
;----------------------------------------------------------------
; live-boar deliberately reports the next living boar, while
; boar-hunting describes the nearest boar being hunted. The distinction
; matters after the first boar is down: using live-boar alone cannot tell
; us that the current hunt is nearly finished.
;
; up-remaining-boar-amount is valid only when a current/next boar exists;
; 65535 means there is no valid boar. Therefore <195 is a safe "current
; boar is low and another boar is available" signal.
;
; This is the smallest second-boar closure. We do not manually select a
; lurer or direct units. We simply return the native hunt controller to
; one-lurer mode so it can begin the next lure.
(defrule
    (strategic-number sn-enable-boar-hunting == 2)
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 32)
    (dropsite-min-distance boar-hunting >= 0)
    (dropsite-min-distance boar-hunting <= 10)
    (up-remaining-boar-amount < 195)
    (strategic-number sn-minimum-number-hunters > 1)
=>
    (set-strategic-number sn-minimum-number-hunters 1)
    (set-strategic-number sn-minimum-boar-hunt-group-size 1)
    (set-strategic-number sn-minimum-boar-lure-group-size 1)
    (up-request-hunters c: 1)
)

;----------------------------------------------------------------
; 10E. BOAR GONE / TOO FAR -> NORMAL HUNTING
;----------------------------------------------------------------
; Once no usable live boar is available, stop forcing the boar
; subsystem and let normal hunting choose deer/forage/farms.
(defrule
    (or
        (dropsite-min-distance live-boar == -1)
        (dropsite-min-distance live-boar > 32)
    )
=>
    (set-strategic-number sn-enable-boar-hunting 1)
    (set-strategic-number sn-minimum-number-hunters 0)
    (set-strategic-number sn-minimum-boar-lure-group-size 0)
    (set-strategic-number sn-minimum-boar-hunt-group-size 0)
    (set-strategic-number sn-maximum-hunt-drop-distance 8)
)

;================================================================
; 11. HORSE COLLAR
;================================================================
; Age advancement gets first resource claim.
; Horse Collar can only claim the bank if Castle is not currently
; researchable.
(defrule
    (current-age >= feudal-age)
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow castle-age))
    (can-research-with-escrow ri-horse-collar)
=>
    (set-strategic-number sn-resource-control ri-horse-collar)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-horse-collar)
)

; Q: "What proves the Horse Collar claim is finished?"
;
; research-complete is the terminal witness for the technology claim.
(defrule
    (strategic-number sn-resource-control == ri-horse-collar)
    (up-research-status c: ri-horse-collar == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

;================================================================
; 11A. CASTLE FARM TECHNOLOGY
;================================================================
; Heavy Plow is the Castle-age continuation of the Mill farm lifecycle.
; Castle Age itself still has priority: if Imperial is immediately
; researchable, the age claim keeps the shared resource bank.
(defrule
    (current-age >= castle-age)
    (up-research-status c: ri-horse-collar >= research-complete)
    (or
        (building-type-count-total farm >= bt-farm-feudal-cap)
        (and
            (food-amount < bt-farm-castle-food-threshold)
            (or
                (dropsite-min-distance deer-hunting == -1)
                (dropsite-min-distance deer-hunting == 255)
                (dropsite-min-distance deer-hunting s:> sn-maximum-hunt-drop-distance)
            )
        )
    )
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow imperial-age))
    (can-research-with-escrow ri-heavy-plow)
=>
    (set-strategic-number sn-resource-control ri-heavy-plow)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-heavy-plow)
)

(defrule
    (strategic-number sn-resource-control == ri-heavy-plow)
    (up-research-status c: ri-heavy-plow == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

;================================================================
; 11B. IMPERIAL FARM TECHNOLOGY
;================================================================
; Crop Rotation is the final Mill farm lifecycle step. At Imperial,
; there is no later age claim to outrank it, but the shared resource
; mutex still prevents it from colliding with every other technology.
(defrule
    (current-age >= imperial-age)
    (up-research-status c: ri-heavy-plow >= research-complete)
    (building-type-count-total farm >= bt-farm-castle-cap)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-crop-rotation)
=>
    (set-strategic-number sn-resource-control ri-crop-rotation)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-crop-rotation)
)

(defrule
    (strategic-number sn-resource-control == ri-crop-rotation)
    (up-research-status c: ri-crop-rotation == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

;================================================================
; 11. FARM TRANSITION
;================================================================
; Farm expansion follows the Mill technology lifecycle.
;
; Normal farm expansion is allowed once the relevant farm technology
; is pending or complete. The pending state is intentional: farms
; already under construction can finish after the technology completes.
;
; A low-food emergency bypass remains available so the AI cannot starve
; merely because the technology claim has not yet been reached.
(defrule
    (current-age >= feudal-age)
    (food-amount < 350)
    (idle-farm-count == 0)
    (or
        (dropsite-min-distance deer-hunting == -1)
        (dropsite-min-distance deer-hunting == 255)
        (dropsite-min-distance deer-hunting s:> sn-maximum-hunt-drop-distance)
    )
    (or
        (up-research-status c: ri-horse-collar >= research-pending)
        (food-amount < bt-farm-feudal-emergency-food)
    )
    (building-type-count-total farm < bt-farm-feudal-cap)
    (wood-amount >= bt-farm-build-wood)
    (can-build farm)
=>
    (build farm)
)

(defrule
    (current-age >= castle-age)
    (food-amount < bt-farm-castle-food-threshold)
    (idle-farm-count == 0)
    (or
        (dropsite-min-distance deer-hunting == -1)
        (dropsite-min-distance deer-hunting == 255)
        (dropsite-min-distance deer-hunting s:> sn-maximum-hunt-drop-distance)
    )
    (or
        (up-research-status c: ri-heavy-plow >= research-pending)
        (food-amount < bt-farm-castle-emergency-food)
    )
    (building-type-count-total farm < bt-farm-castle-cap)
    (wood-amount >= bt-farm-build-wood)
    (can-build farm)
=>
    (build farm)
)

; Imperial farm expansion consumes Crop Rotation completion as its
; authority and raises the existing 12-farm Castle ceiling.
(defrule
    (current-age >= imperial-age)
    (up-research-status c: ri-crop-rotation == research-complete)
    (food-amount < bt-farm-imperial-food-threshold)
    (idle-farm-count == 0)
    (or
        (dropsite-min-distance deer-hunting == -1)
        (dropsite-min-distance deer-hunting == 255)
        (dropsite-min-distance deer-hunting s:> sn-maximum-hunt-drop-distance)
    )
    (building-type-count-total farm < bt-farm-imperial-cap)
    (wood-amount >= bt-farm-build-wood)
    (can-build farm)
=>
    (build farm)
)

;================================================================
; 12. SCOUTING
;================================================================
; Q: "How does the AI deliberately search for the enemy?"
;
; up-send-scout directs a land/water scout to a strategic location.
;
; The community uses scout-flank for the opening search and
; scout-enemy after the enemy's town has actually been located.
;---------------------------------------------------------------
; 12A. INITIAL / REPEATED ENEMY SEARCH
;---------------------------------------------------------------
(defrule
    (timer-triggered bt-scouting-timer)
    (game-time >= 120)
    (players-building-count any-enemy <= 0)
    (strategic-number sn-number-explore-groups > 0)
=>
    (up-send-scout bt-land-explore-group scout-flank)
    (enable-timer bt-scouting-timer 120)
)

;---------------------------------------------------------------
; 12B. TARGETED ENEMY SCOUTING
;---------------------------------------------------------------
;
; scout-enemy is legal only after the target enemy has actually
; been located.
(defrule
    (timer-triggered bt-scouting-timer)
    (game-time >= 120)
    (players-building-count any-enemy > 0)
    (strategic-number sn-number-explore-groups > 0)
=>
    (up-send-scout bt-land-explore-group scout-enemy)
    (enable-timer bt-scouting-timer 180)
)

;================================================================
; 12C. ENEMY THREAT STATE
;----------------------------------------------------------------
; Threat booleans describe immediate counter categories.
; Capacity levels describe production-building demand.
; Counter levels preserve the original military-response thresholds.
(defrule
    (true)
=>
    (set-goal bt-cavalry-threat-goal 0)
    (set-goal bt-ranged-threat-goal 0)
    (set-goal bt-spear-threat-goal 0)
    (set-goal bt-any-threat-goal 0)
    (set-goal bt-cavalry-level-goal 0)
    (set-goal bt-cavalry-counter-level-goal 0)
    (set-goal bt-ranged-level-goal 0)
    (set-goal bt-ranged-counter-level-goal 0)
    (set-goal bt-spear-level-goal 0)
    (set-goal bt-spear-counter-level-goal 0)
    (set-goal bt-noncav-cavalry-level-goal 0)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 3)
        (or
            (players-unit-type-count any-enemy camel-line >= 3)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 3)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 3)
                    (players-unit-type-count any-enemy war-elephant-line >= 3)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-threat-goal 1)
    (set-goal bt-any-threat-goal 1)
)
(defrule
    (or
        (players-unit-type-count any-enemy archer-line >= 3)
        (players-unit-type-count any-enemy cavalry-archer-line >= 3)
    )
=>
    (set-goal bt-ranged-threat-goal 1)
    (set-goal bt-any-threat-goal 1)
)
(defrule
    (players-unit-type-count any-enemy spearman-line >= 4)
=>
    (set-goal bt-spear-threat-goal 1)
    (set-goal bt-any-threat-goal 1)
)
; Capacity levels: ranged 6/15/25, spears 8/12.
(defrule
    (or
        (players-unit-type-count any-enemy archer-line >= 6)
        (players-unit-type-count any-enemy cavalry-archer-line >= 6)
    )
=>
    (set-goal bt-ranged-level-goal 1)
)
(defrule
    (or
        (players-unit-type-count any-enemy archer-line >= 15)
        (players-unit-type-count any-enemy cavalry-archer-line >= 15)
    )
=>
    (set-goal bt-ranged-level-goal 2)
)
(defrule
    (or
        (players-unit-type-count any-enemy archer-line >= 25)
        (players-unit-type-count any-enemy cavalry-archer-line >= 25)
    )
=>
    (set-goal bt-ranged-level-goal 3)
)
(defrule
    (players-unit-type-count any-enemy spearman-line >= 8)
=>
    (set-goal bt-spear-level-goal 1)
)
(defrule
    (players-unit-type-count any-enemy spearman-line >= 12)
=>
    (set-goal bt-spear-level-goal 2)
)
; Counter levels preserve original military-response thresholds.
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 3)
        (or
            (players-unit-type-count any-enemy camel-line >= 3)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 3)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 3)
                    (players-unit-type-count any-enemy war-elephant-line >= 3)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-counter-level-goal 1)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 10)
        (or
            (players-unit-type-count any-enemy camel-line >= 10)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 10)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 10)
                    (players-unit-type-count any-enemy war-elephant-line >= 10)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-counter-level-goal 2)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 20)
        (or
            (players-unit-type-count any-enemy camel-line >= 20)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 20)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 20)
                    (players-unit-type-count any-enemy war-elephant-line >= 20)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-counter-level-goal 3)
)
(defrule
    (or
        (players-unit-type-count any-enemy archer-line >= 3)
        (players-unit-type-count any-enemy cavalry-archer-line >= 3)
    )
=>
    (set-goal bt-ranged-counter-level-goal 1)
)
(defrule
    (or
        (players-unit-type-count any-enemy archer-line >= 10)
        (players-unit-type-count any-enemy cavalry-archer-line >= 10)
    )
=>
    (set-goal bt-ranged-counter-level-goal 2)
)
(defrule
    (or
        (players-unit-type-count any-enemy archer-line >= 20)
        (players-unit-type-count any-enemy cavalry-archer-line >= 20)
    )
=>
    (set-goal bt-ranged-counter-level-goal 3)
)
(defrule
    (players-unit-type-count any-enemy spearman-line >= 4)
=>
    (set-goal bt-spear-counter-level-goal 1)
)
(defrule
    (players-unit-type-count any-enemy spearman-line >= 8)
=>
    (set-goal bt-spear-counter-level-goal 2)
)
; Non-Camel cavalry capacity: 10/15.
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 10)
        (or
            (players-unit-type-count any-enemy cataphract-line >= 10)
            (or
                (players-unit-type-count any-enemy scout-cavalry-line >= 10)
                (players-unit-type-count any-enemy war-elephant-line >= 10)
            )
        )
    )
=>
    (set-goal bt-noncav-cavalry-level-goal 1)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 15)
        (or
            (players-unit-type-count any-enemy cataphract-line >= 15)
            (or
                (players-unit-type-count any-enemy scout-cavalry-line >= 15)
                (players-unit-type-count any-enemy war-elephant-line >= 15)
            )
        )
    )
=>
    (set-goal bt-noncav-cavalry-level-goal 2)
)
; Cavalry production capacity: 6/15/25/40/55.
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 6)
        (or
            (players-unit-type-count any-enemy camel-line >= 6)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 6)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 6)
                    (players-unit-type-count any-enemy war-elephant-line >= 6)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-level-goal 1)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 15)
        (or
            (players-unit-type-count any-enemy camel-line >= 15)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 15)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 15)
                    (players-unit-type-count any-enemy war-elephant-line >= 15)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-level-goal 2)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 25)
        (or
            (players-unit-type-count any-enemy camel-line >= 25)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 25)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 25)
                    (players-unit-type-count any-enemy war-elephant-line >= 25)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-level-goal 3)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 40)
        (or
            (players-unit-type-count any-enemy camel-line >= 40)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 40)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 40)
                    (players-unit-type-count any-enemy war-elephant-line >= 40)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-level-goal 4)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 55)
        (or
            (players-unit-type-count any-enemy camel-line >= 55)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 55)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 55)
                    (players-unit-type-count any-enemy war-elephant-line >= 55)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-level-goal 5)
)

; 13. STRATEGY SELECTION
;================================================================
;
; Strategy answers:
;
;   "What kind of game are we playing right now?"
;
; It does NOT train units.
;
; Strategy values:
;
;   FLUSH = react to military pressure
;   RUSH  = convert a small prepared army into pressure
;   BOOM  = prioritize economic expansion
;---------------------------------------------------------------
; 13A. MILITARY PRESSURE -> FLUSH
;---------------------------------------------------------------
; Threat observation is centralized in section 12C.
;
; FLUSH is the highest-priority strategy state.  It may only be
; entered from a non-FLUSH state.  Recovery is explicit: once the
; threat is gone, return either to the Feudal RUSH posture when its
; conditions are still satisfied, or to BOOM otherwise.
(defrule
    (town-under-attack)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-flush)
)
(defrule
    (not (town-under-attack))
    (goal bt-cavalry-threat-goal 1)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-flush)
)
(defrule
    (not (town-under-attack))
    (goal bt-ranged-threat-goal 1)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-flush)
)
(defrule
    (not (town-under-attack))
    (goal bt-spear-threat-goal 1)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-flush)
)

;---------------------------------------------------------------
; 13B. FLUSH RECOVERY -> RUSH
;---------------------------------------------------------------
; This is an explicit exit from FLUSH.  It is evaluated after the
; threat writers, so the current pass must already be threat-free.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (current-age == feudal-age)
    (game-time >= 600)
    (players-building-count any-enemy > 0)
    (military-population >= 6)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
=>
    (set-goal strategy-goal bt-strategy-rush)
)

;---------------------------------------------------------------
; 13C. FLUSH RECOVERY -> BOOM
;---------------------------------------------------------------
; If the RUSH recovery conditions are not satisfied, recover to the
; economic posture explicitly rather than relying on a generic BOOM
; rule to overwrite FLUSH.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (not (current-age == feudal-age))
    (military-population >= 6)
=>
    (set-goal strategy-goal bt-strategy-boom)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (current-age == feudal-age)
    (not (game-time >= 600))
    (military-population >= 6)
=>
    (set-goal strategy-goal bt-strategy-boom)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (current-age == feudal-age)
    (game-time >= 600)
    (players-building-count any-enemy <= 0)
    (military-population >= 6)
=>
    (set-goal strategy-goal bt-strategy-boom)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (current-age == feudal-age)
    (game-time >= 600)
    (players-building-count any-enemy > 0)
    (military-population >= 6)
=>
    (set-goal strategy-goal bt-strategy-boom)
)

;---------------------------------------------------------------
; 13D. FEUDAL MILITARY READY -> RUSH
;---------------------------------------------------------------
;
; This does NOT run if the AI is already in FLUSH.
;
; The first rush army is intentionally small and readable:
; Archery Range + Archers.
(defrule
    (current-age == feudal-age)
    (game-time >= 600)
    (players-building-count any-enemy > 0)
    (military-population >= 6)
    (not (town-under-attack))
    (not (goal strategy-goal bt-strategy-flush))
    (not (goal strategy-goal bt-strategy-rush))
=>
    (set-goal strategy-goal bt-strategy-rush)
)

;---------------------------------------------------------------
; 13E. SAFE CASTLE -> BOOM
;---------------------------------------------------------------
; Explicitly exclude both active pressure states.  BOOM can no
; longer overwrite RUSH or FLUSH.
(defrule
    (current-age >= castle-age)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (not (goal strategy-goal bt-strategy-boom))
    (not (goal strategy-goal bt-strategy-rush))
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-boom)
)

;---------------------------------------------------------------
; 13F. SAFE PRE-CASTLE DEFAULT
;---------------------------------------------------------------
(defrule
    (current-age < castle-age)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (not (goal strategy-goal bt-strategy-boom))
    (not (goal strategy-goal bt-strategy-rush))
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-boom)
)

;================================================================
; 14. UNIT-GOAL SELECTION
;================================================================
;
; Unit-goal answers:
;
;   "What composition should the production system make?"
;
; The strategy layer decides POSTURE.
; This layer decides COMPOSITION.
;---------------------------------------------------------------
; 14A. MULTIPLE THREAT TYPES -> MIX
;---------------------------------------------------------------
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-cavalry-threat-goal 1)
    (goal bt-ranged-threat-goal 1)
=>
    (set-goal unit-goal bt-unit-mix)
)
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-cavalry-threat-goal 1)
    (goal bt-spear-threat-goal 1)
=>
    (set-goal unit-goal bt-unit-mix)
)
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-ranged-threat-goal 1)
    (goal bt-spear-threat-goal 1)
=>
    (set-goal unit-goal bt-unit-mix)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-cavalry-threat-goal 1)
    (not (goal bt-ranged-threat-goal 1))
    (not (goal bt-spear-threat-goal 1))
=>
    (set-goal unit-goal spearman-line)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-ranged-threat-goal 1)
    (not (goal bt-cavalry-threat-goal 1))
    (not (goal bt-spear-threat-goal 1))
=>
    (set-goal unit-goal skirmisher-line)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-spear-threat-goal 1)
    (not (goal bt-cavalry-threat-goal 1))
    (not (goal bt-ranged-threat-goal 1))
=>
    (set-goal unit-goal archer-line)
)

;---------------------------------------------------------------
; 14B. FLUSH WITH NO CURRENT THREAT -> MIX
;---------------------------------------------------------------
; Prevent a stale composition from surviving a transient defensive
; posture when the town is still under attack but the counted enemy
; threat has not resolved to a specific counter.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (not (goal bt-cavalry-threat-goal 1))
    (not (goal bt-ranged-threat-goal 1))
    (not (goal bt-spear-threat-goal 1))
=>
    (set-goal unit-goal bt-unit-mix)
)

;---------------------------------------------------------------
; 14C. STRATEGIC POSTURES
;---------------------------------------------------------------
(defrule
    (goal strategy-goal bt-strategy-rush)
=>
    (set-goal unit-goal archer-line)
)

(defrule
    (goal strategy-goal bt-strategy-boom)
=>
    (set-goal unit-goal bt-unit-mix)
)

;================================================================
; 15. PRODUCTION CAPACITY
;================================================================
;================================================================
; 15. PRODUCTION CAPACITY
;================================================================
;
; Q: "How do strategy and unit-goal change actual production?"
;
; They become prerequisites for production-building rules.
;
; IMPORTANT:
;   sn-resource-control must be 0.
;
; If an age/research claim owns the bank, military production waits.
; This is the conservative resource arbitration rule.
;---------------------------------------------------------------
; 15A. BARRACK CAPACITY
;---------------------------------------------------------------
(defrule
    (goal strategy-goal bt-strategy-flush)
    (or
    (goal unit-goal spearman-line)
    (goal unit-goal bt-unit-mix)
    )
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-level-goal >= 1)
    (building-type-count-total barracks < 2)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (or
    (goal unit-goal spearman-line)
    (goal unit-goal bt-unit-mix)
    )
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-level-goal >= 2)
    (building-type-count-total barracks < 4)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (or
    (goal unit-goal spearman-line)
    (goal unit-goal bt-unit-mix)
    )
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-level-goal >= 3)
    (building-type-count-total barracks < 6)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (current-age >= imperial-age)
    (goal strategy-goal bt-strategy-flush)
    (or
    (goal unit-goal spearman-line)
    (goal unit-goal bt-unit-mix)
    )
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-level-goal >= 4)
    (building-type-count-total barracks < 8)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (current-age >= imperial-age)
    (goal strategy-goal bt-strategy-flush)
    (or
    (goal unit-goal spearman-line)
    (goal unit-goal bt-unit-mix)
    )
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-level-goal >= 5)
    (building-type-count-total barracks < bt-max-barracks)
    (can-build barracks)
=>
    (build barracks)
)

;---------------------------------------------------------------
; 15B. ARCHERY-RANGE CAPACITY
;---------------------------------------------------------------
(defrule
    (or (goal unit-goal skirmisher-line) (or (goal unit-goal archer-line) (goal unit-goal bt-unit-mix)))
    (or (goal strategy-goal bt-strategy-rush) (goal strategy-goal bt-strategy-flush))
    (strategic-number sn-resource-control == 0)
    (or (goal bt-ranged-threat-goal 1) (or (goal bt-spear-threat-goal 1) (goal strategy-goal bt-strategy-rush)))
    (building-type-count-total archery-range < 1)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (or (goal unit-goal skirmisher-line) (or (goal unit-goal archer-line) (goal unit-goal bt-unit-mix)))
    (not (goal strategy-goal bt-strategy-boom))
    (strategic-number sn-resource-control == 0)
    (or (up-compare-goal bt-ranged-level-goal >= 1) (up-compare-goal bt-spear-level-goal >= 1))
    (building-type-count-total archery-range < 2)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (or (goal unit-goal skirmisher-line) (or (goal unit-goal archer-line) (goal unit-goal bt-unit-mix)))
    (strategic-number sn-resource-control == 0)
    (or (up-compare-goal bt-ranged-level-goal >= 2) (up-compare-goal bt-spear-level-goal >= 2))
    (building-type-count-total archery-range < 4)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (current-age >= imperial-age)
    (goal strategy-goal bt-strategy-flush)
    (or (goal unit-goal skirmisher-line) (or (goal unit-goal archer-line) (goal unit-goal bt-unit-mix)))
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-ranged-level-goal >= 3)
    (building-type-count-total archery-range < 6)
    (can-build archery-range)
=>
    (build archery-range)
)

;---------------------------------------------------------------
; 15C. STABLE CAPACITY
;---------------------------------------------------------------
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal bt-unit-mix)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-noncav-cavalry-level-goal >= 1)
    (building-type-count-total stable < 1)
    (can-build stable)
=>
    (build stable)
)
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal bt-unit-mix)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-noncav-cavalry-level-goal >= 2)
    (building-type-count-total stable < 2)
    (can-build stable)
=>
    (build stable)
)

;================================================================
; 16. MILITARY PRODUCTION ARBITRATION
;================================================================
;
; ONLY this section directly trains military units.
;
; The goals above decide what is wanted.
; These rules decide what actually gets queued.
;
; Explicit composition train rules require:
;
;   strategy
;   unit-goal
;   resource claim free
;   counter/pressure condition
;   queue-aware unit target
;   legal training
;
; The persistent military floors are deliberate exceptions:
; they use the aggregate military-population fact rather than a
; unit-specific queued count.
;---------------------------------------------------------------
; 16A. PERSISTENT BOOM MILITARY FLOOR
;---------------------------------------------------------------
; BOOM prioritizes economic expansion, but it does not abandon a
; minimum defensive army.  This floor is independent of transient
; enemy observation and remains separate from the attack lifecycle.
;
; Six military units is the same minimum floor used by FLUSH recovery.
(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= feudal-age)
    (military-population < 6)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= feudal-age)
    (goal unit-goal bt-unit-mix)
    (military-population < 6)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks >= 1)
    (can-train spearman-line)
=>
    (train spearman-line)
)

; 16B. PERSISTENT FLUSH MILITARY FLOOR
;---------------------------------------------------------------
; FLUSH is a defensive posture, not a momentary reaction to a
; currently visible enemy unit. Once entered, the bot must rebuild
; a minimum army before it is allowed to recover out of FLUSH.
;
; This floor deliberately does not require a current enemy threat or
; a specific unit-goal.  It closes the FLUSH -> temporary observation
; gap -> no production failure.
;
; Six military units is the recovery floor used by strategy selection.
; military-population is the aggregate army-state fact here; the
; queue-aware unit-type-count-total facts are used by composition caps.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (current-age >= feudal-age)
    (military-population < 6)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (current-age >= feudal-age)
    (military-population < 6)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total barracks >= 1)
    (can-train spearman-line)
=>
    (train spearman-line)
)

;---------------------------------------------------------------
; 16C. EXPLICIT SPEAR GOAL
;---------------------------------------------------------------
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal spearman-line)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-counter-level-goal >= 1)
    (unit-type-count-total spearman-line < bt-spear-target-1)
    (can-train spearman-line)
=>
    (train spearman-line)
)
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal spearman-line)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-counter-level-goal >= 2)
    (unit-type-count-total spearman-line < bt-spear-target-2)
    (can-train spearman-line)
=>
    (train spearman-line)
)
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal spearman-line)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-counter-level-goal >= 3)
    (unit-type-count-total spearman-line < bt-spear-target-3)
    (can-train spearman-line)
=>
    (train spearman-line)
)

;---------------------------------------------------------------
; 16D. EXPLICIT SKIRMISHER GOAL
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal skirmisher-line)
    (strategic-number sn-resource-control == 0)
    (goal bt-ranged-threat-goal 1)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total skirmisher-line < bt-skirm-target-1)
    (can-train skirmisher-line)
=>
    (train skirmisher-line)
)
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal skirmisher-line)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-ranged-counter-level-goal >= 2)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total skirmisher-line < bt-skirm-target-2)
    (can-train skirmisher-line)
=>
    (train skirmisher-line)
)
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal skirmisher-line)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-ranged-counter-level-goal >= 3)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total skirmisher-line < bt-skirm-target-3)
    (can-train skirmisher-line)
=>
    (train skirmisher-line)
)

;---------------------------------------------------------------
; 16E. EXPLICIT ARCHER GOAL
(defrule
    (or
    (goal strategy-goal bt-strategy-rush)
    (goal strategy-goal bt-strategy-flush)
    )
    (goal unit-goal archer-line)
    (strategic-number sn-resource-control == 0)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total archer-line < 10)
    (or
    (goal strategy-goal bt-strategy-rush)
    (goal bt-spear-threat-goal 1)
    )
    (can-train archer-line)
=>
    (train archer-line)
)
; RUSH target is ten archers; attack readiness is military-population >= 10.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal archer-line)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-spear-counter-level-goal >= 2)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total archer-line < 10)
    (can-train archer-line)
=>
    (train archer-line)
)

;---------------------------------------------------------------
; 16F. MIXED COMPOSITION
; MIX #1: cheap cavalry cover first.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal bt-unit-mix)
    (strategic-number sn-resource-control == 0)
    (up-compare-goal bt-cavalry-counter-level-goal >= 1)
    (unit-type-count-total spearman-line < bt-spear-target-1)
    (can-train spearman-line)
=>
    (train spearman-line)
)
; MIX #2: Camel support after the cheap spear floor.
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal bt-unit-mix)
    (strategic-number sn-resource-control == 0)
    (unit-type-count-total spearman-line >= bt-spear-target-1)
    (up-compare-goal bt-noncav-cavalry-level-goal >= 1)
    (building-type-count-total stable >= 1)
    (unit-type-count-total camel-line < bt-camel-target-1)
    (can-train camel)
=>
    (train camel)
)
; MIX #3: ranged coverage.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal bt-unit-mix)
    (strategic-number sn-resource-control == 0)
    (goal bt-ranged-threat-goal 1)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total skirmisher-line < bt-skirm-target-1)
    (can-train skirmisher-line)
=>
    (train skirmisher-line)
)
; MIX #4: Archer support against Spears.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal unit-goal bt-unit-mix)
    (strategic-number sn-resource-control == 0)
    (goal bt-spear-threat-goal 1)
    (building-type-count-total archery-range >= 1)
    (unit-type-count-total archer-line < 6)
    (can-train archer-line)
=>
    (train archer-line)
)

;================================================================
; 17. BYZANTINE BOOM
;================================================================
;
; Q: "What does BOOM mean in actual code?"
;
; Town Centers.
;
; These rules only fire in BOOM posture, so TC expansion does not
; compete with the military pressure posture for the shared mutex.
; TC2.
; Demand -> claim -> release food/wood escrow -> start watchdog -> build.
(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= castle-age)
    (unit-type-count villager >= 32)
    (food-amount >= 350)
    (wood-amount >= 300)
    (building-type-count-total town-center < 2)
    (strategic-number sn-resource-control == 0)
    (can-build-with-escrow town-center)
=>
    (set-strategic-number sn-resource-control bt-tc2-claim)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-tc2-watchdog-timer bt-tc-watchdog-seconds)
    (build town-center)
)

; TC2 completed-count witness -> release only the TC2 claim.
(defrule
    (strategic-number sn-resource-control == bt-tc2-claim)
    (building-type-count town-center >= 2)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

; TC2 watchdog recovery.
; Timeout only releases the stale claim. It never retries the build.
(defrule
    (strategic-number sn-resource-control == bt-tc2-claim)
    (building-type-count town-center < 2)
    (timer-triggered bt-tc2-watchdog-timer)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

; TC3.
; Demand -> claim -> release food/wood escrow -> start watchdog -> build.
(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= castle-age)
    (unit-type-count villager >= 45)
    (food-amount >= 500)
    (wood-amount >= 300)
    (building-type-count-total town-center < 3)
    (strategic-number sn-resource-control == 0)
    (can-build-with-escrow town-center)
=>
    (set-strategic-number sn-resource-control bt-tc3-claim)
    (release-escrow food)
    (release-escrow wood)
    (enable-timer bt-tc3-watchdog-timer bt-tc-watchdog-seconds)
    (build town-center)
)

; TC3 completed-count witness -> release only the TC3 claim.
(defrule
    (strategic-number sn-resource-control == bt-tc3-claim)
    (building-type-count town-center >= 3)
=>
    (disable-timer bt-tc3-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

; TC3 watchdog recovery.
; Timeout only releases the stale claim. It never retries the build.
(defrule
    (strategic-number sn-resource-control == bt-tc3-claim)
    (building-type-count town-center < 3)
    (timer-triggered bt-tc3-watchdog-timer)
=>
    (disable-timer bt-tc3-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

;================================================================
; 18. SCOUTING -> ATTACK-GROUP GATHERING
;================================================================
(defrule
    (players-building-count target-player > 0)
=>
    (up-get-fact military-population 0 bt-relative-force-goal)
    (up-get-target-fact military-population 0 bt-target-military-scratch-goal)
    (up-modify-goal bt-relative-force-goal g:- bt-target-military-scratch-goal)
)

; Composition readiness is a parity-only attack veto.
; Positive relative force bypasses composition mismatch.
; Negative relative force is already blocked by the 506 gate.
(defrule
    (true)
=>
    (set-goal bt-counter-veto-goal 0)
)

; CAVALRY-MELEE FAMILY #1.
; Generic and high-frequency mounted melee families.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player knight-line >= 3)
            (or
                (players-unit-type-count target-player scout-cavalry-line >= 3)
                (or
                    (players-unit-type-count target-player camel-line >= 3)
                    (or
                        (players-unit-type-count target-player cataphract-line >= 3)
                        (or
                            (players-unit-type-count target-player battle-elephant-line >= 3)
                            (or
                                (players-unit-type-count target-player war-elephant-line >= 3)
                                (or
                                    (players-unit-type-count target-player steppe-lancer-line >= 3)
                                    (or
                                        (players-unit-type-count target-player tarkan-line >= 3)
                                        (or
                                            (players-unit-type-count target-player boyar-line >= 3)
                                            (players-unit-type-count target-player leitis-line >= 3)
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
        (unit-type-count-total spearman-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; CAVALRY-MELEE FAMILY #2.
; Additional current DE civilization-specific mounted melee families.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player keshik-line >= 3)
            (or
                (players-unit-type-count target-player coustillier-line >= 3)
                (or
                    (players-unit-type-count target-player konnik-line >= 3)
                    (or
                        (players-unit-type-count target-player magyar-huszar-line >= 3)
                        (or
                            (players-unit-type-count target-player shrivamsha-rider-line >= 3)
                            (or
                                (players-unit-type-count target-player iron-pagoda-line >= 3)
                                (or
                                    (players-unit-type-count target-player hei-guang-cavalry-line >= 3)
                                    (or
                                        (players-unit-type-count target-player kona-line >= 3)
                                        (or
                                            (players-unit-type-count target-player monaspa-line >= 3)
                                            (or
                                                (players-unit-type-count target-player centurion-line >= 3)
                                                (or
                                                    (players-unit-type-count target-player ratha-melee-line >= 3)
                                                    (players-unit-type-count target-player tiger-cavalry-line >= 3)
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
        (unit-type-count-total spearman-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; BOW-RANGED FAMILY #1.
; Generic archer/crossbow plus the established unique bow families.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player archer-line >= 3)
            (or
                (players-unit-type-count target-player cavalry-archer-line >= 3)
                (or
                    (players-unit-type-count target-player plumed-archer-line >= 3)
                    (or
                        (players-unit-type-count target-player longbowman-line >= 3)
                        (or
                            (players-unit-type-count target-player chu-ko-nu-line >= 3)
                            (or
                                (players-unit-type-count target-player genoese-crossbowman-line >= 3)
                                (or
                                    (players-unit-type-count target-player rattan-archer-line >= 3)
                                    (or
                                        (players-unit-type-count target-player blackwood-archer-line >= 3)
                                        (players-unit-type-count target-player fire-archer-line >= 3)
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
        (unit-type-count-total skirmisher-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; BOW-RANGED FAMILY #2.
; Mounted/unique bow families with a canonical skirmisher response.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player elephant-archer-line >= 3)
            (or
                (players-unit-type-count target-player bolas-rider-line >= 3)
                (or
                    (players-unit-type-count target-player mangudai-line >= 3)
                    (or
                        (players-unit-type-count target-player kipchak-line >= 3)
                        (or
                            (players-unit-type-count target-player camel-archer-line >= 3)
                            (or
                                (players-unit-type-count target-player genitour-line >= 3)
                                (or
                                    (players-unit-type-count target-player war-wagon-line >= 3)
                                    (or
                                        (players-unit-type-count target-player composite-bowman-line >= 3)
                                        (players-unit-type-count target-player ratha-ranged-line >= 3)
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
        (unit-type-count-total skirmisher-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; GUNPOWDER-CAVALRY FAMILY.
; Dedicated Conquistador/Arambai branch. These are mounted gunpowder
; specialists, not ordinary bow-ranged cavalry. At exact parity,
; require at least minimal skirmisher presence before attack authority.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player conquistador-line >= 3)
            (players-unit-type-count target-player arambai-line >= 3)
        )
        (unit-type-count-total skirmisher-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; ELEPHANT-SPECIALIST FAMILY.
; Ballista and Armored/Siege Elephant lines are elephant/siege specialists,
; but their stable Byzantine parity counter remains the Spearman line.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player ballista-elephant-line >= 3)
            (players-unit-type-count target-player armored-elephant-line >= 3)
        )
        (unit-type-count-total spearman-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; SPECIALIST-MELEE-INFANTRY FAMILY.
; Fire Lancer, Liao Dao, and Ibirapema are infantry specialists with a
; stable Archer-line counter relationship.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player fire-lancer-line >= 3)
            (or
                (players-unit-type-count target-player liao-dao-line >= 3)
                (players-unit-type-count target-player ibirapema-warrior-line >= 3)
            )
        )
        (unit-type-count-total archer-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; RANGED-MELEE SPECIALIST FAMILY.
; Throwing Axemen retain a clean Skirmisher counter relationship.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (players-unit-type-count target-player throwing-axeman-line >= 3)
        (unit-type-count-total skirmisher-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; HAND-CANNONEER FAMILY.
; Hand Cannoneers carry the archer armor class, so the canonical cheap
; Byzantine response is a minimum Skirmisher presence at exact parity.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (players-unit-type-count target-player hand-cannoneer >= 3)
        (unit-type-count-total skirmisher-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; MAMELUKE FAMILY.
; Mamelukes are cavalry-class but function as ranged anti-cavalry specialists.
; At exact parity, require minimum archer-line presence before attack authority.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (players-unit-type-count target-player mameluke-line >= 3)
        (unit-type-count-total archer-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

; SPEAR / ANTI-CAVALRY INFANTRY FAMILY.
; Generic Spearman -> Pikeman -> Halberdier plus the Kamayuk specialist.
(defrule
    (players-building-count target-player > 0)
    (up-compare-goal bt-relative-force-goal == 0)
    (and
        (or
            (players-unit-type-count target-player spearman-line >= 4)
            (players-unit-type-count target-player kamayuk-line >= 3)
        )
        (unit-type-count-total archer-line < 3)
    )
=>
    (set-goal bt-counter-veto-goal 1)
)

;
; Q: "How does the AI actually form an army?"
;
; We do not manually move ten units.
;
; The engine's attack-group system handles gathering.
;
; minimum group size = 10
; gather spacing      = 5
; attack allocation   = 70%
; Q: "When should the first deliberate attack happen?"
;
; After:
;   Feudal+
;   enemy located
;   attack group is actually available
;   town is not currently under attack
;   no other attack cycle is active
(defrule
    (timer-triggered bt-attack-timer)
    (current-age >= feudal-age)
    (players-building-count any-enemy > 0)
    (players-building-count target-player > 0)
    (military-population >= 10)
    (up-compare-goal bt-relative-force-goal >= 0)
    (goal bt-counter-veto-goal 0)
    (goal attack-goal 0)
    (goal retreat-now-goal 0)
    (not (town-under-attack))
=>
    ; Mark the attack cycle active BEFORE attack-now.
    (set-goal attack-goal 1)

    
    ; Force the available attack units into an attack-group.
    ;
    ; attack-now should NOT be spammed.
    (attack-now)

    ; Hold the attack cycle for five minutes before resetting it.
    (enable-timer bt-attack-timer 300)
    

)

;================================================================
; 19. ATTACK CYCLE RESET
;================================================================
;
; Q: "How do we regain script control after attack-now?"
;
; UserPatch supplies up-reset-attack-now for exactly this purpose.
(defrule
    (timer-triggered bt-attack-timer)
    (goal attack-goal 1)
=>
    (up-reset-attack-now)

    
    ; End this attack cycle.
    (set-goal attack-goal 0)

    ; Cooldown before another attack command.
    (enable-timer bt-attack-timer 180)
    

)

;================================================================
; 20. RETREAT
;================================================================
;
; Q: "When does a human player abandon the attack?"
;
; Here:
;
;   attack is active
;   +
;   town is under attack
;   ->
;   recall military
;
; The rule is deliberately broad and conservative.
;
; up-retreat-now recalls military units toward the home Town Center.
(defrule
    (goal attack-goal 1)
    (goal retreat-now-goal 0)
    (or
        (town-under-attack)
        (and
            (players-building-count target-player > 0)
            (up-compare-goal bt-relative-force-goal < -5)
        )
    )
    (attack-soldier-count >= 6)
=>
    (set-goal retreat-now-goal 1)

    
    ; Stop the persistent attack-now targeting.
    (up-reset-attack-now)

    ; Recall military forces.
    (up-retreat-now)

    ; End the attack cycle.
    (set-goal attack-goal 0)

    ; Stop the existing attack cooldown.
    (disable-timer bt-attack-timer)

    ; Prevent repeated retreat commands.
    (enable-timer bt-retreat-timer 120)
    

)

;================================================================
; 21. RETREAT RELEASE
;================================================================
(defrule
    (timer-triggered bt-retreat-timer)
    (goal retreat-now-goal 1)
=>
    (set-goal retreat-now-goal 0)

    
    ; Let the army regroup at home before another attack opportunity.
    (enable-timer bt-attack-timer 180)
    

)

;================================================================
; 22. PIKEMAN RESEARCH
;================================================================
;
; Q: "When does the composition earn its upgrade?"
;
; Existing spear mass + real cavalry threat + free resource claim.
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (or
    (goal unit-goal spearman-line)
    (goal unit-goal bt-unit-mix)
    )
    (unit-type-count-total spearman-line >= 6)
    (or
(players-unit-type-count any-enemy knight-line >= 6)
(or
(players-unit-type-count any-enemy camel-line >= 6)
(or
(players-unit-type-count any-enemy cataphract-line >= 6)
(players-unit-type-count any-enemy scout-cavalry-line >= 6))))
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-pikeman)
=>
    (set-strategic-number sn-resource-control ri-pikeman)
    (release-escrow food)
    (release-escrow gold)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-pikeman)
)

; Q: "What proves the Pikeman claim is finished?"
;
; research-complete is the terminal witness.
(defrule
    (strategic-number sn-resource-control == ri-pikeman)
    (up-research-status c: ri-pikeman == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

;================================================================
; 23. ELITE SKIRMISHER RESEARCH
;================================================================
(defrule
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (or
    (goal unit-goal skirmisher-line)
    (goal unit-goal bt-unit-mix)
    )
    (unit-type-count-total skirmisher-line >= 6)
    (or
    (players-unit-type-count any-enemy archer-line >= 6)
    (players-unit-type-count any-enemy cavalry-archer-line >= 6)
    )
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-elite-skirmisher)
=>
    (set-strategic-number sn-resource-control ri-elite-skirmisher)
    (release-escrow food)
    (release-escrow gold)
    (enable-timer bt-research-watchdog-timer bt-research-watchdog-seconds)
    (research ri-elite-skirmisher)
)

; Q: "What proves the Elite Skirmisher claim is finished?"
;
; research-complete is the terminal witness.
(defrule
    (strategic-number sn-resource-control == ri-elite-skirmisher)
    (up-research-status c: ri-elite-skirmisher == research-complete)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

;================================================================
; RESEARCH / AGE CLAIM WATCHDOG RECOVERY
;================================================================
; Q: "When should a research claim be released without success?"
;
; Only when the timer expires AND the claimed research is no longer
; pending.  A pending research remains owner of the shared mutex.
;
; research-available = 1
; research-pending   = 2
; research-complete  = 3
;
; Therefore status <= research-available means the research is not
; pending and has not completed. The watchdog is recovery only.
; It never retries research or starts another claim.
;
; Age recovery also restores normal villager production because the
; age-claim path disabled train-civ-goal during the attempt.
;----------------------------------------------------------------
; LOOM WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == ri-loom)
    (up-research-status c: ri-loom <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
)

;----------------------------------------------------------------
; FEUDAL AGE WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == feudal-age)
    (current-age < feudal-age)
    (up-research-status c: feudal-age <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal train-civ-goal 1)
)

;----------------------------------------------------------------
; CASTLE AGE WATCHDOG EXPIRY
(defrule
    (strategic-number sn-resource-control == castle-age)
    (current-age < castle-age)
    (up-research-status c: castle-age <= research-available)
    (timer-triggered bt-research-watchdog-timer)
=>
    (disable-timer bt-research-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal train-civ-goal 1)
)

