; Cataphract premium research. Actual completed Cataphracts qualify the
; upgrade; queue-inclusive totals remain the production/completion witness.
(defrule
    (goal bt-cataphract-demand-goal 1)
    (current-age >= imperial-age)
    (building-type-count-total castle >= 1)
    (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-2)
    (unit-type-count cataphract-line >= bt-cataphract-target-1)
    (up-research-status c: ri-logistica < research-pending)
    ; Cataphract premium research is an explicit resource-mode exception:
    ; Cataphract demand itself can trigger these modes, so retaining their
    ; veto here would make the demand unable to complete. Escrow feasibility
    ; remains the final resource guard.
    (up-compare-goal bt-research-castle-failure-backoff-goal != ri-logistica)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-logistica)
    (goal bt-research-castle-claim-goal 0)
    (goal bt-research-cataphract-package-goal ri-logistica)
=>
    (set-strategic-number sn-resource-control ri-logistica)
    (release-escrow food)
    (release-escrow gold)
    (research ri-logistica)
    (set-goal bt-research-castle-claim-goal ri-logistica)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-research-castle-claim-goal ri-logistica)
    (up-research-status c: ri-logistica == research-complete)
=>
    (set-goal bt-research-castle-claim-goal 0)
)
(defrule
    (goal bt-cataphract-demand-goal 1)
    (current-age >= imperial-age)
    (building-type-count-total castle >= 1)
    (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-3)
    (unit-type-count cataphract-line >= bt-cataphract-target-2)
    (up-research-status c: ri-logistica == research-complete)
    (up-research-status c: ri-elite-cataphract < research-pending)
    ; Elite Cataphract is part of the same response package. The resource
    ; mode is not allowed to veto the demand that created the package;
    ; escrow feasibility remains authoritative.
    (up-compare-goal bt-research-castle-failure-backoff-goal != ri-elite-cataphract)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-elite-cataphract)
    (goal bt-research-castle-claim-goal 0)
    (goal bt-research-cataphract-package-goal ri-elite-cataphract)
=>
    (set-strategic-number sn-resource-control ri-elite-cataphract)
    (release-escrow food)
    (release-escrow gold)
    (research ri-elite-cataphract)
    (set-goal bt-research-castle-claim-goal ri-elite-cataphract)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-research-castle-claim-goal ri-elite-cataphract)
    (up-research-status c: ri-elite-cataphract == research-complete)
=>
    (set-goal bt-research-castle-claim-goal 0)
)

;================================================================
; 23. PIKEMAN RESEARCH
;================================================================

;
; Q: "When does the composition earn its upgrade?"
;
; Existing spear mass + real cavalry threat + free resource claim.
(defrule
    (current-age >= castle-age)
    (up-compare-goal bt-cavalry-counter-level-goal >= 1)
    (or
    (goal unit-goal spearman-line)
    (goal unit-goal bt-unit-mix)
    )
    (unit-type-count-total spearman-line >= 6)
    (or
(players-unit-type-count any-enemy knight-line >= 6)
(or
(players-unit-type-count any-enemy camel-line >= 6)
(or
(players-unit-type-count any-enemy cataphract-line >= 6)
(players-unit-type-count any-enemy scout-cavalry-line >= 6))))
    (up-compare-goal bt-research-barracks-failure-backoff-goal != ri-pikeman)
    (strategic-number sn-resource-control == 0)
    (or
        (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
        (and
            (up-compare-goal bt-pikeman-bank-delta-food-goal >= 0)
            (and
                (up-compare-goal bt-pikeman-bank-delta-wood-goal >= 0)
                (up-compare-goal bt-pikeman-bank-delta-gold-goal >= 0)
            )
        )
    )
    (building-type-count barracks >= 1)
    (up-compare-goal bt-research-barracks-pikeman-retry-goal < bt-research-barracks-max-retries)
    (can-research-with-escrow ri-pikeman)
    (goal bt-research-barracks-claim-goal 0)
    (goal bt-research-cavalry-counter-package-goal ri-pikeman)
=>
    (set-strategic-number sn-resource-control ri-pikeman)
    (release-escrow food)
    (release-escrow gold)
    (research ri-pikeman)
    (set-goal bt-research-barracks-claim-goal ri-pikeman)
    (set-strategic-number sn-resource-control 0)
)

; Q: "What proves the Pikeman claim is finished?"
;
; research-complete is the terminal witness.
(defrule
    (goal bt-research-barracks-claim-goal ri-pikeman)
    (up-research-status c: ri-pikeman == research-complete)
=>
    (set-goal bt-research-barracks-claim-goal 0)
)

;================================================================
; 23. ELITE SKIRMISHER RESEARCH
;================================================================
(defrule
    (current-age >= castle-age)
    (or
    (goal unit-goal skirmisher-line)
    (goal unit-goal bt-unit-mix)
    )
    (unit-type-count-total skirmisher-line >= 6)
    (or
    (players-unit-type-count any-enemy archer-line >= 6)
    (players-unit-type-count any-enemy cavalry-archer-line >= 6)
    )
    (up-compare-goal bt-research-archery-range-failure-backoff-goal != ri-elite-skirmisher)
    (strategic-number sn-resource-control == 0)
    (or
        (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
        (and
            (up-compare-goal bt-elite-skirmisher-bank-delta-food-goal >= 0)
            (and
                (up-compare-goal bt-elite-skirmisher-bank-delta-wood-goal >= 0)
                (up-compare-goal bt-elite-skirmisher-bank-delta-gold-goal >= 0)
            )
        )
    )
    (building-type-count archery-range >= 1)
    (can-research-with-escrow ri-elite-skirmisher)
    (goal bt-research-archery-range-claim-goal 0)
    (goal bt-research-ranged-counter-package-goal ri-elite-skirmisher)
=>
    (set-strategic-number sn-resource-control ri-elite-skirmisher)
    (release-escrow food)
    (release-escrow gold)
    (research ri-elite-skirmisher)
    (set-goal bt-research-archery-range-claim-goal ri-elite-skirmisher)
    (set-strategic-number sn-resource-control 0)
)

; Q: "What proves the Elite Skirmisher claim is finished?"
;
; research-complete is the terminal witness.
(defrule
    (goal bt-research-archery-range-claim-goal ri-elite-skirmisher)
    (up-research-status c: ri-elite-skirmisher == research-complete)
=>
    (set-goal bt-research-archery-range-elite-skirmisher-retry-goal 0)
    (set-goal bt-research-archery-range-claim-goal 0)
)

; Plate Mail closes the mature Spear/Halberdier armor package.
; It reinforces the already-funded counter army and never substitutes
; for Halberdier/Pikeman production.
(defrule
    (current-age >= imperial-age)
    (building-type-count blacksmith >= 1)
    (up-research-status c: ri-halberdier == research-complete)
    (up-compare-goal bt-standing-spear-target-goal >= bt-spear-target-2)
    (unit-type-count-total spearman-line >= bt-spear-target-2)
    (or
        (goal bt-ranged-threat-goal 1)
        (up-compare-goal bt-cavalry-counter-level-goal >= 2)
    )
    (up-research-status c: ri-plate-mail < research-pending)
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank))
    (not (goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep))
    (not (goal bt-resource-mode-goal bt-resource-mode-food-crisis))
    (not (goal bt-resource-mode-goal bt-resource-mode-gold-crisis))
    (up-compare-goal bt-research-blacksmith-plate-mail-retry-goal < bt-blacksmith-research-max-retries)
    (up-compare-goal bt-research-blacksmith-failure-backoff-goal != ri-plate-mail)
    (strategic-number sn-resource-control == 0)
    (can-research-with-escrow ri-plate-mail)
    (goal bt-research-blacksmith-claim-goal 0)
    (goal bt-research-cavalry-counter-package-goal ri-plate-mail)
=>
    (set-strategic-number sn-resource-control ri-plate-mail)
    (release-escrow food)
    (release-escrow gold)
    (research ri-plate-mail)
    (set-goal bt-research-blacksmith-claim-goal ri-plate-mail)
    (set-strategic-number sn-resource-control 0)
)

(defrule
    (goal bt-research-blacksmith-claim-goal ri-plate-mail)
    (up-research-status c: ri-plate-mail == research-complete)
=>
    (set-goal bt-research-blacksmith-plate-mail-retry-goal 0)
    (set-goal bt-research-blacksmith-claim-goal 0)
)

;================================================================
; 23. MATURE MILITARY RESEARCH
;================================================================
; Spear and Camel production already consume their unit lines. These
; research lifecycles therefore upgrade the existing production stream
; rather than introducing new unit-goal state.
(defrule
    (goal bt-halberdier-demand-goal 0)
    (current-age >= imperial-age)
    (up-research-status c: ri-pikeman == research-complete)
    (up-compare-goal bt-cavalry-counter-level-goal >= 2)
    (up-compare-goal bt-standing-spear-target-goal >= bt-spear-target-2)
    (research-available ri-halberdier)
=>
    (set-goal bt-halberdier-demand-goal 1)
)
(defrule
    (goal bt-halberdier-demand-goal 1)
    (strategic-number sn-resource-control != ri-halberdier)
    (or (not (research-available ri-halberdier)) (or (current-age < imperial-age) (or (up-compare-goal bt-cavalry-counter-level-goal < 2) (up-compare-goal bt-standing-spear-target-goal < bt-spear-target-2))))
=>
    (set-goal bt-halberdier-demand-goal 0)
)
(defrule
    (goal bt-halberdier-demand-goal 1)
    (current-age >= imperial-age)
    (up-compare-goal bt-research-barracks-failure-backoff-goal != ri-halberdier)
    (strategic-number sn-resource-control == 0)
    (building-type-count barracks >= 1)
    (up-compare-goal bt-research-barracks-halberdier-retry-goal < bt-research-barracks-max-retries)
    (can-research-with-escrow ri-halberdier)
    (goal bt-research-barracks-claim-goal 0)
    (goal bt-research-cavalry-counter-package-goal ri-halberdier)
=>
    (set-strategic-number sn-resource-control ri-halberdier)
    (release-escrow food)
    (release-escrow gold)
    (research ri-halberdier)
    (set-goal bt-research-barracks-claim-goal ri-halberdier)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-research-barracks-claim-goal ri-halberdier)
    (up-research-status c: ri-halberdier == research-complete)
=>
    (set-goal bt-research-barracks-claim-goal 0)
    (set-goal bt-halberdier-demand-goal 0)
)

(defrule
    (goal bt-heavy-camel-demand-goal 0)
    (current-age >= imperial-age)
    (building-type-count stable >= 1)
    (up-compare-goal bt-cavalry-counter-level-goal >= 2)
    (up-compare-goal bt-standing-camel-target-goal >= bt-camel-target-1)
    (unit-type-count-total camel-line >= bt-camel-target-1)
    (research-available ri-heavy-camel)
=>
    (set-goal bt-heavy-camel-demand-goal 1)
)
(defrule
    (goal bt-heavy-camel-demand-goal 1)
    (strategic-number sn-resource-control != ri-heavy-camel)
    (or (not (research-available ri-heavy-camel)) (or (current-age < imperial-age) (or (up-compare-goal bt-cavalry-counter-level-goal < 2) (or (up-compare-goal bt-standing-camel-target-goal < bt-camel-target-1) (unit-type-count-total
camel-line < bt-camel-target-1)))))
=>
    (set-goal bt-heavy-camel-demand-goal 0)
)
(defrule
    (goal bt-heavy-camel-demand-goal 1)
    (current-age >= imperial-age)
    (up-compare-goal bt-research-stable-failure-backoff-goal != ri-heavy-camel)
    (strategic-number sn-resource-control == 0)
    (building-type-count stable >= 1)
    (up-compare-goal bt-research-stable-heavy-camel-retry-goal < bt-stable-research-max-retries)
    (can-research-with-escrow ri-heavy-camel)
    (goal bt-research-stable-claim-goal 0)
=>
    (set-strategic-number sn-resource-control ri-heavy-camel)
    (release-escrow food)
    (release-escrow gold)
    (research ri-heavy-camel)
    (set-goal bt-research-stable-claim-goal ri-heavy-camel)
    (set-strategic-number sn-resource-control 0)
)
(defrule
    (goal bt-research-stable-claim-goal ri-heavy-camel)
    (up-research-status c: ri-heavy-camel == research-complete)
=>
    (set-goal bt-research-stable-claim-goal 0)
    (set-goal bt-heavy-camel-demand-goal 0)
)

(defrule
    (goal bt-research-barracks-claim-goal ri-halberdier)
    (up-research-status c: ri-halberdier <= research-available)
=>
    (up-modify-goal bt-research-barracks-halberdier-retry-goal g:+ 1)
    (set-goal bt-research-barracks-failure-backoff-goal ri-halberdier)
    (enable-timer bt-research-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-barracks-claim-goal 0)
    (set-goal bt-research-cavalry-counter-package-goal 0)
)

(defrule
    (goal bt-research-stable-claim-goal ri-heavy-camel)
    (up-research-status c: ri-heavy-camel <= research-available)
=>
    (up-modify-goal bt-research-stable-heavy-camel-retry-goal g:+ 1)
    (set-goal bt-research-stable-failure-backoff-goal ri-heavy-camel)
    (enable-timer bt-research-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-stable-claim-goal 0)
)

;================================================================
; RESEARCH CAPABILITY LOSS
;================================================================
; A capability-local claim dies when every instance of its research
; building disappears. This is world-state cleanup, not a research-action
; failure. The package/demand layer remains live and can reassert the tech
; after the capability is rebuilt. No global strategic claim is touched.
(defrule
    (up-compare-goal bt-research-town-center-claim-goal != 0)
    (building-type-count town-center == 0)
=>
    (set-goal bt-research-town-center-claim-goal 0)
)

(defrule
    (up-compare-goal bt-research-mill-claim-goal != 0)
    (building-type-count mill == 0)
=>
    (set-goal bt-research-mill-claim-goal 0)
)

(defrule
    (up-compare-goal bt-research-lumber-camp-claim-goal != 0)
    (building-type-count lumber-camp == 0)
=>
