; STONE SHAFT MINING WATCHDOG EXPIRY
;----------------------------------------------------------------
(defrule
    (goal bt-research-mining-camp-claim-goal ri-stone-shaft-mining)
    (up-research-status c: ri-stone-shaft-mining <= research-available)
=>
    (set-goal bt-research-mining-camp-failure-backoff-goal ri-stone-shaft-mining)
    (enable-timer bt-research-failure-backoff-timer bt-research-failure-backoff-seconds)
    (set-goal bt-research-mining-camp-claim-goal 0)
    (set-goal bt-stone-shaft-mining-demand-goal 0)
)

;----------------------------------------------------------------
; MILL CONSTRUCTION COMPLETION
;----------------------------------------------------------------
; The project target is the terminal completed-building witness.
; building-type-count-total includes construction foundations, so it is
; deliberately not used to release the Mill claim.
(defrule
    (strategic-number sn-resource-control == bt-mill-claim)
    (or
        (and
            (goal bt-mill-project-goal 1)
            (building-type-count mill >= 1)
        )
        (or
        (and
            (goal bt-mill-project-goal 2)
            (building-type-count mill >= 2)
        )
        (and
            (goal bt-mill-project-goal 3)
            (building-type-count mill >= 3)
        )
            )
    )
=>
    (disable-timer bt-mill-watchdog-timer)
    (disable-timer bt-mill-backoff-timer)
    (set-goal bt-mill-project-goal 0)
    (set-goal bt-mill-backoff-goal 0)
    (set-strategic-number sn-resource-control 0)
)

; A failed Mill build order leaves no pending foundation. Release the claim
; after the bounded watchdog interval and let the existing demand/project
; path retry on a later pass. Do not release while a real Mill foundation
; is pending: doing so could let the claim layer issue a duplicate Mill
; before the completion witness is observed.
(defrule
    (strategic-number sn-resource-control == bt-mill-claim)
    (goal bt-mill-retry-goal 0)
    (timer-triggered bt-mill-watchdog-timer)
    (up-pending-objects c: mill > 0)
=>
    (disable-timer bt-mill-watchdog-timer)
    (up-assign-builders c: mill c: bt-foundation-stall-builder-count)
    (set-goal bt-mill-retry-goal 1)
    (enable-timer bt-mill-watchdog-timer bt-mill-watchdog-seconds)
)
(defrule
    (strategic-number sn-resource-control == bt-mill-claim)
    (goal bt-mill-retry-goal 1)
    (timer-triggered bt-mill-watchdog-timer)
    (up-pending-objects c: mill > 0)
=>
    (disable-timer bt-mill-watchdog-timer)
    (up-assign-builders c: mill c: bt-foundation-stall-builder-count)
    (set-goal bt-mill-retry-goal 2)
    (enable-timer bt-mill-watchdog-timer bt-mill-watchdog-seconds)
)
(defrule
    (strategic-number sn-resource-control == bt-mill-claim)
    (goal bt-mill-retry-goal 2)
    (timer-triggered bt-mill-watchdog-timer)
    (up-pending-objects c: mill > 0)
=>
    (disable-timer bt-mill-watchdog-timer)
    (up-assign-builders c: mill c: bt-foundation-stall-builder-count)
    (set-goal bt-mill-retry-goal 3)
    (enable-timer bt-mill-watchdog-timer bt-mill-watchdog-seconds)
)
(defrule
    (strategic-number sn-resource-control == bt-mill-claim)
    (goal bt-mill-retry-goal 3)
    (timer-triggered bt-mill-watchdog-timer)
    (up-pending-objects c: mill > 0)
=>
    (disable-timer bt-mill-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-mill-backoff-goal 1)
    (enable-timer bt-mill-backoff-timer bt-mill-backoff-seconds)
)

(defrule
    (strategic-number sn-resource-control == bt-mill-claim)
    (timer-triggered bt-mill-watchdog-timer)
    (or
        (and
            (goal bt-mill-project-goal 1)
            (building-type-count mill < 1)
        )
        (or
        (and
            (goal bt-mill-project-goal 2)
            (building-type-count mill < 2)
        )
        (and
            (goal bt-mill-project-goal 3)
            (building-type-count mill < 3)
        )
            )
    )
    (up-pending-objects c: mill == 0)
=>
    (disable-timer bt-mill-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-mill-backoff-goal 1)
    (enable-timer bt-mill-backoff-timer bt-mill-backoff-seconds)
)

(defrule
    (or
        (and
            (goal bt-mill-project-goal 1)
            (building-type-count mill >= 1)
        )
        (or
        (and
            (goal bt-mill-project-goal 2)
            (building-type-count mill >= 2)
        )
        (and
            (goal bt-mill-project-goal 3)
            (building-type-count mill >= 3)
        )
            )
    )
=>
    (disable-timer bt-mill-watchdog-timer)
    (disable-timer bt-mill-backoff-timer)
    (set-goal bt-mill-project-goal 0)
    (set-goal bt-mill-retry-goal 0)
    (set-goal bt-mill-backoff-goal 0)
)
(defrule
    (goal bt-mill-backoff-goal 1)
    (timer-triggered bt-mill-backoff-timer)
=>
    (disable-timer bt-mill-backoff-timer)
    (set-goal bt-mill-backoff-goal 0)
    (set-goal bt-mill-retry-goal 0)
)


;----------------------------------------------------------------
; TERMINAL RESEARCH RETRY RESET
; Failed-start budgets survive cooldown. They reset only when the strategic
; owner disappears, returning the lifecycle to a clean IDLE state.
(defrule
    (goal bt-cavalier-demand-goal 0)
    (goal bt-research-stable-claim-goal 0)
=>
    (set-goal bt-research-stable-cavalier-retry-goal 0)
)
(defrule
    (goal bt-paladin-demand-goal 0)
    (goal bt-research-stable-claim-goal 0)
=>
    (set-goal bt-research-stable-paladin-retry-goal 0)
)
(defrule
    (goal bt-heavy-camel-demand-goal 0)
    (goal bt-research-stable-claim-goal 0)
=>
    (set-goal bt-research-stable-heavy-camel-retry-goal 0)
)
(defrule
    (goal bt-halberdier-demand-goal 0)
    (goal bt-research-barracks-claim-goal 0)
=>
    (set-goal bt-research-barracks-halberdier-retry-goal 0)
)
(defrule
    (goal bt-research-cavalry-counter-package-goal 0)
    (goal bt-research-barracks-claim-goal 0)
    (up-compare-goal bt-cavalry-counter-level-goal < 1)
=>
    (set-goal bt-research-barracks-pikeman-retry-goal 0)
)
(defrule
    (goal bt-ram-demand-goal 0)
    (goal bt-research-siege-workshop-claim-goal 0)
=>
    (set-goal bt-research-siege-capped-ram-retry-goal 0)
    (set-goal bt-research-siege-ram-retry-goal 0)
)

