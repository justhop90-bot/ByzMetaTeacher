(defrule
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-blocked)
    (goal bt-tc-retry-goal 3)
    (timer-triggered bt-tc2-watchdog-timer)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-goal bt-tc-failure-goal bt-tc-failure-none)
    (set-goal bt-tc-stage-goal bt-tc-stage-demanded)
)

; TC2 retry-4 terminal cooldown:
; Four failed recovery attempts terminate this project instance rather
; than parking it forever. Reuse the maximum retry interval as a
; bounded re-evaluation delay, then allow normal TC2 demand to recreate
; a fresh project under current world-state conditions.
(defrule
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-blocked)
    (goal bt-tc-retry-goal 4)
    (timer-triggered bt-tc2-watchdog-timer)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-goal bt-tc-project-goal 0)
    (set-goal bt-tc-stage-goal bt-tc-stage-idle)
    (set-goal bt-tc-retry-goal 0)
    (set-goal bt-tc-failure-goal bt-tc-failure-project-invalid)
    (enable-timer bt-tc2-watchdog-timer bt-tc-retry-4-seconds)
)

; TC2 terminal cooldown release:
; Do not let a failed project immediately recreate itself. The normal
; demand rule may run again only after the bounded re-evaluation delay.
(defrule
    (goal bt-tc-project-goal 0)
    (goal bt-tc-stage-goal bt-tc-stage-idle)
    (goal bt-tc-failure-goal bt-tc-failure-project-invalid)
    (timer-triggered bt-tc2-watchdog-timer)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-goal bt-tc-failure-goal bt-tc-failure-none)
)

(defrule
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
    (building-type-count-total town-center >= 2)
    (building-type-count town-center < 2)
    (timer-triggered bt-tc2-watchdog-timer)
    (up-compare-goal bt-tc-retry-goal < 3)
    (strategic-number sn-resource-control == bt-tc2-claim)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (up-modify-goal bt-tc-retry-goal g:+ 1)
    (up-assign-builders c: town-center-foundation c: bt-tc-builder-count)
    (set-goal bt-tc-failure-goal bt-tc-failure-foundation-stall)
    (enable-timer bt-tc2-watchdog-timer bt-tc-watchdog-seconds)
)

(defrule
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
    (building-type-count-total town-center >= 2)
    (building-type-count town-center < 2)
    (timer-triggered bt-tc2-watchdog-timer)
    (up-compare-goal bt-tc-retry-goal >= 3)
    (strategic-number sn-resource-control == bt-tc2-claim)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-goal bt-tc-retry-goal 4)
    (set-goal bt-tc-failure-goal bt-tc-failure-foundation-stall)
    ; Reuse the existing bounded retry-4 terminal path. A foundation
    ; stall must not park the TC project forever while BOOM remains active.
    (set-goal bt-tc-stage-goal bt-tc-stage-blocked)
    (set-strategic-number sn-resource-control 0)
    (enable-timer bt-tc2-watchdog-timer bt-tc-retry-4-seconds)
)

; TC2 foundation-loss recovery:
; A foundation-active project is only valid while total TC count still
; includes the target foundation. If that witness disappears, release
; the claim and use the existing bounded retry path.
(defrule
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
    (timer-triggered bt-tc2-watchdog-timer)
    (building-type-count-total town-center < 2)
    (strategic-number sn-resource-control == bt-tc2-claim)
    (goal bt-tc-retry-goal 0)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-tc-failure-goal bt-tc-failure-project-invalid)
    (set-goal bt-tc-retry-goal 1)
    (set-goal bt-tc-stage-goal bt-tc-stage-blocked)
    (enable-timer bt-tc2-watchdog-timer bt-tc-retry-1-seconds)
)

(defrule
    (goal bt-tc-project-goal 2)
    (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
    (timer-triggered bt-tc2-watchdog-timer)
    (building-type-count-total town-center < 2)
    (strategic-number sn-resource-control == bt-tc2-claim)
    (goal bt-tc-retry-goal 1)
=>
    (disable-timer bt-tc2-watchdog-timer)
    (set-strategic-number sn-resource-control 0)
    (set-goal bt-tc-failure-goal bt-tc-failure-project-invalid)
    (set-goal bt-tc-retry-goal 2)
    (set-goal bt-tc-stage-goal bt-tc-stage-blocked)
    (enable-timer bt-tc2-watchdog-timer bt-tc-retry-2-seconds)
)

(defrule
