;      +---- support request ----> active hunt
;      |
;      +---- boar gone ----------> normal hunting
;
;   SCOUT
;      |
;      v
;   enemy observation
;      |
;      v
;   strategy-goal
;      |
;      v
;   unit-goal
;      |
;      v
;   production building
;      |
;      v
;   train
;      |
;      v
;   attack-soldier-count
;      |
;      v
;   attack-now
;      |
;      +---- town-under-attack ----> retreat-now
;      |
;      v
;   reassess
;
; STRATEGY:
;   boom / rush / flush
;
; COMPOSITION:
;   spearman-line
;   skirmisher-line
;   archer-line
;   mix
;
; PRODUCTION:
;   barracks
;   archery-range
;   stable
;
