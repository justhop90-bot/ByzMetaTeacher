)

;----------------------------------------------------------------
; 11A. FEUDAL FARM CAPACITY
;----------------------------------------------------------------
(defrule
    (current-age >= feudal-age)
    (strategic-number sn-resource-control == 0)
    (up-pending-objects c: farm == 0)
    (or
        (and (food-amount < 350) (idle-farm-count == 0))
        (or
        (and (goal bt-natural-food-state-goal bt-natural-food-transition)
             (idle-farm-count <= bt-farm-transition-reserve-goal))
        (and (goal bt-natural-food-state-goal bt-natural-food-depleted)
             (idle-farm-count <= bt-farm-depleted-reserve-goal))
            )
    )
    (building-type-count-total farm < bt-farm-feudal-cap)
    (wood-amount >= bt-farm-build-wood)
    ; Wood escrow is intentionally usable by the farm action once the
    ; shared resource mutex is free. This is the same escrow-aware
    ; feasibility model used by TC/research construction.
    (can-build-with-escrow farm)
=>
    (release-escrow wood)
    (build farm)
)

;----------------------------------------------------------------
; 11B. CASTLE FARM CAPACITY
;----------------------------------------------------------------
(defrule
    (current-age == castle-age)
    (strategic-number sn-resource-control == 0)
    (up-pending-objects c: farm == 0)
    (or
        (and (food-amount < bt-farm-castle-food-threshold) (idle-farm-count == 0))
        (or
        (and (goal bt-natural-food-state-goal bt-natural-food-transition)
             (idle-farm-count <= bt-farm-transition-reserve-goal))
        (and (goal bt-natural-food-state-goal bt-natural-food-depleted)
             (idle-farm-count <= bt-farm-depleted-reserve-goal))
            )
    )
    (building-type-count-total farm < bt-farm-castle-cap)
    (wood-amount >= bt-farm-build-wood)
    ; Farm construction is escrow-aware, so the rule cannot stall merely
    ; because the controller is carrying reserved wood.
    (can-build-with-escrow farm)
=>
    (release-escrow wood)
    (build farm)
)

;----------------------------------------------------------------
; 11C. IMPERIAL FARM CAPACITY
;----------------------------------------------------------------
; Imperial no longer waits for Crop Rotation or deer extinction before
; maintaining food capacity. Natural-food state becomes a soft urgency
; signal; farm capacity remains the hard completion witness.
(defrule
    (current-age >= imperial-age)
    (strategic-number sn-resource-control == 0)
    (up-pending-objects c: farm == 0)
    (or
        (and (food-amount < bt-farm-imperial-food-threshold) (idle-farm-count == 0))
        (or
        (and (goal bt-natural-food-state-goal bt-natural-food-transition)
             (idle-farm-count <= bt-farm-transition-reserve-goal))
        (and (goal bt-natural-food-state-goal bt-natural-food-depleted)
             (idle-farm-count <= bt-farm-depleted-reserve-goal))
            )
    )
    (building-type-count-total farm < bt-farm-imperial-cap)
    (wood-amount >= bt-farm-build-wood)
    ; Preserve the same feasibility semantics through Imperial: the
    ; physical farm may consume reserved wood only when no higher-priority
    ; resource claim currently owns the bank.
    (can-build-with-escrow farm)
=>
    (release-escrow wood)
    (build farm)
)

;================================================================
; 12. SCOUTING
;================================================================
; Q: "How does the AI deliberately search for the enemy?"
;
; up-send-scout directs a land/water scout to a strategic location.
;
; Community pattern:
;   - one exploration group is the normal baseline;
;   - scout-flank performs the opening search;
;   - scout-enemy is used only after the target player's location is known;
;   - extra Scout production is a finite Feudal pressure commitment.
;
;---------------------------------------------------------------
; 12A. TARGET SELECTION
;---------------------------------------------------------------
; The controller already consumes target-player throughout military
; interpretation and attack readiness, but previously had no local
; writer.  Select the closest active enemy once enemy information exists,
; then copy that player number into the engine's target-player selector.
;
; This is intentionally minimal.  In 1v1, the result is deterministic.
; In team games, closest-enemy remains the repository's simple policy;
; it is not a full multi-enemy threat allocator.
(defrule
    (players-building-count any-enemy > 0)
    (or
        (strategic-number sn-target-player-number <= 0)
        (not (player-in-game target-player))
    )
=>
    (up-find-player enemy find-closest bt-scout-target-player-goal)
)

(defrule
    (up-compare-goal bt-scout-target-player-goal > 0)
    (strategic-number sn-target-player-number != bt-scout-target-player-goal)
=>
    (up-modify-sn sn-target-player-number g:= bt-scout-target-player-goal)
)

;---------------------------------------------------------------
; 12B. INITIAL / REPEATED ENEMY SEARCH
;---------------------------------------------------------------
; Search remains timer-driven.  The target-specific witness prevents
; another enemy's visible building from authorizing targeted scouting.
; scout-cavalry-line is used only as an availability witness so an
; upgraded Light Cavalry/Hussar scout remains a mobile reconnaissance asset.
(defrule
    (timer-triggered bt-scouting-timer)
    (game-time >= 120)
    (players-building-count target-player <= 0)
    (unit-type-count-total scout-cavalry-line >= 1)
    (strategic-number sn-number-explore-groups > 0)
=>
    (up-send-scout bt-land-explore-group scout-flank)
    (enable-timer bt-scouting-timer 120)
)

;---------------------------------------------------------------
; 12C. TARGETED ENEMY SCOUTING
;---------------------------------------------------------------
;
; scout-enemy is legal only after target-player has an actual known
; building witness.  any-enemy is deliberately not used here.
(defrule
    (timer-triggered bt-scouting-timer)
    (game-time >= 120)
    (players-building-count target-player > 0)
    (unit-type-count-total scout-cavalry-line >= 1)
    (strategic-number sn-number-explore-groups > 0)
=>
    (up-send-scout bt-land-explore-group scout-enemy)
    (enable-timer bt-scouting-timer 180)
)

;---------------------------------------------------------------
; 12D. FEUDAL SCOUT-PRESSURE DEMAND
;---------------------------------------------------------------
; This is a narrow opening demand, not a new strategy system.
;
; It activates only when the controller is still in its early Feudal
; BOOM posture, is not currently able to research Castle Age, has
; located the target, and has not already invested in an Archer-heavy
; or Barracks-heavy Feudal plan.  The demand owns the finite four-Scout
; investment and disappears when a higher-priority plan takes over.
(defrule
    (goal bt-scout-pressure-demand-goal 0)
    (current-age == feudal-age)
    (game-time < bt-scout-pressure-window)
    (goal strategy-goal bt-strategy-boom)
    (players-building-count target-player > 0)
    (not (town-under-attack))
    (strategic-number sn-resource-control == 0)
    (not (can-research-with-escrow castle-age))
    (building-type-count-total archery-range == 0)
    (unit-type-count-total archer-line == 0)
    (building-type-count-total barracks < 2)
    (unit-type-count-total spearman-line < 3)
    (unit-type-count-total scout-cavalry >= 1)
    (unit-type-count-total scout-cavalry < bt-scout-feudal-cap)
    (food-amount >= bt-scout-safe-food)
    (wood-amount >= bt-scout-stable-wood)
    (can-build stable)
=>
    (set-goal bt-scout-pressure-demand-goal 1)
)

; Stop producing Scouts as soon as the finite Feudal investment has
; reached its cap or another strategic priority has become authoritative.
(defrule
    (goal bt-scout-pressure-demand-goal 1)
    (or (current-age >= castle-age) (or (can-research-with-escrow castle-age) (or (goal strategy-goal bt-strategy-flush) (or (goal strategy-goal bt-strategy-rush) (or (building-type-count-total archery-range >= 1) (or
(building-type-count-total barracks >= 2) (or (unit-type-count-total scout-cavalry >= bt-scout-feudal-cap) (or (food-amount < bt-scout-safe-food) (not (players-building-count target-player > 0))))))))))
=> 
    (set-goal bt-scout-pressure-demand-goal 0)
)

;================================================================
; 12E. ENEMY THREAT STATE
;----------------------------------------------------------------
; Threat booleans describe immediate counter categories.
; Capacity levels describe production-building demand.
; Counter levels preserve the original military-response thresholds.
(defrule
    (true)
=>
    (set-goal bt-cavalry-threat-goal 0)
    (set-goal bt-ranged-threat-goal 0)
    (set-goal bt-spear-threat-goal 0)
    (set-goal bt-any-threat-goal 0)
    (set-goal bt-cavalry-level-goal 0)
    (set-goal bt-cavalry-counter-level-goal 0)
    (set-goal bt-ranged-counter-level-goal 0)
    (set-goal bt-spear-counter-level-goal 0)
    (set-goal bt-noncav-cavalry-level-goal 0)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 3)
        (or
            (players-unit-type-count any-enemy camel-line >= 3)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 3)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 3)
                    (players-unit-type-count any-enemy war-elephant-line >= 3)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-threat-goal 1)
    (set-goal bt-any-threat-goal 1)
)
(defrule
    (or
        (players-unit-type-count any-enemy archer-line >= 3)
        (players-unit-type-count any-enemy cavalry-archer-line >= 3)
    )
=>
    (set-goal bt-ranged-threat-goal 1)
    (set-goal bt-any-threat-goal 1)
)
(defrule
    (players-unit-type-count any-enemy spearman-line >= 4)
=>
    (set-goal bt-spear-threat-goal 1)
    (set-goal bt-any-threat-goal 1)
)
; Counter levels preserve original military-response thresholds.
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 3)
        (or
            (players-unit-type-count any-enemy camel-line >= 3)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 3)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 3)
                    (players-unit-type-count any-enemy war-elephant-line >= 3)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-counter-level-goal 1)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 10)
        (or
            (players-unit-type-count any-enemy camel-line >= 10)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 10)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 10)
                    (players-unit-type-count any-enemy war-elephant-line >= 10)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-counter-level-goal 2)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 20)
        (or
            (players-unit-type-count any-enemy camel-line >= 20)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 20)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 20)
                    (players-unit-type-count any-enemy war-elephant-line >= 20)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-counter-level-goal 3)
)
(defrule
    (or
        (players-unit-type-count any-enemy archer-line >= 3)
        (players-unit-type-count any-enemy cavalry-archer-line >= 3)
    )
=>
    (set-goal bt-ranged-counter-level-goal 1)
)
(defrule
    (or
        (players-unit-type-count any-enemy archer-line >= 10)
        (players-unit-type-count any-enemy cavalry-archer-line >= 10)
    )
=>
    (set-goal bt-ranged-counter-level-goal 2)
)
(defrule
    (or
        (players-unit-type-count any-enemy archer-line >= 20)
        (players-unit-type-count any-enemy cavalry-archer-line >= 20)
    )
=>
    (set-goal bt-ranged-counter-level-goal 3)
)
(defrule
    (players-unit-type-count any-enemy spearman-line >= 4)
=>
    (set-goal bt-spear-counter-level-goal 1)
)
(defrule
    (players-unit-type-count any-enemy spearman-line >= 8)
=>
    (set-goal bt-spear-counter-level-goal 2)
)
; Non-Camel cavalry capacity: 10/15.
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 10)
        (or
            (players-unit-type-count any-enemy cataphract-line >= 10)
            (or
                (players-unit-type-count any-enemy scout-cavalry-line >= 10)
                (players-unit-type-count any-enemy war-elephant-line >= 10)
            )
        )
    )
=>
    (set-goal bt-noncav-cavalry-level-goal 1)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 15)
        (or
            (players-unit-type-count any-enemy cataphract-line >= 15)
            (or
                (players-unit-type-count any-enemy scout-cavalry-line >= 15)
                (players-unit-type-count any-enemy war-elephant-line >= 15)
            )
        )
    )
=>
    (set-goal bt-noncav-cavalry-level-goal 2)
)
; Cavalry production capacity: 6/15/25/40/55.
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 6)
        (or
            (players-unit-type-count any-enemy camel-line >= 6)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 6)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 6)
                    (players-unit-type-count any-enemy war-elephant-line >= 6)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-level-goal 1)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 15)
        (or
            (players-unit-type-count any-enemy camel-line >= 15)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 15)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 15)
                    (players-unit-type-count any-enemy war-elephant-line >= 15)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-level-goal 2)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 25)
        (or
            (players-unit-type-count any-enemy camel-line >= 25)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 25)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 25)
                    (players-unit-type-count any-enemy war-elephant-line >= 25)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-level-goal 3)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 40)
        (or
            (players-unit-type-count any-enemy camel-line >= 40)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 40)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 40)
                    (players-unit-type-count any-enemy war-elephant-line >= 40)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-level-goal 4)
)
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= 55)
        (or
            (players-unit-type-count any-enemy camel-line >= 55)
            (or
                (players-unit-type-count any-enemy cataphract-line >= 55)
                (or
                    (players-unit-type-count any-enemy scout-cavalry-line >= 55)
                    (players-unit-type-count any-enemy war-elephant-line >= 55)
                )
            )
        )
    )
=>
    (set-goal bt-cavalry-level-goal 5)
)

; 13. STRATEGY SELECTION
;================================================================
;
; Strategy answers:
;
;   "What kind of game are we playing right now?"
;
; It does NOT train units.
;
; Strategy values:
;
;   FLUSH = react to military pressure
;   RUSH  = convert a small prepared army into pressure
;   BOOM  = prioritize economic expansion
;---------------------------------------------------------------
; 13A. MILITARY PRESSURE -> FLUSH
;---------------------------------------------------------------
; Threat observation is centralized in section 12C.
;
; FLUSH is the highest-priority strategy state.  It may only be
; entered from a non-FLUSH state.  Recovery is explicit: once the
; threat is gone, return either to the Feudal RUSH posture when its
; conditions are still satisfied, or to BOOM otherwise.
(defrule
    (town-under-attack)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-flush)
)
(defrule
    (not (town-under-attack))
    (goal bt-cavalry-threat-goal 1)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-flush)
)
(defrule
    (not (town-under-attack))
    (goal bt-ranged-threat-goal 1)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-flush)
)
(defrule
    (not (town-under-attack))
    (goal bt-spear-threat-goal 1)
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-flush)
)

;---------------------------------------------------------------
; 13B. FLUSH RECOVERY -> RUSH
;---------------------------------------------------------------
; This is an explicit exit from FLUSH.  It is evaluated after the
; threat writers, so the current pass must already be threat-free.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (current-age == feudal-age)
    (game-time >= 600)
    (players-building-count any-enemy > 0)
    (up-compare-goal bt-standing-army-deficit-goal >= 0)
    (up-compare-goal bt-standing-army-floor-goal >= bt-flush-army-floor-feudal)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
=>
    (set-goal strategy-goal bt-strategy-rush)
)

;---------------------------------------------------------------
; 13C. FLUSH RECOVERY -> BOOM
;---------------------------------------------------------------
; If the RUSH recovery conditions are not satisfied, recover to the
; economic posture explicitly rather than relying on a generic BOOM
; rule to overwrite FLUSH.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (not (current-age == feudal-age))
    (up-compare-goal bt-standing-army-deficit-goal >= 0)
    (or
        (and
            (current-age == castle-age)
            (up-compare-goal bt-standing-army-floor-goal >= bt-flush-army-floor-castle)
        )
        (and
            (current-age >= imperial-age)
            (up-compare-goal bt-standing-army-floor-goal >= bt-flush-army-floor-imperial)
        )
    )
=>
    (set-goal strategy-goal bt-strategy-boom)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (current-age == feudal-age)
    (not (game-time >= 600))
    (up-compare-goal bt-standing-army-deficit-goal >= 0)
    (up-compare-goal bt-standing-army-floor-goal >= bt-flush-army-floor-feudal)
=>
    (set-goal strategy-goal bt-strategy-boom)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (current-age == feudal-age)
    (game-time >= 600)
    (players-building-count any-enemy <= 0)
    (up-compare-goal bt-standing-army-deficit-goal >= 0)
    (up-compare-goal bt-standing-army-floor-goal >= bt-flush-army-floor-feudal)
=>
    (set-goal strategy-goal bt-strategy-boom)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (current-age == feudal-age)
    (game-time >= 600)
    (players-building-count any-enemy > 0)
    (up-compare-goal bt-standing-army-deficit-goal >= 0)
    (up-compare-goal bt-standing-army-floor-goal >= bt-flush-army-floor-feudal)
    (not (goal strategy-goal bt-strategy-rush))
=>
    (set-goal strategy-goal bt-strategy-boom)
)

;---------------------------------------------------------------
; 13D. FEUDAL MILITARY READY -> RUSH
;---------------------------------------------------------------
;
; This does NOT run if the AI is already in FLUSH.
;
; The first rush army is intentionally small and readable:
; Archery Range + Archers.
(defrule
    (current-age == feudal-age)
    (game-time >= 600)
    (players-building-count any-enemy > 0)
    (military-population >= 6)
    (not (town-under-attack))
    (not (goal strategy-goal bt-strategy-flush))
    (not (goal strategy-goal bt-strategy-rush))
=>
    (set-goal strategy-goal bt-strategy-rush)
)

;---------------------------------------------------------------
; 13E. SAFE CASTLE -> BOOM
;---------------------------------------------------------------
; Explicitly exclude both active pressure states.  BOOM can no
; longer overwrite RUSH or FLUSH.
;---------------------------------------------------------------
; 13E.1 FEUDAL RUSH EXPIRY -> BOOM
;---------------------------------------------------------------
; RUSH is a Feudal pressure posture. Once Castle Age is reached,
; a safe RUSH must yield to the existing BOOM posture so Castle
; economic consumers (TC expansion, Castle BOOM resource mode, and
; related maturity rules) are not permanently starved by stale
; Feudal strategy state. Active pressure is already claimed by
; FLUSH above, so this rule only fires when the current threat
; snapshot is clear.
(defrule
    (goal strategy-goal bt-strategy-rush)
    (current-age >= castle-age)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
=>
    (set-goal strategy-goal bt-strategy-boom)
)

(defrule
    (current-age >= castle-age)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (not (goal strategy-goal bt-strategy-boom))
    (not (goal strategy-goal bt-strategy-rush))
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-boom)
)

;---------------------------------------------------------------
; 13F. SAFE PRE-CASTLE DEFAULT
;---------------------------------------------------------------
(defrule
    (current-age < castle-age)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (not (goal strategy-goal bt-strategy-boom))
    (not (goal strategy-goal bt-strategy-rush))
    (not (goal strategy-goal bt-strategy-flush))
=>
    (set-goal strategy-goal bt-strategy-boom)
)

;================================================================
; 13G. CATAPHRACT DEMAND
;================================================================
;
; Cataphract demand is a strategic response package. It persists until
; the current enemy tier is satisfied and its required premium technology
; is complete. Queue-inclusive totals drive execution; actual completed
; Cataphracts drive expensive upgrade qualification.
(defrule
    (current-age >= imperial-age)
    (or
        (goal strategy-goal bt-strategy-boom)
        (goal strategy-goal bt-strategy-flush)
    )
    (or (and
            (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-3)
            (unit-type-count-total cataphract-line < bt-cataphract-target-3)
        ) (or (and (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-2) (and (players-unit-type-count any-enemy militiaman-line < bt-cataphract-enemy-threshold-3) (unit-type-count-total cataphract-line <
bt-cataphract-target-2))) (and (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-1) (and (players-unit-type-count any-enemy militiaman-line < bt-cataphract-enemy-threshold-2) (unit-type-count-total
cataphract-line < bt-cataphract-target-1)))))
=>
    (set-goal bt-cataphract-demand-goal 1)
)

; Demand stays live through a required premium upgrade. This prevents the
; 10/20-unit package from self-canceling when queue-inclusive production
; reaches its target before Logistica or Elite Cataphract can claim.
(defrule
    (goal bt-cataphract-demand-goal 1)
    (strategic-number sn-resource-control != ri-logistica)
    (strategic-number sn-resource-control != ri-elite-cataphract)
    (current-age < imperial-age)
=>
    (set-goal bt-cataphract-demand-goal 0)
)
(defrule
    (goal bt-cataphract-demand-goal 1)
    (strategic-number sn-resource-control != ri-logistica)
    (strategic-number sn-resource-control != ri-elite-cataphract)
    (or (not
            (or
                (goal strategy-goal bt-strategy-boom)
                (goal strategy-goal bt-strategy-flush)
            )
        ) (or (players-unit-type-count any-enemy militiaman-line < bt-cataphract-enemy-threshold-1) (or (and (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-1) (and (players-unit-type-count any-enemy
militiaman-line < bt-cataphract-enemy-threshold-2) (unit-type-count-total cataphract-line >= bt-cataphract-target-1))) (or (and (players-unit-type-count any-enemy militiaman-line >= bt-cataphract-enemy-threshold-2) (and (players-unit-type-count
any-enemy militiaman-line < bt-cataphract-enemy-threshold-3) (and (unit-type-count-total cataphract-line >= bt-cataphract-target-2) (up-research-status c: ri-logistica == research-complete)))) (and (players-unit-type-count any-enemy
militiaman-line >= bt-cataphract-enemy-threshold-3) (and (unit-type-count-total cataphract-line >= bt-cataphract-target-3) (and (up-research-status c: ri-logistica == research-complete) (up-research-status c: ri-elite-cataphract ==
research-complete))))))))
=>
    (set-goal bt-cataphract-demand-goal 0)
)

;================================================================
; 14. UNIT-GOAL SELECTION
;================================================================
;
; Unit-goal answers:
;
;   "What composition should the production system make?"
;
; The strategy layer decides POSTURE.
; This layer decides COMPOSITION.
;---------------------------------------------------------------
; 14A. MULTIPLE THREAT TYPES -> MIX
;---------------------------------------------------------------
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-cavalry-threat-goal 1)
    (goal bt-ranged-threat-goal 1)
=>
    (set-goal unit-goal bt-unit-mix)
)
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-cavalry-threat-goal 1)
    (goal bt-spear-threat-goal 1)
=>
    (set-goal unit-goal bt-unit-mix)
)
(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-ranged-threat-goal 1)
    (goal bt-spear-threat-goal 1)
=>
    (set-goal unit-goal bt-unit-mix)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-cavalry-threat-goal 1)
    (not (goal bt-ranged-threat-goal 1))
    (not (goal bt-spear-threat-goal 1))
=>
    (set-goal unit-goal spearman-line)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-ranged-threat-goal 1)
    (not (goal bt-cavalry-threat-goal 1))
    (not (goal bt-spear-threat-goal 1))
=>
    (set-goal unit-goal skirmisher-line)
)

(defrule
    (goal strategy-goal bt-strategy-flush)
    (goal bt-spear-threat-goal 1)
    (not (goal bt-cavalry-threat-goal 1))
    (not (goal bt-ranged-threat-goal 1))
=>
    (set-goal unit-goal archer-line)
)

;---------------------------------------------------------------
; 14B. FLUSH WITH NO CURRENT THREAT -> MIX
;---------------------------------------------------------------
; Prevent a stale composition from surviving a transient defensive
; posture when the town is still under attack but the counted enemy
; threat has not resolved to a specific counter.
(defrule
    (goal strategy-goal bt-strategy-flush)
    (not (goal bt-cavalry-threat-goal 1))
    (not (goal bt-ranged-threat-goal 1))
    (not (goal bt-spear-threat-goal 1))
=>
    (set-goal unit-goal bt-unit-mix)
)

;---------------------------------------------------------------
; 14C. STRATEGIC POSTURES
;---------------------------------------------------------------
(defrule
    (goal strategy-goal bt-strategy-rush)
=>
    (set-goal unit-goal archer-line)
)

(defrule
    (goal strategy-goal bt-strategy-boom)
=>
    (set-goal unit-goal bt-unit-mix)
)

;---------------------------------------------------------------
; 14C.1 CASTLE PRIMARY MILITARY SELECTION
;---------------------------------------------------------------
(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= castle-age)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (unit-type-count-total archer-line >= 4)
    (food-amount >= 350)
    (gold-amount >= 150)
    (research-available ri-crossbow)
=>
    (set-goal unit-goal crossbowman)
)

(defrule
    (goal strategy-goal bt-strategy-boom)
    (current-age >= castle-age)
    (not (town-under-attack))
    (not (goal bt-any-threat-goal 1))
    (unit-type-count-total archer-line < 4)
    (food-amount >= 350)
    (gold-amount >= 150)
=>
    (set-goal unit-goal knight-line)
)

;================================================================
; 14D. BYZANTINE RESOURCE ALLOCATION
;================================================================
; CONSUMES existing strategy/composition/project state. Never writes it.
; One economic mode resolves demand overlays, then one guarded allocator
; owns all four gatherer-percentage strategic numbers.
;
; Priority:
;   P0 survival -> P1 age bank -> P2 capital project
;   -> P3 military demand -> P4 base economic posture
;
; Percentages are controller tuning, not engine constants.
(defrule
    (true)
=>
    (set-goal bt-resource-mode-goal 0)
)

; P0 FOOD.
(defrule
    (goal bt-resource-mode-goal 0)
    (unit-type-count villager >= 15)
    (food-amount < 150)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-food-crisis)
)

; P0 GOLD. Low gold without an active gold consumer is not a crisis.
(defrule
    (goal bt-resource-mode-goal 0)
    (gold-amount < 100)
    (or (goal bt-cataphract-demand-goal 1) (or (and (current-age >= castle-age) (and (goal strategy-goal bt-strategy-flush) (and (goal unit-goal bt-unit-mix) (and (unit-type-count-total spearman-line >= bt-spear-target-1) (and
(up-compare-goal bt-noncav-cavalry-level-goal >= 1) (and (building-type-count-total stable >= 1) (unit-type-count-total camel-line < bt-camel-target-1))))))) (or (and (current-age == dark-age) (unit-type-count villager >=
bt-feudal-villagers)) (or (and (current-age == feudal-age) (unit-type-count villager >= bt-castle-villagers)) (and (current-age == castle-age) (unit-type-count villager >= bt-imperial-villagers))))))
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-gold-crisis)
)

; P0 WOOD. Requires a real existing wood consumer.
(defrule
    (goal bt-resource-mode-goal 0)
    (current-age >= feudal-age)
    (wood-amount < 100)
    (or (building-type-count-total farm < bt-farm-castle-cap) (or (building-type-count-total barracks >= 1) (or (building-type-count-total archery-range >= 1) (or (building-type-count-total stable >= 1) (building-type-count-total
town-center >= 2)))))
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-wood-crisis)
)

; P1 AGE-UP BANKS. Existing age rules remain the action authority.
(defrule
    (goal bt-resource-mode-goal 0)
    (current-age == dark-age)
    (unit-type-count villager >= bt-feudal-villagers)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-feudal-bank)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (current-age == feudal-age)
    (goal bt-castle-cataphract-demand-goal 0)
    (unit-type-count villager >= bt-castle-villagers)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-castle-bank)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (strategic-number sn-resource-control == imperial-age)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-imperial-bank)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (current-age == castle-age)
    (goal bt-castle-cataphract-demand-goal 0)
    (unit-type-count villager >= bt-imperial-villagers)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-imperial-bank-prep)
)

; P2 CASTLE STONE. Stone exists only while an existing
; Castle-oriented military project has earned the stone allocation.
(defrule
    (goal bt-resource-mode-goal 0)
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (stone-amount < 650)
    (or
        (goal bt-castle-cataphract-demand-goal 1)
        (or
        (goal bt-cataphract-demand-goal 1)
        (and (goal strategy-goal bt-strategy-flush) (and (goal unit-goal bt-unit-mix) (and (unit-type-count-total spearman-line >= bt-spear-target-1) (and (up-compare-goal bt-noncav-cavalry-level-goal >= 1) (and (building-type-count-total
        stable >= 1) (unit-type-count-total camel-line < bt-camel-target-1))))))
            )
    )
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-castle-stone-premium)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (or
        (goal bt-castle-cataphract-demand-goal 1)
        (goal bt-cataphract-demand-goal 1)
    )
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (stone-amount < 650)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-castle-stone)
)

; P2 TC STONE. Consume persistent TC project state; never recreate demand here.
(defrule
    (goal bt-resource-mode-goal 0)
    (goal bt-tc-project-goal 2)
    (or
        (goal bt-tc-stage-goal bt-tc-stage-demanded)
        (or
            (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
            (or
                (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
                (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
            )
        )
    )
    (goal strategy-goal bt-strategy-boom)
    (stone-amount < 100)
    (goal bt-cataphract-demand-goal 1)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-tc-stone-premium)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (goal bt-tc-project-goal 2)
    (or
        (goal bt-tc-stage-goal bt-tc-stage-demanded)
        (or
            (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
            (or
                (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
                (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
            )
        )
    )
    (goal strategy-goal bt-strategy-boom)
    (stone-amount < 100)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-tc-stone)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (goal bt-tc-project-goal 3)
    (or
        (goal bt-tc-stage-goal bt-tc-stage-demanded)
        (or
            (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
            (or
                (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
                (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
            )
        )
    )
    (goal strategy-goal bt-strategy-boom)
    (stone-amount < 100)
    (goal bt-cataphract-demand-goal 1)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-tc-stone-premium)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (goal bt-tc-project-goal 3)
    (or
        (goal bt-tc-stage-goal bt-tc-stage-demanded)
        (or
            (goal bt-tc-stage-goal bt-tc-stage-resource-claimed)
            (or
                (goal bt-tc-stage-goal bt-tc-stage-placement-pending)
                (goal bt-tc-stage-goal bt-tc-stage-foundation-active)
            )
        )
    )
    (goal strategy-goal bt-strategy-boom)
    (stone-amount < 100)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-tc-stone)
)

; P3 PREMIUM-GOLD.
(defrule
    (goal bt-resource-mode-goal 0)
    (current-age == imperial-age)
    (or (goal bt-bombard-cannon-demand-goal 1) (or (goal bt-cataphract-demand-goal 1) (and (goal strategy-goal bt-strategy-flush) (and (goal unit-goal bt-unit-mix) (and (unit-type-count-total spearman-line >= bt-spear-target-1) (and
(up-compare-goal bt-noncav-cavalry-level-goal >= 1) (and (building-type-count-total stable >= 1) (unit-type-count-total camel-line < bt-camel-target-1))))))))
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-imperial-power)
)

(defrule
    (goal bt-resource-mode-goal 0)
    (or (goal bt-bombard-cannon-demand-goal 1) (or (goal bt-cataphract-demand-goal 1) (and (current-age >= castle-age) (and (goal strategy-goal bt-strategy-flush) (and (goal unit-goal bt-unit-mix) (and (unit-type-count-total spearman-line
>= bt-spear-target-1) (and (up-compare-goal bt-noncav-cavalry-level-goal >= 1) (and (building-type-count-total stable >= 1) (unit-type-count-total camel-line < bt-camel-target-1)))))))))
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-premium-gold)
)

; P3 CHEAP-TRASH. Existing Spear/Skirm demand drives food/wood-heavy mode.
(defrule
    (goal bt-resource-mode-goal 0)
    (current-age >= castle-age)
    (goal strategy-goal bt-strategy-flush)
    (or (goal unit-goal spearman-line) (or (goal unit-goal skirmisher-line) (goal unit-goal bt-unit-mix)))
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-cheap-trash)
)

; P4 BASE MODES.
(defrule
    (goal bt-resource-mode-goal 0)
    (current-age >= imperial-age)
=>
    (set-goal bt-resource-mode-goal bt-resource-mode-imperial-trash)
)

(defrule
    (goal bt-resource-mode-goal 0)
